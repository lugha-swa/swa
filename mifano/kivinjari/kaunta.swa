// Kaunta ya kubofya -- mfano wa Swa kwenye kivinjari.
//
//   swa --wasm kaunta.swa > kaunta.wasm
//   swa --wasm-js > swa-js.js
//   python3 -m http.server   # kisha fungua http://localhost:8000
//
// DOM inatoka msingi/maktaba/kivinjari.swa (Swa); swa-js.js ni daraja la
// jumla linaloandikwa na mkusanyaji. Hali (hesabu, lebo) ni vigezo vya
// ulimwengu: vinadumu kati ya mibofyo.
husisha { kivinjari.swa }

n32 hesabu = 0;
n32 lebo = 0;

w0 bonyeza(n32 id) {
    hesabu = hesabu + 1;
    dom_weka_namba(lebo, hesabu);
}

w0 safisha(n32 id) {
    hesabu = 0;
    dom_weka_namba(lebo, hesabu);
}

n32 main() {
    n32 nodi_ya_programu = dom_nodi_kuu();
    n32 kitufe = dom_unda("button");
    dom_weka_maandishi(kitufe, "Ongeza");
    dom_ambatanisha(nodi_ya_programu, kitufe);
    lebo = dom_unda("span");
    dom_weka_namba(lebo, hesabu);
    dom_ambatanisha(nodi_ya_programu, lebo);
    n32 futa = dom_unda("button");
    dom_weka_maandishi(futa, "Safisha");
    dom_ambatanisha(nodi_ya_programu, futa);
    dom_itikia(kitufe, "click", &bonyeza);
    dom_itikia(futa, "click", &safisha);
    rudisha 0;
}
