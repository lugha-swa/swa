{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Swa",
  "scopeName": "source.swa",
  "fileTypes": [".swa"],
  "patterns": [
    {
      "include": "#preprocessor"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "preprocessor": {
      "name": "meta.preprocessor.swa",
      "match": "^\\s*#\\s*[a-zA-Z_]\\w*\\b",
      "captures": {
        "0": {
          "name": "keyword.control.preprocessor.swa"
        }
      }
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.swa",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.swa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.swa",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.swa",
          "match": "\\\\[ntr\\\\'\"0abvf]|\\\\x[0-9a-fA-F]{2}"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.swa",
      "match": "'(?:[^'\\\\]|\\\\.)'"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.swa",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.octal.swa",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.binary.swa",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.swa",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9][0-9_]*)[fF]?\\b"
        },
        {
          "name": "constant.numeric.integer.swa",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.swa",
          "match": "\\b(?:kama|sivyo|chagua|hali)\\b"
        },
        {
          "name": "keyword.control.loop.swa",
          "match": "\\b(?:kwa|wakati|fanya)\\b"
        },
        {
          "name": "keyword.control.flow.swa",
          "match": "\\b(?:rudisha|vunja|endelea|nenda)\\b"
        },
        {
          "name": "keyword.operator.logical.swa",
          "match": "\\b(?:na|au|si)\\b"
        },
        {
          "name": "constant.language.boolean.swa",
          "match": "\\b(?:kweli|uongo)\\b"
        },
        {
          "name": "constant.language.null.swa",
          "match": "\\b(?:tupu)\\b"
        },
        {
          "name": "storage.type.struct.swa",
          "match": "\\b(?:muundo|muungano)\\b"
        },
        {
          "name": "storage.modifier.swa",
          "match": "\\b(?:thabiti|tete|fiche)\\b"
        },
        {
          "name": "keyword.other.memory.swa",
          "match": "\\b(?:ukubwa|tenga|achilia|badili|nakili)\\b"
        },
        {
          "name": "keyword.control.import.swa",
          "match": "\\b(?:husisha|kutoka)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.integer.signed.swa",
          "match": "\\bN(?:8|16|32|64|128)\\b"
        },
        {
          "name": "storage.type.integer.unsigned.swa",
          "match": "\\bA(?:8|16|32|64|128)\\b"
        },
        {
          "name": "storage.type.float.swa",
          "match": "\\bD(?:16|32|64|80|128)\\b"
        },
        {
          "name": "storage.type.boolean.swa",
          "match": "\\bB(?:1|8|16|32|64)\\b"
        },
        {
          "name": "storage.type.pointer.swa",
          "match": "\\bW(?:0|8|16|32|64)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.swa",
          "match": "=>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
        },
        {
          "name": "keyword.operator.arithmetic.swa",
          "match": "\\+\\+|--|\\*\\*"
        },
        {
          "name": "keyword.operator.comparison.swa",
          "match": "==|!=|<=|>=|&&|\\|\\|"
        },
        {
          "name": "keyword.operator.bitwise.swa",
          "match": "<<|>>|->|\\^|~"
        },
        {
          "name": "keyword.operator.swa",
          "match": "[+\\-*/%=<>!&|^~]|[.]{3}"
        },
        {
          "name": "punctuation.delimiter.swa",
          "match": "[{}()\\[\\];,:@?]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.swa",
          "match": "\\b(?:fanya|tunga)\\b"
        },
        {
          "name": "entity.name.function.call.swa",
          "match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()"
        }
      ]
    }
  }
}
