; jaribu-ir.mapishi -- IR ya mstari ya Swa (mteremko.swa) na mtafsiri wake
; (mtafsiri.swa) dhidi ya msimbo wa mashine: kila programu ya
; majaribio/ir/WIGO.txt hutekelezwa kwa njia zote mbili (bin/swa --programu na
; bin/swa --tafsiri) na namba ya kutoka na stdout lazima viwe sawa kabisa.
;   ./msingi/mjenzi.bin gharama/jaribu-ir.mapishi
saraka jengo
endesha msingi/mjenzi.bin gharama/jenga.mapishi > jengo/jenga.towe
endesha bin/swa --programu gharama/jaribu_ir.swa > jengo/jaribu_ir
endesha jengo/jaribu_ir bin/swa majaribio/ir/WIGO.txt
; --kati huchapisha IR (kwa sehemu za nyuma na utatuzi)
endesha bin/swa --kati majaribio/ir/jaribio_ir_msingi.swa > jengo/ir-msingi.txt
ina jengo/ir-msingi.txt "kazi fib:"
ina jengo/ir-msingi.txt wito_asili
; kisichoungwa mkono hukataliwa kwa sauti, kutoka 2
endesha_kosa 2 bin/swa --tafsiri majaribio/ir/nje_ya_wigo_muundo.swa > jengo/ir-nje 2> jengo/ir-nje.kosa
ina jengo/ir-nje.kosa "IR: haijaungwa mkono: muundo"
