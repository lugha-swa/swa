; jaribu-usakinishaji.mapishi -- swa iliyosakinishwa NJE ya hazina lazima
; ipate maktaba yake yenyewe. Mpangilio ni ule ule wa hazina:
;   <saraka_ya_swa>/bin/swa
;   <saraka_ya_swa>/msingi/maktaba/*.swa
; Kila mfano unakusanywa kutoka saraka isiyo na msingi/ ndani yake, kwa njia
; nne za kuita: njia kamili, kiungo (symlink), njia ya jamaa, na kutoka
; saraka ya ndani zaidi; matokeo lazima yalingane na mifano/*.tarajiwa. Hili
; ndilo linalothibitisha kwamba binari ya toleo inafanya kazi baada ya kupakuliwa.
;   ./msingi/mjenzi.bin gharama/jaribu-usakinishaji.mapishi
saraka jengo
endesha msingi/mjenzi.bin gharama/jenga.mapishi > jengo/jenga.towe
saraka jengo/usakinishaji
saraka jengo/usakinishaji/swa
saraka jengo/usakinishaji/swa/bin
saraka jengo/usakinishaji/swa/msingi
saraka jengo/usakinishaji/swa/msingi/maktaba
saraka jengo/usakinishaji/kiungo
saraka jengo/usakinishaji/mradi
saraka jengo/usakinishaji/mradi/ndani
nakili bin/swa jengo/usakinishaji/swa/bin/swa
nakili msingi/maktaba/faili.swa jengo/usakinishaji/swa/msingi/maktaba/faili.swa
nakili msingi/maktaba/hesabu.swa jengo/usakinishaji/swa/msingi/maktaba/hesabu.swa
nakili msingi/maktaba/kumbukumbu.swa jengo/usakinishaji/swa/msingi/maktaba/kumbukumbu.swa
nakili msingi/maktaba/mfuatano.swa jengo/usakinishaji/swa/msingi/maktaba/mfuatano.swa
nakili msingi/maktaba/mpangilio.swa jengo/usakinishaji/swa/msingi/maktaba/mpangilio.swa
nakili msingi/maktaba/nasibu.swa jengo/usakinishaji/swa/msingi/maktaba/nasibu.swa
nakili msingi/maktaba/orodha.swa jengo/usakinishaji/swa/msingi/maktaba/orodha.swa
nakili msingi/maktaba/ramani.swa jengo/usakinishaji/swa/msingi/maktaba/ramani.swa
nakili msingi/maktaba/takwimu.swa jengo/usakinishaji/swa/msingi/maktaba/takwimu.swa
nakili msingi/maktaba/wakati.swa jengo/usakinishaji/swa/msingi/maktaba/wakati.swa
kiungo ../swa/bin/swa jengo/usakinishaji/kiungo/swa
nakili mifano/salamu.swa jengo/usakinishaji/mradi/salamu.swa

; njia kamili
endesha ../swa/bin/swa --programu salamu.swa > jengo/usakinishaji/p_njia_kamili @ jengo/usakinishaji/mradi
endesha jengo/usakinishaji/p_njia_kamili > jengo/usakinishaji/p_njia_kamili.towe
sawa jengo/usakinishaji/p_njia_kamili.towe mifano/salamu.tarajiwa
; kiungo
endesha ../kiungo/swa --programu salamu.swa > jengo/usakinishaji/p_kiungo @ jengo/usakinishaji/mradi
endesha jengo/usakinishaji/p_kiungo > jengo/usakinishaji/p_kiungo.towe
sawa jengo/usakinishaji/p_kiungo.towe mifano/salamu.tarajiwa
; njia ya jamaa
endesha ./swa/bin/swa --programu mradi/salamu.swa > jengo/usakinishaji/p_njia_ya_jamaa @ jengo/usakinishaji/.
endesha jengo/usakinishaji/p_njia_ya_jamaa > jengo/usakinishaji/p_njia_ya_jamaa.towe
sawa jengo/usakinishaji/p_njia_ya_jamaa.towe mifano/salamu.tarajiwa
; saraka ya ndani
endesha ../../swa/bin/swa --programu ../salamu.swa > jengo/usakinishaji/p_saraka_ya_ndani @ jengo/usakinishaji/mradi/ndani
endesha jengo/usakinishaji/p_saraka_ya_ndani > jengo/usakinishaji/p_saraka_ya_ndani.towe
sawa jengo/usakinishaji/p_saraka_ya_ndani.towe mifano/salamu.tarajiwa

; kosa bado ni la sauti: faili lisilopo popote linataja saraka ya usakinishaji
nakili majaribio/usakinishaji/haipo.swa jengo/usakinishaji/mradi/haipo.swa
endesha_kosa 1 ../swa/bin/swa --programu haipo.swa > jengo/usakinishaji/haipo 2> jengo/usakinishaji/haipo.kosa @ jengo/usakinishaji/mradi
ina jengo/usakinishaji/haipo.kosa usakinishaji:
ina jengo/usakinishaji/haipo.kosa jengo/usakinishaji/swa/msingi/
andika usakinishaji: yote yamefaulu

; Bendera zilizoondolewa kabla ya v0.0.2 hukataliwa kwa bendera mpya
endesha_kosa 1 bin/swa --exe mifano/salamu.swa > jengo/usakinishaji/ondolewa.bin 2> jengo/usakinishaji/ondolewa-exe.kosa
ina jengo/usakinishaji/ondolewa-exe.kosa "'--exe' imeondolewa -- tumia '--programu'"
endesha_kosa 1 bin/swa --kernel mifano/salamu.swa > jengo/usakinishaji/ondolewa.bin 2> jengo/usakinishaji/ondolewa-kernel.kosa
ina jengo/usakinishaji/ondolewa-kernel.kosa "'--kernel' imeondolewa -- tumia '--kiini'"
endesha_kosa 1 bin/swa --ir mifano/salamu.swa > jengo/usakinishaji/ondolewa.bin 2> jengo/usakinishaji/ondolewa-ir.kosa
ina jengo/usakinishaji/ondolewa-ir.kosa "'--ir' imeondolewa -- tumia '--kati'"
endesha_kosa 1 bin/swa --jit mifano/salamu.swa > jengo/usakinishaji/ondolewa.bin 2> jengo/usakinishaji/ondolewa-jit.kosa
ina jengo/usakinishaji/ondolewa-jit.kosa "'--jit' imeondolewa -- tumia '--papo'"
