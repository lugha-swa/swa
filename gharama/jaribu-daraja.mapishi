; jaribu-daraja.mapishi -- daraja la mashine, awamu 1 (hati/daraja-la-mashine.md):
; Swa inaita libm na libc kupitia kipakiaji cha mfumo, msimbo wa nje unaita
; Swa (qsort), na kila mpaka wa awamu 1 ni kosa la sauti lenye ujumbe wake.
; Inahitaji libm.so.6 na libc.so.6 za mfumo -- ndizo kazi zinazoitwa.
;   ./msingi/mjenzi.bin gharama/jaribu-daraja.mapishi
saraka jengo
endesha msingi/mjenzi.bin gharama/jenga.mapishi > jengo/jenga.towe
saraka jengo/nje

; kazi za nje zinafanya kazi (kutoka 0 = kila ukaguzi ndani ya programu umepita)
endesha bin/swa --exe majaribio/daraja/hesabu.swa > jengo/nje/hesabu
endesha jengo/nje/hesabu
endesha bin/swa --exe majaribio/daraja/rudi.swa > jengo/nje/rudi
endesha jengo/nje/rudi
endesha bin/swa --exe majaribio/daraja/upangiliaji.swa > jengo/nje/upangiliaji
endesha jengo/nje/upangiliaji
endesha bin/swa --exe majaribio/daraja/nje_kigeu.swa > jengo/nje/nje_kigeu
endesha jengo/nje/nje_kigeu

; mipaka ya awamu 1 na makosa ya sintaksia: kutoka 1 na ujumbe kamili
endesha_kosa 1 bin/swa --exe majaribio/daraja/makosa/alama_si_mfuatano.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/alama_si_mfuatano.kosa
endesha_kosa 1 bin/swa --exe majaribio/daraja/makosa/hoja_saba.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/hoja_saba.kosa
endesha_kosa 1 bin/swa --exe majaribio/daraja/makosa/ina_mwili.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/ina_mwili.kosa
endesha_kosa 1 bin/swa --exe majaribio/daraja/makosa/jina_tupu.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/jina_tupu.kosa
endesha_kosa 1 bin/swa --kernel majaribio/daraja/makosa/kernel.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/kernel.kosa
endesha_kosa 1 bin/swa --exe majaribio/daraja/makosa/marudio.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/marudio.kosa
endesha_kosa 1 bin/swa --exe majaribio/daraja/makosa/muundo_hoja.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/muundo_hoja.kosa
endesha_kosa 1 bin/swa --exe majaribio/daraja/makosa/muundo_matokeo.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/muundo_matokeo.kosa
endesha_kosa 1 bin/swa --exe majaribio/daraja/makosa/mwili_ndani.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/mwili_ndani.kosa
endesha_kosa 1 bin/swa --exe majaribio/daraja/makosa/semikoloni.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/semikoloni.kosa
endesha_kosa 1 bin/swa --tafsiri majaribio/daraja/makosa/tafsiri.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/tafsiri.kosa
endesha_kosa 1 bin/swa --exe majaribio/daraja/makosa/tupu.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/tupu.kosa
endesha_kosa 1 bin/swa --wasm majaribio/daraja/makosa/wasm.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/daraja/makosa/wasm.kosa

andika daraja: kazi za nje na mipaka yake -- yote yamefaulu
