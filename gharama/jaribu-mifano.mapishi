; jaribu-mifano.mapishi -- kila mfano wa README (mifano/*.swa) lazima
; ukusanywe na utoe HASA mifano/*.tarajiwa. README hunukuu mifano hii;
; mfano mpya huongezwa hapa kwa mistari mitatu.
;   ./msingi/mjenzi.bin gharama/jaribu-mifano.mapishi
saraka jengo
endesha msingi/mjenzi.bin gharama/jenga.mapishi > jengo/jenga.towe
saraka jengo/mifano
endesha bin/swa --exe mifano/salamu.swa > jengo/mifano/salamu
endesha jengo/mifano/salamu > jengo/mifano/salamu.towe
sawa jengo/mifano/salamu.towe mifano/salamu.tarajiwa
andika mifano: yote yamefaulu
