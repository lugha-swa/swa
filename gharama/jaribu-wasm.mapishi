; jaribu-wasm.mapishi -- majaribio ya backend ya WebAssembly ("kamili --wasm").
; Kila kisa:
;   - kinachokubalika: kamili --wasm hukusanya, na moduli inayotokana lazima
;     ipite majaribio/wasm/kimbiza.js (Node: WebAssembly.validate +
;     instantiate + main() == thamani). Aina ya uthibitisho (hiari): namba
;     (chaguo-msingi), mfuatano (NUL-terminated kutoka memory.buffer), safu
;     (i32 zilizotenganishwa kwa mkato), dom (mti wa dom_bandia.js dhidi ya
;     .tarajiwa.json) -- angalia kimbiza.js.
;   - kilicho nje ya wigo: kamili --wasm lazima ikatae (kutoka 1, stdout tupu).
; Moduli zote hupakiwa kupitia kiolesura kinachozalishwa na mkusanyaji
; (kamili --wasm-js), na majaribio ya DOM hupitia msingi/maktaba/kivinjari.swa.
; Mwisho: mifano/kivinjari/kihesabu.swa. Hakuna wat2wasm wala wasmtime -- node pekee.
; Kisa kipya huongezwa hapa.
;   ./msingi/mjenzi.bin gharama/jaribu-wasm.mapishi
saraka jengo
endesha msingi/mjenzi.bin gharama/jenga.mapishi > jengo/jenga.towe
saraka jengo/wasm
endesha jengo/kamili --wasm-js > jengo/wasm/swa-js.js
endesha node --check jengo/wasm/swa-js.js

endesha jengo/kamili --wasm majaribio/wasm/rudisha_tupu.swa > jengo/wasm/rudisha_tupu.wasm
endesha node majaribio/wasm/kimbiza.js jengo/wasm/rudisha_tupu.wasm 42 namba
endesha jengo/kamili --wasm majaribio/wasm/hesabu_msingi.swa > jengo/wasm/hesabu_msingi.wasm
endesha node majaribio/wasm/kimbiza.js jengo/wasm/hesabu_msingi.wasm 41 namba
endesha jengo/kamili --wasm majaribio/wasm/kama_sivyo.swa > jengo/wasm/kama_sivyo.wasm
endesha node majaribio/wasm/kimbiza.js jengo/wasm/kama_sivyo.wasm 1 namba
endesha jengo/kamili --wasm majaribio/wasm/mzunguko_mfupi_na.swa > jengo/wasm/mzunguko_mfupi_na.wasm
endesha node majaribio/wasm/kimbiza.js jengo/wasm/mzunguko_mfupi_na.wasm 1 namba
endesha jengo/kamili --wasm majaribio/wasm/mzunguko_mfupi_na_mfuatano.swa > jengo/wasm/mzunguko_mfupi_na_mfuatano.wasm
endesha node majaribio/wasm/kimbiza.js jengo/wasm/mzunguko_mfupi_na_mfuatano.wasm 1 namba
endesha jengo/kamili --wasm majaribio/wasm/mzunguko_mfupi_au_kweli.swa > jengo/wasm/mzunguko_mfupi_au_kweli.wasm
endesha node majaribio/wasm/kimbiza.js jengo/wasm/mzunguko_mfupi_au_kweli.wasm 1 namba
endesha jengo/kamili --wasm majaribio/wasm/mzunguko_mfupi_au_uongo.swa > jengo/wasm/mzunguko_mfupi_au_uongo.wasm
endesha node majaribio/wasm/kimbiza.js jengo/wasm/mzunguko_mfupi_au_uongo.wasm 0 namba
endesha jengo/kamili --wasm majaribio/wasm/wakati_jumla.swa > jengo/wasm/wakati_jumla.wasm
endesha node majaribio/wasm/kimbiza.js jengo/wasm/wakati_jumla.wasm 45 namba
endesha jengo/kamili --wasm majaribio/wasm/wakati_acha.swa > jengo/wasm/wakati_acha.wasm
