; jenga.mapishi -- jenga mkusanyaji wa Swa kutoka baiti 393 za mkono:
;   kwanza.bin -> ... -> kusanyiko -> mbegu -> kamili -> bin/swa
; bin/swa ni kizazi cha pili: kamili iliyojijenga yenyewe (ina uboreshaji
; wote wa uzalishaji.swa). Hakuna gcc, ld, nasm, libc wala bash.
;   ./msingi/mjenzi.bin gharama/jenga.mapishi
endesha msingi/mjenzi.bin gharama/mfululizo.mapishi
unganisha jengo/msuluhishi.swa msingi/maktaba/kumbukumbu.swa msingi/maktaba/mfuatano.swa msingi/maktaba/faili.swa gharama/msuluhishi.swa
endesha jengo/awali --programu jengo/msuluhishi.swa > jengo/msuluhishi
endesha jengo/msuluhishi msingi/mkusanyaji/kiendeshaji.swa > jengo/zima.swa
endesha jengo/awali --programu jengo/zima.swa > jengo/kamili
saraka bin
endesha jengo/kamili --programu jengo/zima.swa > bin/swa
andika bin/swa iko tayari
