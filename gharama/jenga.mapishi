; jenga.mapishi -- jenga mkusanyaji wa Swa kutoka baiti 393 za mkono:
;   kwanza.bin -> ... -> kusanyiko -> mbegu -> stage1 -> bin/swa
; bin/swa ni kizazi cha pili: stage1 iliyojijenga yenyewe (ina uboreshaji
; wote wa uzalishaji.swa). Hakuna gcc, ld, nasm, libc wala bash.
;   ./msingi/mjenzi.bin gharama/jenga.mapishi
endesha msingi/mjenzi.bin gharama/mnyororo.mapishi
unganisha jengo/msuluhishi.swa msingi/maktaba/kumbukumbu.swa msingi/maktaba/mfuatano.swa msingi/maktaba/faili.swa gharama/msuluhishi.swa
endesha jengo/mbegu --programu jengo/msuluhishi.swa > jengo/msuluhishi
endesha jengo/msuluhishi msingi/mkusanyaji/stage1.swa > jengo/zima.swa
endesha jengo/mbegu --programu jengo/zima.swa > jengo/stage1
saraka bin
endesha jengo/stage1 --programu jengo/zima.swa > bin/swa
andika bin/swa iko tayari
