; jaribu-kernel.mapishi -- majaribio ya backend ya "stage1 --kiini" (Kawira).
; Kila kisa:
;   - kinachokubalika: stage1 --kiini hukusanya, baiti zake huunganishwa
;     mwishoni mwa picha ya majaribio/kernel/stub.swm (iliyojengwa na
;     kusanyiko), kisha majaribio/kernel/oracle.py huiwasha kwenye QEMU na
;     kusoma HALI HALISI: RDI baada ya HLT (thamani ya kurudi ya kernel_main)
;     na maandishi ya VGA (0xB8000) -- si "haikuanguka".
;   - kilicho nje ya wigo: stage1 --kiini lazima ikatae (kutoka 1, stdout
;     tupu) kwa ujumbe unaotajwa.
; Kisa kipya huongezwa hapa. Inahitaji python3 na qemu-system-x86_64 kwenye PATH.
;   ./msingi/mjenzi.bin gharama/jaribu-kernel.mapishi
saraka jengo
endesha msingi/mjenzi.bin gharama/jenga.mapishi > jengo/jenga.towe
saraka jengo/kernel
endesha jengo/kusanyiko < majaribio/kernel/stub.swm > jengo/kernel/stub.bin

endesha jengo/stage1 --kiini majaribio/kernel/jaribio_umbo_moja.swa > jengo/kernel/umbo_moja.bin
unganisha jengo/kernel/umbo_moja-kamili.bin jengo/kernel/stub.bin jengo/kernel/umbo_moja.bin
endesha python3 majaribio/kernel/oracle.py jengo/kernel/umbo_moja-kamili.bin 0 "K"
endesha jengo/stage1 --kiini majaribio/kernel/jaribio_hesabu_na_mzunguko.swa > jengo/kernel/hesabu_na_mzunguko.bin
unganisha jengo/kernel/hesabu_na_mzunguko-kamili.bin jengo/kernel/stub.bin jengo/kernel/hesabu_na_mzunguko.bin
endesha python3 majaribio/kernel/oracle.py jengo/kernel/hesabu_na_mzunguko-kamili.bin 20 "Kawira"
endesha jengo/stage1 --kiini majaribio/kernel/jaribio_mstari_mpya.swa > jengo/kernel/mstari_mpya.bin
unganisha jengo/kernel/mstari_mpya-kamili.bin jengo/kernel/stub.bin jengo/kernel/mstari_mpya.bin
endesha python3 majaribio/kernel/oracle.py jengo/kernel/mstari_mpya-kamili.bin 0 "AB\nCD"
endesha jengo/stage1 --kiini majaribio/kernel/jaribio_vga_herufi_usemi.swa > jengo/kernel/vga_herufi_usemi.bin
unganisha jengo/kernel/vga_herufi_usemi-kamili.bin jengo/kernel/stub.bin jengo/kernel/vga_herufi_usemi.bin
endesha python3 majaribio/kernel/oracle.py jengo/kernel/vga_herufi_usemi-kamili.bin 3 "ABC"
endesha jengo/stage1 --kiini majaribio/kernel/jaribio_kbd_scancode_haanguki.swa > jengo/kernel/kbd_scancode_haanguki.bin
unganisha jengo/kernel/kbd_scancode_haanguki-kamili.bin jengo/kernel/stub.bin jengo/kernel/kbd_scancode_haanguki.bin
endesha python3 majaribio/kernel/oracle.py jengo/kernel/kbd_scancode_haanguki-kamili.bin 42
endesha_kosa 1 jengo/stage1 --kiini majaribio/kernel/nje_ya_wigo_tenga.swa > jengo/kernel/tenga.bin 2> jengo/kernel/tenga.kosa
sawa jengo/kernel/tenga.bin /dev/null
ina jengo/kernel/tenga.kosa "nje ya wigo"
endesha_kosa 1 jengo/stage1 --kiini majaribio/kernel/nje_ya_wigo_andika.swa > jengo/kernel/andika.bin 2> jengo/kernel/andika.kosa
sawa jengo/kernel/andika.bin /dev/null
ina jengo/kernel/andika.kosa "nje ya wigo"
endesha_kosa 1 jengo/stage1 --kiini majaribio/kernel/nje_ya_wigo_andika_stderr.swa > jengo/kernel/andika_stderr.bin 2> jengo/kernel/andika_stderr.kosa
sawa jengo/kernel/andika_stderr.bin /dev/null
ina jengo/kernel/andika_stderr.kosa "nje ya wigo"
endesha_kosa 1 jengo/stage1 --kiini majaribio/kernel/nje_ya_wigo_wito_wa_mfumo.swa > jengo/kernel/wito_wa_mfumo.bin 2> jengo/kernel/wito_wa_mfumo.kosa
sawa jengo/kernel/wito_wa_mfumo.bin /dev/null
ina jengo/kernel/wito_wa_mfumo.kosa "nje ya wigo"
endesha_kosa 1 jengo/stage1 --kiini majaribio/kernel/nje_ya_wigo_tekeleza.swa > jengo/kernel/tekeleza.bin 2> jengo/kernel/tekeleza.kosa
sawa jengo/kernel/tekeleza.bin /dev/null
ina jengo/kernel/tekeleza.kosa "nje ya wigo"
endesha_kosa 1 jengo/stage1 --kiini majaribio/kernel/nje_ya_wigo_muundo.swa > jengo/kernel/muundo.bin 2> jengo/kernel/muundo.kosa
sawa jengo/kernel/muundo.bin /dev/null
ina jengo/kernel/muundo.kosa "nje ya wigo"
endesha_kosa 1 jengo/stage1 --kiini majaribio/kernel/nje_ya_wigo_d64_tangazo.swa > jengo/kernel/d64_tangazo.bin 2> jengo/kernel/d64_tangazo.kosa
sawa jengo/kernel/d64_tangazo.bin /dev/null
ina jengo/kernel/d64_tangazo.kosa "nje ya wigo"
endesha_kosa 1 jengo/stage1 --kiini majaribio/kernel/nje_ya_wigo_d32_kurudi.swa > jengo/kernel/d32_kurudi.bin 2> jengo/kernel/d32_kurudi.kosa
sawa jengo/kernel/d32_kurudi.bin /dev/null
ina jengo/kernel/d32_kurudi.kosa "nje ya wigo"
endesha_kosa 1 jengo/stage1 --kiini majaribio/kernel/nje_ya_wigo_chagua.swa > jengo/kernel/chagua.bin 2> jengo/kernel/chagua.kosa
sawa jengo/kernel/chagua.bin /dev/null
ina jengo/kernel/chagua.kosa "nje ya wigo"
endesha_kosa 1 jengo/stage1 --kiini majaribio/kernel/nje_ya_wigo_kernel_main_si_ya_kwanza.swa > jengo/kernel/kernel_main_si_ya_kwanza.bin 2> jengo/kernel/kernel_main_si_ya_kwanza.kosa
sawa jengo/kernel/kernel_main_si_ya_kwanza.bin /dev/null
ina jengo/kernel/kernel_main_si_ya_kwanza.kosa "LAZIMA iwe kazi ya KWANZA"

andika --kiini: majaribio yote yamefaulu
