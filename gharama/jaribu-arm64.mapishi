; jaribu-arm64.mapishi -- lengo la ARM64 (kamili --arm64, kutoka IR): kila
; programu ya majaribio/ir/WIGO.txt hukusanywa kwa x86-64 na kwa AArch64,
; AArch64 huendeshwa kwa qemu-aarch64, na namba ya kutoka na stdout lazima
; viwe sawa kabisa. Inahitaji qemu-aarch64 kwenye PATH.
;   ./msingi/mjenzi.bin gharama/jaribu-arm64.mapishi
saraka jengo
endesha msingi/mjenzi.bin gharama/jenga.mapishi > jengo/jenga.towe
endesha bin/swa --programu gharama/jaribu_ir.swa > jengo/jaribu_ir
endesha jengo/jaribu_ir bin/swa majaribio/ir/WIGO.txt arm64
; kisichoungwa mkono na IR hukataliwa kwa sauti, kutoka 2
endesha_kosa 2 bin/swa --arm64 majaribio/ir/nje_ya_wigo_muundo.swa > jengo/a64-nje 2> jengo/a64-nje.kosa
ina jengo/a64-nje.kosa "IR: haijaungwa mkono: muundo"
; hoja za mstari na wito wa mfumo uliogeuzwa (open/mkdir/unlink/access/
; readlink/dup2/pipe/fork) -- Linux ya jumla ni ile ile kwa RISC-V 64 na
; ARM64, kwa hiyo programu ile ile ya majaribio hutumika
endesha bin/swa --programu majaribio/riscv64/hoja_na_mfumo.swa > jengo/a64-x86
endesha bin/swa --arm64 majaribio/riscv64/hoja_na_mfumo.swa > jengo/a64-a64
endesha_kosa 3 jengo/a64-x86 moja "mbili tatu" > jengo/a64-x86.towe
endesha_kosa 3 qemu-aarch64 jengo/a64-a64 moja "mbili tatu" > jengo/a64-a64.towe
sawa jengo/a64-x86.towe jengo/a64-a64.towe
ina jengo/a64-a64.towe "fork+wait4: 7"
