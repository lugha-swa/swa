; jaribu-mnyororo.mapishi -- mnyororo kamili wa majaribio ya mkusanyaji.
;   1. majaribio ya Swa asili (gharama/jaribu_mnyororo.swa): ujenzi wa stage1,
;      fixpoint stage2 == stage3, na kila programu ya
;      majaribio/programu/MANIFEST.txt kwa minyororo yote miwili
;   2. majaribio ya mkazo na semantiki (majaribio/mkazo/) yaliyo hapa chini
;   ./msingi/mjenzi.bin gharama/jaribu-mnyororo.mapishi
saraka jengo
endesha msingi/mjenzi.bin gharama/jenga.mapishi > jengo/jenga.towe
endesha msingi/mjenzi.bin gharama/jaribu-mnyororo-asili.mapishi > jengo/asili.towe
saraka jengo/mkazo

; mkazo wa RELA: wito 1,000 wa mbele (mbegu)
endesha jengo/mbegu --programu majaribio/mkazo/rela_1000.swa > jengo/mkazo/rela
endesha jengo/mkazo/rela

; semantiki ya C ya endelea ndani ya kwa (minyororo yote miwili): s = 5
endesha jengo/mbegu --programu majaribio/mkazo/kwa_endelea.swa > jengo/mkazo/kwa_mbegu
endesha_kosa 5 jengo/mkazo/kwa_mbegu
endesha jengo/stage1 --programu majaribio/mkazo/kwa_endelea.swa > jengo/mkazo/kwa_stage1
endesha_kosa 5 jengo/mkazo/kwa_stage1

; desimali d64 (minyororo yote miwili)
endesha jengo/mbegu --programu majaribio/mkazo/desimali.swa > jengo/mkazo/des_mbegu
endesha jengo/mkazo/des_mbegu
endesha jengo/stage1 --programu majaribio/mkazo/desimali.swa > jengo/mkazo/des_stage1
endesha jengo/mkazo/des_stage1

; mzunguko mfupi wa && (mbegu): a[99999999] haisomwi
endesha jengo/mbegu --programu majaribio/mkazo/mzunguko_mfupi.swa > jengo/mkazo/mz
endesha jengo/mkazo/mz

; kazi isiyofafanuliwa inalia kwa sauti (mbegu: stdout, stage1: stderr)
endesha_kosa 1 jengo/mbegu --programu majaribio/mkazo/kazi_haipo.swa > jengo/mkazo/kk 2> jengo/mkazo/kk.kosa
ina jengo/mkazo/kk haijafafanuliwa
endesha_kosa 1 jengo/stage1 --programu majaribio/mkazo/kazi_haipo.swa > jengo/mkazo/kk2 2> jengo/mkazo/kk2.kosa
ina jengo/mkazo/kk2.kosa haijafafanuliwa
; husisha ya maktaba: mbegu haitatui (inalia), stage1 hutatua (urefu wa "habari" = 6)
endesha_kosa 1 jengo/mbegu --programu majaribio/mkazo/husisha_maktaba.swa > jengo/mkazo/kh 2> jengo/mkazo/kh.kosa
ina jengo/mkazo/kh haijafafanuliwa
endesha jengo/stage1 --programu majaribio/mkazo/husisha_maktaba.swa > jengo/mkazo/kh2
endesha_kosa 6 jengo/mkazo/kh2

; bomba la stdin: chanzo kikubwa (mistari 3,000) hadi EOF (mbegu) -> 7
endesha jengo/mbegu --programu < majaribio/mkazo/bomba.swa > jengo/mkazo/bomba
endesha_kosa 7 jengo/mkazo/bomba

; ABI ya xmm: hoja na kurudi kwa d64 (minyororo yote miwili)
endesha jengo/mbegu --programu majaribio/mkazo/d64_wito.swa > jengo/mkazo/d64_mbegu
endesha jengo/mkazo/d64_mbegu
endesha jengo/stage1 --programu majaribio/mkazo/d64_wito.swa > jengo/mkazo/d64_stage1
endesha jengo/mkazo/d64_stage1
; kikomo cha mbegu: d64 pamoja na hoja 7-9 inalia kwa sauti
endesha_kosa 1 jengo/mbegu --programu majaribio/mkazo/d64_hoja_7_9.swa > jengo/mkazo/d64m 2> jengo/mkazo/d64m.kosa
ina jengo/mkazo/d64m "hoja 7-9"

; umbizaji hujiumbiza lenyewe bila mabadiliko (fixpoint)
unganisha jengo/mkazo/umbizaji.swa msingi/maktaba/kumbukumbu.swa msingi/maktaba/mfuatano.swa zana/umbizaji.swa
endesha jengo/mbegu --programu jengo/mkazo/umbizaji.swa > jengo/mkazo/umbizaji
endesha jengo/mkazo/umbizaji zana/umbizaji.swa > jengo/mkazo/umbizaji.towe
sawa jengo/mkazo/umbizaji.towe zana/umbizaji.swa

; uhakika wa bomba la stdin: programu halisi (maktaba tatu + main) mara 3,
; baiti zile zile, na inaendeshwa (-> 9). (Toleo la bash lililinganisha
; ujumbe wa kosa ule ule mara tatu -- hesabu.swa + mfuatano.swa pekee
; hazikusanyiki bila kumbukumbu.swa -- hivyo halikujaribu chochote.)
unganisha jengo/mkazo/bomba2.swa msingi/maktaba/kumbukumbu.swa msingi/maktaba/mfuatano.swa msingi/maktaba/hesabu.swa majaribio/mkazo/bomba_kuu.swa
endesha jengo/mbegu --programu < jengo/mkazo/bomba2.swa > jengo/mkazo/b1
endesha jengo/mbegu --programu < jengo/mkazo/bomba2.swa > jengo/mkazo/b2
endesha jengo/mbegu --programu < jengo/mkazo/bomba2.swa > jengo/mkazo/b3
sawa jengo/mkazo/b1 jengo/mkazo/b2
sawa jengo/mkazo/b1 jengo/mkazo/b3
endesha_kosa 9 jengo/mkazo/b1

; lugha-swa/swa#232: jenerali-2 (stage1 iliyojijenga) haipotezi maandishi
; ya andika_stderr -- husoma MAANDISHI HALISI, si tu kwamba haianguki
endesha jengo/stage1 --programu jengo/zima.swa > jengo/mkazo/jenerali2
endesha_kosa 1 jengo/mkazo/jenerali2 --programu jengo/mkazo/haipo-232.swa > jengo/mkazo/j2 2> jengo/mkazo/j2.kosa
ina jengo/mkazo/j2.kosa "; KOSA: faili la chanzo halifunguki: jengo/mkazo/haipo-232.swa"

andika mnyororo: majaribio yote yamefaulu
