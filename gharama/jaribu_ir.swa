husisha { msingi/maktaba/kumbukumbu.swa }
husisha { msingi/maktaba/mfuatano.swa }
husisha { msingi/maktaba/faili.swa }

// jaribu_ir.swa -- mkaguzi wa IR: kila programu iliyoorodheshwa kwenye
// majaribio/ir/WIGO.txt huendeshwa MARA MBILI -- kama msimbo wa mashine
// (`stage1 --exe`) na kupitia IR (`stage1 --tafsiri`: mteremko.swa ->
// mtafsiri.swa) -- na namba ya kutoka pamoja na stdout lazima viwe SAWA
// KABISA. Programu iliyoorodheshwa ikitoka nje ya wigo wa IR ("IR:
// haijaungwa mkono") ni SHINDWA pia: wigo hauwezi kupungua kimya.
//
//   jaribu_ir <stage1> <orodha>       (gharama/jaribu-ir.mapishi)

n32 JI_SAWA = 0;
n32 JI_SHINDWA = 0;
n8* JI_TUPU = 0;

w0 ji_elekeza(n64 fd, n8* njia) {
    kama (njia == 0) { rudisha; }
    n8* f = faili_fungua(njia, "w");
    kama (f == 0) { rudisha; }
    n32 fd_f = kishikio_kutoka_hoja(f);
    wito_wa_mfumo(33, fd_f, fd, 0, 0, 0, 0);
    sys_funga(fd_f);
}

// endesha programu (hoja hadi 3), stdout/stderr kwenda faili; kikomo cha
// muda kwa mlinzi anayeua mtoto. Rudisha namba ya kutoka (au 128+ishara).
n32 ji_endesha(n8** argv, n8** envp, n8* nje, n8* kosa, n64 sekunde) {
    n64 mtoto = sys_fork();
    kama (mtoto == 0) {
        ji_elekeza(1, nje);
        ji_elekeza(2, kosa);
        sys_execve(argv[0], argv, envp);
        wito_wa_mfumo(60, 127, 0, 0, 0, 0, 0);
    }
    n64 mlinzi = sys_fork();
    kama (mlinzi == 0) {
        sys_nanosleep_sekunde(sekunde);
        sys_kill(mtoto, 9);
        wito_wa_mfumo(60, 0, 0, 0, 0, 0, 0);
    }
    n32 hali_mtoto = 0;
    sys_wait4(mtoto, &hali_mtoto, 0);
    sys_kill(mlinzi, 9);
    n32 hali_m = 0;
    sys_wait4(mlinzi, &hali_m, 0);
    kama (sys_wait4_ulitoka_kwa_kawaida(hali_mtoto) == 0) { rudisha 128 + (hali_mtoto & 127); }
    rudisha sys_wait4_msimbo_wa_kutoka(hali_mtoto);
}

n8 ji_bafa_a[1048576];
n8 ji_bafa_b[1048576];

// faili mbili sawa kwa baiti?
n32 ji_sawa(n8* a, n8* b) {
    n64 na = faili_soma_yote(a, ji_bafa_a, 1048576);
    n64 nb = faili_soma_yote(b, ji_bafa_b, 1048576);
    kama (na != nb) { rudisha 0; }
    n64 i = 0;
    wakati (i < na) {
        kama (ji_bafa_a[i] != ji_bafa_b[i]) { rudisha 0; }
        i = i + 1;
    }
    rudisha 1;
}

w0 ji_shindwa(n8* faili, n8* sababu) {
    andika_stderr("SHINDWA (IR): %s -- %s\n", faili, sababu);
    JI_SHINDWA = JI_SHINDWA + 1;
}

w0 ji_jaribu(n8* stage1, n8* faili, n8** envp) {
    n8* argv[4];
    argv[0] = stage1;
    argv[1] = "--exe";
    argv[2] = faili;
    argv[3] = 0;
    n32 rc = ji_endesha(argv, envp, "jengo/ir-linganisha/p", "jengo/ir-linganisha/p.kosa", 60);
    kama (rc != 0) { ji_shindwa(faili, "stage1 --exe haikukusanya"); rudisha; }
    wito_wa_mfumo(90, "jengo/ir-linganisha/p", 493, 0, 0, 0, 0);  // chmod 755

    n8* argv_p[2];
    argv_p[0] = "jengo/ir-linganisha/p";
    argv_p[1] = 0;
    n32 rc_asili = ji_endesha(argv_p, envp, "jengo/ir-linganisha/asili", JI_TUPU, 10);

    argv[1] = "--tafsiri";
    n32 rc_ir = ji_endesha(argv, envp, "jengo/ir-linganisha/ir", "jengo/ir-linganisha/ir.kosa", 120);
    kama (rc_ir == 2) {
        n64 n = faili_soma_yote("jengo/ir-linganisha/ir.kosa", ji_bafa_a, 1048575);
        kama (n < 0) { n = 0; }
        ji_bafa_a[n] = 0;
        kama (tafuta_mfuatano(ji_bafa_a, "IR: haijaungwa") >= 0) {
            ji_shindwa(faili, "nje ya wigo wa IR (lakini imeorodheshwa kwenye WIGO.txt)");
            andika_stderr("%s", ji_bafa_a);
            rudisha;
        }
    }
    kama (rc_ir != rc_asili) {
        andika_stderr("SHINDWA (IR): %s -- namba ya kutoka: asili %d, IR %d\n", faili, rc_asili, rc_ir);
        JI_SHINDWA = JI_SHINDWA + 1;
        rudisha;
    }
    kama (ji_sawa("jengo/ir-linganisha/asili", "jengo/ir-linganisha/ir") == 0) {
        ji_shindwa(faili, "stdout ni tofauti");
        rudisha;
    }
    JI_SAWA = JI_SAWA + 1;
}

n8 ji_orodha[1048576];

n32 main(n32 argc, n8** argv) {
    kama (argc < 3) {
        andika_stderr("matumizi: jaribu_ir <stage1> <orodha>\n");
        rudisha 1;
    }
    n32 i = 0;
    wakati (argv[i] != 0) { i = i + 1; }
    n8** envp = argv + (i + 1);
    sys_mkdir("jengo/ir-linganisha", 493);

    n64 n = faili_soma_yote(argv[2], ji_orodha, 1048575);
    kama (n <= 0) {
        andika_stderr("jaribu_ir: orodha haisomeki: %s\n", argv[2]);
        rudisha 1;
    }
    ji_orodha[n] = 0;
    n64 p = 0;
    wakati (p < n) {
        n64 mwanzo = p;
        wakati (p < n && ji_orodha[p] != 10) { p = p + 1; }
        ji_orodha[p] = 0;
        kama (p > mwanzo && ji_orodha[mwanzo] != 35) {  // si mstari tupu wala maoni (#)
            ji_jaribu(argv[1], ji_orodha + mwanzo, envp);
        }
        p = p + 1;
    }
    andika("IR: %d sawa na msimbo wa mashine, %d zimeshindwa\n", JI_SAWA, JI_SHINDWA);
    kama (JI_SHINDWA > 0) { rudisha 1; }
    rudisha 0;
}
