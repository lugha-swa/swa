husisha { msingi/maktaba/kumbukumbu.swa }
husisha { msingi/maktaba/mfuatano.swa }
husisha { msingi/maktaba/faili.swa }

// jaribu_ir.swa -- mkaguzi wa IR: kila programu iliyoorodheshwa kwenye
// majaribio/ir/WIGO.txt huendeshwa MARA MBILI -- kama msimbo wa mashine
// (`kamili --programu`) na kupitia IR (`kamili --tafsiri`: mteremko.swa ->
// mtafsiri.swa) -- na namba ya kutoka pamoja na stdout lazima viwe SAWA
// KABISA. Programu iliyoorodheshwa ikitoka nje ya wigo wa IR ("IR:
// haijaungwa mkono") ni SHINDWA pia: wigo hauwezi kupungua kimya.
//
//   jaribu_ir <kamili> <orodha>            (gharama/jaribu-ir.mapishi)
//   jaribu_ir <kamili> <orodha> riscv64    (gharama/jaribu-riscv64.mapishi):
//     badala ya --tafsiri, `kamili --riscv64` hukusanya na qemu-riscv64
//     (kutoka PATH) huendesha -- matokeo lazima yawe sawa na x86-64.

n32 JI_SAWA = 0;
n32 JI_SHINDWA = 0;
n8* JI_TUPU = 0;

w0 ji_elekeza(n64 kishikio, n8* njia) {
    kama (njia == 0) { rudisha; }
    n8* f = faili_fungua(njia, "w");
    kama (f == 0) { rudisha; }
    n32 kishikio_cha_faili = kishikio_kutoka_hoja(f);
    wito_wa_mfumo(33, kishikio_cha_faili, kishikio, 0, 0, 0, 0);
    mfumo_funga(kishikio_cha_faili);
}

// endesha programu (hoja hadi 3), stdout/stderr kwenda faili; kikomo cha
// muda kwa mlinzi anayeua mtoto. Rudisha namba ya kutoka (au 128+ishara).
n32 ji_endesha(n8** hoja_za_mstari, n8** mazingira, n8* nje, n8* kosa, n64 sekunde) {
    n64 mchakato_mpya = mfumo_gawanyika();
    kama (mchakato_mpya == 0) {
        ji_elekeza(1, nje);
        ji_elekeza(2, kosa);
        mfumo_tekeleza_programu(hoja_za_mstari[0], hoja_za_mstari, mazingira);
        wito_wa_mfumo(60, 127, 0, 0, 0, 0, 0);
    }
    n64 mlinzi = mfumo_gawanyika();
    kama (mlinzi == 0) {
        mfumo_subiri_nano_sekunde(sekunde);
        mfumo_tuma_ishara(mchakato_mpya, 9);
        wito_wa_mfumo(60, 0, 0, 0, 0, 0, 0);
    }
    n32 hali_ya_mchakato_mpya = 0;
    mfumo_subiri4(mchakato_mpya, &hali_ya_mchakato_mpya, 0);
    mfumo_tuma_ishara(mlinzi, 9);
    n32 hali_m = 0;
    mfumo_subiri4(mlinzi, &hali_m, 0);
    kama (mfumo_subiri4_ulitoka_kwa_kawaida(hali_ya_mchakato_mpya) == 0) { rudisha 128 + (hali_ya_mchakato_mpya & 127); }
    rudisha mfumo_subiri4_msimbo_wa_kutoka(hali_ya_mchakato_mpya);
}

n8 ji_chombo_a[1048576];
n8 ji_chombo_b[1048576];

// faili mbili sawa kwa baiti?
n32 ji_sawa(n8* a, n8* b) {
    n64 na = faili_soma_yote(a, ji_chombo_a, 1048576);
    n64 nb = faili_soma_yote(b, ji_chombo_b, 1048576);
    kama (na != nb) { rudisha 0; }
    n64 i = 0;
    wakati (i < na) {
        kama (ji_chombo_a[i] != ji_chombo_b[i]) { rudisha 0; }
        i = i + 1;
    }
    rudisha 1;
}

w0 ji_shindwa(n8* faili, n8* sababu) {
    andika_kosa("SHINDWA (IR): %s -- %s\n", faili, sababu);
    JI_SHINDWA = JI_SHINDWA + 1;
}

n8* JI_QEMU = 0;          // si 0: hali ya riscv64

// tafuta programu kwenye PATH (execve haitafuti yenyewe)
n8 ji_njia_ya_qemu[512];
n8* ji_tafuta(n8** mazingira, n8* jina) {
    n64 i = 0;
    wakati (mazingira[i] != 0) {
        kama (anza_kwa_mfuatano(mazingira[i], "PATH=")) {
            n8* p = mazingira[i] + 5;
            wakati (p[0] != 0) {
                n64 n = 0;
                wakati (p[n] != 0 && p[n] != 58) { n = n + 1; }
                kama (n > 0 && n < 400) {
                    nakili(ji_njia_ya_qemu, p, n);
                    ji_njia_ya_qemu[n] = 47;
                    nakili_mfuatano(ji_njia_ya_qemu + n + 1, jina);
                    kama (wito_wa_mfumo(21, ji_njia_ya_qemu, 1, 0, 0, 0, 0) == 0) { rudisha ji_njia_ya_qemu; }
                }
                p = p + n;
                kama (p[0] == 58) { p = p + 1; }
            }
        }
        i = i + 1;
    }
    rudisha 0;
}

w0 ji_jaribu(n8* kamili, n8* faili, n8** mazingira) {
    n8* hoja_za_mstari[4];
    hoja_za_mstari[0] = kamili;
    hoja_za_mstari[1] = "--programu";
    hoja_za_mstari[2] = faili;
    hoja_za_mstari[3] = 0;
    n32 rc = ji_endesha(hoja_za_mstari, mazingira, "jengo/ir-linganisha/p", "jengo/ir-linganisha/p.kosa", 60);
    kama (rc != 0) { ji_shindwa(faili, "kamili --programu haikukusanya"); rudisha; }
    wito_wa_mfumo(90, "jengo/ir-linganisha/p", 493, 0, 0, 0, 0);  // chmod 755

    n8* hoja_mstari_p[2];
    hoja_mstari_p[0] = "jengo/ir-linganisha/p";
    hoja_mstari_p[1] = 0;
    n32 rc_asili = ji_endesha(hoja_mstari_p, mazingira, "jengo/ir-linganisha/asili", JI_TUPU, 10);

    n32 rc_ir = 0;
    kama (JI_QEMU == 0) {
        hoja_za_mstari[1] = "--tafsiri";
        rc_ir = ji_endesha(hoja_za_mstari, mazingira, "jengo/ir-linganisha/ir", "jengo/ir-linganisha/ir.kosa", 120);
    } sivyo {
        hoja_za_mstari[1] = "--riscv64";
        rc_ir = ji_endesha(hoja_za_mstari, mazingira, "jengo/ir-linganisha/rv", "jengo/ir-linganisha/ir.kosa", 60);
        kama (rc_ir == 0) {
            wito_wa_mfumo(90, "jengo/ir-linganisha/rv", 493, 0, 0, 0, 0);
            n8* hoja_rv[3];
            hoja_rv[0] = JI_QEMU;
            hoja_rv[1] = "jengo/ir-linganisha/rv";
            hoja_rv[2] = 0;
            rc_ir = ji_endesha(hoja_rv, mazingira, "jengo/ir-linganisha/ir", JI_TUPU, 30);
        }
    }
    kama (rc_ir == 2) {
        n64 n = faili_soma_yote("jengo/ir-linganisha/ir.kosa", ji_chombo_a, 1048575);
        kama (n < 0) { n = 0; }
        ji_chombo_a[n] = 0;
        kama (tafuta_mfuatano(ji_chombo_a, "IR: haijaungwa") >= 0) {
            ji_shindwa(faili, "nje ya wigo wa IR (lakini imeorodheshwa kwenye WIGO.txt)");
            andika_kosa("%s", ji_chombo_a);
            rudisha;
        }
    }
    kama (rc_ir != rc_asili) {
        andika_kosa("SHINDWA (IR): %s -- namba ya kutoka: asili %d, IR %d\n", faili, rc_asili, rc_ir);
        JI_SHINDWA = JI_SHINDWA + 1;
        rudisha;
    }
    kama (ji_sawa("jengo/ir-linganisha/asili", "jengo/ir-linganisha/ir") == 0) {
        ji_shindwa(faili, "stdout ni tofauti");
        rudisha;
    }
    JI_SAWA = JI_SAWA + 1;
}

n8 ji_orodha[1048576];

n32 anza(n32 idadi_ya_hoja_za_mstari, n8** hoja_za_mstari) {
    kama (idadi_ya_hoja_za_mstari < 3) {
        andika_kosa("matumizi: jaribu_ir <kamili> <orodha>\n");
        rudisha 1;
    }
    n32 i = 0;
    wakati (hoja_za_mstari[i] != 0) { i = i + 1; }
    n8** mazingira = hoja_za_mstari + (i + 1);
    mfumo_unda_saraka("jengo/ir-linganisha", 493);
    kama (idadi_ya_hoja_za_mstari > 3 && linganisha_mfuatano(hoja_za_mstari[3], "riscv64") == 0) {
        JI_QEMU = ji_tafuta(mazingira, "qemu-riscv64");
        kama (JI_QEMU == 0) { andika_kosa("jaribu_ir: qemu-riscv64 haipo kwenye PATH\n"); rudisha 1; }
    }

    n64 n = faili_soma_yote(hoja_za_mstari[2], ji_orodha, 1048575);
    kama (n <= 0) {
        andika_kosa("jaribu_ir: orodha haisomeki: %s\n", hoja_za_mstari[2]);
        rudisha 1;
    }
    ji_orodha[n] = 0;
    n64 p = 0;
    wakati (p < n) {
        n64 mwanzo = p;
        wakati (p < n && ji_orodha[p] != 10) { p = p + 1; }
        ji_orodha[p] = 0;
        kama (p > mwanzo && ji_orodha[mwanzo] != 35) {  // si mstari tupu wala maoni (#)
            ji_jaribu(hoja_za_mstari[1], ji_orodha + mwanzo, mazingira);
        }
        p = p + 1;
    }
    kama (JI_QEMU == 0) { andika("IR: %d sawa na msimbo wa mashine, %d zimeshindwa\n", JI_SAWA, JI_SHINDWA); }
    sivyo { andika("RISC-V 64: %d sawa na x86-64, %d zimeshindwa\n", JI_SAWA, JI_SHINDWA); }
    kama (JI_SHINDWA > 0) { rudisha 1; }
    rudisha 0;
}
