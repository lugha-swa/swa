; jaribu-mnyororo-asili.mapishi -- endesha mnyororo wa majaribio kwa Swa
; ASILIA (gharama/jaribu_mnyororo.swa: ujenzi wa stage1, fixpoint, na
; majaribio yote ya MANIFEST.txt kupitia fork/execve/wait4). Pengo la
; kuzaliwa (mbegu, msuluhishi, kutatua na kukusanya jaribu_mnyororo.swa)
; hufungwa na mjenzi -- hakuna bash.
;   ./msingi/mjenzi.bin gharama/jaribu-mnyororo-asili.mapishi
endesha msingi/mjenzi.bin gharama/mnyororo.mapishi
unganisha jengo/msuluhishi.swa msingi/maktaba/kumbukumbu.swa msingi/maktaba/mfuatano.swa msingi/maktaba/faili.swa gharama/msuluhishi.swa
endesha jengo/mbegu --exe jengo/msuluhishi.swa > jengo/msuluhishi
endesha jengo/msuluhishi gharama/jaribu_mnyororo.swa > jengo/jaribu_mnyororo.swa
endesha jengo/mbegu --exe jengo/jaribu_mnyororo.swa > jengo/jaribu_mnyororo
endesha jengo/jaribu_mnyororo jengo/mbegu jengo/msuluhishi
