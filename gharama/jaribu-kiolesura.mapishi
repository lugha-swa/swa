; jaribu-kiolesura.mapishi -- kiolesura cha mashine, awamu 1-3 (hati/kiolesura-cha-mashine.md):
; Swa inaita libm na libc kupitia kipakiaji cha mfumo, msimbo wa nje unaita
; Swa (qsort), hoja za rafu na za ziada (snprintf), data ya maktaba (optind,
; stdout), na kila mpaka ni kosa la sauti lenye ujumbe wake.
; Inahitaji libm.so.6 na libc.so.6 za mfumo -- ndizo kazi zinazoitwa.
;   ./msingi/mjenzi.bin gharama/jaribu-kiolesura.mapishi
saraka jengo
endesha msingi/mjenzi.bin gharama/jenga.mapishi > jengo/jenga.towe
saraka jengo/nje

; kazi za nje zinafanya kazi (kutoka 0 = kila ukaguzi ndani ya programu umepita)
endesha bin/swa --programu majaribio/kiolesura/hesabu.swa > jengo/nje/hesabu
endesha jengo/nje/hesabu
endesha bin/swa --programu majaribio/kiolesura/rudi.swa > jengo/nje/rudi
endesha jengo/nje/rudi
endesha bin/swa --programu majaribio/kiolesura/upangiliaji.swa > jengo/nje/upangiliaji
endesha jengo/nje/upangiliaji
endesha bin/swa --programu majaribio/kiolesura/mrundikano.swa > jengo/nje/rafu
endesha jengo/nje/rafu
endesha bin/swa --programu majaribio/kiolesura/ziada.swa > jengo/nje/ziada
endesha jengo/nje/ziada
endesha bin/swa --programu majaribio/kiolesura/data.swa > jengo/nje/data
endesha jengo/nje/data > jengo/nje/data.towe
sawa jengo/nje/data.towe majaribio/kiolesura/data.tarajiwa
endesha bin/swa --programu majaribio/kiolesura/nje_kigeu.swa > jengo/nje/nje_kigeu
endesha jengo/nje/nje_kigeu

; awamu 3: muundo kwa thamani (uainishaji wa System V) kwenye libc na libm halisi
endesha bin/swa --programu majaribio/kiolesura/miundo.swa > jengo/nje/miundo
endesha jengo/nje/miundo
endesha bin/swa --programu majaribio/kiolesura/miundo_mrundikano.swa > jengo/nje/miundo_rafu
endesha jengo/nje/miundo_rafu
endesha bin/swa --programu majaribio/kiolesura/miundo_data.swa > jengo/nje/miundo_data
endesha jengo/nje/miundo_data

; mipaka na makosa ya sintaksia: kutoka 1 na ujumbe kamili
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/alama_si_mfuatano.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/alama_si_mfuatano.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/data_alama_si_mfuatano.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/data_alama_si_mfuatano.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/data_desimali.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/data_desimali.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/data_safu.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/data_safu.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/ina_maudhui.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/ina_maudhui.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/jina_tupu.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/jina_tupu.kosa
endesha_kosa 1 bin/swa --kiini majaribio/kiolesura/makosa/kiini.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/kiini.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/marudio.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/marudio.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/maudhui_ndani.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/maudhui_ndani.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/semikoloni.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/semikoloni.kosa
endesha_kosa 1 bin/swa --tafsiri majaribio/kiolesura/makosa/tafsiri.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/tafsiri.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/tupu.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/tupu.kosa
endesha_kosa 1 bin/swa --wasm majaribio/kiolesura/makosa/wasm.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/wasm.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/ziada_d32.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/ziada_d32.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/ziada_nje_ya_nje.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/ziada_nje_ya_nje.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/ziada_si_mwisho.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/ziada_si_mwisho.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/muundo_mpangilio.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/muundo_mpangilio.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/muundo_kujaza.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/muundo_kujaza.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/muundo_ndani_mpangilio.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/muundo_ndani_mpangilio.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/muundo_mtupu.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/muundo_mtupu.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/muundo_ziada.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/muundo_ziada.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/muundo_hoja_ya_ziada.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/muundo_hoja_ya_ziada.kosa
endesha_kosa 1 bin/swa --programu majaribio/kiolesura/makosa/data_muundo_mpangilio.swa > jengo/nje/o 2> jengo/nje/o.kosa
sawa jengo/nje/o.kosa majaribio/kiolesura/makosa/data_muundo_mpangilio.kosa

andika kiolesura: kazi za nje, data na mipaka yake -- yote yamefaulu
