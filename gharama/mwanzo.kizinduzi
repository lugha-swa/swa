; mwanzo.kizinduzi -- mwanzo wa mnyororo huru bila kuamini binary yoyote
; isiyosomeka kwa jicho. Huendeshwa na mbegu ya pili:
;
;   ./msingi/kizinduzi.bin gharama/mwanzo.kizinduzi
;
; Mbegu mbili pekee zinaaminiwa: msingi/kwanza.bin (baiti 393) na
; msingi/kizinduzi.bin (baiti 839) -- zote zimeelezwa baiti kwa baiti
; (hati/kwanza-baiti.md, msingi/kizinduzi.hexc). Kutoka kwake hujengwa
; maoni, lebo, kusanyiko0, kusanyiko, kisha mjenzi kutoka CHANZO chake
; (msingi/mfululizo/mjenzi.swm). Mjenzi huo -- si msingi/mjenzi.bin --
; ndio hulinganisha vilivyogandishwa (gharama/thibitisha-mbegu.mapishi).
saraka jengo
saraka jengo/mwanzo

; hatua 0: kwanza hujijenga, na hujenga kizinduzi kutoka hex yake
msingi/kwanza.bin < msingi/kwanza.hex > jengo/mwanzo/kwanza
msingi/kwanza.bin < msingi/kizinduzi.hex > jengo/mwanzo/kizinduzi

; hatua 1-3: maoni, lebo, kusanyiko0 (makro)
msingi/kwanza.bin < msingi/mfululizo/hatua1_maoni.hex > jengo/mwanzo/maoni
jengo/mwanzo/maoni < msingi/kizinduzi.hexc > jengo/mwanzo/kizinduzi_hexc
jengo/mwanzo/maoni < msingi/mfululizo/hatua2_lebo.hexc > jengo/mwanzo/lebo
jengo/mwanzo/lebo < msingi/mfululizo/hatua3_kusanyiko0.hex2 > jengo/mwanzo/kusanyiko0

; hatua 4: kusanyiko la daraja, kisha kusanyiko kwa lugha yake
jengo/mwanzo/kusanyiko0 < msingi/mfululizo/hatua4_kusanyiko.kus > jengo/mwanzo/daraja.hex2
jengo/mwanzo/lebo < jengo/mwanzo/daraja.hex2 > jengo/mwanzo/daraja
jengo/mwanzo/daraja < msingi/mfululizo/kusanyiko.swm > jengo/mwanzo/kusanyiko

; mjenzi, mbegu na kizinduzi kutoka vyanzo vyao
jengo/mwanzo/kusanyiko < msingi/mfululizo/mjenzi.swm > jengo/mwanzo/mjenzi
jengo/mwanzo/kusanyiko < msingi/mbegu.swm > jengo/mwanzo/mbegu
jengo/mwanzo/kusanyiko < msingi/mfululizo/kizinduzi.swm > jengo/mwanzo/kizinduzi_swm

; mjenzi uliojengwa kutoka chanzo hulinganisha vilivyogandishwa
jengo/mwanzo/mjenzi gharama/thibitisha-mbegu.mapishi
