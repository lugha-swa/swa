sawa jengo/jm/bandari.hex msingi/mnyororo/majaribio/bandari.hex

; makosa ya kusanyiko: "kosa MSTARI:AINA" kwenye stderr, kutoka 1
endesha_kosa 1 jengo/kusanyiko < msingi/mnyororo/majaribio/makosa/rejista.swm > jengo/jm/o 2> jengo/jm/o.kosa
sawa jengo/jm/o.kosa msingi/mnyororo/majaribio/makosa/rejista.kosa
endesha_kosa 1 jengo/kusanyiko < msingi/mnyororo/majaribio/makosa/rex32.swm > jengo/jm/o 2> jengo/jm/o.kosa
sawa jengo/jm/o.kosa msingi/mnyororo/majaribio/makosa/rex32.kosa
endesha_kosa 1 jengo/kusanyiko < msingi/mnyororo/majaribio/makosa/mbali64.swm > jengo/jm/o 2> jengo/jm/o.kosa
sawa jengo/jm/o.kosa msingi/mnyororo/majaribio/makosa/mbali64.kosa
endesha_kosa 1 jengo/kusanyiko < msingi/mnyororo/majaribio/makosa/faili.swm > jengo/jm/o 2> jengo/jm/o.kosa
sawa jengo/jm/o.kosa msingi/mnyororo/majaribio/makosa/faili.kosa

; hatua 5: mbegu na mjenzi kutoka vyanzo vyao == vilivyogandishwa (na .hex zao)
endesha msingi/mjenzi.bin gharama/mnyororo.mapishi > jengo/jm/mnyororo.towe

; mjenzi: amri zake (PATH, mazingira, kiungo, @ SARAKA, ina), matokeo na makosa yake
endesha msingi/mjenzi.bin msingi/mnyororo/majaribio/mjenzi/andika.mapishi > jengo/jm/o 2> jengo/jm/o.kosa
sawa jengo/jm/o msingi/mnyororo/majaribio/mjenzi/andika.towe
sawa jengo/jm/o.kosa msingi/mnyororo/majaribio/mjenzi/andika.kosa
