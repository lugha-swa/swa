; jaribu-mnyororo-huru.mapishi -- majaribio ya mnyororo huru (hati/mnyororo-huru.md).
; Kila hatua hujengwa na iliyo chini yake tu, kuanzia kwanza.bin (baiti 393);
; kila kipengele na kila kosa hukaguliwa dhidi ya faili za
; msingi/mnyororo/majaribio/ (matokeo ya baiti kama .hex ya kwanza.bin).
;   ./msingi/mjenzi.bin gharama/jaribu-mnyororo-huru.mapishi

; hatua 0-4d: kila hatua hujijenga yenyewe sawa kwa baiti
endesha msingi/mjenzi.bin gharama/kusanyiko.mapishi
saraka jengo/jm

; hatua 1: maoni hujenga kwanza.bin
endesha jengo/maoni < msingi/kwanza.hex > jengo/jm/kwanza
sawa jengo/jm/kwanza msingi/kwanza.bin

; hatua 2: lebo -- :jina !rel8 %rel32 &anwani, maoni; lebo haipo -> 2, rel8 mbali -> 3
endesha jengo/lebo < msingi/mnyororo/majaribio/lebo/anwani.lebo > jengo/jm/o
hex jengo/jm/o jengo/jm/o.hex
sawa jengo/jm/o.hex msingi/mnyororo/majaribio/lebo/anwani.hex
endesha jengo/lebo < msingi/mnyororo/majaribio/lebo/nyuma.lebo > jengo/jm/o
hex jengo/jm/o jengo/jm/o.hex
sawa jengo/jm/o.hex msingi/mnyororo/majaribio/lebo/nyuma.hex
endesha jengo/lebo < msingi/mnyororo/majaribio/lebo/mbele8.lebo > jengo/jm/o
hex jengo/jm/o jengo/jm/o.hex
sawa jengo/jm/o.hex msingi/mnyororo/majaribio/lebo/mbele8.hex
endesha jengo/lebo < msingi/mnyororo/majaribio/lebo/ita.lebo > jengo/jm/o
hex jengo/jm/o jengo/jm/o.hex
sawa jengo/jm/o.hex msingi/mnyororo/majaribio/lebo/ita.hex
endesha jengo/lebo < msingi/mnyororo/majaribio/lebo/maoni.lebo > jengo/jm/o
hex jengo/jm/o jengo/jm/o.hex
sawa jengo/jm/o.hex msingi/mnyororo/majaribio/lebo/maoni.hex
endesha_kosa 2 jengo/lebo < msingi/mnyororo/majaribio/lebo/haipo.lebo > jengo/jm/o
endesha_kosa 3 jengo/lebo < msingi/mnyororo/majaribio/lebo/mbali.lebo > jengo/jm/o

; hatua 3: kusanyiko0 -- FAFANUA, !N %N ^N, mifuatano, lebo; tokeni isiyojulikana -> 4
endesha jengo/kusanyiko0 < msingi/mnyororo/majaribio/kusanyiko0/makro.kus > jengo/jm/o.hex2
endesha jengo/lebo < jengo/jm/o.hex2 > jengo/jm/o
hex jengo/jm/o jengo/jm/o.hex
sawa jengo/jm/o.hex msingi/mnyororo/majaribio/kusanyiko0/makro.hex
endesha jengo/kusanyiko0 < msingi/mnyororo/majaribio/kusanyiko0/namba.kus > jengo/jm/o.hex2
endesha jengo/lebo < jengo/jm/o.hex2 > jengo/jm/o
hex jengo/jm/o jengo/jm/o.hex
sawa jengo/jm/o.hex msingi/mnyororo/majaribio/kusanyiko0/namba.hex
endesha jengo/kusanyiko0 < msingi/mnyororo/majaribio/kusanyiko0/mfuatano.kus > jengo/jm/o.hex2
endesha jengo/lebo < jengo/jm/o.hex2 > jengo/jm/o
hex jengo/jm/o jengo/jm/o.hex
sawa jengo/jm/o.hex msingi/mnyororo/majaribio/kusanyiko0/mfuatano.hex
endesha jengo/kusanyiko0 < msingi/mnyororo/majaribio/kusanyiko0/lebo.kus > jengo/jm/o.hex2
endesha jengo/lebo < jengo/jm/o.hex2 > jengo/jm/o
hex jengo/jm/o jengo/jm/o.hex
sawa jengo/jm/o.hex msingi/mnyororo/majaribio/kusanyiko0/lebo.hex
endesha jengo/kusanyiko0 < msingi/mnyororo/majaribio/kusanyiko0/maoni.kus > jengo/jm/o.hex2
endesha jengo/lebo < jengo/jm/o.hex2 > jengo/jm/o
hex jengo/jm/o jengo/jm/o.hex
sawa jengo/jm/o.hex msingi/mnyororo/majaribio/kusanyiko0/maoni.hex
endesha_kosa 4 jengo/kusanyiko0 < msingi/mnyororo/majaribio/kusanyiko0/haijulikani.kus > jengo/jm/o
endesha_kosa 4 jengo/kusanyiko0 < msingi/mnyororo/majaribio/kusanyiko0/namba_mbaya.kus > jengo/jm/o

; hatua 4: programu za kusanyiko zinaendeshwa (daraja na kusanyiko kujijenga)
endesha jengo/daraja < msingi/mnyororo/majaribio/habari.swm > jengo/jm/habari
endesha jengo/jm/habari > jengo/jm/habari.towe
sawa jengo/jm/habari.towe msingi/mnyororo/majaribio/habari.towe
