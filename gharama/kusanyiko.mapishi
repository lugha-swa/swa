; kusanyiko.mapishi -- mnyororo huru kutoka baiti 393 za mkono hadi
; kusanyiko (assembler ya lugha ya mashine ya Swa), kila hatua ikijijenga
; yenyewe sawa kwa baiti. Matokeo: jengo/kusanyiko. Hati: hati/mnyororo-huru.md
saraka jengo

; 0: kwanza (baiti 393) hujijenga yenyewe
endesha msingi/kwanza.bin < msingi/kwanza.hex > jengo/kwanza
sawa jengo/kwanza msingi/kwanza.bin

; 1: maoni
endesha msingi/kwanza.bin < msingi/mnyororo/hatua1_maoni.hex > jengo/maoni
endesha jengo/maoni < msingi/mnyororo/hatua1_maoni.hexc > jengo/maoni2
sawa jengo/maoni jengo/maoni2

; 2: lebo
endesha jengo/maoni < msingi/mnyororo/hatua2_lebo.hexc > jengo/lebo
endesha jengo/lebo < msingi/mnyororo/hatua2_lebo.hex2 > jengo/lebo2
sawa jengo/lebo jengo/lebo2

; 3: kusanyiko0 (makro)
endesha jengo/lebo < msingi/mnyororo/hatua3_kusanyiko0.hex2 > jengo/kusanyiko0
endesha jengo/kusanyiko0 < msingi/mnyororo/hatua3_kusanyiko0.kus > jengo/kusanyiko0.hex2
endesha jengo/lebo < jengo/kusanyiko0.hex2 > jengo/kusanyiko0b
sawa jengo/kusanyiko0 jengo/kusanyiko0b

; 4: kusanyiko la daraja (.kus), kisha kusanyiko kwa lugha yake (4d)
endesha jengo/kusanyiko0 < msingi/mnyororo/hatua4_kusanyiko.kus > jengo/daraja.hex2
endesha jengo/lebo < jengo/daraja.hex2 > jengo/daraja
endesha jengo/daraja < msingi/mnyororo/kusanyiko.swm > jengo/kusanyiko
endesha jengo/kusanyiko < msingi/mnyororo/kusanyiko.swm > jengo/kusanyiko2
sawa jengo/kusanyiko jengo/kusanyiko2
