; kusanyiko.mapishi -- mfululizo huru kutoka baiti 393 za mkono hadi
; kusanyiko (assembler ya lugha ya mashine ya Swa), kila hatua ikijijenga
; yenyewe sawa kwa baiti. Matokeo: jengo/kusanyiko. Hati: hati/mfululizo-huru.md
saraka jengo

; 0: kwanza (baiti 393) hujijenga yenyewe
endesha msingi/kwanza.bin < msingi/kwanza.heksa > jengo/kwanza
sawa jengo/kwanza msingi/kwanza.bin

; 1: maoni
endesha msingi/kwanza.bin < msingi/mfululizo/hatua1_maoni.heksa > jengo/maoni
endesha jengo/maoni < msingi/mfululizo/hatua1_maoni.maoni > jengo/maoni2
sawa jengo/maoni jengo/maoni2

; 2: mahali
endesha jengo/maoni < msingi/mfululizo/hatua2_mahali.maoni > jengo/mahali
endesha jengo/mahali < msingi/mfululizo/hatua2_mahali.mahali > jengo/mahali2
sawa jengo/mahali jengo/mahali2

; 3: kusanyiko0 (makro)
endesha jengo/mahali < msingi/mfululizo/hatua3_kusanyiko0.mahali > jengo/kusanyiko0
endesha jengo/kusanyiko0 < msingi/mfululizo/hatua3_kusanyiko0.kus > jengo/kusanyiko0.mahali
endesha jengo/mahali < jengo/kusanyiko0.mahali > jengo/kusanyiko0b
sawa jengo/kusanyiko0 jengo/kusanyiko0b

; 4: kusanyiko la mpito (.kus), kisha kusanyiko kwa lugha yake (4d)
endesha jengo/kusanyiko0 < msingi/mfululizo/hatua4_kusanyiko.kus > jengo/mpito.mahali
endesha jengo/mahali < jengo/mpito.mahali > jengo/mpito
endesha jengo/mpito < msingi/mfululizo/kusanyiko.swm > jengo/kusanyiko
endesha jengo/kusanyiko < msingi/mfululizo/kusanyiko.swm > jengo/kusanyiko2
sawa jengo/kusanyiko jengo/kusanyiko2
