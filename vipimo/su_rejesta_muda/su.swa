// Kipimo cha SU (Sethi-Ullman, ugawaji wa rejesta za vigezo vya muda):
// usemi wa haja=3 unaosoma safu (kuzuia LICM kuhamisha nje ya
// kitanzi), unaorudiwa mara nyingi ndani ya kitanzi kimoja cha kazi
// moja -- hali BORA zaidi kwa SU (gharama ya kuhifadhi/kurudisha
// rejesta za ziada, MARA MOJA kwenye utangulizi/mwisho, inasambazwa
// juu ya matumizi milioni kadhaa).
husisha { msingi/maktaba/kumbukumbu.swa }

n32 arr[4];
n64 N_JUMLA = 20000000;

n64 hesabu() {
    n64 jumla = 0;
    n64 i = 0;
    wakati (i < N_JUMLA) {
        jumla = jumla + (((arr[0] + arr[1]) + arr[2]) + arr[3]);
        i = i + 1;
    }
    rudisha jumla;
}

n32 main() {
    arr[0] = 1; arr[1] = 2; arr[2] = 3; arr[3] = 4;
    n64 r = hesabu();
    andika("jumla=%d\n", r, 0, 0, 0, 0, 0);
    rudisha 0;
}
