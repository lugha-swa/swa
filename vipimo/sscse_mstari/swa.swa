// Kipimo maalum cha SSCSE (CSE ya mstari-moja-kwa-moja): kitanzi
// kizito ambamo "i*i" hutokea MARA MBILI kwa kila mzunguko (h1 na h2)
// -- SIYO invariant (i inabadilika kila mzunguko), hivyo LICM
// haiwezi kuigusa kabisa; ni straight-line ndani ya mwili wa kitanzi
// (hakuna tawi kati ya h1 na h2), hivyo SSCSE inapaswa kuishiriki
// mara moja kwa kila mzunguko badala ya kuikokotoa mara mbili.
husisha { msingi/maktaba/kumbukumbu.swa }

n32 N_KIPIMO = 50000000;

n32 main() {
    n32 suma1 = 0;
    n32 suma2 = 0;
    n32 i = 0;
    wakati (i < N_KIPIMO) {
        n32 h1 = i * i + i;
        n32 h2 = i * i - i;
        suma1 = suma1 + h1;
        suma2 = suma2 + h2;
        i = i + 1;
    }
    andika("suma1=%d suma2=%d\n", suma1, suma2, 0, 0, 0, 0);
    rudisha 0;
}
