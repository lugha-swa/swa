husisha { msingi/maktaba/kumbukumbu.swa }

// mchujo -- Mchujo wa Eratosthenes: safu moja kubwa ya n8, mwandiko
// mwingi wa mfuatano (si usomaji wa row/column kama matriki) --
// muundo tofauti wa ufikiaji wa kumbukumbu.

n32 N_KIPIMO = 25000000;

n32 main() {
    n32 n = N_KIPIMO;
    n8* mchujo = tenga(n + 1);
    weka_sifuri(mchujo, n + 1);
    mchujo[0] = 1;
    mchujo[1] = 1;
    n32 i = 2;
    wakati (i * i <= n) {
        kama (mchujo[i] == 0) {
            n32 j = i * i;
            wakati (j <= n) {
                mchujo[j] = 1;
                j = j + i;
            }
        }
        i = i + 1;
    }
    n32 idadi_kuu = 0;
    i = 0;
    wakati (i <= n) {
        kama (mchujo[i] == 0) { idadi_kuu = idadi_kuu + 1; }
        i = i + 1;
    }
    andika("idadi_kuu=%d\n", idadi_kuu, 0, 0, 0, 0, 0);
    rudisha 0;
}
