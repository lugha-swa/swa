// Kipimo maalum cha zidisho-na-uchawi: kigawanyaji cha kudumu 7 (SI
// nguvu ya 2, hivyo idiv ya asili ndiyo pekee iliyokuwepo KABLA ya
// kazi hii) ndani ya kitanzi kizito -- hakuna kipimo kilichopo
// kinachotumia mgawanyo/modulo ya kigawanyaji-si-nguvu-ya-2 kwenye
// mzunguko mzito (angalia MATOKEO.md) -- kipimo hiki kimeundwa
// MAKUSUDI kujaza pengo hilo.
husisha { msingi/maktaba/kumbukumbu.swa }

n32 N_KIPIMO = 50000000;

n32 main() {
    n32 jumla_q = 0;
    n32 jumla_r = 0;
    n32 i = 0;
    wakati (i < N_KIPIMO) {
        jumla_q = jumla_q + (i / 7);
        jumla_r = jumla_r + (i % 7);
        i = i + 1;
    }
    andika("jumla_q=%d jumla_r=%d\n", jumla_q, jumla_r, 0, 0, 0, 0);
    rudisha 0;
}
