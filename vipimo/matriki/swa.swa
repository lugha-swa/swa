husisha { msingi/maktaba/kumbukumbu.swa }

n32 N_KIPIMO = 300;

n32 main() {
    n32 n = N_KIPIMO;
    d64* a = tenga(ukubwa(d64) * n * n);
    d64* b = tenga(ukubwa(d64) * n * n);
    d64* c = tenga(ukubwa(d64) * n * n);

    n32 i = 0;
    wakati (i < n) {
        n32 j = 0;
        wakati (j < n) {
            d64 vi = i;
            d64 vj = j;
            a[i * n + j] = (vi + vj) * 0.5;
            b[i * n + j] = (vi - vj) * 0.25;
            c[i * n + j] = 0.0;
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    wakati (i < n) {
        n32 k = 0;
        wakati (k < n) {
            d64 aik = a[i * n + k];
            n32 j = 0;
            wakati (j < n) {
                c[i * n + j] = c[i * n + j] + aik * b[k * n + j];
                j = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }

    n32 c00_i = c[0];
    n32 cmid_i = c[(n / 2) * n + (n / 2)];
    n32 clast_i = c[n * n - 1];
    andika("c00=%d cmid=%d clast=%d\n", c00_i, cmid_i, clast_i, 0, 0, 0);
    rudisha 0;
}
