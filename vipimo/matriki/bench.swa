husisha { msingi/maktaba/kumbukumbu.swa }

N32 N = 300;

N32 main() {
    N32* a = tenga(N * N * 4);
    N32* b = tenga(N * N * 4);
    N32* c = tenga(N * N * 4);
    N32 i = 0;
    wakati (i < N * N) {
        a[i] = (i % 97) + 1;
        b[i] = (i % 89) + 1;
        c[i] = 0;
        i = i + 1;
    }
    i = 0;
    wakati (i < N) {
        N32 j = 0;
        wakati (j < N) {
            N32 jumla = 0;
            N32 k = 0;
            wakati (k < N) {
                jumla = jumla + a[i * N + k] * b[k * N + j];
                k = k + 1;
            }
            c[i * N + j] = jumla;
            j = j + 1;
        }
        i = i + 1;
    }
    N64 hesabu = 0;
    i = 0;
    wakati (i < N * N) {
        hesabu = hesabu + c[i];
        i = i + 1;
    }
    andika("hesabu=%d c00=%d\n", hesabu, c[0], 0, 0, 0, 0);
    rudisha 0;
}
