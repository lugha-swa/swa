// Kipimo cha SIMD (kinacho-STAHILI SSE2): c[i] = a[i] + b[i] kwa d64,
// urefu mkubwa, kinarudiwa mara nyingi ili kupata muda unaopimika.
// Linganisha na scalar_msingi.swa (hesabu ile ile, muundo TOFAUTI wa
// mwili wa kitanzi kimakusudi ili kuukwepa uvektishaji) kwa kulinganisha
// halisi ya "kabla/baada" ndani ya mkusanyaji uleule.
husisha { msingi/maktaba/kumbukumbu.swa }

n32 N = 2000000;
n32 REPS = 60;

n32 main() {
    d64* a = tenga(ukubwa(d64) * N);
    d64* b = tenga(ukubwa(d64) * N);
    d64* c = tenga(ukubwa(d64) * N);
    n32 i = 0;
    wakati (i < N) {
        a[i] = i;
        b[i] = i * 2;
        i = i + 1;
    }
    n32 r = 0;
    wakati (r < REPS) {
        i = 0;
        wakati (i < N) {
            c[i] = a[i] + b[i];
            i = i + 1;
        }
        r = r + 1;
    }
    d64 sum = 0;
    i = 0;
    wakati (i < N) {
        sum = sum + c[i];
        i = i + 1;
    }
    n32 y = sum / 1000000000;
    rudisha y;
}
