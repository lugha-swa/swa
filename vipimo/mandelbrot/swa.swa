husisha { msingi/maktaba/kumbukumbu.swa }

// mandelbrot -- kitanzi kigumu cha d64 bila shinikizo la kumbukumbu
// (hakuna ugawaji wowote wa arena) -- tofauti na matriki (ambayo pia
// ni d64 lakini na usomaji/uandishi mwingi wa safu), hapa ni
// hesabu safi kwenye vigezo vya ndani tu.

n32 UKUBWA = 600;
n32 KIWANGO_JUU = 200;

n32 anza() {
    n64 jumla_marudio = 0;
    n32 py = 0;
    wakati (py < UKUBWA) {
        n32 px = 0;
        wakati (px < UKUBWA) {
            d64 px_desimali = px;
            d64 py_desimali = py;
            d64 ukubwa_desimali = UKUBWA;
            d64 x0 = ((px_desimali * 3.5) / ukubwa_desimali) - 2.5;
            d64 y0 = ((py_desimali * 2.0) / ukubwa_desimali) - 1.0;
            d64 x = 0.0;
            d64 y = 0.0;
            n32 marudio = 0;
            n32 hai_bado = 1;
            wakati (marudio < KIWANGO_JUU && hai_bado == 1) {
                d64 x2 = x * x;
                d64 y2 = y * y;
                kama ((x2 + y2) > 4.0) {
                    hai_bado = 0;
                } sivyo {
                    d64 xt = (x2 - y2) + x0;
                    y = (2.0 * x * y) + y0;
                    x = xt;
                    marudio = marudio + 1;
                }
            }
            jumla_marudio = jumla_marudio + marudio;
            px = px + 1;
        }
        py = py + 1;
    }
    andika("jumla_iter=%d\n", jumla_marudio, 0, 0, 0, 0, 0);
    rudisha 0;
}
