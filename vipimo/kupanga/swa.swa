husisha { msingi/maktaba/kumbukumbu.swa }

n32 N_JUMLA = 1000000;

n64 lcg_hali = 12345;

n32 nasibu_ijayo() {
    lcg_hali = (lcg_hali * 1103515245 + 12345) % 2147483648;
    rudisha lcg_hali;
}

w0 badilishana(n32* safu, n32 i, n32 j) {
    n32 t = safu[i];
    safu[i] = safu[j];
    safu[j] = t;
}

n32 gawanya(n32* safu, n32 chini, n32 juu) {
    n32 mhimili = safu[juu];
    n32 i = chini - 1;
    n32 j = chini;
    wakati (j < juu) {
        kama (safu[j] <= mhimili) {
            i = i + 1;
            badilishana(safu, i, j);
        }
        j = j + 1;
    }
    badilishana(safu, i + 1, juu);
    rudisha i + 1;
}

w0 pangaharaka(n32* safu, n32 chini, n32 juu) {
    kama (chini < juu) {
        n32 p = gawanya(safu, chini, juu);
        pangaharaka(safu, chini, p - 1);
        pangaharaka(safu, p + 1, juu);
    }
}

n32 anza() {
    n32* safu = tenga(ukubwa(n32) * N_JUMLA);
    n32 i = 0;
    wakati (i < N_JUMLA) {
        safu[i] = nasibu_ijayo();
        i = i + 1;
    }

    pangaharaka(safu, 0, N_JUMLA - 1);

    n32 sahihi = 1;
    i = 0;
    wakati (i < N_JUMLA - 1) {
        kama (safu[i] > safu[i + 1]) { sahihi = 0; }
        i = i + 1;
    }

    andika("sahihi=%d kwanza=%d katikati=%d mwisho=%d\n", sahihi, safu[0], safu[N_JUMLA / 2], safu[N_JUMLA - 1], 0, 0);
    rudisha 0;
}
