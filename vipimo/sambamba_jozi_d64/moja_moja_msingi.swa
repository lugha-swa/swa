// Kipimo cha msingi (scalar, KIMAKUSUDI hakistahili SSE2): hesabu ile
// ile kabisa na kwa_vekta.swa (c[i]=a[i]+b[i], N na REPS sawa), lakini
// maudhui ya mzunguko yana TAARIFA TATU (tmp ya ziada) badala ya mbili
// hasa, ikikataliwa na simd_jaribu_mzunguko kimakusudi. Hii ndiyo
// linganisho la "kabla" la haki zaidi ndani ya mkusanyaji uleule --
// tofauti na kulinganisha na msimbo wa toleo la zamani la mkusanyaji.
husisha { msingi/maktaba/kumbukumbu.swa }

n32 N = 2000000;
n32 MARUDIO = 60;

n32 anza() {
    d64* a = tenga(ukubwa(d64) * N);
    d64* b = tenga(ukubwa(d64) * N);
    d64* c = tenga(ukubwa(d64) * N);
    n32 i = 0;
    wakati (i < N) {
        a[i] = i;
        b[i] = i * 2;
        i = i + 1;
    }
    n32 r = 0;
    wakati (r < MARUDIO) {
        i = 0;
        wakati (i < N) {
            d64 muda = a[i];
            c[i] = muda + b[i];
            i = i + 1;
        }
        r = r + 1;
    }
    d64 jumla = 0;
    i = 0;
    wakati (i < N) {
        jumla = jumla + c[i];
        i = i + 1;
    }
    n32 y = jumla / 1000000000;
    rudisha y;
}
