// Kipimo cha kashe mpya ya anwani (ugawaji wa kawaida, si kiwanja):
// c[i] = c[i] + a[i]*b[i], D64, safu ndefu, marudio mengi ya kitanzi
// kizima ili kupata muda unaopimika.
husisha { msingi/maktaba/kumbukumbu.swa }

N32 N = 2000000;

N32 main() {
    D64* a = tenga(ukubwa(D64) * N);
    D64* b = tenga(ukubwa(D64) * N);
    D64* c = tenga(ukubwa(D64) * N);
    N32 i = 0;
    wakati (i < N) {
        a[i] = 1.5;
        b[i] = 2.0;
        c[i] = 0.0;
        i = i + 1;
    }
    N32 rudio = 0;
    wakati (rudio < 20) {
        i = 0;
        wakati (i < N) {
            c[i] = c[i] + a[i] * b[i];
            i = i + 1;
        }
        rudio = rudio + 1;
    }
    N32 out = c[0];
    andika("c0=%d\n", out, 0, 0, 0, 0, 0);
    rudisha 0;
}
