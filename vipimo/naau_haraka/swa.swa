// Kipimo cha cmp+jcc ya moja kwa moja ndani ya && -- hakuna kipimo
// kilichopo kinachotumia && / || (kimethibitishwa kwa grep kabla ya
// kuandika hiki), hivyo kipimo hiki kipya kinajenga muundo halisi
// unaoegemea sharti la mchanganyiko: kitanzi cha ndani kikiendelea
// TU pale i<n NA j<m -- muundo wa kawaida wa "clamped nested bound"
// unaoonekana kwenye misimbo halisi (mfano: kupitia gridi yenye
// mipaka miwili tofauti).
husisha { msingi/maktaba/kumbukumbu.swa }

N32 N_KIPIMO = 4000;

N32 main() {
    N32 n = N_KIPIMO;
    N32 m = N_KIPIMO;
    N64 jumla = 0;
    N32 i = 0;
    wakati (i < n) {
        N32 j = 0;
        wakati (j < m && i < n) {
            jumla = jumla + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    N32 j32 = jumla;
    andika("jumla=%d\n", j32, 0, 0, 0, 0, 0);
    rudisha 0;
}
