husisha { ../../msingi/maktaba/kumbukumbu.swa }
husisha { ../../msingi/maktaba/mfuatano.swa }
husisha { ../../msingi/mkusanyaji/msomaji.swa }

n32 main() {
    n8* s = "abc def";
    Msomaji ms = msomaji_mpya(s, 7);
    Msomaji* m = &ms;

    n8 c = m->chanzo[m->nafasi];
    n64 urefu = 0;
    kama (ni_alfabeti(c)) {
        n64 anza = m->nafasi;
        wakati (msomaji_imeisha(m) == 0) {
            n8 ch2 = m->chanzo[m->nafasi];
            kama (ni_alfabeti_tarakimu(ch2) == 0) { vunja; }
            m->nafasi = m->nafasi + 1;
            m->safu = m->safu + 1;
        }
        urefu = m->nafasi - anza;
    }

    n32 n32 = m->nafasi;
    n32 u32 = urefu;
    andika("; nafasi=%d urefu=%d (expect 3 3)\n", n32, u32);
    rudisha 0;
}
