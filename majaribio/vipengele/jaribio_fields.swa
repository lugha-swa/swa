husisha { ../../msingi/maktaba/kumbukumbu.swa }
husisha { ../../msingi/maktaba/mfuatano.swa }
husisha { ../../msingi/mkusanyaji/msomaji.swa }
husisha { ../../msingi/mkusanyaji/msambazaji.swa }

n32 main() {
    n8* s = "N32 f";
    n64 u = 5;
    Msambazaji p = msambazaji_mpya(s, u);

    n32 a1 = p.sasa.aina;
    n32 c1 = p.sasa.mwanzo[0];
    n32 u1 = p.sasa.urefu;
    andika("; sasa: a=%d c=%d u=%d\n", a1, c1, u1);

    n32 a2 = p.inayofuata.aina;
    n32 c2 = p.inayofuata.mwanzo[0];
    n32 u2 = p.inayofuata.urefu;
    andika("; inayo: a=%d c=%d u=%d\n", a2, c2, u2);

    sogeza(&p);

    n32 a3 = p.sasa.aina;
    n32 c3 = p.sasa.mwanzo[0];
    n32 u3 = p.sasa.urefu;
    andika("; sasa2: a=%d c=%d u=%d\n", a3, c3, u3);

    rudisha 0;
}
