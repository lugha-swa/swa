husisha { ../../msingi/maktaba/kumbukumbu.swa }
husisha { ../../msingi/maktaba/mfuatano.swa }
husisha { ../../msingi/mkusanyaji/msomaji.swa }

n32 main() {
    n8 c = 40;
    n32 r = 0;
    kama (c == 59 || c == 44 || c == 58 || c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125) {
        r = 1;
    }
    andika("; result=%d (expect 1)\n", r);

    c = 41;
    r = 0;
    kama (c == 59 || c == 44 || c == 58 || c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125) {
        r = 1;
    }
    andika("; result=%d (expect 1)\n", r);

    rudisha 0;
}
