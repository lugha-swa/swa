husisha { ../../msingi/maktaba/kumbukumbu.swa }
husisha { ../../msingi/maktaba/mfuatano.swa }
husisha { ../../msingi/mkusanyaji/msomaji.swa }

n32 main() {
    n8* s = "N32 f() { rudisha 1; }";
    n64 u = 22;
    Msomaji ms = msomaji_mpya(s, u);

    Tokeni t;
    n32 i = 0;
    wakati (i < 10) {
        tokeni_inayofuata(&t, &ms);
        kama (t.aina == 6) { andika("; T%d: MWISHO\n", i); vunja; }
        n32 ca = t.aina;
        n32 cc = t.mwanzo[0];
        andika("; T%d: a=%d c=%d\n", i, ca, cc);
        i = i + 1;
    }
    rudisha 0;
}
