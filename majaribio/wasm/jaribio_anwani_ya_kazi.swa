// WASM Awamu 4: &kazi ni faharisi ya kazi kwenye jedwali (Table 0),
// kwa mpangilio wa kazi kwenye chanzo: kwanza=0, pili=1, main=2.
// Moduli lazima ithibitishwe ikiwa na Table + Element + export ya
// "jedwali".
n32 kwanza() { rudisha 1; }
n32 pili() { rudisha 2; }
n32 anza() {
    n32 a = &pili;
    n32 b = &kwanza;
    rudisha a * 10 + b;
}
