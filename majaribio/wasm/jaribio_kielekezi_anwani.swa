// WASM Awamu 2: &arr[idx] -- anwani ya kipengele cha safu, kisha
// kuandika kupitia kielekezi hicho, na kusoma tena kupitia arr[idx]
// ya kawaida -- lazima ionyeshe kumbukumbu ILE ILE.
n32 main() {
    n32* arr = tenga(3 * 4);
    arr[0] = 1;
    arr[1] = 2;
    arr[2] = 3;

    n32* q = &arr[1];
    *q = 99;

    rudisha arr[0] + arr[1] + arr[2];
}
