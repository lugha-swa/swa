// WASM Awamu 1: kazi yenye paramu tatu, na kazi W0 (tupu) inayoitwa
// kama taarifa -- thibitisha wito-kama-taarifa haitoi "drop" kwa
// kazi isiyorudisha thamani (mdudu halisi uliopatikana: "not enough
// arguments on the stack for drop").
n32 jumlisha(n32 a, n32 b, n32 c) {
    rudisha a + b + c;
}
w0 kazi_tupu(n32 x) {
    n32 y = x * 2;
}
n32 main() {
    kazi_tupu(5);
    rudisha jumlisha(1, 2, 3);
}
