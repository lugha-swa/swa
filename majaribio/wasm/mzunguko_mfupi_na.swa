// WASM Awamu 1: && (mzunguko mfupi) -- matawi yote mawili ya kweli,
// ikitolewa kama if(i32)/else inayorudisha 0/1 (angalia maelezo ya
// usanifu kwenye uzalishaji_wasm.swa, Sehemu 5).
n32 main() {
    n32 a = 3;
    n32 b = 4;
    kama (a > 0 && b > 0) {
        rudisha 1;
    }
    rudisha 0;
}
