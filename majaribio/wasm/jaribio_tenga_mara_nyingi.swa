// WASM Awamu 2: tenga() ikiitwa mara kadhaa mfululizo -- kila
// utengaji lazima uwe eneo TOFAUTI la kumbukumbu (bump allocator
// isije ikatoa anwani ile ile mara mbili/kuandika juu ya iliyopita).
n32 main() {
    n32* a = tenga(4);
    n32* b = tenga(4);
    n32* c = tenga(4);
    a[0] = 100;
    b[0] = 200;
    c[0] = 300;
    rudisha a[0] + b[0] + c[0];
}
