// WASM Awamu 2: safu ya n32 (kupitia tenga() + n32* + p[i]) -- jaza
// mraba wa faharasa (0,1,4,9,16), rudisha ptr. kimbiza.js (aina=safu)
// husoma i32 tano kutoka kwenye kumbukumbu na kulinganisha moja
// kwa moja.
n32 main() {
    n32* arr = tenga(5 * 4);
    n32 i = 0;
    wakati (i < 5) {
        arr[i] = i * i;
        i = i + 1;
    }
    rudisha arr;
}
