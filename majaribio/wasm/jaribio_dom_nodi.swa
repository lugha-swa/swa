// WASM Awamu 3: mti wa kina 2 -- "ul" (mzazi) + "li" mbili (watoto),
// mmoja akiwa na sifa "class"="kipengele" na maandishi, mwingine
// maandishi tu bila sifa. Thibitisha (kimbiza.swa, aina=dom) mti
// mzima (kina, sifa, maandishi, mpangilio wa watoto) ni sahihi.
husisha { kivinjari.swa }

n32 anza() {
    n32 nodi_ya_programu = dom_nodi_kuu();
    n32 ul1 = dom_unda("ul");
    dom_ambatanisha(nodi_ya_programu, ul1);

    n32 li1 = dom_unda("li");
    dom_weka_sifa(li1, "class", "kipengele");
    dom_weka_maandishi(li1, "kwanza");
    dom_ambatanisha(ul1, li1);

    n32 li2 = dom_unda("li");
    dom_weka_maandishi(li2, "pili");
    dom_ambatanisha(ul1, li2);

    rudisha 0;
}
