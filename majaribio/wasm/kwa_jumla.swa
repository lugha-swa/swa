// WASM Awamu 1: kwa (for) -- msambazaji.swa huibadilisha kuwa
// AST_WAKATI wakati wa uchanganuzi, hivyo hii inathibitisha
// ubadilishaji (desugaring) unafanya kazi sahihi na WASM, ikiwemo
// nafasi ya "hatua" (block la ndani la "endelea" linalofunga kabla
// ya hatua -- angalia wasm_wakati na wasm_ina_hatua).
n32 main() {
    n32 jumla = 0;
    kwa (n32 i = 0; i < 10; i = i + 1) {
        jumla = jumla + i;
    }
    rudisha jumla;
}
