// WASM Awamu 4: vigezo vya ulimwengu ni WASM Globals (ya ulimwengu 1..N;
// 0 ni lundo la tenga). Hali inadumu kati ya wito wa kazi tofauti --
// ndicho kinachohitajika kwa matukio. Pia: ya ndani yenye jina sawa
// hufunika kigezo cha ulimwengu ndani ya kazi yake tu.
n32 g = 5;
n32 jumla;
n32 ongeza(n32 n) {
    jumla = jumla + n;
    rudisha jumla;
}
n32 funika() {
    n32 g = 1000;
    rudisha g;
}
n32 anza() {
    ongeza(10);
    ongeza(g);
    g = g + 2;
    rudisha jumla + g + funika() - 1000;
}
