// WASM Awamu 1: wakati + endelea (continue) -- thibitisha kina cha
// "br" kinacholenga MWANZO wa loop (angalia sharti tena, si vunja).
n32 main() {
    n32 i = 0;
    n32 jumla = 0;
    wakati (i < 10) {
        i = i + 1;
        kama (i % 2 == 0) { endelea; }
        jumla = jumla + i;
    }
    rudisha jumla;
}
