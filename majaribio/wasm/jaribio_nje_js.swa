// Kiolesura cha mashine, awamu 4: `nje` ndani ya --wasm huwa uingizaji wa
// WASM (moduli "js", alama "namba"/"kwa_namba"/...). Hutumia kiolesura cha
// jumla moja kwa moja, bila kivinjari.swa: namba huenda JS na kurudi,
// mfuatano huwa kitu cha JS chenye urefu wake.
nje "js" {
    n32 js_namba(n32 n) = "namba";
    n32 js_kwa_namba(n32 kitu) = "kwa_namba";
    n32 js_mfuatano(n8* s) = "mfuatano";
    n32 js_pata(n32 kitu, n8* sifa) = "pata";
    w0 js_achilia(n32 kitu) = "achilia";
}

n32 anza() {
    n32 h = js_namba(37);
    n32 n = js_kwa_namba(h);
    js_achilia(h);
    n32 m = js_mfuatano("hodi!");
    n32 urefu = js_pata(m, "length");
    n32 u = js_kwa_namba(urefu);
    js_achilia(urefu);
    js_achilia(m);
    rudisha n + u;
}
