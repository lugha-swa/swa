// WASM Awamu 1: wito wa kazi (call) na kujirudia (recursion) --
// thibitisha faharisi za "call" na pasi ya locals inayovuka mipaka
// ya kazi (kila kazi ina jedwali lake la locals tofauti).
n32 fact(n32 n) {
    kama (n <= 1) { rudisha 1; }
    rudisha n * fact(n - 1);
}
n32 main() {
    rudisha fact(5);
}
