// WASM Awamu 1: kwa + endelea -- jaribio LA MUHIMU ZAIDI kwa
// usahihi wa hatua: "endelea" ndani ya kwa LAZIMA bado iendeshe hatua
// (i=i+1), la sivyo kitanzi hakiishi kamwe (semantiki ya C). Kama
// block la ndani la "hatua" halifungwa sahihi, jaribio hili
// huning'inia (timeout) badala ya kutoa jibu baya -- angalia
// wasm_wakati/wasm_ina_hatua kwenye uzalishaji_wasm.swa.
n32 main() {
    n32 jumla = 0;
    kwa (n32 i = 0; i < 10; i = i + 1) {
        kama (i % 2 == 1) { endelea; }
        jumla = jumla + i;
    }
    rudisha jumla;
}
