// WASM Awamu 1: namba hasi (0 - 5) -- thibitisha i32.const na
// i32.sub kwa thamani hasi (SLEB128 kwenye i32.const ya moja kwa
// moja huathiri tu namba HALISI hasi za chanzo, si matokeo ya
// hesabu -- hapa "0 - 5" ni JUMLISHA/TOFAUTI ya kawaida).
n32 main() {
    n32 x = 0 - 5;
    rudisha x + 10;
}
