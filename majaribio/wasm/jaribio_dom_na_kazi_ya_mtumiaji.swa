// WASM Awamu 3: JARIBIO LA KUDUMU LA REGRESSION KWA FAHARISI ZA WITO
// -- programu inayoita KAZI YA MTUMIAJI (mara_mbili), tenga(), NA
// dom_unda/dom_weka_sifa/dom_ambatanisha ZOTE PAMOJA. Kama nyongeza
// ya wasm_import_idadi ikikosekana MAHALI POPOTE (wito wa kazi ya
// ndani, faharisi ya aina kwenye Function section, au faharisi ya
// export ya main), matokeo yatatofautiana: ima WebAssembly.validate
// itakataa moduli (aina/faharisi zisizolingana), au mara_mbili(21)
// itatoa jibu lisilo 42 (ikiita kazi isiyo sahihi), au mti wa DOM
// utakuwa mtupu/tofauti kabisa (main halisi haikuwahi kutekelezwa).
n32 mara_mbili(n32 x) {
    rudisha x * 2;
}

n32 main() {
    n32 mzizi = dom_mzizi();

    n32* buf = tenga(4);
    buf[0] = 21;

    n32 matokeo = mara_mbili(buf[0]);

    n32 div1 = dom_unda("div");
    kama (matokeo == 42) {
        dom_weka_sifa(div1, "hali", "sahihi");
    } sivyo {
        dom_weka_sifa(div1, "hali", "kosa");
    }
    dom_ambatanisha(mzizi, div1);

    rudisha 0;
}
