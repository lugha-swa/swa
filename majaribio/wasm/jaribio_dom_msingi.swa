// WASM Awamu 3: dom_unda + dom_weka_maandishi + dom_ambatanisha --
// unda "div" MOJA, weka maandishi, ambatanisha kwenye mzizi. Thibitisha
// (kimbiza.js, aina=dom) mti wa dom_mock una nodi 1 yenye maandishi
// sahihi.
n32 main() {
    n32 mzizi = dom_mzizi();
    n32 div1 = dom_unda("div");
    dom_weka_maandishi(div1, "hodi");
    dom_ambatanisha(mzizi, div1);
    rudisha 0;
}
