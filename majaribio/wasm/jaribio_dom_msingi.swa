// WASM Awamu 3: dom_unda + dom_weka_maandishi + dom_ambatanisha --
// unda "div" MOJA, weka maandishi, ambatanisha kwenye nodi kuu. Thibitisha
// (kimbiza.js, aina=dom) mti wa dom_bandia una nodi 1 yenye maandishi
// sahihi.
husisha { kivinjari.swa }

n32 anza() {
    n32 nodi_ya_programu = dom_nodi_kuu();
    n32 div1 = dom_unda("div");
    dom_weka_maandishi(div1, "hodi");
    dom_ambatanisha(nodi_ya_programu, div1);
    rudisha 0;
}
