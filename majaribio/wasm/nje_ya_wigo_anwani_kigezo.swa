// WASM (HASI, Awamu 2): '&kigezo_cha_ndani' (anwani ya LOCAL variable
// ya kawaida, si &arr[idx]/&*ptr) iko nje ya wigo kwa MAKUSUDI -- WASM
// "locals" hazina anwani ya kumbukumbu kabisa (tofauti na x86-64's
// rbp-offset stack slots), hivyo '&x' kwa kigezo cha kawaida
// haiwezekani bila "kuhamisha" kigezo hicho kwenda kumbukumbu badala
// ya WASM local (kazi kubwa zaidi, nje ya wigo wa Awamu 2 -- angalia
// mpango). '&arr[idx]'/'&*ptr' (kielekezi tayari kinachoelekeza
// kumbukumbu) VINAFANYA KAZI (angalia jaribio_kielekezi_anwani.swa).
n32 main() {
    n32 x = 5;
    n32* q = &x;
    rudisha *q;
}
