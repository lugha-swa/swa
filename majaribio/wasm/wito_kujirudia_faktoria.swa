// WASM Awamu 1: wito wa kazi (call) na kujirudia (recursion) --
// thibitisha faharisi za "call" na pasi ya vigeu vya ndani inayovuka mipaka
// ya kazi (kila kazi ina jedwali lake la vigeu vya ndani tofauti).
n32 faktoria(n32 n) {
    kama (n <= 1) { rudisha 1; }
    rudisha n * faktoria(n - 1);
}
n32 anza() {
    rudisha faktoria(5);
}
