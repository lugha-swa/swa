// WASM Awamu 1: wakati + vunja (break) -- thibitisha kina cha "br"
// kinacholenga NJE ya block la nje (kutoka kabisa kwenye kitanzi).
n32 main() {
    n32 i = 0;
    n32 jumla = 0;
    wakati (i < 100) {
        kama (i >= 5) { vunja; }
        jumla = jumla + i;
        i = i + 1;
    }
    rudisha jumla;
}
