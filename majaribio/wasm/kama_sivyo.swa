// WASM Awamu 1: kama/sivyo yenye "rudisha" ya wazi kwenye matawi
// YOTE MAWILI -- hii ndiyo iliyofichua mdudu wa uthibitishaji wa
// WASM ("expected 1 elements on the stack for fallthru"): fallthru
// ya kazi inahitaji thamani hata kama mantiki haiwezi kufikia hapo
// (angalia "unreachable" kabla ya mwisho wa kazi, uzalishaji_wasm.swa).
n32 main() {
    n32 x = 10;
    kama (x > 5) {
        rudisha 1;
    } sivyo {
        rudisha 0;
    }
}
