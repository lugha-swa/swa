husisha { maktaba/kumbukumbu.swa }
husisha { maktaba/mfuatano.swa }
n32 fib(n32 n) {
    kama (n < 2) { rudisha n; }
    rudisha fib(n - 1) + fib(n - 2);
}
n32 G = 5;
n32 jedwali[10];
n32 anza() {
    n32 s = 0;
    kwa (n32 i = 0; i < 10; i = i + 1) {
        kama (i == 3) { endelea; }
        jedwali[i] = i * i;
        s += jedwali[i];
    }
    andika("s=%d fib=%d G=%d %s %c%%\n", s, fib(15), G, "habari", 65);
    n8* p = "abc";
    kama (p[1] != 98) rudisha 99;
    rudisha s % 256;
}
