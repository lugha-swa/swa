// Daraja la mashine, awamu 3: data ya maktaba yenye aina ya muundo.
// in6addr_loopback na in6addr_any ni `struct in6_addr` (baiti 16) za
// libc. R_X86_64_COPY hunakili baiti zote 16 ndani ya kigezo cha Swa --
// ukubwa wa alama ukiwa mdogo, nusu ya pili ingebaki sifuri.
muundo Anwani6 { n64 juu; n64 chini; }
nje "libc.so.6" {
    Anwani6 kitanzi6 = "in6addr_loopback";
    Anwani6 yoyote6 = "in6addr_any";
}
n32 main() {
    // ::1 -- baiti ya 15 ni 1, yaani baiti ya juu ya n64 ya pili
    kama (kitanzi6.juu != 0) { rudisha 1; }
    kama (kitanzi6.chini != 72057594037927936) { rudisha 2; }
    kama (yoyote6.juu != 0 || yoyote6.chini != 0) { rudisha 3; }
    rudisha 0;
}
