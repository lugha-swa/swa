// Daraja la mashine: kazi za libm zinaitwa kwa majina ya Kiswahili.
// Hoja na matokeo ya d64 hupita kwenye xmm0/xmm1 (System V).
nje "libm.so.6" {
    d64 kosini(d64 pembe) = "cos";
    d64 kipeo(d64 msingi, d64 kiwango) = "pow";
    d64 mzizi_mraba(d64 x) = "sqrt";
}

n32 main() {
    kama (kosini(0.0) != 1.0) { rudisha 1; }
    kama (kipeo(2.0, 10.0) != 1024.0) { rudisha 2; }
    kama (mzizi_mraba(144.0) != 12.0) { rudisha 3; }
    rudisha 0;
}
