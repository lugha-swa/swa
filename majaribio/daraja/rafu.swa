// Daraja la mashine, awamu 2: kichwa cha kudumu chenye hoja za rafu
// (namba 9: 6 za rejesta, 3 rafuni) -- kipande hunakili sloti 3.
husisha { kumbukumbu.swa }
nje "libc.so.6" {
    n32 tisa(n8* chombo, n64 ukubwa, n8* umbo, n64 a, n64 b, n64 c, n64 d, n64 e, n64 f) = "snprintf";
    n32 linganisha_c(n8* a, n8* b) = "strcmp";
}
n32 main() {
    n8* b = tenga(128);
    tisa(b, 128, "%ld-%ld-%ld-%ld-%ld-%ld", 1, 2, 3, 4, 5, 6);
    kama (linganisha_c(b, "1-2-3-4-5-6") != 0) { andika("[%s]\n", b); rudisha 1; }
    rudisha 0;
}
