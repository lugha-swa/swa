// Huthibitisha vga_herufi(usemi) inaandika herufi ILIYOKOKOTOLEWA
// WAKATI WA KUKIMBIA (SI halisi ya wakati wa kukusanya) -- kila
// herufi ya "ABC" inatokana na 65+i ndani ya mzunguko, i ikibadilika
// kila mzunguko; vga_andika() (halisi, halisi pekee) haiwezi
// kufanya hivi kabisa. rudisha jumla ya i (0+1+2=3) kupitia RDI.
n32 anza() {
    n32 i = 0;
    n32 jumla = 0;
    wakati (i < 3) {
        vga_herufi(65 + i);
        jumla = jumla + i;
        i = i + 1;
    }
    rudisha jumla;
}
