// Mende: n64 hasi (-90) ilikuwa ikipanuliwa kwa SIFURI badala ya
// ishara — n64 x = -90 ilitoa 4294967206 (0xFFFFFFA6 upanuzi wa
// sifuri). Hati 2.3 inaahidi nambari kamili za n64 — thamani lazima
// ibaki -90 (upana kamili wa ishara).
n32 main() {
    n64 x = -90;
    kama (x == -90) { rudisha 0; }
    rudisha 1;
}
