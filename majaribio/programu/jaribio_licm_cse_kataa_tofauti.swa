// LICM CSE: kesi hasi -- "i*n" (fahirisi ya c) na "i*m" (fahirisi ya
// d) zinafanana KIMUUNDO (kitambulisho * kitambulisho) lakini SI
// SAWA (majina tofauti ya kigezo cha pili: n dhidi ya m) -- CSE
// LAZIMA IKATAE kuzishiriki kigezo kimoja cha muda, la sivyo matokeo
// yangekuwa MABAYA (c na d zingesoma/kuandika fahirisi isiyo sahihi).
husisha { msingi/maktaba/kumbukumbu.swa }

n32 main() {
    n32 n = 5;
    n32 m = 8;
    n32* c = tenga(ukubwa(n32) * n * n);
    n32* d = tenga(ukubwa(n32) * m * n);
    n32 i = 0;
    wakati (i < n * n) { c[i] = 0; i = i + 1; }
    i = 0;
    wakati (i < m * n) { d[i] = 0; i = i + 1; }

    i = 0;
    wakati (i < n) {
        n32 j = 0;
        wakati (j < n) {
            c[i * n + j] = 1;
            d[i * m + j] = 2;
            j = j + 1;
        }
        i = i + 1;
    }

    n32 k = 0;
    wakati (k < n * n) {
        kama (c[k] != 1) { rudisha 100 + k; }
        k = k + 1;
    }
    k = 0;
    wakati (k < n) {
        n32 jj = 0;
        wakati (jj < n) {
            kama (d[k * m + jj] != 2) { rudisha 200 + k; }
            jj = jj + 1;
        }
        k = k + 1;
    }
    rudisha 0;
}
