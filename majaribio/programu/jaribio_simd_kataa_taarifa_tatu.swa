// Uvektishaji (SIMD): kesi hasi -- mwili wa kitanzi una TAARIFA TATU
// (si mbili hasa), hivyo muundo HAUKUBALIWI -- njia ya kawaida ya
// scalar lazima iendelee kutoa matokeo sahihi. c[i]=a[i]+b[i], kisha
// jumla ya c[i] zote inahifadhiwa kwenye sum (d64), i += 1.
husisha { maktaba/kumbukumbu.swa }
n32 main() {
    n32 n = 8;
    d64* a = tenga(ukubwa(d64) * n);
    d64* b = tenga(ukubwa(d64) * n);
    d64* c = tenga(ukubwa(d64) * n);
    n32 i = 0;
    wakati (i < n) {
        a[i] = i;
        b[i] = 1;
        i = i + 1;
    }
    d64 sum = 0;
    i = 0;
    wakati (i < n) {
        c[i] = a[i] + b[i];
        sum = sum + c[i];
        i = i + 1;
    }
    // a[i]=i, b[i]=1 => c[i]=i+1, i=0..7 => sum = 8+ (0+1+...+7) = 8+28 = 36
    kama (sum != 36) { rudisha 1; }
    rudisha 0;
}
