// inl_msingi: jaribio la msingi la usukaji wa kazi ndogo (function
// inlining). "hifadhi" ni kazi ya w0, mstari ulionyooka, bila
// tangazo za ndani, inayogusa PARAMU ZAKE PEKEE -- inastahili
// kuunganishwa. Thibitisho ni matokeo halisi ya hesabu (yaliyokokotolewa
// kwa mkono hapa chini), si tu "haianguki".
w0 hifadhi(n32* mahali, n32 thamani) {
    *mahali = thamani + 1;
}

n32 main() {
    n32 a;
    n32 b;
    hifadhi(&a, 10);
    hifadhi(&b, 99);
    kama (a != 11) { rudisha 1; }
    kama (b != 100) { rudisha 2; }
    rudisha 0;
}
