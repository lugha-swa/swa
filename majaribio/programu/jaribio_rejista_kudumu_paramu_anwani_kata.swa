// Ugawaji wa rejesta, awamu ya 2 (paramu) -- paramu ambayo anwani
// yake INACHUKULIWA (&x) mahali fulani ndani ya kazi LAZIMA ibaki
// kwenye rafu (kama ilivyokuwa) -- rejesta haina anwani, hivyo
// kuipuuza hapa kungesababisha uandishi kupitia kielekezi kutoathiri
// thamani halisi inayotumika. Thamani halisi: 5+100=105.
w0 ongeza_kupitia_kielekezi(n32* p) {
    *p = *p + 100;
}

n32 jaribu(n32 x) {
    ongeza_kupitia_kielekezi(&x);
    rudisha x;
}

n32 main() {
    rudisha jaribu(5);
}
