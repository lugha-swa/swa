// LICM: kesi chanya ya msingi -- "a * b" ni usemi usiobadilika (a,b
// hazibadilishwi popote ndani ya mwili) unaotumika kama RHS kamili ya
// taarifa ya ugawaji ndani ya mzunguko. Lazima ihamishwe nje ya
// mzunguko na bado itoe matokeo sahihi: a*b=12, mzunguko 20 ->
// sum=240.
n32 anza() {
    n32 a = 3;
    n32 b = 4;
    n32 jumla = 0;
    n32 i = 0;
    wakati (i < 20) {
        jumla = jumla + (a * b);
        i = i + 1;
    }
    rudisha jumla;
}
