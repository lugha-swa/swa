// jaribio_mende_ulimwengu_muundo: muundo wa ulimwengu — sehemu kwa
// nukta (andika na soma) na kupitia kielekezi. Kabla: kusoma sehemu
// kulipakua baiti za kwanza za muundo kama anwani (SEGV 139); mbegu
// inakataa miundo ya ulimwengu kwa sauti — stage1 pekee.
// Inatarajiwa: 19 (12 + 7)
muundo Nukta { n32 x; n32 y; };
Nukta ulimwengu;

n32 main() {
    ulimwengu.x = 7;
    ulimwengu.y = 5;
    n32 soma = ulimwengu.x + ulimwengu.y;  // 12
    Nukta* p = &ulimwengu;
    p->x = 3;
    p->y = 4;
    n32 kielekezi = p->x + p->y;  // 7
    rudisha soma + kielekezi;
}
