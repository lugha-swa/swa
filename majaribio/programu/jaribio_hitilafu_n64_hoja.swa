// Hitilafu: halisi kubwa kama hoja ya wito ilikuwa ikiharibu mfululizo wa
// hoja -- alama ya "n64 literal" ilikuwa ikiishi kwenye tatu_ya_nodi, ambayo
// pia ni kiungo cha mfululizo wa hoja (wito ulikataliwa kwa kosa lisilo
// sahihi au hoja ikakatwa). Hati 2.3 inaahidi n64 -- hoja lazima ifike
// kamili (4294967296 + 4294967296 = 8589934592).
n64 jumlisha(n64 a, n64 b) { rudisha a + b; }
n32 anza() {
    n64 s = jumlisha(4294967296, 4294967296);
    kama (s == 8589934592) { rudisha 0; }
    rudisha 1;
}
