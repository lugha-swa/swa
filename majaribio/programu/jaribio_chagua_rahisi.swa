// chagua rahisi: hali mbili + kuanguka hadi rudisha ya mwisho.
// (kamili pekee; awali haijui neno la chagua.)
n32 kadiria(n32 x) {
    chagua (x) {
        hali 1: rudisha 10;
        hali 2: rudisha 20;
    }
    rudisha 0;
}

n32 anza() {
    kama (kadiria(1) != 10) rudisha 1;
    kama (kadiria(2) != 20) rudisha 2;
    kama (kadiria(9) != 0) rudisha 3;
    rudisha 0;
}
