// Hoja ya KWANZA ya wito wa kawaida haipiti rafuni (mov rdi, rax; desimali
// inabaki xmm0). Hoja nyingine, wito wa kielekezi, miundo, na wito ulioota
// ndani ya hoja lazima ziendelee kufanya kazi.
husisha { msingi/maktaba/kumbukumbu.swa }

muundo Jozi { n32 a; n32 b; };
muundo Kubwa { n32 a; n32 b; n32 c; n32 d; };

n32 moja(n32 x) { rudisha x + 1; }
n64 moja64(n64 x) { rudisha x + 1; }
n32 mbili(n32 a, n32 b) { rudisha a * 10 + b; }
n32 tatu(n32 a, n32 b, n32 c) { rudisha a * 100 + b * 10 + c; }
n32 nane(n32 a, n32 b, n32 c, n32 d, n32 e, n32 f, n32 g, n32 h) {
    rudisha a * 10000000 + b * 1000000 + c * 100000 + d * 10000 + e * 1000 + f * 100 + g * 10 + h;
}
d64 dmoja(d64 x) { rudisha x * 2.0; }
d64 dmbili(d64 a, d64 b) { rudisha a * 10.0 + b; }
d64 mchanganyiko(n32 a, d64 x, n32 b, d64 y) { rudisha a * 1000.0 + x * 100.0 + b * 10.0 + y; }
d64 mchanganyiko2(d64 x, n32 a, d64 y, n32 b) { rudisha x * 1000.0 + a * 100.0 + y * 10.0 + b; }
d32 fmoja(d32 x) { rudisha x + 0.5; }
n32 pointa(n32* p) { rudisha p[1]; }
n32 muundo_jumla(Jozi z) { rudisha z.a * 10 + z.b; }
n32 muundo_na_namba(n32 k, Jozi z) { rudisha k * 100 + z.a * 10 + z.b; }
n32 namba_na_muundo(Jozi z, n32 k) { rudisha k * 100 + z.a * 10 + z.b; }

Jozi tengeneza(n32 a, n32 b) { Jozi z; z.a = a; z.b = b; rudisha z; }
Jozi tengeneza1(n32 a) { Jozi z; z.a = a; z.b = a + 1; rudisha z; }

n32 kubwa_jumla(Kubwa k) { rudisha k.a * 1000 + k.b * 100 + k.c * 10 + k.d; }
n32 kubwa_na_namba(n32 n, Kubwa k, n32 m) { rudisha n * 100000 + kubwa_jumla(k) * 10 + m; }
n32 kubwa_mbili(n32 n, Kubwa k, Kubwa l) { rudisha n * 100000 + kubwa_jumla(k) * 10 + kubwa_jumla(l); }

n32 g_hesabu = 0;
n32 athari(n32 x) { g_hesabu = g_hesabu * 10 + x; rudisha x; }

n32 jaribu_namba() {
    kama (moja(41) != 42) { rudisha 1; }
    kama (mbili(4, 2) != 42) { rudisha 2; }
    kama (tatu(1, 2, 3) != 123) { rudisha 3; }
    kama (nane(1, 2, 3, 4, 5, 6, 7, 8) != 12345678) { rudisha 4; }
    n32 a = 0 - 5;
    kama (moja(a) != (0 - 4)) { rudisha 5; }                 // hasi: upanuzi wa ishara
    n64 w = 5000000000;
    kama (moja64(w) != 5000000001) { rudisha 6; }
    kama (moja64(0 - 3) != (0 - 2)) { rudisha 7; }
    n32* p = tenga(ukubwa(n32) * 4);
    p[0] = 7; p[1] = 9;
    kama (pointa(p) != 9) { rudisha 8; }
    kama (moja(moja(moja(1))) != 4) { rudisha 9; }           // wito ndani ya hoja
    kama (mbili(moja(1), moja(2)) != 23) { rudisha 10; }
    kama (tatu(moja(0), mbili(1, 2), moja(moja(0))) != 100 + 120 + 2) { rudisha 11; }
    rudisha 0;
}

// Mpangilio wa tathmini: kulia kwenda kushoto, hoja ya kwanza MWISHO
n32 jaribu_mpangilio() {
    g_hesabu = 0;
    n32 r = tatu(athari(1), athari(2), athari(3));   // athari(3), (2), (1)
    kama (r != 123) { rudisha 1; }
    kama (g_hesabu != 321) { rudisha 2; }
    g_hesabu = 0;
    r = mbili(athari(4), athari(5));
    kama (g_hesabu != 54) { rudisha 3; }
    g_hesabu = 0;
    r = moja(athari(6) + athari(7));
    kama (g_hesabu != 76) { rudisha 4; }
    rudisha 0;
}

n32 jaribu_desimali() {
    kama (dmoja(1.5) != 3.0) { rudisha 1; }
    kama (dmbili(1.0, 2.0) != 12.0) { rudisha 2; }
    kama (mchanganyiko(1, 2.0, 3, 4.0) != 1234.0) { rudisha 3; }
    kama (mchanganyiko2(1.0, 2, 3.0, 4) != 1234.0) { rudisha 4; }
    n32 i = 3;
    kama (dmoja(i) != 6.0) { rudisha 5; }                   // namba kamili kuwa desimali
    kama (fmoja(1.5) != 2.0) { rudisha 6; }
    d64 x = 0.25;
    kama (dmoja(dmoja(x)) != 1.0) { rudisha 7; }
    kama (dmbili(dmoja(x), dmoja(dmoja(x))) != 6.0) { rudisha 8; }   // 0.5*10 + 1
    rudisha 0;
}

n32 jaribu_kielekezi_cha_kazi() {
    n8* f = &moja;
    kama (f(9) != 10) { rudisha 1; }
    n8* g = &mbili;
    kama (g(4, 2) != 42) { rudisha 2; }
    n8* h = &tatu;
    kama (h(moja(0), 2, moja(2)) != 123) { rudisha 3; }
    rudisha 0;
}

n32 jaribu_miundo() {
    Jozi z;
    z.a = 3; z.b = 4;
    Jozi t = tengeneza(6, 7);
    kama (t.a != 6 || t.b != 7) { rudisha 4; }
    Jozi u = tengeneza1(8);
    kama (u.a != 8 || u.b != 9) { rudisha 5; }
    kama (muundo_jumla(z) != 34) { rudisha 1; }
    kama (muundo_na_namba(5, z) != 534) { rudisha 2; }
    kama (namba_na_muundo(z, 5) != 534) { rudisha 3; }
    rudisha 0;
}

// Mazingira: hoja ya kwanza haipaswi kuharibiwa na tathmini ya hoja
// nyingine (rdi haiharibiki baada ya mov)
n32 jaribu_kubwa() {
    Kubwa k;
    k.a = 1; k.b = 2; k.c = 3; k.d = 4;
    Kubwa l;
    l.a = 5; l.b = 6; l.c = 7; l.d = 8;
    kama (kubwa_jumla(k) != 1234) { rudisha 1; }
    kama (kubwa_na_namba(9, k, 5) != 900000 + 12340 + 5) { rudisha 2; }
    kama (kubwa_mbili(3, k, l) != 300000 + 12340 + 5678) { rudisha 3; }
    rudisha 0;
}

n32 jaribu_hoja_ngumu() {
    n32 a = 1; n32 b = 2; n32 c = 3; n32 d = 4;
    kama (tatu(a + b, c * d, a - d) != 300 + 120 + (0 - 3)) { rudisha 1; }
    kama (mbili(a, mbili(b, mbili(c, d))) != 10 + 2 * 10 + 3 * 10 + 4) { rudisha 2; }
    rudisha 0;
}

n32 main() {
    n32 r = jaribu_namba();
    kama (r != 0) { rudisha 10 + r; }
    r = jaribu_mpangilio();
    kama (r != 0) { rudisha 30 + r; }
    r = jaribu_desimali();
    kama (r != 0) { rudisha 50 + r; }
    r = jaribu_kielekezi_cha_kazi();
    kama (r != 0) { rudisha 70 + r; }
    r = jaribu_miundo();
    kama (r != 0) { rudisha 80 + r; }
    r = jaribu_kubwa();
    kama (r != 0) { rudisha 100 + r; }
    r = jaribu_hoja_ngumu();
    kama (r != 0) { rudisha 90 + r; }
    rudisha 0;
}
