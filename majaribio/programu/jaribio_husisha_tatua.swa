// jaribio_husisha_tatua.swa — mkusanyaji (stage1) anatatua mstari wa
// "husisha { maktaba/mfuatano.swa }" mwenyewe: msingi/maktaba/mfuatano.swa
// na msingi/maktaba/kumbukumbu.swa zinaingizwa kabla ya chanzo hiki,
// bila zana ya nje. (Stage1 pekee: mbegu inasoma kwenye saraka ya
// faili pekee na kuacha mstari huo — "kazi haijafafanuliwa".)
husisha { maktaba/mfuatano.swa }
n32 main() {
    n64 n = urefu_wa_mfuatano("habari");
    kama (n == 6) { rudisha 0; }
    rudisha 1;
}
