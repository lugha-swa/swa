// jaribio_mende_muundo_hoja_kubwa: muundo mkubwa (>8B) kwa thamani
// kama hoja. Kabla: baiti zaidi ya 8 zilipotea kimya (1 badala ya 6)
// au SEGV. Sasa hupitishwa kwa rejea na nakala (semantiki ya thamani).
// Inatarajiwa: 6 (1 + 2 + 3)
muundo Tatu { n32 a; n32 b; n32 c; };

n32 jumlisha(Tatu t) {
    rudisha t.a + t.b + t.c;
}

n32 main() {
    Tatu t;
    t.a = 1;
    t.b = 2;
    t.c = 3;
    rudisha jumlisha(t);
}
