// Zidisho-na-uchawi kesi hasi -- kila mojawapo lazima kikatae kikamilifu
// na kuendelea kutumia idiv/div ya asili (TAYARI sahihi), likitoa
// matokeo sahihi -- HAKUNA "uboreshaji wa sehemu".
//
// (1) BILA ISHARA d=7: fomula "round-up" haipatikani ikiwa na M
//     inayotoshea biti 32 (M ingehitaji biti 33 -- hatua ya "ongeza"
//     isiyotekelezwa kwa makusudi kwa njia hii, angalia maelezo makuu
//     juu ya uzalishaji_gawanya). gwm_tafuta_uchawi_bila_ishara
//     inarudisha 0, idiv inatumika.
// (2) Kigawanyaji > 65536: nje ya wigo (angalia gwm_thamani_kudumu_ndogo).
// (3) Kigawanyaji SI wa kudumu (kigezo cha wakati wa kukimbia, hata
//     kikiwa na thamani ya nguvu-si-ya-2 inayojulikana wakati wa
//     kukimbia): haiwezekani kutambua wakati wa kukusanya.
// (4) n64 (upana wa 64-bit): nje ya wigo kabisa (angalia WIGO #1 --
//     n64 haiguswi hata ikiwa kigawanyaji ni kidogo na kizuri).

n32 jaribu_bila_ishara_saba() {
    a32 y = 100;
    a32 dv = 7;
    a32 qf = y / 7;
    a32 qs = y / dv;
    a32 rf = y % 7;
    a32 rs = y % dv;
    kama (qf != qs) { rudisha 1; }
    kama (rf != rs) { rudisha 2; }
    kama (qf != 14) { rudisha 3; }
    kama (rf != 2) { rudisha 4; }
    rudisha 0;
}

n32 jaribu_kigawanyaji_mkubwa() {
    n32 x = 0 - 70000;
    n32 dv = 70000;
    kama (x / 70000 != x / dv) { rudisha 1; }
    kama (x % 70000 != x % dv) { rudisha 2; }
    kama (x / 70000 != (0 - 1)) { rudisha 3; }
    rudisha 0;
}

n32 jaribu_kigawanyaji_sio_kudumu() {
    n32 dv = 10;  // nguvu-si-ya-2 lakini SI namba halisi moja kwa moja
    n32 x = 0 - 37;
    kama (x / dv != (0 - 3)) { rudisha 1; }
    kama (x % dv != (0 - 7)) { rudisha 2; }
    rudisha 0;
}

n32 jaribu_n64() {
    n64 x = 0 - 100000;
    n64 dv = 10;
    n64 qf = x / 10;
    n64 qs = x / dv;
    kama (qf != qs) { rudisha 1; }
    kama (qf != (0 - 10000)) { rudisha 2; }
    rudisha 0;
}

n32 main() {
    n32 r;
    r = jaribu_bila_ishara_saba();
    kama (r != 0) { rudisha 100 + r; }
    r = jaribu_kigawanyaji_mkubwa();
    kama (r != 0) { rudisha 200 + r; }
    r = jaribu_kigawanyaji_sio_kudumu();
    kama (r != 0) { rudisha 300 + r; }
    r = jaribu_n64();
    kama (r != 0) { rudisha 400 + r; }
    rudisha 0;
}
