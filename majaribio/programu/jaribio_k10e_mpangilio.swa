// mpangilio.swa -- Shughuli za kupanga safu za nambari
//
// Hutoa kazi za kupanga safu kwa mpangilio wa kupanda na kushuka.
// Inatumia aina ya kiputo (bubble sort) kwa urahisi na usahihi.

// Panga safu ya n32 kwa mpangilio wa kupanda.
w0 pangilia_n32(n32* safu, n32 idadi) {
    kama (idadi <= 1) {
        rudisha;
    }
    n32 i = 0;
    wakati (i < idadi - 1) {
        n32 j = 0;
        wakati (j < idadi - i - 1) {
            kama (safu[j] > safu[j + 1]) {
                n32 muda = safu[j];
                safu[j] = safu[j + 1];
                safu[j + 1] = muda;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

// Panga safu ya n32 kwa mpangilio wa kushuka.
w0 pangilia_n32_kushuka(n32* safu, n32 idadi) {
    kama (idadi <= 1) {
        rudisha;
    }
    n32 i = 0;
    wakati (i < idadi - 1) {
        n32 j = 0;
        wakati (j < idadi - i - 1) {
            kama (safu[j] < safu[j + 1]) {
                n32 muda = safu[j];
                safu[j] = safu[j + 1];
                safu[j + 1] = muda;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

// Panga safu ya n64 kwa mpangilio wa kupanda.
w0 pangilia_n64(n64* safu, n32 idadi) {
    kama (idadi <= 1) {
        rudisha;
    }
    n32 i = 0;
    wakati (i < idadi - 1) {
        n32 j = 0;
        wakati (j < idadi - i - 1) {
            kama (safu[j] > safu[j + 1]) {
                n64 muda = safu[j];
                safu[j] = safu[j + 1];
                safu[j + 1] = muda;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

// Panga safu ya n64 kwa mpangilio wa kushuka.
w0 pangilia_n64_kushuka(n64* safu, n32 idadi) {
    kama (idadi <= 1) {
        rudisha;
    }
    n32 i = 0;
    wakati (i < idadi - 1) {
        n32 j = 0;
        wakati (j < idadi - i - 1) {
            kama (safu[j] < safu[j + 1]) {
                n64 muda = safu[j];
                safu[j] = safu[j + 1];
                safu[j + 1] = muda;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}
n32 anza() {
    n32 safu[5];
    safu[0] = 50;
    safu[1] = 30;
    safu[2] = 10;
    safu[3] = 40;
    safu[4] = 20;

    // Panga kwa kupanda
    pangilia_n32(safu, 5);
    kama (safu[0] != 10) rudisha 1;
    kama (safu[1] != 20) rudisha 2;
    kama (safu[2] != 30) rudisha 3;
    kama (safu[3] != 40) rudisha 4;
    kama (safu[4] != 50) rudisha 5;

    // Panga kwa kushuka
    pangilia_n32_kushuka(safu, 5);
    kama (safu[0] != 50) rudisha 6;
    kama (safu[1] != 40) rudisha 7;
    kama (safu[2] != 30) rudisha 8;
    kama (safu[3] != 20) rudisha 9;
    kama (safu[4] != 10) rudisha 10;

    rudisha 0;
}
