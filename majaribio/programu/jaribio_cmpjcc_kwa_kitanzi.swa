// cmp+jcc ya moja kwa moja: sharti la kitanzi cha "kwa" (for) --
// uzalishaji_wakati inashughulikia wakati NA kwa kwa nodi ile ile
// (AST_WAKATI, kianzio kiko ast_tiga), hivyo njia mpya ya haraka
// lazima ifanye kazi kwa vyote viwili. i=0..9, jumla ya i>5
// inayotarajiwa: 6,7,8,9 => 4 mizunguko.
n32 main() {
    n32 i;
    n32 idadi = 0;
    kwa (i = 0; i < 10; i = i + 1) {
        kama (i > 5) { idadi = idadi + 1; }
    }
    kama (idadi != 4) { rudisha 1; }
    rudisha 0;
}
