// cmp+jcc ya moja kwa moja: usemi WA ULINGANISHI HUO HUO (kimuundo)
// unaotumika PANDE MBILI tofauti ndani ya kazi moja -- mara moja
// kama thamani ya kawaida (inayohitaji cmp;setcc;movzx -- njia ya
// jumla, HAIJAGUSWA) na mara nyingine kama sharti la moja kwa moja
// la kama/kama-sivyo (njia mpya ya haraka). Zote mbili ni nodi
// TOFAUTI za AST (uchanganuzi tofauti wa "a < c" mara mbili) --
// lazima ziendelee kutoa matokeo sahihi bila kuathiriana.
n32 main() {
    n32 a = 3;
    n32 c = 7;

    // (1) Njia ya jumla: b lazima iwe 1 (a<c ni kweli)
    n32 b = a < c;
    kama (b != 1) { rudisha 1; }

    // (2) Usemi mchanganyiko unaotumia matokeo ya ulinganishi tatu
    // ndani ya hesabu (njia ya jumla, si sharti la moja kwa moja)
    n32 jumla = (a < c) + (a > c) + (a == c);
    kama (jumla != 1) { rudisha 2; }

    // (3) Njia ya haraka: sharti la moja kwa moja, na tawi la sivyo
    kama (a < c) {
        // sahihi -- endelea
    } sivyo {
        rudisha 3;
    }

    // (4) Njia ya haraka bila tawi la sivyo, kwenye kitanzi
    n32 mzunguko_idadi = 0;
    n32 i = 0;
    wakati (i < 4) {
        mzunguko_idadi = mzunguko_idadi + 1;
        i = i + 1;
    }
    kama (mzunguko_idadi != 4) { rudisha 4; }

    rudisha 0;
}
