// inl_ukubwa: kazi yenye taarifa nyingi zaidi ya INL_KIKOMO_TAARIFA
// (6) katika ngazi ya juu HAIPASWI kuunganishwa. Jaribio hili
// linathibitisha usahihi wa hesabu unabaki sahihi kwa kazi kubwa
// zaidi ya kikomo, ikiachwa kama wito wa kweli. (Hakuna tangazo la
// ndani hapa -- kikomo cha ukubwa ndicho kinachojaribiwa peke yake,
// si kikomo cha tangazo la ndani.)
W0 hesabu_kubwa(N32* mahali, N32 x) {
    *mahali = x;
    *mahali = *mahali + 1;
    *mahali = *mahali + 1;
    *mahali = *mahali + 1;
    *mahali = *mahali + 1;
    *mahali = *mahali + 1;
    *mahali = *mahali + 1;
}

N32 main() {
    N32 matokeo;
    hesabu_kubwa(&matokeo, 10);
    kama (matokeo != 16) { rudisha 1; }
    rudisha 0;
}
