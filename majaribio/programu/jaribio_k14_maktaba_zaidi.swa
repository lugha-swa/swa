// jaribio_k14_maktaba_zaidi.swa — Majaribio ya kazi mpya za maktaba
// (hesabu + mfuatano) na mrejesho wa mende ya literal-kama-hoja.
// Inajitosheleza: kazi za maktaba zimeingizwa moja kwa moja.

// === Kazi tegemezi ===
n32 neneo_n32(n32 n) {
    kama (n < 0) { rudisha 0 - n; }
    rudisha n;
}

n32 gcd_hesabu(n32 a, n32 b) {
    a = neneo_n32(a);
    b = neneo_n32(b);
    wakati (b != 0) {
        n32 t = a % b;
        a = b;
        b = t;
    }
    rudisha a;
}

n64 urefu_wa_mfuatano(n8* s) {
    n64 n = 0;
    wakati (s[n] != 0) { n = n + 1; }
    rudisha n;
}

// === hesabu.swa — kazi mpya ===
n32 kipengele_hesabu(n32 n) {
    kama (n < 0 || n > 12) { rudisha 0; }
    n32 r = 1;
    n32 i = 2;
    wakati (i <= n) { r = r * i; i = i + 1; }
    rudisha r;
}

n32 ni_kuu_hesabu(n32 n) {
    kama (n < 2) { rudisha 0; }
    kama (n == 2 || n == 3) { rudisha 1; }
    kama (n % 2 == 0) { rudisha 0; }
    n32 i = 3;
    wakati (i * i <= n) {
        kama (n % i == 0) { rudisha 0; }
        i = i + 2;
    }
    rudisha 1;
}

n32 lcm_hesabu(n32 a, n32 b) {
    kama (a == 0 || b == 0) { rudisha 0; }
    n32 g = gcd_hesabu(a, b);
    rudisha neneo_n32((a / g) * b);
}

n32 pow_mod_hesabu(n32 msingi, n32 kipeo, n32 mod) {
    kama (mod <= 1) { rudisha 0; }
    n32 r = 1;
    n32 ms = msingi % mod;
    kama (ms < 0) { ms = ms + mod; }
    n32 kp = kipeo;
    wakati (kp > 0) {
        kama (kp % 2 == 1) { r = (r * ms) % mod; }
        ms = (ms * ms) % mod;
        kp = kp / 2;
    }
    rudisha r;
}

// === mfuatano.swa — kazi mpya ===
w0 geuza_mfuatano(n8* s) {
    n32 i = 0;
    n32 j = 0;
    wakati (s[j] != 0) { j = j + 1; }
    j = j - 1;
    wakati (i < j) {
        n8 t = s[i];
        s[i] = s[j];
        s[j] = t;
        i = i + 1;
        j = j - 1;
    }
}

n8 herufi_ya_juu(n8 c) {
    kama (c >= 97 && c <= 122) { rudisha c - 32; }
    rudisha c;
}

n8 herufi_ya_chini(n8 c) {
    kama (c >= 65 && c <= 90) { rudisha c + 32; }
    rudisha c;
}

n32 kompyuta_linganisha(n8* a, n8* b) {
    n32 i = 0;
    wakati (1 == 1) {
        n8 ca = herufi_ya_juu(a[i]);
        n8 cb = herufi_ya_juu(b[i]);
        kama (ca != cb) {
            kama (ca < cb) { rudisha -1; }
            rudisha 1;
        }
        kama (ca == 0) { rudisha 0; }
        i = i + 1;
    }
}

n32 anza_kwa_mfuatano(n8* s, n8* kiambishi) {
    n32 i = 0;
    wakati (kiambishi[i] != 0) {
        kama (s[i] != kiambishi[i]) { rudisha 0; }
        i = i + 1;
    }
    rudisha 1;
}

n32 isha_kwa_mfuatano(n8* s, n8* kiambishi) {
    n64 ns = urefu_wa_mfuatano(s);
    n64 nk = urefu_wa_mfuatano(kiambishi);
    kama (nk > ns) { rudisha 0; }
    n64 i = 0;
    wakati (i < nk) {
        kama (s[ns - nk + i] != kiambishi[i]) { rudisha 0; }
        i = i + 1;
    }
    rudisha 1;
}

n32 idadi_ya_herufi(n8* s, n8 c) {
    n32 n = 0;
    n32 i = 0;
    wakati (s[i] != 0) {
        kama (s[i] == c) { n = n + 1; }
        i = i + 1;
    }
    rudisha n;
}

n32 nambari_kwa_mfuatano_heksa(n32 n, n8* buf) {
    n8 tarakimu[16];
    n32 i = 0;
    n32 i2 = 0;
    wakati (i2 < 16) { tarakimu[i2] = 0; i2 = i2 + 1; }
    n32 val = n;
    kama (val == 0) {
        buf[0] = 48;
        buf[1] = 0;
        rudisha 1;
    }
    wakati (val != 0) {
        n32 d = val % 16;
        kama (d < 10) { tarakimu[i] = 48 + d; }
        sivyo { tarakimu[i] = 87 + d; }
        val = val / 16;
        i = i + 1;
    }
    n32 j = 0;
    wakati (i > 0) {
        i = i - 1;
        buf[j] = tarakimu[i];
        j = j + 1;
    }
    buf[j] = 0;
    rudisha j;
}

n32 heshi_mfuatano(n8* s) {
    n32 h = 5381;
    n32 i = 0;
    wakati (s[i] != 0) {
        h = h * 33 + s[i];
        i = i + 1;
    }
    rudisha h;
}

// === Mrejesho wa mende ya literal-kama-hoja ===
// Literali kamili yenye thamani katika [768,1023] ilipitishwa kama
// desimali (familia 3) badala ya n32 — hoja ilifika kwenye xmm0.
n32 hesabu_literal(n32 a, n32 b) { rudisha a + b; }
n32 toa_literal(n32 a, n32 b) { rudisha a - b; }
n32 gawanya_literal(n32 a, n32 b) { rudisha a / b; }
n32 asilimia_literal(n32 a, n32 b) { rudisha a % b; }

n32 main() {
    // hesabu.swa
    kama (kipengele_hesabu(5) != 120) rudisha 1;
    kama (kipengele_hesabu(0) != 1) rudisha 2;
    kama (kipengele_hesabu(13) != 0) rudisha 3;
    kama (ni_kuu_hesabu(2) != 1) rudisha 4;
    kama (ni_kuu_hesabu(97) != 1) rudisha 5;
    kama (ni_kuu_hesabu(15) != 0) rudisha 6;
    kama (ni_kuu_hesabu(1) != 0) rudisha 7;
    kama (lcm_hesabu(4, 6) != 12) rudisha 8;
    kama (lcm_hesabu(7, 3) != 21) rudisha 9;
    kama (lcm_hesabu(0, 5) != 0) rudisha 10;
    kama (pow_mod_hesabu(2, 10, 1000) != 24) rudisha 11;
    kama (pow_mod_hesabu(3, 4, 100) != 81) rudisha 12;
    kama (pow_mod_hesabu(5, 0, 7) != 1) rudisha 13;

    // mfuatano.swa
    n8 s1[8];
    s1[0] = 97; s1[1] = 98; s1[2] = 99; s1[3] = 0;
    geuza_mfuatano(s1);
    kama (s1[0] != 99 || s1[1] != 98 || s1[2] != 97) rudisha 14;
    kama (herufi_ya_juu(97) != 65) rudisha 15;
    kama (herufi_ya_juu(65) != 65) rudisha 16;
    kama (herufi_ya_chini(65) != 97) rudisha 17;
    n8 a1[8]; n8 b1[8];
    a1[0]=65;a1[1]=66;a1[2]=67;a1[3]=0;
    b1[0]=97;b1[1]=98;b1[2]=99;b1[3]=0;
    kama (kompyuta_linganisha(a1, b1) != 0) rudisha 18;
    n8 s2[8]; s2[0]=104;s2[1]=101;s2[2]=108;s2[3]=108;s2[4]=111;s2[5]=0;
    n8 p1[4]; p1[0]=104;p1[1]=101;p1[2]=0;
    n8 p2[4]; p2[0]=108;p2[1]=111;p2[2]=0;
    kama (anza_kwa_mfuatano(s2, p1) != 1) rudisha 19;
    kama (anza_kwa_mfuatano(s2, p2) != 0) rudisha 20;
    kama (isha_kwa_mfuatano(s2, p2) != 1) rudisha 21;
    kama (isha_kwa_mfuatano(s2, p1) != 0) rudisha 22;
    n8 s3[8]; s3[0]=98;s3[1]=97;s3[2]=110;s3[3]=97;s3[4]=110;s3[5]=97;s3[6]=0;
    kama (idadi_ya_herufi(s3, 97) != 3) rudisha 23;
    n8 hb[16];
    nambari_kwa_mfuatano_heksa(255, hb);
    kama (hb[0] != 102 || hb[1] != 102 || hb[2] != 0) rudisha 24;
    n8 hs[4]; hs[0]=97;hs[1]=98;hs[2]=99;hs[3]=0;
    kama (heshi_mfuatano(hs) != heshi_mfuatano(hs)) rudisha 25;

    // Mrejesho wa mende ya literal-kama-hoja (familia 3: [768,1023])
    kama (hesabu_literal(1000, 7) != 1007) rudisha 26;
    kama (toa_literal(1024, 1000) != 24) rudisha 27;
    kama (gawanya_literal(1000, 7) != 142) rudisha 28;
    kama (asilimia_literal(1024, 1000) != 24) rudisha 29;

    rudisha 0;
}
