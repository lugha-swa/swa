// Mende 17: ^ (XOR) ilikata usemi kimya — kila kitu baada ya ^
// kilitupwa na jibu la operanda ya kushoto pekee likabaki
// ((12) ^ (10) ilirudisha 12 badala ya 6). Hati 2.5 na 4 zinaahidi ^.
// Pia huthibitisha utangulizi wa C: & juu ya ^ juu ya |.
n32 main() {
    n32 a = (12) ^ (10);       // 6
    n32 b = 6 ^ 3;             // 5
    n32 c = 255 ^ 170;         // 85
    n32 d = 1 ^ 2 & 3;         // 1 ^ (2 & 3) = 3  (& juu ya ^)
    n32 e = 1 | 2 ^ 3;         // 1 | (2 ^ 3) = 1  (^ juu ya |)
    kama (a != 6) { rudisha 1; }
    kama (b != 5) { rudisha 2; }
    kama (c != 85) { rudisha 3; }
    kama (d != 3) { rudisha 4; }
    kama (e != 1) { rudisha 5; }
    rudisha 0;
}
