// inl_kitanzi: kazi yenye kitanzi (AST_WAKATI) HAIPASWI kuunganishwa
// (wigo wa awamu ya kwanza ni mstari ulionyooka tu). Jaribio hili
// linathibitisha usahihi wa hesabu unabaki sahihi kazi kama hiyo
// ikiachwa bila kuunganishwa.
n32 jumla_ya_mzunguko;

w0 jumlisha_hadi(n32 n) {
    n32 i;
    i = 0;
    wakati (i <= n) {
        jumla_ya_mzunguko = jumla_ya_mzunguko + i;
        i = i + 1;
    }
}

n32 main() {
    jumla_ya_mzunguko = 0;
    jumlisha_hadi(4);
    kama (jumla_ya_mzunguko != 10) { rudisha 1; }
    rudisha 0;
}
