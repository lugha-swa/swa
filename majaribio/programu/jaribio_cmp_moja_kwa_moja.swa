// Ulinganishi wa namba kamili bila kupakia operanda kwenye rax/rcx:
// cmp reg,reg / reg,[mem] / [mem],reg / [mem],imm32 / reg,imm32 / L,rax /
// rax,R -- sita ya operesheni (<, >, <=, >=, ==, !=), kwenye sharti la
// kama/wakati (cmp+jcc) na kama thamani; N32 (yenye ishara na bila),
// N64, vigezo vya rejesta, vya rafu, paramu. Thamani zote za mkono.

N32 g = 5;
N32 badilisha(N32* p) { *p = *p + 100; rudisha 1; }
N32 badilisha50(N32* p) { *p = *p + 100; rudisha 50; }

// Kila jozi (a, b) yenye a < b : matokeo ya operesheni zote sita
N32 sita(N32 a, N32 b) {
    N32 r = 0;
    kama (a < b) { r = r + 1; }
    kama (a > b) { r = r + 2; }
    kama (a <= b) { r = r + 4; }
    kama (a >= b) { r = r + 8; }
    kama (a == b) { r = r + 16; }
    kama (a != b) { r = r + 32; }
    rudisha r;
}

// a < b: 1 + 4 + 32 = 37; a > b: 2 + 8 + 32 = 42; a == b: 4 + 8 + 16 = 28
N32 jaribu_paramu() {
    kama (sita(3, 5) != 37) { rudisha 1; }
    kama (sita(5, 3) != 42) { rudisha 2; }
    kama (sita(4, 4) != 28) { rudisha 3; }
    kama (sita(0 - 3, 2) != 37) { rudisha 4; }
    kama (sita(2, 0 - 3) != 42) { rudisha 5; }
    kama (sita(0 - 7, 0 - 7) != 28) { rudisha 6; }
    kama (sita(2147483647, 0 - 2147483647) != 42) { rudisha 7; }
    rudisha 0;
}

N32 jaribu_rejesta_na_rafu() {
    N32 a = 3; N32 b = 5; N32 c = 0 - 4; N32 d = 5; N32 e = 100; N32 f = 0 - 100; N32 h = 7; N32 k = 9;
    kama (a < b) { } sivyo { rudisha 1; }
    kama (b > a) { } sivyo { rudisha 2; }
    kama (b == d) { } sivyo { rudisha 3; }
    kama (c < a) { } sivyo { rudisha 4; }
    kama (c > f) { } sivyo { rudisha 5; }
    kama (e >= h) { } sivyo { rudisha 6; }
    kama (f <= c) { } sivyo { rudisha 7; }
    kama (k != h) { } sivyo { rudisha 8; }
    // dhidi ya namba
    kama (a < 4) { } sivyo { rudisha 9; }
    kama (c < 0) { } sivyo { rudisha 10; }
    kama (f < 0 - 99) { } sivyo { rudisha 11; }
    kama (e == 100) { } sivyo { rudisha 12; }
    kama (h != 7) { rudisha 13; }
    kama (k >= 9) { } sivyo { rudisha 14; }
    kama (k > 9) { rudisha 15; }
    // usemi upande mmoja
    kama (a + 1 < b) { } sivyo { rudisha 16; }
    kama (a < b - 3) { rudisha 17; }
    kama (b * 2 > e / 20 + a) { } sivyo { rudisha 18; }
    kama (a + b == 8) { } sivyo { rudisha 19; }
    kama (c + e == 96) { } sivyo { rudisha 20; }
    kama (8 == a + b) { } sivyo { rudisha 21; }
    kama (b * 2 > a) { } sivyo { rudisha 22; }
    // thamani ya ulinganishi (setcc)
    N32 t1 = (a < b);
    N32 t2 = (a > b);
    N32 t3 = (e == 100) + (h != 7) + (c < a) + (f >= c);
    kama (t1 != 1 || t2 != 0 || t3 != 2) { rudisha 23; }
    // kwenye kitanzi (wakati) -- kaunta ni kigezo cha rejesta
    N32 i = 0;
    N32 s = 0;
    wakati (i < k) { s = s + i; i = i + 1; }
    kama (s != 36) { rudisha 24; }
    i = 10;
    wakati (i > a) { i = i - 1; }
    kama (i != 3) { rudisha 25; }
    rudisha 0;
}

// N64 chache (zote kwenye rejesta): cmp ya biti 64 reg,reg na reg,namba
N32 jaribu_n64_rejesta() {
    N64 u = 4294967296;
    N64 z = 0;
    N64 w = 4294967296;
    kama (u == z) { rudisha 1; }
    kama (u != z) { } sivyo { rudisha 2; }
    kama (u > z) { } sivyo { rudisha 3; }
    kama (z < u) { } sivyo { rudisha 4; }
    kama (u == w) { } sivyo { rudisha 5; }
    kama (u == 4294967296) { } sivyo { rudisha 6; }
    kama (u == 0) { rudisha 7; }
    kama (u + 1 == w) { rudisha 8; }
    kama (z < 1) { } sivyo { rudisha 9; }
    N64 hasi = 0 - 4294967296;
    kama (hasi < z) { } sivyo { rudisha 10; }
    kama (hasi == u) { rudisha 11; }
    rudisha 0;
}

N32 jaribu_n64() {
    N64 a = 5000000000;
    N64 b = 5000000001;
    N64 c = 0 - 5000000000;
    N64 d = 5000000000;
    N64 e = 0; N64 f = 1; N64 h = 2; N64 k = 3; N64 m = 4; N64 n = 6;
    kama (a < b) { } sivyo { rudisha 1; }
    kama (b > a) { } sivyo { rudisha 2; }
    kama (a == d) { } sivyo { rudisha 3; }
    kama (c < a) { } sivyo { rudisha 4; }
    kama (a != b) { } sivyo { rudisha 5; }
    kama (a >= d) { } sivyo { rudisha 6; }
    kama (a <= b) { } sivyo { rudisha 7; }
    kama (a > 4999999999) { } sivyo { rudisha 8; }
    kama (a < 100) { rudisha 9; }
    kama (c < 0) { } sivyo { rudisha 10; }
    kama (c > 0 - 1) { rudisha 11; }
    kama (a + 1 == b) { } sivyo { rudisha 12; }
    kama (b - 1 == d) { } sivyo { rudisha 13; }
    // biti za juu zinatofautiana lakini za chini ni sawa: lazima cmp ya biti 64
    N64 u = 4294967296;
    N64 z = 0;
    kama (u == z) { rudisha 14; }
    kama (u != z) { } sivyo { rudisha 15; }
    kama (u > z) { } sivyo { rudisha 16; }
    kama (e + f + h + k + m + n != 16) { rudisha 17; }
    rudisha 0;
}

// A32 (bila ishara): jb/ja badala ya jl/jg
N32 jaribu_bila_ishara() {
    A32 a = 1;
    A32 b = 0;
    b = b - 1;                // 4294967295
    A32 c = 3000000000;
    kama (a < b) { } sivyo { rudisha 1; }
    kama (b > a) { } sivyo { rudisha 2; }
    kama (c > a) { } sivyo { rudisha 3; }
    kama (c > 2000000000) { } sivyo { rudisha 4; }
    kama (b >= c) { } sivyo { rudisha 5; }
    kama (a < 5) { } sivyo { rudisha 6; }
    kama (b == c) { rudisha 7; }
    rudisha 0;
}

// Mpangilio: kulia (usemi wenye wito) kwanza, kisha kigezo cha kushoto kinasomwa
N32 jaribu_mpangilio() {
    N32 x = 5;
    // kulia: badilisha(&x) hufanya x = 105, kisha x inasomwa: 105 > 1
    kama (x > badilisha(&x)) { } sivyo { rudisha 1; }
    x = 5;
    kama (x == badilisha(&x) + 104) { } sivyo { rudisha 2; }     // 105 == 1 + 104
    // kushoto ni wito, kulia ni kigezo (kinasomwa KWANZA = 5)
    x = 5;
    kama (badilisha(&x) < x) { } sivyo { rudisha 3; }            // 1 < 5
    kama (x == 105) { } sivyo { rudisha 4; }
    // kushoto ni wito unaorudisha 50: x inasomwa KWANZA (5), si baada ya wito (105)
    x = 5;
    kama (badilisha50(&x) < x) { rudisha 7; }                    // 50 < 5 ni uongo
    kama (x != 105) { rudisha 8; }
    x = 5;
    kama (badilisha50(&x) > x) { } sivyo { rudisha 9; }          // 50 > 5
    // kigezo cha ulimwengu (si jani la cmp): njia ya kawaida
    g = 5;
    kama (g < 6) { } sivyo { rudisha 5; }
    kama (g == 5) { } sivyo { rudisha 6; }
    rudisha 0;
}

N32 main() {
    N32 r = jaribu_paramu();
    kama (r != 0) { rudisha 10 + r; }
    r = jaribu_rejesta_na_rafu();
    kama (r != 0) { rudisha 30 + r; }
    r = jaribu_n64();
    kama (r != 0) { rudisha 60 + r; }
    r = jaribu_n64_rejesta();
    kama (r != 0) { rudisha 90 + r; }
    r = jaribu_bila_ishara();
    kama (r != 0) { rudisha 80 + r; }
    r = jaribu_mpangilio();
    kama (r != 0) { rudisha 100 + r; }
    rudisha 0;
}
