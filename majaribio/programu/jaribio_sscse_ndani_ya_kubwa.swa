// SSCSE -- usemi unaorudiwa ukiwa NA taarifa nzima ya kwanza (x =
// a*b;) NA kipande cha ndani cha usemi mkubwa zaidi cha pili
// (y = (a*b) + 10;) -- kuthibitisha kulinganisha kunafanya kazi
// pande zote mbili (nodi nzima YA TAARIFA dhidi ya nodi ndogo YA
// NDANI). a=6,b=7 => a*b=42.
n32 main() {
    n32 a = 6;
    n32 b = 7;
    n32 x = a * b;
    n32 y = (a * b) + 10;
    kama (x != 42) { rudisha 1; }
    kama (y != 52) { rudisha 2; }
    rudisha 0;
}
