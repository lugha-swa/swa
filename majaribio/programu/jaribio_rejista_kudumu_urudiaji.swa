// lugha-swa/swa: jaribio la kudumu la ugawaji wa rejesta (awamu ya 1)
// -- kigezo cha ndani cha rejesta ya kudumu kikitumika ndani ya kazi
// inayojirudia (recursion). Kila wito unaingia unapaswa kuhifadhi na
// kurudisha thamani yake mwenyewe ya rejesta bila kuvuruga wito
// mwingine wowote uliomo kwenye mnyororo wa urudiaji.
n32 jumla_ya_urudiaji(n32 n) {
    n32 jumla = n;
    kama (n <= 1) {
        rudisha jumla;
    }
    jumla = jumla + jumla_ya_urudiaji(n - 1);
    rudisha jumla;
}

n32 factorial(n32 n) {
    n32 matokeo = 1;
    kama (n <= 1) {
        rudisha matokeo;
    }
    matokeo = n * factorial(n - 1);
    rudisha matokeo;
}

n32 main() {
    // 5+4+3+2+1 = 15
    kama (jumla_ya_urudiaji(5) != 15) { rudisha 1; }
    // 5! = 120
    kama (factorial(5) != 120) { rudisha 2; }
    // 10! = 3628800
    kama (factorial(10) != 3628800) { rudisha 3; }
    rudisha 0;
}
