// inl_mgongano_jina: jina la paramu ya "weka" ("thamani") linafanana
// kwa BAHATI na jina la kigezo cha ndani cha "main" chenye thamani
// TOFAUTI KABISA. Ubadilishaji wa jina wa kipekee (rename) wakati
// wa kuunganisha lazima uzuie mgongano huu -- kama jina lisingebadilishwa,
// kigezo cha ndani cha main "thamani" kingeandikwa juu kimakosa au
// kusomwa badala ya paramu halisi.
w0 weka(n32* mahali, n32 thamani) {
    *mahali = thamani * 2;
}

n32 main() {
    n32 thamani;
    thamani = 777;
    n32 matokeo;
    weka(&matokeo, 5);
    kama (matokeo != 10) { rudisha 1; }
    kama (thamani != 777) { rudisha 2; }
    rudisha 0;
}
