// Majina ya zamani ya kazi za maktaba (v0.0.1) bado yanakusanywa kwa toleo
// moja, kwa onyo -- wito huelekezwa kwa jina jipya ikiwa programu
// haijafafanua kazi yenye jina la zamani. Kazi ya programu yenye jina la
// zamani (sys_soma hapa) inabaki yake -- haielekezwi.
// Inatarajiwa: kutoka 24 = 6 + 8 + 5 + 5.
husisha { msingi/maktaba/kumbukumbu.swa }
husisha { msingi/maktaba/hesabu.swa }

n32 sys_soma(n32 x) { rudisha x + 4; }

n32 anza() {
    n32 a = gcd_hesabu(12, 18);
    n32 b = pow_kamili(2, 3);
    n32 c = sys_soma(1);
    n32 d = isqrt_hesabu(30);
    rudisha a + b + c + d;
}
