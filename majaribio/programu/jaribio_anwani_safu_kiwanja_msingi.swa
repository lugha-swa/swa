// Njia ya haraka ya ugawaji wa kiwanja kwenye kipengele cha safu
// (c[i*n+j] += x / -= x) -- inathibitisha thamani sahihi kwa fahirisi
// tata (i*n+j, muundo halisi wa kipimo cha matriki) baada ya
// kuondoa hesabu ya anwani inayorudiwa. Imekokotolewa kwa mkono:
// c[35] = 0 (kianzio) -> += 7 -> 7 -> -= 3 -> 4.
husisha { msingi/maktaba/kumbukumbu.swa }

n32 main() {
    n32* c = tenga(ukubwa(n32) * 100);
    n32 i = 3;
    n32 n = 10;
    n32 j = 5;
    c[i * n + j] += 7;
    kama (c[i * n + j] != 7) { rudisha 1; }
    c[i * n + j] -= 3;
    kama (c[i * n + j] != 4) { rudisha 2; }
    rudisha c[i * n + j];
}
