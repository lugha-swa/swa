// jaribio_kielekezi_hesabu_kipengele.swa — p + n inahamisha kwa
// VIPENGELE, si baiti (rekodi 8.9, t75: *(p + 1) ilisoma ofseti 1
// ya baiti badala ya kipengele cha 1). Upana wa n32 (4), n64 (8)
// na n8 (1); safu na kumbukumbu ya chini (tenga); p - n, n + p,
// nyongeza iliyoota, na faharisi a[i] (bila kurejea nyuma).
// stage1 pekee: mbegu bado inahesabu baiti — rejesha baada ya
// kugandishwa kwa mbegu mpya.
husisha { kumbukumbu.swa }
n32 main() {
    // n32: ukubwa wa kipengele = 4
    n32 a[4]; a[0] = 10; a[1] = 11; a[2] = 12; a[3] = 13;
    n32* p = a;
    kama (*(p + 3) != 13) rudisha 1;
    kama (*(a + 2) != 12) rudisha 2;
    kama (*(2 + p) != 12) rudisha 3;
    n32 n = 1;
    kama (*(p + n) != 11) rudisha 4;
    kama (*(p + 2 + 1) != 13) rudisha 5;
    kama (a[3] != 13) rudisha 6;
    // n64: ukubwa wa kipengele = 8
    n64 b[4]; b[0] = 100; b[1] = 101; b[2] = 102; b[3] = 103;
    n64* q = b;
    kama (*(q + 3) != 103) rudisha 7;
    kama (*(q + 1) != 101) rudisha 8;
    kama (q[2] != 102) rudisha 9;
    // n8: ukubwa wa kipengele = 1 (kielekezi cha baiti)
    n8 c[4]; c[0] = 1; c[1] = 2; c[2] = 3; c[3] = 4;
    n8* r = c;
    kama (*(r + 3) != 4) rudisha 10;
    kama (*(r + 1) != 2) rudisha 11;
    // p - n na kurudi nyuma
    n32* m = p + 3;
    kama (*(m - 2) != 11) rudisha 12;
    kama (*(m - n) != 12) rudisha 13;
    // Kumbukumbu ya chini: tenga inarudisha n8*; mgawo kwa n32*
    // ni halali (familia zinalingana — ukaguzi wa kihifadhi)
    n32* h = tenga(32);
    kama (h == 0) rudisha 14;
    h[0] = 5; h[1] = 9; h[2] = 13;
    kama (*(h + 1) != 9) rudisha 15;
    kama (*(h + 2) != 13) rudisha 16;
    n32* w = h + 1;
    kama (*w != 9) rudisha 17;
    // namba + namba bado bila kuzidisha (hakuna mshale)
    n32 s = 20;
    n32 t = 22;
    kama (s + t != 42) rudisha 18;
    kama (s - 5 != 15) rudisha 19;
    n64 u = 2000000000;
    n64 v = 2000000001;
    kama (u + v != 4000000001) rudisha 20;
    rudisha 0;
}
