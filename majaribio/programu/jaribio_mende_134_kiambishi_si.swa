// Mende 134: kiambishi ! (kanusha mantiki) kilikataliwa na minyororo
// yote miwili ingawa hati 2.5 inaorodhesha ! na hati 3 inaahidi
// "matokeo ya ! ni 1 au 0". Sasa ! inafanya kazi: 1 ikiwa operesheni
// ni 0, vinginevyo 0.
n32 main() {
    n32 a = !5;  kama (a != 0) { rudisha 1; }
    n32 b = !0;  kama (b != 1) { rudisha 2; }
    n32 c = 3;
    kama (!(c == 3) != 0) { rudisha 3; }
    kama (!c != 0) { rudisha 4; }
    n32 d = 0; d = !d; kama (d != 1) { rudisha 5; }
    n64 v = 4294967296;  // 2^32 — nusu ya chini ni 0; ! lazima ijue upana
    kama (!v != 0) { rudisha 6; }
    n64 z = 0;
    kama (!z != 1) { rudisha 7; }
    rudisha 0;
}
