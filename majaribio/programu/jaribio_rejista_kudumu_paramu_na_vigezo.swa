// Ugawaji wa rejesta, awamu ya 2 (paramu) -- kazi yenye paramu 7 NA
// vigezo vya ndani 2 (wagombea 9 wa jumla, rejesta 5 tu zinapatikana)
// lazima ichague wagombea 5 wa kwanza (mpangilio wa AST) kwa usahihi
// bila kuvuruga wale wanaobaki kwenye rafu. Thamani halisi
// imekokotolewa kwa mkono: (1+2+3+4+5+6+7) + 4 + 8 = 40.
n32 kusaidia(n32 v) {
    rudisha v + 1;
}

n32 jaribu(n32 p1, n32 p2, n32 p3, n32 p4, n32 p5, n32 p6, n32 p7) {
    n32 l1 = p1 * 2;
    n32 l2 = p2 * 3;

    n32 i = 0;
    wakati (i < 2) {
        l1 = kusaidia(l1);
        l2 = kusaidia(l2);
        i = i + 1;
    }

    rudisha p1 + p2 + p3 + p4 + p5 + p6 + p7 + l1 + l2;
}

n32 main() {
    rudisha jaribu(1, 2, 3, 4, 5, 6, 7);
}
