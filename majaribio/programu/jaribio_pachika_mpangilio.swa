// inl_mpangilio: mpangilio wa kutathmini hoja lazima ubaki
// kulia-kwenda-kushoto BAADA ya kuunganisha (sawa na wito wa kweli
// -- ona uzalishaji_wito, "Tathmini hoja kutoka kulia kwenda
// kushoto"). "tupu2" ni kazi tupu kabisa (haigusi chochote) --
// jaribio hili linaangalia MPANGILIO wa hoja pekee, si mwili wake.
n32 hesabu_ya_mpangilio;
n32 mpangilio_wa_x;
n32 mpangilio_wa_y;

n32 tathmini_x() {
    hesabu_ya_mpangilio = hesabu_ya_mpangilio + 1;
    mpangilio_wa_x = hesabu_ya_mpangilio;
    rudisha 100;
}

n32 tathmini_y() {
    hesabu_ya_mpangilio = hesabu_ya_mpangilio + 1;
    mpangilio_wa_y = hesabu_ya_mpangilio;
    rudisha 200;
}

w0 tupu2(n32 x, n32 y) {
}

n32 anza() {
    hesabu_ya_mpangilio = 0;
    mpangilio_wa_x = 0;
    mpangilio_wa_y = 0;
    tupu2(tathmini_x(), tathmini_y());
    // haki-kwenda-kushoto: hoja ya mwisho (y) inatathminiwa KWANZA
    kama (mpangilio_wa_y != 1) { rudisha 1; }
    kama (mpangilio_wa_x != 2) { rudisha 2; }
    rudisha 0;
}
