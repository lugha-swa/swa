// chagua ndani ya kazi inayotumia kigezo — mnyororo wa Rust pekee (mbegu haijui chagua).
n32 tathmini(n32 alama) {
    chagua (alama) {
        hali 1: rudisha 50;
        hali 2: rudisha 70;
    }
    rudisha 30;
}

n32 main() {
    kama (tathmini(1) != 50) rudisha 1;
    kama (tathmini(2) != 70) rudisha 2;
    kama (tathmini(9) != 30) rudisha 3;
    rudisha 0;
}
