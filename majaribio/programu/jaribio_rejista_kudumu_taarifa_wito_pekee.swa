// lugha-swa/swa: jaribio la kudumu la kuzuia urudiaji -- mdudu WA PILI
// HALISI uliogunduliwa wakati wa kutafuta chanzo cha kwanza: TAARIFA
// YA WITO PEKEE (bila kuwa sehemu ya kama/ugawaji/usemi mkubwa zaidi,
// mfano "piga(x, y);" peke yake kama taarifa moja ya block) ilikatiza
// KABISA utembeaji wa tambua_anwani_pass (pitio la kugundua &kigezo) --
// kigezo CHOCHOTE kilichotangazwa BAADAYE kwenye block hiyo hiyo
// hakikuwahi kuchunguzwa kwa &kigezo, hata kama tambua_tangazo_pass
// (ambayo haina dosari hii) tayari ilikuwa imekikubali kama mgombea.
W0 piga_kazi_pekee(N8* p, N64 v) {
    N8 bb = v;
}

N32 badilisha_kupitia_anwani(N32 a, N32* p, N32 b) {
    *p = a * b;
    rudisha *p;
}

N32 main() {
    // Taarifa ya wito PEKEE (si sehemu ya kama/ugawaji) -- hii NDIYO
    // muundo halisi uliosababisha mdudu.
    N8 bafa[8];
    piga_kazi_pekee(bafa, 1);

    // Kigezo hiki kimetangazwa BAADA ya taarifa ya wito pekee hapo juu.
    // Kabla ya rekebisho, tambua_anwani_pass haikuwahi kufika hapa
    // KABISA (ilikatizwa na `rudisha;` ya moja kwa moja baada ya
    // kushughulikia mnyororo wa hoja za piga_kazi_pekee).
    N32 h = 7;
    kama (badilisha_kupitia_anwani(3, &h, 5) != 15) { rudisha 1; }
    kama (h != 15) { rudisha 2; }
    rudisha 0;
}
