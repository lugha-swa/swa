// Peephole ya push/pop (rax/rcx) -- wito wa kazi (una utangulizi/
// mwisho wake mwenyewe wenye push/pop za rejesta za kudumu) ukiwa
// KATIKATI ya usemi wenye push inayosubiri kutolewa. png_safisha
// hutolewa moja kwa moja kupitia andika_baiti (kila agizo la wito
// -- call rel32 -- huandikwa kupitia hiyo) kabla ya wito kuanza,
// hivyo thamani iliyosukumwa haiwezi kamwe kuchanganyikiwa na rafu
// ya kazi inayoitwa. (a*b) + ongeza(c) na a=3,b=4,c=10 (ongeza
// hurudisha c+1=11) -> 12+11=23.
n32 ongeza(n32 v) {
    rudisha v + 1;
}

n32 main() {
    n32 a = 3;
    n32 b = 4;
    n32 c = 10;
    n32 r = (a * b) + ongeza(c);
    rudisha r;
}
