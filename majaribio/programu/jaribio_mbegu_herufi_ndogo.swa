// Herufi ndogo za aina 6 zinazotambulika na mbegu.bin YENYEWE (n8/n16/
// n32/n64/w0/d64 -- HAKUNA familia A/B wala D32 kwenye mbegu, hata
// baada ya kugandisha upya) -- angalia lugha-swa/swa#225 kwa
// uhamiaji wa awali (mkusanyaji uliojijenga pekee) na
// hati/hali-ya-lugha.md kwa hali ya sasa ya mbegu.
//
// TOFAUTI na jaribio_herufi_ndogo_aina_msingi.swa: faili hili HALINA
// alama ya "stage1" kwenye MANIFEST.txt -- linaendeshwa dhidi ya
// mbegu.bin NA stage1 zote mbili, kuthibitisha kuwa mbegu YENYEWE
// (si mkusanyaji uliojijenga pekee) sasa inatambua herufi hizi.

husisha { maktaba/kumbukumbu.swa }

n32 jumla_ndogo(n32 a, n32 b) {
    rudisha a + b;
}

// Mchanganyiko wa herufi kubwa/ndogo ndani ya kazi moja (paramu moja
// kubwa, nyingine ndogo, kurudi kwa herufi ndogo) -- lazima zifanane
// kwenye ukaguzi wa aina wa mbegu, sio tu wa mkusanyaji uliojijenga.
n32 changanya(n32 kubwa, n32 ndogo) {
    rudisha kubwa + ndogo;
}

w0 hakuna_kazi_kubwa() {
    rudisha;
}

w0 hakuna_kazi_ndogo() {
    rudisha;
}

d64 jumla_desimali(d64 a, d64 b) {
    rudisha a + b;
}

n32 main() {
    n8 a = 5;
    kama (a != 5) { rudisha 1; }

    n16 b = 300;
    kama (b != 300) { rudisha 2; }

    n32 c = 70000;
    kama (c != 70000) { rudisha 3; }

    n64 d = 5000000000;
    kama (d != 5000000000) { rudisha 4; }

    d64 e = 1.5;
    n32 e_i = e * 1000.0;
    kama (e_i != 1500) { rudisha 5; }

    w0 f;
    hakuna_kazi_ndogo();
    hakuna_kazi_kubwa();

    kama (jumla_ndogo(3, 4) != 7) { rudisha 6; }
    kama (changanya(3, 4) != 7) { rudisha 7; }

    d64 jd = jumla_desimali(1.5, 2.5);
    n32 jd_i = jd * 10.0;
    kama (jd_i != 40) { rudisha 8; }

    // ukubwa() ya herufi ndogo -- mnyororo TOFAUTI wa msimbo kwenye
    // mbegu.s (haitumii changanua_aina, ina ulinganisho wake wa
    // mfuatano tofauti -- lazima ipimwe peke yake).
    kama (ukubwa(n8) != ukubwa(n8)) { rudisha 9; }
    kama (ukubwa(n16) != ukubwa(n16)) { rudisha 10; }
    kama (ukubwa(n32) != ukubwa(n32)) { rudisha 11; }
    kama (ukubwa(n64) != ukubwa(n64)) { rudisha 12; }
    kama (ukubwa(d64) != ukubwa(d64)) { rudisha 13; }

    // Safu ya ndani (rafu), si tenga() -- tenga() haitambuliwi na
    // mbegu.s kwa njia hii (kikwazo cha awali kisichohusiana na
    // herufi ndogo, kimethibitishwa: n32* p = tenga(...); huanguka
    // hata kwa herufi kubwa kwenye mbegu ya KABLA ya mabadiliko haya).
    n32 arr[3];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    kama (arr[0] + arr[1] + arr[2] != 60) { rudisha 14; }

    rudisha 0;
}
