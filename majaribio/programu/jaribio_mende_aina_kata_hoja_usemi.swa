// KATA: hoja ya aina isiyolingana katika NAFASI YA USEMI inazuia
// mkusanyaji. Muundo hadi parameta ya n32 si halali hata kwenye
// kianzio (mende: wito wa nafasi ya usemi ulikwepa ukaguzi).
muundo Nukta { n32 x; }

n32 kazi(n32 a) { rudisha a; }

n32 main() {
    Nukta n;
    n.x = 5;
    n32 v = kazi(n);
    rudisha v;
}
