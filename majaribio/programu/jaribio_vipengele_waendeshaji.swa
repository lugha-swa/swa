// jaribio_vipengele_waendeshaji.swa -- << >> & | ?: na herufi za mfuatano
// halisi kwa faharisi. 0 = yote sawa.

n32 ishara(n32 x) {
    rudisha x > 0 ? 1 : 0;
}

n32 anza() {
    n32 x = 4;
    n32 y = 8;
    kama ((x << 2) != 16) rudisha 1;
    kama ((y >> 1) != 4) rudisha 2;
    kama ((6 & 3) != 2) rudisha 3;
    kama ((6 | 3) != 7) rudisha 4;
    kama (ishara(5) != 1) rudisha 5;
    kama (ishara(-5) != 0) rudisha 6;

    n8* s = "n32 f() { rudisha 1; }";
    kama (s[0] != 110) rudisha 7;   // n
    kama (s[4] != 102) rudisha 8;   // f
    kama (s[5] != 40) rudisha 9;    // (
    kama (s[6] != 41) rudisha 10;   // )
    kama (s[8] != 123) rudisha 11;  // {
    rudisha 0;
}
