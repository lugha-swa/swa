// jaribio_mende_sret_kwa_thamani: kazi inayochukua muundo mkubwa
// (>8B) kwa thamani NA kurudisha muundo (sret). Kabla: njia ya
// kurudi kwa sret ilihitaji anwani ya chanzo kwa LEA ya sloti —
// lakini sloti ya paramu ya muundo mkubwa ina KIELEKEZI, si muundo
// wenyewe. Matokeo yalikuwa baiti za kielekezi (t.a = 1541242656,
// t.b = 32766 ...) — takataka. Sasa chanzo kinapakiwa kutoka sloti
// (kielekezi kinanyooshewa) kabla ya nakili hadi bafa ya sret.
// Inatarajiwa: 0 (t = {11,12,13,14}, s haibadiliki)
muundo Nne { n32 a; n32 b; n32 c; n32 d; };

Nne ongeza_hoja(Nne v, n32 n) {
    v.a = v.a + n;
    v.b = v.b + n;
    v.c = v.c + n;
    v.d = v.d + n;
    rudisha v;
}

n32 main() {
    Nne s;
    s.a = 1;
    s.b = 2;
    s.c = 3;
    s.d = 4;
    Nne t = ongeza_hoja(s, 10);
    kama (t.a != 11) rudisha 1;
    kama (t.b != 12) rudisha 2;
    kama (t.c != 13) rudisha 3;
    kama (t.d != 14) rudisha 4;
    kama (s.a != 1) rudisha 5;
    rudisha 0;
}
