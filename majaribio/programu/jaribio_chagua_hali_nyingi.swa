// chagua yenye hali nyingi (tano) — mnyororo wa Rust pekee (mbegu haijui chagua).
n32 siku_kwa_namba(n32 n) {
    chagua (n) {
        hali 1: rudisha 100;
        hali 2: rudisha 200;
        hali 3: rudisha 300;
        hali 4: rudisha 400;
        hali 5: rudisha 500;
    }
    rudisha 0;
}

n32 main() {
    kama (siku_kwa_namba(1) != 100) rudisha 1;
    kama (siku_kwa_namba(3) != 300) rudisha 2;
    kama (siku_kwa_namba(5) != 500) rudisha 3;
    kama (siku_kwa_namba(9) != 0) rudisha 4;
    rudisha 0;
}
