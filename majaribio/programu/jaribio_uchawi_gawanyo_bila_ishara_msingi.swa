// Zidisho-na-uchawi -- mgawanyo/modulo BILA ISHARA (a32) kwa
// kigawanyaji cha kudumu chochote (si nguvu ya 2). Bila ishara,
// hakuna hatari ya "kukata dhidi ya floor" (hazina hasi kabisa) --
// hatari PEKEE ni M kutotoshea kwenye biti 32 (angalia jaribio la
// kukataa kwa d=7). d=10 na d=100 hapa ZOTE zina M<2^32, hivyo
// zinatumia njia mpya kikamilifu.
//
// Thamani kubwa (karibu na 2^32) inaundwa kwa HESABU YA WAKATI WA
// KUKIMBIA (a+b), SI namba halisi moja kwa moja -- mdudu WA KWAKE
// MWENYEWE, usiohusiana kabisa na kazi hii, uligunduliwa wakati wa
// kuandaa jaribio hili: kuweka a32 moja kwa moja kwa namba halisi
// kubwa kuliko 2^31 (mfano "a32 z = 4294964296;") hakufanyi kazi
// sahihi -- HAKUSABABISHWI na zidisho-na-uchawi (kigawanyaji hapa ni
// wa kudumu, TAYARI umethibitishwa sahihi na Python kabla ya
// kutekelezwa), ni tabia ya UANZISHAJI wa a32 kwa namba halisi kubwa
// PEKEE. Imeripotiwa kwenye maelezo ya PR, imeepukwa hapa kwa
// kutumia hesabu badala ya namba halisi ya moja kwa moja.

n32 main() {
    a32 a = 37;
    kama (a / 10 != 3) { rudisha 1; }
    kama (a % 10 != 7) { rudisha 2; }

    a32 b = 100000;
    kama (b / 10 != 10000) { rudisha 3; }
    kama (b % 10 != 0) { rudisha 4; }

    a32 c = 999;
    kama (c / 100 != 9) { rudisha 5; }
    kama (c % 100 != 99) { rudisha 6; }

    // Karibu na 2^32-1 (4294967295), ikiundwa kwa hesabu -- angalia
    // maelezo makuu juu kuhusu mdudu wa uanzishaji.
    a32 sehemu1 = 2000000000;
    a32 sehemu2 = 2294967295;
    a32 kubwa = sehemu1 + sehemu2;  // = 4294967295
    kama (kubwa / 10 != 429496729) { rudisha 7; }
    kama (kubwa % 10 != 5) { rudisha 8; }
    kama (kubwa / 100 != 42949672) { rudisha 9; }
    kama (kubwa % 100 != 95) { rudisha 10; }

    // Utambulisho: (y/d)*d + (y%d) == y
    kama ((kubwa / 100) * 100 + (kubwa % 100) != kubwa) { rudisha 11; }

    rudisha 0;
}
