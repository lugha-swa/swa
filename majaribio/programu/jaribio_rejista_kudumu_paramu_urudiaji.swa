// Ugawaji wa rejesta, awamu ya 2 (paramu) -- paramu za rejesta ya
// kudumu ndani ya kazi inayojirudia (recursion) lazima zisivurugane
// kati ya wito tofauti kwenye mnyororo wa urudiaji. Thamani halisi:
// 2^6 = 64.
n32 nguvu(n32 msingi, n32 kipeo) {
    kama (kipeo == 0) { rudisha 1; }
    rudisha msingi * nguvu(msingi, kipeo - 1);
}

n32 main() {
    rudisha nguvu(2, 6);
}
