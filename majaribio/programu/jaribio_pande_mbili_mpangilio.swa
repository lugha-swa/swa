// Pande mbili bila push/pop -- mpangilio wa utathmini. Mkusanyaji huu
// hutathmini KULIA kabla ya KUSHOTO; kigezo cha kulia (jani) kinaweza
// kusomwa baadaye (moja kwa moja rcx) TU kama kushoto haiwezi kukibadilisha
// (hakuna wito wala uandishi). Hapa kushoto kinabadilisha kigezo cha kulia
// kupitia kielekezi -- thamani ya KWANZA ndiyo lazima itumike.

n32 g = 100;

n32 badilisha(n32* p) {
    *p = *p + 1000;
    rudisha 1;
}

n32 ongeza_g() {
    g = g + 1;
    rudisha g;
}

n32 jaribu_kielekezi_kushoto() {
    n32 x = 5;
    // kulia (x) inasomwa KWANZA = 5, kisha badilisha(&x) inaweka x=1005
    n32 r = badilisha(&x) + x;
    kama (r != 6) { rudisha 1; }
    kama (x != 1005) { rudisha 2; }
    x = 5;
    n32 s = badilisha(&x) - x;    // 1 - 5
    kama (s != (0 - 4)) { rudisha 3; }
    x = 5;
    n32 t = badilisha(&x) * x;    // 1 * 5
    kama (t != 5) { rudisha 4; }
    x = 5;
    kama (badilisha(&x) < x) { } sivyo { rudisha 5; }   // 1 < 5
    rudisha 0;
}

n32 jaribu_wito_kwenye_kigezo_cha_ulimwengu() {
    g = 100;
    // kulia (g) = 100 kwanza; ongeza_g() -> 101
    n32 r = ongeza_g() + g;
    kama (r != 201) { rudisha 1; }
    g = 100;
    n32 s = ongeza_g() - g;       // 101 - 100
    kama (s != 1) { rudisha 2; }
    // kushoto ni jani, kulia ni wito: kulia kwanza
    g = 100;
    n32 t = g + ongeza_g();       // 101 kwanza, kisha g = 101 => 202
    kama (t != 202) { rudisha 3; }
    g = 100;
    n32 u = g - ongeza_g();       // rhs=101; lhs g=101 => 0
    kama (u != 0) { rudisha 4; }
    rudisha 0;
}

n32 jaribu_faharisi_kwanza() {
    n32 a[4];
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    n32* p = a;
    n32 i = 1;
    n32 r = p[i] + p[i + 1];     // 20 + 30
    kama (r != 50) { rudisha 1; }
    n32 s = p[i + 2] - p[i];     // 40 - 20
    kama (s != 20) { rudisha 2; }
    rudisha 0;
}

n32 main() {
    n32 r = jaribu_kielekezi_kushoto();
    kama (r != 0) { rudisha 10 + r; }
    r = jaribu_wito_kwenye_kigezo_cha_ulimwengu();
    kama (r != 0) { rudisha 20 + r; }
    r = jaribu_faharisi_kwanza();
    kama (r != 0) { rudisha 30 + r; }
    rudisha 0;
}
