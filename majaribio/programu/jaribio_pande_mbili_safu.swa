// Msingi wa arr[i] kama jani: kigezo cha kielekezi (rejesta, rafu, paramu)
// kinapakiwa moja kwa moja rcx baada ya faharasa; safu ya ndani,
// kigezo cha ulimwengu na msingi usio jani hubaki kwenye njia ya asili.
husisha { maktaba/kumbukumbu.swa }

muundo Jozi { n32 a; n32 b; };

n32* g_ptr = 0;
n32 g_safu[4];

n32 t_paramu(n32* p, n64* q, n32 i) {
    kama (p[i] != 30) { rudisha 1; }
    kama (q[i - 1] != 5000000000) { rudisha 2; }
    kama (p[i - 1] + p[i + 1] != 60) { rudisha 3; }
    rudisha 0;
}

n32 jaribu_paramu() {
    n32* p = tenga(ukubwa(n32) * 4);
    n64* q = tenga(ukubwa(n64) * 4);
    p[0] = 10; p[1] = 20; p[2] = 30; p[3] = 40;
    q[0] = 1; q[1] = 5000000000; q[2] = 3;
    rudisha t_paramu(p, q, 2);
}

n32 jaribu_vielekezi_vingi() {
    // zaidi ya rejesta tano => baadhi ya vielekezi viko kwenye rafu
    n8 pedi[300];
    n32* a = tenga(ukubwa(n32) * 4);
    n32* b = tenga(ukubwa(n32) * 4);
    n32* c = tenga(ukubwa(n32) * 4);
    n32* d = tenga(ukubwa(n32) * 4);
    n32* e = tenga(ukubwa(n32) * 4);
    n32* f = tenga(ukubwa(n32) * 4);
    n32 i = 0;
    wakati (i < 4) {
        a[i] = i + 1;
        b[i] = (i + 1) * 10;
        c[i] = (i + 1) * 100;
        d[i] = (i + 1) * 1000;
        e[i] = (i + 1) * 10000;
        f[i] = (i + 1) * 100000;
        i = i + 1;
    }
    pedi[0] = 0;
    n32 j = 2;
    kama (a[j] + b[j] + c[j] + d[j] + e[j] + f[j] != 333333) { rudisha 1; }
    kama (f[j] - e[j] - d[j] != 267000) { rudisha 2; }
    kama (a[j - 1] * b[j - 1] != 40) { rudisha 3; }
    kama (f[j] > e[j]) { } sivyo { rudisha 4; }
    rudisha 0;
}

n32 jaribu_aina_za_vipengele() {
    n8* b = tenga(16);
    n16* h = tenga(ukubwa(n16) * 4);
    n64* w = tenga(ukubwa(n64) * 4);
    d64* d = tenga(ukubwa(d64) * 4);
    b[0] = 1; b[1] = 2; b[2] = 250;
    h[0] = 300; h[1] = 30000; h[2] = 0 - 5;
    w[0] = 4000000000; w[1] = 0 - 3;
    d[0] = 1.5; d[1] = 2.25;
    n32 i = 1;
    kama (b[i] + (b[i + 1] & 255) != 252) { rudisha 1; }
    kama (h[i] + h[i + 1] != 29995) { rudisha 2; }
    kama (w[i - 1] + w[i] != 3999999997) { rudisha 3; }
    kama (d[i - 1] + d[i] != 3.75) { rudisha 4; }
    rudisha 0;
}

n32 jaribu_muundo() {
    Jozi* z = tenga(ukubwa(Jozi) * 3);
    z[0].a = 1; z[0].b = 2;
    z[1].a = 3; z[1].b = 4;
    z[2].a = 5; z[2].b = 6;
    n32 i = 1;
    kama (z[i].a + z[i + 1].b != 9) { rudisha 1; }
    kama (z[i - 1].b * z[i].b != 8) { rudisha 2; }
    rudisha 0;
}

n32 faharasa_mara_mbili(n32 x) { rudisha x * 2; }

// Msingi ni jani lakini faharasa ina wito na msingi haubadilishwi na wito
n32 jaribu_faharasa_yenye_wito() {
    n32* p = tenga(ukubwa(n32) * 8);
    n32 i = 0;
    wakati (i < 8) { p[i] = i * i; i = i + 1; }
    kama (p[faharasa_mara_mbili(2)] != 16) { rudisha 1; }
    kama (p[faharasa_mara_mbili(1)] + p[faharasa_mara_mbili(3)] != 40) { rudisha 2; }
    rudisha 0;
}

// Msingi si jani (usemi, ulimwengu, safu ya ndani): njia ya asili
n32 jaribu_msingi_si_jani() {
    n32 loc[4];
    loc[0] = 7; loc[1] = 8; loc[2] = 9; loc[3] = 10;
    g_safu[0] = 70; g_safu[1] = 80; g_safu[2] = 90; g_safu[3] = 100;
    g_ptr = tenga(ukubwa(n32) * 4);
    g_ptr[0] = 1; g_ptr[1] = 2; g_ptr[2] = 3; g_ptr[3] = 4;
    n32 i = 2;
    kama (loc[i] + g_safu[i] + g_ptr[i] != 102) { rudisha 1; }
    n32* p = loc;
    kama ((p + 1)[i] != 10) { rudisha 2; }
    kama (loc[i - 1] - g_ptr[i - 1] != 6) { rudisha 3; }
    rudisha 0;
}

n32 main() {
    n32 r = jaribu_paramu();
    kama (r != 0) { rudisha 10 + r; }
    r = jaribu_vielekezi_vingi();
    kama (r != 0) { rudisha 20 + r; }
    r = jaribu_aina_za_vipengele();
    kama (r != 0) { rudisha 30 + r; }
    r = jaribu_muundo();
    kama (r != 0) { rudisha 40 + r; }
    r = jaribu_faharasa_yenye_wito();
    kama (r != 0) { rudisha 50 + r; }
    r = jaribu_msingi_si_jani();
    kama (r != 0) { rudisha 60 + r; }
    rudisha 0;
}
