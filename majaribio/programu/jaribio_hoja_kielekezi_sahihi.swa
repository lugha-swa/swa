// Hoja za kielekezi kwa kigezo cha kielekezi (na namba kwa namba)
// lazima zikubaliwe — ukaguzi mkali wa 2026-09-01 haupaswi
// kuvunja mchanganyiko halali.
n32 ongeza_kwa_kielekezi(n32* x, n32 v) {
    *x = *x + v;
    rudisha *x;
}
n32 main() {
    n32 a = 5;
    n32* p = &a;
    n32 r = ongeza_kwa_kielekezi(p, 3);
    kama (r != 8) rudisha 1;
    kama (a != 8) rudisha 2;
    rudisha 0;
}
