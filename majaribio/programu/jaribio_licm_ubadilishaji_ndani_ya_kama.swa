// LICM hatari #5: uchunguzi wa ubadilishaji lazima uwe wa MWILI MZIMA
// (unaojirudia ndani ya matawi ya "kama"), SI wa taarifa za ngazi ya
// juu tu. v inabadilishwa NDANI ya tawi la kama (i==2), ndani ya
// kitanzi -- ikiwa uchunguzi haukuingia ndani ya tawi hilo, ungedhania
// v haibadiliki kamwe ndani ya mwili na kuhamisha "v * 2" kimakosa
// kwa kutumia thamani yake ya awali (3) milele.
n32 main() {
    n32 n = 5;
    n32 v = 3;
    n32 i = 0;
    n32 y = 0;
    wakati (i < n) {
        kama (i == 2) {
            v = 100;
        }
        y = v * 2;
        i = i + 1;
    }
    // v: 3,3,100,100,100 kwa i=0..4 -> y ya mwisho (i=4) = 100*2=200
    kama (y != 200) { rudisha 1; }
    rudisha 0;
}
