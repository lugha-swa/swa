// Jaribio hasi: c[i]=c[i+1]+x -- faharisi ya LHS na ile ya RHS SI
// sawa kimuundo (i dhidi ya i+1), hivyo HAIKUBALIWI -- njia ya
// kawaida (isiyo na kashe ya anwani) lazima itumike, ikitoa matokeo
// SAHIHI (si ya kimakosa yaliyotokana na kashe isiyo sahihi).
husisha { msingi/maktaba/kumbukumbu.swa }

N32 main() {
    N32 n = 6;
    D64* c = tenga(ukubwa(D64) * n);
    N32 i = 0;
    wakati (i < n) { c[i] = i * 10; i = i + 1; }
    // c[i] = c[i+1] + 1 kwa i=0..4 (SI arr[e]=arr[e]+x -- faharisi tofauti)
    i = 0;
    wakati (i < 5) {
        c[i] = c[i + 1] + 1;
        i = i + 1;
    }
    // Baada ya operesheni: hesabu inategemea MPANGILIO wa utekelezaji
    // (kila c[i] inasoma c[i+1], ambayo bado haijabadilishwa kwa
    // mzunguko huu kwa sababu i<i+1 -- thamani asili bado). Tarajiwa:
    // c[0]=c_asili[1]+1=10+1=11, c[1]=c_asili[2]+1=20+1=21,
    // c[2]=30+1=31, c[3]=40+1=41, c[4]=50+1=51, c[5]=50 (haikuguswa)
    N32 c0 = c[0]; kama (c0 != 11) { rudisha 1; }
    N32 c1 = c[1]; kama (c1 != 21) { rudisha 2; }
    N32 c4 = c[4]; kama (c4 != 51) { rudisha 3; }
    N32 c5 = c[5]; kama (c5 != 50) { rudisha 4; }
    rudisha 0;
}
