// jaribio_mende_safu_ya_miundo: safu ya miundo — kipengele cha safu
// lazima kitoa ANWANI (lea) si thamani ya kwanza kama kielekezi (SEGV).
// Pia &nukta[1] + mshale (inatarajiwa 200).
// Inatarajiwa: 14 (nukta[1].x)
muundo Nukta { n32 x; n32 y; };

n32 main() {
    Nukta nukta[3];
    nukta[0].x = 10; nukta[0].y = 100;
    nukta[1].x = 14; nukta[1].y = 200;
    nukta[2].x = 18; nukta[2].y = 300;
    Nukta* p = &nukta[1];
    n32 s = nukta[1].x;
    s = s + p->y - 200;
    rudisha s;
}
