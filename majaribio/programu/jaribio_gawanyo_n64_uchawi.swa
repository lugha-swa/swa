// Zidisho na uchawi kwa n64 yenye ishara: kila kigawanyaji kwenye jedwali la
// gwm64_tafuta (uzalishaji.swa) -- x / D na x % D (D ni namba halisi, njia ya
// uchawi) lazima zilingane na x / fiche(D) na x % fiche(D) (kigezo cha
// wakati wa kukimbia, idiv halisi) kwa thamani za mpaka (INT64_MIN/MAX,
// karibu na vizidisho vya D) na maelfu ya thamani nasibu za mizani yote
// (2^0..2^63), chanya na hasi. Faili hili linazalishwa kwa mfuatano wa
// vigawanyaji vya jedwali -- likibadilisha jedwali, lisasishwe pia.

n64 kianzio_cha_nasibu = 88172645463325252;

n64 fiche(n64 v) { rudisha v; }

n64 nasibu() {
    kianzio_cha_nasibu = kianzio_cha_nasibu * 6364136223846793005 + 1442695040888963407;
    rudisha kianzio_cha_nasibu;
}

// rudisha 0 kama yote yanalingana, vinginevyo kigawanyaji kilichoshindwa
