N32 main() {
    N64 kubwa = 9223372036854775807;
    N64 kidogo = 0 - kubwa - 1;
    N64 r = kagua(0);
    kama (r != 0) { rudisha 1; }
    r = kagua(1);
    kama (r != 0) { rudisha 2; }
    r = kagua(0 - 1);
    kama (r != 0) { rudisha 3; }
    r = kagua(kubwa);
    kama (r != 0) { rudisha 4; }
    r = kagua(kidogo);
    kama (r != 0) { rudisha 5; }
    r = kagua(kubwa - 1);
    kama (r != 0) { rudisha 6; }
    r = kagua(kidogo + 1);
    kama (r != 0) { rudisha 7; }
    // karibu na vizidisho vya 10, 7, 1000, 10^9+7
    N64 m = 0;
    wakati (m < 300) {
        r = kagua(m);
        kama (r != 0) { rudisha 8; }
        r = kagua(0 - m);
        kama (r != 0) { rudisha 9; }
        r = kagua((kubwa / 1000) * 1000 - 150 + m);
        kama (r != 0) { rudisha 10; }
        r = kagua(kidogo / 1000 * 1000 - 150 + m);
        kama (r != 0) { rudisha 11; }
        r = kagua((kubwa / 1000000007) * 1000000007 - 150 + m);
        kama (r != 0) { rudisha 12; }
        m = m + 1;
    }
    // nasibu: mizani yote
    N32 i = 0;
    wakati (i < 6000) {
        N64 x = nasibu();
        N64 kiasi = nasibu() & 63;
        x = x >> kiasi;
        r = kagua(x);
        kama (r != 0) { rudisha 20; }
        i = i + 1;
    }
    rudisha 0;
}
