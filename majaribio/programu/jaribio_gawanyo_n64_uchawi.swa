    kama (x % 18 != x % opaque(18)) { rudisha 18; }
    kama (x / 19 != x / opaque(19)) { rudisha 19; }
    kama (x % 19 != x % opaque(19)) { rudisha 19; }
    kama (x / 20 != x / opaque(20)) { rudisha 20; }
    kama (x % 20 != x % opaque(20)) { rudisha 20; }
    kama (x / 21 != x / opaque(21)) { rudisha 21; }
    kama (x % 21 != x % opaque(21)) { rudisha 21; }
    kama (x / 22 != x / opaque(22)) { rudisha 22; }
    kama (x % 22 != x % opaque(22)) { rudisha 22; }
    kama (x / 23 != x / opaque(23)) { rudisha 23; }
    kama (x % 23 != x % opaque(23)) { rudisha 23; }
    kama (x / 24 != x / opaque(24)) { rudisha 24; }
    kama (x % 24 != x % opaque(24)) { rudisha 24; }
    kama (x / 25 != x / opaque(25)) { rudisha 25; }
    kama (x % 25 != x % opaque(25)) { rudisha 25; }
    kama (x / 26 != x / opaque(26)) { rudisha 26; }
    kama (x % 26 != x % opaque(26)) { rudisha 26; }
    kama (x / 27 != x / opaque(27)) { rudisha 27; }
    kama (x % 27 != x % opaque(27)) { rudisha 27; }
    kama (x / 28 != x / opaque(28)) { rudisha 28; }
    kama (x % 28 != x % opaque(28)) { rudisha 28; }
    kama (x / 29 != x / opaque(29)) { rudisha 29; }
    kama (x % 29 != x % opaque(29)) { rudisha 29; }
    kama (x / 30 != x / opaque(30)) { rudisha 30; }
    kama (x % 30 != x % opaque(30)) { rudisha 30; }
    kama (x / 31 != x / opaque(31)) { rudisha 31; }
    kama (x % 31 != x % opaque(31)) { rudisha 31; }
    kama (x / 33 != x / opaque(33)) { rudisha 33; }
    kama (x % 33 != x % opaque(33)) { rudisha 33; }
    kama (x / 34 != x / opaque(34)) { rudisha 34; }
    kama (x % 34 != x % opaque(34)) { rudisha 34; }
    kama (x / 35 != x / opaque(35)) { rudisha 35; }
    kama (x % 35 != x % opaque(35)) { rudisha 35; }
    kama (x / 36 != x / opaque(36)) { rudisha 36; }
    kama (x % 36 != x % opaque(36)) { rudisha 36; }
    kama (x / 37 != x / opaque(37)) { rudisha 37; }
    kama (x % 37 != x % opaque(37)) { rudisha 37; }
    kama (x / 38 != x / opaque(38)) { rudisha 38; }
    kama (x % 38 != x % opaque(38)) { rudisha 38; }
    kama (x / 39 != x / opaque(39)) { rudisha 39; }
    kama (x % 39 != x % opaque(39)) { rudisha 39; }
    kama (x / 40 != x / opaque(40)) { rudisha 40; }
    kama (x % 40 != x % opaque(40)) { rudisha 40; }
    kama (x / 41 != x / opaque(41)) { rudisha 41; }
    kama (x % 41 != x % opaque(41)) { rudisha 41; }
    kama (x / 42 != x / opaque(42)) { rudisha 42; }
    kama (x % 42 != x % opaque(42)) { rudisha 42; }
    kama (x / 43 != x / opaque(43)) { rudisha 43; }
    kama (x % 43 != x % opaque(43)) { rudisha 43; }
    kama (x / 44 != x / opaque(44)) { rudisha 44; }
    kama (x % 44 != x % opaque(44)) { rudisha 44; }
    kama (x / 45 != x / opaque(45)) { rudisha 45; }
    kama (x % 45 != x % opaque(45)) { rudisha 45; }
    kama (x / 46 != x / opaque(46)) { rudisha 46; }
    kama (x % 46 != x % opaque(46)) { rudisha 46; }
    kama (x / 47 != x / opaque(47)) { rudisha 47; }
    kama (x % 47 != x % opaque(47)) { rudisha 47; }
    kama (x / 48 != x / opaque(48)) { rudisha 48; }
    kama (x % 48 != x % opaque(48)) { rudisha 48; }
    kama (x / 49 != x / opaque(49)) { rudisha 49; }
    kama (x % 49 != x % opaque(49)) { rudisha 49; }
    kama (x / 50 != x / opaque(50)) { rudisha 50; }
    kama (x % 50 != x % opaque(50)) { rudisha 50; }
    kama (x / 51 != x / opaque(51)) { rudisha 51; }
    kama (x % 51 != x % opaque(51)) { rudisha 51; }
    kama (x / 52 != x / opaque(52)) { rudisha 52; }
    kama (x % 52 != x % opaque(52)) { rudisha 52; }
    kama (x / 53 != x / opaque(53)) { rudisha 53; }
    kama (x % 53 != x % opaque(53)) { rudisha 53; }
    kama (x / 54 != x / opaque(54)) { rudisha 54; }
    kama (x % 54 != x % opaque(54)) { rudisha 54; }
    kama (x / 55 != x / opaque(55)) { rudisha 55; }
    kama (x % 55 != x % opaque(55)) { rudisha 55; }
    kama (x / 56 != x / opaque(56)) { rudisha 56; }
