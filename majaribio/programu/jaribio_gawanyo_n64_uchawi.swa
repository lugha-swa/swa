    kama (x % 63 != x % opaque(63)) { rudisha 63; }
    kama (x / 100 != x / opaque(100)) { rudisha 100; }
    kama (x % 100 != x % opaque(100)) { rudisha 100; }
    kama (x / 125 != x / opaque(125)) { rudisha 125; }
    kama (x % 125 != x % opaque(125)) { rudisha 125; }
    kama (x / 250 != x / opaque(250)) { rudisha 250; }
    kama (x % 250 != x % opaque(250)) { rudisha 250; }
    kama (x / 255 != x / opaque(255)) { rudisha 255; }
    kama (x % 255 != x % opaque(255)) { rudisha 255; }
    kama (x / 257 != x / opaque(257)) { rudisha 257; }
    kama (x % 257 != x % opaque(257)) { rudisha 257; }
    kama (x / 360 != x / opaque(360)) { rudisha 360; }
    kama (x % 360 != x % opaque(360)) { rudisha 360; }
    kama (x / 500 != x / opaque(500)) { rudisha 500; }
    kama (x % 500 != x % opaque(500)) { rudisha 500; }
    kama (x / 600 != x / opaque(600)) { rudisha 600; }
    kama (x % 600 != x % opaque(600)) { rudisha 600; }
    kama (x / 1000 != x / opaque(1000)) { rudisha 1000; }
    kama (x % 1000 != x % opaque(1000)) { rudisha 1000; }
    kama (x / 3600 != x / opaque(3600)) { rudisha 3600; }
    kama (x % 3600 != x % opaque(3600)) { rudisha 3600; }
    kama (x / 10000 != x / opaque(10000)) { rudisha 10000; }
    kama (x % 10000 != x % opaque(10000)) { rudisha 10000; }
    kama (x / 12345 != x / opaque(12345)) { rudisha 12345; }
    kama (x % 12345 != x % opaque(12345)) { rudisha 12345; }
    kama (x / 65521 != x / opaque(65521)) { rudisha 65521; }
    kama (x % 65521 != x % opaque(65521)) { rudisha 65521; }
    kama (x / 65537 != x / opaque(65537)) { rudisha 65537; }
    kama (x % 65537 != x % opaque(65537)) { rudisha 65537; }
    kama (x / 86400 != x / opaque(86400)) { rudisha 86400; }
    kama (x % 86400 != x % opaque(86400)) { rudisha 86400; }
    kama (x / 100000 != x / opaque(100000)) { rudisha 100000; }
    kama (x % 100000 != x % opaque(100000)) { rudisha 100000; }
    kama (x / 1000000 != x / opaque(1000000)) { rudisha 1000000; }
    kama (x % 1000000 != x % opaque(1000000)) { rudisha 1000000; }
