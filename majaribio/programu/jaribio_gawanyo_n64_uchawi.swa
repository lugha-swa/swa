    kama (x % 10000000 != x % opaque(10000000)) { rudisha 10000000; }
    kama (x / 100000000 != x / opaque(100000000)) { rudisha 100000000; }
    kama (x % 100000000 != x % opaque(100000000)) { rudisha 100000000; }
    kama (x / 1000000000 != x / opaque(1000000000)) { rudisha 1000000000; }
    kama (x % 1000000000 != x % opaque(1000000000)) { rudisha 1000000000; }
    kama (x / 1000000007 != x / opaque(1000000007)) { rudisha 1000000007; }
    kama (x % 1000000007 != x % opaque(1000000007)) { rudisha 1000000007; }
    kama (x / 998244353 != x / opaque(998244353)) { rudisha 998244353; }
    kama (x % 998244353 != x % opaque(998244353)) { rudisha 998244353; }
