// Sethi-Ullman -- vipengele vya safu (arr[i]) kama majani ndani ya mti
// unaoshughulikiwa na SU: (arr[0]+arr[1]) + (arr[2]+arr[3]), haja=2.
// Umewekwa NDANI ya kitanzi (mara 3, ukibadilisha arr kila mzunguko)
// kwa makusudi -- SU sasa inatengwa TU kwa usemi unaorudiwa ndani ya
// kitanzi (angalia su_kina_kitanzi, uzalishaji.swa). arr={10,20,30,40}
// mzunguko wa 0 (jumla=100), kisha kila kipengele +1 kwa mzunguko
// unaofuata (jumla=104 mzunguko 1, jumla=108 mzunguko 2). Jumla ya
// jumla zote tatu = 100+104+108 = 312.
N32 arr[4];

N32 main() {
    arr[0] = 10; arr[1] = 20; arr[2] = 30; arr[3] = 40;
    N32 jumla_kuu = 0;
    N32 m = 0;
    wakati (m < 3) {
        N32 jumla = (arr[0] + arr[1]) + (arr[2] + arr[3]);
        jumla_kuu = jumla_kuu + jumla;
        arr[0] = arr[0] + 1; arr[1] = arr[1] + 1;
        arr[2] = arr[2] + 1; arr[3] = arr[3] + 1;
        m = m + 1;
    }
    kama (jumla_kuu != 312) { rudisha 1; }
    rudisha 0;
}
