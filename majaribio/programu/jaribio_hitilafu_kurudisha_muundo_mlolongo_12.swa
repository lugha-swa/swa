// jaribio_hitilafu_kurudisha_muundo_mlolongo_12: mlolongo wa sret wa baiti 12 --
// matokeo ya wito unaorudisha muundo mkubwa (>8B) yanapopitishwa
// kwa thamani kwa wito mwingine: jumlisha(tengeneza(10)). Kabla:
// kielekezi cha chombo cha sret kilipitishwa moja kwa moja (bila
// nakala) -- chombo kinachoweza kuandikwa tena na wito unaofuata.
// Mbegu haina hifadhi ya kutosha ya mrundikano kwa mfululizo huu (SEGV) --
// kamili pekee.
// Inatarajiwa: 33 (10 + 11 + 12)
muundo Tatu { n32 a; n32 b; n32 c; };

Tatu tengeneza(n32 x) {
    Tatu n;
    n.a = x;
    n.b = x + 1;
    n.c = x + 2;
    rudisha n;
}

n32 jumlisha(Tatu t) {
    rudisha t.a + t.b + t.c;
}

n32 anza() {
    rudisha jumlisha(tengeneza(10));
}
