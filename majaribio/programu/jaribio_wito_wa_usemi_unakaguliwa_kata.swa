// Mwito wa kazi katika NAFASI YA USEMI lazima ukaguliwe sawa na mwito
// wa taarifa (hitilafu ya 2026-09-01: mwito wa nafasi ya usemi ulikwepa
// ukaguzi wa aina). Idadi mbaya ya hoja hapa lazima ikataliwe kwa sauti.
// Kamili pekee.
n32 f(n32 x) { rudisha x; }
n32 anza() {
    n32 a = 5;
    n32 r = 10 + f(a, a);
    rudisha r;
}
