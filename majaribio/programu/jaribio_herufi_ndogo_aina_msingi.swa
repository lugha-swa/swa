// Aina za msingi kwa herufi ndogo (n8/n16/n32/n64, a32, d64, w0) sasa
// zinakubalika sanjari na herufi kubwa (N8/N16/N32/N64, A32, D64, W0)
// -- zinatoa familia/upana SAWA, si aina mbili tofauti. Sehemu ya
// kwanza ya uhamiaji wa Swa kwenda herufi ndogo kwa aina za msingi.
husisha { maktaba/kumbukumbu.swa }

n32 jumla_ndogo(n32 a, n32 b) {
    rudisha a + b;
}

n64 jumla_ndogo_64(n64 a, n64 b) {
    rudisha a + b;
}

d64 jumla_desimali(d64 a, d64 b) {
    rudisha a + b;
}

w0 hakuna_kazi() {
    rudisha;
}

n32 main() {
    n8 a = 5;
    kama (a != 5) { rudisha 1; }

    n16 b = 300;
    kama (b != 300) { rudisha 2; }

    n32 c = 70000;
    kama (c != 70000) { rudisha 3; }

    n64 d = 5000000000;
    kama (d != 5000000000) { rudisha 4; }

    d64 e = 1.5;
    n32 e_i = e * 1000.0;
    kama (e_i != 1500) { rudisha 5; }

    a32 h = 4000000000;
    kama (h != 4000000000) { rudisha 6; }

    w0 f;
    hakuna_kazi();

    kama (jumla_ndogo(3, 4) != 7) { rudisha 7; }
    kama (jumla_ndogo_64(3, 4) != 7) { rudisha 8; }

    d64 jd = jumla_desimali(1.5, 2.5);
    n32 jd_i = jd * 10.0;
    kama (jd_i != 40) { rudisha 9; }

    n32* p = tenga(ukubwa(n32) * 3);
    p[0] = 10;
    p[1] = 20;
    p[2] = 30;
    kama (p[0] + p[1] + p[2] != 60) { rudisha 10; }

    rudisha 0;
}
