// jaribio_mende_sret_mlolongo_8: mlolongo wa sret wa baiti 8 —
// matokeo ya wito unaorudisha muundo (sret) yanapopitishwa kwa
// thamani kwa wito mwingine: jumlisha(tengeneza(10)). Kabla: wito
// huku kama hoja ulionekana kama aina isiyojulikana (enc 0) na
// kielekezi cha bafa ya sret kikapitishwa kwa thamani — takataka
// isiyo na uhakika (jibu tofauti kila ukimbizaji).
// Inatarajiwa: 21 (10 + 11)
muundo Jozi { n32 a; n32 b; };

Jozi tengeneza(n32 x) {
    Jozi j;
    j.a = x;
    j.b = x + 1;
    rudisha j;
}

n32 jumlisha(Jozi j) {
    rudisha j.a + j.b;
}

n32 main() {
    rudisha jumlisha(tengeneza(10));
}
