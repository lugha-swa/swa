// arr[idx] = thamani (isiyo ya kiwanja, isiyo ya muundo) kwa msingi jani
// na RHS salama sasa hutumia SIB moja kwa moja ([r9+r8*saizi]) badala
// ya kukokotoa anwani kamili + push/pop -- angalia
// uzalishaji_hifadhi_safu_sib. Jaribio hili linakagua kila saizi ya
// kipengele, RHS salama dhidi ya isiyo salama (wito), kiwanja (lazima
// ibaki njia ya asili), muundo (lazima ibaki njia ya asili), na
// fahirisi kubwa (mwingiliano na rekebisho la #252).

husisha { msingi/maktaba/kumbukumbu.swa }

muundo Jozi { N32 a; N32 b; };
N64 kama_n64(N8* p) { rudisha p; }
N32 piga(N32 x) { rudisha x * 2; }   // WITO -- hufanya RHS isiwe salama

N32 jaribu_aina_zote() {
    N8* b8 = tenga(16);
    A8 u8[16];
    N16* b16 = tenga(ukubwa(N16) * 16);
    N32* b32 = tenga(ukubwa(N32) * 16);
    N64* b64 = tenga(ukubwa(N64) * 16);
    D32* d32 = tenga(ukubwa(D32) * 16);
    D64* d64 = tenga(ukubwa(D64) * 16);
    N32 i = 3;
    b8[i] = 0 - 5;
    u8[i] = 250;
    b16[i] = 0 - 3000;
    b32[i] = 0 - 300000;
    b64[i] = 0 - 5000000000;
    d32[i] = 2.5;
    d64[i] = 3.5;
    kama (b8[i] != (0 - 5)) { rudisha 1; }
    kama (u8[i] != 250) { rudisha 2; }
    kama (b16[i] != (0 - 3000)) { rudisha 3; }
    kama (b32[i] != (0 - 300000)) { rudisha 4; }
    kama (b64[i] != (0 - 5000000000)) { rudisha 5; }
    kama (d32[i] != 2.5) { rudisha 6; }
    kama (d64[i] != 3.5) { rudisha 7; }
    // jirani hazipaswi kuguswa
    kama (b32[i - 1] != 0 || b32[i + 1] != 0) { rudisha 8; }
    rudisha 0;
}

N32 jaribu_rhs_salama_na_isiyo_salama() {
    N32* p = tenga(ukubwa(N32) * 16);
    N32 i = 0;
    wakati (i < 16) { p[i] = i; i = i + 1; }
    // RHS salama: usemi wa hesabu na faharasa (njia mpya)
    p[5] = p[1] + p[2] * 3;
    kama (p[5] != 7) { rudisha 1; }
    // RHS isiyo salama (wito) -- lazima ibaki sahihi kupitia njia ya asili
    p[6] = piga(p[3]);
    kama (p[6] != 6) { rudisha 2; }
    // RHS salama inayosoma NAFASI ile ile inayoandikwa (p[7] tayari ni
    // 7 kutoka kwenye kitanzi cha awali -- usomaji lazima utumie
    // thamani hiyo YA SASA, si iliyoandikwa upya)
    p[7] = p[7] + 100;
    kama (p[7] != 107) { rudisha 3; }
    rudisha 0;
}

N32 jaribu_kiwanja_bado_sahihi() {
    // += / -= / *= LAZIMA ziendelee kutumia njia ya asili (haziguswi na
    // njia mpya -- kiwanja_salama inazuia)
    N32* p = tenga(ukubwa(N32) * 4);
    p[1] = 10;
    p[1] += 5;
    kama (p[1] != 15) { rudisha 1; }
    p[1] -= 3;
    kama (p[1] != 12) { rudisha 2; }
    p[1] *= 2;
    kama (p[1] != 24) { rudisha 3; }
    D64* d = tenga(ukubwa(D64) * 4);
    d[1] = 1.5;
    d[1] += 2.5;
    kama (d[1] != 4.0) { rudisha 4; }
    rudisha 0;
}

N32 jaribu_muundo_bado_sahihi() {
    Jozi* arr = tenga(ukubwa(Jozi) * 4);
    Jozi z;
    z.a = 7; z.b = 8;
    arr[1] = z;   // ugawaji wa muundo mzima -- lazima ubaki njia ya asili
    kama (arr[1].a != 7 || arr[1].b != 8) { rudisha 1; }
    rudisha 0;
}

N32 jaribu_fahirisi_kubwa() {
    // idx*saizi > 2^31 (angalia rekebisho la #252) -- lazima libaki
    // sahihi kupitia njia mpya ya SIB pia
    N64 idx = 600000000;
    N64* p = tenga(ukubwa(N64) * (idx + 2));
    p[idx] = 999888777;
    kama (p[idx] != 999888777) { rudisha 1; }
    N64 anwani = kama_n64(&p[idx]);
    N64 tarajiwa = kama_n64(p) + (idx * 8);
    kama (anwani != tarajiwa) { rudisha 2; }
    rudisha 0;
}

// Msingi ni safu ya ndani (si tenga()) -- lea rcx/r9 badala ya mov
N32 jaribu_safu_ya_ndani() {
    N32 arr[10];
    N32 i = 0;
    wakati (i < 10) { arr[i] = i * i; i = i + 1; }
    kama (arr[5] != 25) { rudisha 1; }
    kama (arr[9] != 81) { rudisha 2; }
    rudisha 0;
}

N32 main() {
    N32 r = jaribu_aina_zote();
    kama (r != 0) { rudisha 10 + r; }
    r = jaribu_rhs_salama_na_isiyo_salama();
    kama (r != 0) { rudisha 20 + r; }
    r = jaribu_kiwanja_bado_sahihi();
    kama (r != 0) { rudisha 30 + r; }
    r = jaribu_muundo_bado_sahihi();
    kama (r != 0) { rudisha 40 + r; }
    r = jaribu_fahirisi_kubwa();
    kama (r != 0) { rudisha 50 + r; }
    r = jaribu_safu_ya_ndani();
    kama (r != 0) { rudisha 60 + r; }
    rudisha 0;
}
