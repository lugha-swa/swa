// Jaribio la kudumu la takwimu.swa (lugha-swa/swa) -- PRNG na sampuli
// ya kawaida (Gaussian), sehemu inayofanya kazi SAWA kwenye mbegu NA
// stage1 (hoja/kurudisha ni n64/d64 TU, hakuna kielekezi -- angalia
// jaribio_takwimu_maelezo.swa kwa sehemu ya takwimu za maelezo, ambayo
// ni stage1 pekee kwa sababu ya d64* kwenye hoja).
// Kinafuata mtindo wa jaribio_k10f_hesabu.swa/jaribio_hesabu_trig.swa:
// nakala ya moja kwa moja ya kazi (si husisha).

n64 hesabu_kubwa(n64 a, n64 b) { kama (a > b) { rudisha a; } rudisha b; }
n64 hesabu_dogo(n64 a, n64 b) { kama (a < b) { rudisha a; } rudisha b; }

d64 mzizi_hesabu(d64 x) {
    kama (x <= 0.0) { rudisha 0.0; }
    d64 kisio = x;
    kama (kisio < 1.0) { kisio = 1.0; }
    n32 n = 0;
    wakati (n < 25) { kisio = 0.5 * (kisio + x / kisio); n = n + 1; }
    rudisha kisio;
}

d64 logasili_hesabu(d64 x) {
    kama (x <= 0.0) { rudisha 0.0; }
    d64 LN2 = 0.6931471805;
    n32 k = 0;
    d64 xr = x;
    wakati (xr > 2.0) { xr = xr / 2.0; k = k + 1; }
    wakati (xr < 0.5) { xr = xr * 2.0; k = k - 1; }
    d64 z = (xr - 1.0) / (xr + 1.0);
    d64 z2 = z * z;
    d64 jumla = 0.0;
    d64 neno = z;
    n32 i = 1;
    wakati (i <= 40) { d64 i_d = i; jumla = jumla + neno / i_d; neno = neno * z2; i = i + 2; }
    d64 k_d = k;
    rudisha 2.0 * jumla + k_d * LN2;
}

d64 pi_hesabu() { rudisha 3.1415926536; }

d64 cos_hesabu(d64 x) {
    d64 pi = pi_hesabu();
    d64 pi2 = pi + pi;
    wakati (x > pi) { x = x - pi2; }
    wakati (x <= (0.0 - pi)) { x = x + pi2; }
    d64 x2 = x * x;
    d64 jumla = 1.0;
    d64 neno = 1.0;
    n32 n = 1;
    wakati (n <= 20) {
        d64 n_d = n;
        d64 chini1 = 2.0 * n_d - 1.0;
        d64 chini2 = 2.0 * n_d;
        neno = neno * (0.0 - x2) / (chini1 * chini2);
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla;
}

n64 takwimu_hali = 88172645463325252;
n64 TAKWIMU_LCG_M = 6364136223846793005;
n64 TAKWIMU_LCG_I = 1442695040888963407;

w0 takwimu_panda(n64 mbegu) {
    kama (mbegu == 0) { takwimu_hali = 88172645463325252; rudisha; }
    takwimu_hali = mbegu;
}

n64 takwimu_nasibu_n64() {
    takwimu_hali = takwimu_hali * TAKWIMU_LCG_M + TAKWIMU_LCG_I;
    rudisha takwimu_hali;
}

n64 takwimu_nasibu_kati(n64 chini, n64 juu) {
    n64 lo = hesabu_dogo(chini, juu);
    n64 hi = hesabu_kubwa(chini, juu);
    n64 span = hi - lo;
    n64 idadi_thamani = span + 1;
    kama (idadi_thamani <= 0) { rudisha takwimu_nasibu_n64(); }
    n64 ghafi = takwimu_nasibu_n64();
    n64 m = ghafi % idadi_thamani;
    kama (m < 0) { m = m + idadi_thamani; }
    rudisha lo + m;
}

d64 takwimu_nasibu_d64() {
    n64 M = 9007199254740992;
    n64 r = takwimu_nasibu_kati(0, M - 1);
    d64 rd = r;
    d64 Md = M;
    rudisha rd / Md;
}

d64 takwimu_nasibu_kawaida(d64 wastani, d64 mkengeuko) {
    d64 u1 = takwimu_nasibu_d64();
    wakati (u1 <= 0.0) { u1 = takwimu_nasibu_d64(); }
    d64 u2 = takwimu_nasibu_d64();
    d64 r = mzizi_hesabu(0.0 - 2.0 * logasili_hesabu(u1));
    d64 pi2 = 2.0 * pi_hesabu();
    d64 theta = pi2 * u2;
    d64 z0 = r * cos_hesabu(theta);
    rudisha wastani + mkengeuko * z0;
}

n32 main() {
    // 1. Uamuzi (determinism): mbegu ile ile -> mfuatano ule ule halisi
    // (imekokotolewa mapema nje ya mradi; thibitisha hapa dhidi ya
    // minyororo yote miwili -- mbegu.bin na stage1 zilitoa thamani
    // IDENTICAL kwa jaribio hili wakati wa maendeleo).
    takwimu_panda(424242);
    n64 r1 = takwimu_nasibu_n64();
    kama (r1 != (0 - 3927032172765733607)) { rudisha 1; }
    n64 r2 = takwimu_nasibu_n64();
    kama (r2 != 4586170548915242420) { rudisha 2; }

    // 2. takwimu_nasibu_kati: masafa sahihi, idadi kubwa ya sampuli
    takwimu_panda(99);
    n32 i = 0;
    wakati (i < 20000) {
        n64 r = takwimu_nasibu_kati(1, 6);
        kama (r < 1 || r > 6) { rudisha 3; }
        i = i + 1;
    }
    // chini == juu lazima irudishe thamani hiyo hiyo kila mara
    i = 0;
    wakati (i < 50) {
        kama (takwimu_nasibu_kati(7, 7) != 7) { rudisha 4; }
        i = i + 1;
    }

    // 3. takwimu_nasibu_d64: [0.0, 1.0), wastani wa sampuli karibu 0.5,
    // decile hazina upendeleo mkubwa (mabadiliko ya kistatiki pekee).
    takwimu_panda(2024);
    n32 N = 100000;
    d64 jumla = 0.0;
    n32 decile[10];
    n32 di = 0;
    wakati (di < 10) { decile[di] = 0; di = di + 1; }
    i = 0;
    wakati (i < N) {
        d64 v = takwimu_nasibu_d64();
        kama (v < 0.0 || v >= 1.0) { rudisha 5; }
        jumla = jumla + v;
        n32 b = v * 10.0;
        kama (b < 0) { b = 0; }
        kama (b > 9) { b = 9; }
        decile[b] = decile[b] + 1;
        i = i + 1;
    }
    n64 Nn = N;
    d64 Nd = Nn;
    d64 wastani_u = jumla / Nd;
    kama (wastani_u < 0.48 || wastani_u > 0.52) { rudisha 6; }
    di = 0;
    wakati (di < 10) {
        // kigawo 8000..12000 kwa kila kifuko (10000 kinachotarajiwa,
        // ±20% -- sampuli 100k, mkengeuko wa kawaida wa kila kifuko
        // ni ~95 chini ya usambazaji sahihi, hivyo huu ni mpaka mpana
        // kwa makusudi, si mpaka mkali wa kistatiki).
        kama (decile[di] < 8000 || decile[di] > 12000) { rudisha 7; }
        di = di + 1;
    }

    // 4. takwimu_nasibu_kawaida: wastani/mkengeuko wa sampuli karibu
    // na vigezo vilivyoombwa (N kubwa, Box-Muller).
    takwimu_panda(31415);
    d64 jumla_g = 0.0;
    d64 jumla_g2 = 0.0;
    i = 0;
    wakati (i < N) {
        d64 g = takwimu_nasibu_kawaida(50.0, 10.0);
        jumla_g = jumla_g + g;
        jumla_g2 = jumla_g2 + g * g;
        i = i + 1;
    }
    d64 wastani_g = jumla_g / Nd;
    d64 tofauti_g = jumla_g2 / Nd - wastani_g * wastani_g;
    d64 mkengeuko_g = mzizi_hesabu(tofauti_g);
    kama (wastani_g < 49.0 || wastani_g > 51.0) { rudisha 8; }
    kama (mkengeuko_g < 9.5 || mkengeuko_g > 10.5) { rudisha 9; }

    rudisha 0;
}
