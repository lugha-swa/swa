// Mpaka kwenye hoja za wito: hoja ya kamili inabadilishwa hadi
// parameta ya d64 na kinyume — zamani hoja ilisukumwa kwa rejesta
// isiyo sahihi na kutoa takataka.
d64 ongeza(d64 x, d64 y) { rudisha x + y; }
n32 kata(d64 x) { rudisha x; }
n32 main() {
    kama (ongeza(2, 3) != 5.0) rudisha 1;
    kama (ongeza(2.5, 1) != 3.5) rudisha 2;
    kama (kata(2.9) != 2) rudisha 3;
    rudisha 0;
}
