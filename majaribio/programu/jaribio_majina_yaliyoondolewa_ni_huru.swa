// Majina yaliyoondolewa hayana maana maalum tena: programu inaweza
// kuyafafanua yenyewe kama majina mengine yoyote.
// Inatarajiwa: kutoka 31 = 6 + 5 + 20.
husisha { msingi/maktaba/kumbukumbu.swa }
n32 gcd_hesabu(n32 a, n32 b) { rudisha 6; }
n32 sys_soma(n32 x) { rudisha x + 4; }
n32 main() { rudisha 20; }
n32 anza() {
    n32 vunja = 0;
    vunja = gcd_hesabu(1, 1) + sys_soma(1) + main();
    rudisha vunja;
}
