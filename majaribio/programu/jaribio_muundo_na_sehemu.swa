// Muundo na ufikiaji wa sehemu. (Hoja ya muundo kwa thamani haijatulia
// kwenye mbegu — kielekezi kinafanya kazi minyororo yote miwili.)
muundo Nukta { n32 x; n32 y; };

n32 pata_x(Nukta* p) { rudisha p->x; }

n32 main() {
    Nukta n;
    n.x = 42;
    n.y = 7;
    kama (pata_x(&n) != 42) rudisha 1;
    rudisha 0;
}
