// Ugawaji wa rejesta, awamu ya 2 (paramu) -- paramu ya SABA (7),
// iliyopitishwa KWENYE RAFU ya mpigaji (ABI: hoja 7+ hazipitiwi kwa
// rejesta), bado inaweza kuwa mgombea wa rejesta ya kudumu ikiwa
// paramu za awali (pa/pb/pc/pd, vielekezi) hazikidhi masharti --
// hii inajaribu njia ya pili (andika_pakia_gp_reg_kwa_enc haitumiki
// hapa; njia ya "hoja za rafu" pekee). Thamani halisi imekokotolewa
// kwa mkono: g(=3) x mara 3 = 9; e+f=1+2=3; *pa+*pb+*pc+*pd=10+20+
// 30+40=100; jumla=3+9+100=112.
n32 jaribu(n32* pa, n32* pb, n32* pc, n32* pd, n32 e, n32 f, n32 g) {
    n32 i = 0;
    n32 g_jumla = 0;
    wakati (i < 3) {
        g_jumla = g_jumla + g;
        i = i + 1;
    }
    rudisha e + f + g_jumla + *pa + *pb + *pc + *pd;
}

n32 main() {
    n32 x1 = 10;
    n32 x2 = 20;
    n32 x3 = 30;
    n32 x4 = 40;
    rudisha jaribu(&x1, &x2, &x3, &x4, 1, 2, 3);
}
