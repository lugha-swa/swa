// Kupunguza nguvu kwa mgawanyo/modulo -- BILA ISHARA (a32/a64):
// hakuna hatari ya upendeleo kabisa (hakuna nambari hasi kuwepo),
// hivyo SHR/AND rahisi ni sahihi moja kwa moja. Thamani KUBWA
// iliyochaguliwa MAKUSUDI (4000000000) ni HASI ikiwa ingesomwa kwa
// makosa kama n32 yenye ishara (biti ya juu imewekwa) -- hii
// inathibitisha njia ya bila-ishara HAITUMII SAR (ambayo ingetoa
// jibu tofauti kabisa kwa thamani hii) bali SHR (logical) pekee.
husisha { msingi/maktaba/kumbukumbu.swa }

n32 jaribu_a32_thamani_kubwa() {
    a32 x = 4000000000;  // biti ya juu imewekwa -- hasi kama n32
    a32 q = x / 4;
    a32 r = x % 4;
    // 4000000000 / 4 = 1000000000 hasa
    kama (q != 1000000000) { rudisha 1; }
    kama (r != 0) { rudisha 2; }

    a32 y = 4000000001;
    a32 q2 = y / 4;
    a32 r2 = y % 4;
    kama (q2 != 1000000000) { rudisha 3; }
    kama (r2 != 1) { rudisha 4; }
    rudisha 0;
}

n32 jaribu_a64_thamani_kubwa() {
    a64 x = 18000000000000000000;
    a64 q = x / 16;
    a64 r = x % 16;
    kama (q != 1125000000000000000) { rudisha 1; }
    kama (r != 0) { rudisha 2; }
    rudisha 0;
}

n32 main() {
    n32 r1 = jaribu_a32_thamani_kubwa();
    kama (r1 != 0) { rudisha 100 + r1; }
    n32 r2 = jaribu_a64_thamani_kubwa();
    kama (r2 != 0) { rudisha 200 + r2; }
    rudisha 0;
}
