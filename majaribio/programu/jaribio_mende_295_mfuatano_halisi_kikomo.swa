// lugha-swa/swa#295 -- jaribio la kudumu dhidi ya "anwani za string
// literal zinazochanganyikiwa na mtiririko wa udhibiti" baada ya #292
// kurekebishwa: pale idadi ya JUMLA ya herufi halisi (string literals)
// za KIPEKEE kwenye kitengo kimoja cha utafsiri inapovuka 1024,
// uzalishaji.swa (str_off/str_len/str_lebo_id[1024], str_buf[16384])
// ilijaa KIMYA -- kusanya_herufi() ilichapisha "KOSA: ... limejaa"
// kwenye stderr LAKINI IKAENDELEA (haikusimamisha ukusanyaji),
// ikirudisha -1. -1 hiyo ilipofika uzalishaji_kitambulisho, AGIZO LA
// LEA (kupakia anwani ya mfuatano ndani ya rax) LILIRUKWA KABISA --
// hakuna agizo lolote lililotolewa kwa mfuatano huo husika. Rejesta
// (rax) ilibaki na THAMANI YA ZAMANI isiyohusiana (anwani ya
// mfuatano mwingine uliopakiwa kwa mafanikio tayari kwenye msimbo),
// ikisababisha kigezo kupewa ANWANI YA MFUATANO MBAYA kimya kimya --
// bila kosa la kukusanya, bila kuanguka (SIGSEGV), kazi ikimaliza
// kwa msimbo wa kutoka sahihi vinginevyo. Hesabu halisi (ALU/FPU)
// hazikuharibika, ni ANWANI za mfuatano tu zilizochanganyikiwa --
// hii ndiyo dalili halisi iliyoripotiwa kwenye #295 (thibitisho
// linaloandika "PASS: B" badala ya maandishi sahihi, "B" ikiwa
// ni mfuatano mwingine uliotumika KATIKA WITO ULIOTANGULIA).
//
// Jaribio hili (lililotengenezwa kiotomatiki) huunda kazi 1050, kila
// mmoja akiwa na: (1) kigezo "nanga" chenye herufi halisi YA KUDUMU
// inayorudiwa kila mara ("NANGA_SHIKAMANO", huanza na 'N'=78 -- hii
// hupewa nafasi #0 ya jedwali la str_* mara ya kwanza tu inapoonekana,
// kisha hudumishwa/kutambuliwa upya kwa dedup kila mara baadaye), na
// (2) kigezo "m" chenye herufi halisi YA KIPEKEE ("KIPEKEE_<i>", huanza
// na 'K'=75, 'I'=73). "nanga" hupewa thamani mara moja kabla ya "m"
// kwenye kila kazi ili kuhakikisha anwani YA MWISHO ILIYOPAKIWA KWA
// MAFANIKIO ibaki kwenye rax ikiwa agizo la LEA la "m" litarukwa --
// mkataba HASA uliosababisha #295.
//
// Ukaguzi WA MAKUSUDI haulinganishi "m" na herufi halisi NYINGINE
// (ambayo yenyewe ingekuwa chini ya hitilafu ile ile baada ya
// kikomo kuvukwa, na kuweza "kupitisha" kimakosa ikiwa pande zote
// mbili zingegeuka kuwa anwani ile ile potovu) -- badala yake
// hukagua BAITI GHAFI za "m" dhidi ya namba za ASCII zilizowekwa
// kwa mkono moja kwa moja (75, 73), ukaguzi usiotegemea
// kusanya_herufi kabisa. "m" ikiwa imeharibika (ikielekeza kwa
// "nanga" badala yake) itaanza na 78 ('N'), si 75 ('K') -- kaunta
// ya ulimwengu "kosa" huongezeka kwa kila hitilafu kama hiyo.
//
// Herufi 1..~1024 za kwanza zinapaswa kuwa SAHIHI (ndani ya kikomo
// cha ZAMANI); zilizobaki ndizo zilizokuwa zinaharibika KABLA ya
// rekebisho hili. UTHIBITISHO WA MUTATION (umefanywa kabla ya PR
// hii): kurudisha uzalishaji.swa kwenye hali ya awali (kabla ya
// rekebisho) na kujenga upya stage1 hutoa hasa dalili hii --
// kukusanya kwa "mafanikio" (rudisha-msimbo 0, "KOSA" kwenye
// stderr PEKEE, si kwenye njia inayozuia), kisha kuendesha
// binary hutoa msimbo wa kutoka usio sifuri (idadi ya mfuatano
// uliopotoshwa). Baada ya rekebisho (ongezeko la str_*[1024] hadi
// str_*[65536] + str_buf[16384] hadi str_buf[1048576], na ukaguzi
// wa kufurika sasa unasimamisha ukusanyaji -- exit 1 -- badala ya
// kuendelea kimya), jaribio hili hurudisha 0.
//
// stage1 pekee (mbegu haina ukomo huu wa str_*[1024] -- bwawa lake
// la herufi (STR_POOL_SIZE) tayari ni kubwa zaidi tangu Agosti 2026).
husisha { msingi/maktaba/kumbukumbu.swa }

n32 kosa = 0;

n32 kaz0() { n8* nanga = "NANGA_SHIKAMANO"; n8* m = "KIPEKEE_0"; kama (m == 0 || m[0] != 75 || m[1] != 73) { kosa = kosa + 1; } rudisha 0; }
n32 kaz1() { n8* nanga = "NANGA_SHIKAMANO"; n8* m = "KIPEKEE_1"; kama (m == 0 || m[0] != 75 || m[1] != 73) { kosa = kosa + 1; } rudisha 0; }
