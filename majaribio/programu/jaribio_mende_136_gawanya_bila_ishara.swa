// Mende 136: mgawanyo wa aina bila ishara yenye biti ya juu ulitoa
// SIGFPE (msimbo wa toka 136) — cdq/cqo ilipanua ishara kabla ya div.
// Sasa edx inafutwa kwa xor edx,edx (upanuzi wa sifuri) kwa A/B/W,
// na idiv yenye ishara haijarejea nyuma (kukata hadi sifuri).
// Stage1 pekee: mbegu inakataa familia A/B/W kabisa.
n32 main() {
    a32 a = 3000000000;
    a32 b = a / 2;
    kama (b != 1500000000) { rudisha 1; }
    a32 c = a / 3;
    kama (c != 1000000000) { rudisha 2; }
    a32 d = a % 2;
    kama (d != 0) { rudisha 3; }
    a32 e = a % 7;
    kama (e != 4) { rudisha 4; }
    a32 f = 4294967295;
    a32 g = f / 1;
    kama (g != 4294967295) { rudisha 5; }
    b32 h = 3000000000;
    b32 i = h / 2;
    kama (i != 1500000000) { rudisha 6; }
    b32 j = h % 2;
    kama (j != 0) { rudisha 7; }
    w32 k = 3000000000;
    w32 l = k / 2;
    kama (l != 1500000000) { rudisha 8; }
    a64 m = 9223372036854775808;
    a64 n = m / 2;
    kama (n != 4611686018427387904) { rudisha 9; }
    a64 o = m % 3;
    kama (o != 2) { rudisha 10; }
    a64 p = 18446744073709551615;
    a64 q = p / 3;
    kama (q != 6148914691236517205) { rudisha 11; }
    // Zenye ishara: kukata hadi sifuri (C-semantiki) — haijarejea nyuma.
    n32 r = -7 / 2;
    kama (r != -3) { rudisha 12; }
    n32 s = -7 % 3;
    kama (s != -1) { rudisha 13; }
    n64 t = -7 / 2;
    kama (t != -3) { rudisha 14; }
    n64 u = -7 % 3;
    kama (u != -1) { rudisha 15; }
    rudisha 0;
}
