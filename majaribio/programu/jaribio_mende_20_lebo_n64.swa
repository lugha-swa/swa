// Mende 20: lebo za n64 kubwa (> 2^31) hazikulingana kamwe — lebo
// ilikuwa inakuwa 0 kwenye kizazi. Sasa lebo ya n64 inalinganishwa
// kwa 64-bit na selecta ya n64.
n32 main() {
    n64 x = 5000000000; n32 s = 0;
    chagua (x) { hali 5000000000: s = 77; sivyo: s = 88; }
    kama (s != 77) { rudisha 1; }
    s = 0;
    n64 y = 5000000001;
    chagua (y) { hali 5000000000: s = 77; sivyo: s = 88; }
    kama (s != 88) { rudisha 2; }
    s = 0;
    n64 z = 3000000000;
    chagua (z) { hali 2000000000: s = 11; hali 3000000000: s = 77; sivyo: s = 88; }
    kama (s != 77) { rudisha 3; }
    rudisha 0;
}
