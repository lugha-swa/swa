// c[idx] += / -= / *= thamani -- thamani ya sasa inashikiliwa bila rafu
// pale inapowezekana: N32/N64 kulia ni jani (rcx moja kwa moja), desimali
// kulia isiyo na wito (xmm2..xmm7), na kulia yenye wito (njia ya rafu, kwa
// sababu wito unaharibu xmm).
husisha { msingi/maktaba/kumbukumbu.swa }

D64 mara_tatu(D64 x) { rudisha x * 3.0; }
N32 mara_saba(N32 x) { rudisha x * 7; }
D64 jozi(D64* w) { rudisha w[0] * w[1] + w[2] * w[3]; }

N32 jaribu_namba() {
    N32* c = tenga(ukubwa(N32) * 100);
    N64* l = tenga(ukubwa(N64) * 100);
    N32 i = 3;
    N32 n = 10;
    N32 j = 5;
    N32 k = 6;
    N64 big = 5000000000;
    c[i * n + j] = 100;
    c[i * n + j] += k;                    // kulia ni kigezo (jani)
    kama (c[i * n + j] != 106) { rudisha 1; }
    c[i * n + j] -= 6;                    // kulia ni namba
    kama (c[i * n + j] != 100) { rudisha 2; }
    c[i * n + j] *= k;                    // 600
    kama (c[i * n + j] != 600) { rudisha 3; }
    c[i * n + j] += k * n + 1;            // kulia si jani: 600 + 61
    kama (c[i * n + j] != 661) { rudisha 4; }
    c[i * n + j] += mara_saba(k);         // kulia ina wito: 661 + 42
    kama (c[i * n + j] != 703) { rudisha 5; }
    c[i * n + j] -= c[i * n + j - 1] + 3; // kulia inasoma safu ile ile (0 + 3)
    kama (c[i * n + j] != 700) { rudisha 6; }
    l[i * n + j] = 1;
    l[i * n + j] += big;                  // N64 jani
    kama (l[i * n + j] != 5000000001) { rudisha 7; }
    l[i * n + j] -= big;
    kama (l[i * n + j] != 1) { rudisha 8; }
    l[i * n + j] += 0 - 3;                // namba hasi, upana 8
    kama (l[i * n + j] != (0 - 2)) { rudisha 9; }
    rudisha 0;
}

N32 jaribu_desimali() {
    D64* d = tenga(ukubwa(D64) * 100);
    D64* w = tenga(ukubwa(D64) * 4);
    N32 i = 3;
    N32 n = 10;
    N32 j = 5;
    D64 x = 0.5;
    w[0] = 1.0; w[1] = 2.0; w[2] = 3.0; w[3] = 4.0;
    d[i * n + j] = 4.0;
    d[i * n + j] += x;                    // jani: 4.5
    kama (d[i * n + j] != 4.5) { rudisha 1; }
    d[i * n + j] -= x * 3.0;              // isiyo na wito: 4.5 - 1.5
    kama (d[i * n + j] != 3.0) { rudisha 2; }
    d[i * n + j] *= w[1] * w[2];          // 3 * 6 = 18
    kama (d[i * n + j] != 18.0) { rudisha 3; }
    d[i * n + j] += mara_tatu(w[0]);      // ina wito: 18 + 3
    kama (d[i * n + j] != 21.0) { rudisha 4; }
    d[i * n + j] -= jozi(w);              // ina wito unaotumia xmm2/xmm3: 21 - 14
    kama (d[i * n + j] != 7.0) { rudisha 5; }
    d[i * n + j] += w[0] * w[1] + w[2] * w[3];   // 7 + 14
    kama (d[i * n + j] != 21.0) { rudisha 6; }
    d[i * n + j] -= d[i * n + j - 1] + 1.0;      // kulia inasoma safu ile ile
    kama (d[i * n + j] != 20.0) { rudisha 7; }
    rudisha 0;
}

N32 jaribu_d32() {
    D32* f = tenga(ukubwa(D32) * 10);
    N32 i = 2;
    f[i * 2 + 1] = 1.5;
    f[i * 2 + 1] += 2.25;
    kama (f[i * 2 + 1] != 3.75) { rudisha 1; }
    f[i * 2 + 1] *= 2.0;
    kama (f[i * 2 + 1] != 7.5) { rudisha 2; }
    rudisha 0;
}

N32 main() {
    N32 r = jaribu_namba();
    kama (r != 0) { rudisha 10 + r; }
    r = jaribu_desimali();
    kama (r != 0) { rudisha 30 + r; }
    r = jaribu_d32();
    kama (r != 0) { rudisha 50 + r; }
    rudisha 0;
}
