// Jaribio la kudumu la kuzuia urudiaji: mkaguzi_thibitisha_aina_ya_muundo
// (mkaguzi.swa, iliyoongezwa kurekebisha pengo la jina-lisilotambuliwa,
// angalia jaribio_muundo_asiyetangazwa_*.swa) LAZIMA isivunje muundo
// unaojirejelea kupitia kielekezi (mfano nodi ya orodha iliyounganishwa)
// -- "Nodi" bado haijasajiliwa kwenye muundo_nodes[] wakati mwili wake
// wenyewe unachanganuliwa, lakini itakuwa imesajiliwa kabla ya
// uthibitisho kufanyika (angalia mkaguzi_angalia: pitia ya kwanza
// inakusanya miundo YOTE kabla ya uthibitisho wowote). Stage1 pekee.
muundo Nodi {
    n32 thamani;
    Nodi* ijayo;
}
n32 main() {
    Nodi a;
    Nodi b;
    a.thamani = 1;
    a.ijayo = &b;
    b.thamani = 2;
    b.ijayo = 0;
    rudisha a.ijayo->thamani;
}
