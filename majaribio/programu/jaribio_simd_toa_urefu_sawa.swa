// Uvektishaji (SIMD): c[i] = a[i] - b[i], urefu 10 (SAWA kimakusudi --
// jozi 5 hasa, awamu ya mabaki haitatekelezwa kabisa). a[i]=100+i,
// b[i]=i, matokeo yanayotarajiwa c[i]=100 kwa kila i.
husisha { maktaba/kumbukumbu.swa }
n32 main() {
    n32 n = 10;
    d64* a = tenga(ukubwa(d64) * n);
    d64* b = tenga(ukubwa(d64) * n);
    d64* c = tenga(ukubwa(d64) * n);
    n32 i = 0;
    wakati (i < n) {
        d64 ai = 100 + i;
        a[i] = ai;
        b[i] = i;
        i = i + 1;
    }
    i = 0;
    wakati (i < n) {
        c[i] = a[i] - b[i];
        i = i + 1;
    }
    i = 0;
    wakati (i < n) {
        kama (c[i] != 100) { rudisha i + 1; }
        i = i + 1;
    }
    rudisha 0;
}
