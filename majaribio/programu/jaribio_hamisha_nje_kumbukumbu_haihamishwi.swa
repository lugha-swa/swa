// LICM hatari #2: usemi wowote unaogusa kumbukumbu (kipengele cha
// safu/nyoosha kama arr[i], *p, s.f, s->f) HAUCHUKULIWI KAMWE kuwa
// "usiobadilika", hata kama fahirisi yake ni ya moja kwa moja (arr[0]).
// arr[0] inabadilishwa NDANI ya mzunguko kila mzunguko -- kama
// "arr[0] + 1" ingehamishwa (kimakosa) nje ya mzunguko ikitegemea
// thamani ya kwanza tu, jumla ingekuwa isiyo sahihi (kila mzunguko
// ungeongeza namba ile ile ya kwanza badala ya thamani iliyosasishwa).
husisha { msingi/maktaba/kumbukumbu.swa }

n32 anza() {
    n32* safu = tenga(ukubwa(n32) * 4);
    safu[0] = 1;
    n32 jumla = 0;
    n32 i = 0;
    wakati (i < 4) {
        safu[0] = safu[0] + 1;
        jumla = jumla + safu[0];
        i = i + 1;
    }
    // arr[0]: 2,3,4,5 -> sum = 2+3+4+5 = 14
    kama (jumla != 14) { rudisha 1; }
    rudisha 0;
}
