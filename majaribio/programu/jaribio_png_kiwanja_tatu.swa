// Peephole ya push/pop (rax/rcx) -- kesi maalum "push X; push X; pop X"
// (nakala mbili za rejesta MOJA, kisha pop moja) inayotokana na
// uzalishaji_asimilia_kiwanja_tail (kashe ya anwani ya kiwanja/
// ugawaji wa kawaida) -- lazima itoe: push HALISI MOJA TU (nakala ya
// kwanza), rejesta ikibaki bila kubadilika (nakala ya pili + pop
// hulingana kabisa). c[i*n+j] += 7 kisha -= 3, i=3,n=10,j=5 (fahirisi
// tata, sawa na kipimo cha matriki) -- kianzio 0 -> 7 -> 4.
n32 c[100];

n32 main() {
    n32 i = 3;
    n32 n = 10;
    n32 j = 5;
    c[i * n + j] += 7;
    kama (c[i * n + j] != 7) { rudisha 1; }
    c[i * n + j] -= 3;
    kama (c[i * n + j] != 4) { rudisha 2; }
    rudisha 0;
}
