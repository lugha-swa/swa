// Jaribio la kuzuia urudiaji la mdudu wa PILI HALISI uliogunduliwa
// (angalia maelezo kamili juu ya su_haja_rejista katika uzalishaji.swa
// -- kipengele hiki kimezimwa kwa sasa, lakini jaribio hili
// linathibitisha mpangilio wa utathmini SAHIHI (kulia KABLA ya
// kushoto) unaotumika kila mahali kwenye mkusanyaji huu, na
// litaendelea kuthibitisha hilo endapo kipengele cha ugawaji wa
// rejesta cha vigezo vya muda kitawashwa tena siku moja BILA
// kubadilisha mpangilio huu (jaribio la awali la Sethi-Ullman
// lilijaribu kutathmini upande "mgumu zaidi" bila kujali muundo,
// likibadilisha mpangilio kwa kesi nyingi -- hii ilithibitika
// kuvunja mkusanyaji WENYEWE wakati wa kujijenga upya, kwa sababu
// msimbo wenye wito wa kazi wenye madhara ya kando unategemea
// mpangilio wa asili).
husisha { msingi/maktaba/kumbukumbu.swa }

n32 kaunta = 0;
n32 alama_kulia = 0;
n32 alama_kushoto = 0;

n32 kulia_kazi() {
    kaunta = kaunta + 1;
    alama_kulia = kaunta;
    rudisha 10;
}

n32 kushoto_kazi() {
    kaunta = kaunta + 1;
    alama_kushoto = kaunta;
    rudisha 20;
}

n32 main() {
    n32 r = kushoto_kazi() + kulia_kazi();
    // Mpangilio SAHIHI (kulia kabla ya kushoto, kama njia ya asili):
    // kulia_kazi() inaitwa KWANZA (alama_kulia=1), kisha kushoto_kazi()
    // (alama_kushoto=2).
    kama (alama_kulia != 1) { rudisha 1; }
    kama (alama_kushoto != 2) { rudisha 2; }
    kama (r != 30) { rudisha 3; }
    rudisha 0;
}
