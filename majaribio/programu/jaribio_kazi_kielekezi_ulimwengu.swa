// Kielekezi cha kazi katika kigezo cha ULIMWENGU: anwani inagawiwa
// wakati wa kukimbia (bss), wito unafuata rip-rel. Hati 4.3.
n32 nyongeza(n32 x) { rudisha x + 1; }
n8* kazi_ulimwengu;
n32 main() {
    kazi_ulimwengu = &nyongeza;
    n32 r = kazi_ulimwengu(41);
    kama (r != 42) rudisha 1;
    rudisha 0;
}
