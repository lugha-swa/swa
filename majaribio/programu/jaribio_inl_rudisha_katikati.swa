// inl_rudisha_katikati: "rudisha;" TUPU inayotokea KATIKATI ya mwili
// (si taarifa ya mwisho) HAIPASWI kuruhusu kuunganishwa -- ingesababisha
// usukaji kuendelea kutekeleza taarifa zilizofuata rudisha hiyo,
// jambo ambalo linapingana na maana halisi ("acha kutekeleza sasa").
// Jaribio hili linathibitisha kazi kama hiyo (isiyostahili kuunganishwa)
// bado inatoa matokeo sahihi ikiachwa kama wito wa kweli.
W0 andika_ikiwa(N32* mahali, N32 x) {
    *mahali = 1;
    rudisha;
    *mahali = 99;
}

N32 main() {
    N32 matokeo;
    matokeo = 0;
    andika_ikiwa(&matokeo, 5);
    kama (matokeo != 1) { rudisha 1; }
    rudisha 0;
}
