// Kazi (kiwango cha juu) yenye hoja ya kielekezi kwa muundo
// unaotangazwa BAADAYE kwenye faili -- uthibitisho kwamba
// mkaguzi_thibitisha_aina_ya_muundo (angalia jaribio_muundo_
// asiyetangazwa_*.swa) haiathiri usajili wa saini za kazi
// (mkaguzi_sajili_kazi), ambao unafanyika BAADA ya pitia ya kwanza
// kukusanya miundo yote. Stage1 pekee.
n32 tumia(Baadaye* p) {
    rudisha p->v;
}
muundo Baadaye { n32 v; }
n32 main() {
    Baadaye x;
    x.v = 9;
    rudisha tumia(&x);
}
