// vunja ndani ya fanya inaondoka kwenye kitanzi mara moja bila
// kujaribu sharti tena. Bila vunja, s ingekuwa 2 (mwendo wa pili
// ungekamilika, kisha sharti (i < 2) lingekoma).
// Stage1 pekee: mbegu bado haijui neno la fanya.
n32 main() {
    n32 s = 0;
    n32 i = 0;
    fanya {
        i = i + 1;
        kama (i >= 2) { vunja; }
        s = s + 1;
    } wakati (i < 2);
    rudisha s;
}
