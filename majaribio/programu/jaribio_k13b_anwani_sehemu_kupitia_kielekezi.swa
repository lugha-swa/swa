// Anwani ya sehemu ya muundo kupitia kielekezi -- si hoja ya kazi.
// (Toleo la awali lilitumia safu ya muundo -- mbegu haijui safu za
// muundo, ilileta SEGV; kielekezi cha muundo kinafanya kazi minyororo yote miwili.)
muundo Nukta { n32 x; n32 y; }

n32 anza() {
    Nukta n;
    Nukta* p = &n;
    p->x = 10;
    p->y = 20;
    n32* anwani = &p->y;  // &p->y SIO hoja ya kazi -- inajaribu uzalishaji pekee
    *anwani = 42;
    rudisha n.x + n.y;  // 10 + 42 = 52
}
