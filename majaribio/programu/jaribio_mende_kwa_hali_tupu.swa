// kwa yenye hali iliyoachwa: hali = kweli daima (semantiki ya C).
// Zamani mnyororo wa uzalishaji ulichukulia hali tupu kama uongo —
// mwili haukuwahi kutekelezwa (jibu baya la kimya).
n32 main() {
    n32 s = 0;
    n32 i = 0;
    kwa (i = 0; ; i = i + 1) {
        s = s + 1;
        kama (s >= 3) vunja;
    }
    rudisha s;
}
