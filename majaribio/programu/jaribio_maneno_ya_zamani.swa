// Maneno ya zamani (vunja, main, andika_stderr) bado yanakusanywa kwa toleo
// moja, kwa onyo -- ili miradi mingine ihamie kwenda acha, anza, andika_kosa.
// Mbegu inajua maneno mapya pekee, kwa hiyo jaribio hili ni la stage1.
// Inatarajiwa: kutoka 7.
husisha { kumbukumbu.swa }
n32 main() {
    n32 i = 0;
    wakati (i < 10) {
        kama (i == 7) { vunja; }
        i = i + 1;
    }
    andika_stderr("i=%d\n", i);
    rudisha i;
}
