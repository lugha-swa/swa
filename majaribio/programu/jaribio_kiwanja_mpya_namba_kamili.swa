// Jaribio la N32 (namba kamili): c[i]=c[i]+a[i]*b[i] (ZIDISHA kwenye
// upande wa "x", JUMLISHA kwenye ngazi ya juu -- muundo wa pili
// unaokubaliwa) -- kuthibitisha njia ya namba kamili bado sahihi na
// mpya (si tu D64).
husisha { msingi/maktaba/kumbukumbu.swa }

N32 main() {
    N32 n = 10;
    N32* a = tenga(ukubwa(N32) * n);
    N32* b = tenga(ukubwa(N32) * n);
    N32* c = tenga(ukubwa(N32) * n);
    N32 i = 0;
    wakati (i < n) {
        a[i] = i + 1;
        b[i] = 2;
        c[i] = 100;
        i = i + 1;
    }
    i = 0;
    wakati (i < n) {
        c[i] = c[i] + a[i] * b[i];
        i = i + 1;
    }
    // c[i] tarajiwa = 100 + (i+1)*2
    i = 0;
    wakati (i < n) {
        N32 tarajiwa = 100 + (i + 1) * 2;
        kama (c[i] != tarajiwa) { rudisha i + 1; }
        i = i + 1;
    }
    rudisha 0;
}
