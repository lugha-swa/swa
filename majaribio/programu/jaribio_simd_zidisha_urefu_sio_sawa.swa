// Uvektishaji (SIMD): c[i] = a[i] * b[i], urefu 15 (SIO SAWA) --
// jaribio la tatu la operesheni (jumlisha na toa tayari yamejaribiwa)
// pamoja na awamu nyingine ya mabaki. a[i]=i, b[i]=i, c[i]=i*i.
husisha { maktaba/kumbukumbu.swa }
N32 main() {
    N32 n = 15;
    D64* a = tenga(ukubwa(D64) * n);
    D64* b = tenga(ukubwa(D64) * n);
    D64* c = tenga(ukubwa(D64) * n);
    N32 i = 0;
    wakati (i < n) {
        a[i] = i;
        b[i] = i;
        i = i + 1;
    }
    i = 0;
    wakati (i < n) {
        c[i] = a[i] * b[i];
        i = i + 1;
    }
    i = 0;
    wakati (i < n) {
        D64 tarajiwa = i * i;
        kama (c[i] != tarajiwa) { rudisha i + 1; }
        i = i + 1;
    }
    rudisha 0;
}
