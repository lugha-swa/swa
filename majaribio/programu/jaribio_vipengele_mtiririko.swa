// jaribio_vipengele_mtiririko.swa -- mtiririko: endelea na vunja ndani ya
// wakati, kama ndani ya kama, kwa yenye kianzio cha kigezo au cha kigeu
// kilichotangazwa tayari, kazi ya w0, na kitanzi tupu kisichoisha
// (kinakusanywa; hakiitwi). 0 = yote sawa.

n32 kama_mbili(n32 x) {
    kama (x > 0) {
        kama (x > 10) {
            rudisha 2;
        }
        rudisha 1;
    }
    rudisha 0;
}

n32 kwa_na_kigezo(n32 i) {
    n32 s = 0;
    kwa (i = 0; i < 5; i = i + 1) { s = s + i; }
    rudisha s;
}

n32 KIHESABU = 0;
w0 ongeza_kihesabu() {
    KIHESABU = KIHESABU + 1;
}

w0 subiri_milele() {
    wakati (1) { }
}

n32 anza() {
    // endelea: i = 1..5, 3 inarukwa -> 1+2+4+5
    n32 i = 0;
    n32 s = 0;
    wakati (i < 5) {
        i = i + 1;
        kama (i == 3) { endelea; }
        s = s + i;
    }
    kama (s != 12) rudisha 1;

    // vunja kutoka wakati (1)
    i = 0;
    wakati (1) {
        kama (i >= 5) { acha; }
        i = i + 1;
    }
    kama (i != 5) rudisha 2;

    kama (kama_mbili(0) != 0) rudisha 3;
    kama (kama_mbili(5) != 1) rudisha 4;
    kama (kama_mbili(11) != 2) rudisha 5;

    kama (kwa_na_kigezo(99) != 10) rudisha 6;
    n32 j;
    n32 t = 0;
    kwa (j = 0; j < 5; j = j + 1) { t = t + 1; }
    kama (t != 5 || j != 5) rudisha 7;

    ongeza_kihesabu();
    ongeza_kihesabu();
    kama (KIHESABU != 2) rudisha 8;

    n32 hesabu = 0;
    i = 0;
    wakati (i < 3) { hesabu = hesabu + 1; i = i + 1; }
    kama (hesabu != 3 || i != 3) rudisha 9;
    rudisha 0;
}
