// jaribio_mfumo_hoja_1_hadi_7.swa — wito_wa_mfumo kwa kila idadi
// ya hoja 1-7: zote zinaendesha (getpid, hoja za ziada hazina
// madhara). Hoja ya 8+ inakataliwa (jaribio_mende_wito_mfumo_hoja_8_kata).
n32 main() {
    n64 p = wito_wa_mfumo(39);
    kama (p <= 0) rudisha 1;
    p = wito_wa_mfumo(39, 0);
    kama (p <= 0) rudisha 2;
    p = wito_wa_mfumo(39, 0, 0);
    kama (p <= 0) rudisha 3;
    p = wito_wa_mfumo(39, 0, 0, 0);
    kama (p <= 0) rudisha 4;
    p = wito_wa_mfumo(39, 0, 0, 0, 0);
    kama (p <= 0) rudisha 5;
    p = wito_wa_mfumo(39, 0, 0, 0, 0, 0);
    kama (p <= 0) rudisha 6;
    p = wito_wa_mfumo(39, 0, 0, 0, 0, 0, 0);
    kama (p <= 0) rudisha 7;
    rudisha 0;
}
