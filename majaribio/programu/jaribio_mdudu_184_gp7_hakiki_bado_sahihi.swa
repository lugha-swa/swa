// lugha-swa/swa#184 -- jaribio la kudumu la kuthibitisha kesi
// iliyokuwa SAHIHI tayari (vigezo 7 vyote vya GP, hakuna d64)
// haikuvunjika na rekebisho la #184 -- hii NDIYO kesi halisi ya
// GP inayozidi rejesta 6, inayohitaji hoja 1 kubaki rafuni kweli.
n32 jumla7(n32 a, n32 b, n32 c, n32 d, n32 e, n32 f, n32 g) {
    rudisha a + b + c + d + e + f + g;
}
n32 main() {
    n32 i = 0;
    n32 s = 0;
    wakati (i < 50) {
        s = jumla7(1, 2, 3, 4, 5, 6, 7);
        i = i + 1;
    }
    rudisha s;
}
