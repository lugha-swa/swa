// UAMIZI WA 2026-08-31: hakuna mwanguko wa mkono hadi mkono
// (fall-through) kwenye chagua — kila mkono wa hali unamalizika
// peke yake, sawa na vunja ya kimya kwenye C. Mkono usio na
// taarifa yoyote haufanyi chochote. (stage1 pekee: mbegu haijui
// neno la chagua.)
n32 kadiria(n32 x) {
    n32 s = 0;
    chagua (x) {
        hali 1: s = s + 1;
        hali 2: s = s + 10;
        hali 3:
    }
    rudisha s;
}

n32 main() {
    kama (kadiria(1) != 1) rudisha 1;
    kama (kadiria(2) != 10) rudisha 2;
    kama (kadiria(3) != 0) rudisha 3;
    kama (kadiria(9) != 0) rudisha 4;
    rudisha 0;
}
