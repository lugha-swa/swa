// Sethi-Ullman -- jaribio MUHIMU ZAIDI: linathibitisha hitilafu ya ABI
// iliyogunduliwa (rejesta za "ziada" za SU lazima zihifadhiwe/
// kurudishwa na utangulizi/mwisho wa KAZI INAYOZITUMIA, angalia
// maelezo kamili karibu na su_ni_kushughulikiwa kwenye uzalishaji.swa)
// imerekebishwa KWELI.
//
// MUHIMU: chanzo cha data ni SAFU (garr[i]), SI vigezo vya ULIMWENGU
// vya moja kwa moja -- majaribio mawili ya awali ya usemi huu
// (vigezo vya ulimwengu visivyobadilika; kisha vigezo vilivyochanganywa
// na "+k") yote yalishindwa kimya kabisa na LICM (PR #236, iliyoungana
// KABLA ya sehemu hii): LICM inaweza kuhamisha SEHEMU TU ya mti
// (mti mdogo wa juu zaidi usiobadilika), ikiacha kilichobaki na haja
// ndogo mno (<2) kwa SU kukataa kabla hata kufika kwenye jaribio
// lililokusudiwa. Kusoma kutoka SAFU (AST_TAJA) HAKUWEZI KAMWE
// kuchukuliwa kuwa usiobadilika na LICM (hakuna uchambuzi wa alias --
// angalia maelezo ya LICM) HATA kama thamani za garr kwa HALISI
// hazibadiliki kamwe -- hivyo mti mzima unabaki NDANI ya kitanzi
// kikamilifu, bila kujali maudhui yake HALISI.
//
// mpigaji() ina vigezo VITANO vya ndani vinavyostahili rejesta
// (x1..x5, rega_tumika_idadi=5 -- vinatumia rbx/r12/r13/r14/r15
// ZOTE). kazi_ndogo() ina vigezo VIWILI vya ndani (jumla,k --
// rega_tumika_idadi=2, id 0,1 = rbx,r12; garr ni safu ya ULIMWENGU,
// SI mgombea wa rejesta) na usemi wa SU wenye haja=3 ndani ya kitanzi
// -- su_rejestwa_idadi=3, ikitumia id 2,3,4 (r13,r14,r15) -- ZILE
// ZILE ambazo mpigaji() ameshikilia x3,x4,x5.
//
// Kama utangulizi/mwisho wa kazi_ndogo() haukuhifadhi/kurudisha
// rejesta hizo (mdudu wa awali), thamani za x3,x4,x5 za mpigaji()
// zingeharibika KIMYA mara tu kazi_ndogo() inaporudi. Jaribio hili
// linathibitisha x1..x5 ZOTE zinabaki sahihi BAADA ya wito.
N32 garr[4];

N32 kazi_ndogo() {
    // haja=3 kwa ((garr[0]+garr[1])+garr[2])+garr[3], kinarudiwa mara
    // 5 ndani ya kitanzi -- jumla ya kila mzunguko = 100 (10+20+30+40),
    // jumla ya mizunguko 5 = 500.
    N32 jumla = 0;
    N32 k = 0;
    wakati (k < 5) {
        jumla = jumla + (((garr[0] + garr[1]) + garr[2]) + garr[3]);
        k = k + 1;
    }
    rudisha jumla;
}

N32 mpigaji() {
    garr[0] = 10; garr[1] = 20; garr[2] = 30; garr[3] = 40;
    N32 x1 = 111; N32 x2 = 222; N32 x3 = 333; N32 x4 = 444; N32 x5 = 555;
    N32 r = kazi_ndogo();
    kama (r != 500) { rudisha 1; }
    kama (x1 != 111) { rudisha 2; }
    kama (x2 != 222) { rudisha 3; }
    kama (x3 != 333) { rudisha 4; }
    kama (x4 != 444) { rudisha 5; }
    kama (x5 != 555) { rudisha 6; }
    rudisha 0;
}

N32 main() { rudisha mpigaji(); }
