// Kama/sivyo bila mabano: taarifa MOJA (semantiki ya C). Mdudu wa
// 2026-09-01: mwili wa sivyo bila mabano ulitekelezwa KILA mara
// (kama (1) a = 1; sivyo a = 2; ulitoa 2). Sasa: 1 kwa kweli, 2
// kwa uwongo. Stage1 pekee: mbegu ya zamani bado ina mdudu.
n32 main() {
    n32 a = 0;
    kama (1) a = 1;
    sivyo a = 2;
    kama (a != 1) rudisha 1;
    kama (0) a = 9;
    sivyo a = 2;
    kama (a != 2) rudisha 2;
    rudisha 0;
}
