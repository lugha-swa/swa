// Kama/sivyo bila mabano: taarifa MOJA (semantiki ya C). Hitilafu ya
// 2026-09-01: maudhui ya sivyo bila mabano yalitekelezwa KILA mara
// (kama (1) a = 1; sivyo a = 2; ulitoa 2). Sasa: 1 kwa kweli, 2
// kwa uwongo. Kamili pekee: awali ya zamani bado ina hitilafu.
n32 anza() {
    n32 a = 0;
    kama (1) a = 1;
    sivyo a = 2;
    kama (a != 1) rudisha 1;
    kama (0) a = 9;
    sivyo a = 2;
    kama (a != 2) rudisha 2;
    rudisha 0;
}
