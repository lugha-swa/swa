// ukubwa(JinaLaMuundo) na muundo halisi (uliotangazwa) -- uthibitisho
// kwamba mkaguzi_ukubwa_hoja (alama mpya inayoruhusu jina la
// aina/muundo kama hoja ya ukubwa(...) kupita ukaguzi wa "kitambulisho
// hakijafafanuliwa") haiathiri usahihi wa ukubwa() kwa jina la muundo
// halisi -- si tu aina za msingi (angalia majaribio mengine
// yanayotumia ukubwa(n32) n.k.). Stage1 pekee.
muundo Kitu {
    n32 a;
    n32 b;
}
n32 main() {
    rudisha ukubwa(Kitu);
}
