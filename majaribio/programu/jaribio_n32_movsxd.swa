// Kusoma kigezo cha n32 chenye ishara hutumia movsxd moja (badala ya
// mov + cdqe). Thamani hasi lazima zipanuliwe kwa ishara katika kila
// muktadha wa biti 64: ugawaji kwa n64, hoja ya n64, faharasa hasi ya
// safu, hesabu na n64, kurudi.
husisha { msingi/maktaba/kumbukumbu.swa }

n64 kama_n64(n64 v) { rudisha v; }
n32 kama_n32(n32 v) { rudisha v; }

n32 jaribu_rejesta() {
    n32 x = 0 - 5;
    n64 w = x;
    kama (w != (0 - 5)) { rudisha 1; }
    kama (kama_n64(x) != (0 - 5)) { rudisha 2; }
    n64 y = 1000000000000;
    kama (y + x != 999999999995) { rudisha 3; }
    kama (x + y != 999999999995) { rudisha 4; }
    n32* p = tenga(ukubwa(n32) * 8);
    p[3] = 33;
    n32 k = 4;
    n32 m = 0 - 1;
    kama (p[k + m] != 33) { rudisha 5; }
    n32* q = p + 4;
    kama (q[m] != 33) { rudisha 6; }
    kama (q[x + 4] != q[0 - 1]) { rudisha 7; }
    rudisha 0;
}

n32 jaribu_rafu() {
    // vigezo vingi: baadhi kwenye rafu
    n32 a = 0 - 1; n32 b = 0 - 2; n32 c = 0 - 3; n32 d = 0 - 4; n32 e = 0 - 5; n32 f = 0 - 6; n32 g = 0 - 7; n32 h = 0 - 8;
    n32 i = 0;
    n32 s = 0;
    wakati (i < 2) {
        s = s + a + b + c + d + e + f + g + h;
        i = i + 1;
    }
    kama (s != (0 - 72)) { rudisha 1; }
    n64 w1 = a; n64 w2 = b; n64 w3 = c; n64 w4 = d; n64 w5 = e; n64 w6 = f; n64 w7 = g; n64 w8 = h;
    kama (w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8 != (0 - 36)) { rudisha 2; }
    kama (kama_n64(h) != (0 - 8)) { rudisha 3; }
    kama (kama_n64(a) != (0 - 1)) { rudisha 4; }
    n64 tofauti = h;
    tofauti = tofauti * 1000000000;
    kama (tofauti != (0 - 8000000000)) { rudisha 5; }
    rudisha 0;
}

// Aina zisizoguswa: a32 (bila ishara), n8, n16
n32 jaribu_bila_ishara() {
    a32 u = 0;
    u = u - 1;                 // 4294967295
    kama (u < 5) { rudisha 1; }
    kama (u + 1 != 0) { rudisha 2; }
    n8 b = 0 - 3;
    n32 wb = b;
    kama (wb != (0 - 3)) { rudisha 3; }
    n16 h = 0 - 300;
    n32 wh = h;
    kama (wh != (0 - 300)) { rudisha 4; }
    rudisha 0;
}

// Paramu (njia ya paramu haijabadilishwa)
n64 t_paramu(n32 v, n32 z) { n64 w = v; n64 y = z; rudisha w * 1000 + y; }
n32 jaribu_paramu() {
    kama (t_paramu(0 - 2, 5) != (0 - 1995)) { rudisha 1; }
    kama (kama_n32(0 - 9) != (0 - 9)) { rudisha 2; }
    rudisha 0;
}

n32 main() {
    n32 r = jaribu_rejesta();
    kama (r != 0) { rudisha 10 + r; }
    r = jaribu_rafu();
    kama (r != 0) { rudisha 20 + r; }
    r = jaribu_bila_ishara();
    kama (r != 0) { rudisha 30 + r; }
    r = jaribu_paramu();
    kama (r != 0) { rudisha 40 + r; }
    rudisha 0;
}
