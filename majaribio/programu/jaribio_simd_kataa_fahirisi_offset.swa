// Uvektishaji (SIMD): kesi hasi -- fahirisi ya a SI kitambulisho sawa
// na i (ni "i + 1"), hivyo muundo HAUKUBALIWI kabisa -- kitanzi kizima
// lazima kiendelee kupitia njia ya kawaida ya scalar, ikitoa matokeo
// sahihi bado. a[i+1]+b[i] kwa i=0..4 (a ina urefu 6, b na c urefu 5).
// a[k]=k, b[i]=i*10 => c[i] = (i+1) + i*10.
husisha { maktaba/kumbukumbu.swa }
N32 main() {
    N32 n = 5;
    D64* a = tenga(ukubwa(D64) * (n + 1));
    D64* b = tenga(ukubwa(D64) * n);
    D64* c = tenga(ukubwa(D64) * n);
    N32 i = 0;
    wakati (i < (n + 1)) {
        a[i] = i;
        i = i + 1;
    }
    i = 0;
    wakati (i < n) {
        b[i] = i * 10;
        i = i + 1;
    }
    i = 0;
    wakati (i < n) {
        c[i] = a[i + 1] + b[i];
        i = i + 1;
    }
    i = 0;
    wakati (i < n) {
        D64 tarajiwa = (i + 1) + (i * 10);
        kama (c[i] != tarajiwa) { rudisha i + 1; }
        i = i + 1;
    }
    rudisha 0;
}
