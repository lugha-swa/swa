// Sethi-Ullman -- mwingiliano na ugawaji wa rejesta wa vigezo vya
// ndani (PR #226/#227): kazi hii ina vigezo VITANO vya ndani
// (vinavyostahili rejesta), hivyo rega_tumika_idadi=5 na nafasi
// iliyobaki kwa SU (su_rejestwa_idadi) = 5-5 = 0. Usemi wa SU
// unaostahili (v1+v2)+((v3+v4)+m), haja=2, umewekwa NDANI ya kitanzi
// ili kuhakikisha ni SABABU YA REJESTA (SI ukosefu wa kitanzi)
// inayosababisha kukataliwa -- lazima ukatae SU kabisa (nafasi=0 <
// haja yoyote) na kutumia njia ya asili ya push/pop.
//
// MUHIMU: v1..v4 zinabadilishwa (+1) KILA mzunguko wa kitanzi kwa
// makusudi (SI kwa sababu ya jaribio lenyewe, bali kuzuia LICM,
// PR #236, kuhamisha SEHEMU ya usemi nje ya kitanzi -- v1..v4
// zisingebadilika, LICM ingehamisha (v1+v2) na (v3+v4) kando kando
// kabla ya SU kufikia usemi, ikiacha haja<2 na jaribio lisijaribu
// sababu sahihi -- angalia maelezo sawa kwenye jaribio_su_kina_kirefu
// na jaribio_su_abi_uhifadhi_wa_mpigaji). Kubadilika kwa v1..v4
// kunazuia LICM kikamilifu bila kuongeza mgombea mpya wa rejesta
// (v1..v5 tayari zipo). v5 haibadiliki kamwe -- inatumika kuthibitisha
// rejesta zake haziathiriki na SU kukataa/kukubali kwingineko.
//
// Thamani kwa kila m (KABLA ya kuongeza v1..v4): m=0: (100+200)+
// ((300+400)+0)=1000; m=1: (101+201)+((301+401)+1)=1005; m=2:
// (102+202)+((302+402)+2)=1010. Jumla=3015. v1..v4 baada ya
// mizunguko 3: 103,203,303,403.
N32 jaribu() {
    N32 v1 = 100; N32 v2 = 200; N32 v3 = 300; N32 v4 = 400; N32 v5 = 500;
    N32 jumla_kuu = 0;
    N32 m = 0;
    wakati (m < 3) {
        jumla_kuu = jumla_kuu + (v1 + v2) + ((v3 + v4) + m);
        v1 = v1 + 1; v2 = v2 + 1; v3 = v3 + 1; v4 = v4 + 1;
        m = m + 1;
    }
    kama (jumla_kuu != 3015) { rudisha 1; }
    kama (v5 != 500) { rudisha 2; }
    kama (v1 != 103) { rudisha 3; }
    kama (v2 != 203) { rudisha 4; }
    kama (v3 != 303) { rudisha 5; }
    kama (v4 != 403) { rudisha 6; }
    rudisha 0;
}

N32 main() { rudisha jaribu(); }
