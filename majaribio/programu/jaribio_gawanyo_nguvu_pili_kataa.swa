// Kupunguza nguvu kwa mgawanyo/modulo -- majaribio hasi: kigawanyaji
// ambacho SI nguvu kamili ya 2 (3, 5, 6, 7) na kigawanyaji ambacho SI
// cha KUDUMU (kigezo cha wakati wa kukimbia, hata kikiwa na thamani
// ya nguvu ya 2) -- vyote lazima viendelee kutumia njia ya asili ya
// idiv (isiyoguswa kabisa na mabadiliko haya), na kutoa matokeo
// sahihi.
//
// MUHIMU: x (kigawiwa) NI KIGEZO (si namba halisi ya moja kwa moja
// kwenye AST ya mgawanyo) HATA pale x imepewa thamani na usemi wa
// kudumu -- hii inaepuka KABISA mkondo wa kukunja namba
// (jaribu_kunja_namba, msambazaji.swa), usiohusiana na kazi hii,
// wenye mdudu wake WA KWAKE (usioguswa hapa, angalia ujumbe wa PR
// kwa maelezo kamili -- umegunduliwa wakati wa kuandaa majaribio haya,
// umeripotiwa kando).
husisha { msingi/maktaba/kumbukumbu.swa }

n32 jaribu_si_nguvu_ya_pili() {
    n32 a = 0 - 17;
    n32 q = a / 3;
    n32 r = a % 3;
    kama (q != (0 - 5)) { rudisha 1; }
    kama (r != (0 - 2)) { rudisha 2; }
    kama ((q * 3) + r != a) { rudisha 3; }

    n32 b = 22;
    n32 q2 = b / 5;
    n32 r2 = b % 5;
    kama (q2 != 4) { rudisha 4; }
    kama (r2 != 2) { rudisha 5; }

    n32 c = 0 - 13;
    n32 q3 = c / 6;
    n32 r3 = c % 6;
    kama (q3 != (0 - 2)) { rudisha 6; }
    kama (r3 != (0 - 1)) { rudisha 7; }

    n32 e = 29;
    n32 q4 = e / 7;
    n32 r4 = e % 7;
    kama (q4 != 4) { rudisha 8; }
    kama (r4 != 1) { rudisha 9; }

    rudisha 0;
}

n32 jaribu_kigawanyaji_sio_kudumu() {
    // d ni kigezo (si nambari halisi ya moja kwa moja kwenye AST ya
    // usemi wa mgawanyo) -- gwm_kipeo_kulia HAIWEZI kutambua d kama
    // nguvu ya 2 (nguvu_kamili_ya_pili inahitaji AST_NAMBARI moja kwa
    // moja), hivyo njia ya asili ya idiv inaendelea kutumika hata
    // ingawa d=4 (nguvu kamili ya 2) HALISI wakati wa kukimbia.
    n32 d = 4;
    n32 x = 0 - 7;
    n32 q = x / d;
    n32 r = x % d;
    kama (q != (0 - 1)) { rudisha 1; }
    kama (r != (0 - 3)) { rudisha 2; }
    rudisha 0;
}

n32 main() {
    n32 r1 = jaribu_si_nguvu_ya_pili();
    kama (r1 != 0) { rudisha 100 + r1; }
    n32 r2 = jaribu_kigawanyaji_sio_kudumu();
    kama (r2 != 0) { rudisha 200 + r2; }
    rudisha 0;
}
