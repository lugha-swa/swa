// Kasoro ya rafu ya wito_wa_mfumo: mkusanyaji ulitengeneza "pop r9"
// usio na masharti kwa hoja ya 7 (ofseti) — kwa wito wenye hoja
// chini ya 7, rafu iliteleza +8 kwa kila wito. Baada ya wito 4,
// push zilizofuata ziliandika kwenye sloti za vigezo vya ndani na
// kuharibu maadili yao (na hatimaye anwani ya kurudi kwenye mnyororo
// wa uzalishaji — SEGV).
//
// Wito 4 wa hoja 4 (namba + hoja 3), hoja ya pili ni 7 (isiyo 0) ili
// uharibifu uonekane. Vigezo 6 vya ndani vinapaswa kunusurika wito
// wote — ukaguzi wa mwisho unathibitisha rafu ilisawazika.
n32 main() {
    n32 a = 8;
    n32 b = 11;
    n32 c = 1;
    n32 d = 0;
    n32 e = 5;
    n32 f = 9;
    wito_wa_mfumo(0, 7, 0, 0);  // read(7, 0, 0) = 0, salama
    wito_wa_mfumo(0, 7, 0, 0);
    wito_wa_mfumo(0, 7, 0, 0);
    wito_wa_mfumo(0, 7, 0, 0);
    kama (a != 8) rudisha 1;
    kama (b != 11) rudisha 2;
    kama (c != 1) rudisha 3;
    kama (d != 0) rudisha 4;
    kama (e != 5) rudisha 5;
    kama (f != 9) rudisha 6;
    rudisha 0;
}
