// Peephole ya push/pop (rax/rcx) -- usemi wenye kina kirefu, wenye
// jozi NYINGI za push/pop mfululizo, kuthibitisha kwamba mfumo wa
// kuahirisha (png_akiba_reg -- moja tu inayosubiri kwa wakati mmoja)
// hauchanganyikiwi na mfuatano wa jozi HURU (kila moja ikitolewa na
// kufungwa kabla ya inayofuata kuanza), si jozi moja tu.
// (((a+b)*(c+d))-((e*f)+(g-h))) na a=2,b=3,c=4,d=5,e=6,f=7,g=8,h=1
// -> (5*9) - (42+7) = 45 - 49 = -4
n32 main() {
    n32 a = 2; n32 b = 3; n32 c = 4; n32 d = 5;
    n32 e = 6; n32 f = 7; n32 g = 8; n32 h = 1;
    n32 r = ((a + b) * (c + d)) - ((e * f) + (g - h));
    rudisha r + 100;  // -4 + 100 = 96 (epuka kanusho hasi kwenye msimbo wa kutoka)
}
