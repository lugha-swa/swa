// jaribio_mende_298_bafa_text_kikomo -- jaribio la kudumu dhidi ya
// lugha-swa/swa#298: bafa_text[524288] (bafa ya msimbo wa mashine
// iliyozalishwa, uzalishaji.swa) ilikuwa ikifurika KIMYA -- andika_baiti
// ilichapisha "KOSA: bafa_text imefurika" kwenye stderr LAKINI
// IKAENDELEA (haikusimamisha ukusanyaji); --exe ilitoka na msimbo wa 0,
// ikizalisha executable iliyoharibika (msimbo wa mashine uliokatwa
// kimya mara baada ya nafasi 524288). Mdudu uligunduliwa dhidi ya
// mradi wa nje (Dominion) wenye kazi 1000+ baada ya kuongeza
// serializer ya save/load.
//
// Jaribio hili (lililotengenezwa kiotomatiki) huunda kazi nyingi, kila
// mmoja akifanya HESABU HALISI isiyoweza kukunjwa (constant-folded) --
// kila operesheni inatumia kigezo cha ulimwengu kinachobadilika
// (kaunta), SI namba mbili za moja kwa moja, kwa hiyo jaribu_kunja_namba
// (msambazaji.swa) haiwezi kuondoa agizo lolote -- kila kazi lazima
// izalishe msimbo halisi wa x86-64. Kila kazi pia inachapisha (andika)
// na kuthibitisha (kama/kosa) thamani yake kwa wito mmoja -- mtindo
// uliosababisha mdudu halisi kwenye Dominion (wito MOJA kwa kila
// ulinganisho, SI mbili tofauti).
//
// Jumla ya msimbo wa mashine unaozalishwa na faili hili HUVUKA kikomo
// cha ZAMANI cha bafa_text (524288 baiti/512KB) kwa wazi (uthibitisho:
// executable inayozalishwa ni ~baiti 1.3M) -- UTHIBITISHO WA MUTATION
// (umefanywa kabla ya PR hii): kurudisha uzalishaji.swa kwenye hali ya
// awali (kabla ya rekebisho la #298, bafa_text[524288] + andika_baiti
// isiyosimamisha) na kujenga upya stage1 hutoa hasa dalili ya #298 --
// kukusanya "kwa mafanikio" (toka-msimbo 0, "KOSA: bafa_text imefurika"
// kwenye stderr PEKEE), kisha kuendesha binary hutoa matokeo
// YALIYOCHANGANYIKA (herufi za ajabu/takataka zikichanganyika na
// maandishi sahihi), SI toka isiyo sifuri safi. Baada ya rekebisho
// (bafa_text 524288->8388608 + andika_baiti sasa inasimamisha
// ukusanyaji -- wito_wa_mfumo(60,1,...) -- badala ya kuendelea kimya),
// jaribio hili hurudisha 0 na matokeo yote ni sahihi.
//
// stage1 pekee (ni jaribio la mkusanyaji wa .swa wenyewe).
husisha { msingi/maktaba/kumbukumbu.swa }

n32 kosa = 0;
n32 kaunta = 1;

