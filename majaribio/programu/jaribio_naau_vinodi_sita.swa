// Jaribio la vinodi sita vya ulinganishi kama legs za && / || --
// kuhakikisha jcc sahihi (moja kwa moja NA kinyume) inatumika kwa
// kila mojawapo ndani ya muktadha huu mpya.
N32 main() {
    N32 a = 5;
    N32 b = 5;
    N32 c = 3;
    N32 d = 7;

    // == na != (a==b kweli, c!=d kweli)
    N32 r1 = 0;
    kama (a == b && c != d) { r1 = 1; }
    kama (r1 != 1) { rudisha 1; }

    // < na > (c<d kweli, d>c kweli)
    N32 r2 = 0;
    kama (c < d && d > c) { r2 = 1; }
    kama (r2 != 1) { rudisha 2; }

    // <= na >= (a<=b kweli, b>=a kweli)
    N32 r3 = 0;
    kama (a <= b && b >= a) { r3 = 1; }
    kama (r3 != 1) { rudisha 3; }

    // Vibaya (kila operesheni ikitoa SIVYO, || lazima ianguke zote mbili)
    N32 r4 = 0;
    kama (a != b || c > d) { r4 = 1; }
    kama (r4 != 0) { rudisha 4; }

    N32 r5 = 0;
    kama (d < c || a > b) { r5 = 1; }
    kama (r5 != 0) { rudisha 5; }

    N32 r6 = 0;
    kama (a < c || d <= c) { r6 = 1; }
    kama (r6 != 0) { rudisha 6; }

    rudisha 0;
}
