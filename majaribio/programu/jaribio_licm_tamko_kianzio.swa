// LICM: usemi usiobadilika ndani ya KIANZISHO CHA TAMKO jipya
// (n32 t = p * q;), si tu RHS ya ugawaji -- p,q ni vigezo (SI namba
// za moja kwa moja, hivyo hazikunjwi wakati wa kuchanganua) hivyo
// fursa halisi ya LICM ipo. p*q=12, mzunguko 5 -> total=60.
n32 anza() {
    n32 n = 5;
    n32 p = 3;
    n32 q = 4;
    n32 jumla_kuu = 0;
    n32 i = 0;
    wakati (i < n) {
        n32 t = p * q;
        jumla_kuu = jumla_kuu + t;
        i = i + 1;
    }
    kama (jumla_kuu != 60) { rudisha 1; }
    rudisha 0;
}
