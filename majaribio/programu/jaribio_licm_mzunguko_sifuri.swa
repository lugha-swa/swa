// LICM hatari #4: kitanzi kisichotekelezwa hata mara moja (n=0)
// lazima kibaki kikitekeleza taarifa za mtumiaji MARA SIFURI hasa
// kama zamani -- LICM haipaswi kamwe kuhamisha/kufuta/kupanga upya
// taarifa halisi ya mtumiaji (y = a * b), inapaswa TU kuongeza tamko
// jipya la muda KABLA ya kitanzi na kuandika upya taarifa ya ndani
// kuelekeza kwenye hilo tamko -- kama utekelezaji wa mwili
// haujawahi kutokea, y lazima ibaki bila kuguswa (0).
N32 main() {
    N32 n = 0;
    N32 a = 7;
    N32 b = 6;
    N32 i = 0;
    N32 y = 0;
    wakati (i < n) {
        y = a * b;
        i = i + 1;
    }
    kama (y != 0) { rudisha 1; }
    rudisha 0;
}
