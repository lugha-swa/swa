// jaribio_mende_sivyo_bila_kama: 'sivyo' bila 'kama' iliyotangulia.
// Kabla: mkusanyaji wa uzalishaji ulianguka (SEGV 139) au kutoa
// kosa lisilo sahihi la kianzilishi cha safu; 'sivyo;' ilipita
// kimya kama kitambulisho. Sasa inakataliwa kwa sauti na mkusanyaji
// haitoi faili lolote. (stage1 pekee — mbegu ina kosa lingine.)
n32 main() {
    n32 x = 5;
    sivyo {
        x = 1;
    }
    rudisha x;
}
