// x = x + namba / x = x - namba kwa kigezo cha n32: "add r32, imm32" +
// movsxd (rejesta) au "add dword [rbp-off], imm32" (rafu). Hesabu ni ya
// biti 32 -- lazima izunguke (wrap) kama njia ya kawaida, na thamani ya
// n32 kwenye rejesta lazima ibaki imepanuliwa kwa ishara.

n32 jaribu_rejesta() {
    n32 i = 0;
    n32 s = 0;
    wakati (i < 10) {
        s = s + i;
        i = i + 1;
    }
    kama (i != 10) { rudisha 1; }
    kama (s != 45) { rudisha 2; }
    i = i - 20;
    kama (i != (0 - 10)) { rudisha 3; }
    kama (i < 0) { } sivyo { rudisha 4; }
    i = i + 5;
    i = i - 1000000;
    kama (i != (0 - 1000005)) { rudisha 5; }
    // n64 nzima lazima ione thamani hasi iliyopanuliwa kwa ishara
    n64 w = i;
    kama (w != (0 - 1000005)) { rudisha 6; }
    rudisha 0;
}

n32 jaribu_kuzunguka() {
    n32 a = 2147483647;
    a = a + 1;                       // -2147483648
    kama (a != (0 - 2147483647 - 1)) { rudisha 1; }
    kama (a < 0) { } sivyo { rudisha 2; }
    a = a - 1;                       // 2147483647
    kama (a != 2147483647) { rudisha 3; }
    kama (a > 0) { } sivyo { rudisha 4; }
    n64 w = a;
    kama (w != 2147483647) { rudisha 5; }
    a = a + 1;
    n64 v = a;
    kama (v != (0 - 2147483647 - 1)) { rudisha 6; }
    rudisha 0;
}

// Vigezo vingi (baadhi kwenye rafu, ofseti kubwa)
n32 jaribu_rafu() {
    n8 pedi[300];
    n32 a = 1; n32 b = 2; n32 c = 3; n32 d = 4; n32 e = 5; n32 f = 6; n32 g = 7; n32 h = 8;
    n32 i = 0;
    wakati (i < 3) {
        a = a + 10; b = b + 20; c = c - 1; d = d + 1; e = e - 5; f = f + 100; g = g - 100; h = h + 7;
        i = i + 1;
    }
    pedi[0] = 0;
    kama (a != 31) { rudisha 1; }
    kama (b != 62) { rudisha 2; }
    kama (c != 0) { rudisha 3; }
    kama (d != 7) { rudisha 4; }
    kama (e != (0 - 10)) { rudisha 5; }
    kama (f != 306) { rudisha 6; }
    kama (g != (0 - 293)) { rudisha 7; }
    kama (h != 29) { rudisha 8; }
    // kuzunguka kwenye rafu
    h = 2147483647;
    h = h + 1;
    kama (h >= 0) { rudisha 9; }
    a = 0 - 2147483647;
    a = a - 2;
    kama (a != 2147483647) { rudisha 10; }
    rudisha 0;
}

// Ofseti ndogo (disp8): vigezo vingi bila safu kubwa
n32 jaribu_rafu_ndogo() {
    n32 a = 1; n32 b = 2; n32 c = 3; n32 d = 4; n32 e = 5; n32 f = 6; n32 g = 7; n32 h = 8;
    n32 i = 0;
    wakati (i < 3) {
        a = a - 10; b = b + 20; c = c - 1; d = d - 4; e = e + 5; f = f - 100; g = g + 100; h = h - 7;
        i = i + 1;
    }
    kama (a != (0 - 29)) { rudisha 1; }
    kama (b != 62) { rudisha 2; }
    kama (c != 0) { rudisha 3; }
    kama (d != (0 - 8)) { rudisha 4; }
    kama (e != 20) { rudisha 5; }
    kama (f != (0 - 294)) { rudisha 6; }
    kama (g != 307) { rudisha 7; }
    kama (h != (0 - 13)) { rudisha 8; }
    rudisha 0;
}

// Aina zisizoguswa: n64, n8, a32 (bila ishara), d64, kielekezi
n32 jaribu_aina_nyingine() {
    n64 x = 4000000000;
    x = x + 1;
    kama (x != 4000000001) { rudisha 1; }
    a32 u = 4000000000;
    u = u + 1;
    kama (u != 4000000001) { rudisha 2; }
    a32 z = 0;
    z = z - 1;                       // 4294967295
    kama (z < 5) { rudisha 3; }
    n8 b = 127;
    b = b + 1;                       // n8 inazunguka -128
    kama (b >= 0) { rudisha 4; }
    d64 d = 1.5;
    d = d + 2;
    kama (d != 3.5) { rudisha 5; }
    n32 arr[4];
    arr[0] = 1; arr[1] = 2; arr[2] = 3; arr[3] = 4;
    n32* p = arr;
    p = p + 1;
    kama (p[0] != 2) { rudisha 6; }
    p = p - 1;
    kama (p[0] != 1) { rudisha 7; }
    rudisha 0;
}

// Kigezo cha kushoto ni kigezo TOFAUTI: si kaunta -- njia ya kawaida
n32 jaribu_si_kaunta() {
    n32 x = 5;
    n32 y = 10;
    x = y + 3;
    kama (x != 13) { rudisha 1; }
    y = x - 4;
    kama (y != 9) { rudisha 2; }
    x = x + y;
    kama (x != 22) { rudisha 3; }
    rudisha 0;
}

n32 main() {
    n32 r = jaribu_rejesta();
    kama (r != 0) { rudisha 10 + r; }
    r = jaribu_kuzunguka();
    kama (r != 0) { rudisha 20 + r; }
    r = jaribu_rafu();
    kama (r != 0) { rudisha 30 + r; }
    r = jaribu_rafu_ndogo();
    kama (r != 0) { rudisha 40 + r; }
    r = jaribu_aina_nyingine();
    kama (r != 0) { rudisha 50 + r; }
    r = jaribu_si_kaunta();
    kama (r != 0) { rudisha 70 + r; }
    rudisha 0;
}
