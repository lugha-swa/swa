// Kukunja mara kwa mara -- usemi ambao MATOKEO yake ya kukunja
// yangezidi wigo wa n32 (-2147483648 hadi 2147483647) HAUKUNJWI
// KABISA, unabaki bila kubadilika ukikokotolewa wakati wa kukimbia
// (ambapo eax ya x86 hufanya wraparound sahihi kiotomatiki). Jaribio
// hili linathibitisha thamani ya WRAPAROUND HALISI bado ni sahihi
// baada ya rekebisho hili -- si tu "haianguki". Imekokotolewa kwa
// mkono: 2000000000 * 3 = 6000000000; 6000000000 mod 2^32
// (4294967296) = 1705032704.
n32 main() {
    n32 x = 2000000000 * 3;
    kama (x != 1705032704) { rudisha 1; }
    rudisha 0;
}
