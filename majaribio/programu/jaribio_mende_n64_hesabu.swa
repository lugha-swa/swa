// Mende: hesabu ya n64 ilikuwa ikikatwa hadi biti 32 — 0 - 10000000000
// ilitoa 2884901888 (hesabu ya 32-bit). Hati 2.3 inaahidi n64 —
// operesheni mchanganyiko lazima ipandishwe hadi upana wa 64
// (C-semantiki: n32 + n64 = n64).
n32 main() {
    n64 x = 0 - 10000000000;
    kama (x == -10000000000) { rudisha 0; }
    rudisha 1;
}
