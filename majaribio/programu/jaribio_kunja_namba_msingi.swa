// Kukunja mara kwa mara (constant folding) -- usemi wa nambari
// HALISI pande zote mbili (2+3*4, (10-3)%4, 100/5/2, na matokeo
// hasi kutoka 3-10) hukunjwa wakati wa kuchanganua kuwa tokeni MOJA,
// lakini bado hutoa thamani SAHIHI kabisa -- imekokotolewa kwa mkono
// kabla ya kuandika: a=2+12=14, b=7%4=3, c=(100/5)/2=10, jumla=27.
n32 main() {
    n32 a = 2 + 3 * 4;
    n32 b = (10 - 3) % 4;
    n32 c = 100 / 5 / 2;
    n32 x = 3 - 10;
    kama (a != 14) { rudisha 1; }
    kama (b != 3) { rudisha 2; }
    kama (c != 10) { rudisha 3; }
    kama (x != (0 - 7)) { rudisha 4; }
    rudisha a + b + c;
}
