// SSCSE (CSE ya mstari-moja-kwa-moja) -- kesi ya msingi: "a*b"
// hutokea kama kipande cha ndani cha usemi MBILI TOFAUTI ("a*b+c" na
// "a*b-d") -- vitengo hivyo VIZIMA HAVIFANANI kimuundo kamwe
// (AST_JUMLISHA dhidi ya AST_TOFAUTI), hivyo TU ulinganisho wa kina
// (recursive) unaoingia ndani ya watoto unaweza kutambua "a*b"
// inarudiwa. a=6,b=7 => a*b=42; x=42+100=142; y=42-1=41.
N32 main() {
    N32 a = 6;
    N32 b = 7;
    N32 c = 100;
    N32 d = 1;
    N32 x = a * b + c;
    N32 y = a * b - d;
    kama (x != 142) { rudisha 1; }
    kama (y != 41) { rudisha 2; }
    rudisha 0;
}
