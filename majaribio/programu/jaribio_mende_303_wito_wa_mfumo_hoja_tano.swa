// lugha-swa/swa#303 -- jaribio la kudumu (PR #304 ilirekebisha bila
// jaribio). wito_wa_mfumo yenye hoja 6+ ilipoteza a5 kimya: r8 (nafasi
// ya tano ya syscall) ilibaki na a4. Kwa mmap, a5 ni fd na a4 ni
// flags -- kwa hiyo fd ikawa MAP_PRIVATE (2) badala ya fd halisi.
//
// mmap ya ANONYMOUS haifai kwa jaribio hili: kernel hupuuza fd hapo,
// na mdudu hupita bila kuonekana. Hapa faili halisi (/proc/self/exe)
// linaramaniwa kupitia fd yake, na baiti nne za kwanza lazima ziwe
// kichwa cha ELF. Imethibitishwa: stage1 ya kabla ya #304 hurudisha 1
// (mmap(..., fd=2) = -EACCES).
//
// Minyororo yote miwili: mbegu.s ilikuwa na mdudu huu huu (hakuna
// mov r8, r9 kwenye builtin yake ya wito_wa_mfumo) -- ilirekebishwa
// na kugandishwa upya kwenye #311.
n32 main() {
    n64 fd = wito_wa_mfumo(2, "/proc/self/exe", 0, 0, 0, 0, 0);
    kama (fd < 0) { rudisha 10; }
    n64 p = wito_wa_mfumo(9, 0, 4096, 1, 2, fd, 0);
    kama (p < 0) { rudisha 1; }
    n8* b = p;
    kama (b[0] != 127) { rudisha 2; }
    kama (b[1] != 69) { rudisha 3; }
    kama (b[2] != 76) { rudisha 4; }
    kama (b[3] != 70) { rudisha 5; }
    rudisha 0;
}
