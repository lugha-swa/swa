// Kianzio cha ULIMWENGU cha anwani ya kazi: n64 g = &mbili; — slot
// ya .data inapata anwani kamili ya .text mwishoni mwa kukusanya
// (rekebisha_anwani_za_data). Wito unafuata kigezo cha ulimwengu.
n32 mbili(n32 x) { rudisha x * 2; }
n64 op_ulimwengu = &mbili;
n32 main() { rudisha op_ulimwengu(21); }
