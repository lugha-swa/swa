// jaribio_mende_muundo_thamani_16: muundo wa baiti 16 kwa thamani —
// mabadiliko ya kigezo ndani ya kazi hayapaswi kugusa kigeu cha
// mpigaji. Kabla: kigezo kilielekeza kwenye kigeu cha mpigaji (bafa
// ya nakala ilihifadhi anwani ya chanzo badala ya lengwa) — jibu
// 44 (90+80+70+60) badala ya 10.
// Inatarajiwa: 10 (1 + 2 + 3 + 4)
muundo Nne { n32 a; n32 b; n32 c; n32 d; };

w0 badilisha(Nne n) {
    n.a = 90;
    n.b = 80;
    n.c = 70;
    n.d = 60;
}

n32 main() {
    Nne n;
    n.a = 1;
    n.b = 2;
    n.c = 3;
    n.d = 4;
    badilisha(n);
    rudisha n.a + n.b + n.c + n.d;
}
