w0 nakili(n8* lengwa, n8* chanzo, n64 n) {
    n64 i = 0;
    wakati (i < n) {
        lengwa[i] = chanzo[i];
        i = i + 1;
    }
}

w0 weka_sifuri(n8* lengwa, n64 n) {
    n64 i = 0;
    wakati (i < n) {
        lengwa[i] = 0;
        i = i + 1;
    }
}

n32 linganisha_kumbukumbu(n8* a, n8* b, n64 n) {
    n64 i = 0;
    wakati (i < n) {
        kama (a[i] < b[i]) {
            rudisha -1;
        }
        kama (a[i] > b[i]) {
            rudisha 1;
        }
        i = i + 1;
    }
    rudisha 0;
}

// ==========================================================
// Runtime ya syscalls — maktaba haihitaji libc tena
// ==========================================================

// Wito wa mfumo wa Linux — builtin ya mzalishaji (uzalishaji_wito)
// na daraja la C kwa mbegu. Haina tangazo la .swa: kila mkaguzi
// (wa Swa na wa Rust) hujenga saini kutoka hoja halisi za wito.

n64 sys_soma(n32 faili, n8* bafa, n64 urefu) {
    rudisha wito_wa_mfumo(0, faili, bafa, urefu, 0, 0, 0);
}

n64 sys_andika(n32 faili, n8* bafa, n64 urefu) {
    rudisha wito_wa_mfumo(1, faili, bafa, urefu, 0, 0, 0);
}

n64 sys_fungua(n8* njia, n64 bendera, n64 ruhusa) {
    // Hoja ya 3 (hali) ni ruhusa za faili linaloundwa (mode) — kernel
    // inaitumia tu wakati O_CREAT iko kwenye bendera, vinginevyo
    // inapuuzwa. Awali ilipitishwa kama 0, hivyo faili zilizoundwa
    // na O_CREAT zilipata ruhusa 0000 (hazikufunguka kwa usomaji).
    rudisha wito_wa_mfumo(2, njia, bendera, ruhusa, 0, 0, 0);
}

n64 sys_funga(n32 faili) {
    rudisha wito_wa_mfumo(3, faili, 0, 0, 0, 0, 0);
}

n64 sys_mmap(n8* anwani, n64 urefu, n64 ulinzi, n64 bendera, n64 faili) {
    rudisha wito_wa_mfumo(9, anwani, urefu, ulinzi, bendera, faili, 0);
}

n64 sys_munmap(n8* anwani, n64 urefu) {
    rudisha wito_wa_mfumo(11, anwani, urefu, 0, 0, 0, 0);
}

// ==========================================================
// Uchapishaji — andika_n64 / andika_mfuatano / andika_baiti
// Hizi ndizo kazi zinazoitwa na builtin ya andika katika mzalishaji.
// ==========================================================

w0 andika_n64(n32 faili, n64 v) {
    // Bafa ya n32, si n8 — mbegu hutoa maandishi ya safu ya n8
    // kwa mizani ya baiti 4, hivyo tumia n32 na uchapishe tarakimu
    // moja kwa moja kupitia andika_herufi.
    n32 bafa[32];
    n32 n = 0;
    kama (v < 0) {
        andika_herufi(faili, 45);  // '-'
        v = 0 - v;
    }
    wakati (1 == 1) {
        bafa[n] = v - ((v / 10) * 10);
        n = n + 1;
        v = v / 10;
        kama (v == 0) { vunja; }
    }
    // Chapisha tarakimu kwa mpangilio wa nyuma
    wakati (n > 0) {
        n = n - 1;
        andika_herufi(faili, 48 + bafa[n]);
    }
}

w0 andika_mfuatano(n32 faili, n8* s) {
    // Urefu wa mfuatano unahesabiwa hapa — kumbukumbu.swa
    // haitegemei mfuatano.swa (jaribio la k10a linahusisha peke yake).
    n64 u = 0;
    wakati (s[u] != 0) {
        u = u + 1;
    }
    sys_andika(faili, s, u);
}

w0 andika_herufi(n32 faili, n64 b) {
    n8 bb = b;
    sys_andika(faili, &bb, 1);
}

w0 andika_sehemu(n32 faili, n8* s, n64 urefu) {
    sys_andika(faili, s, urefu);
}

// ==========================================================
// andika / andika_stderr — utekelezaji wa ndani wa muundo
// (kwa mbegu: wito za nje hujitatua hapa; codegen ya Swa ni builtin)
// Muundo ni mfuatano PAMOJA na nukuu.
//
// Viashiria vinavyotumika:
//   %d  — n64 yenye ishara (desimali, na alama ya kutoa ikihitajika)
//   %u  — n64 isiyo na ishara (desimali; thamani hasi inaonyeshwa
//         kama mfuatano kamili wa bits za baiti 64)
//   %x  — heksadesimali ndogo bila sifuri za mwanzo (42 → "2a");
//         thamani hasi inaonyeshwa kama bits zote 64
//   %s  — mfuatano unaoishia kwenye 0
//   %c  — herufi moja
//   %%  — alama ya % (haitumii hoja)
// Viashiria VISIVYOSAIDIWA (%f, %l, %n, n.k.) vinachapishwa kama
// herufi halisi ("%f" → "%f") — hakuna kinachomezwa, na havitumii
// hoja. Mnyororo wa Rust (andika = printf ya C) unasaidia vyote
// vya printf; tofauti hii kati ya minyororo imeandikwa kwenye
// hati/uthibitisho-wa-lugha.md.
// ==========================================================

// Chagua hoja ya na kati ya a1..a6. na zaidi ya 5 hurudisha a6
// (kama ilivyokuwa awali — hoja ya 7+ haiwezekani kwenye andika).
n64 hoja_kwa_na(n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6, n32 na) {
    kama (na == 0) { rudisha a1; }
    kama (na == 1) { rudisha a2; }
    kama (na == 2) { rudisha a3; }
    kama (na == 3) { rudisha a4; }
    kama (na == 4) { rudisha a5; }
    rudisha a6;
}

// andika_u64 — andika n64 kama nambari isiyo na ishara (desimali
// bila alama ya kutoa). Thamani hasi inaonyeshwa kama mfuatano
// kamili wa bits: -1 → 18446744073709551615.
w0 andika_u64(n32 faili, n64 v) {
    n32 bafa[32];
    n32 n = 0;
    wakati (1 == 1) {
        bafa[n] = v - ((v / 10) * 10);
        n = n + 1;
        v = v / 10;
        kama (v == 0) { vunja; }
    }
    wakati (n > 0) {
        n = n - 1;
        andika_herufi(faili, 48 + bafa[n]);
    }
}

// andika_heksa — andika n64 kwa heksadesimali ndogo bila sifuri
// za mwanzo. Thamani hasi inaonyeshwa kama bits zote 64.
w0 andika_heksa(n32 faili, n64 v) {
    n32 tarakimu[32];
    n32 n = 0;
    kama (v == 0) {
        andika_herufi(faili, 48);  // '0'
        rudisha;
    }
    wakati (v != 0) {
        n32 d = v - ((v / 16) * 16);
        kama (d < 10) { tarakimu[n] = 48 + d; }
        sivyo { tarakimu[n] = 87 + d; }  // 'a' = 97, 97 - 10 = 87
        n = n + 1;
        v = v / 16;
    }
    wakati (n > 0) {
        n = n - 1;
        andika_herufi(faili, tarakimu[n]);
    }
}

// Kielekezi kutoka hoja ya n64: mkia wa andika (a1..a6) hupita kwa
// rejesta za n64 kwa ABI, iwe thamani au kielekezi. %s huhitaji
// kielekezi — ubadilishaji wazi (ukaguzi wa hoja unakataa n64 kwa
// kigezo cha n8* tangu 2026-09-01).
n8* kielekezi_kutoka_hoja(n64 v) {
    n8* p = v;
    rudisha p;
}

w0 andika_ndani(n32 faili, n8* f, n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6) {
    n32 p = 0;  // mfuatano hauna nukuu (kumbukumbu hutoa bila nukuu)
    n32 na = 0;  // faharisi ya hoja inayofuata
    wakati (1 == 1) {
        kama (f[p] == 0) { vunja; }  // mwisho wa mfuatano (null terminator)
        kama (f[p] == 37) {  // '%'
            n8 sp = f[p + 1];
            kama (sp == 0) {  // '%' mwishoni mwa mfuatano — chapisha kama herufi
                andika_herufi(faili, 37);
                p = p + 1;
                endelea;
            }
            p = p + 2;
            kama (sp == 100) {  // %d
                andika_n64(faili, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                na = na + 1;
            } sivyo { kama (sp == 117) {  // %u
                    andika_u64(faili, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                    na = na + 1;
                } sivyo { kama (sp == 120) {  // %x
                        andika_heksa(faili, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                        na = na + 1;
                    } sivyo { kama (sp == 115) {  // %s
                            andika_mfuatano(faili, kielekezi_kutoka_hoja(hoja_kwa_na(a1, a2, a3, a4, a5, a6, na)));
                            na = na + 1;
                        } sivyo { kama (sp == 99) {  // %c
                                andika_herufi(faili, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                                na = na + 1;
                            } sivyo { kama (sp == 37) {  // %%
                                    andika_herufi(faili, 37);  // haina hoja
                                } sivyo {
                                    // Visivyosaidiwa (%f, %l, %n, ...) — chapisha
                                    // kama herufi halisi, bila kutumia hoja.
                                    andika_herufi(faili, 37);
                                    andika_herufi(faili, sp);
                                } } } } } }
            endelea;
        }
        kama (f[p] == 92 && f[p + 1] == 110) {  // \n
            andika_herufi(faili, 10);
            p = p + 2;
            endelea;
        }
        andika_herufi(faili, f[p]);
        p = p + 1;
    }
}

n32 andika(n8* f, n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6) {
    andika_ndani(1, f, a1, a2, a3, a4, a5, a6);
    rudisha 0;
}

n32 andika_stderr(n8* f, n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6) {
    andika_ndani(2, f, a1, a2, a3, a4, a5, a6);
    rudisha 0;
}

// ukubwa — kwa mbegu (codegen ya Swa huikokotoa wakati wa kukusanya)
n64 ukubwa(n32 aina) {
    kama (aina == 1) { rudisha 1; }
    kama (aina == 2) { rudisha 2; }
    kama (aina == 3) { rudisha 4; }
    kama (aina == 4) { rudisha 8; }
    rudisha 8;
}

// ==========================================================
// Arena ya kumbukumbu — badala ya malloc/realloc/free
// ==========================================================
n8* arena_anwani = 0;
n64 arena_nafasi = 0;

n8* tenga(n64 ukubwa) {
    kama (arena_anwani == 0) {
        // Anwani sifuri = "popote" (kama mmap(NULL, ...) ya C).
        // Halisi 0 kwa kigezo cha kielekezi inakataliwa na ukaguzi
        // wa 2026-09-01 — tumia kielekezi cha sifuri wazi.
        n8* anwani_sifuri = 0;
        arena_anwani = sys_mmap(anwani_sifuri, 1048576, 3, 34, 0 - 1);
        kama (arena_anwani == 0 - 1) { rudisha 0; }
    }
    kama (ukubwa == 0) { ukubwa = 8; }
    ukubwa = ukubwa + 8;  // nafasi ya ukubwa wa kipande (kwa badili)
    kama (arena_nafasi + ukubwa > 1048576) { rudisha 0; }
    n8* r = arena_anwani + arena_nafasi;
    // hifadhi ukubwa mbele ya kipande (baiti 8)
    n8* h = &ukubwa;
    n32 bi = 0;
    wakati (bi < 8) {
        r[bi] = h[bi];
        bi = bi + 1;
    }
    arena_nafasi = arena_nafasi + ukubwa;
    rudisha r + 8;
}

w0 achilia_arena(n8* p) {
    // Arena haiwezi kufungua vipande — hakuna kitu
}

n8* badili(n8* p, n64 ukubwa) {
    kama (p == 0) { rudisha tenga(ukubwa); }
    kama (ukubwa == 0) { rudisha p; }
    // soma ukubwa wa zamani kutoka kichwa cha kipande
    n64 zamani = 0;
    n8* h2 = &zamani;
    n32 bi2 = 0;
    wakati (bi2 < 8) {
        h2[bi2] = p[bi2 - 8];
        bi2 = bi2 + 1;
    }
    n8* r = tenga(ukubwa);
    kama (r == 0) { rudisha 0; }
    n64 nakili_urefu = zamani;
    kama (ukubwa < zamani) { nakili_urefu = ukubwa; }
    nakili(r, p, nakili_urefu);
    rudisha r;
}

// ==========================================================
// Usomaji wa desimali halisi — badala ya strtod (libc)
// bits_ya_d64_swa: mfuatano [-]z.z → baiti za d64 (IEEE 754)
// (majina ya kigeu hayawezi kuwa herufi za aina: N A B D W)
// Kikomo cha sasa: tarakimu za kasoro <= 10 kwa thamani < 2^26,
// <= 3 kwa thamani kubwa zaidi (vinginevyo hesabu*2^hamisha
// inaweza kuzidi baiti 64).
// ==========================================================

n64 p2_kwa(n32 kubwa) {
    n64 thamani = 1;
    n32 fasi = 0;
    wakati (fasi < kubwa) {
        thamani = thamani * 2;
        fasi = fasi + 1;
    }
    rudisha thamani;
}

n64 bits_ya_d64_swa(n8* ch, n32 u) {
    n64 alama = 0;
    n32 fasi = 0;
    kama (ch[fasi] == 45) { alama = 1; fasi = fasi + 1; }
    n64 nzima = 0;
    wakati (fasi < u && ch[fasi] != 46) {
        nzima = nzima * 10 + (ch[fasi] - 48);
        fasi = fasi + 1;
    }
    n64 kasoro = 0;
    n64 idadi_k = 0;
    kama (fasi < u && ch[fasi] == 46) {
        fasi = fasi + 1;
        wakati (fasi < u) {
            kasoro = kasoro * 10 + (ch[fasi] - 48);
            idadi_k = idadi_k + 1;
            fasi = fasi + 1;
        }
    }
    // nene = 10^idadi_k
    n64 nene = 1;
    n32 kaunta = 0;
    wakati (kaunta < idadi_k) { nene = nene * 10; kaunta = kaunta + 1; }
    // hesabu = nzima * nene + kasoro  (thamani = hesabu / nene)
    n64 hesabu = nzima * nene + kasoro;
    kama (hesabu == 0) { rudisha 0; }

    // kizio: kubwa zaidi kama 2^kizio <= hesabu/nene < 2^(kizio+1)
    n64 urefu_juu = 0; n64 muda = hesabu;
    wakati (muda > 0) { muda = muda / 2; urefu_juu = urefu_juu + 1; }
    n64 urefu_chini = 0; muda = nene;
    wakati (muda > 0) { muda = muda / 2; urefu_chini = urefu_chini + 1; }
    n64 kizio = urefu_juu - urefu_chini;
    kama (kizio >= 0) {
        // kurekebisha chini: kama hesabu/nene < 2^kizio, punguza
        n64 p2m = p2_kwa(kizio);
        kama (hesabu < nene * p2m) { kizio = kizio - 1; }
    } sivyo {
        // kizio hasi (v < 1): linganisha hesabu * 2^m < nene, m = -kizio
        n64 m = 0 - kizio;
        n64 q = 1;
        n32 mf = 0;
        wakati (mf < m) { q = q * 2; mf = mf + 1; }
        kama (hesabu * q < nene) { kizio = kizio - 1; }
    }
    // Kuinua hesabu hadi [nene, 2*nene) — hesabu/nene sasa ni
    // 2^(kizio+d); kizio yenyewe inabaki kielelezo cha thamani asilia.
    n64 d = 0;
    wakati (hesabu < nene) {
        hesabu = hesabu * 2;
        d = d + 1;
    }

    // pacha = (hesabu/nene - 2^(kizio+d)) * 2^(52-kizio-d)
    //       = hesabu * 2^(52-kizio-d) / nene - 2^52
    n64 hamisha = 52 - (kizio + d);
    kama (hamisha < 0) { hamisha = 0; }
    kama (hamisha > 52) { hamisha = 52; }
    n64 p52 = p2_kwa(52);
    n64 pacha = 0;
    kama (hamisha <= 26) {
        n64 p2s = p2_kwa(hamisha);
        pacha = (hesabu * p2s) / nene - p52;
    } sivyo {
        // Gawanya kuzidisha ili kuepuka kuzidi baiti 64:
        // hesabu*2^hamisha = (hi*nene + salio) * 2^(hamisha-26)
        n64 p2a = p2_kwa(26);
        n64 p2b = p2_kwa(hamisha - 26);
        n64 hi = (hesabu * p2a) / nene;
        n64 salio = hesabu * p2a - hi * nene;
        pacha = hi * p2b + (salio * p2b) / nene - p52;
    }

    // bits: alama << 63 | (kizio + 1023) << 52 | pacha
    n64 p63 = p2_kwa(63);
    n64 biti = 0;
    kama (alama == 1) { biti = biti + p63; }
    biti = biti + (kizio + 1023) * p52;
    biti = biti + (pacha - (pacha / p52) * p52);
    rudisha biti;
}

// soma_mstari — soma mstari mmoja kutoka faili hadi bafa.
// Inasimama kwa '\n' (isiyojumuishwa) au EOF. Rudisha idadi ya
// baiti zilizosomwa, au -1 ikiwa EOF mara moja bila baiti.
n64 soma_mstari(n32 faili, n8* bafa, n64 upeo) {
    n64 n = 0;
    wakati (n + 1 < upeo) {
        n8 ch = 0;
        n64 r = sys_soma(faili, &ch, 1);
        kama (r <= 0) {
            kama (n == 0) {
                rudisha -1;
            }
            rudisha n;
        }
        kama (ch == 10) {
            rudisha n;
        }
        bafa[n] = ch;
        n = n + 1;
    }
    rudisha n;
}
husisha { kumbukumbu.swa }

// faili.swa — Shughuli za I/O za faili
//
// Hutoa usomaji, uandikaji, na ushughulikiaji wa faili kwa kutumia
// wito wa mfumo wa Linux moja kwa moja (sys_fungua, sys_soma,
// sys_andika, sys_funga kutoka kumbukumbu.swa) — HAKUNA libc.
// Awali moduli hii ilizungushia stdio ya C (fopen/fread/...); kwa
// kuwa maktaba haihitaji libc tena, kazi hizi zimeandikwa upya kwa
// syscalls. Hivyo moduli inakusanyika na kuendesha kwenye minyororo
// YOTE MIWILI (mbegu na stage1) — si ya mnyororo wa Rust pekee.
//
// Kishikio kinachorudishwa na faili_fungua ni n8* lenye thamani ya
// deskripta ya faili (fd) — si kielekezi halisi kinachoweza kusomwa.
// Kipitishe tu kwa kazi nyingine za moduli hii; usijaribu kukibomoa.
//
// Hali za ufunguzi zinazotumika na faili_fungua:
//   "r"  — soma tu (faili lazima liwepo)
//   "w"  — andika tu (huunda upya kama lipo, ruhusa 0644)
//   "a"  — ongeza mwishoni (huunda kama halipo, ruhusa 0644)
//   "r+" — soma na andika (faili lazima liwepo)
//   "w+" — soma na andika (huunda upya, ruhusa 0644)
//   "a+" — soma na ongeza (huunda kama halipo, ruhusa 0644)

// Ruhusa za faili zinazoundwa na O_CREAT (0644 = soma/andika kwa
// mmiliki, soma kwa kikundi na wengine). Inapaswa kupitishwa kwa
// sys_fungua kama hoja ya 3 — bila hiyo kernel huunda faili lenye
// ruhusa 0000 (halifunguki kwa usomaji).
n64 faili_ruhusa = 420;

// Mchoro wa hali ("r"/"w"/"a"[+"]) hadi bendera za open(2):
// O_RDONLY=0, O_WRONLY=1, O_RDWR=2, O_CREAT=64, O_TRUNC=512,
// O_APPEND=1024.
n64 faili_bendera(n8* namna) {
    n64 b = 0;
    kama (namna[0] == 119) { b = 1; }  // 'w' — andika
    kama (namna[0] == 97) { b = 1; }  // 'a' — ongeza
    kama (namna[1] == 43) { b = 2; }  // '+' — soma na andika (O_RDWR)
    kama (namna[0] == 119 || namna[0] == 97) {
        b = b + 64;  // O_CREAT
        kama (namna[0] == 119) { b = b + 512; }  // O_TRUNC
        kama (namna[0] == 97) { b = b + 1024; }  // O_APPEND
    }
    rudisha b;
}

// Fungua faili. Hurudisha kishikio (n8*) au 0 kwa kushindwa.
n8* faili_fungua(n8* njia, n8* namna) {
    n64 fd = sys_fungua(njia, faili_bendera(namna), faili_ruhusa);
    kama (fd < 0) { rudisha 0; }
    rudisha fd;  // n8* lenye thamani ya fd (si kielekezi halisi)
}

// Kishikio cha faili (fd) kutoka kwa kielekezi: faili_fungua hurudisha
// fd ndani ya n8* (0 = kushindwa). Ukaguzi wa hoja unakataa kielekezi
// kwa kigezo cha n32 tangu 2026-09-01 — ubadilishaji wazi.
n32 kishikio_kutoka_hoja(n8* f) {
    n32 k = f;
    rudisha k;
}

// Funga faili.
w0 faili_funga(n8* f) {
    kama (f != 0) {
        sys_funga(kishikio_kutoka_hoja(f));
    }
}

// Soma data kutoka faili. Hurudisha idadi ya vipengele vilivyosomwa
// (vipengele kamili; salio la mwisho linatupwa kama fread ya C).
n64 faili_soma(n8* buf, n64 ukubwa, n64 idadi, n8* f) {
    kama (f == 0) { rudisha 0; }
    kama (ukubwa == 0) { rudisha 0; }
    n64 n = sys_soma(kishikio_kutoka_hoja(f), buf, ukubwa * idadi);
    kama (n <= 0) { rudisha 0; }
    rudisha n / ukubwa;
}

// Andika data kwenye faili. Hurudisha idadi ya vipengele
// vilivyoandikwa.
n64 faili_andika(n8* buf, n64 ukubwa, n64 idadi, n8* f) {
    kama (f == 0) { rudisha 0; }
    kama (ukubwa == 0) { rudisha 0; }
    n64 n = sys_andika(kishikio_kutoka_hoja(f), buf, ukubwa * idadi);
    kama (n <= 0) { rudisha 0; }
    rudisha n / ukubwa;
}

// Soma faili lote na ulihifadhi kwenye bafa.
// Hurudisha urefu wa data iliyosomwa, au -1 kwa kushindwa.
// Bafa lazima iwe na nafasi ya kutosha (uwezo ni pamoja na NUL).
n64 faili_soma_yote(n8* njia, n8* buf, n64 uwezo) {
    n8* f = faili_fungua(njia, "r");
    kama (f == 0) { rudisha -1; }
    n64 n = 0;
    wakati (n + 1 < uwezo) {
        n64 r = sys_soma(kishikio_kutoka_hoja(f), buf + n, uwezo - 1 - n);
        kama (r <= 0) { vunja; }
        n = n + r;
    }
    faili_funga(f);
    buf[n] = 0;
    rudisha n;
}

// Andika mfuatano kwenye faili. Hurudisha 0 kwa mafanikio, -1 kwa
// kushindwa.
n32 faili_andika_yote(n8* njia, n8* data, n64 urefu) {
    n8* f = faili_fungua(njia, "w");
    kama (f == 0) { rudisha -1; }
    n64 n = sys_andika(kishikio_kutoka_hoja(f), data, urefu);
    faili_funga(f);
    kama (n < urefu) { rudisha -1; }
    rudisha 0;
}

// Angalia kama faili lipo (na linaweza kufunguliwa kwa usomaji).
n32 faili_ipo(n8* njia) {
    n8* f = faili_fungua(njia, "r");
    kama (f == 0) { rudisha 0; }
    faili_funga(f);
    rudisha 1;
}

// Soma mstari mmoja kutoka faili hadi bafa.
// Huacha kwenye '\n' (inayojumuishwa kwenye bafa) au EOF.
// Hurudisha urefu uliosomwa au -1 kwa mwisho.
n32 faili_soma_mstari(n8* f, n8* buf, n32 uwezo) {
    kama (f == 0 || uwezo <= 0) {
        rudisha -1;
    }
    n32 i = 0;
    wakati (i < uwezo - 1) {
        n8 c = 0;
        n64 r = sys_soma(kishikio_kutoka_hoja(f), &c, 1);
        kama (r <= 0) {  // EOF — hakuna baiti zaidi
            kama (i == 0) {
                rudisha -1;
            }
            vunja;
        }
        kama (c == 10) {  // '\n'
            buf[i] = c;
            i = i + 1;
            vunja;
        }
        buf[i] = c;
        i = i + 1;
    }
    buf[i] = 0;
    rudisha i;
}

// Futa faili (unlink). Hurudisha 0 kwa mafanikio, -1 kwa kushindwa.
n32 faili_futa(n8* njia) {
    rudisha wito_wa_mfumo(87, njia, 0, 0, 0, 0, 0);
}
n32 main() {
    // Andika faili (faili_andika_yote huunda faili na O_CREAT —
    // ruhusa 0644 inapaswa kuwezesha kufungua tena kwa usomaji)
    n8 njia[64];
    nakili(njia, "_jaribio_k10g.txt", 17);
    n8 data[64];
    nakili(data, "Habari, Swa!", 12);
    n64 urefu = 12;
    kama (faili_andika_yote(njia, data, urefu) != 0) rudisha 1;

    // Angalia kama lipo
    kama (faili_ipo(njia) != 1) rudisha 2;

    // Soma faili lote
    n8 buf[64];
    weka_sifuri(buf, 64);
    n64 soma = faili_soma_yote(njia, buf, 64);
    kama (soma != urefu) rudisha 3;
    kama (linganisha_kumbukumbu(buf, data, urefu) != 0) rudisha 4;

    // Fungua na uandike kwa mkono
    n8 namna[8];
    nakili(namna, "w", 2);
    n8* f = faili_fungua(njia, namna);
    kama (f == 0) rudisha 5;
    n8 andiko[64];
    nakili(andiko, "Jaribio", 8);
    n64 n = faili_andika(andiko, 1, 7, f);
    faili_funga(f);
    kama (n != 7) rudisha 6;

    // Soma tena na uhakikishe
    weka_sifuri(buf, 64);
    soma = faili_soma_yote(njia, buf, 64);
    kama (soma != 7) rudisha 7;
    kama (linganisha_kumbukumbu(buf, andiko, 7) != 0) rudisha 8;

    // faili_soma_mstari — mistari imejengwa kwa baiti 10 waziwazi
    // (utorokaji wa \n ni tofauti kati ya minyororo — usitegemee;
    // pia hesabu ya anwani ya safu ya ndani ni mbovu kwenye mbegu —
    // tumia kitanzi cha faharisi, si safu + ofseti)
    n8 f2[64];
    nakili(f2, "_jaribio_k10g_mistari.txt", 25);
    n8 mistari[16];
    n8 chanzo[8];
    nakili(chanzo, "mstari1", 7);
    n32 mi = 0;
    wakati (mi < 7) { mistari[mi] = chanzo[mi]; mi = mi + 1; }
    mistari[7] = 10;
    nakili(chanzo, "mstari2", 7);
    mi = 0;
    wakati (mi < 7) { mistari[8 + mi] = chanzo[mi]; mi = mi + 1; }
    mistari[15] = 10;
    faili_andika_yote(f2, mistari, 16);
    n8* fh = faili_fungua(f2, "r");
    kama (fh == 0) rudisha 9;
    n8 mst_buf[32];
    weka_sifuri(mst_buf, 32);
    n32 len = faili_soma_mstari(fh, mst_buf, 32);
    kama (len != 8) rudisha 10;
    n8 tarajiwa1[16];
    nakili(tarajiwa1, "mstari1", 7);
    tarajiwa1[7] = 10;
    kama (linganisha_kumbukumbu(mst_buf, tarajiwa1, 8) != 0) rudisha 11;
    len = faili_soma_mstari(fh, mst_buf, 32);
    kama (len != 8) rudisha 12;
    n8 tarajiwa2[16];
    nakili(tarajiwa2, "mstari2", 7);
    tarajiwa2[7] = 10;
    kama (linganisha_kumbukumbu(mst_buf, tarajiwa2, 8) != 0) rudisha 13;
    faili_funga(fh);

    // Angalia faili isiyokuwepo
    n8 haipo[64];
    nakili(haipo, "_haipo_kamwe.txt", 16);
    kama (faili_ipo(haipo) != 0) rudisha 14;

    // Futa faili za jaribio (usichafue saraka)
    kama (faili_futa(njia) != 0) rudisha 15;
    kama (faili_futa(f2) != 0) rudisha 16;
    kama (faili_ipo(njia) != 0) rudisha 17;

    rudisha 0;
}
