// lugha-swa/swa#215 (sehemu ya pili) -- miundo miwili yenye jina moja.
// hakiki_marudio_ya_ngazi_ya_juu tayari inakataa hili; jaribio hili
// linalinda tabia hiyo isirudi nyuma kimya (hapakuwa na jaribio la
// marudio ya muundo, kazi pekee). Kamili pekee.
muundo nukta { n32 x; }
muundo nukta { n64 x; n64 y; }
n32 anza() { rudisha ukubwa(nukta); }
