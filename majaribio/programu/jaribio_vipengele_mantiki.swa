// jaribio_vipengele_mantiki.swa -- && na || (pamoja na mifululizo mirefu ya
// ||, aina ya alama za uakifishaji ambazo msomaji hutumia). Kila ukaguzi
// unaoshindwa hurudisha namba yake; 0 = yote sawa.

n32 ni_alama(n8 c) {
    kama (c == 59 || c == 44 || c == 58 || c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125) {
        rudisha 1;
    }
    rudisha 0;
}

n32 anza() {
    n8 c = 65;
    n32 r = 0;
    kama (c >= 65 && c <= 90) { r = 1; }
    kama (r != 1) rudisha 1;

    n32 a = 65;
    r = 0;
    kama (a >= 65 && a <= 90) { r = 1; }
    kama (r != 1) rudisha 2;
    r = 0;
    kama (a >= 66 && a <= 90) { r = 1; }
    kama (r != 0) rudisha 3;

    c = 40;
    r = 0;
    kama (c == 59 || c == 40) { r = 1; }
    kama (r != 1) rudisha 4;
    r = 0;
    kama (c == 59 || c == 44 || c == 40) { r = 1; }
    kama (r != 1) rudisha 5;
    r = 0;
    kama (c == 59 || c == 44 || c == 58) { r = 1; }
    kama (r != 0) rudisha 6;

    kama (ni_alama(40) != 1) rudisha 7;
    kama (ni_alama(41) != 1) rudisha 8;
    kama (ni_alama(125) != 1) rudisha 9;
    kama (ni_alama(102) != 0) rudisha 10;
    rudisha 0;
}
