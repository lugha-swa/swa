// Jina lile lile likitangazwa tena kwa AINA ILE ILE kwenye ubeti jirani
// ni halali na hushiriki sloti moja kwa usalama: f(2) = 6*7 = 42, f(1)
// ni 0 (6 != 7). Matokeo 42 + 1 = 43 -- kuthibitisha kuwa ukaguzi wa
// "aina tofauti" haukatai matumizi halali.
n64 mr[64];
n64 mr_juu = 0;
w0 sukuma(n64 v) { mr[mr_juu] = v; mr_juu = mr_juu + 1; }
n64 vuta() { mr_juu = mr_juu - 1; rudisha mr[mr_juu]; }
n64 f(n32 op) {
    n64 v0 = 0;
    n64 v1 = 1;
    n64 v2 = 2;
    kama (op == 1) {
        n64 b = vuta(); n64 a = vuta(); n64 r = 0;
        kama (a == b) { r = 1; }
        rudisha r;
    }
    kama (op == 2) {
        n64 b = vuta(); n64 a = vuta(); n64 r = 0;
        r = a * b;
        rudisha r;
    }
    rudisha v0 + v1 + v2;
}
n32 anza() {
    sukuma(6); sukuma(7);
    n64 x = f(2);
    sukuma(6); sukuma(7);
    n64 y = f(1);
    rudisha x + y + 1;
}
