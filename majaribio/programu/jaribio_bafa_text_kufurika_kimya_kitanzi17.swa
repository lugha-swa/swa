// jaribio la kudumu -- kufuatia #301 (bafa za chanzo 1MB -> 16MB):
// uchunguzi wa #301 uligundua mdudu MWINGINE, tofauti kabisa: andika_baiti()
// (uzalishaji.swa) iliweka text_imefurika = 1 ilipojaa bafa_text, lakini
// bendera hiyo HAIJAWAHI kusomwa/kukaguliwa popote kwenye mradi mzima kabla
// ya kutoa ELF ya mwisho au kuamua msimbo wa kutoka -- ukusanyaji uliendelea
// "kimya" ukimaliza kwa msimbo wa kutoka 0 (mafanikio ya uwongo) huku ukitoa
// ELF iliyokatika/kuharibika. Hii NI AINA ILEILE ya mdudu uliorekebishwa #189,
// #197, #199, #200, #292, #295, #298 na #301: jedwali lenye ukubwa dhahiri,
// ikijaa kimya (ujumbe wa onyo bila kusimamisha mchakato), ikizalisha matokeo
// yaliyoharibika bila ishara ya kweli ya kosa.
//
// Bendera ile ile (text_imefurika) pia inawekwa na ukaguzi mwingine wa ndani
// usiohusiana na ukubwa HALISI wa bafa_text (uzalishaji.swa): undani wa
// kitanzi (mzunguko_undani) kuzidi 16, na vigezo vya ndani (var_idadi)
// kuzidi 64. Hizi ni rahisi ZAIDI kugonga kwa jaribio dogo/haraka kuliko
// kuzalisha MAMILIONI ya baiti za msimbo wa mashine halisi (ambayo sasa
// inahitaji kuzidi 16,777,216 baiti baada ya ukubwa wa bafa_text kuongezwa
// kwenye PR hii) -- jaribio hili linatumia kitanzi cha 17 (> kikomo cha 16)
// kugonga njia ile ile ya hitilafu HASA, likithibitisha kwamba ukaguzi wa
// mwisho mpya (ndani ya uzalishaji_kuu, kabla ya "4. Toa ELF kwa stdout",
// na wavu wa pili ndani ya stage1.swa::main()) unashughulikia bendera MOJA
// inayoshirikiwa na VYANZO VYOTE vitatu vya kujaa, si bafa_text pekee.
//
// UTHIBITISHO WA MUTATION (umefanywa kabla ya PR hii, nje ya mnyororo huu
// wa kawaida -- angalia ujumbe wa PR kwa undani kamili): kurudisha
// uzalishaji.swa/stage1.swa kwenye hali ya KABLA ya rekebisho hili (ukaguzi
// wa mwisho haupo kabisa) na kujenga upya stage1, kisha kukusanya chanzo
// HIKI HIKI kunatoa hasa dalili ya zamani -- mkusanyaji unatoka kwa MSIMBO 0
// (mafanikio ya uwongo) ukiwa umeandika ujumbe "; KOSA: upeo wa kupandikiza
// kitanzi (16)" kwenye stderr PEKEE (si kwenye njia inayozuia), na kutoa
// faili la pato lenye baiti ~800+ (msimbo uliokatika/haribika kwa sababu
// mwili wa kitanzi cha ndani kabisa uliruka kuzalishwa kimya). Baada ya
// rekebisho hili, chanzo HIKI HIKI kinakataliwa kwa sauti: msimbo wa kutoka
// 1, ujumbe wa kosa kwenye stderr, NA HAKUNA FAILI LA PATO LOLOTE (baiti 0 --
// ukaguzi mpya uko KABLA ya kichwa cha ELF kuanza kuandikwa kabisa).
n32 main() {
    n32 s = 0;
    kwa (n32 a = 0; a < 1; a = a + 1) {
    kwa (n32 b = 0; b < 1; b = b + 1) {
    kwa (n32 c = 0; c < 1; c = c + 1) {
    kwa (n32 d = 0; d < 1; d = d + 1) {
    kwa (n32 e = 0; e < 1; e = e + 1) {
    kwa (n32 f = 0; f < 1; f = f + 1) {
    kwa (n32 g = 0; g < 1; g = g + 1) {
    kwa (n32 h = 0; h < 1; h = h + 1) {
    kwa (n32 i = 0; i < 1; i = i + 1) {
    kwa (n32 j = 0; j < 1; j = j + 1) {
    kwa (n32 k = 0; k < 1; k = k + 1) {
    kwa (n32 l = 0; l < 1; l = l + 1) {
    kwa (n32 m = 0; m < 1; m = m + 1) {
    kwa (n32 n = 0; n < 1; n = n + 1) {
    kwa (n32 o = 0; o < 1; o = o + 1) {
    kwa (n32 p = 0; p < 1; p = p + 1) {
    kwa (n32 q = 0; q < 1; q = q + 1) {
        s = s + 1;
    }}}}}}}}}}}}}}}}}
    rudisha s;
}
