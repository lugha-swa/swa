// endelea ndani ya kama + vunja mwishoni mwa mwili wa kwa:
// lebo ya hatua lazima itolewe ingawa mnyororo unakatika kwenye
// vunja — vinginevyo endelea inaruka mahali pasipo lebo.
n32 main() {
    n32 s = 0;
    n32 i = 0;
    kwa (i = 0; i < 5; i = i + 1) {
        kama (i == 0) endelea;
        s = s + 1;
        vunja;
    }
    rudisha s;
}
