// Hati 2.3: halisi za herufi ('\n', 'a', '\x41') hazimo kwenye lugha --
// thamani ya herufi huandikwa kama namba (10, 97, 65). Chanzo hiki LAZIMA
// kikataliwe kwa sauti (MANIFEST: KATA, kamili; mbegu pia hukataa, ikiandika
// 'herufi isiyojulikana' kwenye stdout).
n32 anza() {
    n8 a = '\n';
    n8 b = '\t';
    n8 c = '\r';
    n8 d = '\\';
    n8 e = '\0';
    n8 f = '\x41';
    n8 g = '\x5A';
    rudisha 0;
}
