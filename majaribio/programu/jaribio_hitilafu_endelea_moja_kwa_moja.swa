// endelea kama taarifa ya MOJA KWA MOJA ndani ya maudhui ya kwa.
// Zamani mfululizo wa uzalishaji ulikwama (mzunguko usioisha):
// mahali pa hatua hapakutolewa kwa sababu mfululizo wa maudhui ulikatika
// kwenye endelea. Awali ni sahihi.
n32 anza() {
    n32 s = 0;
    n32 i = 0;
    kwa (i = 0; i < 3; i = i + 1) {
        s = s + 1;
        endelea;
    }
    rudisha s;
}
