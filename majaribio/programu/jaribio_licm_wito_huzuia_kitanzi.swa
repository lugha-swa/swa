// LICM hatari #3: kitanzi chenye WITO WOWOTE mahali popote ndani ya
// mwili wake (hata kama wito wenyewe hauhusiani na usemi unaoonekana
// "usiobadilika") lazima kiruke KABISA kwa LICM -- mwito unaweza
// kubadilisha kigezo cha ulimwengu ambacho usemi huo unakitegemea.
// mabadiliko() huongeza g kwa 100 kila wito. "y = g * 2" ingeonekana
// isiyobadilika (g haibadilishwi MOJA KWA MOJA na taarifa nyingine
// yoyote ya mwili) ikiwa uchunguzi wa wito haukuzingatiwa -- lakini
// kwa kweli g HUBADILIKA kila mzunguko kupitia wito huo.
N32 g;

W0 mabadiliko() {
    g = g + 100;
}

N32 main() {
    g = 1;
    N32 y = 0;
    N32 i = 0;
    wakati (i < 3) {
        y = g * 2;
        mabadiliko();
        i = i + 1;
    }
    // mzunguko1: y=1*2=2, g->101
    // mzunguko2: y=101*2=202, g->201
    // mzunguko3: y=201*2=402, g->301
    kama (y != 402) { rudisha 1; }
    rudisha 0;
}
