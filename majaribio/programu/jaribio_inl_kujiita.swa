// inl_kujiita: kazi inayojiita yenyewe (moja kwa moja) HAIPASWI
// kuunganishwa (ingesababisha urudiaji usio na kikomo wa usukaji
// wakati wa kukusanya). Jaribio hili linathibitisha kwamba usahihi
// wa hesabu unabaki sahihi hata baada ya pasi ya kuunganisha kupita
// (kazi bado inaitwa kwa kawaida, si kusukwa).
n32 hesabu_kushuka;

w0 shuka(n32 n) {
    kama (n > 0) {
        hesabu_kushuka = hesabu_kushuka + 1;
        shuka(n - 1);
    }
}

n32 main() {
    hesabu_kushuka = 0;
    shuka(5);
    kama (hesabu_kushuka != 5) { rudisha 1; }
    rudisha 0;
}
