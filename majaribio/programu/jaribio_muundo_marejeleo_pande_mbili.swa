// Sawa na jaribio_muundo_kujirejelea_bado_kazi.swa, lakini marejeleo
// ya PANDE MBILI kati ya miundo miwili tofauti (A imetangazwa kabla
// ya B, lakini A inarejelea B kupitia kielekezi) -- uthibitisho kamili
// zaidi kwamba mpangilio wa utangazaji hauathiri uthibitisho, maadamu
// miundo yote miwili ipo mahali fulani kwenye graph. Stage1 pekee.
muundo A { B* b; n32 alama; }
muundo B { A* a; n32 alama; }
n32 anza() {
    A x;
    B y;
    x.b = &y;
    x.alama = 1;
    y.a = &x;
    y.alama = 2;
    rudisha x.b->alama + y.a->alama;
}
