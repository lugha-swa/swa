// jaribio_hitilafu_kurudia_kirefu: kina 40,000 cha kujirudia.
// Kabla: kila fremu ya uzalishaji ilichukua baiti 304 (vyombo vya
// sret/wito zisizo na masharti) -- SEGV 139 kwa kina ~25,000.
// Sasa fremu ni baiti 16 na kina 100,000+ kinafanya kazi (kikomo
// halisi ni mrundikano wa mfumo, ~130,000).
// Inatarajiwa: 40000 mod 256 = 64.
n32 kina(n32 n) {
    kama (n == 0) { rudisha 0; }
    rudisha 1 + kina(n - 1);
}

n32 anza() {
    rudisha kina(40000);
}
