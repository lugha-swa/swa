// Mende: halisi >= 2^63 ilikuwa ikikatwa kimya hadi biti 32 — msimbo
// uliotolewa ulikuwa "mov eax, 0xFFFFFFFF" (n64 x = 18446744073709551615
// ilikuwa 4294967295). Hati 2.3 inaahidi nambari kamili — thamani
// lazima ibaki kamili (18446744073709551615 = 2^64-1).
n32 main() {
    n64 x = 18446744073709551615;
    kama (x == 18446744073709551615) { rudisha 0; }
    rudisha 1;
}
