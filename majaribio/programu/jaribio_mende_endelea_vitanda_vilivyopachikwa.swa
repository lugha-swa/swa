// endelea ndani ya kwa iliyopachikwa inaruka hadi hatua ya kitanzi
// cha NDANI (semantiki ya C) — si cha nje.
n32 main() {
    n32 s = 0;
    n32 i = 0;
    n32 j = 0;
    kwa (i = 0; i < 3; i = i + 1) {
        kwa (j = 0; j < 3; j = j + 1) {
            kama (j == 1) endelea;
            s = s + 1;
        }
    }
    rudisha s;
}
