// Zidisho-na-uchawi -- mfululizo mpana wa (kigawanyaji, kigawiwa)
// dhidi ya idiv, ndani ya mzunguko wa wakati wa kukimbia (dividend ni
// KIGEZO, si namba halisi -- inaepuka kabisa mkondo wa kukunja namba,
// angalia maelezo ya PR #243 kuhusu mdudu wa mbegu.bin usiohusiana).
// Kigawanyaji NI namba halisi ya moja kwa moja (kulazimisha njia mpya)
// dhidi ya nakala yake ya kigezo (kulazimisha idiv), yote mawili
// yakilinganishwa dhidi ya kila mmoja kwa kila x.
//
// MUHIMU (uzoefu uliopatikana wakati wa kuandika jaribio hili):
// (1) hakuna vitalu VISIVYO na kitanzi/tawi vinavyofunga tangazo la
//     kigezo cha ndani ({ n32 x = 1; }) -- mdudu WA KWAKE, usiohusiana
//     kabisa na kazi hii, uliogunduliwa hapa (angalia maelezo ya PR);
// (2) kigezo cha kitanzi HAKIWEZI kuongezwa kikaribia N32_JUU moja
//     kwa moja (kufurika kunazunguka hadi N32_CHINI, sharti la
//     kitanzi lisilotambua hilo -- HITILAFU YA JARIBIO, si ya
//     mkusanyaji) -- hesabu za mipaka hutumia kupunguza kutoka juu.
n32 chks3(n32 x, n32 dv) {
    n32 qf = x / 3; n32 qs = x / dv; n32 rf = x % 3; n32 rs = x % dv;
    kama (qf != qs) { rudisha 1; } kama (rf != rs) { rudisha 2; }
    kama ((qf * 3) + rf != x) { rudisha 3; }
    rudisha 0;
}
