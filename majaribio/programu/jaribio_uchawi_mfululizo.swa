    N32 qf = x / 5; N32 qs = x / dv; N32 rf = x % 5; N32 rs = x % dv;
    kama (qf != qs) { rudisha 1; } kama (rf != rs) { rudisha 2; }
    kama ((qf * 5) + rf != x) { rudisha 3; }
    rudisha 0;
}
