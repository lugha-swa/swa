// Ugawaji wa rejesta, awamu ya 2 (paramu) -- paramu za rejesta ya
// kudumu lazima zibaki sahihi KABLA na BAADA ya wito wa kazi nyingine
// (lengo hasa la kutumia rejesta za callee-saved). Thamani halisi:
// kabla=3+4=7, r1=700, baada ya wito x/y bado 3/4, rudisho=3+4+7=14.
n32 badilisha(n32 v) {
    rudisha v * 100;
}

n32 jaribu(n32 x, n32 y) {
    n32 kabla = x + y;
    n32 r1 = badilisha(kabla);
    n32 baada = x + y;
    kama (kabla != baada) { rudisha 1; }
    rudisha x + y + (r1 / 100);
}

n32 main() {
    rudisha jaribu(3, 4);
}
