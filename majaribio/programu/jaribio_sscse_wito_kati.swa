// SSCSE -- wito wa kazi kati ya tokeo mawili la usemi unaorudiwa.
//
// UGUNDUZI (uliothibitishwa kwa disassembly wakati wa kuandaa jaribio
// hili): WITO WOWOTE (AST_WITO) unaopatikana kati ya taarifa mbili
// UNAFUTA JEDWALI ZIMA la upatikanaji -- HATA kama usemi unaorudiwa
// unarejelea KIGEZO CHA NDANI TU (kisichoguswa na wito huo hata
// kidogo). Hii ni KWA MAKUSUDI (angalia SABABU #5 kwenye maelezo
// makuu ya sscse_boresha, msambazaji.swa): mkusanyaji huu hautofautishi
// kigezo cha ndani na cha ULIMWENGU katika awamu hii (LICM yenyewe
// haitofautishi pia), hivyo hatuna njia salama ya kujua kama wito huo
// "hauguzi kabisa" bila uchambuzi wa grafu ya wito (nje ya wigo).
// Matokeo: fursa iliyokosekana (haiguzi_lolote() ingeruhusu "a*b"
// kushiriki kimantiki, lakini haitumiki hapa), SI hatari ya usahihi --
// jaribio hili linathibitisha USAHIHI unabaki (si tu kwamba
// haikuanguka) kwa PANDE ZOTE MBILI: usemi usiohusiana na wito
// (a*b) NA usemi unaohusiana moja kwa moja (g*2, ambapo g ni kigezo
// cha ulimwengu kinachobadilishwa na wito wenyewe -- hapa kufuta
// jedwali ni MUHIMU kikweli, si tahadhari ya ziada tu).
N32 g = 0;

N32 haiguzi_lolote() {
    rudisha 5;
}

N32 badilisha_g() {
    g = g + 1;
    rudisha g;
}

N32 main() {
    N32 a = 6;
    N32 b = 7;
    N32 x = a * b + 1;              // 43
    N32 unused = haiguzi_lolote();  // wito -- HUFUTA jedwali kwa uangalifu, ijapokuwa haiguzi a/b
    N32 y = a * b + 2;              // 44 -- HAISHIRIKI na x (fursa iliyokosekana, si hitilafu) --
                                     // lakini bado LAZIMA itoe thamani SAHIHI
    kama (x != 43) { rudisha 1; }
    kama (y != 44) { rudisha 2; }
    kama (unused != 5) { rudisha 3; }

    g = 10;
    N32 p = g * 2 + 1;      // 21, g=10
    N32 q = badilisha_g();  // g=11 sasa -- wito huu HUFUTA jedwali, na hapa ni MUHIMU kikweli
    N32 r = g * 2 + 1;      // 23, g=11 -- LAZIMA ikokotolewe upya, SI 21 (thamani ya zamani)
    kama (p != 21) { rudisha 4; }
    kama (q != 11) { rudisha 5; }
    kama (r != 23) { rudisha 6; }

    rudisha 0;
}
