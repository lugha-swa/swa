// vunja ndani ya mkono wa chagua inamaliza MZUNGUKO wa ndani kabisa
// (wakati au kwa -- vipimo 6.7), si chagua chenyewe: chagua haina
// mwanguko, hivyo hakuna vunja ya mkono inayohitajika.
n32 anza() {
    n32 s = 0;
    n32 i = 0;
    kwa (i = 0; i < 3; i = i + 1) {
        chagua (i) {
            hali 1: acha;
            sivyo: s = s + 1;
        }
    }
    rudisha s;
}
