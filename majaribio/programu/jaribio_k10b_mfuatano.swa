w0 nakili(n8* lengwa, n8* chanzo, n64 n) {
    n64 i = 0;
    wakati (i < n) {
        lengwa[i] = chanzo[i];
        i = i + 1;
    }
}

W0 weka_sifuri(N8* lengwa, N64 n) {
    N64 i = 0;
    wakati (i < n) {
        lengwa[i] = 0;
        i = i + 1;
    }
}

N32 linganisha_kumbukumbu(N8* a, N8* b, N64 n) {
    N64 i = 0;
    wakati (i < n) {
        kama (a[i] < b[i]) {
            rudisha -1;
        }
        kama (a[i] > b[i]) {
            rudisha 1;
        }
        i = i + 1;
    }
    rudisha 0;
}

// ==========================================================
// Runtime ya syscalls — maktaba haihitaji libc tena
// ==========================================================

// Wito wa mfumo wa Linux — builtin ya mzalishaji (uzalishaji_wito)
// na daraja la C kwa mbegu. Haina tangazo la .swa: kila mkaguzi
// (wa Swa na wa Rust) hujenga saini kutoka hoja halisi za wito.

N64 sys_soma(N32 faili, N8* bafa, N64 urefu) {
    rudisha wito_wa_mfumo(0, faili, bafa, urefu, 0, 0, 0);
}

N64 sys_andika(N32 faili, N8* bafa, N64 urefu) {
    rudisha wito_wa_mfumo(1, faili, bafa, urefu, 0, 0, 0);
}

N64 sys_fungua(N8* njia, N64 bendera) {
    rudisha wito_wa_mfumo(2, njia, bendera, 0, 0, 0, 0);
}

N64 sys_funga(N32 faili) {
    rudisha wito_wa_mfumo(3, faili, 0, 0, 0, 0, 0);
}

N64 sys_mmap(N8* anwani, N64 urefu, N64 ulinzi, N64 bendera, N64 faili) {
    rudisha wito_wa_mfumo(9, anwani, urefu, ulinzi, bendera, faili, 0);
}

N64 sys_munmap(N8* anwani, N64 urefu) {
    rudisha wito_wa_mfumo(11, anwani, urefu, 0, 0, 0, 0);
}

// ==========================================================
// Uchapishaji — andika_n64 / andika_mfuatano / andika_baiti
// Hizi ndizo kazi zinazoitwa na builtin ya andika katika mzalishaji.
// ==========================================================

W0 andika_n64(N32 faili, N64 v) {
    // Bafa ya N32, si N8 — mbegu hutoa maandishi ya safu ya N8
    // kwa mizani ya baiti 4, hivyo tumia N32 na uchapishe tarakimu
    // moja kwa moja kupitia andika_herufi.
    N32 bafa[32];
    N32 n = 0;
    kama (v < 0) {
        andika_herufi(faili, 45);  // '-'
        v = 0 - v;
    }
    wakati (1 == 1) {
        bafa[n] = v - ((v / 10) * 10);
        n = n + 1;
        v = v / 10;
        kama (v == 0) { vunja; }
    }
    // Chapisha tarakimu kwa mpangilio wa nyuma
    wakati (n > 0) {
        n = n - 1;
        andika_herufi(faili, 48 + bafa[n]);
    }
}

W0 andika_mfuatano(N32 faili, N8* s) {
    // Urefu wa mfuatano unahesabiwa hapa — kumbukumbu.swa
    // haitegemei mfuatano.swa (jaribio la k10a linahusisha peke yake).
    N64 u = 0;
    wakati (s[u] != 0) {
        u = u + 1;
    }
    sys_andika(faili, s, u);
}

W0 andika_herufi(N32 faili, N64 b) {
    N8 bb = b;
    sys_andika(faili, &bb, 1);
}

W0 andika_sehemu(N32 faili, N8* s, N64 urefu) {
    sys_andika(faili, s, urefu);
}

// ==========================================================
// andika / andika_stderr — utekelezaji wa ndani wa muundo
// (kwa mbegu: wito za nje hujitatua hapa; codegen ya Swa ni builtin)
// Muundo ni mfuatano PAMOJA na nukuu, viashiria: %d, %s, %c, \n.
// ==========================================================

// Kielekezi kutoka hoja ya N64: mkia wa andika (a1..a6) hupita kwa
// rejesta za N64 kwa ABI, iwe thamani au kielekezi. %s huhitaji
// kielekezi — ubadilishaji wazi (ukaguzi wa hoja unakataa N64 kwa
// kigezo cha N8* tangu 2026-09-01).
N8* kielekezi_kutoka_hoja(N64 v) {
    N8* p = v;
    rudisha p;
}

W0 andika_ndani(N32 faili, N8* f, N64 a1, N64 a2, N64 a3, N64 a4, N64 a5, N64 a6) {
    N32 p = 0;  // mfuatano hauna nukuu (kumbukumbu hutoa bila nukuu)
    N32 na = 0;  // faharisi ya hoja inayofuata
    wakati (1 == 1) {
        kama (f[p] == 0) { vunja; }  // mwisho wa mfuatano (null terminator)
        kama (f[p] == 37) {  // '%'
            N8 sp = f[p + 1];
            p = p + 2;
            kama (sp == 100) {  // %d
                kama (na == 0) { andika_n64(faili, a1); } sivyo { kama (na == 1) { andika_n64(faili, a2); }
                    sivyo { kama (na == 2) { andika_n64(faili, a3); } sivyo { kama (na == 3) { andika_n64(faili, a4); }
                            sivyo { kama (na == 4) { andika_n64(faili, a5); } sivyo { andika_n64(faili, a6); } } } } }
                na = na + 1;
            } sivyo { kama (sp == 115) {  // %s
                    kama (na == 0) { andika_mfuatano(faili, kielekezi_kutoka_hoja(a1)); } sivyo { kama (na == 1) { andika_mfuatano(faili, kielekezi_kutoka_hoja(a2)); }
                        sivyo { kama (na == 2) { andika_mfuatano(faili, kielekezi_kutoka_hoja(a3)); } sivyo { kama (na == 3) { andika_mfuatano(faili, kielekezi_kutoka_hoja(a4)); }
                                sivyo { kama (na == 4) { andika_mfuatano(faili, kielekezi_kutoka_hoja(a5)); } sivyo { andika_mfuatano(faili, kielekezi_kutoka_hoja(a6)); } } } } }
                    na = na + 1;
                } sivyo { kama (sp == 99) {  // %c
                        kama (na == 0) { andika_herufi(faili, a1); } sivyo { kama (na == 1) { andika_herufi(faili, a2); }
                            sivyo { kama (na == 2) { andika_herufi(faili, a3); } sivyo { kama (na == 3) { andika_herufi(faili, a4); }
                                    sivyo { kama (na == 4) { andika_herufi(faili, a5); } sivyo { andika_herufi(faili, a6); } } } } }
                        na = na + 1;
                    } } }
            endelea;
        }
        kama (f[p] == 92 && f[p + 1] == 110) {  // \n
            andika_herufi(faili, 10);
            p = p + 2;
            endelea;
        }
        andika_herufi(faili, f[p]);
        p = p + 1;
    }
}

N32 andika(N8* f, N64 a1, N64 a2, N64 a3, N64 a4, N64 a5, N64 a6) {
    andika_ndani(1, f, a1, a2, a3, a4, a5, a6);
    rudisha 0;
}

N32 andika_stderr(N8* f, N64 a1, N64 a2, N64 a3, N64 a4, N64 a5, N64 a6) {
    andika_ndani(2, f, a1, a2, a3, a4, a5, a6);
    rudisha 0;
}

// ukubwa — kwa mbegu (codegen ya Swa huikokotoa wakati wa kukusanya)
N64 ukubwa(N32 aina) {
    kama (aina == 1) { rudisha 1; }
    kama (aina == 2) { rudisha 2; }
    kama (aina == 3) { rudisha 4; }
    kama (aina == 4) { rudisha 8; }
    rudisha 8;
}

// ==========================================================
// Arena ya kumbukumbu — badala ya malloc/realloc/free
// ==========================================================
N8* arena_anwani = 0;
N64 arena_nafasi = 0;

N8* tenga(N64 ukubwa) {
    kama (arena_anwani == 0) {
        // Anwani sifuri = "popote" (kama mmap(NULL, ...) ya C).
        // Halisi 0 kwa kigezo cha kielekezi inakataliwa na ukaguzi
        // wa 2026-09-01 — tumia kielekezi cha sifuri wazi.
        N8* anwani_sifuri = 0;
        arena_anwani = sys_mmap(anwani_sifuri, 1048576, 3, 34, 0 - 1);
        kama (arena_anwani == 0 - 1) { rudisha 0; }
    }
    kama (ukubwa == 0) { ukubwa = 8; }
    ukubwa = ukubwa + 8;  // nafasi ya ukubwa wa kipande (kwa badili)
    kama (arena_nafasi + ukubwa > 1048576) { rudisha 0; }
    N8* r = arena_anwani + arena_nafasi;
    // hifadhi ukubwa mbele ya kipande (baiti 8)
    N8* h = &ukubwa;
    N32 bi = 0;
    wakati (bi < 8) {
        r[bi] = h[bi];
        bi = bi + 1;
    }
    arena_nafasi = arena_nafasi + ukubwa;
    rudisha r + 8;
}

W0 achilia_arena(N8* p) {
    // Arena haiwezi kufungua vipande — hakuna kitu
}

N8* badili(N8* p, N64 ukubwa) {
    kama (p == 0) { rudisha tenga(ukubwa); }
    kama (ukubwa == 0) { rudisha p; }
    // soma ukubwa wa zamani kutoka kichwa cha kipande
    N64 zamani = 0;
    N8* h2 = &zamani;
    N32 bi2 = 0;
    wakati (bi2 < 8) {
        h2[bi2] = p[bi2 - 8];
        bi2 = bi2 + 1;
    }
    N8* r = tenga(ukubwa);
    kama (r == 0) { rudisha 0; }
    N64 nakili_urefu = zamani;
    kama (ukubwa < zamani) { nakili_urefu = ukubwa; }
    nakili(r, p, nakili_urefu);
    rudisha r;
}

// ==========================================================
// Usomaji wa desimali halisi — badala ya strtod (libc)
// bits_ya_d64_swa: mfuatano [-]z.z → baiti za D64 (IEEE 754)
// (majina ya kigeu hayawezi kuwa herufi za aina: N A B D W)
// Kikomo cha sasa: tarakimu za kasoro <= 10 kwa thamani < 2^26,
// <= 3 kwa thamani kubwa zaidi (vinginevyo hesabu*2^hamisha
// inaweza kuzidi baiti 64).
// ==========================================================

N64 p2_kwa(N32 kubwa) {
    N64 thamani = 1;
    N32 fasi = 0;
    wakati (fasi < kubwa) {
        thamani = thamani * 2;
        fasi = fasi + 1;
    }
    rudisha thamani;
}

// KUMBUKA: bits_ya_d64_swa imegawanywa katika kazi mbili kwa sababu
// mbegu ilikusanya vibaya kazi ndefu sana (FPE) — sehemu ndogo
// zinakusanywa kwa usahihi. API haijabadilika.
N64 bits_ya_d64_swa(N8* ch, N32 u) {
    N64 alama = 0;
    N32 fasi = 0;
    kama (ch[fasi] == 45) { alama = 1; fasi = fasi + 1; }
    N64 nzima = 0;
    wakati (fasi < u && ch[fasi] != 46) {
        nzima = nzima * 10 + (ch[fasi] - 48);
        fasi = fasi + 1;
    }
    N64 kasoro = 0;
    N64 idadi_k = 0;
    kama (fasi < u && ch[fasi] == 46) {
        fasi = fasi + 1;
        wakati (fasi < u) {
            kasoro = kasoro * 10 + (ch[fasi] - 48);
            idadi_k = idadi_k + 1;
            fasi = fasi + 1;
        }
    }
    // nene = 10^idadi_k
    N64 nene = 1;
    N32 kaunta = 0;
    wakati (kaunta < idadi_k) { nene = nene * 10; kaunta = kaunta + 1; }
    // hesabu = nzima * nene + kasoro  (thamani = hesabu / nene)
    N64 hesabu = nzima * nene + kasoro;
    kama (hesabu == 0) { rudisha 0; }

    // kizio: kubwa zaidi kama 2^kizio <= hesabu/nene < 2^(kizio+1)
    N64 urefu_juu = 0; N64 muda = hesabu;
    wakati (muda > 0) { muda = muda / 2; urefu_juu = urefu_juu + 1; }
    N64 urefu_chini = 0; muda = nene;
    wakati (muda > 0) { muda = muda / 2; urefu_chini = urefu_chini + 1; }
    N64 kizio = urefu_juu - urefu_chini;
    kama (kizio >= 0) {
        // kurekebisha chini: kama hesabu/nene < 2^kizio, punguza
        N64 p2m = p2_kwa(kizio);
        kama (hesabu < nene * p2m) { kizio = kizio - 1; }
    } sivyo {
        // kizio hasi (v < 1): linganisha hesabu * 2^m < nene, m = -kizio
        N64 m = 0 - kizio;
        N64 q = 1;
        N32 mf = 0;
        wakati (mf < m) { q = q * 2; mf = mf + 1; }
        kama (hesabu * q < nene) { kizio = kizio - 1; }
    }
    // Kuinua hesabu hadi [nene, 2*nene) — hesabu/nene sasa ni
    // 2^(kizio+d); kizio yenyewe inabaki kielelezo cha thamani asilia.
    N64 d = 0;
    wakati (hesabu < nene) {
        hesabu = hesabu * 2;
        d = d + 1;
    }

    // pacha = (hesabu/nene - 2^(kizio+d)) * 2^(52-kizio-d)
    //       = hesabu * 2^(52-kizio-d) / nene - 2^52
    rudisha kamilisha_bits_swa(hesabu, nene, kizio, d, alama);
}

N64 kamilisha_bits_swa(N64 hesabu, N64 nene, N64 kizio, N64 d, N64 alama) {
    N64 hamisha = 52 - (kizio + d);
    kama (hamisha < 0) { hamisha = 0; }
    kama (hamisha > 52) { hamisha = 52; }
    N64 p52 = p2_kwa(52);
    N64 pacha = 0;
    kama (hamisha <= 26) {
        N64 p2s = p2_kwa(hamisha);
        pacha = (hesabu * p2s) / nene - p52;
    } sivyo {
        N64 p2a = p2_kwa(26);
        N64 p2b = p2_kwa(hamisha - 26);
        N64 hi = (hesabu * p2a) / nene;
        N64 salio = hesabu * p2a - hi * nene;
        pacha = hi * p2b + (salio * p2b) / nene - p52;
    }
    N64 p63 = p2_kwa(63);
    N64 biti = 0;
    kama (alama == 1) { biti = biti + p63; }
    biti = biti + (kizio + 1023) * p52;
    biti = biti + (pacha - (pacha / p52) * p52);
    rudisha biti;
}

// soma_mstari — soma mstari mmoja kutoka faili hadi bafa.
// Inasimama kwa '\n' (isiyojumuishwa) au EOF. Rudisha idadi ya
// baiti zilizosomwa, au -1 ikiwa EOF mara moja bila baiti.
N64 soma_mstari(N32 faili, N8* bafa, N64 upeo) {
    N64 n = 0;
    wakati (n + 1 < upeo) {
        N8 ch = 0;
        N64 r = sys_soma(faili, &ch, 1);
        kama (r <= 0) {
            kama (n == 0) {
                rudisha -1;
            }
            rudisha n;
        }
        kama (ch == 10) {
            rudisha n;
        }
        bafa[n] = ch;
        n = n + 1;
    }
    rudisha n;
}
husisha { kumbukumbu.swa }

N64 urefu_wa_mfuatano(N8* s) {
    N64 n = 0;
    wakati (s[n] != 0) {
        n = n + 1;
    }
    rudisha n;
}

N32 linganisha_mfuatano(N8* a, N8* b) {
    N64 i = 0;
    wakati (a[i] != 0 && b[i] != 0) {
        kama (a[i] < b[i]) {
            rudisha -1;
        }
        kama (a[i] > b[i]) {
            rudisha 1;
        }
        i = i + 1;
    }
    kama (a[i] == 0 && b[i] == 0) {
        rudisha 0;
    }
    kama (a[i] == 0) {
        rudisha -1;
    }
    rudisha 1;
}

W0 nakili_mfuatano(N8* lengwa, N8* chanzo) {
    N64 i = 0;
    wakati (chanzo[i] != 0) {
        lengwa[i] = chanzo[i];
        i = i + 1;
    }
    lengwa[i] = 0;
}

W0 unganisha_mfuatano(N8* lengwa, N8* a, N8* b) {
    N64 i = 0;
    N64 j = 0;
    wakati (a[j] != 0) {
        lengwa[i] = a[j];
        i = i + 1;
        j = j + 1;
    }
    j = 0;
    wakati (b[j] != 0) {
        lengwa[i] = b[j];
        i = i + 1;
        j = j + 1;
    }
    lengwa[i] = 0;
}

N32 tafuta_herufi(N8* s, N8 c) {
    N32 i = 0;
    wakati (s[i] != 0) {
        kama (s[i] == c) {
            rudisha i;
        }
        i = i + 1;
    }
    rudisha -1;
}
N32 nambari_kwa_mfuatano(N32 n, N8* buf) {
    kama (n == 0) {
        buf[0] = 48;
        buf[1] = 0;
        rudisha 1;
    }
    N32 hasi = 0;
    N32 val = n;
    kama (n < 0) {
        buf[0] = 45;
        hasi = 1;
        val = 0 - n;
    }
    N32 len = 0;
    N32 tmp = val;
    wakati (tmp > 0) {
        len = len + 1;
        tmp = tmp / 10;
    }
    N32 pos = hasi + len;
    buf[pos] = 0;
    wakati (pos > hasi) {
        pos = pos - 1;
        buf[pos] = 48 + (val - (val / 10) * 10);
        val = val / 10;
    }
    rudisha hasi + len;
}
N32 linganisha_mfuatano_n(N8* a, N8* b, N64 n) {
    N64 i = 0;
    wakati (i < n) {
        kama (a[i] == 0 && b[i] == 0) {
            rudisha 0;
        }
        kama (a[i] == 0) {
            rudisha -1;
        }
        kama (b[i] == 0) {
            rudisha 1;
        }
        kama (a[i] < b[i]) {
            rudisha -1;
        }
        kama (a[i] > b[i]) {
            rudisha 1;
        }
        i = i + 1;
    }
    rudisha 0;
}
N32 tafuta_herufi_mwisho(N8* s, N8 c) {
    N32 matokeo = -1;
    N32 i = 0;
    wakati (s[i] != 0) {
        kama (s[i] == c) {
            matokeo = i;
        }
        i = i + 1;
    }
    rudisha matokeo;
}

// Ubadilishaji wa mfuatano hadi nambari.

N32 mfuatano_hadi_n32(N8* s) {
    N32 matokeo = 0;
    N32 hasi = 0;
    N32 i = 0;
    // Ruka nafasi nyeupe mwanzoni.
    wakati (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13) {
        i = i + 1;
    }
    // Angalia alama ya hasi/chanya.
    kama (s[i] == 45) {
        hasi = 1;
        i = i + 1;
    } sivyo {
        kama (s[i] == 43) {
            i = i + 1;
        }
    }
    // Soma tarakimu.
    wakati (s[i] >= 48 && s[i] <= 57) {
        matokeo = matokeo * 10 + (s[i] - 48);
        i = i + 1;
    }
    kama (hasi == 1) {
        rudisha 0 - matokeo;
    }
    rudisha matokeo;
}

N64 mfuatano_hadi_n64(N8* s) {
    N64 matokeo = 0;
    N32 hasi = 0;
    N32 i = 0;
    // Ruka nafasi nyeupe mwanzoni.
    wakati (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13) {
        i = i + 1;
    }
    // Angalia alama ya hasi/chanya.
    kama (s[i] == 45) {
        hasi = 1;
        i = i + 1;
    } sivyo {
        kama (s[i] == 43) {
            i = i + 1;
        }
    }
    // Soma tarakimu.
    wakati (s[i] >= 48 && s[i] <= 57) {
        matokeo = matokeo * 10 + (s[i] - 48);
        i = i + 1;
    }
    kama (hasi == 1) {
        rudisha 0 - matokeo;
    }
    rudisha matokeo;
}

// Umbizaji wa nambari hadi mfuatano.

// Badilisha N64 hadi mfuatano. Hurudisha urefu wa mfuatano ulioandikwa.
N32 nambari_kwa_mfuatano_n64(N64 n, N8* buf) {
    kama (n == 0) {
        buf[0] = 48;
        buf[1] = 0;
        rudisha 1;
    }
    N32 hasi = 0;
    N64 val = n;
    kama (n < 0) {
        buf[0] = 45;
        hasi = 1;
        val = 0 - n;
    }
    N32 len = 0;
    N64 tmp = val;
    wakati (tmp > 0) {
        len = len + 1;
        tmp = tmp / 10;
    }
    N32 pos = hasi + len;
    buf[pos] = 0;
    wakati (pos > hasi) {
        pos = pos - 1;
        buf[pos] = 48 + (val - (val / 10) * 10);
        val = val / 10;
    }
    rudisha hasi + len;
}

// tafuta_mfuatano — pata nafasi ya kwanza ya mfuatano mdogo ndani
// ya mfuatano mkubwa. Rudisha -1 ikiwa haupo.
N32 tafuta_mfuatano(N8* s, N8* ndogo) {
    N64 n = urefu_wa_mfuatano(ndogo);
    kama (n == 0) {
        rudisha 0;
    }
    N64 i = 0;
    wakati (s[i] != 0) {
        N64 j = 0;
        wakati (j < n && s[i + j] == ndogo[j]) {
            j = j + 1;
        }
        kama (j == n) {
            rudisha i;
        }
        i = i + 1;
    }
    rudisha -1;
}

// kata_nafasi — rudisha faharisi ya herufi ya kwanza isiyo nafasi,
// na urefu wa mwisho usio na nafasi (kupitia kielekezi). Inarudisha
// mwanzo mpya; *mwisho hupokea faharisi moja baada ya herufi ya
// mwisho isiyo nafasi (tayari kwa kunakili hadi hapo).
N32 kata_nafasi(N8* s, N64* mwisho) {
    N64 i = 0;
    wakati (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13) {
        i = i + 1;
    }
    N64 mw = i;
    N64 j = i;
    wakati (s[j] != 0) {
        j = j + 1;
    }
    wakati (j > mw && (s[j - 1] == 32 || s[j - 1] == 9 || s[j - 1] == 10 || s[j - 1] == 13)) {
        j = j - 1;
    }
    *mwisho = j;
    rudisha i;
}
N32 main() {
    // mifuatano imejengwa kwa herufi moja moja — mbegu haijui vitendea-mbali vya mifuatano
    N8 s1[6]; s1[0] = 104; s1[1] = 101; s1[2] = 108; s1[3] = 108; s1[4] = 111; s1[5] = 0;  // "hello"
    N8 s2[6]; s2[0] = 104; s2[1] = 101; s2[2] = 108; s2[3] = 108; s2[4] = 111; s2[5] = 0;  // "hello"
    N8 s3[6]; s3[0] = 104; s3[1] = 101; s3[2] = 108; s3[3] = 112; s3[4] = 111; s3[5] = 0;  // "helpo"
    kama (linganisha_mfuatano(s1, s2) != 0) rudisha 1;
    // s1 < s3 kwa sababu 'l' < 'p'
    kama (linganisha_mfuatano(s1, s3) == 0) rudisha 2;

    // nakili_mfuatano — inanakili mfuatano
    N8 buf[32];
    nakili_mfuatano(buf, s1);
    kama (linganisha_mfuatano(buf, s1) != 0) rudisha 3;

    // mfuatano_hadi_n32 — ubadilishaji mfuatano→namba
    N8 namba1[3]; namba1[0] = 52; namba1[1] = 50; namba1[2] = 0;  // "42"
    kama (mfuatano_hadi_n32(namba1) != 42) rudisha 4;

    N8 namba2[6]; namba2[0] = 32; namba2[1] = 32; namba2[2] = 45; namba2[3] = 49; namba2[4] = 55; namba2[5] = 0;  // "   -17"
    kama (mfuatano_hadi_n32(namba2) != -17) rudisha 5;

    // nambari_kwa_mfuatano — ubadilishaji namba→mfuatano
    N8 buf2[32];
    nambari_kwa_mfuatano(99, buf2);
    kama (buf2[0] != 57) rudisha 6;  // '9'
    kama (buf2[1] != 57) rudisha 7;  // '9'
    kama (buf2[2] != 0) rudisha 8;  // ncha-tupu

    // tafuta_herufi — inatafuta herufi kwenye mfuatano
    N8 s4[7]; s4[0] = 104; s4[1] = 97; s4[2] = 98; s4[3] = 97; s4[4] = 114; s4[5] = 105; s4[6] = 0;  // "habari"
    kama (tafuta_herufi(s4, 98) != 2) rudisha 9;  // 'b' iko kwenye faharisi 2
    kama (tafuta_herufi(s4, 122) != -1) rudisha 10;  // 'z' haipo

    rudisha 0;
}
