// *ptr = thamani (isiyo ya kiwanja, isiyo ya muundo) kwa njia ya haraka:
// kielekezi kinashikiliwa kwenye r9 wakati RHS salama inatathminiwa,
// badala ya push/pop ya anwani -- angalia uzalishaji_hifadhi_ptr_sib.

husisha { msingi/maktaba/kumbukumbu.swa }

n32 piga(n32 x) { rudisha x * 2; }   // WITO -- hufanya RHS isiwe salama

n32 jaribu_aina_zote() {
    n8* b8 = tenga(8);
    n16* b16 = tenga(ukubwa(n16) * 4);
    n32* b32 = tenga(ukubwa(n32) * 4);
    n64* b64 = tenga(ukubwa(n64) * 4);
    d32* bd32 = tenga(ukubwa(d32) * 4);
    d64* bd64 = tenga(ukubwa(d64) * 4);
    *b8 = 0 - 5;
    *b16 = 0 - 3000;
    *b32 = 0 - 300000;
    *b64 = 0 - 5000000000;
    *bd32 = 2.5;
    *bd64 = 3.5;
    kama (*b8 != (0 - 5)) { rudisha 1; }
    kama (*b16 != (0 - 3000)) { rudisha 2; }
    kama (*b32 != (0 - 300000)) { rudisha 3; }
    kama (*b64 != (0 - 5000000000)) { rudisha 4; }
    kama (*bd32 != 2.5) { rudisha 5; }
    kama (*bd64 != 3.5) { rudisha 6; }
    // RHS isiyo dogo (inatumia rcx kama scratch ya ndani -- inathibitisha
    // kielekezi hakiharibiki, hakitegemei rcx kubaki bila kuguswa kwa
    // bahati) kwa kila upana, ikiwemo byte -- mdudu HALISI ulipatikana
    // hapa wakati wa kuandika (angalia jaribio_uhifadhi_ptr kwenye
    // MANIFEST): RHS ndogo (namba ya moja kwa moja) haikuwa ikigusa rcx
      // KAMWE, hivyo mutation ya REX.B ilipita bila kugundulika.
    n32 x1 = 3; n32 x2 = 4;
    *b8 = x1 + x2 * 2;       // 11
    kama (*b8 != 11) { rudisha 7; }
    *b16 = x1 + x2 * 2;
    kama (*b16 != 11) { rudisha 8; }
    *b64 = x1 + x2 * 2;
    kama (*b64 != 11) { rudisha 9; }
    rudisha 0;
}

n32 jaribu_rhs_salama_na_isiyo_salama() {
    n32* p = tenga(ukubwa(n32) * 4);
    n32* q = tenga(ukubwa(n32) * 4);
    *p = 5; *q = 10;
    *p = *p + *q * 2;              // RHS salama (usemi wa hesabu)
    kama (*p != 25) { rudisha 1; }
    *p = piga(*q);                 // RHS isiyo salama (wito)
    kama (*p != 20) { rudisha 2; }
    *p = *p + 1;                   // *p kusomwa NA kuandikwa (usomaji kabla)
    kama (*p != 21) { rudisha 3; }
    rudisha 0;
}

// Kielekezi kilichotokana na pointer arithmetic (bado jani -- kigezo)
n32 jaribu_kielekezi_kilichosongwa() {
    n32* arr = tenga(ukubwa(n32) * 8);
    n32 i = 0;
    wakati (i < 8) { arr[i] = i; i = i + 1; }
    n32* mid = arr + 4;
    *mid = 999;
    kama (arr[4] != 999) { rudisha 1; }
    kama (*mid != 999) { rudisha 2; }
    rudisha 0;
}

n32 jaribu_kiwanja_bado_sahihi() {
    n32* p = tenga(ukubwa(n32) * 4);
    *p = 10;
    *p += 5;
    kama (*p != 15) { rudisha 1; }
    *p -= 3;
    kama (*p != 12) { rudisha 2; }
    rudisha 0;
}

n32 main() {
    n32 r = jaribu_aina_zote();
    kama (r != 0) { rudisha 10 + r; }
    r = jaribu_rhs_salama_na_isiyo_salama();
    kama (r != 0) { rudisha 20 + r; }
    r = jaribu_kielekezi_kilichosongwa();
    kama (r != 0) { rudisha 30 + r; }
    r = jaribu_kiwanja_bado_sahihi();
    kama (r != 0) { rudisha 40 + r; }
    rudisha 0;
}
