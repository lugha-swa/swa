// SASISHO: kwa muundo WA KIWANJA HALISI (+=, njia (1) ya ugunduzi
// kwenye uzalishaji_asimilia_kiwanja_tail), njia ya haraka
// HAISHUGHULIKII kipengele cha desimali (d64/d32) kwa makusudi
// (hakuna sababu ya kuipanua njia hiyo maalum -- += ni nadra kwa
// desimali kwenye vitanzi vizito ikilinganishwa na ugawaji wa
// kawaida ulioandikwa kwa mkono, angalia jaribio_kiwanja_mpya_*
// kwa njia (2) mpya inayoshughulikia desimali). Jaribio hili la
// kudumu linathibitisha njia ya asili (isiyoboreshwa) bado inafanya
// kazi sahihi kwa kesi hii ya +=, kuzuia urudiaji ikiwa ukaguzi wa
// ni_desimali_enc utaondolewa kimakosa kwenye njia (1) siku moja.
// Thamani halisi: 5.0 + 2.5 = 7.5, * 10 = 75.
husisha { msingi/maktaba/kumbukumbu.swa }

n32 main() {
    d64* c = tenga(ukubwa(d64) * 10);
    n32 i = 2;
    c[i] = 5.0;
    c[i] += 2.5;
    n32 r = c[i] * 10.0;
    rudisha r;
}
