// Njia ya haraka ya ugawaji wa kiwanja HAISHUGHULIKII kipengele cha
// desimali (d64/d32) kwa makusudi -- jaribio hili la kudumu
// linathibitisha njia ya asili (isiyoboreshwa) bado inafanya kazi
// sahihi kwa kesi hii, kuzuia urudiaji ikiwa ukaguzi wa ni_desimali_enc
// utaondolewa kimakosa siku moja. Thamani halisi: 5.0 + 2.5 = 7.5,
// * 10 = 75.
husisha { msingi/maktaba/kumbukumbu.swa }

n32 main() {
    d64* c = tenga(ukubwa(d64) * 10);
    n32 i = 2;
    c[i] = 5.0;
    c[i] += 2.5;
    n32 r = c[i] * 10.0;
    rudisha r;
}
