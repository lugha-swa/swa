// LICM: kesi chanya ya msingi -- "a * b" ni usemi usiobadilika (a,b
// hazibadilishwi popote ndani ya mwili) unaotumika kama RHS kamili ya
// taarifa ya ugawaji ndani ya kitanzi. Lazima ihamishwe nje ya
// kitanzi na bado itoe matokeo sahihi: a*b=12, mzunguko 20 ->
// sum=240.
N32 main() {
    N32 a = 3;
    N32 b = 4;
    N32 sum = 0;
    N32 i = 0;
    wakati (i < 20) {
        sum = sum + (a * b);
        i = i + 1;
    }
    rudisha sum;
}
