// jaribio_husisha_hu.swa — mistari inayoanza na "hu" haifutwi kamwe;
// maelekezo KAMILI ya husisha ndiyo pekee yanayoondolewa.
// Mende: mstakaji wa maelekezo ulilinganisha kiambishi "hu" badala ya
// neno "husisha" — mstari wowote unaoanza na "hu" ulifutwa kimya.
husisha C::stdio
n32 huru = 0;
n32 huu = 0;

n32 main() {
huru = 42;
huu = 7;
    // huu ni maelezo — maoni yenye "huu" mwanzoni mwa maudhui yake
    kama (huru != 42) rudisha 1;
    kama (huu != 7) rudisha 2;
    rudisha 0;
}
