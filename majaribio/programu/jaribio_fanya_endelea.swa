// endelea ndani ya fanya inaruka hadi SHARTI (semantiki ya C ya
// do-while): taarifa zilizobaki za maudhui zinarukwa kwenye mwendo
// huo, na sharti linajaribiwa upya. Hapa endelea ndiyo taarifa
// ya MWISHO ya maudhui (i < 3) -- bila kuruka, s ingekuwa 4.
// Kamili pekee: awali bado haijui neno la fanya.
n32 anza() {
    n32 s = 0;
    n32 i = 0;
    fanya {
        i = i + 1;
        kama (i < 3) { endelea; }
        s = s + 1;
    } wakati (i < 4);
    rudisha s;
}
