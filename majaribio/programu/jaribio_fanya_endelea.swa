// endelea ndani ya fanya inaruka hadi SHARTI (semantiki ya C ya
// do-while): taarifa zilizobaki za mwili zinarukwa kwenye mwendo
// huo, na sharti linajaribiwa upya. Hapa endelea ndiyo taarifa
// ya MWISHO ya mwili (i < 3) — bila kuruka, s ingekuwa 4.
// Stage1 pekee: mbegu bado haijui neno la fanya.
n32 main() {
    n32 s = 0;
    n32 i = 0;
    fanya {
        i = i + 1;
        kama (i < 3) { endelea; }
        s = s + 1;
    } wakati (i < 4);
    rudisha s;
}
