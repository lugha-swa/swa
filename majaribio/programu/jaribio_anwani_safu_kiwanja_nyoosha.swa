// Njia ya haraka ya ugawaji wa kiwanja kwenye kielekezi cha nyoosha
// tu (*p += x / -= x, si safu iliyofahirishwa) -- tawi la pili
// lililobadilishwa na rekebisho hili, linahitaji jaribio lake
// mwenyewe kwa kuwa hesabu ya anwani ni tofauti (hakuna fahirisi*
// saizi). Thamani halisi: 10 + 5 - 2 = 13.
husisha { msingi/maktaba/kumbukumbu.swa }

n32 main() {
    n32* p = tenga(ukubwa(n32));
    *p = 10;
    *p += 5;
    *p -= 2;
    rudisha *p;
}
