// Sawa na jaribio_kwa_tangazo_ndani_ya_hali.swa, lakini vitanzi VIWILI
// vya "kwa" vilivyopachikwa, VYOTE VIWILI vikiwa na tangazo la ndani
// (i na j) -- uthibitisho kwamba kupachika hakusababishi kigezo cha
// ndani (i) "kupotea" au kubadilika kimakosa wakati kitanzi cha ndani
// (j) kinachangua wigo wake chenyewe. Stage1 pekee.
n32 main() {
    n32 jumla = 0;
    kwa (n32 i = 0; i < 3; i = i + 1) {
        kwa (n32 j = 0; j < 4; j = j + 1) {
            jumla = jumla + i * 10 + j;
        }
    }
    rudisha jumla;
}
