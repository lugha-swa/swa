// Sawa na jaribio_kwa_tangazo_ndani_ya_hali.swa, lakini mizunguko miwili
// ya "kwa" iliyopachikwa, YOTE MIWILI ikiwa na tangazo la ndani
// (i na j) -- uthibitisho kwamba kupachika hakusababishi kigezo cha
// ndani (i) "kupotea" au kubadilika kimakosa wakati mzunguko wa ndani
// (j) kinachangua wigo wake chenyewe. Kamili pekee.
n32 anza() {
    n32 jumla = 0;
    kwa (n32 i = 0; i < 3; i = i + 1) {
        kwa (n32 j = 0; j < 4; j = j + 1) {
            jumla = jumla + i * 10 + j;
        }
    }
    rudisha jumla;
}
