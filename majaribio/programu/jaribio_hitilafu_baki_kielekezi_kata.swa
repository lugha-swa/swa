// jaribio_hitilafu_baki_kielekezi_kata.swa -- kielekezi % namba
// kinakataliwa kwa sauti: % si hesabu ya anwani (jumlisha na toa
// ndizo pekee, rekodi 8.9); zamani modulo ya anwani yenyewe
// ilipigwa kimya. kamili pekee: awali bado inakubali -- rejesha
// baada ya kugandishwa kwa awali mpya.
n32 anza() {
    n32 a[4];
    n32* p = a;
    n32 x = p % 4;
    rudisha x;
}
