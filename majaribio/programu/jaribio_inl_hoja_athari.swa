// inl_hoja_athari: hoja yenye athari ya kando (kuongeza kihesabu cha
// ulimwengu) LAZIMA itathminiwe MARA MOJA TU wakati kazi inayoitwa
// inaunganishwa. Kama usukaji ungeigiza usemi wa hoja moja kwa moja
// (badala ya kuutathmini kwenye tangazo la muda mara moja), kihesabu
// kingeongezeka zaidi ya mara moja -- kosa la kawaida la "double
// evaluation" katika upanuzi wa kazi ndogo.
N32 kihesabu;

N32 ongeza_kihesabu() {
    kihesabu = kihesabu + 1;
    rudisha kihesabu;
}

W0 hifadhi(N32* mahali, N32 x) {
    *mahali = x;
}

N32 main() {
    kihesabu = 0;
    N32 matokeo;
    hifadhi(&matokeo, ongeza_kihesabu());
    kama (kihesabu != 1) { rudisha 1; }
    kama (matokeo != 1) { rudisha 2; }
    rudisha 0;
}
