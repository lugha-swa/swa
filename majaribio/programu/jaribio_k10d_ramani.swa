w0 nakili(n8* lengwa, n8* chanzo, n64 n) {
    n64 i = 0;
    wakati (i < n) {
        lengwa[i] = chanzo[i];
        i = i + 1;
    }
}

w0 weka_sifuri(n8* lengwa, n64 n) {
    n64 i = 0;
    wakati (i < n) {
        lengwa[i] = 0;
        i = i + 1;
    }
}

n32 linganisha_kumbukumbu(n8* a, n8* b, n64 n) {
    n64 i = 0;
    wakati (i < n) {
        kama (a[i] < b[i]) {
            rudisha -1;
        }
        kama (a[i] > b[i]) {
            rudisha 1;
        }
        i = i + 1;
    }
    rudisha 0;
}

// ==========================================================
// Runtime ya syscalls -- maktaba haihitaji libc tena
// ==========================================================

// Wito wa mfumo wa Linux -- kazi asili ya mzalishaji (uzalishaji_wito)
// na kiolesura cha C kwa awali. Haina tangazo la .swa: kila mkaguzi
// (wa awali na wa kamili) hujenga saini kutoka hoja halisi za wito.

n64 mfumo_soma(n32 faili, n8* chombo, n64 urefu) {
    rudisha wito_wa_mfumo(0, faili, chombo, urefu, 0, 0, 0);
}

n64 mfumo_andika(n32 faili, n8* chombo, n64 urefu) {
    rudisha wito_wa_mfumo(1, faili, chombo, urefu, 0, 0, 0);
}

n64 mfumo_fungua(n8* njia, n64 machaguo) {
    rudisha wito_wa_mfumo(2, njia, machaguo, 0, 0, 0, 0);
}

n64 mfumo_funga(n32 faili) {
    rudisha wito_wa_mfumo(3, faili, 0, 0, 0, 0, 0);
}

n64 mfumo_ramani_kumbukumbu(n8* anwani, n64 urefu, n64 ulinzi, n64 machaguo, n64 faili) {
    rudisha wito_wa_mfumo(9, anwani, urefu, ulinzi, machaguo, faili, 0);
}

n64 mfumo_ondoa_ramani_kumbukumbu(n8* anwani, n64 urefu) {
    rudisha wito_wa_mfumo(11, anwani, urefu, 0, 0, 0, 0);
}

// ==========================================================
// Uchapishaji -- andika_n64 / andika_mfuatano / andika_baiti
// Hizi ndizo kazi zinazoitwa na kazi asili ya andika katika mzalishaji.
// ==========================================================

w0 andika_n64(n32 faili, n64 v) {
    // Chombo cha n32, si n8 -- awali hutoa maandishi ya safu ya n8
    // kwa mizani ya baiti 4, hivyo tumia n32 na uchapishe tarakimu
    // moja kwa moja kupitia andika_herufi.
    n32 chombo[32];
    n32 n = 0;
    kama (v < 0) {
        andika_herufi(faili, 45);  // '-'
        v = 0 - v;
    }
    wakati (1 == 1) {
        chombo[n] = v - ((v / 10) * 10);
        n = n + 1;
        v = v / 10;
        kama (v == 0) { acha; }
    }
    // Chapisha tarakimu kwa mpangilio wa nyuma
    wakati (n > 0) {
        n = n - 1;
        andika_herufi(faili, 48 + chombo[n]);
    }
}

w0 andika_mfuatano(n32 faili, n8* s) {
    // Urefu wa mfuatano unahesabiwa hapa -- kumbukumbu.swa
    // haitegemei mfuatano.swa (jaribio la k10a linahusisha peke yake).
    n64 u = 0;
    wakati (s[u] != 0) {
        u = u + 1;
    }
    mfumo_andika(faili, s, u);
}

w0 andika_herufi(n32 faili, n64 b) {
    n8 bb = b;
    mfumo_andika(faili, &bb, 1);
}

w0 andika_sehemu(n32 faili, n8* s, n64 urefu) {
    mfumo_andika(faili, s, urefu);
}

// ==========================================================
// andika / andika_kosa -- utekelezaji wa ndani wa muundo
// (kwa awali: wito za nje hujitatua hapa; uzalishaji wa Swa ni kazi asili)
// Muundo ni mfuatano PAMOJA na nukuu, viashiria: %d, %s, %c, \n.
// ==========================================================

// Kielekezi kutoka hoja ya n64: mkia wa andika (a1..a6) hupita kwa
// rejesta za n64 kwa ABI, iwe thamani au kielekezi. %s huhitaji
// kielekezi -- ubadilishaji wazi (ukaguzi wa hoja unakataa n64 kwa
// kigezo cha n8* tangu 2026-09-01).
n8* kielekezi_kutoka_hoja(n64 v) {
    n8* p = v;
    rudisha p;
}

w0 andika_ndani(n32 faili, n8* f, n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6) {
    n32 p = 0;  // mfuatano hauna nukuu (kumbukumbu hutoa bila nukuu)
    n32 na = 0;  // faharisi ya hoja inayofuata
    wakati (1 == 1) {
        kama (f[p] == 0) { acha; }  // mwisho wa mfuatano (sifuri kimalizio)
        kama (f[p] == 37) {  // '%'
            n8 juu_ya_mrundikano = f[p + 1];
            p = p + 2;
            kama (juu_ya_mrundikano == 100) {  // %d
                kama (na == 0) { andika_n64(faili, a1); } sivyo { kama (na == 1) { andika_n64(faili, a2); }
                    sivyo { kama (na == 2) { andika_n64(faili, a3); } sivyo { kama (na == 3) { andika_n64(faili, a4); }
                            sivyo { kama (na == 4) { andika_n64(faili, a5); } sivyo { andika_n64(faili, a6); } } } } }
                na = na + 1;
            } sivyo { kama (juu_ya_mrundikano == 115) {  // %s
                    kama (na == 0) { andika_mfuatano(faili, kielekezi_kutoka_hoja(a1)); } sivyo { kama (na == 1) { andika_mfuatano(faili, kielekezi_kutoka_hoja(a2)); }
                        sivyo { kama (na == 2) { andika_mfuatano(faili, kielekezi_kutoka_hoja(a3)); } sivyo { kama (na == 3) { andika_mfuatano(faili, kielekezi_kutoka_hoja(a4)); }
                                sivyo { kama (na == 4) { andika_mfuatano(faili, kielekezi_kutoka_hoja(a5)); } sivyo { andika_mfuatano(faili, kielekezi_kutoka_hoja(a6)); } } } } }
                    na = na + 1;
                } sivyo { kama (juu_ya_mrundikano == 99) {  // %c
                        kama (na == 0) { andika_herufi(faili, a1); } sivyo { kama (na == 1) { andika_herufi(faili, a2); }
                            sivyo { kama (na == 2) { andika_herufi(faili, a3); } sivyo { kama (na == 3) { andika_herufi(faili, a4); }
                                    sivyo { kama (na == 4) { andika_herufi(faili, a5); } sivyo { andika_herufi(faili, a6); } } } } }
                        na = na + 1;
                    } } }
            endelea;
        }
        kama (f[p] == 92 && f[p + 1] == 110) {  // \n
            andika_herufi(faili, 10);
            p = p + 2;
            endelea;
        }
        andika_herufi(faili, f[p]);
        p = p + 1;
    }
}

n32 andika(n8* f, n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6) {
    andika_ndani(1, f, a1, a2, a3, a4, a5, a6);
    rudisha 0;
}

n32 andika_kosa(n8* f, n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6) {
    andika_ndani(2, f, a1, a2, a3, a4, a5, a6);
    rudisha 0;
}

// ukubwa -- kwa awali (uzalishaji wa Swa huikokotoa wakati wa kukusanya)
n64 ukubwa(n32 aina) {
    kama (aina == 1) { rudisha 1; }
    kama (aina == 2) { rudisha 2; }
    kama (aina == 3) { rudisha 4; }
    kama (aina == 4) { rudisha 8; }
    rudisha 8;
}

// ==========================================================
// Eneo la utengaji -- badala ya malloc/realloc/free
// ==========================================================
n8* anwani_ya_eneo_la_utengaji = 0;
n64 nafasi_ndani_ya_eneo_la_utengaji = 0;

n8* tenga(n64 ukubwa) {
    kama (anwani_ya_eneo_la_utengaji == 0) {
        // Anwani sifuri = "popote" (kama mmap(NULL, ...) ya C).
        // Halisi 0 kwa kigezo cha kielekezi inakataliwa na ukaguzi
        // wa 2026-09-01 -- tumia kielekezi cha sifuri wazi.
        n8* anwani_sifuri = 0;
        anwani_ya_eneo_la_utengaji = mfumo_ramani_kumbukumbu(anwani_sifuri, 1048576, 3, 34, 0 - 1);
        kama (anwani_ya_eneo_la_utengaji == 0 - 1) { rudisha 0; }
    }
    kama (ukubwa == 0) { ukubwa = 8; }
    ukubwa = ukubwa + 8;  // nafasi ya ukubwa wa kipande (kwa badili)
    kama (nafasi_ndani_ya_eneo_la_utengaji + ukubwa > 1048576) { rudisha 0; }
    n8* r = anwani_ya_eneo_la_utengaji + nafasi_ndani_ya_eneo_la_utengaji;
    // hifadhi ukubwa mbele ya kipande (baiti 8)
    n8* h = &ukubwa;
    n32 bi = 0;
    wakati (bi < 8) {
        r[bi] = h[bi];
        bi = bi + 1;
    }
    nafasi_ndani_ya_eneo_la_utengaji = nafasi_ndani_ya_eneo_la_utengaji + ukubwa;
    rudisha r + 8;
}

w0 achilia_eneo_la_utengaji(n8* p) {
    // Eneo la utengaji haliwezi kufungua vipande -- hakuna kitu
}

n8* badili(n8* p, n64 ukubwa) {
    kama (p == 0) { rudisha tenga(ukubwa); }
    kama (ukubwa == 0) { rudisha p; }
    // soma ukubwa wa zamani kutoka utangulizi wa kipande
    n64 zamani = 0;
    n8* h2 = &zamani;
    n32 bi2 = 0;
    wakati (bi2 < 8) {
        h2[bi2] = p[bi2 - 8];
        bi2 = bi2 + 1;
    }
    n8* r = tenga(ukubwa);
    kama (r == 0) { rudisha 0; }
    n64 nakili_urefu = zamani;
    kama (ukubwa < zamani) { nakili_urefu = ukubwa; }
    nakili(r, p, nakili_urefu);
    rudisha r;
}

// ==========================================================
// Usomaji wa desimali halisi -- badala ya strtod (libc)
// biti_ya_d64_swa: mfuatano [-]z.z -> baiti za d64 (IEEE 754)
// (majina ya kigeu hayawezi kuwa herufi za aina: N A B D W)
// Kikomo cha sasa: tarakimu za kasoro <= 10 kwa thamani < 2^26,
// <= 3 kwa thamani kubwa zaidi (vinginevyo hesabu*2^hamisha
// inaweza kuzidi baiti 64).
// ==========================================================

n64 p2_kwa(n32 kubwa) {
    n64 thamani = 1;
    n32 fasi = 0;
    wakati (fasi < kubwa) {
        thamani = thamani * 2;
        fasi = fasi + 1;
    }
    rudisha thamani;
}

// KUMBUKA: biti_ya_d64_swa imegawanywa katika kazi mbili kwa sababu
// awali ilikusanya vibaya kazi ndefu sana (FPE) -- sehemu ndogo
// zinakusanywa kwa usahihi. API haijabadilika.
n64 biti_ya_d64_swa(n8* herufi, n32 u) {
    n64 alama = 0;
    n32 fasi = 0;
    kama (herufi[fasi] == 45) { alama = 1; fasi = fasi + 1; }
    n64 nzima = 0;
    wakati (fasi < u && herufi[fasi] != 46) {
        nzima = nzima * 10 + (herufi[fasi] - 48);
        fasi = fasi + 1;
    }
    n64 kasoro = 0;
    n64 idadi_k = 0;
    kama (fasi < u && herufi[fasi] == 46) {
        fasi = fasi + 1;
        wakati (fasi < u) {
            kasoro = kasoro * 10 + (herufi[fasi] - 48);
            idadi_k = idadi_k + 1;
            fasi = fasi + 1;
        }
    }
    // nene = 10^idadi_k
    n64 nene = 1;
    n32 kihesabu = 0;
    wakati (kihesabu < idadi_k) { nene = nene * 10; kihesabu = kihesabu + 1; }
    // hesabu = nzima * nene + kasoro  (thamani = hesabu / nene)
    n64 hesabu = nzima * nene + kasoro;
    kama (hesabu == 0) { rudisha 0; }

    // kizio: kubwa zaidi kama 2^kizio <= hesabu/nene < 2^(kizio+1)
    n64 urefu_juu = 0; n64 muda = hesabu;
    wakati (muda > 0) { muda = muda / 2; urefu_juu = urefu_juu + 1; }
    n64 urefu_chini = 0; muda = nene;
    wakati (muda > 0) { muda = muda / 2; urefu_chini = urefu_chini + 1; }
    n64 kizio = urefu_juu - urefu_chini;
    kama (kizio >= 0) {
        // kurekebisha chini: kama hesabu/nene < 2^kizio, punguza
        n64 p2m = p2_kwa(kizio);
        kama (hesabu < nene * p2m) { kizio = kizio - 1; }
    } sivyo {
        // kizio hasi (v < 1): linganisha hesabu * 2^m < nene, m = -kizio
        n64 m = 0 - kizio;
        n64 q = 1;
        n32 mf = 0;
        wakati (mf < m) { q = q * 2; mf = mf + 1; }
        kama (hesabu * q < nene) { kizio = kizio - 1; }
    }
    // Kuinua hesabu hadi [nene, 2*nene) -- hesabu/nene sasa ni
    // 2^(kizio+d); kizio yenyewe inabaki kielelezo cha thamani asilia.
    n64 d = 0;
    wakati (hesabu < nene) {
        hesabu = hesabu * 2;
        d = d + 1;
    }

    // pacha = (hesabu/nene - 2^(kizio+d)) * 2^(52-kizio-d)
    //       = hesabu * 2^(52-kizio-d) / nene - 2^52
    rudisha kamilisha_biti_swa(hesabu, nene, kizio, d, alama);
}

n64 kamilisha_biti_swa(n64 hesabu, n64 nene, n64 kizio, n64 d, n64 alama) {
    n64 hamisha = 52 - (kizio + d);
    kama (hamisha < 0) { hamisha = 0; }
    kama (hamisha > 52) { hamisha = 52; }
    n64 p52 = p2_kwa(52);
    n64 pacha = 0;
    kama (hamisha <= 26) {
        n64 p2s = p2_kwa(hamisha);
        pacha = (hesabu * p2s) / nene - p52;
    } sivyo {
        n64 p2a = p2_kwa(26);
        n64 p2b = p2_kwa(hamisha - 26);
        n64 hi = (hesabu * p2a) / nene;
        n64 salio = hesabu * p2a - hi * nene;
        pacha = hi * p2b + (salio * p2b) / nene - p52;
    }
    n64 p63 = p2_kwa(63);
    n64 biti = 0;
    kama (alama == 1) { biti = biti + p63; }
    biti = biti + (kizio + 1023) * p52;
    biti = biti + (pacha - (pacha / p52) * p52);
    rudisha biti;
}

// soma_mstari -- soma mstari mmoja kutoka faili hadi chombo.
// Inasimama kwa '\n' (isiyojumuishwa) au EOF. Rudisha idadi ya
// baiti zilizosomwa, au -1 ikiwa EOF mara moja bila baiti.
n64 soma_mstari(n32 faili, n8* chombo, n64 upeo) {
    n64 n = 0;
    wakati (n + 1 < upeo) {
        n8 herufi = 0;
        n64 r = mfumo_soma(faili, &herufi, 1);
        kama (r <= 0) {
            kama (n == 0) {
                rudisha -1;
            }
            rudisha n;
        }
        kama (herufi == 10) {
            rudisha n;
        }
        chombo[n] = herufi;
        n = n + 1;
    }
    rudisha n;
}
husisha { kumbukumbu.swa }

muundo Ramani {
    n32* funguo;
    n32* thamani;
    n32 uwezo;
    n32 idadi;
};

Ramani* ramani_mpya(n32 uwezo) {
    Ramani* r = tenga(ukubwa(Ramani));
    r->funguo = tenga(ukubwa(n32) * uwezo);
    r->thamani = tenga(ukubwa(n32) * uwezo);
    r->uwezo = uwezo;
    r->idadi = 0;
    n32 i = 0;
    wakati (i < uwezo) {
        r->funguo[i] = -1;
        i = i + 1;
    }
    rudisha r;
}

w0 ramani_weka(Ramani* r, n32 funguo, n32 thamani) {
    kama (r->idadi >= r->uwezo) {
        rudisha;
    }
    n32 faharasa = funguo % r->uwezo;
    n32 alama_ya_kufutwa = -1;
    n32 hatua = 0;
    wakati (hatua < r->uwezo) {
        kama (r->funguo[faharasa] == funguo) {
            r->thamani[faharasa] = thamani;
            rudisha;
        }
        kama (r->funguo[faharasa] == -2 && alama_ya_kufutwa == -1) {
            alama_ya_kufutwa = faharasa;
        }
        kama (r->funguo[faharasa] == -1) {
            kama (alama_ya_kufutwa != -1) {
                faharasa = alama_ya_kufutwa;
            }
            r->funguo[faharasa] = funguo;
            r->thamani[faharasa] = thamani;
            r->idadi = r->idadi + 1;
            rudisha;
        }
        faharasa = (faharasa + 1) % r->uwezo;
        hatua = hatua + 1;
    }
    kama (alama_ya_kufutwa != -1) {
        r->funguo[alama_ya_kufutwa] = funguo;
        r->thamani[alama_ya_kufutwa] = thamani;
        r->idadi = r->idadi + 1;
    }
}

n32 ramani_pata(Ramani* r, n32 funguo) {
    n32 faharasa = funguo % r->uwezo;
    n32 hatua = 0;
    wakati (hatua < r->uwezo) {
        kama (r->funguo[faharasa] == funguo) {
            rudisha r->thamani[faharasa];
        }
        kama (r->funguo[faharasa] == -1) {
            rudisha -1;
        }
        faharasa = (faharasa + 1) % r->uwezo;
        hatua = hatua + 1;
    }
    rudisha -1;
}

n32 ramani_ina(Ramani* r, n32 funguo) {
    n32 faharasa = funguo % r->uwezo;
    n32 hatua = 0;
    wakati (hatua < r->uwezo) {
        kama (r->funguo[faharasa] == funguo) {
            rudisha 1;
        }
        kama (r->funguo[faharasa] == -1) {
            rudisha 0;
        }
        faharasa = (faharasa + 1) % r->uwezo;
        hatua = hatua + 1;
    }
    rudisha 0;
}

w0 ramani_futa(Ramani* r, n32 funguo) {
    n32 faharasa = funguo % r->uwezo;
    n32 hatua = 0;
    wakati (hatua < r->uwezo) {
        kama (r->funguo[faharasa] == funguo) {
            r->funguo[faharasa] = -2;
            r->idadi = r->idadi - 1;
            rudisha;
        }
        kama (r->funguo[faharasa] == -1) {
            rudisha;
        }
        faharasa = (faharasa + 1) % r->uwezo;
        hatua = hatua + 1;
    }
}

w0 ramani_huru(Ramani* r) {
    achilia_eneo_la_utengaji(r->funguo);
    achilia_eneo_la_utengaji(r->thamani);
    achilia_eneo_la_utengaji(r);
}

n32 anza() {
    Ramani* r = ramani_mpya(16);

    // Weka thamani
    ramani_weka(r, 5, 100);
    ramani_weka(r, 10, 200);
    ramani_weka(r, 20, 300);

    // Pata thamani zilizowekwa
    kama (ramani_pata(r, 5) != 100) rudisha 4;
    kama (ramani_pata(r, 10) != 200) rudisha 5;
    kama (ramani_pata(r, 20) != 300) rudisha 6;

    // Pata thamani isiyokuwepo
    kama (ramani_pata(r, 99) != -1) rudisha 7;

    // Angalia kuwepo
    kama (ramani_ina(r, 5) != 1) rudisha 8;
    kama (ramani_ina(r, 10) != 1) rudisha 9;
    kama (ramani_ina(r, 99) != 0) rudisha 10;

    // Badilisha thamani iliyopo
    ramani_weka(r, 5, 999);
    kama (ramani_pata(r, 5) != 999) rudisha 12;

    // Futa funguo
    ramani_futa(r, 10);
    kama (ramani_ina(r, 10) != 0) rudisha 13;
    kama (ramani_ina(r, 5) != 1) rudisha 14;

    ramani_huru(r);
    rudisha 0;
}
