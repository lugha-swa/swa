// KATA: jina lile lile la kigeu likitangazwa kwa aina tofauti ndani ya
// kazi moja (hapa `r` ni n32 kwenye ubeti mmoja na n64 kwenye ubeti
// jirani) lazima likataliwe kwa sauti. Zamani lilipata sloti ile ile ya
// baiti 4: maandishi ya baiti 8 ya n64 yaliharibu kigeu kilicho jirani
// (`a` ilisomeka 0 badala ya 6) bila onyo lolote. Vigeu vitatu vya
// mwanzo vinahitajika ili sloti ziwe jirani kwenye mrundikano.
n64 mr[64];
n64 mr_juu = 0;
w0 sukuma(n64 v) { mr[mr_juu] = v; mr_juu = mr_juu + 1; }
n64 vuta() { mr_juu = mr_juu - 1; rudisha mr[mr_juu]; }
n64 f(n32 op) {
    n64 v0 = 0;
    n64 v1 = 1;
    n64 v2 = 2;
    kama (op == 1) {
        n64 b = vuta(); n64 a = vuta(); n32 r = 0;
        r = a == b;
        rudisha r;
    }
    kama (op == 2) {
        n64 b = vuta(); n64 a = vuta(); n64 r = 0;
        r = a * b;
        rudisha r;
    }
    rudisha v0 + v1 + v2;
}
n32 anza() {
    sukuma(6); sukuma(7);
    rudisha f(2);
}
