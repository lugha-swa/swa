// Ugawaji wa rejesta, awamu ya 2 (paramu) -- paramu ya rejesta ya
// kudumu inayosomwa mara nyingi ndani ya kitanzi lazima ibaki sahihi
// kila mara (thamani halisi imekokotolewa kwa mkono: 7*10=70).
n32 jaribu(n32 x) {
    n32 jumla = 0;
    n32 i = 0;
    wakati (i < 10) {
        jumla = jumla + x;
        i = i + 1;
    }
    rudisha jumla;
}

n32 main() {
    rudisha jaribu(7);
}
