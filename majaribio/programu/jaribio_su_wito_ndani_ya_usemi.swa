// Jaribio la kuzuia urudiaji la mdudu HALISI uliogunduliwa wakati wa
// ujenzi wa ugawaji wa rejesta wa vigezo vya muda vya usemi (Sethi-
// Ullman, angalia maelezo katika uzalishaji.swa karibu na
// su_ni_kushughulikiwa -- kipengele hiki kimezimwa kwa sasa, lakini
// jaribio hili bado linathibitisha tabia SAHIHI kupitia njia ya asili,
// na litaendelea kuthibitisha usahihi endapo kipengele kitawashwa
// tena siku moja): "(a+b) * kazi(c+d)" -- hoja ya wito (c+d) ilikuwa
// ikisababisha uharibifu wa kimya wa rejesta ikiwa mzazi (a+b)
// alishikilia matokeo yake kwenye rejesta wakati hoja hiyo
// ikitathminiwa. Thamani halisi: a+b=3, c+d=7, kazi(7)=14, 3*14=42.
husisha { msingi/maktaba/kumbukumbu.swa }

n32 kazi(n32 x) {
    rudisha x * 2;
}

n32 main() {
    n32 a = 1;
    n32 b = 2;
    n32 c = 3;
    n32 d = 4;
    n32 r = (a + b) * kazi(c + d);
    rudisha r;
}
