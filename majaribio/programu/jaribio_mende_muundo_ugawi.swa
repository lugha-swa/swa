// jaribio_mende_muundo_ugawi: ugawi wa muundo mzima b = a — chanzo
// cha nakili lazima kiwe ANWANI ya a (lea), si thamani yake kama
// anwani (iliyokuwa SEGV au takataka).
// Inatarajiwa: 17 (8 + 9)
muundo Nukta { n32 x; n32 y; };

n32 main() {
    Nukta a;
    a.x = 8;
    a.y = 9;
    Nukta b;
    b = a;
    rudisha b.x + b.y;
}
