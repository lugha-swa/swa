// SSCSE -- kesi hasi MUHIMU: "a*b" hutokea mara mbili, lakini "a"
// inabadilishwa (reassignment) KATI ya tokeo la kwanza na la pili --
// CSE LAZIMA ISITUMIE TENA thamani ya zamani ya "a*b" (42), bali
// ikokotoe upya kwa thamani MPYA ya a (99). Kama upatikanaji (kill)
// haukufanya kazi, y ingekuwa 42-1=41 (SIVYO SAHIHI); jibu sahihi ni
// 99*7-1=692.
n32 main() {
    n32 a = 6;
    n32 b = 7;
    n32 c = 100;
    n32 d = 1;
    n32 x = a * b + c;
    a = 99;
    n32 y = a * b - d;
    kama (x != 142) { rudisha 1; }
    kama (y != 692) { rudisha 2; }
    rudisha 0;
}
