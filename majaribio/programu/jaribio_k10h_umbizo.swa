w0 nakili(n8* lengwa, n8* chanzo, n64 n) {
    n64 i = 0;
    wakati (i < n) {
        lengwa[i] = chanzo[i];
        i = i + 1;
    }
}

w0 weka_sifuri(n8* lengwa, n64 n) {
    n64 i = 0;
    wakati (i < n) {
        lengwa[i] = 0;
        i = i + 1;
    }
}

n32 linganisha_kumbukumbu(n8* a, n8* b, n64 n) {
    n64 i = 0;
    wakati (i < n) {
        kama (a[i] < b[i]) {
            rudisha -1;
        }
        kama (a[i] > b[i]) {
            rudisha 1;
        }
        i = i + 1;
    }
    rudisha 0;
}

// ==========================================================
// Runtime ya syscalls — maktaba haihitaji libc tena
// ==========================================================

// Wito wa mfumo wa Linux — builtin ya mzalishaji (uzalishaji_wito)
// na daraja la C kwa mbegu. Haina tangazo la .swa: kila mkaguzi
// (wa Swa na wa Rust) hujenga saini kutoka hoja halisi za wito.

n64 sys_soma(n32 faili, n8* bafa, n64 urefu) {
    rudisha wito_wa_mfumo(0, faili, bafa, urefu, 0, 0, 0);
}

n64 sys_andika(n32 faili, n8* bafa, n64 urefu) {
    rudisha wito_wa_mfumo(1, faili, bafa, urefu, 0, 0, 0);
}

n64 sys_fungua(n8* njia, n64 bendera, n64 ruhusa) {
    // Hoja ya 3 (hali) ni ruhusa za faili linaloundwa (mode) — kernel
    // inaitumia tu wakati O_CREAT iko kwenye bendera, vinginevyo
    // inapuuzwa. Awali ilipitishwa kama 0, hivyo faili zilizoundwa
    // na O_CREAT zilipata ruhusa 0000 (hazikufunguka kwa usomaji).
    rudisha wito_wa_mfumo(2, njia, bendera, ruhusa, 0, 0, 0);
}

n64 sys_funga(n32 faili) {
    rudisha wito_wa_mfumo(3, faili, 0, 0, 0, 0, 0);
}

n64 sys_mmap(n8* anwani, n64 urefu, n64 ulinzi, n64 bendera, n64 faili) {
    rudisha wito_wa_mfumo(9, anwani, urefu, ulinzi, bendera, faili, 0);
}

n64 sys_munmap(n8* anwani, n64 urefu) {
    rudisha wito_wa_mfumo(11, anwani, urefu, 0, 0, 0, 0);
}

// ==========================================================
// Uchapishaji — andika_n64 / andika_mfuatano / andika_baiti
// Hizi ndizo kazi zinazoitwa na builtin ya andika katika mzalishaji.
// ==========================================================

w0 andika_n64(n32 faili, n64 v) {
    // Bafa ya n32, si n8 — mbegu hutoa maandishi ya safu ya n8
    // kwa mizani ya baiti 4, hivyo tumia n32 na uchapishe tarakimu
    // moja kwa moja kupitia andika_herufi.
    n32 bafa[32];
    n32 n = 0;
    kama (v < 0) {
        andika_herufi(faili, 45);  // '-'
        v = 0 - v;
    }
    wakati (1 == 1) {
        bafa[n] = v - ((v / 10) * 10);
        n = n + 1;
        v = v / 10;
        kama (v == 0) { vunja; }
    }
    // Chapisha tarakimu kwa mpangilio wa nyuma
    wakati (n > 0) {
        n = n - 1;
        andika_herufi(faili, 48 + bafa[n]);
    }
}

w0 andika_mfuatano(n32 faili, n8* s) {
    // Urefu wa mfuatano unahesabiwa hapa — kumbukumbu.swa
    // haitegemei mfuatano.swa (jaribio la k10a linahusisha peke yake).
    n64 u = 0;
    wakati (s[u] != 0) {
        u = u + 1;
    }
    sys_andika(faili, s, u);
}

w0 andika_herufi(n32 faili, n64 b) {
    n8 bb = b;
    sys_andika(faili, &bb, 1);
}

w0 andika_sehemu(n32 faili, n8* s, n64 urefu) {
    sys_andika(faili, s, urefu);
}

// ==========================================================
// andika / andika_stderr — utekelezaji wa ndani wa muundo
// (kwa mbegu: wito za nje hujitatua hapa; codegen ya Swa ni builtin)
// Muundo ni mfuatano PAMOJA na nukuu.
//
// Viashiria vinavyotumika:
//   %d  — n64 yenye ishara (desimali, na alama ya kutoa ikihitajika)
//   %u  — n64 isiyo na ishara (desimali; thamani hasi inaonyeshwa
//         kama mfuatano kamili wa bits za baiti 64)
//   %x  — heksadesimali ndogo bila sifuri za mwanzo (42 → "2a");
//         thamani hasi inaonyeshwa kama bits zote 64
//   %s  — mfuatano unaoishia kwenye 0
//   %c  — herufi moja
//   %%  — alama ya % (haitumii hoja)
// Viashiria VISIVYOSAIDIWA (%f, %l, %n, n.k.) vinachapishwa kama
// herufi halisi ("%f" → "%f") — hakuna kinachomezwa, na havitumii
// hoja. Mnyororo wa Rust (andika = printf ya C) unasaidia vyote
// vya printf; tofauti hii kati ya minyororo imeandikwa kwenye
// hati/uthibitisho-wa-lugha.md.
// ==========================================================

// Chagua hoja ya na kati ya a1..a6. na zaidi ya 5 hurudisha a6
// (kama ilivyokuwa awali — hoja ya 7+ haiwezekani kwenye andika).
n64 hoja_kwa_na(n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6, n32 na) {
    kama (na == 0) { rudisha a1; }
    kama (na == 1) { rudisha a2; }
    kama (na == 2) { rudisha a3; }
    kama (na == 3) { rudisha a4; }
    kama (na == 4) { rudisha a5; }
    rudisha a6;
}

// andika_u64 — andika n64 kama nambari isiyo na ishara (desimali
// bila alama ya kutoa). Thamani hasi inaonyeshwa kama mfuatano
// kamili wa bits: -1 → 18446744073709551615.
w0 andika_u64(n32 faili, n64 v) {
    n32 bafa[32];
    n32 n = 0;
    wakati (1 == 1) {
        bafa[n] = v - ((v / 10) * 10);
        n = n + 1;
        v = v / 10;
        kama (v == 0) { vunja; }
    }
    wakati (n > 0) {
        n = n - 1;
        andika_herufi(faili, 48 + bafa[n]);
    }
}

// andika_heksa — andika n64 kwa heksadesimali ndogo bila sifuri
// za mwanzo. Thamani hasi inaonyeshwa kama bits zote 64.
w0 andika_heksa(n32 faili, n64 v) {
    n32 tarakimu[32];
    n32 n = 0;
    kama (v == 0) {
        andika_herufi(faili, 48);  // '0'
        rudisha;
    }
    wakati (v != 0) {
        n32 d = v - ((v / 16) * 16);
        kama (d < 10) { tarakimu[n] = 48 + d; }
        sivyo { tarakimu[n] = 87 + d; }  // 'a' = 97, 97 - 10 = 87
        n = n + 1;
        v = v / 16;
    }
    wakati (n > 0) {
        n = n - 1;
        andika_herufi(faili, tarakimu[n]);
    }
}

// Kielekezi kutoka hoja ya n64: mkia wa andika (a1..a6) hupita kwa
// rejesta za n64 kwa ABI, iwe thamani au kielekezi. %s huhitaji
// kielekezi — ubadilishaji wazi (ukaguzi wa hoja unakataa n64 kwa
// kigezo cha n8* tangu 2026-09-01).
n8* kielekezi_kutoka_hoja(n64 v) {
    n8* p = v;
    rudisha p;
}

w0 andika_ndani(n32 faili, n8* f, n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6) {
    n32 p = 0;  // mfuatano hauna nukuu (kumbukumbu hutoa bila nukuu)
    n32 na = 0;  // faharisi ya hoja inayofuata
    wakati (1 == 1) {
        kama (f[p] == 0) { vunja; }  // mwisho wa mfuatano (null terminator)
        kama (f[p] == 37) {  // '%'
            n8 sp = f[p + 1];
            kama (sp == 0) {  // '%' mwishoni mwa mfuatano — chapisha kama herufi
                andika_herufi(faili, 37);
                p = p + 1;
                endelea;
            }
            p = p + 2;
            kama (sp == 100) {  // %d
                andika_n64(faili, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                na = na + 1;
            } sivyo { kama (sp == 117) {  // %u
                    andika_u64(faili, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                    na = na + 1;
                } sivyo { kama (sp == 120) {  // %x
                        andika_heksa(faili, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                        na = na + 1;
                    } sivyo { kama (sp == 115) {  // %s
                            andika_mfuatano(faili, kielekezi_kutoka_hoja(hoja_kwa_na(a1, a2, a3, a4, a5, a6, na)));
                            na = na + 1;
                        } sivyo { kama (sp == 99) {  // %c
                                andika_herufi(faili, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                                na = na + 1;
                            } sivyo { kama (sp == 37) {  // %%
                                    andika_herufi(faili, 37);  // haina hoja
                                } sivyo {
                                    // Visivyosaidiwa (%f, %l, %n, ...) — chapisha
                                    // kama herufi halisi, bila kutumia hoja.
                                    andika_herufi(faili, 37);
                                    andika_herufi(faili, sp);
                                } } } } } }
            endelea;
        }
        kama (f[p] == 92 && f[p + 1] == 110) {  // \n
            andika_herufi(faili, 10);
            p = p + 2;
            endelea;
        }
        andika_herufi(faili, f[p]);
        p = p + 1;
    }
}

n32 andika(n8* f, n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6) {
    andika_ndani(1, f, a1, a2, a3, a4, a5, a6);
    rudisha 0;
}

n32 andika_stderr(n8* f, n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6) {
    andika_ndani(2, f, a1, a2, a3, a4, a5, a6);
    rudisha 0;
}

// ukubwa — kwa mbegu (codegen ya Swa huikokotoa wakati wa kukusanya)
n64 ukubwa(n32 aina) {
    kama (aina == 1) { rudisha 1; }
    kama (aina == 2) { rudisha 2; }
    kama (aina == 3) { rudisha 4; }
    kama (aina == 4) { rudisha 8; }
    rudisha 8;
}

// ==========================================================
// Arena ya kumbukumbu — badala ya malloc/realloc/free
// ==========================================================
n8* arena_anwani = 0;
n64 arena_nafasi = 0;

n8* tenga(n64 ukubwa) {
    kama (arena_anwani == 0) {
        // Anwani sifuri = "popote" (kama mmap(NULL, ...) ya C).
        // Halisi 0 kwa kigezo cha kielekezi inakataliwa na ukaguzi
        // wa 2026-09-01 — tumia kielekezi cha sifuri wazi.
        n8* anwani_sifuri = 0;
        arena_anwani = sys_mmap(anwani_sifuri, 1048576, 3, 34, 0 - 1);
        kama (arena_anwani == 0 - 1) { rudisha 0; }
    }
    kama (ukubwa == 0) { ukubwa = 8; }
    ukubwa = ukubwa + 8;  // nafasi ya ukubwa wa kipande (kwa badili)
    kama (arena_nafasi + ukubwa > 1048576) { rudisha 0; }
    n8* r = arena_anwani + arena_nafasi;
    // hifadhi ukubwa mbele ya kipande (baiti 8)
    n8* h = &ukubwa;
    n32 bi = 0;
    wakati (bi < 8) {
        r[bi] = h[bi];
        bi = bi + 1;
    }
    arena_nafasi = arena_nafasi + ukubwa;
    rudisha r + 8;
}

w0 achilia_arena(n8* p) {
    // Arena haiwezi kufungua vipande — hakuna kitu
}

n8* badili(n8* p, n64 ukubwa) {
    kama (p == 0) { rudisha tenga(ukubwa); }
    kama (ukubwa == 0) { rudisha p; }
    // soma ukubwa wa zamani kutoka kichwa cha kipande
    n64 zamani = 0;
    n8* h2 = &zamani;
    n32 bi2 = 0;
    wakati (bi2 < 8) {
        h2[bi2] = p[bi2 - 8];
        bi2 = bi2 + 1;
    }
    n8* r = tenga(ukubwa);
    kama (r == 0) { rudisha 0; }
    n64 nakili_urefu = zamani;
    kama (ukubwa < zamani) { nakili_urefu = ukubwa; }
    nakili(r, p, nakili_urefu);
    rudisha r;
}

// ==========================================================
// Usomaji wa desimali halisi — badala ya strtod (libc)
// bits_ya_d64_swa: mfuatano [-]z.z → baiti za d64 (IEEE 754)
// (majina ya kigeu hayawezi kuwa herufi za aina: N A B D W)
// Kikomo cha sasa: tarakimu za kasoro <= 10 kwa thamani < 2^26,
// <= 3 kwa thamani kubwa zaidi (vinginevyo hesabu*2^hamisha
// inaweza kuzidi baiti 64).
// ==========================================================

n64 p2_kwa(n32 kubwa) {
    n64 thamani = 1;
    n32 fasi = 0;
    wakati (fasi < kubwa) {
        thamani = thamani * 2;
        fasi = fasi + 1;
    }
    rudisha thamani;
}

n64 bits_ya_d64_swa(n8* ch, n32 u) {
    n64 alama = 0;
    n32 fasi = 0;
    kama (ch[fasi] == 45) { alama = 1; fasi = fasi + 1; }
    n64 nzima = 0;
    wakati (fasi < u && ch[fasi] != 46) {
        nzima = nzima * 10 + (ch[fasi] - 48);
        fasi = fasi + 1;
    }
    n64 kasoro = 0;
    n64 idadi_k = 0;
    kama (fasi < u && ch[fasi] == 46) {
        fasi = fasi + 1;
        wakati (fasi < u) {
            kasoro = kasoro * 10 + (ch[fasi] - 48);
            idadi_k = idadi_k + 1;
            fasi = fasi + 1;
        }
    }
    // nene = 10^idadi_k
    n64 nene = 1;
    n32 kaunta = 0;
    wakati (kaunta < idadi_k) { nene = nene * 10; kaunta = kaunta + 1; }
    // hesabu = nzima * nene + kasoro  (thamani = hesabu / nene)
    n64 hesabu = nzima * nene + kasoro;
    kama (hesabu == 0) { rudisha 0; }

    // kizio: kubwa zaidi kama 2^kizio <= hesabu/nene < 2^(kizio+1)
    n64 urefu_juu = 0; n64 muda = hesabu;
    wakati (muda > 0) { muda = muda / 2; urefu_juu = urefu_juu + 1; }
    n64 urefu_chini = 0; muda = nene;
    wakati (muda > 0) { muda = muda / 2; urefu_chini = urefu_chini + 1; }
    n64 kizio = urefu_juu - urefu_chini;
    kama (kizio >= 0) {
        // kurekebisha chini: kama hesabu/nene < 2^kizio, punguza
        n64 p2m = p2_kwa(kizio);
        kama (hesabu < nene * p2m) { kizio = kizio - 1; }
    } sivyo {
        // kizio hasi (v < 1): linganisha hesabu * 2^m < nene, m = -kizio
        n64 m = 0 - kizio;
        n64 q = 1;
        n32 mf = 0;
        wakati (mf < m) { q = q * 2; mf = mf + 1; }
        kama (hesabu * q < nene) { kizio = kizio - 1; }
    }
    // Kuinua hesabu hadi [nene, 2*nene) — hesabu/nene sasa ni
    // 2^(kizio+d); kizio yenyewe inabaki kielelezo cha thamani asilia.
    n64 d = 0;
    wakati (hesabu < nene) {
        hesabu = hesabu * 2;
        d = d + 1;
    }

    // pacha = (hesabu/nene - 2^(kizio+d)) * 2^(52-kizio-d)
    //       = hesabu * 2^(52-kizio-d) / nene - 2^52
    n64 hamisha = 52 - (kizio + d);
    kama (hamisha < 0) { hamisha = 0; }
    kama (hamisha > 52) { hamisha = 52; }
    n64 p52 = p2_kwa(52);
    n64 pacha = 0;
    kama (hamisha <= 26) {
        n64 p2s = p2_kwa(hamisha);
        pacha = (hesabu * p2s) / nene - p52;
    } sivyo {
        // Gawanya kuzidisha ili kuepuka kuzidi baiti 64:
        // hesabu*2^hamisha = (hi*nene + salio) * 2^(hamisha-26)
        n64 p2a = p2_kwa(26);
        n64 p2b = p2_kwa(hamisha - 26);
        n64 hi = (hesabu * p2a) / nene;
        n64 salio = hesabu * p2a - hi * nene;
        pacha = hi * p2b + (salio * p2b) / nene - p52;
    }

    // bits: alama << 63 | (kizio + 1023) << 52 | pacha
    n64 p63 = p2_kwa(63);
    n64 biti = 0;
    kama (alama == 1) { biti = biti + p63; }
    biti = biti + (kizio + 1023) * p52;
    biti = biti + (pacha - (pacha / p52) * p52);
    rudisha biti;
}

// soma_mstari — soma mstari mmoja kutoka faili hadi bafa.
// Inasimama kwa '\n' (isiyojumuishwa) au EOF. Rudisha idadi ya
// baiti zilizosomwa, au -1 ikiwa EOF mara moja bila baiti.
n64 soma_mstari(n32 faili, n8* bafa, n64 upeo) {
    n64 n = 0;
    wakati (n + 1 < upeo) {
        n8 ch = 0;
        n64 r = sys_soma(faili, &ch, 1);
        kama (r <= 0) {
            kama (n == 0) {
                rudisha -1;
            }
            rudisha n;
        }
        kama (ch == 10) {
            rudisha n;
        }
        bafa[n] = ch;
        n = n + 1;
    }
    rudisha n;
}

// k10h — viashiria vya umbizo katika andika_ndani (kumbukumbu.swa)
//
// Jaribio la mnyororo: hujaribu andika_ndani moja kwa moja (muundo
// wa nguvu, si upanuzi wa mkusanyaji) kupitia faili halisi:
//   1. %d, %u, %x, %%, %s, %c
//   2. %f, %l, %n — visivyosaidiwa: vinachapishwa kama herufi halisi
//   3. '%' ya mwisho mwishoni mwa muundo
//   4. O_CREAT kupitia sys_fungua (ruhusa 0644) — faili lazima
//      lifunguke tena kwa usomaji
//
// Kikomo cha mbegu (kilichoandikwa kwenye hati): %u na %x za
// thamani > 2^31 hazifanyi kazi kwenye mnyororo wa mbegu (hesabu
// ya baiti 64 kwenye hoja) — jaribio hili linatumia thamani ndogo.
n32 main() {
    // Urefu wa nakili ni mkubwa kwa makusudi: mfuatano huisha kwenye
    // NUL yake wenyewe, na andika_ndani huacha pale. Utorokaji wa \n
    // ni tofauti kati ya minyororo (mbegu: baiti 10; stage1: 92,110)
    // — andika_ndani hushughulikia zote mbili, hivyo tokeo ni sawa.
    n8 njia[64];
    nakili(njia, "_jaribio_k10h.txt", 17);

    // Fungua kwa uandishi: O_WRONLY|O_CREAT|O_TRUNC (577), ruhusa 0644 (420)
    n64 fd = sys_fungua(njia, 577, 420);
    kama (fd < 0) rudisha 1;

    // 42:42:2a:%:%f:%l:%n:habari:A
    n8 umbo[64];
    nakili(umbo, "%d:%u:%x:%%:%f:%l:%n:%s:%c\n", 40);
    andika_ndani(fd, umbo, 42, 42, 42, "habari", 65, 0);
    sys_funga(fd);

    // Soma nyuma na ulinganishe
    n8 bafa[128];
    weka_sifuri(bafa, 128);
    n64 fd2 = sys_fungua(njia, 0, 0);
    kama (fd2 < 0) rudisha 2;
    n64 n = sys_soma(fd2, bafa, 127);
    sys_funga(fd2);
    n8 tarajiwa[64];
    // Newline wazi (baiti 10) — utorokaji wa \n ni tofauti kati ya
    // minyororo: usiandike kwenye halisi.
    nakili(tarajiwa, "42:42:2a:%:%f:%l:%n:habari:A", 28);
    tarajiwa[28] = 10;
    kama (n != 29) rudisha 3;
    kama (linganisha_kumbukumbu(bafa, tarajiwa, 29) != 0) rudisha 4;

    // '%' ya mwisho mwishoni mwa muundo — chapishwa kama herufi
    n64 fd5 = sys_fungua(njia, 577, 420);
    kama (fd5 < 0) rudisha 5;
    n8 umbo3[64];
    nakili(umbo3, "asilimia %", 40);
    andika_ndani(fd5, umbo3, 0, 0, 0, 0, 0, 0);
    sys_funga(fd5);
    weka_sifuri(bafa, 128);
    n64 fd6 = sys_fungua(njia, 0, 0);
    kama (fd6 < 0) rudisha 6;
    n = sys_soma(fd6, bafa, 127);
    sys_funga(fd6);
    n8 tarajiwa3[64];
    nakili(tarajiwa3, "asilimia %", 40);
    kama (n != 10) rudisha 7;
    kama (linganisha_kumbukumbu(bafa, tarajiwa3, 10) != 0) rudisha 8;

    // Muundo wa nguvu kupitia kifungio cha andika (sio moja kwa moja
    // kwenye andika_ndani). %% haitumii hoja — kwa hiyo %x inachukua
    // a2 na %s inachukua a3.
    n8 dumbo[64];
    nakili(dumbo, "k10h: %d na %% na %x na %s\n", 40);
    andika(dumbo, 7, 42, "bora", 0, 0, 0);

    // Futa faili la jaribio (unlink — wito_wa_mfumo namba 87)
    n64 r = wito_wa_mfumo(87, njia, 0, 0, 0, 0, 0);
    kama (r != 0) rudisha 9;

    rudisha 0;
}
