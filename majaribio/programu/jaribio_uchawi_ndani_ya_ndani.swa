// Mgawanyo/modulo wa kudumu (zidisho na uchawi) ULIOOTA ndani ya mwingine:
// x / 10 / 100, (x % 7) / 3, n.k. Namba ya uchawi ilikuwa inatafutwa KABLA ya
// kushoto kutathminiwa, na mgawanyo wa ndani uliandika juu ya gwm_uchawi_*
// (na gwm64_*) kabla ya nje kuzitumia -- nje ilitumia uchawi wa kigawanyaji
// cha ndani. Sasa inatafutwa tena baada ya kushoto kutathminiwa. Kila jibu
// linalinganishwa na idiv halisi (kigezo cha wakati wa kukimbia).
husisha { msingi/maktaba/kumbukumbu.swa }

n32 kitendo(n32 v) { rudisha v; }
n64 kitendo64(n64 v) { rudisha v; }
a32 opu(a32 v) { rudisha v; }

n32 jaribu_n32() {
    n32 x = 123456;
    n32 h = 0 - 987654;
    kama (x / 10 / 100 != kitendo(x) / kitendo(10) / kitendo(100)) { rudisha 1; }
    kama (h / 10 / 100 != kitendo(h) / kitendo(10) / kitendo(100)) { rudisha 2; }
    kama ((x % 7) / 3 != (kitendo(x) % kitendo(7)) / kitendo(3)) { rudisha 3; }
    kama ((x / 7) % 10 != (kitendo(x) / kitendo(7)) % kitendo(10)) { rudisha 4; }
    kama ((h / 7) % 10 != (kitendo(h) / kitendo(7)) % kitendo(10)) { rudisha 5; }
    kama (x / 3 / 5 / 7 != kitendo(x) / kitendo(3) / kitendo(5) / kitendo(7)) { rudisha 6; }
    kama (h / 3 / 5 / 7 != kitendo(h) / kitendo(3) / kitendo(5) / kitendo(7)) { rudisha 7; }
    kama (x % 1000 % 7 != kitendo(x) % kitendo(1000) % kitendo(7)) { rudisha 8; }
    kama ((x / 10) % 10 + (x / 100) % 10 * 10 != (kitendo(x) / kitendo(10)) % kitendo(10) + (kitendo(x) / kitendo(100)) % kitendo(10) * 10) { rudisha 9; }
    // kulia pia ni usemi wenye mgawanyo (kigawanyaji si namba -- njia ya kawaida)
    kama (x / (h / 100000 + 20) != kitendo(x) / (kitendo(h) / kitendo(100000) + kitendo(20))) { rudisha 10; }
    // thamani nyingi
    n32 i = 0 - 500;
    wakati (i < 500) {
        n32 v = i * 2731 + 17;
        kama (v / 10 / 3 != kitendo(v) / kitendo(10) / kitendo(3)) { rudisha 11; }
        kama ((v % 13) / 5 != (kitendo(v) % kitendo(13)) / kitendo(5)) { rudisha 12; }
        kama ((v / 6) % 11 != (kitendo(v) / kitendo(6)) % kitendo(11)) { rudisha 13; }
        i = i + 1;
    }
    rudisha 0;
}

n32 jaribu_bila_ishara() {
    a32 u = 4000000000;
    kama (u / 10 / 100 != opu(u) / opu(10) / opu(100)) { rudisha 1; }
    kama ((u % 7) / 3 != (opu(u) % opu(7)) / opu(3)) { rudisha 2; }
    kama (u / 3 / 5 != opu(u) / opu(3) / opu(5)) { rudisha 3; }
    rudisha 0;
}

n32 jaribu_n64() {
    n64 y = 123456789012;
    n64 z = 0 - 987654321098;
    kama (y / 10 / 7 != kitendo64(y) / kitendo64(10) / kitendo64(7)) { rudisha 1; }
    kama (z / 10 / 7 != kitendo64(z) / kitendo64(10) / kitendo64(7)) { rudisha 2; }
    kama ((y % 100) / 3 != (kitendo64(y) % kitendo64(100)) / kitendo64(3)) { rudisha 3; }
    kama ((y / 1000) % 7 != (kitendo64(y) / kitendo64(1000)) % kitendo64(7)) { rudisha 4; }
    kama ((z / 1000) % 7 != (kitendo64(z) / kitendo64(1000)) % kitendo64(7)) { rudisha 5; }
    kama (y / 3 / 5 / 11 != kitendo64(y) / kitendo64(3) / kitendo64(5) / kitendo64(11)) { rudisha 6; }
    kama (y % 1000000007 % 100 != kitendo64(y) % kitendo64(1000000007) % kitendo64(100)) { rudisha 7; }
    // mgawanyo wa n32 ndani ya n64 na kinyume chake
    n32 k = 987654;
    kama ((y / 10) / k != kitendo64(y) / kitendo64(10) / kitendo64(k)) { rudisha 8; }
    n64 i = 0;
    wakati (i < 400) {
        n64 v = (i - 200) * 30000000007 + 123;
        kama (v / 10 / 7 != kitendo64(v) / kitendo64(10) / kitendo64(7)) { rudisha 9; }
        kama ((v % 1000) / 13 != (kitendo64(v) % kitendo64(1000)) / kitendo64(13)) { rudisha 10; }
        i = i + 1;
    }
    rudisha 0;
}

// Ndani ya faharasa ya safu na ndani ya hoja ya wito
n32 mara(n32 a, n32 b) { rudisha a * b; }
n32 jaribu_katika_muktadha() {
    n32 a[8];
    n32 b[8];
    n32 c[8];
    n32 i = 0;
    wakati (i < 8) { a[i] = i * 10; b[i] = i * 100; c[i] = 7 - i; i = i + 1; }
    kama (b[a[1] / 10] / 100 != 1) { rudisha 1; }
    kama (c[b[a[1] / 10] / 100] != 6) { rudisha 2; }
    kama (mara(a[3] / 10, b[4] / 100) != 12) { rudisha 3; }
    kama (mara(a[7] / 10 / 7, 5) != 5) { rudisha 4; }
    rudisha 0;
}

n32 anza() {
    n32 r = jaribu_n32();
    kama (r != 0) { rudisha 10 + r; }
    r = jaribu_bila_ishara();
    kama (r != 0) { rudisha 30 + r; }
    r = jaribu_n64();
    kama (r != 0) { rudisha 50 + r; }
    r = jaribu_katika_muktadha();
    kama (r != 0) { rudisha 70 + r; }
    rudisha 0;
}
