// Fahirisi kubwa: faharisi * saizi_ya_kipengele > 2^32 kwa arr[faharisi] (kuandika na
// kusoma), &arr[faharisi], na *(kielekezi + n) -- hitilafu iliyogunduliwa kwenye ukaguzi wa
// PR #251 (andika_ongea_kipengele_kwa_saizi ilizidisha kwenye r0d (biti 32)
// KISHA kupanua kwa ishara; kwa faharisi*saizi > 2^32 zidisho hilo lilizunguka
// (kufurika) kabla ya kupanuliwa, likitoa anwani mbaya). Usajili wa kumbukumbu
// ni wa uvivu (mmap ya kibinafsi, isiyo na hifadhi/anonymous) -- safu za
// hapa ni virtual kubwa lakini kumbukumbu halisi inayoguswa ni ndogo sana.
//
// Kila anwani inathibitishwa dhidi ya hesabu huru ya n64 (msingi + faharisi*saizi,
// n64*n64 haina hitilafu hii -- zidisha_n r0,r1 ni ya biti 64 tayari).
husisha { msingi/maktaba/kumbukumbu.swa }

n64 kama_n64(n8* p) { rudisha p; }

n32 jaribu_n64_saizi8() {
    // faharisi*8 > 2^32 kwa faharisi > 536870912
    n64 faharasa = 600000000;
    n64* p = tenga(ukubwa(n64) * (faharasa + 8));
    n64 msingi = kama_n64(p);
    p[faharasa] = 123456789;
    kama (p[faharasa] != 123456789) { rudisha 1; }
    n64 anwani_halisi = kama_n64(&p[faharasa]);
    n64 anwani_tarajiwa = msingi + (faharasa * 8);
    kama (anwani_halisi != anwani_tarajiwa) { rudisha 2; }
    // jirani (faharisi+1, idx-1) hazipaswi kuguswa
    kama (p[faharasa + 1] != 0) { rudisha 3; }
    kama (p[faharasa - 1] != 0) { rudisha 4; }
    p[faharasa + 1] = 999;
    kama (p[faharasa] != 123456789) { rudisha 5; }
    rudisha 0;
}

n32 jaribu_d64_saizi8() {
    n64 faharasa = 550000000;
    d64* p = tenga(ukubwa(d64) * (faharasa + 4));
    n64 msingi = kama_n64(p);
    p[faharasa] = 3.5;
    kama (p[faharasa] != 3.5) { rudisha 1; }
    n64 anwani_halisi = kama_n64(&p[faharasa]);
    kama (anwani_halisi != msingi + (faharasa * 8)) { rudisha 2; }
    rudisha 0;
}

n32 jaribu_n32_saizi4() {
    // faharisi*4 > 2^32 kwa faharisi > 1073741824
    n64 faharasa = 1100000000;
    n32* p = tenga(ukubwa(n32) * (faharasa + 8));
    n64 msingi = kama_n64(p);
    p[faharasa] = 42;
    kama (p[faharasa] != 42) { rudisha 1; }
    n64 anwani_halisi = kama_n64(&p[faharasa]);
    kama (anwani_halisi != msingi + (faharasa * 4)) { rudisha 2; }
    kama (p[faharasa - 5] != 0) { rudisha 3; }
    rudisha 0;
}

n32 jaribu_nyoosha_kielekezi() {
    // *(kielekezi + n) kwa n kubwa (uzalishaji_jumlisha_kielekezi hutumia
    // andika_ongea_kielekezi_kipengele -- tayari sahihi, lakini
    // tunathibitisha hapa pia kwa ukamilifu wa jaribio)
    n64 faharasa = 700000000;
    n64* p = tenga(ukubwa(n64) * (faharasa + 4));
    n64* q = p + faharasa;
    n64 msingi = kama_n64(p);
    *q = 777;
    kama (*q != 777) { rudisha 1; }
    kama (p[faharasa] != 777) { rudisha 2; }
    kama (kama_n64(q) != msingi + (faharasa * 8)) { rudisha 3; }
    rudisha 0;
}

// Fahirisi ndogo, ya kawaida -- lazima ibaki sahihi baada ya mabadiliko
n32 jaribu_ndogo_bado_sahihi() {
    n32* a = tenga(ukubwa(n32) * 8);
    n32 i = 3;
    a[i] = 99;
    kama (a[i] != 99) { rudisha 1; }
    kama (a[i - 1] != 0) { rudisha 2; }
    a[i - 2] = 0 - 5;
    kama (a[1] != (0 - 5)) { rudisha 3; }
    n8* b = tenga(8);
    n32 j = 0 - 1;
    b[7] = 100;   // < 128, hakuna utata wa ishara ya n8
    kama (b[7 + j] != 0) { rudisha 4; }   // b[6], haijaandikwa
    kama ((b[7 + j - j]) != 100) { rudisha 5; }  // b[7]
    rudisha 0;
}

n32 anza() {
    n32 r = jaribu_n64_saizi8();
    kama (r != 0) { rudisha 10 + r; }
    r = jaribu_d64_saizi8();
    kama (r != 0) { rudisha 20 + r; }
    r = jaribu_n32_saizi4();
    kama (r != 0) { rudisha 30 + r; }
    r = jaribu_nyoosha_kielekezi();
    kama (r != 0) { rudisha 40 + r; }
    r = jaribu_ndogo_bado_sahihi();
    kama (r != 0) { rudisha 50 + r; }
    rudisha 0;
}
