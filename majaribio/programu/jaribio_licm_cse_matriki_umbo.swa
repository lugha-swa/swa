// LICM CSE (cross-occurrence): muundo halisi wa matriki -- taarifa
// moja "c[i*n+j] = c[i*n+j] + x" ndani ya kitanzi cha j, ambapo "i*n"
// hutokea MARA MBILI (fahirisi ya LHS na fahirisi ya kwanza ya c
// kwenye RHS). Kabla ya CSE hii, LICM ilikuwa ikihamisha kila tokeo
// kivyake kwa jina tofauti la muda -- baada ya CSE, zote mbili
// zinapaswa kushiriki KIGEZO KIMOJA cha muda (kinathibitishwa kwa
// disassembly: kuzidisha kunapaswa kuonekana MARA MOJA tu kabla ya
// kitanzi, si mara mbili).
husisha { msingi/maktaba/kumbukumbu.swa }

n32 main() {
    n32 n = 5;
    n32* c = tenga(ukubwa(n32) * n * n);
    n32 x = 3;
    n32 i = 0;
    wakati (i < n * n) { c[i] = 0; i = i + 1; }
    i = 0;
    wakati (i < n) {
        n32 j = 0;
        wakati (j < n) {
            c[i * n + j] = c[i * n + j] + x;
            j = j + 1;
        }
        i = i + 1;
    }
    // Kila kipengele kinapaswa kuwa x (mzunguko mmoja tu wa i, hivyo
    // kila c[i*n+j] inaandikwa mara moja: 0 + x = x).
    n32 k = 0;
    wakati (k < n * n) {
        kama (c[k] != x) { rudisha k + 1; }
        k = k + 1;
    }
    rudisha 0;
}
