// Sethi-Ullman -- usemi wenye wito za kazi kama majani ndani ya mti
// unaoshughulikiwa na SU: (chukua(..)+chukua(..)) + (chukua(..)+chukua(..)).
// Umewekwa NDANI ya kitanzi (mara 2) kwa makusudi -- SU sasa
// inatengwa TU kwa usemi unaorudiwa ndani ya kitanzi (angalia
// su_kina_kitanzi, uzalishaji.swa). jumla_kuu na m ni za ULIMWENGU
// (SI za ndani) kwa makusudi -- hii ndiyo pia ilikuwa ya lazima
// kwenye jaribio_su_kina_kirefu/jaribio_su_abi_uhifadhi_wa_mpigaji:
// vigezo vya ndani vingepunguza nafasi ya rejesta iliyobaki (haja=2
// ya mti huu ingekataliwa kama vigezo 4+ vya ndani vingetumika hapa,
// vikiacha nafasi <2). Mti mzima unatoshea (haja=2). Kila wito
// huandika hoja yake kwenye logi ya ulimwengu -- mpangilio HALISI wa
// wito lazima ubaki KULIA-KWENDA-KUSHOTO KABISA (sawa na njia ya
// asili isiyotumia SU) KATIKA KILA MZUNGUKO: mzunguko 1 -> 4,3,2,1;
// mzunguko 2 -> 8,7,6,5 (hoja za wito zinatathminiwa D,C,B,A --
// kinyume cha mpangilio wa maandishi A,B,C,D -- kwa muundo huu wa
// mti). Jumla ya thamani kwa mzunguko: 1+2+3+4=10, 5+6+7+8=26, jumla
// ya jumla=36.
N32 logi[8];
N32 logi_idx = 0;
N32 jumla_kuu = 0;
N32 m = 0;

N32 chukua(N32 n) {
    logi[logi_idx] = n;
    logi_idx = logi_idx + 1;
    rudisha n;
}

N32 main() {
    wakati (m < 2) {
        jumla_kuu = jumla_kuu + (chukua(m * 4 + 1) + chukua(m * 4 + 2)) + (chukua(m * 4 + 3) + chukua(m * 4 + 4));
        m = m + 1;
    }
    kama (jumla_kuu != 36) { rudisha 1; }
    kama (logi_idx != 8) { rudisha 2; }
    kama (logi[0] != 4) { rudisha 3; }
    kama (logi[1] != 3) { rudisha 4; }
    kama (logi[2] != 2) { rudisha 5; }
    kama (logi[3] != 1) { rudisha 6; }
    kama (logi[4] != 8) { rudisha 7; }
    kama (logi[5] != 7) { rudisha 8; }
    kama (logi[6] != 6) { rudisha 9; }
    kama (logi[7] != 5) { rudisha 10; }
    rudisha 0;
}
