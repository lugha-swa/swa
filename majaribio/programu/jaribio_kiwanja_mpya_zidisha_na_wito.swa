// Jaribio: (1) op ya ZIDISHA yenyewe kwenye ngazi ya juu (c[i]=c[i]*x),
// (2) upande "mwingine" wa RHS una WITO WA KAZI (chukua()) -- lazima
// kazi hiyo iendelee kuitwa mara moja kwa kila kipengele, bila
// kuathiriwa na kashe ya anwani.
husisha { msingi/maktaba/kumbukumbu.swa }

N32 wito_idadi;

N32 chukua(N32 v) {
    wito_idadi = wito_idadi + 1;
    rudisha v + 1;
}

N32 main() {
    N32 n = 5;
    N32* c = tenga(ukubwa(N32) * n);
    N32 i = 0;
    wakati (i < n) { c[i] = i + 1; i = i + 1; }  // c = {1,2,3,4,5}

    // (1) ZIDISHA: c[i] = c[i] * 2
    i = 0;
    wakati (i < n) {
        c[i] = c[i] * 2;
        i = i + 1;
    }
    // c sasa = {2,4,6,8,10}
    kama (c[0] != 2) { rudisha 1; }
    kama (c[4] != 10) { rudisha 2; }

    // (2) c[i] = c[i] + chukua(i) -- chukua() lazima iitwe MARA MOJA
    // kwa kila i, ikirudisha i+1. c[i]_mpya = c[i]_sasa + (i+1).
    wito_idadi = 0;
    i = 0;
    wakati (i < n) {
        c[i] = c[i] + chukua(i);
        i = i + 1;
    }
    kama (wito_idadi != n) { rudisha 3; }
    // c[0] = 2 + 1 = 3; c[4] = 10 + 5 = 15
    kama (c[0] != 3) { rudisha 4; }
    kama (c[4] != 15) { rudisha 5; }
    rudisha 0;
}
