// Mende: halisi za radiksi (0x, 0o, 0b) zilikuwa zikikubaliwa na
// kuhesabiwa kama desimali (0x10 = 10, 0b101 = 101, 0o17 = 17).
// Hati 2.3 inaahidi "mfuatano wa tarakimu" pekee kwa nambari kamili —
// lazima zikataliwe kwa sauti na kosa la Kiswahili, si kukubaliwa
// kimya. (Sawa na halisi ya herufi na kianzilishi cha safu.)
n32 main() { rudisha 0x10 + 0b101 + 0o17; }
