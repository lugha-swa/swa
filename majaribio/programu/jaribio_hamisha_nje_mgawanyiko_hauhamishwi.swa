// LICM hatari #1: mgawanyiko (/) na modulo (%) HAZIRUHUSIWI KAMWE
// kuhamishwa nje ya mzunguko, hata kama zinaonekana "hazibadiliki".
// k = 0 hufanya kigawanyaji kuwa sifuri; n = -1 hufanya sharti la
// mzunguko (i < n, i=0) liwe la uongo TANGU MWANZO -- maudhui ya mzunguko
// hayapaswi kutekelezwa hata mara moja. Kama LICM ingehamisha "a / k"
// nje ya mzunguko (ikidhania kimakosa kuwa ni salama kama +,-,*),
// mgawanyiko-kwa-sifuri ungetokea papo hapo, KABLA sharti la mzunguko
// halijaangaliwa -- ikigeuza programu isiyoanguka kamwe kuwa moja
// inayoanguka kila wakati.
n32 a;
n32 k;
n32 x;

n32 anza() {
    a = 10;
    k = 0;
    n32 n = 0 - 1;
    n32 i = 0;
    wakati (i < n) {
        x = a / k;
        i = i + 1;
    }
    rudisha 0;
}
