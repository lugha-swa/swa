// Kupunguza nguvu (strength reduction): zidisho kwa nambari halisi
// iliyo nguvu kamili ya 2 (upande wowote) linatolewa kama shl badala
// ya imul. Jaribio hili linathibitisha thamani SAHIHI kwa: nguvu ya
// 2 upande wa kulia, upande wa kushoto, thamani hasi, kigezo cha
// upana mdogo (n8) kikizidishwa na kupanuliwa hadi n32, na nambari
// isiyo nguvu kamili ya 2 (lazima ibaki kwenye njia ya kawaida ya
// imul bila kuvunjika).
n32 main() {
    n32 x = 7;
    n32 a = x * 8;
    kama (a != 56) { rudisha 1; }

    n32 b = 8 * x;
    kama (b != 56) { rudisha 2; }

    n32 neg = 0 - 3;
    n32 c = neg * 4;
    kama (c != (0 - 12)) { rudisha 3; }

    n8 dogo = 5;
    n32 d = dogo * 4;
    kama (d != 20) { rudisha 4; }

    n32 y = 5;
    n32 e = y * 6;
    kama (e != 30) { rudisha 5; }

    rudisha 0;
}
