// jaribio_hitilafu_d32_kazi: kazi ya d32 (parameta na kurudisha).
// Kabla: ABI ya d32 ilitumia soma_d64 badala ya soma_d32 kwenye mrundikano wa
// hoja (na uharibifu wa mrundikano) -- SEGV 139 kwenye uzalishaji. Sasa
// parameta inapakuliwa kwa movss, halisi inabadilishwa d64->d32, na
// matokeo yanarudishwa kwenye xmm0.
// Inatarajiwa: 5 (2.5 * 2.0)
// (kamili pekee -- awali bado inaanguka kwenye d32.)
d32 mara_mbili(d32 x) { rudisha x * 2.0; }

n32 anza() {
    rudisha mara_mbili(2.5);
}
