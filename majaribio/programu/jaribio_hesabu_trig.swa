// Jaribio la kudumu la hesabu za d64 transcendental (hesabu.swa,
// lugha-swa/swa#183) — sin/cos/atan2/mzizi/kielelezi/logasili/kuinua.
// Kinafuata mtindo wa jaribio_k10f_hesabu.swa: nakala ya moja kwa
// moja ya kazi (si husisha), matokeo yanaonyeshwa kwa msimbo wa
// kutoka (exit code), si andika.

d64 pi_hesabu() {
    rudisha 3.1415926536;
}

d64 mzizi_hesabu(d64 x) {
    kama (x <= 0.0) { rudisha 0.0; }
    d64 kisio = x;
    kama (kisio < 1.0) { kisio = 1.0; }
    n32 n = 0;
    wakati (n < 25) {
        kisio = 0.5 * (kisio + x / kisio);
        n = n + 1;
    }
    rudisha kisio;
}

d64 kielelezi_hesabu(d64 x) {
    d64 jumla = 1.0;
    d64 neno = 1.0;
    n32 n = 1;
    wakati (n <= 30) {
        d64 n_d = n;
        neno = neno * x / n_d;
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla;
}

d64 logasili_hesabu(d64 x) {
    kama (x <= 0.0) { rudisha 0.0; }
    d64 LN2 = 0.6931471805;
    n32 k = 0;
    d64 xr = x;
    wakati (xr > 2.0) { xr = xr / 2.0; k = k + 1; }
    wakati (xr < 0.5) { xr = xr * 2.0; k = k - 1; }
    d64 z = (xr - 1.0) / (xr + 1.0);
    d64 z2 = z * z;
    d64 jumla = 0.0;
    d64 neno = z;
    n32 i = 1;
    wakati (i <= 40) {
        d64 i_d = i;
        jumla = jumla + neno / i_d;
        neno = neno * z2;
        i = i + 2;
    }
    d64 k_d = k;
    rudisha 2.0 * jumla + k_d * LN2;
}

d64 kuinua_hesabu(d64 x, d64 y) {
    kama (x <= 0.0) { rudisha 0.0; }
    rudisha kielelezi_hesabu(y * logasili_hesabu(x));
}

d64 sin_hesabu(d64 x) {
    d64 pi = pi_hesabu();
    d64 pi2 = pi + pi;
    wakati (x > pi) { x = x - pi2; }
    wakati (x <= (0.0 - pi)) { x = x + pi2; }
    d64 x2 = x * x;
    d64 jumla = x;
    d64 neno = x;
    n32 n = 1;
    wakati (n <= 20) {
        d64 n_d = n;
        d64 chini1 = 2.0 * n_d;
        d64 chini2 = chini1 + 1.0;
        neno = neno * (0.0 - x2) / (chini1 * chini2);
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla;
}

d64 cos_hesabu(d64 x) {
    d64 pi = pi_hesabu();
    d64 pi2 = pi + pi;
    wakati (x > pi) { x = x - pi2; }
    wakati (x <= (0.0 - pi)) { x = x + pi2; }
    d64 x2 = x * x;
    d64 jumla = 1.0;
    d64 neno = 1.0;
    n32 n = 1;
    wakati (n <= 20) {
        d64 n_d = n;
        d64 chini1 = 2.0 * n_d - 1.0;
        d64 chini2 = 2.0 * n_d;
        neno = neno * (0.0 - x2) / (chini1 * chini2);
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla;
}

d64 atan_ndogo_hesabu(d64 t) {
    d64 u1 = t / (1.0 + mzizi_hesabu(1.0 + t * t));
    d64 u2 = u1 / (1.0 + mzizi_hesabu(1.0 + u1 * u1));
    d64 u3 = u2 / (1.0 + mzizi_hesabu(1.0 + u2 * u2));
    d64 u2sq = u3 * u3;
    d64 jumla = u3;
    d64 neno = u3;
    n32 n = 1;
    wakati (n <= 20) {
        d64 n_d = n;
        d64 juu = 2.0 * n_d - 1.0;
        d64 chini = 2.0 * n_d + 1.0;
        neno = neno * (0.0 - u2sq) * juu / chini;
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla * 8.0;
}

d64 atan_hesabu(d64 t) {
    n32 hasi = 0;
    d64 tt = t;
    kama (tt < 0.0) { hasi = 1; tt = 0.0 - tt; }
    d64 matokeo = atan_ndogo_hesabu(tt);
    kama (tt > 1.0) {
        matokeo = (pi_hesabu() / 2.0) - atan_ndogo_hesabu(1.0 / tt);
    }
    kama (hasi == 1) { matokeo = 0.0 - matokeo; }
    rudisha matokeo;
}

d64 atan2_hesabu(d64 y, d64 x) {
    kama (x > 0.0) { rudisha atan_hesabu(y / x); }
    kama (x < 0.0) {
        kama (y >= 0.0) { rudisha atan_hesabu(y / x) + pi_hesabu(); }
        rudisha atan_hesabu(y / x) - pi_hesabu();
    }
    kama (y > 0.0) { rudisha pi_hesabu() / 2.0; }
    kama (y < 0.0) { rudisha 0.0 - (pi_hesabu() / 2.0); }
    rudisha 0.0;
}

n32 karibu(d64 a, d64 b, d64 tofauti_kubwa) {
    d64 d = a - b;
    kama (d < 0.0) { d = 0.0 - d; }
    kama (d > tofauti_kubwa) { rudisha 0; }
    rudisha 1;
}

n32 main() {
    d64 pi = pi_hesabu();

    kama (karibu(sin_hesabu(0.0), 0.0, 0.00001) == 0) { rudisha 1; }
    kama (karibu(cos_hesabu(0.0), 1.0, 0.00001) == 0) { rudisha 2; }
    kama (karibu(sin_hesabu(pi/6.0), 0.5, 0.0001) == 0) { rudisha 3; }
    kama (karibu(cos_hesabu(pi/3.0), 0.5, 0.0001) == 0) { rudisha 4; }
    kama (karibu(sin_hesabu(pi/2.0), 1.0, 0.0001) == 0) { rudisha 5; }
    kama (karibu(cos_hesabu(pi/2.0), 0.0, 0.0001) == 0) { rudisha 6; }
    kama (karibu(sin_hesabu(pi), 0.0, 0.0001) == 0) { rudisha 7; }
    kama (karibu(cos_hesabu(pi), 0.0 - 1.0, 0.0001) == 0) { rudisha 8; }
    d64 x_kubwa = pi * 2.0 + pi / 6.0;
    kama (karibu(sin_hesabu(x_kubwa), 0.5, 0.0001) == 0) { rudisha 9; }
    d64 x_hasi_kubwa = 0.0 - (pi * 3.0 + pi / 3.0);
    kama (karibu(cos_hesabu(x_hasi_kubwa), 0.0 - 0.5, 0.0001) == 0) { rudisha 10; }

    kama (karibu(mzizi_hesabu(4.0), 2.0, 0.00001) == 0) { rudisha 11; }
    kama (karibu(mzizi_hesabu(2.0), 1.41421356, 0.00001) == 0) { rudisha 12; }
    kama (mzizi_hesabu(0.0 - 5.0) != 0.0) { rudisha 13; }

    kama (karibu(kielelezi_hesabu(0.0), 1.0, 0.00001) == 0) { rudisha 14; }
    kama (karibu(kielelezi_hesabu(1.0), 2.71828183, 0.0001) == 0) { rudisha 15; }
    kama (karibu(kielelezi_hesabu(2.0), 7.38905610, 0.001) == 0) { rudisha 16; }

    kama (karibu(logasili_hesabu(1.0), 0.0, 0.00001) == 0) { rudisha 17; }
    kama (karibu(logasili_hesabu(2.71828183), 1.0, 0.0001) == 0) { rudisha 18; }
    kama (karibu(logasili_hesabu(10.0), 2.302585, 0.0001) == 0) { rudisha 19; }

    kama (karibu(kuinua_hesabu(2.0, 10.0), 1024.0, 0.01) == 0) { rudisha 20; }
    kama (karibu(kuinua_hesabu(3.0, 2.0), 9.0, 0.001) == 0) { rudisha 21; }

    kama (karibu(atan_hesabu(1.0), pi/4.0, 0.0001) == 0) { rudisha 22; }
    kama (karibu(atan2_hesabu(1.0, 1.0), pi/4.0, 0.0001) == 0) { rudisha 23; }
    kama (karibu(atan2_hesabu(1.0, 0.0 - 1.0), pi * 3.0/4.0, 0.0001) == 0) { rudisha 24; }
    kama (karibu(atan2_hesabu(0.0 - 1.0, 0.0 - 1.0), 0.0 - (pi * 3.0/4.0), 0.0001) == 0) { rudisha 25; }
    kama (karibu(atan2_hesabu(0.0 - 1.0, 1.0), 0.0 - (pi/4.0), 0.0001) == 0) { rudisha 26; }
    kama (karibu(atan2_hesabu(1.0, 0.0), pi/2.0, 0.0001) == 0) { rudisha 27; }
    kama (karibu(atan2_hesabu(0.0 - 1.0, 0.0), 0.0 - (pi/2.0), 0.0001) == 0) { rudisha 28; }

    rudisha 0;
}
