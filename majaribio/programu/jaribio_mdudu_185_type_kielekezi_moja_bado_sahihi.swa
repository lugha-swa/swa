// lugha-swa/swa#185 -- jaribio la kudumu la kesi iliyokuwa SAHIHI
// tayari (TYPE* pekee, safu ya miundo iliyopachikwa kupitia
// kielekezi) haikuvunjika na rekebisho la #185.
husisha { maktaba/kumbukumbu.swa }
muundo Kitu {
    N32 v;
};
N32 main() {
    Kitu* arr = tenga(ukubwa(Kitu) * 5);
    N32 i = 0;
    wakati (i < 5) {
        arr[i].v = i * 10;
        i = i + 1;
    }
    N32 makosa = 0;
    i = 0;
    wakati (i < 5) {
        kama (arr[i].v != i * 10) { makosa = makosa + 1; }
        i = i + 1;
    }
    rudisha makosa;
}
