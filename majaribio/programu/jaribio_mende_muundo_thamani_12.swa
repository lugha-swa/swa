// jaribio_mende_muundo_thamani_12: muundo wa baiti 12 kwa thamani —
// mabadiliko ya kigezo ndani ya kazi hayapaswi kugusa kigeu cha
// mpigaji. Kabla: bafa ya nakala ilihifadhi anwani ya CHANZO badala
// ya lengwa, kwa hiyo kigezo kilielekeza kwenye kigeu cha mpigaji na
// mabadiliko yaliharibu data yake (jibu 240 badala ya 6).
// Inatarajiwa: 6 (1 + 2 + 3)
muundo Tatu { n32 a; n32 b; n32 c; };

w0 badilisha(Tatu t) {
    t.a = 90;
    t.b = 80;
    t.c = 70;
}

n32 main() {
    Tatu t;
    t.a = 1;
    t.b = 2;
    t.c = 3;
    badilisha(t);
    rudisha t.a + t.b + t.c;
}
