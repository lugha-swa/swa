// jaribio_mende_sret_mlolongo_16: mlolongo wa sret wa baiti 16 —
// matokeo ya wito unaorudisha muundo mkubwa (>8B) yanapopitishwa
// kwa thamani kwa wito mwingine: jumlisha(tengeneza(10)). Kabla:
// kielekezi cha bafa ya sret kilipitishwa moja kwa moja (bila
// nakala). Mbegu haina hifadhi ya kutosha ya rafu kwa mnyororo huu
// (SEGV) — stage1 pekee.
// Inatarajiwa: 46 (10 + 11 + 12 + 13)
muundo Nne { n32 a; n32 b; n32 c; n32 d; };

Nne tengeneza(n32 x) {
    Nne n;
    n.a = x;
    n.b = x + 1;
    n.c = x + 2;
    n.d = x + 3;
    rudisha n;
}

n32 jumlisha(Nne n) {
    rudisha n.a + n.b + n.c + n.d;
}

n32 main() {
    rudisha jumlisha(tengeneza(10));
}
