// lugha-swa/swa#215 -- kinga ya upande mwingine: majina yanayofanana
// na aina ya msingi lakini SI aina (herufi baada ya tarakimu, herufi
// mbili mwanzoni, herufi kubwa) bado ni majina halali ya muundo.
// N32 si aina tena tangu uhamiaji wa herufi ndogo.
muundo n32a { n64 x; n64 y; }
muundo nn32 { n64 x; }
muundo N32 { n64 x; n64 y; n64 z; }
n32 main() { rudisha ukubwa(n32a) + ukubwa(nn32) + ukubwa(N32); }
