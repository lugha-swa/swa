// lugha-swa/swa#215 -- jina la aina ya msingi kama jina la muundo.
// Zamani "muundo n32 { ... }" ilipita kimya, lakini muundo huo
// haukufikika kamwe: aina ya msingi hushinda kila mahali jina la aina
// linasomwa, hivyo ukubwa(n32) ilirudisha 4 badala ya 8. Sasa
// linakataliwa kwa sauti kwenye tangazo. Kamili pekee: awali
// iliyogandishwa bado inakubali.
muundo n32 { n64 x; }
n32 anza() { rudisha ukubwa(n32); }
