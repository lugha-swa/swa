husisha { ../../msingi/maktaba/kumbukumbu.swa }
husisha { ../../msingi/maktaba/mfuatano.swa }
husisha { ../../msingi/mkusanyaji/msomaji.swa }

n32 main() {
    Tokeni t;
    t.aina = 0;
    t.urefu = 1;
    t.mstari = 2;
    t.safu = 3;
    n32 a = t.aina;
    n32 u = t.urefu;
    n32 m = t.mstari;
    n32 s = t.safu;
    andika("; a=%d u=%d m=%d s=%d\n", a, u, m, s);
    rudisha 0;
}
