// Jaribio kubwa: mzunguko (wakati), wito wa kazi ya mtumiaji
// iliyotangazwa BAADAYE kwenye chanzo (wito wa mbele -- ndiyo
// hasa uliogusa mdudu wa RELA uliopatikana wakati wa maendeleo),
// hesabu (* na +), tawi la kama/sivyo, na vga_andika ya herufi
// nyingi. rudisha 20 (2*(0+1+2+3+4)) inathibitishwa kupitia RDI
// baada ya HLT, na maandishi "Kawira" kupitia kumbukumbu ya VGA.
n32 kernel_main() {
    n32 jumla = 0;
    n32 i = 0;
    wakati (i < 5) {
        jumla = jumla + mara_mbili(i);
        i = i + 1;
    }

    kama (jumla == 20) {
        vga_andika("Kawira");
    } sivyo {
        vga_andika("KOSA");
    }
    rudisha jumla;
}

n32 mara_mbili(n32 x) {
    rudisha x * 2;
}
