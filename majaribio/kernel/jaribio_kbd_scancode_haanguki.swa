// Huthibitisha kbd_scancode() (in al, 0x60) inatekelezwa bila
// kuanguka (hakuna #UD/#GP -- QEMU haingefikia HLT sahihi kama
// ingekuwepo hitilafu ya CPU). Thamani HALISI ya scancode
// HAIJAAMULIWA kwenye mazingira haya ya jaribio (hakuna kibodi
// halisi inayobonyeza), hivyo HAITHIBITISHWI moja kwa moja hapa --
// angalia lugha-swa/kawira (Sehemu 3), ambapo QEMU monitor
// 'sendkey' inatoa thamani halisi inayothibitishwa mwisho hadi
// mwisho.
n32 kernel_main() {
    n32 s = kbd_scancode();
    n32 sifuri = s & 0;
    rudisha 42 + sifuri;
}
