W0 nakili(N8* lengwa, N8* chanzo, N64 n) {
    N64 i = 0;
    wakati (i < n) {
        lengwa[i] = chanzo[i];
        i = i + 1;
    }
}

W0 weka_sifuri(N8* lengwa, N64 n) {
    N64 i = 0;
    wakati (i < n) {
        lengwa[i] = 0;
        i = i + 1;
    }
}

N32 linganisha_kumbukumbu(N8* a, N8* b, N64 n) {
    N64 i = 0;
    wakati (i < n) {
        kama (a[i] < b[i]) {
            rudisha -1;
        }
        kama (a[i] > b[i]) {
            rudisha 1;
        }
        i = i + 1;
    }
    rudisha 0;
}

// ==========================================================
// Runtime ya syscalls — maktaba haihitaji libc tena
// ==========================================================

// Wito wa mfumo wa Linux — builtin ya mzalishaji (uzalishaji_wito)
// na daraja la C kwa mbegu. Haina tangazo la .swa: kila mkaguzi
// (wa Swa na wa Rust) hujenga saini kutoka hoja halisi za wito.

N64 sys_soma(N32 faili, N8* bafa, N64 urefu) {
    rudisha wito_wa_mfumo(0, faili, bafa, urefu, 0, 0, 0);
}

N64 sys_andika(N32 faili, N8* bafa, N64 urefu) {
    rudisha wito_wa_mfumo(1, faili, bafa, urefu, 0, 0, 0);
}

N64 sys_fungua(N8* njia, N64 bendera) {
    rudisha wito_wa_mfumo(2, njia, bendera, 0, 0, 0, 0);
}

N64 sys_funga(N32 faili) {
    rudisha wito_wa_mfumo(3, faili, 0, 0, 0, 0, 0);
}

N64 sys_mmap(N8* anwani, N64 urefu, N64 ulinzi, N64 bendera, N64 faili) {
    rudisha wito_wa_mfumo(9, anwani, urefu, ulinzi, bendera, faili, 0);
}

N64 sys_munmap(N8* anwani, N64 urefu) {
    rudisha wito_wa_mfumo(11, anwani, urefu, 0, 0, 0, 0);
}

// ==========================================================
// Uchapishaji — andika_n64 / andika_mfuatano / andika_baiti
// Hizi ndizo kazi zinazoitwa na builtin ya andika katika mzalishaji.
// ==========================================================

W0 andika_n64(N32 faili, N64 v) {
    N8 bafa[32];
    N32 n = 0;
    N32 mwanzo = 0;
    kama (v < 0) {
        bafa[n] = 45;  // '-'
        n = n + 1;
        v = 0 - v;
        mwanzo = 1;
    }
    wakati (1 == 1) {
        bafa[n] = 48 + (v - ((v / 10) * 10));
        n = n + 1;
        v = v / 10;
        kama (v == 0) { vunja; }
    }
    // geuza mpangilio wa tarakimu
    N32 i = mwanzo;
    N32 j = n - 1;
    wakati (i < j) {
        N8 t = bafa[i];
        bafa[i] = bafa[j];
        bafa[j] = t;
        i = i + 1;
        j = j - 1;
    }
    sys_andika(faili, bafa, n);
}

W0 andika_mfuatano(N32 faili, N8* s) {
    // Urefu wa mfuatano unahesabiwa hapa — kumbukumbu.swa
    // haitegemei mfuatano.swa (jaribio la k10a linahusisha peke yake).
    N64 u = 0;
    wakati (s[u] != 0) {
        u = u + 1;
    }
    sys_andika(faili, s, u);
}

W0 andika_herufi(N32 faili, N64 b) {
    N8 bb = b;
    sys_andika(faili, &bb, 1);
}

W0 andika_sehemu(N32 faili, N8* s, N64 urefu) {
    sys_andika(faili, s, urefu);
}

// ==========================================================
// Arena ya kumbukumbu — badala ya malloc/realloc/free
// ==========================================================
N8* arena_anwani = 0;
N64 arena_nafasi = 0;

N8* tenga(N64 ukubwa) {
    kama (arena_anwani == 0) {
        arena_anwani = sys_mmap(0, 1048576, 3, 34, 0 - 1);
        kama (arena_anwani == 0 - 1) { rudisha 0; }
    }
    kama (ukubwa == 0) { ukubwa = 8; }
    ukubwa = ukubwa + 8;  // nafasi ya ukubwa wa kipande (kwa badili)
    kama (arena_nafasi + ukubwa > 1048576) { rudisha 0; }
    N8* r = arena_anwani + arena_nafasi;
    // hifadhi ukubwa mbele ya kipande (baiti 8)
    N8* h = &ukubwa;
    N32 bi = 0;
    wakati (bi < 8) {
        r[bi] = h[bi];
        bi = bi + 1;
    }
    arena_nafasi = arena_nafasi + ukubwa;
    rudisha r + 8;
}

W0 achilia(N8* p) {
    // Arena haiwezi kufungua vipande — hakuna kitu
}

N8* badili(N8* p, N64 ukubwa) {
    kama (p == 0) { rudisha tenga(ukubwa); }
    kama (ukubwa == 0) { rudisha p; }
    // soma ukubwa wa zamani kutoka kichwa cha kipande
    N64 zamani = 0;
    N8* h2 = &zamani;
    N32 bi2 = 0;
    wakati (bi2 < 8) {
        h2[bi2] = p[bi2 - 8];
        bi2 = bi2 + 1;
    }
    N8* r = tenga(ukubwa);
    kama (r == 0) { rudisha 0; }
    N64 nakili_urefu = zamani;
    kama (ukubwa < zamani) { nakili_urefu = ukubwa; }
    nakili(r, p, nakili_urefu);
    rudisha r;
}

// ==========================================================
// Usomaji wa desimali halisi — badala ya strtod (libc)
// bits_ya_d64_swa: mfuatano [-]z.z → baiti za D64 (IEEE 754)
// (majina ya kigeu hayawezi kuwa herufi za aina: N A B D W)
// Kikomo cha sasa: tarakimu za kasoro <= 10 kwa thamani < 2^26,
// <= 3 kwa thamani kubwa zaidi (vinginevyo hesabu*2^hamisha
// inaweza kuzidi baiti 64).
// ==========================================================

N64 p2_kwa(N32 kubwa) {
    N64 thamani = 1;
    N32 fasi = 0;
    wakati (fasi < kubwa) {
        thamani = thamani * 2;
        fasi = fasi + 1;
    }
    rudisha thamani;
}

N64 bits_ya_d64_swa(N8* ch, N32 u) {
    N64 alama = 0;
    N32 fasi = 0;
    kama (ch[fasi] == 45) { alama = 1; fasi = fasi + 1; }
    N64 nzima = 0;
    wakati (fasi < u && ch[fasi] != 46) {
        nzima = nzima * 10 + (ch[fasi] - 48);
        fasi = fasi + 1;
    }
    N64 kasoro = 0;
    N64 idadi_k = 0;
    kama (fasi < u && ch[fasi] == 46) {
        fasi = fasi + 1;
        wakati (fasi < u) {
            kasoro = kasoro * 10 + (ch[fasi] - 48);
            idadi_k = idadi_k + 1;
            fasi = fasi + 1;
        }
    }
    // nene = 10^idadi_k
    N64 nene = 1;
    N32 kaunta = 0;
    wakati (kaunta < idadi_k) { nene = nene * 10; kaunta = kaunta + 1; }
    // hesabu = nzima * nene + kasoro  (thamani = hesabu / nene)
    N64 hesabu = nzima * nene + kasoro;
    kama (hesabu == 0) { rudisha 0; }

    // kizio: kubwa zaidi kama 2^kizio <= hesabu/nene < 2^(kizio+1)
    N64 urefu_juu = 0; N64 muda = hesabu;
    wakati (muda > 0) { muda = muda / 2; urefu_juu = urefu_juu + 1; }
    N64 urefu_chini = 0; muda = nene;
    wakati (muda > 0) { muda = muda / 2; urefu_chini = urefu_chini + 1; }
    N64 kizio = urefu_juu - urefu_chini;
    kama (kizio >= 0) {
        // kurekebisha chini: kama hesabu/nene < 2^kizio, punguza
        N64 p2m = p2_kwa(kizio);
        kama (hesabu < nene * p2m) { kizio = kizio - 1; }
    } sivyo {
        // kizio hasi (v < 1): linganisha hesabu * 2^m < nene, m = -kizio
        N64 m = 0 - kizio;
        N64 q = 1;
        N32 mf = 0;
        wakati (mf < m) { q = q * 2; mf = mf + 1; }
        kama (hesabu * q < nene) { kizio = kizio - 1; }
    }
    // Kuinua hesabu hadi [nene, 2*nene) — hesabu/nene sasa ni
    // 2^(kizio+d); kizio yenyewe inabaki kielelezo cha thamani asilia.
    N64 d = 0;
    wakati (hesabu < nene) {
        hesabu = hesabu * 2;
        d = d + 1;
    }

    // pacha = (hesabu/nene - 2^(kizio+d)) * 2^(52-kizio-d)
    //       = hesabu * 2^(52-kizio-d) / nene - 2^52
    N64 hamisha = 52 - (kizio + d);
    kama (hamisha < 0) { hamisha = 0; }
    kama (hamisha > 52) { hamisha = 52; }
    N64 p52 = p2_kwa(52);
    N64 pacha = 0;
    kama (hamisha <= 26) {
        N64 p2s = p2_kwa(hamisha);
        pacha = (hesabu * p2s) / nene - p52;
    } sivyo {
        // Gawanya kuzidisha ili kuepuka kuzidi baiti 64:
        // hesabu*2^hamisha = (hi*nene + salio) * 2^(hamisha-26)
        N64 p2a = p2_kwa(26);
        N64 p2b = p2_kwa(hamisha - 26);
        N64 hi = (hesabu * p2a) / nene;
        N64 salio = hesabu * p2a - hi * nene;
        pacha = hi * p2b + (salio * p2b) / nene - p52;
    }

    // bits: alama << 63 | (kizio + 1023) << 52 | pacha
    N64 p63 = p2_kwa(63);
    N64 biti = 0;
    kama (alama == 1) { biti = biti + p63; }
    biti = biti + (kizio + 1023) * p52;
    biti = biti + (pacha - (pacha / p52) * p52);
    rudisha biti;
}
