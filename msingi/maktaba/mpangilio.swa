// mpangilio.swa -- Shughuli za kupanga safu za nambari
//
// Hutoa kazi za kupanga safu kwa mpangilio wa kupanda na kushuka.
// Inatumia aina ya kiputo (bubble sort) kwa urahisi na usahihi.

// Panga safu ya n32 kwa mpangilio wa kupanda.
w0 pangilia_n32(n32* safu, n32 idadi) {
    kama (idadi <= 1) {
        rudisha;
    }
    n32 i = 0;
    wakati (i < idadi - 1) {
        n32 j = 0;
        wakati (j < idadi - i - 1) {
            kama (safu[j] > safu[j + 1]) {
                n32 muda = safu[j];
                safu[j] = safu[j + 1];
                safu[j + 1] = muda;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

