husisha { maktaba/kumbukumbu.swa }

// faili.swa — Shughuli za I/O za faili
//
// Hutoa usomaji, uandikaji, na ushughulikiaji wa faili kwa kutumia
// wito wa mfumo wa Linux moja kwa moja (sys_fungua, sys_soma,
// sys_andika, sys_funga kutoka kumbukumbu.swa) — HAKUNA libc.
// Awali moduli hii ilizungushia stdio ya C (fopen/fread/...); kwa
// kuwa maktaba haihitaji libc tena, kazi hizi zimeandikwa upya kwa
// syscalls. Moduli inakusanyika na kuendesha kwenye minyororo
// YOTE MIWILI (mbegu na stage1).
//
// Kishikio kinachorudishwa na faili_fungua ni n8* lenye thamani ya
// deskripta ya faili (fd) — si kielekezi halisi kinachoweza kusomwa.
// Kipitishe tu kwa kazi nyingine za moduli hii; usijaribu kukibomoa.
//
// Hali za ufunguzi zinazotumika na faili_fungua:
//   "r"  — soma tu (faili lazima liwepo)
//   "w"  — andika tu (huunda upya kama lipo, ruhusa 0644)
//   "a"  — ongeza mwishoni (huunda kama halipo, ruhusa 0644)
//   "r+" — soma na andika (faili lazima liwepo)
//   "w+" — soma na andika (huunda upya, ruhusa 0644)
//   "a+" — soma na ongeza (huunda kama halipo, ruhusa 0644)

// Ruhusa za faili zinazoundwa na O_CREAT (0644 = soma/andika kwa
// mmiliki, soma kwa kikundi na wengine). Inapaswa kupitishwa kwa
// sys_fungua kama hoja ya 3 — bila hiyo kernel huunda faili lenye
// ruhusa 0000 (halifunguki kwa usomaji).
n64 faili_ruhusa = 420;

// Mchoro wa namna ("r"/"w"/"a"[+"]) hadi bendera za open(2):
// O_RDONLY=0, O_WRONLY=1, O_RDWR=2, O_CREAT=64, O_TRUNC=512,
// O_APPEND=1024.
N64 faili_bendera(N8* namna) {
    N64 b = 0;
    kama (namna[0] == 119) { b = 1; }  // 'w' — andika
    kama (namna[0] == 97) { b = 1; }  // 'a' — ongeza
    kama (namna[1] == 43) { b = 2; }  // '+' — soma na andika (O_RDWR)
    kama (namna[0] == 119 || namna[0] == 97) {
        b = b + 64;  // O_CREAT
        kama (namna[0] == 119) { b = b + 512; }  // O_TRUNC
        kama (namna[0] == 97) { b = b + 1024; }  // O_APPEND
    }
    rudisha b;
}

// Fungua faili. Hurudisha kishikio (N8*) au 0 kwa kushindwa.
N8* faili_fungua(N8* njia, N8* namna) {
    N64 fd = sys_fungua(njia, faili_bendera(namna), faili_ruhusa);
    kama (fd < 0) { rudisha 0; }
    rudisha fd;  // N8* lenye thamani ya fd (si kielekezi halisi)
}

// Kishikio cha faili (fd) kutoka kwa kielekezi: faili_fungua hurudisha
// fd ndani ya N8* (0 = kushindwa). Ukaguzi wa hoja unakataa kielekezi
// kwa kigezo cha N32 tangu 2026-09-01 — ubadilishaji wazi.
N32 kishikio_kutoka_hoja(N8* f) {
    N32 k = f;
    rudisha k;
}

// Funga faili.
W0 faili_funga(N8* f) {
    kama (f != 0) {
        sys_funga(kishikio_kutoka_hoja(f));
    }
}

// Soma data kutoka faili. Hurudisha idadi ya vipengele vilivyosomwa
// (vipengele kamili; salio la mwisho linatupwa kama fread ya C).
N64 faili_soma(N8* buf, N64 ukubwa, N64 idadi, N8* f) {
    kama (f == 0) { rudisha 0; }
    kama (ukubwa == 0) { rudisha 0; }
    N64 n = sys_soma(kishikio_kutoka_hoja(f), buf, ukubwa * idadi);
    kama (n <= 0) { rudisha 0; }
    rudisha n / ukubwa;
}

// Andika data kwenye faili. Hurudisha idadi ya vipengele
// vilivyoandikwa.
N64 faili_andika(N8* buf, N64 ukubwa, N64 idadi, N8* f) {
    kama (f == 0) { rudisha 0; }
    kama (ukubwa == 0) { rudisha 0; }
    N64 n = sys_andika(kishikio_kutoka_hoja(f), buf, ukubwa * idadi);
    kama (n <= 0) { rudisha 0; }
    rudisha n / ukubwa;
}

// Soma faili lote na ulihifadhi kwenye bafa.
// Hurudisha urefu wa data iliyosomwa, au -1 kwa kushindwa.
// Bafa lazima iwe na nafasi ya kutosha (uwezo ni pamoja na NUL).
N64 faili_soma_yote(N8* njia, N8* buf, N64 uwezo) {
    N8* f = faili_fungua(njia, "r");
    kama (f == 0) { rudisha -1; }
    N64 n = 0;
    wakati (n + 1 < uwezo) {
        N64 r = sys_soma(kishikio_kutoka_hoja(f), buf + n, uwezo - 1 - n);
        kama (r <= 0) { vunja; }
        n = n + r;
    }
    faili_funga(f);
    buf[n] = 0;
    rudisha n;
}

// Andika mfuatano kwenye faili. Hurudisha 0 kwa mafanikio, -1 kwa
// kushindwa.
N32 faili_andika_yote(N8* njia, N8* data, N64 urefu) {
    N8* f = faili_fungua(njia, "w");
    kama (f == 0) { rudisha -1; }
    N64 n = sys_andika(kishikio_kutoka_hoja(f), data, urefu);
    faili_funga(f);
    kama (n < urefu) { rudisha -1; }
    rudisha 0;
}

// Angalia kama faili lipo (na linaweza kufunguliwa kwa usomaji).
N32 faili_ipo(N8* njia) {
    N8* f = faili_fungua(njia, "r");
    kama (f == 0) { rudisha 0; }
    faili_funga(f);
    rudisha 1;
}

// Soma mstari mmoja kutoka faili hadi bafa.
// Huacha kwenye '\n' (inayojumuishwa kwenye bafa) au EOF.
// Hurudisha urefu uliosomwa au -1 kwa mwisho.
N32 faili_soma_mstari(N8* f, N8* buf, N32 uwezo) {
    kama (f == 0 || uwezo <= 0) {
        rudisha -1;
    }
    N32 i = 0;
    wakati (i < uwezo - 1) {
        N8 c = 0;
        N64 r = sys_soma(kishikio_kutoka_hoja(f), &c, 1);
        kama (r <= 0) {  // EOF — hakuna baiti zaidi
            kama (i == 0) {
                rudisha -1;
            }
            vunja;
        }
        kama (c == 10) {  // '\n'
            buf[i] = c;
            i = i + 1;
            vunja;
        }
        buf[i] = c;
        i = i + 1;
    }
    buf[i] = 0;
    rudisha i;
}

// Futa faili (unlink). Hurudisha 0 kwa mafanikio, -1 kwa kushindwa.
N32 faili_futa(N8* njia) {
    rudisha wito_wa_mfumo(87, njia, 0, 0, 0, 0, 0);
}
