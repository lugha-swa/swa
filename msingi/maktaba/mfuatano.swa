husisha { maktaba/kumbukumbu.swa }

n64 urefu_wa_mfuatano(n8* s) {
    n64 n = 0;
    wakati (s[n] != 0) {
        n = n + 1;
    }
    rudisha n;
}

n32 linganisha_mfuatano(n8* a, n8* b) {
    n64 i = 0;
    wakati (a[i] != 0 && b[i] != 0) {
        kama (a[i] < b[i]) {
            rudisha -1;
        }
        kama (a[i] > b[i]) {
            rudisha 1;
        }
        i = i + 1;
    }
    kama (a[i] == 0 && b[i] == 0) {
        rudisha 0;
    }
    kama (a[i] == 0) {
        rudisha -1;
    }
    rudisha 1;
}

w0 nakili_mfuatano(n8* lengwa, n8* chanzo) {
    n64 i = 0;
    wakati (chanzo[i] != 0) {
        lengwa[i] = chanzo[i];
        i = i + 1;
    }
    lengwa[i] = 0;
}

w0 unganisha_mfuatano(n8* lengwa, n8* a, n8* b) {
    n64 i = 0;
    n64 j = 0;
    wakati (a[j] != 0) {
        lengwa[i] = a[j];
        i = i + 1;
        j = j + 1;
    }
    j = 0;
    wakati (b[j] != 0) {
        lengwa[i] = b[j];
        i = i + 1;
        j = j + 1;
    }
    lengwa[i] = 0;
}

n32 tafuta_herufi(n8* s, n8 c) {
    n32 i = 0;
    wakati (s[i] != 0) {
        kama (s[i] == c) {
            rudisha i;
        }
        i = i + 1;
    }
    rudisha -1;
}
n32 nambari_kwa_mfuatano(n32 n, n8* buf) {
    kama (n == 0) {
        buf[0] = 48;
        buf[1] = 0;
        rudisha 1;
    }
    n32 hasi = 0;
    n32 val = n;
    kama (n < 0) {
        buf[0] = 45;
        hasi = 1;
        val = 0 - n;
    }
    n32 len = 0;
    n32 tmp = val;
    wakati (tmp > 0) {
        len = len + 1;
        tmp = tmp / 10;
    }
    n32 pos = hasi + len;
    buf[pos] = 0;
    wakati (pos > hasi) {
        pos = pos - 1;
        buf[pos] = 48 + (val - (val / 10) * 10);
        val = val / 10;
    }
    rudisha hasi + len;
}
n32 linganisha_mfuatano_n(n8* a, n8* b, n64 n) {
    n64 i = 0;
    wakati (i < n) {
        kama (a[i] == 0 && b[i] == 0) {
            rudisha 0;
        }
        kama (a[i] == 0) {
            rudisha -1;
        }
        kama (b[i] == 0) {
            rudisha 1;
        }
        kama (a[i] < b[i]) {
            rudisha -1;
        }
        kama (a[i] > b[i]) {
            rudisha 1;
        }
        i = i + 1;
    }
    rudisha 0;
}
n32 tafuta_herufi_mwisho(n8* s, n8 c) {
    n32 matokeo = -1;
    n32 i = 0;
    wakati (s[i] != 0) {
        kama (s[i] == c) {
            matokeo = i;
        }
        i = i + 1;
    }
    rudisha matokeo;
}

// Ubadilishaji wa mfuatano hadi nambari.

n32 mfuatano_hadi_n32(n8* s) {
    n32 matokeo = 0;
    n32 hasi = 0;
    n32 i = 0;
    // Ruka nafasi nyeupe mwanzoni.
    wakati (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13) {
        i = i + 1;
    }
    // Angalia alama ya hasi/chanya.
    kama (s[i] == 45) {
        hasi = 1;
        i = i + 1;
    } sivyo {
        kama (s[i] == 43) {
            i = i + 1;
        }
    }
    // Soma tarakimu.
    wakati (s[i] >= 48 && s[i] <= 57) {
        matokeo = matokeo * 10 + (s[i] - 48);
        i = i + 1;
    }
    kama (hasi == 1) {
        rudisha 0 - matokeo;
    }
    rudisha matokeo;
}

n64 mfuatano_hadi_n64(n8* s) {
    n64 matokeo = 0;
    n32 hasi = 0;
    n32 i = 0;
    // Ruka nafasi nyeupe mwanzoni.
    wakati (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13) {
        i = i + 1;
    }
    // Angalia alama ya hasi/chanya.
    kama (s[i] == 45) {
        hasi = 1;
        i = i + 1;
    } sivyo {
        kama (s[i] == 43) {
            i = i + 1;
        }
    }
    // Soma tarakimu.
    wakati (s[i] >= 48 && s[i] <= 57) {
        matokeo = matokeo * 10 + (s[i] - 48);
        i = i + 1;
    }
    kama (hasi == 1) {
        rudisha 0 - matokeo;
    }
    rudisha matokeo;
}

// Umbizaji wa nambari hadi mfuatano.

// Badilisha n64 hadi mfuatano. Hurudisha urefu wa mfuatano ulioandikwa.
n32 nambari_kwa_mfuatano_n64(n64 n, n8* buf) {
    kama (n == 0) {
        buf[0] = 48;
        buf[1] = 0;
        rudisha 1;
    }
    n32 hasi = 0;
    n64 val = n;
    kama (n < 0) {
        buf[0] = 45;
        hasi = 1;
        val = 0 - n;
    }
    n32 len = 0;
    n64 tmp = val;
    wakati (tmp > 0) {
        len = len + 1;
        tmp = tmp / 10;
    }
    n32 pos = hasi + len;
    buf[pos] = 0;
    wakati (pos > hasi) {
        pos = pos - 1;
        buf[pos] = 48 + (val - (val / 10) * 10);
        val = val / 10;
    }
    rudisha hasi + len;
}

// tafuta_mfuatano — pata nafasi ya kwanza ya mfuatano mdogo ndani
// ya mfuatano mkubwa. Rudisha -1 ikiwa haupo.
n32 tafuta_mfuatano(n8* s, n8* ndogo) {
    n64 n = urefu_wa_mfuatano(ndogo);
    kama (n == 0) {
        rudisha 0;
    }
    n64 i = 0;
    wakati (s[i] != 0) {
        n64 j = 0;
        wakati (j < n && s[i + j] == ndogo[j]) {
            j = j + 1;
        }
        kama (j == n) {
            rudisha i;
        }
        i = i + 1;
    }
    rudisha -1;
}

// kata_nafasi — rudisha faharisi ya herufi ya kwanza isiyo nafasi,
// na urefu wa mwisho usio na nafasi (kupitia kielekezi). Inarudisha
// mwanzo mpya; *mwisho hupokea faharisi moja baada ya herufi ya
// mwisho isiyo nafasi (tayari kwa kunakili hadi hapo).
n32 kata_nafasi(n8* s, n64* mwisho) {
    n64 i = 0;
    wakati (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13) {
        i = i + 1;
    }
    n64 mw = i;
    n64 j = i;
    wakati (s[j] != 0) {
        j = j + 1;
    }
    wakati (j > mw && (s[j - 1] == 32 || s[j - 1] == 9 || s[j - 1] == 10 || s[j - 1] == 13)) {
        j = j - 1;
    }
    *mwisho = j;
    rudisha i;
}

// geuza_mfuatano — geuza mfuatano mahali pake (sio kwa nakala).
w0 geuza_mfuatano(n8* s) {
    n32 i = 0;
    n32 j = 0;
    wakati (s[j] != 0) { j = j + 1; }
    j = j - 1;
    wakati (i < j) {
        n8 t = s[i];
        s[i] = s[j];
        s[j] = t;
        i = i + 1;
        j = j - 1;
    }
}

// herufi_ya_juu — badilisha herufi ndogo hadi kubwa (ASCII).
n8 herufi_ya_juu(n8 c) {
    kama (c >= 97 && c <= 122) { rudisha c - 32; }
    rudisha c;
}

// herufi_ya_chini — badilisha herufi kubwa hadi ndogo (ASCII).
n8 herufi_ya_chini(n8 c) {
    kama (c >= 65 && c <= 90) { rudisha c + 32; }
    rudisha c;
}

// kompyuta_linganisha — linganisha mifuatano miwili bila kujali
// ukubwa wa herufi. Rudisha -1, 0, au 1.
n32 kompyuta_linganisha(n8* a, n8* b) {
    n32 i = 0;
    wakati (1 == 1) {
        n8 ca = herufi_ya_juu(a[i]);
        n8 cb = herufi_ya_juu(b[i]);
        kama (ca != cb) {
            kama (ca < cb) { rudisha -1; }
            rudisha 1;
        }
        kama (ca == 0) { rudisha 0; }
        i = i + 1;
    }
}

// anza_kwa_mfuatano — angalia kama s inaanza kwa kiambishi.
n32 anza_kwa_mfuatano(n8* s, n8* kiambishi) {
    n32 i = 0;
    wakati (kiambishi[i] != 0) {
        kama (s[i] != kiambishi[i]) { rudisha 0; }
        i = i + 1;
    }
    rudisha 1;
}

// isha_kwa_mfuatano — angalia kama s inaisha kwa kiambishi.
n32 isha_kwa_mfuatano(n8* s, n8* kiambishi) {
    n64 ns = urefu_wa_mfuatano(s);
    n64 nk = urefu_wa_mfuatano(kiambishi);
    kama (nk > ns) { rudisha 0; }
    n64 i = 0;
    wakati (i < nk) {
        kama (s[ns - nk + i] != kiambishi[i]) { rudisha 0; }
        i = i + 1;
    }
    rudisha 1;
}

// idadi_ya_herufi — hesabu idadi ya matukio ya herufi c kwenye s.
n32 idadi_ya_herufi(n8* s, n8 c) {
    n32 n = 0;
    n32 i = 0;
    wakati (s[i] != 0) {
        kama (s[i] == c) { n = n + 1; }
        i = i + 1;
    }
    rudisha n;
}

// nambari_kwa_mfuatano_heksa — badilisha n32 hadi mfuatano wa heksadesimali
// (herufi ndogo). Hurudisha urefu ulioandikwa.
n32 nambari_kwa_mfuatano_heksa(n32 n, n8* buf) {
    n8 tarakimu[16];
    n32 i = 0;
    n32 i2 = 0;
    wakati (i2 < 16) { tarakimu[i2] = 0; i2 = i2 + 1; }
    n32 val = n;
    kama (val == 0) {
        buf[0] = 48;
        buf[1] = 0;
        rudisha 1;
    }
    wakati (val != 0) {
        n32 d = val % 16;
        kama (d < 10) { tarakimu[i] = 48 + d; }
        sivyo { tarakimu[i] = 87 + d; }
        val = val / 16;
        i = i + 1;
    }
    n32 j = 0;
    wakati (i > 0) {
        i = i - 1;
        buf[j] = tarakimu[i];
        j = j + 1;
    }
    buf[j] = 0;
    rudisha j;
}

// heshi_mfuatano — heshi ya djb2 ya mfuatano (kwa jedwali la hashi).
n32 heshi_mfuatano(n8* s) {
    n32 h = 5381;
    n32 i = 0;
    wakati (s[i] != 0) {
        h = h * 33 + s[i];
        i = i + 1;
    }
    rudisha h;
}

// ==========================================================
// mfuatano_umbiza — "sprintf" ya Swa: umbiza mfuatano wa muundo +
// hoja (viashiria vilevile vya andika_ndani: %d %u %x %s %c %%)
// KWENYE BAFA, badala ya kuandika kwenye faili moja kwa moja.
// Muundo unaosaidiwa unafuata andika_ndani (kumbukumbu.swa) HASA --
// kazi hii ni tafsiri ya moja kwa moja ya mantiki hiyo hiyo, ikibadilisha
// tu lengwa la matokeo kutoka faili (sys_andika) kwenda bafa (kuandika
// moja kwa moja kwenye kumbukumbu).
//
// `uwezo` ni UKUBWA WA JUMLA wa bafa, IKIWEMO nafasi ya null
// terminator (kanuni ile ile ya faili.swa's faili_soma_yote) --
// matokeo hukatwa (truncate) SALAMA kama yangezidi uwezo-1 baiti,
// KAMWE hayaandiki nje ya bafa. Inarudisha idadi ya baiti
// zilizoandikwa (bila kuhesabu null terminator).
//
// Kama andika_ndani, hii ni njia ya WAKATI WA KUKIMBIA (runtime) --
// muundo (f) ni kigezo cha kawaida, si lazima uwe herufi halisi
// (literal) inayojulikana wakati wa kukusanya.

w0 bafa_herufi(n8* bafa, n64 uwezo, n64* nafasi, n64 b) {
    kama (*nafasi + 1 < uwezo) {
        bafa[*nafasi] = b;
        *nafasi = *nafasi + 1;
    }
}

w0 bafa_mfuatano(n8* bafa, n64 uwezo, n64* nafasi, n8* s) {
    n64 i = 0;
    wakati (s[i] != 0) {
        bafa_herufi(bafa, uwezo, nafasi, s[i]);
        i = i + 1;
    }
}

w0 bafa_n64(n8* bafa, n64 uwezo, n64* nafasi, n64 v) {
    n32 tmp[32];
    n32 n = 0;
    kama (v < 0) {
        bafa_herufi(bafa, uwezo, nafasi, 45);
        v = 0 - v;
    }
    wakati (1 == 1) {
        tmp[n] = v - ((v / 10) * 10);
        n = n + 1;
        v = v / 10;
        kama (v == 0) { vunja; }
    }
    wakati (n > 0) {
        n = n - 1;
        bafa_herufi(bafa, uwezo, nafasi, 48 + tmp[n]);
    }
}

// bafa_u64 — angalia maelezo ya hesabu kwenye andika_u64
// (kumbukumbu.swa): thamani hasi huonyeshwa kama mfuatano kamili wa
// bits 64, sio kama nambari yenye alama.
w0 bafa_u64(n8* bafa, n64 uwezo, n64* nafasi, n64 v) {
    n32 tmp[32];
    n32 n = 0;
    kama (v < 0) {
        n64 u = v + 6;
        n64 d = u % 10;
        n32 ni_hasi_x = 0;
        kama (d < 0) { d = d + 10; ni_hasi_x = 1; }
        tmp[n] = d;
        n = n + 1;
        v = 1844674407370955161 + u / 10;
        kama (ni_hasi_x) { v = v - 1; }
    }
    wakati (1 == 1) {
        tmp[n] = v - ((v / 10) * 10);
        n = n + 1;
        v = v / 10;
        kama (v == 0) { vunja; }
    }
    wakati (n > 0) {
        n = n - 1;
        bafa_herufi(bafa, uwezo, nafasi, 48 + tmp[n]);
    }
}

w0 bafa_heksa(n8* bafa, n64 uwezo, n64* nafasi, n64 v) {
    n32 imeanza = 0;
    n32 i = 15;
    wakati (i >= 0) {
        n32 d = (v >> (4 * i)) & 15;
        kama (d != 0 || imeanza) {
            imeanza = 1;
            kama (d < 10) { bafa_herufi(bafa, uwezo, nafasi, 48 + d); }
            sivyo { bafa_herufi(bafa, uwezo, nafasi, 87 + d); }
        }
        i = i - 1;
    }
    kama (imeanza == 0) { bafa_herufi(bafa, uwezo, nafasi, 48); }
}

n64 mfuatano_umbiza(n8* bafa, n64 uwezo, n8* f, n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6) {
    kama (uwezo == 0) { rudisha 0; }
    n64 nafasi = 0;
    n32 p = 0;
    n32 na = 0;
    wakati (1 == 1) {
        kama (f[p] == 0) { vunja; }
        kama (f[p] == 37) {  // '%'
            n8 sp = f[p + 1];
            kama (sp == 0) {
                bafa_herufi(bafa, uwezo, &nafasi, 37);
                p = p + 1;
                endelea;
            }
            p = p + 2;
            kama (sp == 100) {  // %d
                bafa_n64(bafa, uwezo, &nafasi, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                na = na + 1;
            } sivyo { kama (sp == 117) {  // %u
                    bafa_u64(bafa, uwezo, &nafasi, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                    na = na + 1;
                } sivyo { kama (sp == 120) {  // %x
                        bafa_heksa(bafa, uwezo, &nafasi, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                        na = na + 1;
                    } sivyo { kama (sp == 115) {  // %s
                            bafa_mfuatano(bafa, uwezo, &nafasi, kielekezi_kutoka_hoja(hoja_kwa_na(a1, a2, a3, a4, a5, a6, na)));
                            na = na + 1;
                        } sivyo { kama (sp == 99) {  // %c
                                bafa_herufi(bafa, uwezo, &nafasi, hoja_kwa_na(a1, a2, a3, a4, a5, a6, na));
                                na = na + 1;
                            } sivyo { kama (sp == 37) {  // %%
                                    bafa_herufi(bafa, uwezo, &nafasi, 37);
                                } sivyo {
                                    // Visivyosaidiwa — chapisha kama herufi halisi.
                                    bafa_herufi(bafa, uwezo, &nafasi, 37);
                                    bafa_herufi(bafa, uwezo, &nafasi, sp);
                                } } } } } }
            endelea;
        }
        kama (f[p] == 92 && f[p + 1] == 110) {  // \n (mfuatano wa kawaida)
            bafa_herufi(bafa, uwezo, &nafasi, 10);
            p = p + 2;
            endelea;
        }
        bafa_herufi(bafa, uwezo, &nafasi, f[p]);
        p = p + 1;
    }
    bafa[nafasi] = 0;
    rudisha nafasi;
}
