// hesabu.swa — Shughuli za hisabati
//
// Inatoa kazi za msingi za kulinganisha nambari na kukokotoa
// maadili kamili. Hizi ni muhimu kwa algorithms nyingi za msingi.

// Rudisha nambari kubwa kati ya mbili (n32).
n32 hesabu_kamili(n32 a, n32 b) {
    kama (a > b) {
        rudisha a;
    }
    rudisha b;
}

// Rudisha nambari ndogo kati ya mbili (n32).
n32 hesabu_ndogo(n32 a, n32 b) {
    kama (a < b) {
        rudisha a;
    }
    rudisha b;
}

// Rudisha nambari kubwa kati ya mbili (n64).
n64 hesabu_kubwa(n64 a, n64 b) {
    kama (a > b) {
        rudisha a;
    }
    rudisha b;
}

// Rudisha nambari ndogo kati ya mbili (n64).
n64 hesabu_dogo(n64 a, n64 b) {
    kama (a < b) {
        rudisha a;
    }
    rudisha b;
}

// Thamani kamili ya n32.
n32 neneo_n32(n32 n) {
    kama (n < 0) {
        rudisha 0 - n;
    }
    rudisha n;
}

// Thamani kamili ya n64.
n64 neneo_n64(n64 n) {
    kama (n < 0) {
        rudisha 0 - n;
    }
    rudisha n;
}

// gcd — kigawanyo kikubwa cha pamoja (algorithm ya Euclid)
n32 gcd_hesabu(n32 a, n32 b) {
    a = neneo_n32(a);
    b = neneo_n32(b);
    wakati (b != 0) {
        n32 t = a % b;
        a = b;
        b = t;
    }
    rudisha a;
}

// pow_kamili — kipeo cha nambari kamili (msingi ^ kipeo)
n32 pow_kamili(n32 msingi, n32 kipeo) {
    n32 r = 1;
    n32 i = 0;
    wakati (i < kipeo) { r = r * msingi; i = i + 1; }
    rudisha r;
}

// isqrt — kipeuo cha pili kamili (njia ya Newton kwa nambari kamili)
n32 isqrt_hesabu(n32 n) {
    kama (n <= 1) { rudisha n; }
    n32 x = n;
    n32 y = (x + 1) / 2;
    wakati (y < x) {
        x = y;
        y = (x + n / x) / 2;
    }
    rudisha x;
}

// fibonacci_hesabu — nambari ya Fibonacci kwa njia ya kujirudia
n32 fibonacci_hesabu(n32 n) {
    kama (n <= 1) { rudisha n; }
    rudisha fibonacci_hesabu(n - 1) + fibonacci_hesabu(n - 2);
}

// kipengele_hesabu — n! (kipengele). Rudisha 0 kwa n < 0 au n > 12
// (n32 inazidi kuanzia 13!).
n32 kipengele_hesabu(n32 n) {
    kama (n < 0 || n > 12) { rudisha 0; }
    n32 r = 1;
    n32 i = 2;
    wakati (i <= n) { r = r * i; i = i + 1; }
    rudisha r;
}

// ni_kuu_hesabu — angalia kama n ni namba kuu (1 = kuu, 0 = sivyo).
// Inajaribu vigawanyo visivyo hata hadi kipeuo cha pili cha n.
n32 ni_kuu_hesabu(n32 n) {
    kama (n < 2) { rudisha 0; }
    kama (n == 2 || n == 3) { rudisha 1; }
    kama (n % 2 == 0) { rudisha 0; }
    n32 i = 3;
    wakati (i * i <= n) {
        kama (n % i == 0) { rudisha 0; }
        i = i + 2;
    }
    rudisha 1;
}

// lcm_hesabu — kigawo kidogo cha pamoja (LCM) cha a na b.
n32 lcm_hesabu(n32 a, n32 b) {
    kama (a == 0 || b == 0) { rudisha 0; }
    n32 g = gcd_hesabu(a, b);
    rudisha neneo_n32((a / g) * b);
}

// pow_mod_hesabu — (msingi^kipeo) % mod kwa njia ya kurudia mara mbili.
// Kikomo: mod lazima iwe chini ya 32768 (ili (r*ms) isizidi n32).
n32 pow_mod_hesabu(n32 msingi, n32 kipeo, n32 mod) {
    kama (mod <= 1) { rudisha 0; }
    n32 r = 1;
    n32 ms = msingi % mod;
    kama (ms < 0) { ms = ms + mod; }
    n32 kp = kipeo;
    wakati (kp > 0) {
        kama (kp % 2 == 1) { r = (r * ms) % mod; }
        ms = (ms * ms) % mod;
        kp = kp / 2;
    }
    rudisha r;
}

// ==========================================================
// Hesabu za d64 transcendental (lugha-swa/swa#183)
//
// Kabla ya hii, hesabu.swa haikuwa na sin/cos/atan2/mzizi/kielelezi/
// logasili/kuinua kwa d64 kabisa -- kila mradi uliohitaji alilazimika
// kuandika upya kutoka mwanzo (mfano mradi wa Dominion, ambako
// vialgorithm hivi vilianzia na kujaribiwa kwa nambari halisi kabla
// ya kuhamishwa hapa). Hakuna libc/math.h -- kila kazi ni algorithm
// safi ya Swa (mfululizo wa Taylor/Gregory, upunguzaji wa masafa,
// njia ya Newton).
// ==========================================================

// kielelezi_hesabu: e^x (badala ya expf/exp ya libc) kwa mfululizo
// wa Taylor (maneno 30). Sahihi vya kutosha kwa x kati ya -3 na 1
// (imethibitishwa hapa chini); si sahihi kwa x kubwa sana chanya
// (mfululizo hausambamki haraka kwa hoja kubwa).
d64 kielelezi_hesabu(d64 x) {
    d64 jumla = 1.0;
    d64 neno = 1.0;
    n32 n = 1;
    wakati (n <= 30) {
        d64 n_d = n;
        neno = neno * x / n_d;
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla;
}

// mzizi_hesabu: mzizi wa mraba (badala ya sqrt ya libc) kwa mbinu ya
// Newton (marudio 25). x hasi hurudisha 0.0 (hakuna mzizi halisi).
d64 mzizi_hesabu(d64 x) {
    kama (x <= 0.0) { rudisha 0.0; }
    d64 kisio = x;
    kama (kisio < 1.0) { kisio = 1.0; }
    n32 n = 0;
    wakati (n < 25) {
        kisio = 0.5 * (kisio + x / kisio);
        n = n + 1;
    }
    rudisha kisio;
}

// logasili_hesabu: logarithm ya asili (ln, badala ya log() ya libc).
// kielelezi_hesabu (exp) kwa Taylor haisambamki vizuri kwa x kubwa,
// kwa hiyo hapa: upunguzaji wa masafa (x inagawanywa/kuzidishwa mara
// kwa mara kwa 2 hadi iwe kati ya 0.5 na 2.0, idadi ya hatua = k),
// kisha mfululizo wa atanh (unaosambamka haraka kwa hoja ndogo):
// ln(x_iliyopunguzwa) = 2*atanh((x-1)/(x+1)). Hatimaye
// ln(x_asili) = ln(x_iliyopunguzwa) + k * ln(2). x<=0.0 hurudisha 0.0.
d64 logasili_hesabu(d64 x) {
    kama (x <= 0.0) { rudisha 0.0; }

    // MUHIMU: maneno ya d64 yenye tarakimu nyingi (>~10 baada ya
    // nukta) huchanganuliwa vibaya KIMYA KIMYA (lugha-swa/swa#188) --
    // 0.6931471805 (tarakimu 10) ni ndani ya kikomo salama.
    d64 LN2 = 0.6931471805;
    n32 k = 0;
    d64 xr = x;
    wakati (xr > 2.0) {
        xr = xr / 2.0;
        k = k + 1;
    }
    wakati (xr < 0.5) {
        xr = xr * 2.0;
        k = k - 1;
    }

    d64 z = (xr - 1.0) / (xr + 1.0);
    d64 z2 = z * z;
    d64 jumla = 0.0;
    d64 neno = z;
    n32 i = 1;
    wakati (i <= 40) {
        d64 i_d = i;
        jumla = jumla + neno / i_d;
        neno = neno * z2;
        i = i + 2;
    }

    d64 k_d = k;
    rudisha 2.0 * jumla + k_d * LN2;
}

// kuinua_hesabu: x kwa nguvu ya y (badala ya pow() ya libc), kwa
// x > 0 pekee. x^y = exp(y * ln(x)). x <= 0.0 hurudisha 0.0.
d64 kuinua_hesabu(d64 x, d64 y) {
    kama (x <= 0.0) { rudisha 0.0; }
    rudisha kielelezi_hesabu(y * logasili_hesabu(x));
}

// pi_hesabu: thamani ya pi (kazi, si kigezo cha ulimwengu -- kigezo
// cha ulimwengu cha d64 hakijawahi kujaribiwa kwenye mradi huu, kwa
// hiyo tunaepuka hatari isiyojulikana). 3.1415926536 ni herufi 12
// jumla, ndani ya kikomo salama cha #188.
d64 pi_hesabu() {
    rudisha 3.1415926536;
}

// sin_hesabu/cos_hesabu: hupunguza masafa (range reduction) kwenda
// (-pi,pi] kwa kutoa/kuongeza 2*pi mara kwa mara, kisha mfululizo wa
// Taylor wa moja kwa moja (maneno 20) -- imethibitishwa kusambamka
// vizuri ndani ya (-pi,pi] bila upunguzaji zaidi kwenda robo-mzunguko.
d64 sin_hesabu(d64 x) {
    d64 pi = pi_hesabu();
    d64 pi2 = pi + pi;
    wakati (x > pi) { x = x - pi2; }
    wakati (x <= (0.0 - pi)) { x = x + pi2; }

    d64 x2 = x * x;
    d64 jumla = x;
    d64 neno = x;
    n32 n = 1;
    wakati (n <= 20) {
        d64 n_d = n;
        d64 chini1 = 2.0 * n_d;
        d64 chini2 = chini1 + 1.0;
        neno = neno * (0.0 - x2) / (chini1 * chini2);
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla;
}

d64 cos_hesabu(d64 x) {
    d64 pi = pi_hesabu();
    d64 pi2 = pi + pi;
    wakati (x > pi) { x = x - pi2; }
    wakati (x <= (0.0 - pi)) { x = x + pi2; }

    d64 x2 = x * x;
    d64 jumla = 1.0;
    d64 neno = 1.0;
    n32 n = 1;
    wakati (n <= 20) {
        d64 n_d = n;
        d64 chini1 = 2.0 * n_d - 1.0;
        d64 chini2 = 2.0 * n_d;
        neno = neno * (0.0 - x2) / (chini1 * chini2);
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla;
}

// atan_ndogo_hesabu: kazi ya ndani (msaidizi) -- atan(t) kwa t ndani
// ya [0.0, 1.0] pekee. Mfululizo wa Gregory unasambamka POLEPOLE SANA
// karibu na t=1.0, kwa hiyo t inapunguzwa mara tatu kwa kigezo cha
// "nusu-pembe" (atan(t) = 2*atan(t/(1+sqrt(1+t^2)))) KABLA ya
// mfululizo. Tumia atan_hesabu/atan2_hesabu badala yake -- hii ni
// msaidizi wa ndani.
d64 atan_ndogo_hesabu(d64 t) {
    d64 u1 = t / (1.0 + mzizi_hesabu(1.0 + t * t));
    d64 u2 = u1 / (1.0 + mzizi_hesabu(1.0 + u1 * u1));
    d64 u3 = u2 / (1.0 + mzizi_hesabu(1.0 + u2 * u2));

    d64 u2sq = u3 * u3;
    d64 jumla = u3;
    d64 neno = u3;
    n32 n = 1;
    wakati (n <= 20) {
        d64 n_d = n;
        d64 juu = 2.0 * n_d - 1.0;
        d64 chini = 2.0 * n_d + 1.0;
        neno = neno * (0.0 - u2sq) * juu / chini;
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla * 8.0;
}

// atan_hesabu: atan(t) kwa t YOYOTE halisi. t hasi hushughulikiwa kwa
// ulinganifu (atan ni kazi isiyo ya kawaida); |t| > 1.0 hushughulikiwa
// kwa kitambulisho atan(t) = pi/2 - atan(1/t).
d64 atan_hesabu(d64 t) {
    n32 hasi = 0;
    d64 tt = t;
    kama (tt < 0.0) { hasi = 1; tt = 0.0 - tt; }

    d64 matokeo = atan_ndogo_hesabu(tt);
    kama (tt > 1.0) {
        matokeo = (pi_hesabu() / 2.0) - atan_ndogo_hesabu(1.0 / tt);
    }

    kama (hasi == 1) { matokeo = 0.0 - matokeo; }
    rudisha matokeo;
}

// atan2_hesabu: pembe kamili (mzunguko mzima, -pi hadi pi) ya (y, x),
// kwa mantiki ya robo (quadrant) ya kawaida ya atan2. x==0.0 na
// y==0.0 (isiyofafanuliwa kihisabati) hurudisha 0.0.
d64 atan2_hesabu(d64 y, d64 x) {
    kama (x > 0.0) { rudisha atan_hesabu(y / x); }
    kama (x < 0.0) {
        kama (y >= 0.0) { rudisha atan_hesabu(y / x) + pi_hesabu(); }
        rudisha atan_hesabu(y / x) - pi_hesabu();
    }
    kama (y > 0.0) { rudisha pi_hesabu() / 2.0; }
    kama (y < 0.0) { rudisha 0.0 - (pi_hesabu() / 2.0); }
    rudisha 0.0;
}
