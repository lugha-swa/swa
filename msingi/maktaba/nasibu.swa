// nasibu.swa -- namba za nasibu (si za usalama), kwa Swa safi.
//
// Jenereta ni xorshift64* (Vigna): hali ya biti 64, kipindi 2^64 - 1.
// Thamani ya kuanzia ile ile hutoa mfuatano ule ule -- kwa majaribio yanayozalika
// upya. nasibu_kutoka_mfumo() huchukua thamani ya kuanzia kutoka kernel
// (getrandom(2), syscall 318) kwa matokeo tofauti kila mara.

n64 nasibu_hali = 88172645463325252;

// Weka thamani ya kuanzia. Thamani 0 haifai kwa xorshift (ingebaki 0 milele),
// kwa hiyo inabadilishwa kuwa thamani isiyo sifuri.
w0 nasibu_anzisha(n64 thamani_ya_kuanzia) {
    kama (thamani_ya_kuanzia == 0) { thamani_ya_kuanzia = 88172645463325252; }
    nasibu_hali = thamani_ya_kuanzia;
}

// Thamani ya kuanzia kutoka kernel. Hurudisha 1 ikifaulu, 0 kama getrandom
// haikupatikana (thamani ya sasa inabaki).
n32 nasibu_kutoka_mfumo() {
    n64* b = tenga(8);
    n64 n = wito_wa_mfumo(318, b, 8, 0, 0, 0, 0);
    kama (n != 8) { rudisha 0; }
    nasibu_anzisha(b[0]);
    rudisha 1;
}

// Biti 64 za nasibu.
n64 nasibu_n64() {
    n64 x = nasibu_hali;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    nasibu_hali = x;
    rudisha x * 2685821657736338717;
}

// Namba isiyo hasi katika [0, 2^31 - 1].
n32 nasibu_n32() {
    rudisha (nasibu_n64() >> 33) & 2147483647;
}

// Namba katika [0, upeo). upeo <= 0 hurudisha 0.
n32 nasibu_katikati(n32 upeo) {
    kama (upeo <= 0) { rudisha 0; }
    rudisha nasibu_n32() % upeo;
}
