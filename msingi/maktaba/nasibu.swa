husisha C::stdlib

// nasibu.swa — Shughuli za nambari nasibu
//
// Hutoa kazi za kuzalisha nambari nasibu kwa kutumia
// rand() na srand() ya maktaba ya C.

// Weka mbegu ya jenereta ya nambari nasibu.
// Tumia kabla ya nasibu_n32() kwa matokeo tofauti.
w0 nasibu_anzisha(n32 mbegu) {
    srand(mbegu);
}

// Zalisha nambari nasibu kati ya 0 na RAND_MAX.
n32 nasibu_n32() {
    rudisha rand();
}

// Zalisha nambari nasibu katika fungu [0, upeo).
n32 nasibu_katikati(n32 upeo) {
    kama (upeo <= 0) {
        rudisha 0;
    }
    rudisha rand() % upeo;
}
