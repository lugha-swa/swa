da 02 00 00 00 00 00 00 ; p_filesz: 730
00 00 40 00 00 00 00 00 ; p_memsz: MB 4 -- kuingiza 0x500000, kutoa 0x600000, jedwali la lebo 0x700000
00 10 00 00 00 00 00 00 ; p_align: 0x1000

