# hatua1_maoni.maoni -- hatua ya 1 ya mfululizo huru: heksa yenye maoni.
#
# Kama kwanza (heksa -> binari), lakini ';' au '#' huanzisha maoni hadi
# mwisho wa mstari. Imeandikwa kwa mkono: kila mstari ni baiti za agizo
# moja na agizo lenyewe kwenye maoni, ili kila baiti ikaguliwe kwa jicho.
# kwanza hujenga hatua1_maoni.heksa (baiti zile zile bila maoni); maoni
# iliyojengwa lazima ijijenge yenyewe sawa kwa baiti kutoka faili hili.
#
# rejista: r12 kielekezi cha kutoa, r13 baiti inayojengwa, r14 nusu
# ya kwanza imeonekana, r15 ndani ya maoni, r3/r8 kusoma chombo.

# ---- utangulizi wa ELF (baiti 64) ----
7f 45 4c 46             ; ELF: alama ya uchawi \x7f E L F
02 01 01 00             ; biti 64, little-endian, toleo 1, ABI ya System V
00 00 00 00 00 00 00 00 ; nafasi tupu (kujaza)
02 00                   ; aina ya faili: faili linalotekelezwa (EXEC)
3e 00                   ; mashine: x86-64
01 00 00 00             ; toleo: 1
78 00 40 00 00 00 00 00 ; kiingilio: 0x400078 (mara baada ya utangulizi na maelezo ya kipande)
40 00 00 00 00 00 00 00 ; umbali wa maelezo ya vipande: maelezo ya kipande yako kwenye umbali 64
00 00 00 00 00 00 00 00 ; umbali wa maelezo ya sehemu: hakuna sehemu (sehemu)
00 00 00 00             ; machaguo ya ELF
40 00                   ; ukubwa wa utangulizi: 64
38 00                   ; ukubwa wa maelezo ya kipande: 56
01 00                   ; idadi ya vipande: maelezo ya kipande 1
00 00 00 00 00 00       ; ukubwa wa maelezo ya sehemu, idadi ya sehemu, faharisi ya majina ya sehemu: 0

# ---- maelezo ya kipande (baiti 56) ----
01 00 00 00             ; aina ya kipande: PT_LOAD
07 00 00 00             ; ruhusa za kipande: soma + andika + tekeleza
00 00 00 00 00 00 00 00 ; umbali kwenye faili: 0
00 00 40 00 00 00 00 00 ; anwani pepe: 0x400000
00 00 40 00 00 00 00 00 ; anwani halisi: 0x400000
90 01 00 00 00 00 00 00 ; ukubwa kwenye faili: 400 (baiti za faili zima)
00 09 00 00 00 00 00 00 ; ukubwa kwenye kumbukumbu: 0x900 -- chombo: kuingiza 0x400300 (1024), kutoa 0x400700 (512)
00 10 00 00 00 00 00 00 ; mpangilio wa kipande: 0x1000

