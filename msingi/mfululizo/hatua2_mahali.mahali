# hatua2_mahali.mahali -- hatua ya 2 ya mfululizo huru: heksa yenye mahali. (mahali hujijenga yenyewe)
#
#   ; au #  maoni hadi mwisho wa mstari
#   :jina   fafanua mahali kwenye anwani ya sasa (0x400000 + umbali)
#   !jina   umbali wa baiti 1 hadi mahali, kutoka mwisho wa sehemu
#   %jina   umbali wa baiti 4 hadi mahali, kutoka mwisho wa sehemu
#   &jina   anwani kamili ya mahali, baiti 4
#   heksa     jozi za tarakimu -> baiti
# Mapitio mawili juu ya stdin yote. Mahali hapajulikani: kutoka 2; !jina
# nje ya -128..127: kutoka 3. Rejista: r5/r15 mwanzo/mwisho wa kuingiza,
# r12 umbali wa kutoa, r14 pitio (1/2), r9 mwisho wa jedwali la mahali,
# r10/r11 baiti inayojengwa na nusu yake.

# ---- utangulizi wa ELF (baiti 64) ----
7f 45 4c 46             ; ELF: alama ya uchawi
02 01 01 00             ; biti 64, little-endian, toleo 1, System V
00 00 00 00 00 00 00 00 ; nafasi tupu
02 00                   ; aina ya faili: EXEC
3e 00                   ; mashine: x86-64
01 00 00 00             ; toleo: 1
78 00 40 00 00 00 00 00 ; kiingilio: 0x400078
40 00 00 00 00 00 00 00 ; umbali wa maelezo ya vipande: 64
00 00 00 00 00 00 00 00 ; umbali wa maelezo ya sehemu: hakuna sehemu
00 00 00 00             ; machaguo ya ELF
40 00                   ; ukubwa wa utangulizi: 64
38 00                   ; ukubwa wa maelezo ya kipande: 56
01 00                   ; idadi ya vipande: 1
00 00 00 00 00 00       ; ukubwa wa maelezo ya sehemu, idadi ya sehemu, faharisi ya majina ya sehemu: 0

# ---- maelezo ya kipande (baiti 56) ----
01 00 00 00             ; aina ya kipande: PT_LOAD
07 00 00 00             ; ruhusa za kipande: soma + andika + tekeleza
00 00 00 00 00 00 00 00 ; umbali kwenye faili: 0
00 00 40 00 00 00 00 00 ; anwani pepe: 0x400000
00 00 40 00 00 00 00 00 ; anwani halisi: 0x400000
da 02 00 00 00 00 00 00 ; ukubwa kwenye faili: 730
00 00 40 00 00 00 00 00 ; ukubwa kwenye kumbukumbu: MB 4 -- kuingiza 0x500000, kutoa 0x600000, jedwali la mahali 0x700000
00 10 00 00 00 00 00 00 ; mpangilio wa kipande: 0x1000

