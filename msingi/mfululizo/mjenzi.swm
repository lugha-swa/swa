n8 neno_kiungo = "kiungo", 0
n8 neno_ina = "ina", 0

; jedwali_amri: (neno, kazi), mwisho 0
n64 jedwali_amri = neno_saraka, amri_saraka
n64 = neno_endesha, amri_endesha
n64 = neno_endesha_kosa, amri_endesha_kosa
n64 = neno_sawa, amri_sawa
n64 = neno_nakili, amri_nakili
n64 = neno_unganisha, amri_unganisha
