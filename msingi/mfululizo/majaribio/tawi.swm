; tawi.swm -- linganisha na kuruka kwa familia: -5 <n 3 ni kweli, lakini <a si kweli
anza:
        r1d = -5
        r7d = 0
        linganisha r1d, 3
        ruka .dogo kama <n
        r7d = 100
.dogo:
        r7d = r7d
        linganisha r1d, 3
        ruka .mwisho kama <a      ; 0xfffffffb < 3 bila ishara? hapana
        r7d = 42
.mwisho:
        r0d = 60
        mfumo
