; mfumo.swm -- maagizo ya mfumo na picha tambarare (majaribio ya kusanyiko).
; Matokeo yalikaguliwa mara moja dhidi ya NASM (mfumo.heksa: picha nzima kama hex ya kwanza.bin).
picha 0x7c00
biti 32
anza32:
        katizo_zima
        katizo_washa
        simama
        soma_msr
        andika_msr
        r0d = cr0
        cr0 = r0d
        r3d = cr4
        cr3 = r7d
        r0w = ds
        ds = r0w
        ss = r1w
        n32[mahali_data] = r0d
        r0d = n32[mahali_data]
        n16[mahali_data] = r0w
        r0b = n8[mahali_data + 1]
        n32[mahali_data + 4] = 7
        r1d = n32[r3 + 8]
        pakia_gdt [mahali_data]
        pakia_idt [mahali_data]
        ruka_mbali 8, anza64
biti 64
anza64:
        r0 = cr3
        cr4 = r0
        cr8 = r1
        es = r0w
        pakia_gdt [mahali_data]
        rudi_katizo
        mfumo
        nakili
        mwelekeo_mbele
        rudi
pangilia 16
n32 mahali_data = 1, 2
n16 = 3
n8 tupu_ndani[5]
n8 = 9
