; habari.swm -- programu ya kwanza kwa lugha ya mashine ya Swa
n8 ujumbe = "habari kutoka lugha ya mashine ya Swa", 10
fafanua UREFU = 38

anza:
        r0d = 1                 ; andika
        r7d = 1                 ; stdout
        r6d = ujumbe
        r2d = UREFU
        mfumo
        r0d = 60                ; toka
        r7d = 0
        mfumo
