# hatua1_maoni.hexc -- hatua ya 1 ya mnyororo huru: hex yenye maoni.
#
# Kama kwanza (hex -> binary), lakini ';' au '#' huanzisha maoni hadi
# mwisho wa mstari. Imeandikwa kwa mkono: kila mstari ni baiti za agizo
# moja na agizo lenyewe kwenye maoni, ili kila baiti ikaguliwe kwa jicho.
# kwanza hujenga hatua1_maoni.hex (baiti zile zile bila maoni); maoni
# iliyojengwa lazima ijijenge yenyewe sawa kwa baiti kutoka faili hili.
#
# rejista: r12 kielekezi cha kutoa, r13 baiti inayojengwa, r14 nusu
# ya kwanza imeonekana, r15 ndani ya maoni, rbx/r8 kusoma bafa.

# ---- kichwa cha ELF (baiti 64) ----
7f 45 4c 46             ; ELF: alama ya uchawi \x7f E L F
02 01 01 00             ; biti 64, little-endian, toleo 1, ABI ya System V
00 00 00 00 00 00 00 00 ; nafasi tupu (padding)
02 00                   ; e_type: faili linalotekelezwa (EXEC)
3e 00                   ; e_machine: x86-64
01 00 00 00             ; e_version: 1
78 00 40 00 00 00 00 00 ; e_entry: 0x400078 (mara baada ya vichwa)
40 00 00 00 00 00 00 00 ; e_phoff: kichwa cha programu kiko kwenye ofseti 64
00 00 00 00 00 00 00 00 ; e_shoff: hakuna sehemu (sections)
00 00 00 00             ; e_flags
40 00                   ; e_ehsize: 64
38 00                   ; e_phentsize: 56
01 00                   ; e_phnum: kichwa 1 cha programu
00 00 00 00 00 00       ; e_shentsize, e_shnum, e_shstrndx: 0

# ---- kichwa cha programu (baiti 56) ----
01 00 00 00             ; p_type: PT_LOAD
07 00 00 00             ; p_flags: soma + andika + tekeleza
00 00 00 00 00 00 00 00 ; p_offset: 0
00 00 40 00 00 00 00 00 ; p_vaddr: 0x400000
00 00 40 00 00 00 00 00 ; p_paddr: 0x400000
90 01 00 00 00 00 00 00 ; p_filesz: 400 (baiti za faili zima)
00 09 00 00 00 00 00 00 ; p_memsz: 0x900 -- bafa: kuingiza 0x400300 (1024), kutoa 0x400700 (512)
00 10 00 00 00 00 00 00 ; p_align: 0x1000

