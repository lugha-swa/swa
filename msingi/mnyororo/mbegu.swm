n8 tn_d64 = "D64", 0

; Herufi ndogo (sawa na lugha-swa/swa#225 kwenye mkusanyaji uliojijenga)
; -- alama HASA za walio juu, si aina mpya. Angalia changanua_aina na
; ukubwa(...) chini kwa jinsi zinavyotumika.
n8 tn_n8_ndogo = "n8", 0
n8 tn_n16_ndogo = "n16", 0
n8 tn_n32_ndogo = "n32", 0
n8 tn_n64_ndogo = "n64", 0
n8 tn_w0_ndogo = "w0", 0
n8 tn_d64_ndogo = "d64", 0

n8 tn_muundo = "muundo", 0

; ---------- Herufi halisi ya .shstrtab ----------

; "\0.text\0.data\0.bss\0.symtab\0.strtab\0.rela.text\0.shstrtab\0"
; Hii ni baiti 55 zilizohesabiwa tayari
n8 shstrtab_data = 0
n8 = ".text", 0   ; offset 1
n8 = ".data", 0   ; offset 7
n8 = ".bss", 0   ; offset 13
n8 = ".symtab", 0   ; offset 18
n8 = ".strtab", 0   ; offset 26
n8 = ".rela.text", 0   ; offset 34
n8 = ".shstrtab", 0   ; offset 45
fafanua SHSTRTAB_SIZE = 55

; ---------- Kiolezo cha kichwa cha ELF ----------

; Kichwa cha ELF (baiti 64) — tunatumia kiolezo na kujaza maeneo yanayobadilika
n8 shstrtab_data_end =
n8 ehdr_template = 0x7f, 0x45, 0x4c, 0x46   ; e_ident[0:4] — ELF magic
n8 = 2   ; EI_CLASS = 64-bit
n8 = 1   ; EI_DATA = little-endian
n8 = 1   ; EI_VERSION
n8 = 0   ; EI_OSABI = System V
n8 = 0, 0, 0, 0, 0, 0, 0, 0   ; e_ident[8:16] — padding
n16 = 1   ; e_type = ET_REL
n16 = 62   ; e_machine = x86-64 (0x3E)
n32 = 1   ; e_version
n64 = 0   ; e_entry (0 kwa .o)
n64 = 0   ; e_phoff (0 kwa .o)
n64 = 0   ; e_shoff (itajazwa)
n32 = 0   ; e_flags
n16 = 64   ; e_ehsize
n16 = 0   ; e_phentsize (0 kwa .o)
n16 = 0   ; e_phnum
n16 = 64   ; e_shentsize
n16 = 7   ; e_shnum (itajazwa ikiwa tofauti)
n16 = 6   ; e_shstrndx

; =============================================================================
; Sehemu ya 2: BSS (vibafa na vigezo visivyosanifiwa)
; =============================================================================

        ; sehemu: tupu

; ---------- Bafa la chanzo ----------
n8 source_buf[MAX_SOURCE]
n64 source_len

; ---------- Bafa la tokeni ----------
; Kila tokeni: baiti 20 (aina:4, thamani:8, mstari:4, safu:2, urefu:2)
n32 token_ty[MAX_TOKENS]
n64 token_val[MAX_TOKENS]
n8 token_desimali[MAX_TOKENS]   ; 1 = tokeni ni desimali (D64)
n32 token_line[MAX_TOKENS]
n16 token_col[MAX_TOKENS]
n16 token_len[MAX_TOKENS]
n64 token_count
n64 token_pos   ; nafasi ya sasa ya usomaji wa tokeni
n64 line_sasa   ; mstari wa sasa (1-msingi) kwa mchanganyaji

; ---------- Bafa la chanzo kwa mchanganuzi ----------
; Hifadhi anwani ya mwanzo ya kila tokeni ya neno/jina kwenye chanzo
n64 token_text[MAX_TOKENS]
n8 lit64_pool[LIT64_POOL_SIZE]   ; baiti 8 kwa halisi ya N64 (thamani kubwa)
n64 lit64_pool_pos   ; nafasi inayofuata kwenye bwawa

; ---------- AST (safu sambamba) ----------
n32 ast_aina[MAX_AST_NODES]   ; aina ya nodi
n32 ast_kushoto[MAX_AST_NODES]   ; mtoto wa kushoto
n32 ast_kulia[MAX_AST_NODES]   ; mtoto wa kulia
n32 ast_tiga[MAX_AST_NODES]   ; mtoto wa tatu
n32 ast_nne[MAX_AST_NODES]   ; ndugu anayefuata
n32 ast_thamani[MAX_AST_NODES]   ; thamani (kwa nambari)
n32 ast_jina_off[MAX_AST_NODES]   ; ofseti ya jina kwenye bwawa la herufi
n32 ast_zaida[MAX_AST_NODES]   ; nafasi ya ziada (safu za miundo: jina la muundo)
n64 ast_count

; ---------- Bwawa la herufi ----------
n8 str_pool[STR_POOL_SIZE]
n64 str_pool_pos

; ---------- Bafa za msimbo ----------
n8 text_buf[TEXT_BUF_SIZE]
n64 text_buf_pos

n8 data_buf[DATA_BUF_SIZE]
n64 data_buf_pos

; ---------- Lebo za kazi ----------
n64 label_name[MAX_LABELS]   ; anwani ya jina (kwenye str_pool)
n32 label_offset[MAX_LABELS]   ; ofseti kwenye text_buf
n32 label_size[MAX_LABELS]   ; ukubwa wa kazi
n64 label_count

; ---------- Nje (alama za nje) ----------
n64 extern_name[MAX_EXTERNS]   ; anwani ya jina
n64 extern_count

; ---------- Marekebisho (relocations) ----------
n32 rela_offset[MAX_RELOCS]   ; ofseti kwenye text_buf
n32 rela_sym[MAX_RELOCS]   ; faharisi ya alama au -1
n32 rela_addend[MAX_RELOCS]   ; addend maalum (kwa rekebisho la data)
n64 rela_count

; ---------- Vigezo vya ulimwengu ----------
n64 global_name[MAX_GLOBALS]
n32 global_offset[MAX_GLOBALS]
n32 global_size[MAX_GLOBALS]
n32 global_is_bss[MAX_GLOBALS]   ; 1 ikiwa ni .bss, 0 ikiwa ni .data
n32 global_base_type[MAX_GLOBALS]   ; aina msingi: N8=1, N16=2, N32=3, N64=4, W0=5, muundo=6+
n32 global_star_count[MAX_GLOBALS]   ; idadi ya nyota: 0=kawaida, 1=nyota moja, 2=nyota mbili, n.k.
n32 global_is_array[MAX_GLOBALS]   ; 1 ikiwa ni safu, 0 ikiwa ni kigeu rahisi
n64 global_count
; Rekodi za kianzio cha anwani ya kazi kwenye .data (hali ya --exe):
; sloti ya data_buf na ofseti ya jina la kazi (str_pool). Zinajazwa
; wakati wa uchanganuzi na kutatuliwa na rekebisha_anwani_za_data.
n32 data_kazi_anwani_ofseti[MAX_GLOBALS]
n32 data_kazi_anwani_jina[MAX_GLOBALS]
n64 data_kazi_anwani_idadi
n64 bss_size   ; ukubwa wa jumla wa .bss

; ---------- Vigezo vya ndani (kwa kazi ya sasa) ----------
n64 local_name[MAX_LOCALS]   ; anwani ya jina
n32 local_offset[MAX_LOCALS]   ; ofseti ya rafu (kutoka rbp, hasi)
n32 local_size[MAX_LOCALS]   ; ukubwa kwa baiti
n32 local_base_type[MAX_LOCALS]   ; aina msingi: N8=1, N16=2, N32=3, N64=4, W0=5, muundo=6+
n32 local_star_count[MAX_LOCALS]   ; idadi ya nyota: 0=kawaida, 1=nyota moja, 2=nyota mbili, n.k.
n64 local_count

; ---------- Kina cha mzunguko ----------
n64 loop_depth
n64 loop_break_label[16]   ; lebo za vunja (ufungwaji wa mipaka ya rafu)
n32 break_fixup_pos[65536]   ; nafasi za marekebisho ya vunja
n64 cl_hatua   ; nafasi ya hatua ya kwa (semantiki ya C ya endelea)
n64 cl_lengo   ; lengo la sasa la endelea
n64 break_fixup_count   ; idadi ya marekebisho ya vunja

; ---------- Hali ya mkusanyaji ----------
n64 compiler_state   ; 0=sawa, 1=kosa
n64 compiler_error_msg   ; ujumbe wa kosa
n32 muundo_jina   ; ofseti ya jina la muundo (kwa aina za mtumiaji)
n8 exe_mode   ; 1 = toa ET_EXEC badala ya .o
n64 tmp_argc   ; hifadhi ya argc wakati wa kuchanganua hoja
n32 gen_op_64bit   ; 1 = operesheni binary ya baiti 8 (N64/kielekezi)
n32 kianzio_lengo64   ; 1 = kianzilishi cha tangazo la N64 (uhamishaji wa baiti 8)

; ---------- Jedwali la miundo ----------
n64 muundo_count   ; idadi ya miundo
n32 muundo_jina_off[64]   ; ofseti ya jina la muundo
n32 muundo_ukubwa[64]   ; ukubwa wa muundo kwa baiti
n32 muundo_pangilio[64]   ; upangilio wa muundo
n32 muundo_nyuga_anza[64]   ; nyuga ya kwanza
n32 muundo_nyuga_mwisho[64]   ; nyuga ya mwisho (isiyojumuishwa)

; ---------- Jedwali la nyuga ----------
n64 nyuga_count   ; idadi ya nyuga
n32 nyuga_muundo[512]   ; faharisi ya muundo wa nyuga
n32 nyuga_jina_off[512]   ; ofseti ya jina la nyuga
n32 nyuga_aina[512]   ; aina msingi ya nyuga (1-6)
n32 nyuga_muundo_id[512]   ; faharisi ya muundo ndani au -1
n32 nyuga_nyota[512]   ; idadi ya nyota
n32 nyuga_ofseti[512]   ; ofseti ya nyuga ndani ya muundo

; ---------- Viwezeshaji vya muundo kwa vigezo vya ndani ----------
n32 local_muundo_id[MAX_LOCALS]   ; faharisi ya muundo wa kigezo au -1
n32 local_muundo_ukubwa[MAX_LOCALS]   ; ukubwa wa muundo wa paramu (kwa hifadhi)
n32 local_kwa_rejea[MAX_LOCALS]   ; 1 = paramu ya muundo mkubwa (>8B) kwa rejea
n32 local_array_size[MAX_LOCALS]   ; idadi ya elementi za safu ya ndani au 0
n64 frame_wapi   ; ofseti inayofuata ya fremu ya rafu
n32 ak_kipengele_ni_muundo   ; alama: kipengele cha safu ni muundo (assign_kielelezo)
n32 ak_kipengele_ni_d64   ; alama: kipengele cha safu ni D64 (hifadhi xmm0)

; ---------- Habari ya kurejesha muundo ----------
n32 kazi_ret_aina   ; aina ya kurejesha ya kazi ya sasa (uzalishaji)
n32 kazi_ret_muundo_id   ; faharisi ya muundo unaorudishwa au -1 (uzalishaji)
n32 kazi_ret_jina[256]   ; ofseti ya jina la kazi inayorudisha muundo
n32 kazi_ret_muundo_jina[256]   ; ofseti ya jina la muundo unaorudishwa
n64 kazi_ret_idadi   ; idadi ya kazi zinazorudisha muundo

; ---------- Aina za kurudi za kazi (kwa fumbua_aina ya wito) ----------
; Jedwali la jina -> aina ya kurudi. Hujazwa wakati wa kuchanganua
; kazi, na hutumiwa na fumbua_aina kuamua aina ya usemi wa wito.
n64 func_ret_name[MAX_GLOBALS]   ; anwani ya jina la kazi (kwenye str_pool)
n32 func_ret_base[MAX_GLOBALS]   ; aina msingi ya kurudi
n32 func_ret_star[MAX_GLOBALS]   ; idadi ya nyota ya aina ya kurudi
n32 func_ret_params[MAX_GLOBALS]   ; idadi ya vigezo (kwa ukaguzi wa idadi — 8.16)
n8 func_ret_paina[MAX_GLOBALS*16]   ; aina msingi ya kila kigezo (upeo wa hoja 16)
n8 func_ret_pnyota[MAX_GLOBALS*16]   ; nyota za kila kigezo (upeo wa hoja 16)
n64 func_ret_count   ; idadi ya kazi zilizosajiliwa

; ---------- Marekebisho ya endelea ----------
n32 continue_fixup_pos[65536]   ; nafasi za marekebisho ya endelea
n64 continue_fixup_count   ; idadi ya marekebisho ya endelea

; ---------- Bafa la matokeo ya ELF ----------
; ELF header (64) + section data + section headers
; Tutatoa moja kwa moja kwa stdout, kwa hivyo hatuhitaji bafa kubwa la matokeo

; ---------- Bafa la muda la uunganishi ----------
n8 tmp_buf[4096]   ; bafa la matumizi ya jumla

; =============================================================================
; Sehemu ya 3: Msaada — Kazi za kumbukumbu na herufi
; =============================================================================

        ; sehemu: msimbo

; -------------------------------------------------------
; urefu_wa_mfuatano: rudisha urefu wa mfuatano unaoishia '\0'
;   rdi = anwani ya mfuatano
;   rax = urefu
; -------------------------------------------------------
urefu_wa_mfuatano:
        r0d ^= r0d
.loop:
        linganisha n8[r7 + r0], 0
        ruka .done kama ==
        r0++
        ruka .loop
.done:
        rudi

; -------------------------------------------------------
; linganisha_mfuatano: linganisha nyuzi mbili
;   rdi = a, rsi = b
;   rax = 0 ikiwa sawa, !=0 ikiwa tofauti
; -------------------------------------------------------
linganisha_mfuatano:
        sukuma r7
        sukuma r6
.loop:
        r0b = n8[r7]
        r1b = n8[r6]
        linganisha r0b, r1b
        ruka .not_equal kama !=
        linganisha r0b, 0
        ruka .equal kama ==
        r7++
        r6++
        ruka .loop
.equal:
        r0d ^= r0d
        vuta r6
        vuta r7
        rudi
.not_equal:
        r0d = 1
        vuta r6
        vuta r7
        rudi

; -------------------------------------------------------
; linganisha_neno_muhimu: angalia ikiwa tokeni inalingana na neno
;   rdi = anwani ya tokeni (kwenye chanzo)
;   esi = urefu wa tokeni
;   rdx = anwani ya neno muhimu
;   rax = 0 ikiwa sawa, !=0 ikiwa tofauti
; -------------------------------------------------------
linganisha_neno_muhimu:
        ; rdx = anwani ya neno muhimu (mfuatano unaoishia '\0')
        ; rsi = anwani ya maandishi ya tokeni
        ; ecx = urefu wa tokeni (idadi ya herufi)
        sukuma r7
        sukuma r6
        sukuma r1
        sukuma r2
        r7 = r2   ; neno muhimu kwenye rdi kwa kulinganisha
        mwelekeo_mbele
.loop:
        linganisha r1d, 0
        ruka .check_keyword_end kama ==
        r0b = n8[r6]   ; herufi kutoka tokeni
        linganisha n8[r7], 0
        ruka .not_equal kama ==   ; neno muhimu fupi kuliko tokeni
        linganisha r0b, n8[r7]
        ruka .not_equal kama !=
        r7++
        r6++
        r1d--
        ruka .loop
.check_keyword_end:
        linganisha n8[r7], 0
        ruka .not_equal kama !=   ; neno muhimu refu kuliko tokeni
        r0d ^= r0d   ; zinalingana
        ruka .done
.not_equal:
        r0d = 1
.done:
        vuta r2
        vuta r1
        vuta r6
        vuta r7
        rudi

; -------------------------------------------------------
; ni_neno_muhimu: je, tokeni ya sasa ni neno muhimu (hati 2.2)?
;   Orodha kamili ya maneno 13 ya mnyororo wa .swa: muundo,
;   rudisha, kama, sivyo, wakati, fanya, kwa, vunja, endelea,
;   chagua, hali, husisha, achilia.
;   rax = 1 ikiwa ni neno muhimu, 0 vinginevyo.
;   Huharibu rax, rcx, rdx, rsi, rdi; huhifadhi r12-r15.
; -------------------------------------------------------
ni_neno_muhimu:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        r7 = n64[token_pos]
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        linganisha r1d, 3   ; maneno yote yana angalau herufi 3
        ruka .nnm_hapana kama <n
        r2 = &[kw_muundo]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_rudisha]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_kama]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_sivyo]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_wakati]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_fanya]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_kwa]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_vunja]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_endelea]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_chagua]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_hali]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_husisha]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
        r2 = &[kw_achilia]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .nnm_ndiyo kama ==
.nnm_hapana:
        r0d ^= r0d
        ruka .nnm_mwisho
.nnm_ndiyo:
        r0d = 1
.nnm_mwisho:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; kataa_neno_muhimu: kataa tokeni ya sasa ikiwa ni neno muhimu
;   linalotumiwa kama jina (hati 2.2) — kosa la sauti lenye
;   ujumbe; hakuna kurudi ikiwa imekataliwa.
;   Huharibu rax, rcx, rdx, rsi, rdi, r12-r15.
; -------------------------------------------------------
kataa_neno_muhimu:
        ita ni_neno_muhimu
        linganisha r0d, 0
        ruka .knm_mwisho kama ==
        r7 = &[msg_muhimu_1]
        ita andika_mfuatano
        r7 = n64[token_pos]
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        ita hifadhi_jina
        r7 = &[str_pool + r0]
        ita andika_mfuatano
        r7 = &[msg_muhimu_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.knm_mwisho:
        rudi

; -------------------------------------------------------
; kagua_muundo_wa_kamba: kagua muundo wa KAMBA HALISI (hoja ya
; kwanza ya andika/andika_stderr) — viungwa %d %s %c %% pekee
; (8.11: %u na %x katika muundo halisi zilikubaliwa kimya).
; Bwawa lina mfuatano ULIOTOROKISHWA (hakuna nukuu za mipaka) —
; sawa na mkaguzi wa mnyororo: jozi ya backslash (k.m. kutoka
; "\\") hurukwa zima kabla ya kuangalia '%', na jozi halali %X
; hurukwa kwa herufi MBILI (%% ikifuatwa na \n haionekani kama
; '%' isiyotumika; mwisho ni 0, si nukuu).
;   edi = nodi ya hoja (halisi ya kamba)
;   Hakuna kurudi ikiwa kipengele kisichotumika kinapatikana.
;   Huharibu rax, rcx, rdx, rsi, rdi, r8-r11; huhifadhi r12-r15.
; -------------------------------------------------------
kagua_muundo_wa_kamba:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        r12d = r7d
        linganisha r12d, -1
        ruka .kmk_mwisho kama ==
        ; Halisi ya kamba: KAULI yenye kushoto = -1
        linganisha n32[ast_aina + r12*4], AST_KAULI
        ruka .kmk_mwisho kama !=
        linganisha n32[ast_kushoto + r12*4], -1
        ruka .kmk_mwisho kama !=
        r13d = n32[ast_jina_off + r12*4]
        r13 = &[str_pool + r13]
.kmk_loop:
        r0b = n8[r13]
        linganisha r0b, 0
        ruka .kmk_mwisho kama ==
        linganisha r0b, 92   ; backslash — ruka jozi ya utorokaji
        ruka .kmk_sio_backslash kama !=
        r13 += 2
        ruka .kmk_loop
.kmk_sio_backslash:
        linganisha r0b, 37   ; '%'
        ruka .kmk_ruka_herufi kama !=
        r0d = a8[r13 + 1]
        linganisha r0b, 37   ; %%
        ruka .kmk_jozi_halali kama ==
        linganisha r0b, 100   ; %d
        ruka .kmk_jozi_halali kama ==
        linganisha r0b, 115   ; %s
        ruka .kmk_jozi_halali kama ==
        linganisha r0b, 99   ; %c
        ruka .kmk_jozi_halali kama ==
        ; Kipengele kisichotumika — kosa la sauti (8.11)
        r14d = r0d   ; msimbo wa herufi
        r7 = &[msg_umbo_1]
        ita andika_mfuatano
        r7d = r14d
        ita andika_nambari
        r7 = &[msg_umbo_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.kmk_jozi_halali:
        r13 += 2
        ruka .kmk_loop
.kmk_ruka_herufi:
        r13++
        ruka .kmk_loop
.kmk_mwisho:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; nakili: nakili kumbukumbu (kama memcpy)
;   rdi = lengwa, rsi = chanzo, rdx = urefu
; -------------------------------------------------------
nakili:
        sukuma r7
        sukuma r6
        sukuma r1
        r1 = r2
        mwelekeo_mbele
        nakili
        vuta r1
        vuta r6
        vuta r7
        rudi

; -------------------------------------------------------
; andika_baiti: andika baiti moja kwa bafa la .text
;   al = baiti ya kuandika
;   inatumia na kurekebisha text_buf_pos
; -------------------------------------------------------
andika_baiti:
        sukuma r7
        r7 = n64[text_buf_pos]
        linganisha r7, TEXT_BUF_SIZE
        ruka .overflow kama >=a
        r7 = &[text_buf + r7]
        n8[r7] = r0b
        n64[text_buf_pos]++
        vuta r7
        rudi
.overflow:
        r7 = &[msg_textbuf_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; andika_neno4: andika neno la baiti 4 kwa bafa la .text
;   edi = thamani ya kuandika
; -------------------------------------------------------
andika_neno4:
        sukuma r7
        sukuma r1
        r1 = n64[text_buf_pos]
        linganisha r1, TEXT_BUF_SIZE - 4
        ruka .overflow kama >=a
        r1 = &[text_buf + r1]
        n32[r1] = r7d
        n64[text_buf_pos] += 4
        vuta r1
        vuta r7
        rudi
.overflow:
        r7 = &[msg_textbuf_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; andika_neno8: andika neno la baiti 8 kwa bafa la .text
;   rdi = thamani ya kuandika
; -------------------------------------------------------
andika_neno8:
        sukuma r7
        sukuma r1
        r1 = n64[text_buf_pos]
        linganisha r1, TEXT_BUF_SIZE - 8
        ruka .overflow kama >=a
        r1 = &[text_buf + r1]
        n64[r1] = r7
        n64[text_buf_pos] += 8
        vuta r1
        vuta r7
        rudi
.overflow:
        r7 = &[msg_textbuf_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; andika_neno8_moja_kwa_moja: andika neno8 moja kwa moja kwa stdout
;   rdi = thamani
; -------------------------------------------------------
andika_neno8_moja_kwa_moja:
        ; Hifadhi thamani kwenye bafa la muda na tumia sys_write
        sukuma r7
        sukuma r6
        sukuma r2
        sukuma r0
        n64[tmp_buf] = r7
        r7 = 1   ; stdout
        r6 = &[tmp_buf]
        r2 = 8
        r0 = 1   ; sys_write
        mfumo
        vuta r0
        vuta r2
        vuta r6
        vuta r7
        rudi

; -------------------------------------------------------
; andika_neno4_moja_kwa_moja: andika baiti 4 kwa stdout
;   edi = thamani
; -------------------------------------------------------
andika_neno4_moja_kwa_moja:
        sukuma r7
        sukuma r6
        sukuma r2
        sukuma r0
        n32[tmp_buf] = r7d
        r7 = 1   ; stdout
        r6 = &[tmp_buf]
        r2 = 4
        r0 = 1   ; sys_write
        mfumo
        vuta r0
        vuta r2
        vuta r6
        vuta r7
        rudi

; -------------------------------------------------------
; andika_baiti_moja_kwa_moja: andika baiti 1 kwa stdout
;   dil = baiti
; -------------------------------------------------------
andika_baiti_moja_kwa_moja:
        sukuma r7
        sukuma r6
        sukuma r2
        sukuma r0
        n8[tmp_buf] = r7b
        r7 = 1   ; stdout
        r6 = &[tmp_buf]
        r2 = 1
        r0 = 1   ; sys_write
        mfumo
        vuta r0
        vuta r2
        vuta r6
        vuta r7
        rudi

; -------------------------------------------------------
; andika_neno2_moja_kwa_moja: andika baiti 2 kwa stdout
;   di = thamani
; -------------------------------------------------------
andika_neno2_moja_kwa_moja:
        sukuma r7
        sukuma r6
        sukuma r2
        sukuma r0
        n16[tmp_buf] = r7w
        r7 = 1   ; stdout
        r6 = &[tmp_buf]
        r2 = 2
        r0 = 1   ; sys_write
        mfumo
        vuta r0
        vuta r2
        vuta r6
        vuta r7
        rudi

; -------------------------------------------------------
; sys_exit: toka kwa msimbo
;   edi = msimbo wa kutoka
; -------------------------------------------------------
sys_exit:
        r0d = 60   ; sys_exit
        mfumo

; -------------------------------------------------------
; sys_write_buf: andika bafa kwa stdout
;   rsi = anwani, rdx = urefu
; -------------------------------------------------------
sys_write_buf:
        r7 = 1   ; stdout
        r0 = 1   ; sys_write
        mfumo
        rudi

; -------------------------------------------------------
; sys_read_all: soma faili lote kwenye bafa
;   rdi = fd, rsi = anwani ya bafa, rdx = upeo wa ukubwa
;   rax = idadi ya baiti zilizosomwa
; -------------------------------------------------------
sys_read_all:
        ; Soma hadi EOF au bafa lijae. Kusoma mara moja tu hakutoshi
        ; kwa stdin (bomba): sys_read inarudisha tu kile kilichopo
        ; wakati huo — chanzo kinakatwa bila mpangilio. Huu ulikuwa
        ; chanzo cha kutokubalika kwa mbegu: matokeo tofauti kwa
        ; pembejeo moja (kazi za mwisho wa faili zikipotea).
        sukuma r3
        sukuma r12
        sukuma r13
        r3 = r6   ; nafasi ya sasa kwenye bafa
        r13 = r2   ; upeo wa ukubwa
        r12 ^= r12   ; jumla ya baiti zilizosomwa
.loop:
        linganisha r12, r13
        ruka .done kama >=a   ; bafa limejaa — acha (mlio utafuata)
        r6 = r3
        r2 = r13
        r2 -= r12
        r0 = 0   ; sys_read
        mfumo
        linganisha r0, 0
        ruka .done kama ==   ; EOF
        ruka .error kama <n   ; kosa la syscall — rudisha -1
        r12 += r0
        r3 += r0
        ruka .loop
.done:
        r0 = r12
        vuta r13
        vuta r12
        vuta r3
        rudi
.error:
        r0 = -1
        vuta r13
        vuta r12
        vuta r3
        rudi

; -------------------------------------------------------
; andika_mfuatano: andika mfuatano wa C kwa stdout
;   rdi = anwani ya mfuatano
; -------------------------------------------------------
andika_mfuatano:
        sukuma r7
        ita urefu_wa_mfuatano
        r6 = r7
        r2 = r0
        ita sys_write_buf
        vuta r7
        rudi

; -------------------------------------------------------
; andika_nambari: andika nambari kamili ya desimali (yenye ishara)
;   edi = nambari
;   Huharibu rax, rcx, rdx, rsi, rdi; huhifadhi rbx, r12, r13
; -------------------------------------------------------
andika_nambari:
        sukuma r3
        sukuma r12
        sukuma r13
        r13d = r7d   ; nambari asili (kwa ishara)
        r3d = r7d
        pima r3d, r3d
        ruka .an_sio_hasi kama si_hasi
        r3d = -r3d
.an_sio_hasi:
        r12 = &[tmp_buf + 32]
        n8[r12] = 0
        r0d = r3d
.an_loop:
        r2d ^= r2d
        r1d = 10
        gawanya a r1d
        r2d += 48
        r12--
        n8[r12] = r2b
        pima r0d, r0d
        ruka .an_loop kama !=
        pima r13d, r13d
        ruka .an_chapisha kama si_hasi
        r12--
        n8[r12] = '-'
.an_chapisha:
        r7 = r12
        ita andika_mfuatano
        vuta r13
        vuta r12
        vuta r3
        rudi

; -------------------------------------------------------
; soma_chanzo_kutoka_stdin: soma chanzo chote kutoka stdin
; -------------------------------------------------------
soma_chanzo_kutoka_stdin:
        r6 = &[source_buf]
        r2 = MAX_SOURCE
        r7 = 0   ; stdin
        ita sys_read_all
        linganisha r0, 0
        ruka .error kama <n
        n64[source_len] = r0
        linganisha r0, MAX_SOURCE
        ruka .kikubwa_mno kama >=a
        rudi
.kikubwa_mno:
        r7 = &[msg_chanzo_kikubwa]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.error:
        r7 = &[msg_lexerr]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; soma_chanzo_kutoka_faili: soma chanzo kutoka jina la faili
;   rdi = anwani ya jina la faili
; -------------------------------------------------------
soma_chanzo_kutoka_faili:
        sukuma r12
        r12 = r7   ; hifadhi jina la faili

        ; Fungua faili
        r7 = r12
        r6 = 0   ; O_RDONLY
        r0 = 2   ; sys_open
        mfumo
        linganisha r0, 0
        ruka .error kama <n

        ; Soma faili lote (hadi EOF) — si kusoma mara moja tu
        r7 = r0
        r6 = &[source_buf]
        r2 = MAX_SOURCE
        ita sys_read_all
        n64[source_len] = r0
        linganisha r0, 0
        ruka .error kama <n
        linganisha r0, MAX_SOURCE
        ruka .kikubwa_mno kama >=a

        vuta r12
        rudi
.kikubwa_mno:
        r7 = &[msg_chanzo_kikubwa]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.error:
        r7 = &[msg_lexerr]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; =============================================================================
; Sehemu ya 4: Msomaji (Lexer)
; =============================================================================

; -------------------------------------------------------
; ni_nafasi: angalia ikiwa herufi ni nafasi
;   al = herufi
;   kurudisha: ZF=1 ikiwa ni nafasi
; -------------------------------------------------------
ni_nafasi:
        linganisha r0b, ' '
        ruka .yes kama ==
        linganisha r0b, 9   ; tab
        ruka .yes kama ==
        linganisha r0b, 10   ; newline
        ruka .yes kama ==
        linganisha r0b, 13   ; carriage return
        ruka .yes kama ==
        linganisha r0b, 0
.yes:
        rudi

; -------------------------------------------------------
; ni_herufi: angalia ikiwa ni herufi au _
;   al = herufi
; -------------------------------------------------------
ni_herufi:
        linganisha r0b, 'a'
        ruka .check_upper kama <n
        linganisha r0b, 'z'
        ruka .yes kama <=n
.check_upper:
        linganisha r0b, 'A'
        ruka .no kama <n
        linganisha r0b, 'Z'
        ruka .yes kama <=n
        linganisha r0b, '_'
        ruka .yes kama ==
.no:
        r0d = 0
        rudi
.yes:
        r0d = 1
        rudi

; -------------------------------------------------------
; ni_tarakimu: angalia ikiwa ni tarakimu
; -------------------------------------------------------
ni_tarakimu:
        linganisha r0b, '0'
        ruka .no kama <n
        linganisha r0b, '9'
        ruka .no kama >n
        r0d = 1
        rudi
.no:
        r0d ^= r0d
        rudi

; -------------------------------------------------------
; ni_herufi_au_tarakimu: herufi, tarakimu, au _
; -------------------------------------------------------
ni_herufi_au_tarakimu:
        sukuma r0   ; hifadhi al (herufi halisi)
        ita ni_herufi
        linganisha r0d, 1
        ruka .yes_pop kama ==
        vuta r0   ; rejesha al kwa ni_tarakimu
        ita ni_tarakimu
        linganisha r0d, 1
        ruka .yes kama ==
        r0d ^= r0d
        rudi
.yes_pop:
        vuta r0   ; tupa rax iliyohifadhiwa
.yes:
        r0d = 1
        rudi

; -------------------------------------------------------
; ruka_maelezo: ruka maoni ya // hadi mwisho wa mstari
;   r12 = nafasi ya sasa (faharisi kwenye chanzo)
;   r13 = anwani ya chanzo
;   r14 = urefu wa chanzo
;   inarekebisha r12
; -------------------------------------------------------
ruka_maelezo:
        linganisha r12, r14
        ruka .done kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '/'
        ruka .done kama !=
        linganisha r12, r14
        ruka .done kama ==
        r0b = n8[r13 + r12 + 1]
        linganisha r0b, '/'
        ruka .done kama !=
        ; Ni maoni ya //
        r12 += 2
.loop:
        linganisha r12, r14
        ruka .done kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, 10   ; newline
        ruka .newline kama ==
        linganisha r0b, 0
        ruka .done kama ==
        r12++
        ruka .loop
.newline:
        n64[line_sasa]++   ; mstari mpya
        r12++   ; ruka newline pia
.done:
        rudi

; -------------------------------------------------------
; ruka_nafasi_na_maelezo: ruka nafasi nyeupe na maoni
;   inarekebisha r12 (faharisi)
; -------------------------------------------------------
ruka_nafasi_na_maelezo:
        linganisha r12, r14
        ruka .done kama >=a
.loop:
        linganisha r12, r14
        ruka .done kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '/'
        ruka .check_comment kama ==
        linganisha r0b, ' '
        ruka .skip kama ==
        linganisha r0b, 9
        ruka .skip kama ==
        linganisha r0b, 10
        ruka .skip kama ==
        linganisha r0b, 13
        ruka .skip kama ==
        ruka .done
.check_comment:
        r0b = n8[r13 + r12 + 1]
        linganisha r0b, '/'
        ruka .done kama !=
        ita ruka_maelezo
        ruka .loop
.skip:
        linganisha r0b, 10
        ruka .skip_no_inc_line kama !=
        n64[line_sasa]++   ; mstari mpya
.skip_no_inc_line:
        r12++
        ruka .loop
.done:
        rudi

; -------------------------------------------------------
; soma_neno: soma neno kutoka chanzo
;   r12 = faharisi ya sasa
;   r13 = anwani ya chanzo
;   r14 = urefu wa chanzo
;   rax = TOK_NENO ikifaulu, 0 ikiwa hakuna neno
;   rbx = anwani ya mwanzo ya neno
;   rcx = urefu wa neno
;   inarekebisha r12
; -------------------------------------------------------
soma_neno:
        sukuma r12
        ita ruka_nafasi_na_maelezo
        linganisha r12, r14
        ruka .fail kama >=a
        r0b = n8[r13 + r12]
        ita ni_herufi
        linganisha r0d, 1
        ruka .fail kama !=
        r3 = r12   ; anwani ya mwanzo (faharisi)
        r3 += r13   ; anwani halisi
        r1d ^= r1d
.loop:
        linganisha r12, r14
        ruka .done kama >=a
        r0b = n8[r13 + r12]
        ita ni_herufi_au_tarakimu
        linganisha r0d, 1
        ruka .done kama !=
        r12++
        r1d++
        ruka .loop
.done:
        r0d = TOK_NENO
        ruka .ret
.fail:
        r0d = 0
        r3 = 0
        r1d = 0
.ret:
        r4 += 8   ; tupa r12 iliyohifadhiwa (usiharibu rax/eax)
        rudi

; -------------------------------------------------------
; soma_nambari: soma nambari kamili
;   r12 = faharisi ya sasa
;   rax = TOK_NAMBARI ikifaulu, 0 ikiwa hakuna
;   rbx = thamani ya nambari (64-bit)
;   inarekebisha r12
; -------------------------------------------------------
soma_nambari:
        sukuma r12
        ita ruka_nafasi_na_maelezo
        linganisha r12, r14
        ruka .fail kama >=a
        r0b = n8[r13 + r12]
        ita ni_tarakimu
        linganisha r0d, 1
        ruka .fail kama !=
        ; Radiksi (0x, 0o, 0b): hati 2.3 inaahidi mfuatano wa tarakimu
        ; pekee — kataa kwa sauti, sawa na mnyororo wa .swa.
        r0b = n8[r13 + r12]   ; soma tena (ni_tarakimu inaharibu al)
        linganisha r0b, '0'
        ruka .sio_radiksi kama !=
        r1 = &[r12 + 1]
        linganisha r1, r14
        ruka .sio_radiksi kama >=a
        r0b = n8[r13 + r1]
        linganisha r0b, 'x'
        ruka .radiksi_kosa kama ==
        linganisha r0b, 'X'
        ruka .radiksi_kosa kama ==
        linganisha r0b, 'o'
        ruka .radiksi_kosa kama ==
        linganisha r0b, 'O'
        ruka .radiksi_kosa kama ==
        linganisha r0b, 'b'
        ruka .radiksi_kosa kama ==
        linganisha r0b, 'B'
        ruka .radiksi_kosa kama ==
.sio_radiksi:
        r3d ^= r3d
.loop:
        linganisha r12, r14
        ruka .angalia_desimali kama >=a
        r0b = n8[r13 + r12]
        ita ni_tarakimu
        linganisha r0d, 1
        ruka .angalia_desimali kama !=
        r1d = a8[r13 + r12]   ; soma tena baada ya ni_tarakimu kuharibu al
        r1d -= '0'
        r3 = r3 * 10
        r3 += r1
        r12++
        ruka .loop
.angalia_desimali:
        ; Angalia desimali: '.' ikifuatiwa na tarakimu
        linganisha r12, r14
        ruka .done kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '.'
        ruka .done kama !=
        r10 = r12
        r10++
        linganisha r10, r14
        ruka .done kama >=a
        r0b = n8[r13 + r10]
        ita ni_tarakimu
        linganisha r0d, 1
        ruka .done kama !=

        ; Desimali: changanua sehemu ndogo na ubadilishe hadi double
        r12++   ; ruka '.'
        r1d ^= r1d   ; idadi ya tarakimu ndogo
        r2d ^= r2d   ; thamani ya sehemu ndogo
.frac_loop:
        linganisha r12, r14
        ruka .frac_badilisha kama >=a
        r0b = n8[r13 + r12]
        ita ni_tarakimu
        linganisha r0d, 1
        ruka .frac_badilisha kama !=
        r0d = a8[r13 + r12]
        r0d -= '0'
        r2 = r2 * 10
        r2 += r0
        r1++
        r12++
        linganisha r1d, 17   ; usahihi wa juu wa double
        ruka .frac_loop kama <a
.frac_badilisha:
        ; double = (double)rbx + (double)rdx / 10^rcx  (SSE2 ya mbegu)
        x0 = n r3
        x1 = n r2
        r0 = r1
        r10 = &[nguvu_za_kumi]
        x1 /= d64[r10 + r0*8]
        x0 += x1
        r3 = x0
        r0d = TOK_NAMBARI
        r2d = 1   ; alama: hii ni desimali
        ruka .ret
.done:
        r0d = TOK_NAMBARI
        r2d ^= r2d   ; si desimali
        ruka .ret
.fail:
        r0d = 0
        r3d ^= r3d
        r2d ^= r2d
        ruka .ret
.radiksi_kosa:
        ; Radiksi haijaungwa mkono — kosa LAUTI, si kukubali kimya
        r7 = &[msg_radiksi]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.ret:
        vuta r1   ; tupa r12 ya awali
        rudi

; -------------------------------------------------------
; soma_ishara: soma alama ya hesabu au ulinganisho
;   inarekebisha r12
;   rax = TOK_ISHARA, 0 ikiwa hakuna
;   rbx = msimbo wa ishara
; -------------------------------------------------------
soma_ishara:
        sukuma r12
        ita ruka_nafasi_na_maelezo
        linganisha r12, r14
        ruka .fail kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '+'
        ruka .plus kama ==
        linganisha r0b, '-'
        ruka .arrow_or_minus kama ==
        linganisha r0b, '*'
        ruka .star kama ==
        linganisha r0b, '/'
        ruka .slash kama ==
        linganisha r0b, '%'
        ruka .mod kama ==
        linganisha r0b, '&'
        ruka .and kama ==
        linganisha r0b, '|'
        ruka .or kama ==
        linganisha r0b, '^'
        ruka .xor kama ==
        linganisha r0b, '~'
        ruka .makosa_biti kama ==
        linganisha r0b, '<'
        ruka .lt_or_shift_or_le kama ==
        linganisha r0b, '>'
        ruka .gt_or_shift_or_ge kama ==
        linganisha r0b, '='
        ruka .eq_or_assign kama ==
        linganisha r0b, '!'
        ruka .ne kama ==
        ruka .fail
.plus:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_JUMLISHA
        ruka .ret
.arrow_or_minus:
        r12++
        linganisha r12, r14
        ruka .is_minus kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '>'
        ruka .arrow kama ==
.is_minus:
        r0d = TOK_ISHARA
        r3d = OP_TOA
        ruka .ret
.arrow:
        r12++
        r0d = TOK_MSHALE_KULIA
        r3d = 0
        ruka .ret
.star:
        r12++
        r0d = TOK_NYOTA
        r3d = OP_ZIDISHA
        ruka .ret
.slash:
        r12++
        ; Angalia ikiwa ni maoni
        linganisha r12, r14
        ruka .is_div kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '/'
        ruka .comment_in_expr kama ==
.is_div:
        r0d = TOK_ISHARA
        r3d = OP_GAWANYA
        ruka .ret
.comment_in_expr:
        r12--   ; rudi nyuma, ruka_maelezo itashughulikia
        ita ruka_maelezo
        ruka soma_ishara   ; jaribu tena baada ya maoni
.mod:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_MODULO
        ruka .ret
.and:
        r12++
        ; Angalia ikiwa ni &&
        linganisha r12, r14
        ruka .is_and_addr kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '&'
        ruka .logical_and kama ==
.is_and_addr:
        r0d = TOK_ALAMA
        r3d ^= r3d
        ruka .ret
.logical_and:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_NA
        ruka .ret
.or:
        r12++
        ; Angalia ikiwa ni ||
        linganisha r12, r14
        ruka .is_or kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '|'
        ruka .bor kama ==
.is_or:
        r0d = TOK_ISHARA
        r3d = OP_AU_BITI
        ruka .ret
.bor:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_AU
        ruka .ret
.xor:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_XOR_BITI
        ruka .ret
.makosa_biti:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_MAKOSA_BITI
        ruka .ret
.lt_or_shift_or_le:
        r12++
        linganisha r12, r14
        ruka .is_lt kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '<'
        ruka .shl kama ==
        linganisha r0b, '='
        ruka .le kama ==
.is_lt:
        r0d = TOK_ISHARA
        r3d = OP_KIDOGO
        ruka .ret
.shl:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_HAMISHA_KUSHOTO
        ruka .ret
.le:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_KIDOGO_SAWA
        ruka .ret
.gt_or_shift_or_ge:
        r12++
        linganisha r12, r14
        ruka .is_gt kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '>'
        ruka .shr kama ==
        linganisha r0b, '='
        ruka .ge kama ==
.is_gt:
        r0d = TOK_ISHARA
        r3d = OP_KUBWA
        ruka .ret
.shr:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_HAMISHA_KULIA
        ruka .ret
.ge:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_KUBWA_SAWA
        ruka .ret
.eq_or_assign:
        r12++
        linganisha r12, r14
        ruka .is_assign kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '='
        ruka .eq kama ==
.is_assign:
        r0d = TOK_SAWA
        r3d = 0
        ruka .ret
.eq:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_SAWA_SAWA
        ruka .ret
.ne:
        r12++
        linganisha r12, r14
        ruka .not kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '='
        ruka .not kama !=
        r12++
        r0d = TOK_ISHARA
        r3d = OP_SIO_SAWA
        ruka .ret
.not:
        ; ! pekee — kukanusha kimantiki (OP_MAKOSA)
        r0d = TOK_ISHARA
        r3d = OP_MAKOSA
        ruka .ret
.fail:
        r0d = 0
        r3d ^= r3d
.ret:
        vuta r1   ; tupa r12 ya awali
        rudi

; -------------------------------------------------------
; changanua_chanzo: badilisha chanzo chote kuwa tokeni
;   inajaza safu za token_*
; -------------------------------------------------------
changanua_chanzo:
        ; Weka upya vihesabio
        n64[token_count] = 0
        n64[token_pos] = 0
        n64[line_sasa] = 1   ; mstari wa kwanza

        ; r12 = faharisi ya sasa kwenye chanzo
        ; r13 = anwani ya chanzo
        ; r14 = urefu wa chanzo
        r12d ^= r12d
        r13 = &[source_buf]
        r14 = n64[source_len]

.changanua_loop:
        linganisha r12, r14
        ruka .changanua_done kama >=a

        ita ruka_nafasi_na_maelezo
        linganisha r12, r14
        ruka .changanua_done kama >=a

        r15 = n64[token_count]
        linganisha r15, MAX_TOKENS - 1
        ruka .tokeni_jaa kama >=a

        ; Anwani ya mwanzo ya tokeni
        n64[token_text + r15*8] = r12   ; hifadhi faharisi ya mwanzo

        r0b = n8[r13 + r12]

        ; Nambari
        linganisha r0b, '0'
        ruka .try_word kama <n
        linganisha r0b, '9'
        ruka .try_word kama >n

        ita soma_nambari
        linganisha r0d, 0
        ruka .try_word kama ==
        r15 = n64[token_count]
        n8[token_desimali + r15] = r2b   ; alama ya desimali
        ruka .hifadhi_tokeni

.try_word:
        ; Neno (jina au neno muhimu)
        ita ni_herufi
        linganisha r0d, 1
        ruka .try_symbols kama !=

        ita soma_neno
        linganisha r0d, 0
        ruka .try_symbols kama ==
        n32[token_ty + r15*4] = r0d
        n64[token_val + r15*8] = r3
        r1d = a r1w   ; hakikisha urefu uko safi kwa kuhifadhi
        n16[token_len + r15*2] = r1w
        r2d = n32[line_sasa]   ; maneno pia lazima yawe na mstari
        n32[token_line + r15*4] = r2d

        n64[token_text + r15*8] = r3   ; hifadhi anwani halisi ya neno
        n64[token_count]++
        ruka .changanua_loop

.try_symbols:
        ; Alama za hesabu na ulinganisho
        ita soma_ishara
        linganisha r0d, 0
        ruka .try_punctuation kama ==
        ruka .hifadhi_tokeni_kwa_ishara

.try_punctuation:
        ; Alama za uakifishaji
        r0b = n8[r13 + r12]
        linganisha r0b, '{'
        ruka .tok_brace_open kama ==
        linganisha r0b, '}'
        ruka .tok_brace_close kama ==
        linganisha r0b, '('
        ruka .tok_paren_open kama ==
        linganisha r0b, ')'
        ruka .tok_paren_close kama ==
        linganisha r0b, '['
        ruka .tok_bracket_open kama ==
        linganisha r0b, ']'
        ruka .tok_bracket_close kama ==
        linganisha r0b, ';'
        ruka .tok_semicolon kama ==
        linganisha r0b, ','
        ruka .tok_comma kama ==
        linganisha r0b, ':'
        ruka .tok_colon kama ==
        linganisha r0b, '.'
        ruka .tok_dot kama ==
        linganisha r0b, '&'
        ruka .tok_ampersand kama ==
        linganisha r0b, '"'
        ruka .tok_string kama ==
        linganisha r0b, '?'
        ruka .tok_question kama ==

        ; Herufi isiyojulikana — kosa LAUTI, si ruka kimya
        r7 = &[msg_herufi_baya]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.tok_brace_open:
        r0d = TOK_FUNGO
        r3d = 0
        r12++
        ruka .hifadhi_tokeni
.tok_brace_close:
        r0d = TOK_FUNGA
        r3d = 0
        r12++
        ruka .hifadhi_tokeni
.tok_paren_open:
        r0d = TOK_MABANO_FUNGO
        r3d = 0
        r12++
        ruka .hifadhi_tokeni
.tok_paren_close:
        r0d = TOK_MABANO_FUNGA
        r3d = 0
        r12++
        ruka .hifadhi_tokeni
.tok_bracket_open:
        r0d = TOK_MABANO_MKOA
        r3d = 0
        r12++
        ruka .hifadhi_tokeni
.tok_bracket_close:
        r0d = TOK_MABANO_MKOA_FUNGA
        r3d = 0
        r12++
        ruka .hifadhi_tokeni
.tok_semicolon:
        r0d = TOK_NUKTA_MKATO
        r3d = 0
        r12++
        ruka .hifadhi_tokeni
.tok_comma:
        r0d = TOK_KOMA
        r3d = 0
        r12++
        ruka .hifadhi_tokeni
.tok_colon:
        r0d = TOK_JUWILI
        r3d = 0
        r12++
        ruka .hifadhi_tokeni
.tok_question:
        r0d = TOK_SWALI
        r3d = 0
        r12++
        ruka .hifadhi_tokeni
.tok_dot:
        r12++
        linganisha r12, r14
        ruka .hifadhi_dot kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '.'
        ruka .tok_dotdot kama ==
.hifadhi_dot:
        r0d = TOK_NUKTA
        r3d = 0
        ruka .hifadhi_tokeni
.tok_dotdot:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_MAKOSA
        ruka .hifadhi_tokeni_kwa_ishara
.tok_ampersand:
        r12++
        linganisha r12, r14
        ruka .hifadhi_amp kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, '&'
        ruka .tok_and kama ==
.hifadhi_amp:
        r0d = TOK_ALAMA
        r3d = 0
        ruka .hifadhi_tokeni
.tok_and:
        r12++
        r0d = TOK_ISHARA
        r3d = OP_NA
        ruka .hifadhi_tokeni_kwa_ishara

.tok_string:
        ; Ruka '"' ya kufungua
        r12++
        ; Hifadhi ofseti ya kwanza kwenye bwawa la herufi
        r8 = n64[str_pool_pos]
        r9d = r8d   ; ofseti ya kwanza ya mfuatano
        r10d ^= r10d   ; hesabu ya baiti

.str_loop:
        linganisha r12, r14
        ruka .str_eof kama >=a   ; mwisho wa faili bila '"'
        r0b = n8[r13 + r12]
        linganisha r0b, '"'
        ruka .str_done kama ==
        linganisha r0b, '\\'
        ruka .str_escape kama ==
        linganisha r0b, 10
        ruka .str_eof kama ==   ; newline kwenye mfuatano

        ; Herufi ya kawaida
        r7 = n64[str_pool_pos]
        linganisha r7, STR_POOL_SIZE - 2
        ruka .str_overflow kama >=a
        n8[str_pool + r7] = r0b
        n64[str_pool_pos]++
        r12++
        r10d++
        ruka .str_loop

.str_escape:
        r12++
        linganisha r12, r14
        ruka .str_eof kama >=a
        r0b = n8[r13 + r12]
        linganisha r0b, 'n'
        ruka .esc_newline kama ==
        linganisha r0b, 't'
        ruka .esc_tab kama ==
        linganisha r0b, '\\'
        ruka .esc_backslash kama ==
        linganisha r0b, '"'
        ruka .esc_quote kama ==
        linganisha r0b, '0'
        ruka .esc_null kama ==
        ; Herufi isiyotambulika baada ya '\' — tumia kama ilivyo
        ruka .str_store_char

.esc_newline:
        r0b = 10
        ruka .str_store_char
.esc_tab:
        r0b = 9
        ruka .str_store_char
.esc_backslash:
        r0b = '\\'
        ruka .str_store_char
.esc_quote:
        r0b = '"'
        ruka .str_store_char
.esc_null:
        r0b = 0

.str_store_char:
        r7 = n64[str_pool_pos]
        linganisha r7, STR_POOL_SIZE - 2
        ruka .str_overflow kama >=a
        n8[str_pool + r7] = r0b
        n64[str_pool_pos]++
        r12++
        r10d++
        ruka .str_loop

.str_done:
        r12++   ; ruka '"' ya kufunga
        ; Ongeza '\0' mwishoni
        r7 = n64[str_pool_pos]
        linganisha r7, STR_POOL_SIZE - 2
        ruka .str_overflow kama >=a
        n8[str_pool + r7] = 0
        n64[str_pool_pos]++
        r10d++   ; urefu pamoja na '\0'

        ; Andika tokeni moja kwa moja (token_len != 1)
        r15 = n64[token_count]
        linganisha r15, MAX_TOKENS - 1
        ruka .tokeni_jaa kama >=a
        n32[token_ty + r15*4] = TOK_HERUFI
        n64[token_val + r15*8] = r9   ; ofseti ya str_pool
        r2d = n32[line_sasa]
        n32[token_line + r15*4] = r2d
        n16[token_len + r15*2] = r10w   ; urefu wa baiti (pamoja na '\0')
        n64[token_count]++
        ruka .changanua_loop

.str_eof:
.str_overflow:
        ; Kosa LAUTI — kuruka kimya ni uharibifu
        r7 = &[msg_strpool_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.hifadhi_tokeni_kwa_ishara:
        r15 = n64[token_count]
        linganisha r15, MAX_TOKENS - 1
        ruka .tokeni_jaa kama >=a
        n32[token_ty + r15*4] = r0d
        n64[token_val + r15*8] = r3
        r2d = n32[line_sasa]
        n32[token_line + r15*4] = r2d
        n16[token_len + r15*2] = 1
        n64[token_count]++
        ruka .changanua_loop

.hifadhi_tokeni:
        r15 = n64[token_count]
        linganisha r15, MAX_TOKENS - 1
        ruka .tokeni_jaa kama >=a
        n32[token_ty + r15*4] = r0d
        n64[token_val + r15*8] = r3
        r2d = n32[line_sasa]
        n32[token_line + r15*4] = r2d
        n16[token_len + r15*2] = 1
        n64[token_count]++
        ruka .changanua_loop

.tokeni_jaa:
        ; Kosa LAUTI — kukata chanzo kimya ni uharibifu
        r7 = &[msg_tokeni_jaa]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.changanua_done:
        ; Ongeza tokeni ya mwisho
        r15 = n64[token_count]
        n32[token_ty + r15*4] = TOK_MWISHO
        n64[token_val + r15*8] = 0
        n16[token_len + r15*2] = 0
        n64[token_count]++
        rudi

; -------------------------------------------------------
; tokeni_sasa: rudisha aina ya tokeni ya sasa
;   rax = aina ya tokeni
; -------------------------------------------------------
tokeni_sasa:
        r0 = n64[token_pos]
        r0d = n32[token_ty + r0*4]
        rudi

; -------------------------------------------------------
; tokeni_songa: sogea mbele kwenye tokeni
; -------------------------------------------------------
tokeni_songa:
        n64[token_pos]++
        rudi

; -------------------------------------------------------
; tokeni_val_sasa: rudisha thamani ya tokeni ya sasa
;   rax = thamani
; -------------------------------------------------------
tokeni_val_sasa:
        r0 = n64[token_pos]
        r0 = n64[token_val + r0*8]
        rudi

; -------------------------------------------------------
; tokeni_text_sasa: rudisha anwani ya maandishi ya tokeni ya sasa
;   rax = anwani
; -------------------------------------------------------
tokeni_text_sasa:
        r0 = n64[token_pos]
        r0 = n64[token_text + r0*8]
        rudi

; -------------------------------------------------------
; tokeni_len_sasa: rudisha urefu wa tokeni ya sasa
;   rax = urefu
; -------------------------------------------------------
tokeni_len_sasa:
        r0 = n64[token_pos]
        r0d = a16[token_len + r0*2]
        rudi

; -------------------------------------------------------
; tarajia_ishara: angalia ikiwa tokeni ya sasa ni aina fulani
;   edi = aina inayotarajiwa
;   rax = 1 ikiwa sawa, 0 ikiwa tofauti
;   ikifaulu, inasongeza mbele
; -------------------------------------------------------
tarajia_ishara:
        sukuma r3
        r3 = n64[token_pos]
        r3d = n32[token_ty + r3*4]
        linganisha r3d, r7d
        ruka .fail kama !=
        n64[token_pos]++
        r0d = 1
        vuta r3
        rudi
.fail:
        r0d ^= r0d
        vuta r3
        rudi

; -------------------------------------------------------
; tarajia_ishara_hesabu: angalia ikiwa tokeni ya sasa ni ishara maalum
;   edi = msimbo wa ishara inayotarajiwa
;   rax = 1 ikiwa sawa, 0 ikiwa tofauti
; -------------------------------------------------------
tarajia_ishara_hesabu:
        sukuma r3
        r3 = n64[token_pos]
        linganisha n32[token_ty + r3*4], TOK_ISHARA
        ruka .fail kama !=
        linganisha n64[token_val + r3*8], r7
        ruka .fail kama !=
        n64[token_pos]++
        r0d = 1
        vuta r3
        rudi
.fail:
        r0d ^= r0d
        vuta r3
        rudi

; -------------------------------------------------------
; tarajia_neno: angalia ikiwa tokeni ya sasa inalingana na neno
;   rdi = anwani ya neno linalotarajiwa
;   rax = 1 ikiwa sawa, 0 ikiwa tofauti
; -------------------------------------------------------
tarajia_neno:
        sukuma r3
        sukuma r1
        sukuma r2
        r3 = n64[token_pos]
        linganisha n32[token_ty + r3*4], TOK_NENO
        ruka .fail kama !=
        r6 = n64[token_text + r3*8]
        r1d = a16[token_len + r3*2]
        r2 = r7   ; neno muhimu (kutoka rdi) → rdx
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .fail kama !=
        n64[token_pos]++
        r0d = 1
        vuta r2
        vuta r1
        vuta r3
        rudi
.fail:
        r0d ^= r0d
        vuta r2
        vuta r1
        vuta r3
        rudi

; =============================================================================
; Sehemu ya 5: Mchanganuzi (Parser)
; =============================================================================

; -------------------------------------------------------
; ast_nodi_mpya: unda nodi mpya ya AST
;   r8d = aina ya nodi
;   r9d = kushoto, r10d = kulia, r11d = tiga
;   rax = faharisi ya nodi mpya (N32)
; -------------------------------------------------------
ast_nodi_mpya:
        sukuma r3
        r3 = n64[ast_count]
        linganisha r3, MAX_AST_NODES - 1
        ruka .fail kama >=a
        n32[ast_aina + r3*4] = r8d
        n32[ast_kushoto + r3*4] = r9d
        n32[ast_kulia + r3*4] = r10d
        n32[ast_tiga + r3*4] = r11d
        n32[ast_nne + r3*4] = -1
        n32[ast_thamani + r3*4] = 0
        n32[ast_jina_off + r3*4] = 0
        n64[ast_count]++
        r0d = r3d
        vuta r3
        rudi
.fail:
        ; Kosa LAUTI — kurudisha -1 ("hakuna nodi") kimya ni uharibifu:
        ; mchanganuzi ungeendelea na mti usio sahihi
        r7 = &[msg_ast_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; hifadhi_jina: hifadhi jina kwenye bwawa la herufi
;   rsi = anwani ya jina
;   ecx = urefu wa jina
;   rax = ofseti kwenye str_pool
; -------------------------------------------------------
hifadhi_jina:
        sukuma r7
        sukuma r6
        sukuma r1
        sukuma r2
        r2 = n64[str_pool_pos]
        ; Angalia kufurika kwa str_pool
        r0 = &[r2 + r1 + 1]   ; nafasi inayohitajika
        linganisha r0, STR_POOL_SIZE
        ruka .furika kama >=a
        r7 = &[str_pool + r2]
        mwelekeo_mbele
        nakili
        n8[r7] = 0   ; mwisho wa mfuatano
        r0 = n64[str_pool_pos]
        vuta r2
        vuta r1
        ; Ongeza urefu + 1 kwa str_pool_pos
        r1 += 1
        n64[str_pool_pos] += r1
        vuta r6
        vuta r7
        rudi
.furika:
        ; Rudisha faharisi batili
        r0 = 0
        vuta r2
        vuta r1
        vuta r6
        vuta r7
        rudi

; -------------------------------------------------------
; tangaza mbele kwa vitendakazi
; -------------------------------------------------------
; Tunahitaji kutangaza mbele kazi za kuchanganua
; Katika assembly, tunatumia lebo za kawaida

; -------------------------------------------------------
; changanua_aina: changanua jina la aina
;   rax = nambari ya aina (0=haijulikani, 1=N8, 2=N16, 3=N32, 4=N64, 5=W0)
;   rbx = nyota_ya_aina (1 ikiwa ni nyota, 0 la sivyo)
; -------------------------------------------------------
changanua_aina:
        sukuma r12
        sukuma r13
        sukuma r14

        ; Aina ya msingi -- herufi ndogo PEKEE (herufi kubwa
        ; imeondolewa, uamuzi wa msimamizi baada ya Awamu C
        ; kukamilika -- angalia hati/mipaka.md)
        r7 = &[tn_w0_ndogo]
        ita tarajia_neno
        linganisha r0d, 1
        ruka .is_w0 kama ==

        r7 = &[tn_n8_ndogo]
        ita tarajia_neno
        linganisha r0d, 1
        ruka .is_n8 kama ==

        r7 = &[tn_n16_ndogo]
        ita tarajia_neno
        linganisha r0d, 1
        ruka .is_n16 kama ==

        r7 = &[tn_n32_ndogo]
        ita tarajia_neno
        linganisha r0d, 1
        ruka .is_n32 kama ==

        r7 = &[tn_n64_ndogo]
        ita tarajia_neno
        linganisha r0d, 1
        ruka .is_n64 kama ==

        r7 = &[tn_d64_ndogo]
        ita tarajia_neno
        linganisha r0d, 1
        ruka .is_d64 kama ==

        ; Jaribu aina ya muundo (jina la mtumiaji)
        ; Muundo lazima UTANGAZWE kabla ya matumizi (utangulizi wa C).
        ; Jina lisilotangazwa (A32, B1, W64, N128, D80 n.k.) si aina
        ; yoyote — ni kosa la sauti, si kugawanyika kwa mkusanyaji.
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .unknown kama !=

        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        sukuma r7
        ita hifadhi_jina
        vuta r7
        r14d = r0d   ; ofseti ya jina (r14 imehifadhiwa)
        r7d = r14d
        ita tafuta_muundo   ; rax = faharisi ya muundo au -1
        linganisha r0d, 0
        ruka .unknown kama <n   ; haujatangazwa — si aina

        ; Ni jina la muundo lililotangazwa — urudi aina=6
        n32[muundo_jina] = r14d   ; hifadhi kwa matumizi ya baadaye
        n64[token_pos]++   ; tumia jina la muundo
        r0d = 6   ; aina = muundo
        r3d ^= r3d
        ruka .check_star

        ; Hakuna aina inayojulikana - rudi kwa unknown
        ruka .unknown

.is_w0:
        r0d = 5
        r3d ^= r3d
        ruka .check_star
.is_n8:
        r0d = 1
        r3d ^= r3d
        ruka .check_star
.is_n16:
        r0d = 2
        r3d ^= r3d
        ruka .check_star
.is_n32:
        r0d = 3
        r3d ^= r3d
        ruka .check_star
.is_n64:
        r0d = 4
        r3d ^= r3d
        ruka .check_star
.is_d64:
        r0d = 7   ; D64 — desimali (double)
        r3d ^= r3d
        ruka .check_star

.check_star:
        ; Angalia ikiwa inafuatiwa na * (moja au zaidi)
        sukuma r0
        r3d ^= r3d
.star_loop:
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NYOTA
        ruka .star_done kama !=
        n64[token_pos]++   ; tumia nyota
        r3d++   ; ongeza hesabu ya nyota
        ruka .star_loop
.star_done:
        vuta r0
        ruka .done

.unknown:
        r0d ^= r0d
        r3d ^= r3d
.done:
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; kosa_aina_isiyojulikana: kosa la aina isiyojulikana kwa neno
; la sasa kwenye token_pos — andika ujumbe kamili na toka 1.
; Inaharibu rax, rcx, rdi, rsi, rdx, r14 (hakuna kurudi).
; -------------------------------------------------------
kosa_aina_isiyojulikana:
        r7 = n64[token_pos]
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        ita hifadhi_jina   ; rax = ofseti ya jina kwenye str_pool
        r14d = r0d
        r7 = &[msg_aina_isiyojulikana_1]
        ita andika_mfuatano
        r7 = &[str_pool + r14]
        ita andika_mfuatano
        r7 = &[msg_aina_isiyojulikana_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; ukubwa_kutoka_aina: rudisha ukubwa wa aina kwa baiti
;   edi = nambari ya aina (1=N8, 2=N16, 3=N32, 4=N64, 5=W0, 6=muundo, 7=D64)
;   rax = ukubwa kwa baiti
; -------------------------------------------------------
ukubwa_kutoka_aina:
        linganisha r7d, 1   ; N8
        ruka .size1 kama ==
        linganisha r7d, 2   ; N16
        ruka .size2 kama ==
        linganisha r7d, 3   ; N32
        ruka .size4 kama ==
        linganisha r7d, 4   ; N64
        ruka .size8 kama ==
        linganisha r7d, 5   ; W0
        ruka .size0 kama ==
        linganisha r7d, 7   ; D64
        ruka .size8 kama ==
        ; Muundo au nyota — tumia 8 (ukubwa wa anwani)
        r0d = 8
        rudi
.size1:
        r0d = 1
        rudi
.size2:
        r0d = 2
        rudi
.size4:
        r0d = 4
        rudi
.size8:
        r0d = 8
        rudi
.size0:
        r0d ^= r0d
        rudi

; -------------------------------------------------------
; tafuta_muundo: tafuta muundo kwa ofseti ya jina
;   edi = ofseti ya jina kwenye bwawa la herufi
;   rax = faharisi ya muundo au -1
; -------------------------------------------------------
tafuta_muundo:
        ; Linganisha jina kwa HERUFI, si kwa ofseti:
        ; hifadhi_jina hairudishi nakala rudufu, kwa hiyo ofseti za
        ; jina moja zinaweza kutofautiana kati ya matangazo.
        sukuma r1
        sukuma r7
        sukuma r6
        sukuma r2
        r7d = r7d   ; sufuri juu ya rdi (ofseti ni N32)
        r6 = &[str_pool + r7]   ; jina linalotafutwa
        r2d ^= r2d
        r1 = n64[muundo_count]
        pima r1, r1
        ruka .not_found kama ==
.tm_loop:
        r7d = n32[muundo_jina_off + r2*4]
        r7 = &[str_pool + r7]   ; jina la muundo la jedwali
        ita linganisha_mfuatano   ; eax = 0 ikiwa sawa
        linganisha r0d, 0
        ruka .found kama ==
        r2d++
        linganisha r2, r1
        ruka .tm_loop kama <a
.not_found:
        r2d = -1
.found:
        r0d = r2d
        vuta r2
        vuta r6
        vuta r7
        vuta r1
        rudi

; -------------------------------------------------------
; changanua_kipengele_msingi: changanua kipengele cha msingi cha usemi
;   rax = faharisi ya nodi ya AST
; -------------------------------------------------------
changanua_kipengele_msingi:
        ; Angalia nambari
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NAMBARI
        ruka .try_name kama !=

        ; Nambari halisi (kamili au desimali)
        r7 = n64[token_pos]
        linganisha n8[token_desimali + r7], 0
        ruka .nambari_desimali kama !=

        r8d = AST_NAMBA
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        linganisha r0d, -1
        ruka .fail kama ==
        sukuma r0
        r7 = n64[token_pos]
        r7 = n64[token_val + r7*8]
        ; Thamani kubwa kuliko N32 (zaidi ya 2147483647) — halisi ya N64:
        ; baiti 8 kwenye bwawa, alama ast_kulia=1 (sawa na mnyororo wa
        ; .swa, unaotumia ast_kulia kama alama ya N64).
        linganisha r7, 2147483647
        ruka .nambari_n64 kama >a
        r1 = n64[ast_count]
        n32[ast_thamani + r1*4 - 4] = r7d   ; nodi iliyoundwa hivi punde
        ruka .nambari_imehifadhiwa
.nambari_n64:
        r0 = n64[lit64_pool_pos]
        r1 = &[r0 + 8]
        linganisha r1, LIT64_POOL_SIZE
        ruka .nambari_pool_jaa kama >a
        n64[lit64_pool_pos] = r1
        n64[lit64_pool + r0] = r7   ; baiti 8 (little-endian)
        r1 = n64[ast_count]
        n32[ast_thamani + r1*4 - 4] = r0d   ; ofseti ya bwawa
        n32[ast_kulia + r1*4 - 4] = 1   ; alama ya N64
.nambari_imehifadhiwa:
        n64[token_pos]++
        vuta r0
        ruka .done
.nambari_pool_jaa:
        vuta r0
        r7 = &[msg_lit64_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.nambari_desimali:
        ; D64: biti 64 hugawanywa — lo32 kwenye ast_thamani, hi32 kwenye ast_tiga
        ; (mkongwe ule ule wa mnyororo wa .swa kwa AST_HALISI_D).
        r7 = n64[token_pos]
        r8d = AST_HALISI_D
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        linganisha r0d, -1
        ruka .fail kama ==
        sukuma r0
        r7 = n64[token_pos]
        r7 = n64[token_val + r7*8]
        r1 = n64[ast_count]
        n32[ast_thamani + r1*4 - 4] = r7d   ; lo32
        r7 >>=a 32
        n32[ast_tiga + r1*4 - 4] = r7d   ; hi32
        n64[token_pos]++
        vuta r0
        ruka .done

.try_name:
        ; Angalia jina
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .try_paren kama !=

        ; Jina — angalia ikiwa ni kitambulisho rahisi
        r7 = n64[token_pos]
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]

        ; Unda nodi ya jina
        r8d = AST_JINA
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        linganisha r0d, -1
        ruka .fail kama ==
        sukuma r0
        sukuma r1
        sukuma r6
        ; Hifadhi jina kwenye bwawa
        vuta r6
        vuta r1
        ita hifadhi_jina
        r1 = n64[ast_count]
        n32[ast_jina_off + r1*4 - 4] = r0d
        n64[token_pos]++
        vuta r0
        ruka .done

.try_paren:
        ; Angalia mabano (usemi)
        r7d = TOK_MABANO_FUNGO
        ita tarajia_ishara
        linganisha r0d, 1
        ruka .try_string kama !=
        ita changanua_usemi
        sukuma r0
        r7d = TOK_MABANO_FUNGA
        ita tarajia_ishara
        vuta r0
        ruka .done

.try_string:
        ; Angalia kama ni mfuatano wa herufi
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_HERUFI
        ruka .fail kama !=
        ; Unda nodi ya AST_KAULI yenye kushoto=-1 kama kiashiria cha mfuatano
        r1 = n64[ast_count]
        linganisha r1, MAX_AST_NODES - 1
        ruka .fail kama >=a
        n32[ast_aina + r1*4] = AST_KAULI
        n32[ast_kushoto + r1*4] = -1   ; kiashiria: si operesheni binary
        n32[ast_kulia + r1*4] = -1
        n32[ast_tiga + r1*4] = -1
        n32[ast_nne + r1*4] = -1
        ; Hifadhi ofseti ya str_pool na urefu wa baiti
        r8 = n64[token_val + r7*8]
        n32[ast_jina_off + r1*4] = r8d   ; ofseti ya str_pool
        r8d = a16[token_len + r7*2]
        n32[ast_thamani + r1*4] = r8d   ; urefu (pamoja na '\0')
        n64[ast_count]++
        n64[token_pos]++
        r0d = r1d
        ruka .done
.done:
        rudi
.fail:
        r0d = -1
        rudi

; -------------------------------------------------------
; changanua_kiambishi: changanua viambishi vya usemi ([], ->, .)
;   edi = nodi ya msingi
;   rax = nodi ya matokeo
; -------------------------------------------------------
changanua_kiambishi:
        sukuma r12
        r12d = r7d   ; hifadhi nodi ya kushoto
.loop:
        r7 = n64[token_pos]
        r7d = n32[token_ty + r7*4]

        ; Angalia [
        linganisha r7d, TOK_MABANO_MKOA
        ruka .faharisi kama ==

        ; Angalia ->
        linganisha r7d, TOK_MSHALE_KULIA
        ruka .mshale kama ==

        ; Angalia .
        linganisha r7d, TOK_NUKTA
        ruka .nukta kama ==

        ; Angalia (
        linganisha r7d, TOK_MABANO_FUNGO
        ruka .wito kama ==

        ruka .done

.faharisi:
        n64[token_pos]++   ; tumia [
        ita changanua_usemi
        r9d = r12d   ; kushoto
        r10d = r0d   ; kulia = faharisi
        r8d = AST_KIELELEZO   ; faharisi ya safu
        r11d = -1
        ita ast_nodi_mpya
        r12d = r0d
        r7d = TOK_MABANO_MKOA_FUNGA   ; ]
        ita tarajia_ishara
        ruka .loop

.mshale:
        n64[token_pos]++   ; tumia ->
        ; Jina la uga ni lazima liwe TOK_NENO — ';' au mwisho wa faili
        ; ungeharibu hifadhi_jina (token_text ya alama si anwani halisi)
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .kiambishi_jina_kosa kama !=
        r7 = n64[token_pos]
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        n64[token_pos]++   ; tumia jina la nyuga

        ; Unda nodi ya jina kwa nyuga
        r8d = AST_JINA
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        sukuma r12
        sukuma r0
        ita hifadhi_jina
        vuta r10   ; nodi ya jina
        r2 = n64[ast_count]
        n32[ast_jina_off + r2*4 - 4] = r0d
        vuta r9   ; nodi ya kushoto

        ; Unda nodi ya mshale (eneekeza au elekeza)
        r8d = AST_ENEKEZA_FUNGO
        r11d = -1
        ita ast_nodi_mpya
        r12d = r0d
        ruka .loop

.nukta:
        n64[token_pos]++   ; tumia .
        ; Jina la uga ni lazima liwe TOK_NENO — '5.;' (nukta ikifuatiwa
        ; na nukta-mkato) lilikuwa likianguka SEGV kwenye hifadhi_jina
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .kiambishi_jina_kosa kama !=
        r7 = n64[token_pos]
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        n64[token_pos]++   ; tumia jina la nyuga

        ; Unda nodi ya jina
        r8d = AST_JINA
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        sukuma r12
        sukuma r0
        ita hifadhi_jina
        vuta r10
        r2 = n64[ast_count]
        n32[ast_jina_off + r2*4 - 4] = r0d
        vuta r9

        ; Unda nodi ya nukta (elekeza_jina)
        r8d = AST_ELEKEZA_JINA
        r11d = -1
        ita ast_nodi_mpya
        r12d = r0d
        ruka .loop

.wito:
        n64[token_pos]++   ; tumia (

        ; Kusanya hoja
        r8d = AST_WAMBILE   ; nodi ya wito
        r9d = -1   ; kushoto = orodha ya hoja (itajazwa baadaye)
        r10d = r12d   ; kulia = jina la kazi
        r11d = -1
        ita ast_nodi_mpya
        sukuma r0
        r15d = r0d   ; hifadhi nodi ya wito

        ; Changanua hoja
        r14d = -1   ; mwanzo wa orodha ya hoja
        r13d = -1   ; hoja iliyotangulia

        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_MABANO_FUNGA
        ruka .wito_mwisho kama ==

.wito_hoja_loop:
        ita changanua_usemi
        linganisha r0d, -1
        ruka .wito_mwisho kama ==
        linganisha r14d, -1
        ruka .hoja_ifuatayo kama !=
        r14d = r0d
        r13d = r0d
        ruka .hoja_angalia_koma
.hoja_ifuatayo:
        n32[ast_nne + r13*4] = r0d
        r13d = r0d
.hoja_angalia_koma:
        r7d = TOK_KOMA
        ita tarajia_ishara
        linganisha r0d, 1
        ruka .wito_hoja_loop kama ==
.wito_mwisho:
        r7d = TOK_MABANO_FUNGA
        ita tarajia_ishara

        vuta r0
        r1 = n64[ast_count]   ; rax = faharisi ya nodi ya wito
        n32[ast_kushoto + r0*4] = r14d   ; weka orodha ya hoja
        r12d = r0d
        ruka .loop

.done:
        r0d = r12d
        vuta r12
        rudi

.kiambishi_jina_kosa:
        ; '.' au '->' ikifuatiwa na kitu kisicho jina (nambari, ';',
        ; mwisho wa faili n.k.) ni kosa LAUTI — zamani SEGV kwenye
        ; hifadhi_jina (token_text ya alama si anwani halisi)
        r7 = &[msg_kiambishi_jina]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; changanua_kipengele_kimoja: changanua kipengele kimoja cha usemi
;   rax = nodi ya AST
; -------------------------------------------------------
changanua_kipengele_kimoja:
        ; Angalia viambishi awali: &, *, -, !
        r7 = n64[token_pos]
        r7d = n32[token_ty + r7*4]

        linganisha r7d, TOK_ALAMA
        ruka .anwani_ya kama ==
        linganisha r7d, TOK_NYOTA
        ruka .nyota_ya kama ==
        linganisha r7d, TOK_ISHARA
        ruka .no_prefix kama !=

        r7 = n64[token_pos]
        linganisha n64[token_val + r7*8], OP_TOA
        ruka .hasili kama ==
        linganisha n64[token_val + r7*8], OP_MAKOSA
        ruka .makosa kama ==
        linganisha n64[token_val + r7*8], OP_MAKOSA_BITI
        ruka .makosa_biti kama ==

.no_prefix:
        ita changanua_kipengele_msingi
        linganisha r0d, -1
        ruka .done kama ==
        r7d = r0d
        ita changanua_kiambishi
        ruka .done

.anwani_ya:
        n64[token_pos]++   ; tumia &
        ita changanua_kipengele_kimoja
        linganisha r0d, -1
        ruka .done kama ==
        r9d = r0d
        r8d = AST_ALAMA_ELEKEZA
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        ruka .done

.nyota_ya:
        n64[token_pos]++   ; tumia *
        ita changanua_kipengele_kimoja
        linganisha r0d, -1
        ruka .done kama ==
        r9d = r0d
        r8d = AST_NYOTA_ELEKEZA
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        ruka .done

.hasili:
        n64[token_pos]++   ; tumia -
        ita changanua_kipengele_kimoja
        linganisha r0d, -1
        ruka .done kama ==
        r9d = r0d
        r8d = AST_HASILI
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        ruka .done

.makosa:
        n64[token_pos]++   ; tumia !
        ita changanua_kipengele_kimoja
        linganisha r0d, -1
        ruka .done kama ==
        r9d = r0d
        r8d = AST_MAKOSA
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        ruka .done

.makosa_biti:
        n64[token_pos]++   ; tumia ~
        ita changanua_kipengele_kimoja
        linganisha r0d, -1
        ruka .done kama ==
        r9d = r0d
        r8d = AST_MAKOSA_BITI
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
.done:
        rudi

; -------------------------------------------------------
; utangulizi_wa_ishara: rudisha utangulizi wa ishara (utangulizi wa C)
;   edi = msimbo wa ishara
;   rax = utangulizi (1..12) au 0 ikiwa haijulikani
;   Viwango (juu zaidi = inafunga nguvu zaidi):
;     12  * / %
;     11  + -
;     10  << >>
;      9  < > <= >=
;      8  == !=
;      7  &
;      6  ^
;      5  |
;      4  &&
;      3  ||
;      1  = (ugawi — chini kabisa, ushirika wa kulia)
;   Hii ni utangulizi wa C, unaoendana na mnyororo wa .swa
;   (msambazaji.swa). Kabla ya 2026-08 mbegu ilikuwa na && || & | ^
;   katika kiwango kimoja na = pamoja na == — mipango miwili
;   iliyotofautiana na C.
; -------------------------------------------------------
utangulizi_wa_ishara:
        linganisha r7d, OP_ZIDISHA
        ruka .prec_12 kama ==
        linganisha r7d, OP_GAWANYA
        ruka .prec_12 kama ==
        linganisha r7d, OP_MODULO
        ruka .prec_12 kama ==
        linganisha r7d, OP_JUMLISHA
        ruka .prec_11 kama ==
        linganisha r7d, OP_TOA
        ruka .prec_11 kama ==
        linganisha r7d, OP_HAMISHA_KUSHOTO
        ruka .prec_10 kama ==
        linganisha r7d, OP_HAMISHA_KULIA
        ruka .prec_10 kama ==
        linganisha r7d, OP_KIDOGO
        ruka .prec_9 kama ==
        linganisha r7d, OP_KUBWA
        ruka .prec_9 kama ==
        linganisha r7d, OP_KIDOGO_SAWA
        ruka .prec_9 kama ==
        linganisha r7d, OP_KUBWA_SAWA
        ruka .prec_9 kama ==
        linganisha r7d, OP_SAWA_SAWA
        ruka .prec_8 kama ==
        linganisha r7d, OP_SIO_SAWA
        ruka .prec_8 kama ==
        linganisha r7d, OP_NA_BITI
        ruka .prec_7 kama ==
        linganisha r7d, OP_XOR_BITI
        ruka .prec_6 kama ==
        linganisha r7d, OP_AU_BITI
        ruka .prec_5 kama ==
        linganisha r7d, OP_NA
        ruka .prec_4 kama ==
        linganisha r7d, OP_AU
        ruka .prec_3 kama ==
        linganisha r7d, OP_SAWA
        ruka .prec_1 kama ==
        r0d = 0
        rudi
; Viwango vinaanza kutoka 1 kwa sababu changanua_usemi_na_utangulizi
; hutumia 0 kama ishara ya "acha kuchunguza" (cmp eax, 0 / je .done).
; Ugawi (=) ni kiwango 1 — chini ya kila kitu — kwa ushirika wa kulia
; (upande wake wa kulia unachanganuliwa kwa kiwango 1, si 2).
; Ulinganisho (< > <= >=) ni 9, lakini upande wake wa kulia
; unachanganuliwa kwa kiwango 11 (jumlisha) — mnyororo wa .swa
; hukataa << >> upande wa kulia wa ulinganisho (mfano: `1 < 2 << 1`
; ni kosa, si `(1 < 2) << 1`).
.prec_12:
        r0d = 12
        rudi
.prec_11:
        r0d = 11
        rudi
.prec_10:
        r0d = 10
        rudi
.prec_9:
        r0d = 9
        rudi
.prec_8:
        r0d = 8
        rudi
.prec_7:
        r0d = 7
        rudi
.prec_6:
        r0d = 6
        rudi
.prec_5:
        r0d = 5
        rudi
.prec_4:
        r0d = 4
        rudi
.prec_3:
        r0d = 3
        rudi
.prec_1:
        r0d = 1
        rudi

; -------------------------------------------------------
; changanua_usemi_na_utangulizi: precedence climbing
;   edi = utangulizi wa chini
;   rax = nodi ya AST
; -------------------------------------------------------
changanua_usemi_na_utangulizi:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r3
        sukuma r7   ; hifadhi utangulizi wa chini (min_prec) kwenye stack
        sukuma 0   ; bendera: kiwango cha ishara iliyotumiwa mara ya mwisho
                                        ; (0 = hakuna) — [rsp] = bendera, [rsp+8] = min_prec

        ita changanua_kipengele_kimoja
        linganisha r0d, -1
        ruka .fail kama ==
        r12d = r0d   ; nodi ya kushoto

.loop:
        ; Angalia ikiwa tokeni ya sasa ni ishara
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_ISHARA
        ruka .check_prec kama ==
        linganisha n32[token_ty + r7*4], TOK_NYOTA
        ruka .check_sawa kama !=

        ; * inaweza kuwa ishara ya zidisha
        r3d = OP_ZIDISHA
        ruka .got_op

.check_sawa:
        linganisha n32[token_ty + r7*4], TOK_SAWA
        ruka .check_alama kama !=
        r3d = OP_SAWA
        ruka .got_op

.check_alama:
        ; & kati ya vielezi — NA ya biti (binary)
        linganisha n32[token_ty + r7*4], TOK_ALAMA
        ruka .check_swali kama !=
        r3d = OP_NA_BITI
        ruka .got_op

.check_swali:
        ; ?: — uchaguzi (ternary), kwenye kiwango cha ugawi na cha juu
        ; (min_prec <= 2): kiwango 0 = mwanzo/mfuatano wa ternary,
        ; 1 = upande wa kulia wa =, 2 = tawi la uwongo la ternary.
        linganisha n32[token_ty + r7*4], TOK_SWALI
        ruka .done kama !=
        r14d = n32[r4+8]   ; utangulizi wa chini
        linganisha r14d, 2
        ruka .done kama >n
        n64[token_pos]++   ; tumia ?

        ; Changanua upande wa kweli
        sukuma r12   ; hifadhi sharti
        r7d = 0
        ita changanua_usemi_na_utangulizi
        r10d = r0d   ; nodi ya kweli
        vuta r8   ; sharti
        linganisha r10d, -1
        ruka .fail kama ==

        ; Tarajia :
        sukuma r8
        sukuma r10
        r7d = TOK_JUWILI
        ita tarajia_ishara
        vuta r10
        vuta r8
        linganisha r0d, 0
        ruka .fail kama ==

        ; Changanua upande wa uwongo kwa kiwango 2 — unaweza kushika
        ; viendeshaji vyote vya binary (|| hadi * / %) na ternary ya
        ; ndani, lakini SI ugawi (=) — uoani na mnyororo wa .swa
        ; (upande wa uwongo wa ternary ni ternary, si ugawi).
        sukuma r8
        sukuma r10
        r7d = 2
        ita changanua_usemi_na_utangulizi
        r11d = r0d   ; nodi ya uwongo
        vuta r10
        vuta r8
        linganisha r11d, -1
        ruka .fail kama ==

        ; Unda nodi ya mfuatano (kweli, uwongo)
        sukuma r8   ; sharti
        sukuma r10   ; kweli
        sukuma r11   ; uwongo
        r8d = AST_MFUATANO
        vuta r11   ; thamani = uwongo
        vuta r9   ; kushoto = kweli
        vuta r10   ; sharti (rudisha baadaye)
        sukuma r10   ; rudisha sharti kwenye stack
        r10d = r11d   ; kulia = uwongo
        sukuma r11
        ita ast_nodi_mpya
        vuta r11
        r1 = n64[ast_count]
        n32[ast_thamani + r1*4 - 4] = r11d
        r13d = r0d   ; nodi ya mfuatano

        ; Unda nodi ya ternary: kushoto = sharti, kulia = mfuatano
        sukuma r13   ; mfuatano
        r8d = AST_KAULI
        vuta r10   ; kulia = mfuatano
        vuta r9   ; kushoto = sharti
        r11d = OP_HUU
        sukuma r11
        ita ast_nodi_mpya
        vuta r11
        r1 = n64[ast_count]
        n32[ast_thamani + r1*4 - 4] = r11d
        r12d = r0d   ; nodi ya ternary
        ruka .loop

.check_prec:
        r3 = n64[token_val + r7*8]
.got_op:
        r7d = r3d
        ita utangulizi_wa_ishara
        linganisha r0d, 0
        ruka .done kama ==
        r13d = r0d   ; utangulizi wa sasa
        ; Bendera ya ulinganisho: ikiwa ishara iliyotumiwa mara ya
        ; mwisho ilikuwa ulinganisho (kiwango 9) na hii ni uhamishaji
        ; (kiwango 10), acha kuchunguza — mnyororo wa .swa hukataa
        ; << >> baada ya < > <= >= kwenye kiwango kile kile
        ; (mfano: `1 < 2 << 1` ni kosa la mchanganuzi, si `(1 < 2) << 1`).
        linganisha n32[r4], 9
        ruka .sema_iko_sawa kama !=
        linganisha r0d, 10
        ruka .done kama ==
.sema_iko_sawa:
        r14d = n32[r4+8]   ; utangulizi wa chini (kutoka stack)
        linganisha r13d, r14d
        ruka .done kama <n

        ; Tumia ishara
        n64[token_pos]++
        n32[r4] = r13d   ; kumbuka kiwango cha ishara iliyotumiwa

        ; Rekodi tokeni ya kwanza ya upande wa kulia (aina na thamani)
        ; kwa utambuzi wa '++' na '--': viendeshaji hivyo HAVIPO kwenye
        ; hati 2.3 — lazima vikataliwe kwa sauti, si no-op kimya.
        ; (Tahadhari: mchanganuzi wa RHS anaweza kula tokeni ya '-'
        ; kama kiambishi hasi — rekodi kabla ya uchanganuzi.)
        r7 = n64[token_pos]
        r7d = n32[token_ty + r7*4]
        sukuma r7   ; [rsp]   = aina ya tokeni ya kwanza
        r7 = n64[token_pos]
        r7 = n64[token_val + r7*8]
        sukuma r7   ; [rsp+8] = thamani ya tokeni ya kwanza

        sukuma r3   ; hifadhi ishara
        sukuma r12   ; hifadhi kushoto

        ; Changanua upande wa kulia kwa utangulizi wa juu:
        ;   - ugawi (=) unajirudia kwa kiwango chake (ushirika wa kulia)
        ;   - ulinganisho (< > <= >=) unachukua kulia kwa kiwango 11
        ;     (jumlisha) — << >> hazijumuiwi, mwigo wa mnyororo wa .swa
        ;   - vingine vyote: kiwango + 1 (ushirika wa kushoto)
        r7d = r13d
        linganisha r7d, 9
        ruka .kulia_linganisho kama ==
        linganisha r7d, 1
        ruka .kulia_endelea kama ==   ; edi = 1 tayari (kiwango cha =)
        r7d++
        ruka .kulia_endelea
.kulia_linganisho:
        r7d = 11
.kulia_endelea:
        ita changanua_usemi_na_utangulizi
        r10d = r0d   ; kulia
        linganisha r10d, -1
        ruka .kulia_kosa kama ==
        vuta r9   ; kushoto
        vuta r8   ; ishara (tunahifadhi kama thamani)
        vuta r1   ; thamani ya tokeni ya kwanza ya RHS
        vuta r2   ; aina ya tokeni ya kwanza ya RHS

        ; Unda nodi ya hesabu au ulinganisho
        sukuma r10
        sukuma r9
        sukuma r8
        r8d = AST_KAULI   ; operesheni binary
        vuta r11   ; thamani = ishara
        vuta r9   ; kushoto
        vuta r10   ; kulia
        sukuma r11
        ita ast_nodi_mpya
        vuta r11
        r1 = n64[ast_count]
        n32[ast_thamani + r1*4 - 4] = r11d
        r12d = r0d
        ruka .loop

.kulia_kosa:
        ; Upande wa kulia haukupatikana. '++' na '--' zinaingia hapa:
        ; tokeni ya kwanza ya RHS ni kiendeshi kingine cha + au -.
        ; Viendeshaji hivyo HAVIPO kwenye hati 2.3 — kataa kwa sauti,
        ; sawa na mnyororo wa .swa (si no-op kimya).
        vuta r9   ; kushoto (hatutumii)
        vuta r8   ; ishara iliyotumiwa
        vuta r1   ; thamani ya tokeni ya kwanza ya RHS
        vuta r2   ; aina ya tokeni ya kwanza ya RHS
        linganisha r8d, OP_JUMLISHA
        ruka .kk_angalia_minus kama !=
        linganisha r2d, TOK_ISHARA
        ruka .kk_operanda kama !=
        linganisha r1d, OP_JUMLISHA
        ruka .kk_operanda kama !=
        r7 = &[msg_plus_plus]
        ruka .kk_andika
.kk_angalia_minus:
        linganisha r8d, OP_TOA
        ruka .kk_operanda kama !=
        linganisha r2d, TOK_ISHARA
        ruka .kk_operanda kama !=
        linganisha r1d, OP_TOA
        ruka .kk_operanda kama !=
        r7 = &[msg_minus_minus]
        ruka .kk_andika
.kk_operanda:
        r7 = &[msg_operanda_kulia]
.kk_andika:
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.done:
        r0d = r12d
        r4 += 8   ; toa nafasi ya bendera
        vuta r7
        vuta r3
        vuta r14
        vuta r13
        vuta r12
        rudi
.fail:
        r0d = -1
        r4 += 8   ; toa nafasi ya bendera
        vuta r7
        vuta r3
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; changanua_usemi: changanua usemi kamili
;   rax = nodi ya AST
; -------------------------------------------------------
changanua_usemi:
        r7d = 0   ; utangulizi wa chini kabisa
        ita changanua_usemi_na_utangulizi
        rudi

; -------------------------------------------------------
; changanua_taarifa: changanua taarifa moja
;   rax = nodi ya AST, -1 ikiwa hakuna taarifa zaidi
; -------------------------------------------------------
changanua_taarifa:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        r7 = n64[token_pos]
        r7d = n32[token_ty + r7*4]

        ; Angalia aina ya taarifa
        linganisha r7d, TOK_MWISHO
        ruka .fail kama ==
        linganisha r7d, TOK_FUNGA
        ruka .fail kama ==

        ; { block } — taarifa ya mchanganyiko
        linganisha r7d, TOK_FUNGO
        ruka .not_block kama !=
        n64[token_pos]++   ; tumia {
        ita changanua_block
        ruka .done

.not_block:
        ; rudisha ...
        linganisha r7d, TOK_NENO
        ruka .try_semicolon kama !=

        ; Angalia ikiwa ni "rudisha"
        r7 = n64[token_pos]
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        r2 = &[kw_rudisha]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .not_return kama !=

        n64[token_pos]++   ; tumia "rudisha"

        ; Angalia ikiwa ni rudisha tupu (ikifuatiwa na ;)
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NUKTA_MKATO
        ruka .return_void kama ==

        ita changanua_usemi
        r9d = r0d
        r8d = AST_RUDISHA
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        ruka .expect_semicolon

.return_void:
        r8d = AST_RUDISHA
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        ruka .expect_semicolon

.not_return:
        ; Angalia ikiwa ni "kama"
        r2 = &[kw_kama]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .not_if kama !=

        n64[token_pos]++   ; tumia "kama"
        r7d = TOK_MABANO_FUNGO
        ita tarajia_ishara
        ita changanua_usemi
        r12d = r0d
        r7d = TOK_MABANO_FUNGA
        ita tarajia_ishara
        ita changanua_block
        r13d = r0d

        ; Angalia sivyo
        r14d = -1
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .no_else kama !=
        r7 = n64[token_pos]
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        r2 = &[kw_sivyo]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .no_else kama !=
        n64[token_pos]++   ; tumia "sivyo"
        ita changanua_block
        r14d = r0d
.no_else:
        ; Unda nodi ya kama: kushoto=hali, kulia=mwili, tiga=sivyo
        r8d = AST_KAMA
        r9d = r12d
        r10d = r13d
        r11d = r14d
        ita ast_nodi_mpya
        ruka .done

.not_if:
        ; Angalia ikiwa ni "wakati"
        r2 = &[kw_wakati]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .not_while kama !=

        n64[token_pos]++   ; tumia "wakati"
        r7d = TOK_MABANO_FUNGO
        ita tarajia_ishara
        ita changanua_usemi
        r12d = r0d
        r7d = TOK_MABANO_FUNGA
        ita tarajia_ishara
        n64[loop_depth]++   ; kitanzi kimefunguka (8.13)
        ita changanua_block
        n64[loop_depth]--
        r13d = r0d
        r8d = AST_WAKATI
        r9d = r12d
        r10d = r13d
        r11d = -1
        ita ast_nodi_mpya
        ruka .done

.not_while:
        ; Angalia ikiwa ni "kwa"
        r2 = &[kw_kwa]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .not_for kama !=

        n64[token_pos]++   ; tumia "kwa"
        r7d = TOK_MABANO_FUNGO
        ita tarajia_ishara

        ; --- Anzisha: tangazo/usemi au tupu (;) ---
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NUKTA_MKATO
        ruka .kwa_init_tupu kama ==
        ita changanua_taarifa   ; tangazo au usemi (hutumia ;)
        r13d = r0d
        ruka .kwa_hali
.kwa_init_tupu:
        n64[token_pos]++
        r13d = -1

.kwa_hali:
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NUKTA_MKATO
        ruka .kwa_hali_tupu kama ==
        ita changanua_usemi
        r14d = r0d
        r7d = TOK_NUKTA_MKATO
        ita tarajia_ishara
        ruka .kwa_hatua
.kwa_hali_tupu:
        n64[token_pos]++
        r14d = -1

.kwa_hatua:
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_MABANO_FUNGA
        ruka .kwa_hatua_tupu kama ==
        ita changanua_usemi
        r15d = r0d
        r7d = TOK_MABANO_FUNGA
        ita tarajia_ishara
        ruka .kwa_mwili
.kwa_hatua_tupu:
        n64[token_pos]++
        r15d = -1

.kwa_mwili:
        n64[loop_depth]++   ; kitanzi kimefunguka (8.13)
        ita changanua_block
        n64[loop_depth]--
        r9d = r0d   ; mwili asili (au -1)

        ; Funga mwili kwenye AST_BLOCK (mnyororo uko kwenye ast_kushoto)
        r10d = -1
        r11d = -1
        r8d = AST_BLOCK
        ita ast_nodi_mpya
        r8d = r0d
        n32[ast_kushoto + r8*4] = r9d
        linganisha r15d, -1
        ruka .kwa_hakuna_hatua_p kama ==

        ; Funga hatua kwenye block-mini yenye alama -777777 kwenye
        ; ast_kulia (kulia ya block huwa -1 kamwe — hakuna mgongano).
        ; Uzalishaji_block hurekodi nafasi yake kwa ajili ya endelea
        ; (semantiki ya C: endelea inaruka kwenye hatua).
        sukuma r8   ; hifadhi wrapper
        r9d = r15d   ; hatua
        r10d = -1
        r11d = -1
        r8d = AST_BLOCK
        ita ast_nodi_mpya
        r15d = r0d   ; r15 = block-mini
        n32[ast_kushoto + r15*4] = r9d
        n32[ast_kulia + r15*4] = -777777
        vuta r8   ; r8 = wrapper
        n32[ast_kulia + r8*4] = -777777   ; alama ya has_step

        ; Ambatisha block-mini mwishoni mwa mnyororo
        r9d = n32[ast_kushoto + r8*4]
        linganisha r9d, -1
        ruka .kwa_mwisho_mnyororo kama !=
        n32[ast_kushoto + r8*4] = r15d
        ruka .kwa_hakuna_hatua_p
.kwa_mwisho_mnyororo:
        r10d = n32[ast_nne + r9*4]
        linganisha r10d, -1
        ruka .kwa_ambatisha_sasa kama ==
        r9d = r10d
        ruka .kwa_mwisho_mnyororo
.kwa_ambatisha_sasa:
        n32[ast_nne + r9*4] = r15d
.kwa_hakuna_hatua_p:

        ; AST_WAKATI: kushoto=hali, kulia=mwili, tiga=anzisha
        r9d = r14d
        r10d = r8d
        r11d = r13d
        r8d = AST_WAKATI
        ita ast_nodi_mpya
        ruka .done

.not_for:
        ; Angalia ikiwa ni "fanya" (fanya { mwili } wakati (sharti); —
        ; mwili hutekelezwa mara moja kabla ya sharti kujaribiwa)
        r2 = &[kw_fanya]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .not_fanya kama !=

        n64[token_pos]++   ; tumia "fanya"

        ; Mwili wa fanya: { ... } — mabano ya mwili ni ya lazima.
        ; Angalia tu (bila kula) — changanua_block ndicho hula {
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_FUNGO
        ruka .fanya_kosa kama !=

        n64[loop_depth]++   ; kitanzi kimefunguka (8.13)
        ita changanua_block
        n64[loop_depth]--
        r13d = r0d   ; r13 = mwili (AST_BLOCK)

        ; Sharti la fanya: neno "wakati" (hali baada ya mwili)
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .fanya_kosa kama !=
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        r2 = &[kw_wakati]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .fanya_kosa kama !=
        n64[token_pos]++   ; tumia "wakati"

        r7d = TOK_MABANO_FUNGO
        ita tarajia_ishara
        linganisha r0d, 1
        ruka .fanya_kosa kama !=
        ita changanua_usemi
        r14d = r0d   ; r14 = sharti (usemi)
        r7d = TOK_MABANO_FUNGA
        ita tarajia_ishara
        linganisha r0d, 1
        ruka .fanya_kosa kama !=

        ; AST_FANYA: kushoto=hali, kulia=mwili (sawa na AST_WAKATI);
        ; tiga haitumiki
        r8d = AST_FANYA
        r9d = r14d
        r10d = r13d
        r11d = -1
        ita ast_nodi_mpya
        ruka .expect_semicolon

.fanya_kosa:
        ; Fanya yenye muundo mbovu (mwili umeshamezwa) — kosa la
        ; sauti, si kurudi nyuma
        r7 = &[msg_parseerr]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.not_fanya:
        ; Angalia ikiwa ni "vunja"
        r2 = &[kw_vunja]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .not_break kama !=

        n64[token_pos]++   ; tumia "vunja"
        ; vunja nje ya kitanzi ni kosa la sauti (8.13) — zamani
        ; ilikubaliwa kimya na kuwa no-op
        linganisha n64[loop_depth], 0
        ruka .vunja_ndani kama !=
        r7 = &[msg_vunja_nje]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.vunja_ndani:
        r8d = AST_VUNJA
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        ruka .expect_semicolon

.not_break:
        ; Angalia ikiwa ni "endelea"
        r2 = &[kw_endelea]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .not_endelea kama !=

        n64[token_pos]++   ; tumia "endelea"
        ; endelea nje ya kitanzi ni kosa la sauti (8.13)
        linganisha n64[loop_depth], 0
        ruka .endelea_ndani kama !=
        r7 = &[msg_endelea_nje]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.endelea_ndani:
        r8d = AST_ENDELEA
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        ruka .expect_semicolon

.not_endelea:
        ; Labda ni tangazo la kigezo (N32 jina = ...) au usemi (wito wa kazi, n.k.)
        ; Jaribu kuchanganua kama tangazo la aina kwanza
        ; Hifadhi nafasi ya token — ikiwa tangazo litashindwa, rejesha na jaribu usemi
        sukuma n64[token_pos]
        ita changanua_aina
        linganisha r0d, 0
        ruka .angalia_aina_taarifa kama ==

        ; Tulipata aina! eax = nambari ya aina, ebx = nyota
        r12d = r0d   ; hifadhi aina
        r13d = r3d   ; hifadhi nyota

        ; "N32;" — taarifa ya jina la aina PEKEE. Jina la aina
        ; halitumiki kama usemi (rekodi 8.19) — kosa la sauti.
        ; Ukataji ni FINYU: ';' mara baada ya aina haufuatiwi na
        ; chochote, kwa hiyo hakuna usemi halali unaoanza hivyo;
        ; kila kitu kingine (mfano "s[0].a = 11") kinarudi kwenye
        ; njia ya usemi kama zamani.
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NUKTA_MKATO
        ruka .kosa_taarifa_aina_pekee kama ==

        ; Hifadhi jina la muundo ndani kwenye rafu (ikiwa aina ni muundo)
        r4 -= 8
        n64[r4] = -1
        linganisha r12d, 6
        ruka .tangazo_sio_muundo kama !=
        r0d = n32[muundo_jina]
        n64[r4] = r0
.tangazo_sio_muundo:

        ; Soma jina la kigezo — neno muhimu halikubaliki (8.12, hati 2.2)
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .decl_error kama !=
        ita kataa_neno_muhimu
        r7 = n64[token_pos]   ; soma upya (kataa inaharibu rejesta)
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        n64[token_pos]++   ; tumia jina

        ; Hifadhi jina kwenye bwawa
        sukuma r13   ; nyota
        sukuma r12   ; aina
        sukuma r1
        sukuma r6
        vuta r6
        vuta r1
        ita hifadhi_jina
        r14d = r0d   ; ofseti ya jina
        vuta r12   ; aina
        vuta r13   ; nyota

        ; Angalia ikiwa ni tangazo la safu: N32 jina[N];
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_MABANO_MKOA
        ruka .tangazo_safu kama ==

        ; Angalia ikiwa kuna sawa (=) kwa thamani ya awali
        r15d = -1   ; chaguo-msingi: hakuna kianzilishi
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_SAWA
        ruka .no_init kama !=

        n64[token_pos]++   ; tumia =
        sukuma r14   ; ofseti ya jina
        sukuma r13   ; nyota
        sukuma r12   ; aina
        ita changanua_usemi
        r15d = r0d   ; nodi ya kianzilishi
        vuta r12   ; aina
        vuta r13   ; nyota
        vuta r14   ; ofseti ya jina
.no_init:
        ; Unda nodi ya AST_TANGAZO
        ; kushoto = kianzilishi, kulia = nyota, thamani = aina, jina_off = jina
        ; tiga = ofseti ya jina la muundo (au -1)
        vuta r11   ; ofseti ya muundo kutoka rafu
        r8d = AST_TANGAZO
        r9d = r15d   ; kushoto = kianzilishi
        r10d = r13d   ; kulia = nyota
        sukuma r11   ; hifadhi ofseti ya muundo
        r11d = -1   ; tiga haitumiki
        ita ast_nodi_mpya
        vuta r11   ; rejesha ofseti ya muundo
        r1 = n64[ast_count]
        n32[ast_thamani + r1*4 - 4] = r12d   ; aina
        n32[ast_jina_off + r1*4 - 4] = r14d   ; jina
        n32[ast_tiga + r1*4 - 4] = r11d   ; muundo (au -1)
        r4 += 8   ; toa token_pos bila kubadilisha eax
        ruka .expect_semicolon

        ; Njia ya safu ya ndani: N32 jina[N]; (miundo pia inaruhusiwa)
.tangazo_safu:
        n64[token_pos]++   ; ruka [
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NAMBARI
        ruka .decl_error kama !=
        r15 = n64[token_val + r7*8]   ; idadi ya elementi
        pima r15, r15
        ruka .decl_error kama ==   ; elementi 0 si halali
        n64[token_pos]++   ; ruka nambari
        r7d = TOK_MABANO_MKOA_FUNGA
        ita tarajia_ishara   ; haibadilishi r15
        linganisha r0d, 1
        ruka .decl_error kama !=
        r15 = -r15   ; hasi inaashiria safu ya ndani (tiga)
        ; Unda nodi ya AST_TANGAZO: tiga = -N, hakuna kianzilishi.
        ; Ofseti ya jina la muundo huwekwa kwenye ast_zaida (safu za
        ; miundo: muundo_ukubwa unahitajika wakati wa usajili).
        ; ast_nne ni mlolongo wa taarifa — hauwezi kutumika.
        vuta r11   ; ofseti ya muundo (au -1)
        sukuma r11   ; hifadhi kwa ast_zaida baadaye
        r8d = AST_TANGAZO
        r9d = -1   ; kushoto = hakuna kianzilishi
        r10d = r13d   ; kulia = nyota
        sukuma r15   ; hifadhi -N (ast_nodi_mpya inaharibu r11)
        r11d = -1   ; thamani haitumiki
        ita ast_nodi_mpya
        vuta r11   ; rejesha -N
        r1 = n64[ast_count]
        n32[ast_thamani + r1*4 - 4] = r12d   ; aina
        n32[ast_jina_off + r1*4 - 4] = r14d   ; jina
        n32[ast_tiga + r1*4 - 4] = r11d   ; -N: safu ya ndani
        vuta r11   ; ofseti ya muundo (au -1)
        n32[ast_zaida + r1*4 - 4] = r11d   ; muundo (safu za miundo)
        r4 += 8   ; toa token_pos bila kubadilisha eax
        ruka .expect_semicolon

.kosa_taarifa_aina_pekee:
        ; Taarifa ya jina la aina pekee (8.19): "N32;" haiwezi kuwa
        ; kitu kingine chochote — aina inahitaji jina la kigezo.
        r7 = &[msg_aina_kama_usemi]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.decl_error:
        ; Sio tangazo — rejesha nafasi ya token na jaribu kama usemi
        ; (8.19 IMEACHWA: ukataji mkali unavunja ugawaji wa
        ; taarifa-usemi kama "s[0].a = 11")
        vuta r0   ; toa ofseti ya muundo
        vuta r0
        n64[token_pos] = r0
        ruka .not_decl

.angalia_aina_taarifa:
        ; Aina haikujulikana. Neno linalofuatiwa na neno lingine ni
        ; jaribio la tangazo la aina isiyojulikana (A32, B1, W64,
        ; N128, D80 n.k.) — kosa la sauti, si kurudi kwenye usemi.
        ; (Usemi halali hauanzi kwa maneno mawili mfululizo.)
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .not_decl_pop kama !=
        r6 = &[r7 + 1]
        linganisha r6, n64[token_count]
        ruka .not_decl_pop kama >=a
        linganisha n32[token_ty + r6*4], TOK_NENO
        ruka .not_decl_pop kama !=
        ruka kosa_aina_isiyojulikana

.not_decl_pop:
        vuta r0   ; toa token_pos iliyohifadhiwa
        ruka .not_decl

.not_decl:
        ; Sio aina — changanua kama usemi
        ita changanua_usemi
        linganisha r0d, -1
        ruka .fail kama ==
        ruka .expect_semicolon

.try_semicolon:
        linganisha r7d, TOK_NUKTA_MKATO
        ruka .empty_statement kama ==
        ruka .not_decl   ; si neno wala ; — jaribu kama usemi (*w = ..., n.k.)
.empty_statement:
        n64[token_pos]++
        r0d = -1   ; taarifa tupu
        ruka .done

.expect_semicolon:
        sukuma r0
        r7d = TOK_NUKTA_MKATO
        ita tarajia_ishara
        vuta r0
        ruka .done

.fail:
        r0d = -1
.done:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; changanua_block: changanua block ya taarifa { ... }
;   rax = nodi ya AST_BLOCK
; -------------------------------------------------------
changanua_block:
        sukuma r12
        sukuma r13
        sukuma r14

        r7d = TOK_FUNGO
        ita tarajia_ishara
        linganisha r0d, 1
        ruka .single_statement kama !=

        ; Unda nodi ya block
        r8d = AST_BLOCK
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        r12d = r0d
        r13d = -1   ; taarifa iliyotangulia

.block_loop:
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_FUNGA
        ruka .block_done kama ==
        ; EOF kabla ya } — mabano yasiyofungwa ni kosa, si kukubalika
        linganisha n32[token_ty + r7*4], TOK_MWISHO
        ruka .block_eof_kosa kama ==
        ; Kinga ya mipaka ya mkondo wa tokeni
        linganisha r7, n64[token_count]
        ruka .block_eof_kosa kama >=a

        ita changanua_taarifa

        linganisha r0d, -1
        ruka .block_done kama ==

        linganisha r13d, -1
        ruka .append_statement kama !=
        n32[ast_kushoto + r12*4] = r0d
        r13d = r0d
        ruka .block_loop
.append_statement:
        n32[ast_nne + r13*4] = r0d
        r13d = r0d
        ruka .block_loop

.block_done:
        r7d = TOK_FUNGA
        ita tarajia_ishara
        r0d = r12d
        ruka .done

.block_eof_kosa:
        ; Mwisho wa faili ndani ya block isiyofungwa
        r7 = &[msg_parseerr]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.single_statement:
        ita changanua_taarifa
.done:
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; changanua_vigezo: changanua orodha ya vigezo vya kazi
;   rax = nodi ya kwanza ya param au -1
; -------------------------------------------------------
changanua_vigezo:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        ; Angalia ikiwa mabano ni tupu
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_MABANO_FUNGA
        ruka .empty kama ==

        r12d = -1   ; param ya kwanza
        r13d = -1   ; param iliyotangulia

.param_loop:
        ; Changanua aina
        ita changanua_aina
        linganisha r0d, 0
        ruka .angalia_param_aina kama ==

        ; W0 ni aina ya KAZI TU — aina ya kurudi (hati 3: "W0 —
        ; Bila thamani (void) — kwa kazi tu"). Parameta ya W0
        ; ilikubaliwa kimyakimya zamani (kama baiti 8) — kosa la
        ; sauti sasa.
        linganisha r0d, 5
        ruka .w0_param_sawa kama !=
        r7 = &[msg_w0_param]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.w0_param_sawa:

        ; r15d = aina (msingi)
        ; rbx = nyota
        r15d = r0d
        r14d = r3d   ; hifadhi nyota

        ; Hifadhi jina la muundo ndani kwenye rafu (ikiwa aina ni muundo)
        r4 -= 8
        n64[r4] = -1
        linganisha r15d, 6
        ruka .param_sio_muundo kama !=
        r0d = n32[muundo_jina]
        n64[r4] = r0
.param_sio_muundo:

        ; Changanua jina la kigezo — neno muhimu halikubaliki
        ; (8.12, hati 2.2)
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .param_jina_hapana kama !=
        ita kataa_neno_muhimu
        r7 = n64[token_pos]   ; soma upya (kataa inaharibu rejesta)
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        n64[token_pos]++

        ; Unda nodi ya param
        r8d = AST_PARAM
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        ; Hifadhi faharisi ya nodi kabla ya hifadhi_jina kuiharibu
        sukuma r0   ; hifadhi faharisi ya nodi
        sukuma r15
        sukuma r14
        ita hifadhi_jina
        r1 = n64[ast_count]
        n32[ast_jina_off + r1*4 - 4] = r0d   ; jina (ofseti ya bwawa)
        vuta r14
        vuta r15
        n32[ast_thamani + r1*4 - 4] = r15d   ; aina
        ; Weka nyota kwenye tiga
        n32[ast_tiga + r1*4 - 4] = r14d
        vuta r0   ; rejesha faharisi ya nodi
        vuta r2   ; ofseti ya muundo au -1
        n32[ast_kushoto + r1*4 - 4] = r2d

        linganisha r12d, -1
        ruka .append_param kama !=
        r12d = r0d
        r13d = r0d
        ruka .param_check_comma
.append_param:
        n32[ast_nne + r13*4] = r0d
        r13d = r0d
        ruka .param_check_comma

.angalia_param_aina:
        ; Aina ya param haijulikani. Neno (D32, A8 n.k.) ni aina
        ; isiyojulikana — kosa la sauti. Isiyo neno (tarakimu,
        ; ishara): ruka kama zamani.
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .skip_unknown_param kama !=
        ruka kosa_aina_isiyojulikana

.skip_unknown_param:
        ; Aina haijulikani (isiyo neno) - ruka kigezo hiki
        ; token_pos bado iko kwenye jina la aina
        n64[token_pos]++   ; ruka jina la aina
        ; Angalia kama kuna nyota
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NYOTA
        ruka .skip_param_name kama !=
        n64[token_pos]++   ; ruka nyota
.skip_param_name:
        ; Ruka jina la kigezo kama lipo
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .param_check_comma kama !=
        n64[token_pos]++   ; ruka jina la kigezo
        ; Angalia koma au mabano ya kufunga

.param_jina_hapana:
        r4 += 8   ; toa ofseti ya muundo
        ruka .done

.param_check_comma:
        r7d = TOK_KOMA
        ita tarajia_ishara
        linganisha r0d, 1
        ruka .param_loop kama ==
        ruka .done

.empty:
        r0d = -1
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi
.done:
        r0d = r12d
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; changanua_kazi: changanua kazi nzima
;   rax = nodi ya AST_KAZI, -1 ikiwa haikuweza
; -------------------------------------------------------
changanua_kazi:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        ; Nafasi ya muundo wa kurudi (sret) — chaguo-msingi: -1
        r4 -= 8
        n64[r4] = -1

        ; Changanua aina ya kurudi
        ita changanua_aina
        linganisha r0d, 0
        ruka .fail_no_type kama ==
        r12d = r0d   ; aina ya kurudi
        ; rbx ina nyota

        ; Ikiwa aina ni muundo (na hakuna nyota), hifadhi jina lake
        pima r3d, r3d
        ruka .kazi_sio_muundo_ret kama !=
        linganisha r12d, 6
        ruka .kazi_sio_muundo_ret kama !=
        r0d = n32[muundo_jina]
        n64[r4] = r0
.kazi_sio_muundo_ret:

        ; Changanua jina la kazi — neno muhimu halikubaliki (8.12,
        ; hati 2.2: kazi inayoitwa 'rudisha' ilikubaliwa kimya)
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .fail_name kama !=
        ita kataa_neno_muhimu
        r7 = n64[token_pos]   ; soma upya (kataa inaharibu rejesta)
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        n64[token_pos]++

        ; Hifadhi jina la kazi
        sukuma r12
        sukuma r3
        ita hifadhi_jina
        r15d = r0d   ; hifadhi ofseti ya jina
        vuta r3
        vuta r12

        ; Sajili aina ya kurudi ya kazi kwa fumbua_aina ya wito.
        ; r12d = aina msingi, ebx = idadi ya nyota, r15d = ofseti ya jina.
        r0 = n64[func_ret_count]
        linganisha r0, MAX_GLOBALS
        ruka .kazi_reg_imejaa kama >=a
        r7 = &[str_pool + r15]
        n64[func_ret_name + r0*8] = r7
        n32[func_ret_base + r0*4] = r12d
        n32[func_ret_star + r0*4] = r3d
        n64[func_ret_count]++
.kazi_reg_imejaa:

        ; Tarajia mabano ya kufungua
        r7d = TOK_MABANO_FUNGO
        ita tarajia_ishara
        linganisha r0d, 1
        ruka .fail_paren kama !=

        ; Changanua vigezo
        ita changanua_vigezo
        r13d = r0d   ; orodha ya vigezo

        ; Rekodi vigezo kwenye jedwali la func_ret_* (8.15/8.16):
        ; idadi na aina za vigezo kwa ukaguzi wa wito. Kila kazi
        ; iliyosajiliwa hapo juu inapata mlango wake; kigezo kina
        ; aina msingi kwenye ast_thamani na nyota kwenye ast_tiga.
        r1 = n64[func_ret_count]
        r1--   ; faharisi ya kazi hii
        r8d ^= r8d
        r9d = r13d
.param_hesabu:
        linganisha r9d, -1
        ruka .param_hesabu_iko kama ==
        r8d++
        r9d = n32[ast_nne + r9*4]
        ruka .param_hesabu
.param_hesabu_iko:
        n32[func_ret_params + r1*4] = r8d
        r9d = r13d
        r10d ^= r10d
.param_nakili:
        linganisha r9d, -1
        ruka .param_nakili_iko kama ==
        linganisha r10d, 16   ; upeo wa rekodi: hoja 16 (8.16)
        ruka .param_nakili_iko kama >=a   ; vigezo zaidi ya 16 havihifadhiwi
        r11d = r1d
        r11d <<= 4   ; rekodi ya hoja 16: faharisi * 16
        r11d += r10d
        r8d = n32[ast_thamani + r9*4]
        n8[func_ret_paina + r11] = r8b
        r8d = n32[ast_tiga + r9*4]
        n8[func_ret_pnyota + r11] = r8b
        r10d++
        r9d = n32[ast_nne + r9*4]
        ruka .param_nakili
.param_nakili_iko:

        ; Tarajia mabano ya kufunga
        r7d = TOK_MABANO_FUNGA
        ita tarajia_ishara
        linganisha r0d, 1
        ruka .fail_close_paren kama !=

        ; Angalia ikiwa ni tangazo la mbele (;) au mwili ({)
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NUKTA_MKATO
        ruka .tangazo_mbele kama ==

        ; Changanua mwili (block)
        ita changanua_block
        r14d = r0d   ; mwili

        ; Unda nodi ya kazi
        r8d = AST_KAZI
        r9d = r13d   ; vigezo
        r10d = r14d   ; mwili
        r11d = -1
        ita ast_nodi_mpya
        r1 = n64[ast_count]
        n32[ast_thamani + r1*4 - 4] = r12d   ; aina
        n32[ast_jina_off + r1*4 - 4] = r15d   ; jina
        r2d = n32[r4]   ; ofseti ya muundo wa kurudi au -1
        n32[ast_tiga + r1*4 - 4] = r2d
        linganisha r2d, -1
        ruka .kazi_hakuna_ret_muundo kama ==
        ; Rekodi kazi inayorudisha muundo (kwa uzalishaji wa sret)
        ; Tahadhari: eax bado ina index ya nodi — usiiharibu!
        r10 = n64[kazi_ret_idadi]
        linganisha r10, 256
        ruka .kaziret_jaa kama >=a
        n32[kazi_ret_jina + r10*4] = r15d
        n32[kazi_ret_muundo_jina + r10*4] = r2d
        n64[kazi_ret_idadi]++
.kazi_hakuna_ret_muundo:
        ruka .done
.kaziret_jaa:
        r7 = &[msg_kaziret_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.tangazo_mbele:
        n64[token_pos]++   ; tumia ;
        ; Unda nodi ya kazi isiyo na mwili
        r8d = AST_KAZI
        r9d = r13d
        r10d = -1   ; mwili = -1
        r11d = -1
        ita ast_nodi_mpya
        r1 = n64[ast_count]
        n32[ast_thamani + r1*4 - 4] = r12d
        n32[ast_jina_off + r1*4 - 4] = r15d
        r2d = n32[r4]   ; ofseti ya muundo wa kurudi au -1
        n32[ast_tiga + r1*4 - 4] = r2d
        linganisha r2d, -1
        ruka .kazi_hakuna_ret_muundo_mbele kama ==
        ; Tahadhari: eax bado ina index ya nodi — usiiharibu!
        r10 = n64[kazi_ret_idadi]
        linganisha r10, 256
        ruka .kaziret_jaa kama >=a
        n32[kazi_ret_jina + r10*4] = r15d
        n32[kazi_ret_muundo_jina + r10*4] = r2d
        n64[kazi_ret_idadi]++
.kazi_hakuna_ret_muundo_mbele:
        ruka .done

.fail_no_type:
        n64[compiler_state] = 2
        ruka .fail_common
.fail_name:
        n64[compiler_state] = 3
        ruka .fail_common
.fail_paren:
        n64[compiler_state] = 4
        ruka .fail_common
.fail_close_paren:
        n64[compiler_state] = 5
        ruka .fail_common
.fail_common:
        r0d = -1
.done:
        r4 += 8   ; toa nafasi ya muundo wa kurudi
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; changanua_muundo: changanua tangazo la muundo
;   token_pos inaelekeza kwenye neno "muundo"
;   rax = 1 ikiwa ilifanikiwa, 0 ikiwa ilishindwa
; -------------------------------------------------------
changanua_muundo:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        ; Tumia neno "muundo"
        n64[token_pos]++

        ; Jina la muundo lazima liwe TOK_NENO — neno muhimu halikubaliki
        ; (8.12, hati 2.2)
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .fail kama !=
        ita kataa_neno_muhimu
        r7 = n64[token_pos]   ; soma upya (kataa inaharibu rejesta)
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]

        ; Jina la muundo linaweza kuwa na umbo la aina (k.m. "K24",
        ; "B12") — mnyororo wa .swa unakubali, kwa hiyo mbegu
        ; inakubali pia (ukaguzi wa aina hutafuta muundo kwenye
        ; jedwali lake kwa herufi, si kwa umbo la jina).
.muundo_jina_sawa:
        r7 = n64[token_pos]   ; soma upya (kaguzi ziliharibu rejesta)
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        n64[token_pos]++
        ita hifadhi_jina
        r12d = r0d   ; ofseti ya jina la muundo

        ; Rekodi muundo kwenye jedwali (upeo: 64)
        r0 = n64[muundo_count]
        linganisha r0, 64
        ruka .muundo_jaa kama >=a

        ; Kagua marudio ya jina. Marudio ya muundo na mgongano na
        ; kigezo cha ulimwengu ni kosa la kufa, sawa na mnyororo wa
        ; .swa (linganisha kwa herufi — hifadhi_jina hairudishi
        ; nakala rudufu). Kazi zinakaguliwa wakati wa uzalishaji,
        ; kwani jedwali la lebo halijajazwa bado.
        sukuma r0   ; hifadhi faharisi ya muundo mpya
        sukuma r3
        r6 = &[str_pool + r12]   ; jina la muundo mpya
        r3d ^= r3d
.kagua_muundo_miundo:
        linganisha r3, n64[muundo_count]
        ruka .kagua_muundo_ulimwengu kama >=a
        sukuma r1
        r7d = n32[muundo_jina_off + r3*4]
        r7 = &[str_pool + r7]
        ita linganisha_mfuatano
        vuta r1
        linganisha r0d, 0
        ruka .kosa_muundo_marudio kama ==
        r3++
        ruka .kagua_muundo_miundo
.kagua_muundo_ulimwengu:
        r3d ^= r3d
.kagua_muundo_ulimwengu_loop:
        linganisha r3, n64[global_count]
        ruka .kagua_muundo_sawa kama >=a
        sukuma r1
        r7 = n64[global_name + r3*8]
        ita linganisha_mfuatano
        vuta r1
        linganisha r0d, 0
        ruka .kosa_jina_aina_mbili_muundo kama ==
        r3++
        ruka .kagua_muundo_ulimwengu_loop
.kagua_muundo_sawa:
        vuta r3
        vuta r0
        n32[muundo_jina_off + r0*4] = r12d
        n32[muundo_ukubwa + r0*4] = 0
        n32[muundo_pangilio + r0*4] = 0
        r1d = n32[nyuga_count]
        n32[muundo_nyuga_anza + r0*4] = r1d
        n64[muundo_count]++
        ruka .muundo_imewekwa
.kosa_muundo_marudio:
        vuta r3
        vuta r0
        sukuma r12   ; ofseti ya jina la muundo
        r7 = &[msg_muundo_marudio_1]
        ita andika_mfuatano
        vuta r7
        r7 = &[str_pool + r7]
        ita andika_mfuatano
        r7 = &[msg_muundo_marudio_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.kosa_jina_aina_mbili_muundo:
        vuta r3
        vuta r0
        sukuma r12   ; ofseti ya jina lenye mgongano
        r7 = &[msg_jina_aina_mbili_1]
        ita andika_mfuatano
        vuta r7
        r7 = &[str_pool + r7]
        ita andika_mfuatano
        r7 = &[msg_jina_aina_mbili_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.muundo_imewekwa:

        ; Tarajia mabano ya mbele {
        r7d = TOK_FUNGO
        ita tarajia_ishara
        linganisha r0d, 1
        ruka .fail kama !=

        ; Hali ya kupanga: ofseti inayoendelea na pangilio la juu
        r13d = 0   ; ofseti inayofuata
        r15d = 0   ; pangilio la juu

.nyuga_loop:
        ; Mwisho wa muundo?
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_FUNGA
        ruka .mwisho kama ==
        ; EOF kabla ya } — muundo usiofungwa ni kosa
        linganisha n32[token_ty + r7*4], TOK_MWISHO
        ruka .nyuga_eof_kosa kama ==
        linganisha r7, n64[token_count]
        ruka .nyuga_eof_kosa kama >=a

        ; Changanua aina ya nyuga
        ita changanua_aina
        linganisha r0d, 0
        ruka .fail kama ==
        r12d = r0d   ; aina msingi (1-6)
        r14d = r3d   ; nyota

        ; Hifadhi jina la muundo ndani kwenye rafu (ikiwa aina ni muundo)
        r4 -= 8
        n64[r4] = -1
        linganisha r12d, 6
        ruka .nyuga_sio_muundo kama !=
        r0d = n32[muundo_jina]
        n64[r4] = r0
.nyuga_sio_muundo:

        ; Jina la nyuga lazima liwe TOK_NENO — neno muhimu halikubaliki
        ; (8.12, hati 2.2)
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .fail_pop kama !=
        ita kataa_neno_muhimu
        r7 = n64[token_pos]   ; soma upya (kataa inaharibu rejesta)
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        n64[token_pos]++

        ; Hifadhi jina la nyuga (hifadhi_jina hufuta rejista)
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        ita hifadhi_jina
        r11d = r0d   ; ofseti ya jina la nyuga
        vuta r15
        vuta r14
        vuta r13
        vuta r12

        ; Kokotoa ukubwa na pangilio la nyuga
        ; r8d = ukubwa, r9d = pangilio, r10d = muundo ndani au -1
        r10d = -1
        r2d = n32[r4]   ; jina la muundo ndani au -1
        ; Aina ya msingi 6 (muundo): tafuta faharisi ya muundo ndani
        ; hata kama nyuga ni pointer — pointer kwenda muundo bado
        ; inahitaji muundo id ili kufumbua wanachama wake
        linganisha r12d, 6
        ruka .nyuga_sio_id kama !=
        linganisha r2d, -1
        ruka .nyuga_sio_id kama ==
        r7d = r2d
        ita tafuta_muundo
        linganisha r0d, -1
        ruka .nyuga_sio_id kama ==
        r10d = r0d   ; faharisi ya muundo ndani
.nyuga_sio_id:
        linganisha r14d, 0
        ruka .nyuga_ptr kama >n
        linganisha r12d, 1
        ruka .nyuga_n8 kama ==
        linganisha r12d, 2
        ruka .nyuga_n16 kama ==
        linganisha r12d, 3
        ruka .nyuga_n32 kama ==
        ; Muundo-thamani ndani — ukubwa na pangilio kutoka jedwali
        linganisha r10d, -1
        ruka .nyuga_ptr kama ==
        r0d = n32[muundo_ukubwa + r10*4]
        r8d = r0d
        r0d = n32[muundo_pangilio + r10*4]
        r9d = r0d
        ruka .nyuga_panga
.nyuga_n8:
        r8d = 1
        r9d = 1
        ruka .nyuga_panga
.nyuga_n16:
        r8d = 2
        r9d = 2
        ruka .nyuga_panga
.nyuga_n32:
        r8d = 4
        r9d = 4
        ruka .nyuga_panga
.nyuga_ptr:
        r8d = 8
        r9d = 8
.nyuga_panga:
        ; MPANGILIO UMEJAA (8.23): ofseti inayoendelea haina kipanga
        ; kimoja — sawa na mnyororo wa .swa (muundo wa N8+N16+N32 ni
        ; baiti 7, si 8). Zamani mbegu ilipanga na kutoa miundo
        ; isiyosomika sawa na uzalishaji.
        ; (hakuna kipanga — r13d inasalia kama ilivyo)

        ; Rekodi nyuga kwenye jedwali (upeo: 512)
        r0 = n64[nyuga_count]
        linganisha r0, 512
        ruka .nyuga_jaa kama >=a
        r1 = n64[muundo_count]
        r1--
        n32[nyuga_muundo + r0*4] = r1d
        n32[nyuga_jina_off + r0*4] = r11d
        n32[nyuga_aina + r0*4] = r12d
        n32[nyuga_muundo_id + r0*4] = r10d
        n32[nyuga_nyota + r0*4] = r14d
        n32[nyuga_ofseti + r0*4] = r13d
        n64[nyuga_count]++

        ; Sogeza ofseti inayoendelea na pangilio la juu
        r13d += r8d
        linganisha r9d, r15d
        ruka .nyuga_align_ok kama <=a
        r15d = r9d
.nyuga_align_ok:

        ; Toa nafasi ya muundo ndani na tarajia nukta mkato
        r4 += 8
        r7d = TOK_NUKTA_MKATO
        ita tarajia_ishara
        linganisha r0d, 1
        ruka .fail kama !=
        ruka .nyuga_loop

.nyuga_eof_kosa:
        ; Mwisho wa faili ndani ya muundo usiofungwa
        r7 = &[msg_parseerr]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.mwisho:
        ; Tumia }
        n64[token_pos]++

        ; Hiari ya nukta mkato baada ya }
        r7d = TOK_NUKTA_MKATO
        ita tarajia_ishara

        ; Muundo tupu: pangilio la chini ni 1
        linganisha r15d, 0
        ruka .pangilio_ok kama !=
        r15d = 1
.pangilio_ok:

        ; Ukubwa wa mwisho: hakuna kuzungusha (mpangilio umejaa —
        ; 8.23); sloti za rafu huzungushwa hadi 8 katika uzalishaji.

        ; Rekodi ukubwa, pangilio, na mwisho wa nyuga
        r0 = n64[muundo_count]
        r0--
        n32[muundo_ukubwa + r0*4] = r13d
        n32[muundo_pangilio + r0*4] = r15d
        r1d = n32[nyuga_count]
        n32[muundo_nyuga_mwisho + r0*4] = r1d

        r0d = 1   ; ilifanikiwa
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

.nyuga_jaa:
        r7 = &[msg_nyuga_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.fail_pop:
        r4 += 8   ; toa nafasi ya muundo ndani
.fail:
        r0d ^= r0d
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi
.muundo_jaa:
        r7 = &[msg_muundo_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; changanua_programu: changanua programu nzima
;   rax = nodi ya mzizi (orodha ya matamko)
; -------------------------------------------------------
changanua_programu:
        sukuma r12
        sukuma r13

        ; Unda nodi ya mzizi (orodha)
        r8d = -1   ; aina maalum kwa mzizi
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        r12d = r0d   ; mzizi
        r13d = -1   ; tamko lililotangulia

.programu_loop:
        r7 = n64[token_pos]
        ; Kinga ya mipaka: usisome zaidi ya mwisho wa mkondo wa tokeni
        linganisha r7, n64[token_count]
        ruka .done kama >=a
        linganisha n32[token_ty + r7*4], TOK_MWISHO
        ruka .done kama ==

        ; Jaribu changanua kazi au tangazo la nje
        ; Angalia ikiwa ni aina
        ; Kwanza, ikiwa sio neno, kosa LAUTI (si ruka kimya)
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .skip_token kama !=

        ; Angalia ikiwa ni husisha
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        r2 = &[kw_husisha]
        sukuma r7
        ita linganisha_neno_muhimu
        vuta r7
        linganisha r0d, 0
        ruka .try_function kama !=

        ; Husisha: aina mbili
        ;   husisha { faili.swa }  — kiungo cha ndani chenye mabano
        ;   husisha C::stdio       — kiungo cha C, hakina mabano
        n64[token_pos]++   ; ruka neno 'husisha'
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_FUNGO
        ruka .husisha_brace kama ==   ; ina { — tumia kuruka kwa mabano

        ; husisha C::xxx — ruka tokeni hadi mstari ubadilike
        r2d = n32[token_line + r7*4]   ; hifadhi nambari ya mstari
.husisha_c_line:
        n64[token_pos]++
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_MWISHO
        ruka .programu_loop kama ==
        linganisha r2d, n32[token_line + r7*4]
        ruka .husisha_c_line kama ==   ; bado kwenye mstari uleule
        ruka .programu_loop   ; mstari mpya — tumeshamaliza

        ; husisha { faili.swa } — kuruka kwa mabano
.husisha_brace:
        r1d = 1   ; kina cha mabano: { = +1, } = -1
.husisha_skip:
        n64[token_pos]++
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_FUNGO
        ruka .husisha_open kama ==
        linganisha n32[token_ty + r7*4], TOK_FUNGA
        ruka .husisha_close kama ==
        linganisha n32[token_ty + r7*4], TOK_MWISHO
        ruka .husisha_eof_kosa kama ==   ; husisha isiyofungwa ni kosa
        ruka .husisha_skip
.husisha_eof_kosa:
        r7 = &[msg_parseerr]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.husisha_open:
        r1d++
        ruka .husisha_skip
.husisha_close:
        r1d--
        ruka .husisha_skip kama !=   ; sio mabano ya kufunga ya nje
        ; kuanguka hadi .husisha_done - tulipata } inayofunga
.husisha_done:
        n64[token_pos]++   ; ruka }
        ruka .programu_loop

.try_function:
        ; Angalia kwanza ikiwa ni tangazo la muundo
        r2 = &[kw_muundo]
        ita linganisha_neno_muhimu
        linganisha r0d, 0
        ruka .sio_muundo kama !=
        ita changanua_muundo
        ruka .programu_loop
.sio_muundo:

        ; Okoa nafasi ya tokeni kabla ya kujaribu changanua kazi
        ; (changanua_kazi hula aina na jina hata inaposhindwa)
        r0 = n64[token_pos]
        sukuma r0
        n64[compiler_state] = 10
        ita changanua_kazi
        n64[compiler_state] = 11
        linganisha r0d, -1
        ruka .try_global kama ==

        ; Ilifanikiwa — ni kazi; tupilie nafasi ya tokeni iliyookolewa
        r4 += 8

        ; Ongeza kwenye orodha ya mzizi
        linganisha r13d, -1
        ruka .append_decl kama !=
        n32[ast_kushoto + r12*4] = r0d
        r13d = r0d
        n64[compiler_state] = 12
        ruka .programu_loop
.append_decl:
        n32[ast_nne + r13*4] = r0d
        r13d = r0d
        n64[compiler_state] = 13
        ruka .programu_loop

; ------------------------------------------------------------
; Tangazo la kigeu cha ulimwengu: N32 x = 42; au N8 buf[1024];
; ------------------------------------------------------------
.try_global:
        ; Rejesha nafasi ya tokeni iliyookolewa (changanua_kazi ilikula tokeni)
        vuta r0
        n64[token_pos] = r0
        n64[compiler_state] = 14

        ; Chunguza aina: eax = aina, ebx = idadi ya nyota
        ita changanua_aina
        linganisha r0d, 0
        ruka .angalia_aina_ngazi kama ==   ; haikujulikana, haikutumia tokeni
        linganisha r0d, 6
                ruka .global_d64_kosa kama >=a   ; D64 ya ulimwengu haisaidiwi na mbegu
                                        ; (kikomo kilichoandikwa) — kosa la sauti

        ; Hifadhi aina na nyota kwenye stack: [rsp] = aina, [rsp+8] = nyota
        sukuma r3
        sukuma r0

        ; Jina la kigeu lazima liwe TOK_NENO — neno muhimu halikubaliki
        ; (8.12, hati 2.2)
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .global_parse_fail kama !=
        ita kataa_neno_muhimu
        r7 = n64[token_pos]   ; soma upya (kataa inaharibu rejesta)
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        ita hifadhi_jina
        r14d = r0d   ; ofseti ya jina kwenye str_pool
        n64[token_pos]++

        ; Kokotoa ukubwa wa aina
        r7d = n32[r4]   ; aina
        ita ukubwa_kutoka_aina
        linganisha r0d, 0
        ruka .global_size8 kama ==   ; W0 -> baiti 8
        linganisha n32[r4+8], 0
        ruka .global_size8 kama >n   ; nyota -> baiti 8
        r15d = r0d
        ruka .global_size_ok
.global_size8:
        r15d = 8
.global_size_ok:

        ; Aina tatu za tangazo: safu [n], = thamani, au tupu ;
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_MABANO_MKOA
        ruka .global_array kama ==
        linganisha n32[token_ty + r7*4], TOK_SAWA
        ruka .global_init kama ==
        linganisha n32[token_ty + r7*4], TOK_NUKTA_MKATO
        ruka .global_bare kama ==
        ruka .global_parse_fail

.global_array:
        n64[token_pos]++   ; ruka [
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NAMBARI
        ruka .global_parse_fail kama !=
        r1 = n64[token_val + r7*8]   ; idadi ya elementi
        r1 *= r15
        r15 = r1   ; ukubwa wa jumla wa safu
        n64[token_pos]++
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_MABANO_MKOA_FUNGA
        ruka .global_parse_fail kama !=
        n64[token_pos]++
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NUKTA_MKATO
        ruka .global_parse_fail kama !=
        n64[token_pos]++
        r8d = 1   ; .bss
        r9d ^= r9d
        r10d = 1   ; ni safu
        ruka .global_register

.global_init:
        n64[token_pos]++   ; ruka =
        ; Kianzio cha ANWANI ya kazi: "= &jina_la_kazi" (4.3). Aina ya
        ; kigezo lazima iwe kielekezi au N64, na hali ya --exe pekee
        ; (kama mnyororo wa uzalishaji); vinginevyo kosa la sauti.
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_ALAMA
        ruka .global_init_anwani kama ==
        r9d ^= r9d   ; thamani ya awali
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_ISHARA
        ruka .global_init_num kama !=
        linganisha n64[token_val + r7*8], OP_TOA
        ruka .global_parse_fail kama !=
        n64[token_pos]++   ; ruka -
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NAMBARI
        ruka .global_parse_fail kama !=
        ; Kianzio cha desimali (D64) — kosa la sauti (8.6): halisi
        ; ya nambari pekee inakubalika kwenye ulimwengu
        linganisha n8[token_desimali + r7], 0
        ruka .global_d64_kosa kama !=
        r9 = n64[token_val + r7*8]
        r9 = -r9   ; hasi
        n64[token_pos]++
        ruka .global_init_end
.global_init_num:
        linganisha n32[token_ty + r7*4], TOK_NAMBARI
        ruka .global_parse_fail kama !=
        ; Kianzio cha desimali (D64) — kosa la sauti (8.6)
        linganisha n8[token_desimali + r7], 0
        ruka .global_d64_kosa kama !=
        r9 = n64[token_val + r7*8]
        n64[token_pos]++
        ruka .global_init_end
.global_d64_kosa:
        r7 = &[msg_ulimwengu_d64]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.global_init_anwani:
        ; & jina — kianzio cha anwani ya kazi. Kagua hali na aina:
        ; kielekezi (nyota) au N64 pekee, si D64/safu/muundo (zile
        ; tayari zimekataliwa na utaratibu wa aina za ulimwengu).
        linganisha n8[exe_mode], 0
        ruka .gia_kosa kama ==
        r0d = n32[r4 + 8]   ; nyota
        linganisha r0d, 0
        ruka .gia_aina_sawa kama >n
        linganisha n32[r4], 4   ; N64
        ruka .gia_aina_sawa kama ==
.gia_kosa:
        r7 = &[msg_kianzio_kazi]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.gia_aina_sawa:
        n64[token_pos]++   ; ruka &
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .gia_kosa kama !=
        r6 = n64[token_text + r7*8]
        r1d = a16[token_len + r7*2]
        ; Hifadhi jina la kazi; r14 (jina la kigezo) na r15 (ukubwa)
        ; huhifadhiwa — vinahitajika na .global_register
        sukuma r14
        sukuma r15
        sukuma r1
        sukuma r6
        vuta r6
        vuta r1
        ita hifadhi_jina
        vuta r15
        vuta r14
        n64[token_pos]++   ; tumia jina la kazi
        ; Rekodi sloti ya sasa ya data_buf (ndiyo sloti ya .data
        ; inayofuata) pamoja na jina — rekebisha_anwani_za_data
        ; itaandika anwani kamili ya kazi mwishoni
        r1 = n64[data_kazi_anwani_idadi]
        linganisha r1, MAX_GLOBALS
        ruka .global_parse_fail kama >=a
        r2d = n32[data_buf_pos]
        n32[data_kazi_anwani_ofseti + r1*4] = r2d
        n32[data_kazi_anwani_jina + r1*4] = r0d
        n64[data_kazi_anwani_idadi]++
        r9d ^= r9d   ; sifuri kwa sasa — itajazwa baadaye
        ruka .global_init_end
.global_init_end:
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NUKTA_MKATO
        ruka .global_parse_fail kama !=
        n64[token_pos]++
        r8d = 0   ; .data
        r10d = 0   ; si safu
        ruka .global_register

.global_bare:
        n64[token_pos]++   ; ruka ;
        r9d ^= r9d
        r8d = 1   ; .bss
        r10d = 0   ; si safu

.global_register:
        linganisha n64[global_count], MAX_GLOBALS
        ruka .global_fail_pops kama >=a
        r1 = n64[global_count]
        pima r8d, r8d
        ruka .global_reg_bss kama !=

        ; — .data: hakikisha nafasi kabla ya kusajili
        r0 = n64[data_buf_pos]
        r0 += r15
        linganisha r0, DATA_BUF_SIZE
        ruka .global_fail_pops kama >a
        r0d = n32[data_buf_pos]
        n32[global_offset + r1*4] = r0d
        n32[global_is_bss + r1*4] = r8d   ; 0 = .data
        n32[global_is_array + r1*4] = 0   ; .data ni tangazo la kuanzishwa tu
        ; Andika thamani kwa mpangilio wa little-endian
        r10 = n64[data_buf_pos]
        r0 = r9
        r11 = r15
.global_data_loop:
        linganisha r11, 0
        ruka .global_data_done kama ==
        n8[data_buf + r10] = r0b
        r0 >>=a 8
        r10++
        r11--
        ruka .global_data_loop
.global_data_done:
        n64[data_buf_pos] += r15
        ruka .global_common

.global_reg_bss:
        r0d = n32[bss_size]
        n32[global_offset + r1*4] = r0d
        n32[global_is_bss + r1*4] = r8d   ; 1 = .bss
        n32[global_is_array + r1*4] = r10d
        n64[bss_size] += r15

.global_common:
        ; Rekodi kigeu cha ulimwengu kwenye jedwali
        r6 = &[str_pool + r14]

        ; Kagua marudio ya jina. Marudio ya kigezo cha ulimwengu na
        ; mgongano na muundo ni kosa la kufa, sawa na mnyororo wa
        ; .swa (linganisha kwa herufi — hifadhi_jina hairudishi
        ; nakala rudufu). Kazi zinakaguliwa wakati wa uzalishaji,
        ; kwani jedwali la lebo halijajazwa bado.
        sukuma r3
        sukuma r1
        r3d ^= r3d
.kagua_ulimwengu:
        linganisha r3, n64[global_count]
        ruka .kagua_miundo kama >=a
        sukuma r1
        r7 = n64[global_name + r3*8]
        ita linganisha_mfuatano
        vuta r1
        linganisha r0d, 0
        ruka .kosa_global_marudio kama ==
        r3++
        ruka .kagua_ulimwengu
.kagua_miundo:
        r3d ^= r3d
.kagua_miundo_loop:
        linganisha r3, n64[muundo_count]
        ruka .kagua_ulimwengu_sawa kama >=a
        sukuma r1
        r7d = n32[muundo_jina_off + r3*4]
        r7 = &[str_pool + r7]
        ita linganisha_mfuatano
        vuta r1
        linganisha r0d, 0
        ruka .kosa_jina_aina_mbili_ulimwengu kama ==
        r3++
        ruka .kagua_miundo_loop
.kagua_ulimwengu_sawa:
        vuta r1
        vuta r3
        n64[global_name + r1*8] = r6
        n32[global_size + r1*4] = r15d
        r0d = n32[r4]
        n32[global_base_type + r1*4] = r0d
        r0d = n32[r4+8]
        n32[global_star_count + r1*4] = r0d
        n64[global_count]++
        ruka .global_imewekwa
.kosa_global_marudio:
        vuta r1
        vuta r3
        sukuma r6   ; jina la kigezo (hupotea kwa andika)
        r7 = &[msg_global_marudio_1]
        ita andika_mfuatano
        vuta r7
        ita andika_mfuatano
        r7 = &[msg_global_marudio_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.kosa_jina_aina_mbili_ulimwengu:
        vuta r1
        vuta r3
        sukuma r6   ; jina lenye mgongano
        r7 = &[msg_jina_aina_mbili_1]
        ita andika_mfuatano
        vuta r7
        ita andika_mfuatano
        r7 = &[msg_jina_aina_mbili_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.global_imewekwa:

        ; Tengeneza nodi ya AST_TANGAZO_ULIM
        r8d = AST_TANGAZO_ULIM
        r9d = -1
        r10d = -1
        r11d = -1
        ita ast_nodi_mpya
        linganisha r0d, -1
        ruka .global_fail_pops kama ==
        r1d = n32[r4]   ; aina -> ast_thamani
        n32[ast_thamani + r0d*4] = r1d
        n32[ast_jina_off + r0d*4] = r14d

        ; Ongeza kwenye orodha ya mzizi
        linganisha r13d, -1
        ruka .global_append kama !=
        n32[ast_kushoto + r12*4] = r0d
        r13d = r0d
        ruka .global_done
.global_append:
        n32[ast_nne + r13*4] = r0d
        r13d = r0d
.global_done:
        r4 += 16
        n64[compiler_state] = 15
        ruka .programu_loop

.global_parse_fail:
        ; Hitilafu ya ulichanganuzi wa tangazo la ulimwengu
        r7 = &[msg_parseerr]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.global_fail_pops:
        ; Kosa LAUTI — jedwali la ulimwengu limejaa (si ruka kimya)
        r7 = &[msg_global_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.angalia_aina_ngazi:
        ; Neno la ngazi ya juu lisilojulikana kama aina — kosa la
        ; sauti lenye jina (si la jumla); usigawanyike kimya.
        r7 = n64[token_pos]
        linganisha n32[token_ty + r7*4], TOK_NENO
        ruka .skip_token kama !=
        ruka kosa_aina_isiyojulikana

.skip_token:
        ; Tokeni isiyojulikana kwenye kiwango cha juu — kosa LAUTI
        r7 = &[msg_parseerr]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.done:
        r0d = r12d
        vuta r13
        vuta r12
        rudi

; =============================================================================
; Sehemu ya 6: Mzalishaji Msimbo (Code Generator)
; =============================================================================

; -------------------------------------------------------
; uzalishaji: linda la kazi ya uzalishaji
;   r12d = nodi ya sasa ya AST
; -------------------------------------------------------

; Hali ya uzalishaji
        ; sehemu: tupu
n64 gen_label_count
n32 gen_fixup_offset[MAX_RELOCS]
n32 gen_fixup_label[MAX_RELOCS]
n64 gen_fixup_count
n64 gen_stack_size
n64 gen_current_func
n64 gen_return_label
n32 gen_label_pos[1024]

; ---------- Aina za hoja za wito (kwa ABI ya xmm) ----------
; hoja_d64[i] = 1 ikiwa hoja i (0-basi) ni desimali (D64); hoja_reg[i]
; = faharisi ya rejesta (gp 0-5 au xmm 0-7) kwa hoja i. Hujazwa wakati
; wa kutathmini hoja na kusomwa wakati wa kuzipanga kwenye rejesta.
; Hifadhiwa na kurejeshwa karibu na wito zilizowekwa ndani.
n8 hoja_d64[16]
n8 hoja_reg[16]
n64 hoja_gp
n64 hoja_xmm

        ; sehemu: msimbo

; -------------------------------------------------------
; gen_label_mpya: tengeneza lebo mpya ya kipekee
;   rax = nambari ya lebo
; -------------------------------------------------------
gen_label_mpya:
        r0 = n64[gen_label_count]
        linganisha r0, 1024
        ruka .genlabel_jaa kama >=a
        n64[gen_label_count]++
        rudi
.genlabel_jaa:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_genlabel_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; gen_andika_baiti_text: ongeza baiti kwenye bafa la .text
;   al = baiti
; -------------------------------------------------------
gen_baiti:
        sukuma r7
        r7 = n64[text_buf_pos]
        linganisha r7, TEXT_BUF_SIZE - 16
        ruka .overflow kama >=a
        r7 = &[text_buf + r7]
        n8[r7] = r0b
        n64[text_buf_pos]++
        vuta r7
        rudi
.overflow:
        r7 = &[msg_textbuf_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; gen_neno4: ongeza baiti 4 kwenye bafa la .text
;   edi = thamani
; -------------------------------------------------------
gen_neno4:
        sukuma r7
        sukuma r1
        r1 = n64[text_buf_pos]
        linganisha r1, TEXT_BUF_SIZE - 16
        ruka .overflow kama >=a
        r1 = &[text_buf + r1]
        n32[r1] = r7d
        n64[text_buf_pos] += 4
        vuta r1
        vuta r7
        rudi
.overflow:
        r7 = &[msg_textbuf_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; gen_neno8: ongeza baiti 8 kwenye bafa la .text
;   rdi = thamani
; -------------------------------------------------------
gen_neno8:
        sukuma r7
        sukuma r1
        r1 = n64[text_buf_pos]
        linganisha r1, TEXT_BUF_SIZE - 16
        ruka .overflow kama >=a
        r1 = &[text_buf + r1]
        n64[r1] = r7
        n64[text_buf_pos] += 8
        vuta r1
        vuta r7
        rudi
.overflow:
        r7 = &[msg_textbuf_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; gen_fixup_ongeza: ongeza fixup kwa kuruka mbele
;   edi = ofseti ya sasa kwenye bafa la .text (ya baiti 4 zilizowekwa)
;   esi = lebo ya kulenga
; -------------------------------------------------------
gen_fixup_ongeza:
        sukuma r3
        r3 = n64[gen_fixup_count]
        linganisha r3, MAX_RELOCS
        ruka .overflow kama >=a
        n32[gen_fixup_offset + r3*4] = r7d
        n32[gen_fixup_label + r3*4] = r6d
        n64[gen_fixup_count]++
        vuta r3
        rudi
.overflow:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_fixup_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; gen_weka_lebo: weka lebo kwenye nafasi ya sasa ya bafa la .text
;   edi = nambari ya lebo
; -------------------------------------------------------
gen_weka_lebo:
        ; Hifadhi nafasi ya lebo: edi = nafasi ya text_buf, esi = nambari ya lebo
        linganisha r6d, 1024
        ruka .overflow kama >=a
        n32[gen_label_pos + r6*4] = r7d
        rudi
.overflow:
        r7 = &[msg_genlabel_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; uzalishaji_tangazo: zalisha msimbo kwa nodi ya tangazo la kigezo
;   r12d = faharisi ya nodi
;   matokeo yanawekwa kwenye eax (thamani ya kianzilishi)
; -------------------------------------------------------
uzalishaji_tangazo:
        sukuma r12
        sukuma r13
        sukuma r14

        r12d = r12d
        r13d = n32[ast_kushoto + r12*4]   ; nodi ya kianzilishi
        r14d = n32[ast_jina_off + r12*4]   ; ofseti ya jina

        ; Sajili kigezo cha ndani
        r1 = n64[local_count]
        linganisha r1, MAX_LOCALS
        ruka .local_jaa kama >=a
        ; Hifadhi jina
        r7 = &[str_pool + r14]
        n64[local_name + r1*8] = r7
        ; Ofseti ya rafu kutoka frame_wapi (baada ya vigezo vyote)
        r8d = n32[frame_wapi]
        n32[local_offset + r1*4] = r8d
        ; Hifadhi aina msingi na idadi ya nyota
        r10d = n32[ast_thamani + r12*4]   ; aina msingi (N8=1, n.k.)
        n32[local_base_type + r1*4] = r10d
        r10d = n32[ast_kulia + r12*4]   ; idadi ya nyota
        n32[local_star_count + r1*4] = r10d
        ; Hifadhi kitambulisho cha muundo (tafuta kwa ofseti ya jina)
        r7d = n32[ast_tiga + r12*4]   ; ofseti ya jina la muundo au -1
        linganisha r7d, -1
        ruka .safu_ya_ndani kama <n   ; hasi isiyo -1: -N, safu ya ndani
        ruka .no_muundo kama ==
        ita tafuta_muundo   ; rax = faharisi ya muundo au -1
        r10d = r0d
        n32[local_array_size + r1*4] = 0
        ruka .muundo_hifadhiwa
.safu_ya_ndani:
        r7d = -r7d   ; idadi ya elementi N
        n32[local_array_size + r1*4] = r7d
        r10d = -1
        ; Safu ya miundo: id ya muundo iko kwenye ast_zaida (jina la muundo)
        r11d = n32[local_base_type + r1*4]
        linganisha r11d, 6
        ruka .muundo_hifadhiwa kama !=
        r7d = n32[ast_zaida + r12*4]
        linganisha r7d, 0
        ruka .muundo_hifadhiwa kama <=n
        ita tafuta_muundo
        r10d = r0d
        ruka .muundo_hifadhiwa
.no_muundo:
        r10d = -1
        n32[local_array_size + r1*4] = 0
.muundo_hifadhiwa:
        n32[local_muundo_id + r1*4] = r10d
        n32[local_kwa_rejea + r1*4] = 0   ; si paramu ya rejea
        n64[local_count]++
        ruka .local_sajiliwa
.local_jaa:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_local_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.local_sajiliwa:

        ; Safu ya ndani: sehemu ya rafu = N x ukubwa wa elementi,
        ; imepangiliwa kwa 8; ofseti ni msingi wa eneo (kama muundo)
        r10d = n32[local_array_size + r1*4]
        pima r10d, r10d
        ruka .sio_safu_slot kama ==
        ; Ukubwa wa elementi moja
        r11d = n32[local_star_count + r1*4]
        linganisha r11d, 0
        ruka .safu_uk_8 kama !=
        r11d = n32[local_base_type + r1*4]
        linganisha r11d, 6
        ruka .safu_uk_muundo kama ==
        r7d = r11d
        ita ukubwa_kutoka_aina   ; haibadilishi rcx/r10/r11
        pima r0d, r0d
        ruka .safu_uk_ok kama !=
        r0d = 8   ; W0 → 8
.safu_uk_ok:
        ruka .safu_uk_hifadhiwa
.safu_uk_muundo:
        ; Safu ya miundo: elementi ni muundo mzima (ukubwa kutoka jedwali)
        r7d = n32[local_muundo_id + r1*4]
        linganisha r7d, 0
        ruka .safu_uk_8 kama <n
        linganisha r7d, n32[muundo_count]
        ruka .safu_uk_8 kama >=a
        r0d = n32[muundo_ukubwa + r7*4]
        ruka .safu_uk_hifadhiwa
.safu_uk_8:
        r0d = 8
.safu_uk_hifadhiwa:
        r0 *= n64[local_array_size + r1*4]
        r0 += 7
        r0 &= ~7
        n64[frame_wapi] += r0
        r8d = n32[frame_wapi]
        r8d -= 8
        n32[local_offset + r1*4] = r8d
        ruka .slot_done
.sio_safu_slot:

        ; Amua ukubwa wa sehemu ya rafu
        ; Muundo bila nyota: ukubwa wa muundo uliopangiliwa kwa 8
        r10d = n32[local_base_type + r1*4]
        linganisha r10d, 6
        ruka .slot_8 kama !=
        r10d = n32[local_star_count + r1*4]
        linganisha r10d, 0
        ruka .slot_8 kama !=
        r7d = n32[local_muundo_id + r1*4]
        linganisha r7d, -1
        ruka .slot_8 kama ==
        r10d = n32[muundo_ukubwa + r7*4]
        r10d += 7
        r10d &= ~7
        n64[frame_wapi] += r10
        ; Ofseti ya muundo: eneo lake ni [rbp-O, rbp-O+ukubwa).
        ; Ili lisiingiliane na kigezo kinachofuata, msingi lazima
        ; uwe frame_wapi_mpya - 8 (na sloti ya scalar inaanzia
        ; frame_wapi_ya_zamani — miungo huongezwa juu ya msingi)
        r8d = n32[frame_wapi]
        r8d -= 8
        n32[local_offset + r1*4] = r8d
        ruka .slot_done
.slot_8:
        n64[frame_wapi] += 8
.slot_done:

        ; Muundo bila nyota: thamani yake ni anwani yake
        r10d = n32[local_base_type + r1*4]
        linganisha r10d, 6
        ruka .scalar kama !=
        r10d = n32[local_star_count + r1*4]
        linganisha r10d, 0
        ruka .scalar kama !=
        ; Hakuna kianzilishi: hakuna msimbo wa kuhifadhi
        linganisha r13d, -1
        ruka .tangazo_mwisho kama ==
        ; Kinga: muundo usiotambulika (id hasi au nje ya jedwali)
        ; haupaswi kuwapo — ikiwa utatokea, ruka nakala kabla ya
        ; kutoa msimbo wowote (usisome muundo_ukubwa kwa id hasi).
        r7d = n32[local_muundo_id + r1*4]
        linganisha r7d, 0
        ruka .tangazo_mwisho kama <n
        linganisha r7d, n32[muundo_count]
        ruka .tangazo_mwisho kama >=a
        ; Muundo wenye kianzilishi: lea rax, [rbp + disp32]
        r0b = 0x48
        ita gen_baiti
        r0b = 0x8D
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        r7d = r8d
        r7d = -r7d
        ita gen_neno4
        ; Hifadhi anwani ya lengo kwenye rafu (push rax)
        r0b = 0x50
        ita gen_baiti
        ; Tathmini kianzilishi — anwani ya chanzo inabaki kwenye rax
        sukuma r12
        r12d = r13d
        ita uzalishaji_ast
        vuta r12
        ; Rejesha faharisi ya usajili baada ya tathmini
        r1 = n64[local_count]
        r1--
        ; Nakili muundo: mov rsi, rax; pop rdi; mov ecx, ukubwa; rep movsb
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xC6
        ita gen_baiti
        r0b = 0x5F
        ita gen_baiti
        r0b = 0xB9
        ita gen_baiti
        r7d = n32[local_muundo_id + r1*4]
        r7d = n32[muundo_ukubwa + r7*4]
        ita gen_neno4
        r0b = 0xF3
        ita gen_baiti
        r0b = 0xA4
        ita gen_baiti
        ruka .tangazo_mwisho

.scalar:
        ; Safu ya ndani: hakuna msimbo wa kuhifadhi kianzilishi
        linganisha n32[local_array_size + r1*4], 0
        ruka .tangazo_mwisho kama >n
        ; Thamani ya kianzilishi (ikiwa ipo)
        linganisha r13d, -1
        ruka .no_init kama ==
        ; Kianzilishi cha tangazo la N64: uhamishaji << >> huhesabiwa
        ; kwa baiti 8 hata kama operanda zote ni ndogo (8.5):
        ; "N64 x = 1 << 32" lazima itoe 4294967296, si 1 (1 << (32 & 31)).
        ; Alama inasomwa na uzalishaji_kauli_ya_binary (upana wa
        ; uhamishaji) na panua_ishara_ya_kauli (usitoe cdqe kwenye
        ; matokeo ya baiti 8). Inafutwa katika .bmd_kianzio_isha.
        n32[kianzio_lengo64] = 0
        r8d = n32[local_base_type + r1*4]
        linganisha r8d, 4
        ruka .kianzio_64_isha kama !=
        r10d = n32[local_star_count + r1*4]
        pima r10d, r10d
        ruka .kianzio_64_isha kama !=
        n32[kianzio_lengo64] = 1
.kianzio_64_isha:
        sukuma r12
        r12d = r13d
        ita uzalishaji_ast
        vuta r12
        ; Panua ishara ya matokeo ya hesabu ya binary kabla ya
        ; kuhifadhiwa kwenye kigezo cha baiti 8: "N64 y = 0 - 90;"
        ; — operesheni ya N32 (sub eax, ecx) huacha biti 32 za juu
        ; kuwa sifuri; cdqe (48 98) huzipanua kwa ishara. Sawia na
        ; panua_ishara_ndogo ya mnyororo wa .swa na uwekaji
        ; (.do_assign); anwani (kielekezi, jina la safu) hazipanuliwi.
        r7d = r13d
        ita panua_ishara_ya_kauli
        ; Mpaka wa kamili/desimali kwenye kianzio (8.6): D64 → kamili
        ; (kukata hadi sifuri) na kamili → D64 (pandisha).
        r1 = n64[local_count]
        r1--
        r8d = n32[local_base_type + r1*4]
        r10d = n32[local_star_count + r1*4]
        pima r10d, r10d
        ruka .bmd_kianzio_isha kama !=   ; kielekezi — hakuna ubadilishaji
        linganisha r8d, 7
        ruka .bmd_kianzio_d64 kama ==
        linganisha r8d, 4
        ruka .bmd_kianzio_64 kama ==
        linganisha r8d, 1
        ruka .bmd_kianzio_32 kama ==
        linganisha r8d, 2
        ruka .bmd_kianzio_32 kama ==
        linganisha r8d, 3
        ruka .bmd_kianzio_32 kama ==
        ruka .bmd_kianzio_isha
.bmd_kianzio_d64:
        r6d = 7
        r2d = 8
        r7d = r13d
        ita badilisha_mpaka_wa_desimali
        ruka .bmd_kianzio_isha
.bmd_kianzio_64:
        r6d = 4
        r2d = 8
        r7d = r13d
        ita badilisha_mpaka_wa_desimali
        ruka .bmd_kianzio_isha
.bmd_kianzio_32:
        r6d = 3
        r2d = 4
        r7d = r13d
        ita badilisha_mpaka_wa_desimali
.bmd_kianzio_isha:
        n32[kianzio_lengo64] = 0
        ruka .store_value
.no_init:
        r0d ^= r0d   ; hakuna kianzilishi, thamani = 0
        ; D64 bila kianzilishi: sifuri kwenye xmm0 (pxor xmm0, xmm0
        ; → 66 0F EF C0), si takataka kutoka kwa eax.
        r1 = n64[local_count]
        r1--
        linganisha n32[local_base_type + r1*4], 7
        ruka .store_value kama !=
        r0b = 0x66
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xEF
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .store_value
.store_value:
        ; Rejesha faharisi ya usajili na ofseti baada ya tathmini
        r1 = n64[local_count]
        r1--
        r8d = n32[local_offset + r1*4]

        ; Angalia kama tunahitaji 64-bit store
        r10d = n32[local_star_count + r1*4]
        linganisha r10d, 0
        ruka .store_64 kama >n
        r10d = n32[local_base_type + r1*4]
        linganisha r10d, 4   ; N64
        ruka .store_64 kama ==
        linganisha r10d, 5   ; W0
        ruka .store_64 kama ==
        linganisha r10d, 7   ; D64
        ruka .store_d64 kama ==

        ; 32-bit store: mov [rbp + disp32], eax  ->  89 85 d32
        r0b = 0x89
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        r7d = r8d
        r7d = -r7d
        ita gen_neno4
        ruka .tangazo_mwisho

.store_64:
        ; 64-bit store: mov [rbp + disp32], rax  ->  48 89 85 d32
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        r7d = r8d
        r7d = -r7d
        ita gen_neno4
        ruka .tangazo_mwisho

.store_d64:
        ; movsd [rbp + disp32], xmm0  ->  f2 0f 11 85 d32
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x11
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        r7d = r8d
        r7d = -r7d
        ita gen_neno4

.tangazo_mwisho:
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_nambari: zalisha msimbo kwa nodi ya nambari
;   r12d = faharisi ya nodi
;   matokeo yanawekwa kwenye eax (32-bit) au rax (64-bit)
; -------------------------------------------------------
uzalishaji_nambari:
        sukuma r12
        sukuma r13
        r12d = r12d   ; hakikisha ni 32-bit
        r7d = n32[ast_thamani + r12*4]
        ; Alama ya N64 (ast_kulia == 1): mov rax, imm64 — 48 B8 + baiti 8
        linganisha n32[ast_kulia + r12*4], 1
        ruka .emit_imm64 kama ==
        ; Toa maelekezo: mov eax, imm32
        r0b = 0xb8   ; opcode ya "mov eax, imm32"
        ita gen_baiti
        ita gen_neno4   ; edi = thamani ya haraka
        r0d = r7d   ; rudisha thamani
        vuta r13
        vuta r12
        rudi
.emit_imm64:
        ; mov rax, imm64 -> 48 B8 + baiti 8 (kutoka kwenye bwawa)
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0xB8   ; mov rax, imm64
        ita gen_baiti
        r13 = &[lit64_pool]
        r13 += r7   ; r13 = anwani ya baiti 8
        r1d = 8
.imm64_loop:
        r0b = n8[r13]
        ita gen_baiti
        r13++
        r1d--
        ruka .imm64_loop kama !=
        r0d = n32[lit64_pool + r7]   ; CT: biti 32 za chini
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_halisi_d: zalisha msimbo kwa halisi ya D64
;   Biti 64 zimegawanywa: ast_thamani = lo32, ast_tiga = hi32.
;   Hutoa thabiti ya baiti 8 kwenye .data (iliyopangiliwa kwa 8) na
;   inapakia kwenye xmm0: movsd xmm0, [disp32].
;   CT: -1 (haijulikani — hesabu ya kuelea haikunjwi na mbegu).
; -------------------------------------------------------
uzalishaji_halisi_d:
        sukuma r12
        sukuma r13
        r12d = r12d
        r13d = n32[ast_thamani + r12*4]   ; lo32

        ; Pangilia data_buf_pos kwa 8 NA usonge mbele kwa baiti 8
        r0 = n64[data_buf_pos]
        r0 += 7
        r0 &= ~7
        r1 = r0   ; mwanzo wa thabiti
        r0 += 8   ; nafasi inayofuata
        linganisha r0, DATA_BUF_SIZE
        ruka .data_jaa kama >a
        n64[data_buf_pos] = r0

        ; Andika baiti 8 (little-endian: lo32 kwanza, kisha hi32)
        n32[data_buf + r1] = r13d
        r13d = n32[ast_tiga + r12*4]   ; hi32
        n32[data_buf + r1 + 4] = r13d

        ; movsd xmm0, [disp32]  ->  f2 0f 10 05 d32
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x10
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti

        ; Rekebisho la .data (sawa na mfuatano): addend = data_offset - 4
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        n32[rela_sym + r7*4] = -1   ; .data section
        r1d -= 4   ; data_offset - 4
        n32[rela_addend + r7*4] = r1d
        n64[rela_count]++
        ; Weka nafasi ya disp32
        r7d = 0
        ita gen_neno4

        r0d = -1   ; CT: haijulikani
        vuta r13
        vuta r12
        rudi
.rela_jaa:
        r7 = &[msg_rela_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.data_jaa:
        r7 = &[msg_databuf]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; uzalishaji_jina: zalisha msimbo kwa nodi ya jina (rejeleo ya kigezo)
;   r12d = faharisi ya nodi
;   matokeo kwenye eax
; -------------------------------------------------------
uzalishaji_jina:
        sukuma r12
        sukuma r13
        sukuma r14

        r12d = r12d

        ; Tafuta kigezo kwenye orodha ya vigezo vya ndani
        r14d = n32[ast_jina_off + r12*4]   ; ofseti ya jina
        r14 = &[str_pool + r14]   ; anwani ya jina

        r13d ^= r13d
.search_loop:
        linganisha r13, n64[local_count]
        ruka .not_found kama >=a
        r7 = n64[local_name + r13*8]
        r6 = r14
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .found kama ==
        r13++
        ruka .search_loop

.found:
        ; Kigezo kiko kwenye rafu
        r7d = n32[local_offset + r13*4]
        r7d = -r7d   ; edi = hasi (kwa [rbp + disp32])

        ; Safu ya ndani — anwani ndiyo thamani (kama muundo)
        linganisha n32[local_array_size + r13*4], 0
        ruka .lea_ya_safu kama >n

        ; Muundo wa ndani (aina 6, bila nyota) — anwani ndiyo thamani
        r8d = n32[local_base_type + r13*4]
        linganisha r8d, 6
        ruka .sio_muundo kama !=
        r8d = n32[local_star_count + r13*4]
        linganisha r8d, 0
        ruka .load_ptr64 kama !=   ; muundo* — pakia pointer
        ; Paramu ya muundo mkubwa (kwa rejea): sloti ina kielekezi
        linganisha n32[local_kwa_rejea + r13*4], 0
        ruka .load_ptr64 kama !=
        ; lea rax, [rbp+disp32]
.lea_ya_safu:
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x8D   ; lea
        ita gen_baiti
        r0b = 0x85   ; ModRM: [rbp+disp32], reg=rax
        ita gen_baiti
        ita gen_neno4
        ruka .load_done

.sio_muundo:
        ; Angalia ikiwa ni kigezo cha nyota (pointer) — paki baiti 8 daima
        r8d = n32[local_star_count + r13*4]
        linganisha r8d, 0
        ruka .load_ptr64 kama >n

        ; Sio pointer — paki kulingana na aina msingi
        r8d = n32[local_base_type + r13*4]
        linganisha r8d, 1   ; N8
        ruka .load_n8 kama ==
        linganisha r8d, 2   ; N16
        ruka .load_n16 kama ==
        linganisha r8d, 4   ; N64
        ruka .load_n64 kama ==
        linganisha r8d, 7   ; D64
        ruka .load_d64 kama ==
        ; N32 (3) au chaguo-msingi
        r0b = 0x8B   ; mov eax, [rbp+disp32]
        ita gen_baiti
        r0b = 0x85   ; ModRM: [rbp+disp32], reg=eax
        ita gen_baiti
        ita gen_neno4
        ruka .load_done

.load_n8:
        ; movsx eax, byte [rbp+disp32] — upanuzi wa ISHARA (8.20):
        ; N8 hasi (-1) inapakiwa kama -1, si 255.
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xBE
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        ita gen_neno4
        ruka .load_done

.load_n16:
        ; movsx eax, word [rbp+disp32] — upanuzi wa ISHARA (8.20)
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xBF
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        ita gen_neno4
        ruka .load_done

.load_n64:
.load_ptr64:
        ; Pointer au N64 — paki baiti 8
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x8B   ; mov rax, [rbp+disp32]
        ita gen_baiti
        r0b = 0x85   ; ModRM: [rbp+disp32], reg=rax
        ita gen_baiti
        ita gen_neno4
        ruka .load_done

.load_d64:
        ; D64 — paki baiti 8 kwenye xmm0: f2 0f 10 85 d32
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x10
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        ita gen_neno4
        r0d = -1   ; CT haijulikani kwa D64
        vuta r14
        vuta r13
        vuta r12
        rudi

.load_done:
        ; Thamani itasomwa wakati wa utekelezaji; rudisha 0 kwa sasa
        r0d ^= r0d
        vuta r14
        vuta r13
        vuta r12
        rudi

.not_found:
        ; Tafuta kwenye orodha ya vigezo vya ulimwengu
        r13d ^= r13d
.search_ulimwengu:
        linganisha r13, n64[global_count]
        ruka .not_found_exit kama >=a
        r7 = n64[global_name + r13*8]
        r6 = r14
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .found_ulimwengu kama ==
        r13++
        ruka .search_ulimwengu

.found_ulimwengu:
        ; Kigezo cha ulimwengu — pakia kwa RIP-relative
        linganisha n32[global_is_array + r13*4], 0
        ruka .load_ulimwengu_lea kama !=   ; safu — rudisha anwani yake
        r8d = n32[global_base_type + r13*4]
        linganisha r8d, 6
        ruka .load_ulimwengu_lea kama ==   ; muundo — anwani ndiyo thamani
        r8d = n32[global_star_count + r13*4]
        linganisha r8d, 0
        ruka .load_ulimwengu_n64 kama >n
        r8d = n32[global_base_type + r13*4]
        linganisha r8d, 1   ; N8
        ruka .load_ulimwengu_n8 kama ==
        linganisha r8d, 2   ; N16
        ruka .load_ulimwengu_n16 kama ==
        linganisha r8d, 4   ; N64
        ruka .load_ulimwengu_n64 kama ==
        linganisha r8d, 5   ; W0 — pointer, baiti 8
        ruka .load_ulimwengu_n64 kama ==
        ; N32 (3) au chaguo-msingi
.load_ulimwengu_n32:
        r0b = 0x8B   ; mov eax, [rip+disp32]
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ruka .load_ulimwengu_reloc
.load_ulimwengu_n8:
        ; movsx eax, byte [rip+disp32] — upanuzi wa ISHARA (8.20)
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xBE
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ruka .load_ulimwengu_reloc
.load_ulimwengu_n16:
        ; movsx eax, word [rip+disp32] — upanuzi wa ISHARA (8.20)
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xBF
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ruka .load_ulimwengu_reloc
.load_ulimwengu_n64:
        r0b = 0x48   ; mov rax, [rip+disp32]
        ita gen_baiti
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ruka .load_ulimwengu_reloc

.load_ulimwengu_lea:
        ; Safu ya ulimwengu — rudisha anwani: lea rax, [rip+disp32]
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x8D   ; lea
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti

.load_ulimwengu_reloc:
        ; Ongeza rekebisho la R_X86_64_PC32 kwa kigezo cha ulimwengu
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .ulimwengu_rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        r0d = r13d
        r0d += 2
        r0d = -r0d
        n32[rela_sym + r7*4] = r0d
        n32[rela_addend + r7*4] = -4
        n64[rela_count]++
.skip_ulimwengu_reloc:
        ; Weka nafasi ya disp32 (baiti 4 za sifuri)
        r7d = 0
        ita gen_neno4
        ruka .load_done
.ulimwengu_rela_jaa:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_rela_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.not_found_exit:
        ; Jina la kazi BILA & kama usemi ni kosa la sauti (4.2) —
        ; zamani lilirudisha 0 kimya. Anwani ya kazi inachukuliwa kwa
        ; & jina_la_kazi tu (4.3). r14 bado ina anwani ya jina kwenye
        ; bwawa la herufi — tafuta kati ya kazi zilizosajiliwa.
        r13d ^= r13d
.uj_fn_skan:
        linganisha r13, n64[func_ret_count]
        ruka .uj_sio_kazi kama >=a
        r7 = n64[func_ret_name + r13*8]
        r6 = r14
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .uj_kazi_ipo kama ==
        r13++
        ruka .uj_fn_skan
.uj_sio_kazi:
        r0d ^= r0d
        vuta r14
        vuta r13
        vuta r12
        rudi
.uj_kazi_ipo:
        r7 = &[msg_kazi_usemi_1]
        ita andika_mfuatano
        r7 = r14
        ita andika_mfuatano
        r7 = &[msg_mstari_mpya]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; toa_anwani_kazi: toa "lea rax, [rel kazi]" kwa jina la kazi
;   r14 = anwani ya jina la kazi (kwenye str_pool)
;   Inaharibu rax, rcx, rdx, rdi, rsi na r13.
; -------------------------------------------------------
toa_anwani_kazi:
        ; lea rax, [rip + disp32] — 48 8D 05 d32
        r0b = 0x48
        ita gen_baiti
        r0b = 0x8D
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ; Ongeza nje (jina la kazi) na rekebisho la PC32 — sawa na wito
        ; wa kazi: .o inafungua kwenye uunganishaji, exe inatatua kwa
        ; lebo ya ndani (au inalia kwa sauti kama kazi haipo)
        r7 = n64[extern_count]
        linganisha r7, MAX_EXTERNS - 1
        ruka .ak_extern_jaa kama >=a
        r2 = &[extern_name]
        n64[r2 + r7*8] = r14
        n64[extern_count]++
        r13d = r7d   ; faharisi ya nje
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .ak_rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        n32[rela_sym + r7*4] = r13d
        n32[rela_addend + r7*4] = -4
        n64[rela_count]++
        r7d = 0
        ita gen_neno4
        rudi
.ak_extern_jaa:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_extern_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.ak_rela_jaa:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_rela_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; uzalishaji_anwani_ya: zalisha msimbo kwa nodi ya & (chukua anwani)
;   r12d = faharisi ya nodi (AST_ALAMA_ELEKEZA)
;   mtoto wa kushoto = usemi unaochukuliwa anwani
;   huweka anwani kwenye eax
; -------------------------------------------------------
uzalishaji_anwani_ya:
        sukuma r12
        sukuma r13
        sukuma r14

        r12d = r12d
        r13d = n32[ast_kushoto + r12*4]   ; nodi ya mtoto

        ; Chunguza aina ya mtoto
        r14d = n32[ast_aina + r13*4]
        linganisha r14d, AST_JINA
        ruka .kupitia_nodi kama !=

        ; Mtoto ni jina — tafuta kigezo cha ndani
        r14d = n32[ast_jina_off + r13*4]
        r14 = &[str_pool + r14]

        r13d ^= r13d
.search_anwani:
        linganisha r13, n64[local_count]
        ruka .search_anwani_ulimwengu kama >=a
        r7 = n64[local_name + r13*8]
        r6 = r14
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .found_anwani kama ==
        r13++
        ruka .search_anwani

.found_anwani:
        ; Pata ofseti ya kigezo
        r7d = n32[local_offset + r13*4]
        r7d = -r7d

        ; Toa: lea rax, [rbp + disp32]
        ; Encoding: 48 8D 85 XX XX XX XX
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x8D   ; lea
        ita gen_baiti
        r0b = 0x85   ; ModRM: [rbp+disp32], reg=rax
        ita gen_baiti
        ita gen_neno4

        vuta r14
        vuta r13
        vuta r12
        rudi

.kupitia_nodi:
        ; Mtoto si jina rahisi — tumia mzalishaji wa anwani wa nodi
        ; (hushughulikia wanachama, vipengele vya safu, na *p)
        sukuma r12
        r12d = r13d
        ita uzalishaji_anwani_ya_nodi
        vuta r12

        vuta r14
        vuta r13
        vuta r12
        rudi

.search_anwani_ulimwengu:
        ; Tafuta kigezo cha ulimwengu
        r13d ^= r13d
.search_anwani_ulimwengu_loop:
        linganisha r13, n64[global_count]
        ruka .not_lvalue kama >=a
        r7 = n64[global_name + r13*8]
        r6 = r14
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .found_anwani_ulimwengu kama ==
        r13++
        ruka .search_anwani_ulimwengu_loop

.found_anwani_ulimwengu:
        ; Toa: lea rax, [rip + disp32]
        ; Encoding: 48 8D 05 XX XX XX XX
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x8D   ; lea
        ita gen_baiti
        r0b = 0x05   ; ModRM: [rip+disp32], reg=rax
        ita gen_baiti

        ; Ongeza rekebisho la R_X86_64_PC32 kwa kigezo cha ulimwengu
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .anwani_rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        r0d = r13d
        r0d += 2
        r0d = -r0d
        n32[rela_sym + r7*4] = r0d
        n32[rela_addend + r7*4] = -4
        n64[rela_count]++
.skip_anwani_reloc:
        ; Weka nafasi ya disp32 (baiti 4 za sifuri)
        r7d = 0
        ita gen_neno4
        vuta r14
        vuta r13
        vuta r12
        rudi
.anwani_rela_jaa:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_rela_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.not_lvalue:
        ; "&jina_la_kazi" — anwani ya kazi (semantiki ya C: &f = f)
        r13d ^= r13d
.ay_fn_skan:
        linganisha r13, n64[func_ret_count]
        ruka .not_lvalue_silent kama >=a
        r7 = n64[func_ret_name + r13*8]
        r6 = r14
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .ay_fn_ipo kama ==
        r13++
        ruka .ay_fn_skan
.ay_fn_ipo:
        ita toa_anwani_kazi   ; lea rax, [rel jina_la_kazi]
.not_lvalue_silent:
        ; Jina lisilojulikana (si kigezo wala kazi) — 0 kimya kama zamani
        r0d ^= r0d
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_nyota_ya: zalisha msimbo kwa nodi ya * (deref)
;   r12d = faharisi ya nodi (AST_NYOTA_ELEKEZA)
;   mtoto wa kushoto = usemi wa pointer
;   huweka thamani iliyofunguliwa kwenye eax
; -------------------------------------------------------
uzalishaji_nyota_ya:
        sukuma r12
        sukuma r13
        sukuma r14

        r12d = r12d
        r13d = n32[ast_kushoto + r12*4]   ; nodi ya mtoto (pointer)

        ; Tathmini usemi wa pointer
        sukuma r12
        r12d = r13d
        ita uzalishaji_ast   ; eax = anwani (pointer)
        vuta r12

        ; Jaribu kujua aina ya kipengele kutoka kwa kigezo
        r14d = n32[ast_aina + r13*4]
        linganisha r14d, AST_JINA
        ruka .deref_fumbua kama !=   ; sio jina — fumbua upana wa kipengele

        ; Tafuta kigezo cha ndani
        r14d = n32[ast_jina_off + r13*4]
        r14 = &[str_pool + r14]
        r13d ^= r13d
.deref_search:
        linganisha r13, n64[local_count]
        ruka .deref_fumbua kama >=a   ; si cha ndani — jaribu ulimwengu/mchanganyiko
        r7 = n64[local_name + r13*8]
        r6 = r14
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .deref_found kama ==
        r13++
        ruka .deref_search

.deref_found:
        r14d = n32[local_star_count + r13*4]
        linganisha r14d, 0
        ruka .deref_n32 kama ==   ; sio pointer
        ; Kielekezi kwa kielekezi (N32** q; *q) — matokeo ni KIELEKEZI:
        ; pakia baiti 8 (9.2 — zamani *q ilipakia baiti 4 na SEGV
        ; kwenye **q)
        linganisha r14d, 1
        ruka .deref_n64 kama >a

        ; Ni pointer — tumia aina msingi kujua ukubwa wa kupakia
        r14d = n32[local_base_type + r13*4]
        linganisha r14d, 1   ; N8
        ruka .deref_n8 kama ==
        linganisha r14d, 2   ; N16
        ruka .deref_n16 kama ==
        linganisha r14d, 4   ; N64
        ruka .deref_n64 kama ==
        linganisha r14d, 5   ; W0 — anwani, pakia baiti 8
        ruka .deref_n64 kama ==
        ; N32 (3) au chaguo-msingi — anguka hadi .deref_n32

.deref_fumbua:
        ; Usemi changamano (au kigezo cha ulimwengu): pakia kwa upana
        ; wa KIPENGELE cha kielekezi. Zamani N32 kwa chaguo-msingi —
        ; jibu baya la kimya kwa kielekezi cha N8/N16/N64 (mfano
        ; *(p + 1) kwenye N8* kilisoma baiti 4, si 1).
        sukuma r12
        r12d = r13d
        ita fumbua_aina   ; eax=aina, ebx=nyota, edx=muundo id
        vuta r12
        pima r3d, r3d
        ruka .deref_n32 kama <=n   ; si kielekezi — N32 kwa chaguo-msingi
        r3d--   ; kipengele = nyota - 1
        linganisha r3d, 0
        ruka .deref_n64 kama >n   ; kipengele chenye nyota — anwani, baiti 8
        linganisha r0d, 1
        ruka .deref_n8 kama ==
        linganisha r0d, 2
        ruka .deref_n16 kama ==
        linganisha r0d, 4
        ruka .deref_n64 kama ==
        linganisha r0d, 5
        ruka .deref_n64 kama ==
        linganisha r0d, 6
        ruka .deref_muundo kama ==   ; muundo — anwani ndiyo thamani
        ; N32 (3) na D64 (7) — N32 kwa chaguo-msingi (D64 ni kikomo)
        ruka .deref_n32
.deref_muundo:
        ; Muundo haujapakiwa — anwani yake tayari iko kwenye rax
        ruka .deref_done

.deref_n32:
        ; mov eax, [rax]  →  8B 00
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .deref_done

.deref_n8:
        ; movsx eax, byte [rax]  →  0F BE 00 — upanuzi wa ISHARA (8.20)
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xBE
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .deref_done

.deref_n16:
        ; movsx eax, word [rax]  →  0F BF 00 — upanuzi wa ISHARA (8.20)
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xBF
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .deref_done

.deref_n64:
        ; mov rax, [rax]  →  48 8B 00
        r0b = 0x48
        ita gen_baiti
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti

.deref_done:
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_kielelezo: zalisha msimbo kwa nodi ya faharisi ya safu
;   mtoto wa kushoto = usemi wa msingi (pointer)
;   mtoto wa kulia  = usemi wa faharisi
;   Hutoa msimbo wa: [msingi + faharisi * ukubwa]
;   Njia kuu iko kwenye gen_kielelezo (r12d = nodi, edi = namna)
; -------------------------------------------------------
uzalishaji_kielelezo:
        sukuma r12
        r7d = 0   ; namna: 0 = thamani
        ita gen_kielelezo
        vuta r12
        rudi

; -------------------------------------------------------
; gen_kielelezo: injini ya uzalishaji wa faharisi ya safu
;   r12d = nodi ya KIELELEZO
;   edi  = namna: 0 = paki thamani, 1 = rudisha anwani
;   Hutoa msimbo unaoweka matokeo kwenye rax
; -------------------------------------------------------
gen_kielelezo:
        sukuma r5
        r5 = r4
        r4 -= 48
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        n64[r5-8] = r7   ; namna
        r13d = n32[ast_kulia + r12*4]   ; usemi wa faharisi
        r14d = n32[ast_kushoto + r12*4]   ; usemi wa msingi
        n64[r5-48] = r14   ; hifadhi nodi ya msingi

        ; Hali maalum: safu ya ulimwengu (global_is_array == 1)
        linganisha r14d, -1
        ruka .njia_kawaida kama ==
        linganisha n32[ast_aina + r14*4], AST_JINA
        ruka .njia_kawaida kama !=
        r8d = n32[ast_jina_off + r14*4]
        r8 = &[str_pool + r8]
        ; Tafuta safu ya ndani kwanza (inachagiza ulimwengu)
        r10d ^= r10d
.saka_ndani:
        linganisha r10, n64[local_count]
        ruka .saka_ulimwengu_anza kama >=a
        r7 = n64[local_name + r10*8]
        r6 = r8
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .imepatikana_ndani kama ==
        r10++
        ruka .saka_ndani
.imepatikana_ndani:
        linganisha n32[local_array_size + r10*4], 0
        ruka .njia_kawaida kama ==   ; kigezo cha kawaida (kinachagiza ulimwengu)
        ; Kipengele: aina msingi ya safu, nyota zake moja kwa moja
        r8d = n32[local_base_type + r10*4]
        n32[r5-24] = r8d   ; aina ya kipengele
        r8d = n32[local_star_count + r10*4]
        n32[r5-32] = r8d   ; nyota za kipengele
        r8d = n32[local_muundo_id + r10*4]
        n32[r5-40] = r8d   ; muundo id ya kipengele
        ; Ukubwa wa kipengele: nyota -> baiti 8
        linganisha n32[r5-32], 0
        ruka .uk_8 kama >n
        r8d = n32[local_base_type + r10*4]
        linganisha r8d, 1
        ruka .uk_1 kama ==
        linganisha r8d, 2
        ruka .uk_2 kama ==
        linganisha r8d, 4
        ruka .uk_8 kama ==
        linganisha r8d, 5
        ruka .uk_8 kama ==
        linganisha r8d, 6
        ruka .uk_muundo_ndani kama ==
        linganisha r8d, 7
        ruka .uk_8 kama ==
        n32[r5-16] = 4
        ruka .tathmini
.uk_muundo_ndani:
        ; Ukubwa wa muundo kutoka jedwali la muundo_ukubwa
        r8d = n32[r5-40]
        linganisha r8d, 0
        ruka .sio kama <n
        linganisha r8d, n32[muundo_count]
        ruka .sio kama >=a
        r8d = n32[muundo_ukubwa + r8*4]
        n32[r5-16] = r8d
        ruka .tathmini
.saka_ulimwengu_anza:
        r9d ^= r9d
.saka_ulimwengu:
        linganisha r9, n64[global_count]
        ruka .njia_kawaida kama >=a
        r7 = n64[global_name + r9*8]
        r6 = r8
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .imepatikana_ulimwengu kama ==
        r9++
        ruka .saka_ulimwengu
.imepatikana_ulimwengu:
        linganisha n32[global_is_array + r9*4], 0
        ruka .njia_kawaida kama ==   ; sio safu — kipengele cha pointer
        ; Kipengele ni aina msingi ya safu, nyota zake moja kwa moja
        r8d = n32[global_base_type + r9*4]
        n32[r5-24] = r8d   ; aina ya kipengele
        r8d = n32[global_star_count + r9*4]
        n32[r5-32] = r8d   ; nyota za kipengele
        n32[r5-40] = -1
        ; Ukubwa wa kipengele
        linganisha r8d, 0
        ruka .uk_8 kama >n   ; kipengele cha nyota — baiti 8
        r8d = n32[global_base_type + r9*4]
        linganisha r8d, 1
        ruka .uk_1 kama ==
        linganisha r8d, 2
        ruka .uk_2 kama ==
        linganisha r8d, 4
        ruka .uk_8 kama ==
        linganisha r8d, 5
        ruka .uk_8 kama ==
        linganisha r8d, 7
        ruka .uk_8 kama ==
        n32[r5-16] = 4
        ruka .tathmini

.njia_kawaida:
        ; Fumbua aina ya usemi wa msingi, kisha punguza nyota moja
        r12d = r14d
        ita fumbua_aina
        linganisha r3d, 0
        ruka .sio kama ==   ; sio pointer
        r3d--   ; nyota za kipengele
        n32[r5-24] = r0d   ; aina ya kipengele
        n32[r5-32] = r3d   ; nyota za kipengele
        n32[r5-40] = r2d   ; muundo id ya kipengele

        ; Ukubwa wa kipengele kutoka kipengele (baada ya punguzo)
        linganisha r3d, 0
        ruka .uk_8 kama >n
        linganisha r0d, 6
        ruka .uk_muundo kama ==
        linganisha r0d, 1
        ruka .uk_1 kama ==
        linganisha r0d, 2
        ruka .uk_2 kama ==
        linganisha r0d, 4
        ruka .uk_8 kama ==
        linganisha r0d, 5
        ruka .uk_8 kama ==
        linganisha r0d, 7
        ruka .uk_8 kama ==
        n32[r5-16] = 4
        ruka .tathmini
.uk_muundo:
        ; Ukubwa wa muundo kutoka jedwali la muundo_ukubwa
        linganisha r2d, 0
        ruka .sio kama <n
        linganisha r2, n64[muundo_count]
        ruka .sio kama >=a
        r8d = n32[muundo_ukubwa + r2*4]
        n32[r5-16] = r8d
        ruka .tathmini
.uk_1:
        n32[r5-16] = 1
        ruka .tathmini
.uk_2:
        n32[r5-16] = 2
        ruka .tathmini
.uk_8:
        n32[r5-16] = 8
        ruka .tathmini

.tathmini:
        ; Tathmini usemi wa faharisi
        r12d = r13d
        ita uzalishaji_ast   ; rax = faharisi
        ; cdqe (48 98) — panua ishara: faharisi hasi (-1) inakwenda kwa
        ; 0xFFFFFFFFFFFFFFFF, si 0x00000000FFFFFFFF (SEGV la anwani)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x98
        ita gen_baiti
        ; push rax — hifadhi faharisi kwenye rafu ya utekelezaji
        r0b = 0x50
        ita gen_baiti
        ; Tathmini usemi wa msingi
        r12d = n32[r5-48]
        ita uzalishaji_ast   ; rax = anwani ya msingi
        ; pop rcx — rudisha faharisi
        r0b = 0x59
        ita gen_baiti

        ; Zidisha faharisi kwa ukubwa wa kipengele
        r15d = n32[r5-16]
        linganisha r15d, 1
        ruka .hakuna_shift kama ==
        linganisha r15d, 2
        ruka .shift_1 kama ==
        linganisha r15d, 4
        ruka .shift_2 kama ==
        linganisha r15d, 8
        ruka .shift_3 kama ==
        ; Ukubwa mwingine — imul rcx, rcx, imm32
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x69   ; imul r/m64, r64, imm32
        ita gen_baiti
        r0b = 0xC9   ; ModRM: r/m=rcx, reg=rcx
        ita gen_baiti
        r7d = r15d
        ita gen_neno4
        ruka .do_add
.shift_1:
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1   ; shl r/m64, imm8
        ita gen_baiti
        r0b = 0xE1   ; ModRM: r/m=rcx, reg=4 (shl)
        ita gen_baiti
        r0b = 1
        ita gen_baiti
        ruka .do_add
.shift_2:
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0b = 0xE1
        ita gen_baiti
        r0b = 2
        ita gen_baiti
        ruka .do_add
.shift_3:
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0b = 0xE1
        ita gen_baiti
        r0b = 3
        ita gen_baiti

.do_add:
.hakuna_shift:
        ; add rax, rcx -> 48 01 C8
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x01   ; add r/m64, r64
        ita gen_baiti
        r0b = 0xC8   ; ModRM: r/m=rax, reg=rcx
        ita gen_baiti

        ; Namna ya anwani: rudisha anwani bila kupakia
        linganisha n64[r5-8], 0
        ruka .mwisho kama !=
        ; Kipengele cha muundo: anwani ndiyo thamani
        linganisha n32[r5-24], 6
        ruka .mwisho kama ==
        ; Paki thamani kutoka [rax] kulingana na kipengele
        linganisha n32[r5-32], 0
        ruka .pakia_64 kama >n
        r8d = n32[r5-24]
        linganisha r8d, 1
        ruka .pakia_8 kama ==
        linganisha r8d, 2
        ruka .pakia_16 kama ==
        linganisha r8d, 4
        ruka .pakia_64 kama ==
        linganisha r8d, 5
        ruka .pakia_64 kama ==
        linganisha r8d, 7
        ruka .pakia_d64 kama ==
        ; N32: mov eax, [rax] -> 8B 00
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .mwisho
.pakia_d64:
        ; D64 — movsd xmm0, [rax] -> f2 0f 10 00
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x10
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .mwisho
.pakia_8:
        ; movsx eax, byte [rax] -> 0F BE 00 — upanuzi wa ISHARA (8.20):
        ; vipengele vya safu ya N8 hupakiwa kwa ishara kama vigeu
        ; (zamani movzx: N8 hasi kwenye safu ilisomwa 255 badala ya
        ; -1). Kumbuka: mnyororo wa .swa unasoma kwa A8 kwa baiti
        ; ghafi zisizo na ishara (ast_pool, chanzo) — mbegu haina
        ; familia ya A, kwa hiyo upakiaji wa vipengele ni wenye
        ; ishara sawa na wa vigeu.
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xBE
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .mwisho
.pakia_16:
        ; movsx eax, word [rax] -> 0F BF 00 — upanuzi wa ISHARA (8.20)
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xBF
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .mwisho
.pakia_64:
        ; mov rax, [rax] -> 48 8B 00
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti

.mwisho:
        r0d ^= r0d   ; mafanikio ya kukusanya
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        r4 = r5
        vuta r5
        rudi
.sio:
        r0d ^= r0d   ; aina batili — hakuna msimbo
        ruka .mwisho

; -------------------------------------------------------
; tafuta_nyuga: tafuta uga wa muundo kwa jina
;   edi = faharisi ya muundo kwenye jedwali la muundo
;   rsi = anwani ya jina la uga (ndani ya str_pool)
;   Matokeo: eax = ofseti, ebx = aina, ecx = nyota, edx = muundo id
;   eax = -1 kama haikupatikana
; -------------------------------------------------------
tafuta_nyuga:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        r12d = r7d   ; muundo id
        r13 = r6   ; anwani ya jina la uga
        linganisha r12, n64[muundo_count]
        ruka .tn_hakuna kama >=a
        r14d = n32[muundo_nyuga_anza + r12*4]
        r15d = n32[muundo_nyuga_mwisho + r12*4]
.tn_mzunguko:
        linganisha r14d, r15d
        ruka .tn_hakuna kama >=a
        sukuma r14
        sukuma r15
        r8d = n32[nyuga_jina_off + r14*4]
        r7 = &[str_pool + r8]
        r6 = r13
        ita linganisha_mfuatano
        vuta r15
        vuta r14
        linganisha r0d, 0
        ruka .tn_iko kama ==
        r14d++
        ruka .tn_mzunguko
.tn_iko:
        r0d = n32[nyuga_ofseti + r14*4]
        r3d = n32[nyuga_aina + r14*4]
        r1d = n32[nyuga_nyota + r14*4]
        r2d = n32[nyuga_muundo_id + r14*4]
        ruka .tn_mwisho
.tn_hakuna:
        r0d = -1
        r3d ^= r3d
        r1d ^= r1d
        r2d = -1
.tn_mwisho:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; fumbua_aina: amua aina ya usemi kwa wakati wa ukusanyaji
;   r12d = faharisi ya nodi (hifadhiwa)
;   Matokeo: eax = aina msingi, ebx = idadi ya nyota,
;            edx = muundo id (au -1)
;   Batili: eax=0, ebx=0, edx=-1
; -------------------------------------------------------
fumbua_aina:
        sukuma r13
        sukuma r14
        sukuma r15
.fa_anza_tena:
        linganisha r12d, -1
        ruka .fa_sio kama ==
        r13d = n32[ast_aina + r12*4]

        linganisha r13d, AST_JINA
        ruka .fa_jina kama ==
        linganisha r13d, AST_TANGAZO
        ruka .fa_tangazo kama ==
        linganisha r13d, AST_ELEKEZA_JINA
        ruka .fa_mwanachama kama ==
        linganisha r13d, AST_ENEKEZA_FUNGO
        ruka .fa_mwanachama kama ==
        linganisha r13d, AST_KIELELEZO
        ruka .fa_kielelezo kama ==
        linganisha r13d, AST_NYOTA_KIELELEZO
        ruka .fa_kielelezo kama ==
        linganisha r13d, AST_NYOTA_ELEKEZA
        ruka .fa_nyota kama ==
        linganisha r13d, AST_ALAMA_ELEKEZA
        ruka .fa_alama kama ==
        linganisha r13d, AST_NAMBA
        ruka .fa_namba kama ==
        linganisha r13d, AST_HALISI_D
        ruka .fa_halisi_d kama ==
        linganisha r13d, AST_KAULI
        ruka .fa_kauli kama ==
        linganisha r13d, AST_WAMBILE
        ruka .fa_wambile kama ==
        ; Unari: -x, !x, ~x — aina ya matokeo ni aina ya operanda
        ; (8.4/8.6: -10000000000 ni N64; -2.5 ni D64; operesheni
        ; mchanganyiko na hasili lazima ijue upana).
        linganisha r13d, AST_HASILI
        ruka .fa_unari kama ==
        linganisha r13d, AST_MAKOSA
        ruka .fa_unari kama ==
        linganisha r13d, AST_MAKOSA_BITI
        ruka .fa_unari kama ==
        ruka .fa_sio

.fa_halisi_d:
        r0d = 7   ; D64
        r3d ^= r3d
        r2d = -1
        ruka .fa_mwisho

.fa_unari:
        r12d = n32[ast_kushoto + r12*4]
        ruka .fa_anza_tena

.fa_jina:
        ; Tafuta kati ya vigezo vya ndani
        r13d = n32[ast_jina_off + r12*4]
        r13 = &[str_pool + r13]
        r14d ^= r14d
.fa_jina_ndani:
        linganisha r14, n64[local_count]
        ruka .fa_jina_ulimwengu kama >=a
        r7 = n64[local_name + r14*8]
        r6 = r13
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .fa_jina_ndani_iko kama ==
        r14++
        ruka .fa_jina_ndani
.fa_jina_ndani_iko:
        r0d = n32[local_base_type + r14*4]
        r3d = n32[local_star_count + r14*4]
        r2d = n32[local_muundo_id + r14*4]
        ruka .fa_mwisho
.fa_jina_ulimwengu:
        r14d ^= r14d
.fa_jina_ulimwengu_mzunguko:
        linganisha r14, n64[global_count]
        ruka .fa_sio kama >=a
        r7 = n64[global_name + r14*8]
        r6 = r13
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .fa_jina_ulimwengu_iko kama ==
        r14++
        ruka .fa_jina_ulimwengu_mzunguko
.fa_jina_ulimwengu_iko:
        r0d = n32[global_base_type + r14*4]
        r3d = n32[global_star_count + r14*4]
        r2d = -1   ; ulimwengu hana muundo id
        ruka .fa_mwisho

.fa_tangazo:
        r0d = n32[ast_thamani + r12*4]
        r3d = n32[ast_kulia + r12*4]
        r2d = -1
        linganisha r0d, 6
        ruka .fa_mwisho kama !=
        ; Muundo: tafuta id kutoka jina la muundo (ast_tiga)
        r15d = n32[ast_tiga + r12*4]
        linganisha r15d, -1
        ruka .fa_mwisho kama ==
        sukuma r0
        sukuma r3
        r7d = r15d
        ita tafuta_muundo
        r2d = r0d
        vuta r3
        vuta r0
        ruka .fa_mwisho

.fa_mwanachama:
        ; Mwanachama wa muundo: .jina au ->jina
        r15d = n32[ast_kushoto + r12*4]
        linganisha r15d, -1
        ruka .fa_sio kama ==
        ; Fumbua aina ya msingi
        sukuma r12
        r12d = r15d
        ita fumbua_aina
        vuta r12
        linganisha r2d, -1
        ruka .fa_sio kama ==
        ; Tafuta uga kwa jina ndani ya muundo wa msingi
        r15d = n32[ast_kulia + r12*4]
        linganisha r15d, -1
        ruka .fa_sio kama ==
        r14d = n32[ast_jina_off + r15*4]
        r6 = &[str_pool + r14]
        r7d = r2d
        ; Matokeo ya tafuta_nyuga (eax/ebx/ecx/edx) ni yale
        ; tunayohitaji — usiyarudishe kwa thamani za zamani
        ita tafuta_nyuga
        linganisha r0d, -1
        ruka .fa_sio kama ==
        ; eax = ofseti, ebx = aina, ecx = nyota, edx = muundo id
        r0d = r3d
        r3d = r1d
        ruka .fa_mwisho

.fa_kielelezo:
        ; Kipengele cha safu: fumbua msingi, punguza nyota moja.
        ; Msingi wa SAFU (sio pointer) hana nyota — kipengele ni aina
        ; msingi yenyewe (kwa safu ya miundo: aina 6, nyota 0).
        r15d = n32[ast_kushoto + r12*4]
        linganisha r15d, -1
        ruka .fa_sio kama ==
        linganisha n32[ast_aina + r15*4], AST_JINA
        ruka .fk_punguza kama !=
        r14d = n32[ast_jina_off + r15*4]
        r14 = &[str_pool + r14]
        r10d ^= r10d
.fk_saka_ndani:
        linganisha r10, n64[local_count]
        ruka .fk_punguza kama >=a
        r7 = n64[local_name + r10*8]
        r6 = r14
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .fk_ndani_iko kama ==
        r10++
        ruka .fk_saka_ndani
.fk_ndani_iko:
        linganisha n32[local_array_size + r10*4], 0
        ruka .fk_punguza kama ==
        ; Safu ya ndani: kipengele = aina msingi, nyota zake (0 kwa muundo)
        r0d = n32[local_base_type + r10*4]
        r3d = n32[local_star_count + r10*4]
        r2d = n32[local_muundo_id + r10*4]
        ruka .fa_mwisho
.fk_punguza:
        ; Safu ya ULIMWENGU (sawa na ya ndani): kipengele ni aina
        ; msingi na NYOTA zake — si punguzo (safu ya kielekezi kama
        ; muundo_ukubwa_jina[mi] ina kipengele cha kielekezi).
        linganisha n32[ast_aina + r15*4], AST_JINA
        ruka .fk_punguza_halisi kama !=
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        r13d = n32[ast_jina_off + r15*4]
        r13 = &[str_pool + r13]
        r10d ^= r10d
.fk_saka_ulimwengu:
        linganisha r10, n64[global_count]
        ruka .fk_sio_safu_ulimwengu kama >=a
        r7 = n64[global_name + r10*8]
        r6 = r13
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .fk_ulimwengu_iko kama ==
        r10++
        ruka .fk_saka_ulimwengu
.fk_ulimwengu_iko:
        linganisha n32[global_is_array + r10*4], 0
        ruka .fk_sio_safu_ulimwengu kama ==
        r0d = n32[global_base_type + r10*4]
        r3d = n32[global_star_count + r10*4]
        r2d = -1
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        ruka .fa_mwisho
.fk_sio_safu_ulimwengu:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
.fk_punguza_halisi:
        sukuma r12
        r12d = r15d
        ita fumbua_aina
        vuta r12
        linganisha r3d, 0
        ruka .fa_sio kama ==
        r3d--
        ruka .fa_mwisho

.fa_nyota:
        ; Toleo la dereference: *p — punguza nyota moja
        r15d = n32[ast_kushoto + r12*4]
        linganisha r15d, -1
        ruka .fa_sio kama ==
        sukuma r12
        r12d = r15d
        ita fumbua_aina
        vuta r12
        linganisha r3d, 0
        ruka .fa_sio kama ==
        r3d--
        ruka .fa_mwisho

.fa_alama:
        ; Anwani-ya: &x — ongeza nyota moja
        r15d = n32[ast_kushoto + r12*4]
        linganisha r15d, -1
        ruka .fa_sio kama ==
        sukuma r12
        r12d = r15d
        ita fumbua_aina
        vuta r12
        r3d++
        ruka .fa_mwisho

.fa_namba:
        ; Halisi ya N64 (alama ast_kulia == 1) ina aina N64 — inafanya
        ; oparesheni zake ziwe za baiti 8 (sawa na mnyororo wa .swa,
        ; ambapo enc ya halisi ya N64 ni N64).
        linganisha n32[ast_kulia + r12*4], 1
        ruka .fa_namba_32 kama !=
        r0d = 4   ; N64
        ruka .fa_namba_mwisho
.fa_namba_32:
        r0d = 3   ; N32
.fa_namba_mwisho:
        r3d ^= r3d
        r2d = -1
        ruka .fa_mwisho

.fa_kauli:
        ; Ulinganisho (== != < > <= >=) unarudisha 0/1 kwenye eax —
        ; aina yake ni N32 hata kama operanda ni D64 (8.6/8.21:
        ; "d > 1.99 && d < 2.01" ni halali — && ya matokeo ya
        ; ulinganisho wa D64 haikataliwi). TAHADHARI: mfuatano wa
        ; herufi ni KAULI yenye kushoto=-1 na thamani=urefu wake —
        ; usiuchukulie kama ulinganisho (urefu unaweza kuwa sawa na
        ; msimbo wa ishara).
        r15d = n32[ast_kushoto + r12*4]
        linganisha r15d, -1
        ruka .fa_sio kama ==
        r15d = n32[ast_thamani + r12*4]
        linganisha r15d, OP_SAWA_SAWA
        ruka .fa_kauli_linganisho kama ==
        linganisha r15d, OP_SIO_SAWA
        ruka .fa_kauli_linganisho kama ==
        linganisha r15d, OP_KIDOGO
        ruka .fa_kauli_linganisho kama ==
        linganisha r15d, OP_KUBWA
        ruka .fa_kauli_linganisho kama ==
        linganisha r15d, OP_KIDOGO_SAWA
        ruka .fa_kauli_linganisho kama ==
        linganisha r15d, OP_KUBWA_SAWA
        ruka .fa_kauli_linganisho kama ==
        ; ?: — aina ya matokeo ni ya tawi la kweli (pandisha C:
        ; tawi la uwongo la D64 linafanya matokeo yawe D64).
        linganisha r15d, OP_HUU
        ruka .fa_kauli_binary kama !=
        ruka .fa_kauli_huu
.fa_kauli_linganisho:
        r0d = 3   ; N32 (matokeo ya 0/1 kwenye eax)
        r3d ^= r3d
        r2d = -1
        ruka .fa_mwisho
.fa_kauli_huu:
        r15d = n32[ast_kulia + r12*4]   ; mfuatano (kweli, uwongo)
        linganisha r15d, -1
        ruka .fa_kauli_binary kama ==
        sukuma r12
        r12d = n32[ast_kushoto + r15*4]
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .fa_kauli_d64 kama ==
        sukuma r12
        r12d = n32[ast_kulia + r15*4]
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .fa_kauli_d64 kama ==
        ruka .fa_kauli_binary
.fa_kauli_d64:
        r0d = 7   ; D64
        r3d ^= r3d
        r2d = -1
        ruka .fa_mwisho
.fa_kauli_binary:
        ; Kauli ya binary: PANDISHA C — D64/N64/kielekezi kwenye
        ; upande wowote inafanya operesheni nzima iwe ya upana huo.
        ; (8.4: 0 - 10000000000 ni N64 hata kama kushoto ni N32;
        ; 8.6: 1 + 2.5 ni D64; minyororo kama (pi * r) * r kubaki
        ; D64.) Hesabu ya anwani (8.15): safu + ofseti ni KIELEKEZI —
        ; jina la safu linaharibika hadi kielekezi (lea), kama
        ; mnyororo wa .swa ("safu ya ndani: usemi wa jina unaharibika
        ; hadi kielekezi (mshale +1)"). Rudi kwenye kichwa cha
        ; fumbua_aina BAADA ya pushes — .fa_anza_tena iko mara moja
        ; baada ya kuzihifadhi.
        r15d = n32[ast_kushoto + r12*4]
        linganisha r15d, -1
        ruka .fa_sio kama ==
        sukuma r12
        r12d = r15d
        ita fumbua_aina
        vuta r12
        r13d = r0d   ; aina ya kushoto
        r14d = r3d   ; nyota za kushoto
        linganisha r0d, 7
        ruka .fa_mwisho kama ==   ; D64
        linganisha r0d, 4
        ruka .fa_mwisho kama ==   ; N64
        pima r3d, r3d
        ruka .fa_mwisho kama >n   ; kielekezi
        ; Kushoto ni jina la safu — anwani (kielekezi)
        r7d = r15d
        ita ni_jina_la_safu   ; huhifadhi r12-r15
        pima r0d, r0d
        ruka .fa_kauli_left_sio_safu kama ==
        r0d = r13d
        r3d = 1   ; nyota = 1 (kielekezi)
        ruka .fa_mwisho
.fa_kauli_left_sio_safu:
        r15d = n32[ast_kulia + r12*4]
        linganisha r15d, -1
        ruka .fa_sio kama ==
        sukuma r12
        r12d = r15d
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .fa_kauli_d64 kama ==
        linganisha r0d, 4
        ruka .fa_mwisho kama ==
        pima r3d, r3d
        ruka .fa_mwisho kama >n
        ; Kulia ni jina la safu — anwani (kielekezi)
        r7d = r15d
        ita ni_jina_la_safu
        pima r0d, r0d
        ruka .fa_kauli_right_sio_safu kama ==
        r0d = r13d   ; aina ya kushoto (msingi wa anwani)
        r3d = 1
        ruka .fa_mwisho
.fa_kauli_right_sio_safu:
        ; Vyote viwili ni vidogo — aina ya kushoto ndiyo inashinda
        r0d = r13d
        r3d = r14d
        ruka .fa_mwisho

.fa_wambile:
        ; Wito wa kazi: aina yake ni aina ya KURUDI ya kazi, si aina
        ; ya hoja. Nodi ya wito ina kushoto=orodha ya hoja, kulia=jina
        ; la kazi. Tafuta aina ya kurudi kwenye jedwali la func_ret_*.
        ; Wito kupitia kielekezi (mwitaji ni kigezo chenye N64/kielekezi)
        ; hauna saini: matokeo yake ni N64 kwa wigo (4.3) — isiyojulikana
        ; hapa (0) inatosha: D64 hairuhusiwi na hukataliwa kwa sauti.
        r15d = n32[ast_kulia + r12*4]   ; nodi ya jina la kazi
        linganisha r15d, -1
        ruka .fa_sio kama ==
        r15d = n32[ast_jina_off + r15*4]   ; ofseti ya jina
        r15 = &[str_pool + r15]   ; anwani ya jina
        r14d ^= r14d
.fa_wambile_scan:
        linganisha r14, n64[func_ret_count]
        ruka .fa_sio kama >=a
        r7 = n64[func_ret_name + r14*8]
        r6 = r15
        sukuma r14
        ita linganisha_mfuatano
        vuta r14
        linganisha r0d, 0
        ruka .fa_wambile_iko kama ==
        r14++
        ruka .fa_wambile_scan
.fa_wambile_iko:
        r0d = n32[func_ret_base + r14*4]
        r3d = n32[func_ret_star + r14*4]
        r2d = -1
        ruka .fa_mwisho

.fa_sio:
        r0d ^= r0d
        r3d ^= r3d
        r2d = -1
.fa_mwisho:
        vuta r15
        vuta r14
        vuta r13
        rudi

; -------------------------------------------------------
; ni_jina_la_safu: je, nodi hii ni jina la SAFU?
;   edi = faharisi ya nodi
;   eax = 1 ikiwa jina la safu (ndani au ulimwengu), 0 vinginevyo
;   Safu hutoa ANWANI (lea) si thamani — upanuzi wa ishara haufai.
;   Huhifadhi r12-r15; r8-r11, rdi, rsi zinaweza kuharibiwa.
; -------------------------------------------------------
ni_jina_la_safu:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        r0d ^= r0d
        linganisha r7d, -1
        ruka .njs_mwisho kama ==
        r12d = n32[ast_aina + r7*4]
        linganisha r12d, AST_JINA
        ruka .njs_mwisho kama !=
        r13d = n32[ast_jina_off + r7*4]
        r13 = &[str_pool + r13]
        ; Saka kati ya vigezo vya ndani
        r14d ^= r14d
.njs_ndani:
        linganisha r14, n64[local_count]
        ruka .njs_ulimwengu kama >=a
        r7 = n64[local_name + r14*8]
        r6 = r13
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .njs_ndani_iko kama ==
        r14++
        ruka .njs_ndani
.njs_ndani_iko:
        linganisha n32[local_array_size + r14*4], 0
        ruka .njs_ndiyo kama >n
        ruka .njs_mwisho
        ; Saka kati ya vigezo vya ulimwengu
.njs_ulimwengu:
        r14d ^= r14d
.njs_ulimwengu_mzunguko:
        linganisha r14, n64[global_count]
        ruka .njs_mwisho kama >=a
        r7 = n64[global_name + r14*8]
        r6 = r13
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .njs_ulimwengu_iko kama ==
        r14++
        ruka .njs_ulimwengu_mzunguko
.njs_ulimwengu_iko:
        linganisha n32[global_is_array + r14*4], 0
        ruka .njs_ndiyo kama !=
        ruka .njs_mwisho
.njs_ndiyo:
        r0d = 1
.njs_mwisho:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; panua_ishara_ya_kauli: toa cdqe (48 98) ikiwa matokeo ya operesheni
; ya binary yanahitaji upanuzi wa ishara kabla ya kuhifadhiwa kwenye
; lengwa la baiti 8. "N64 y = 0 - 90;" — operesheni ya N32 (sub eax,
; ecx) huacha biti 32 za juu kuwa sifuri; cdqe huzipanua kwa ishara.
; Sawia na panua_ishara_ndogo ya mnyororo wa .swa. Hutoa cdqe ikiwa
; nodi ni KAULI (si ?:), aina yake ni N8/N16/N32 bila nyota, na
; operanda zake si majina ya safu. Anwani hazipanuliwi: kielekezi
; (nyota > 0) na jina la safu (lea) si thamani ya hesabu; ?: (OP_HUU)
; haijumuishwi kwa sababu fumbua_aina huukadiria kwa aina ya sharti,
; si ya matokeo; N64 (4), W0 (5), muundo (6) na D64 (7) hazihitaji
; — D64 inabeba thamani kwenye xmm0, si rax.
;   edi = faharisi ya nodi
;   Huhifadhi r12-r15; r8-r11, rdi, rsi zinaweza kuharibiwa.
; -------------------------------------------------------
panua_ishara_ya_kauli:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        linganisha r7d, -1
        ruka .pik_mwisho kama ==
        r13d = r7d   ; r13d = faharisi ya nodi
        r14d = n32[ast_aina + r13*4]
        linganisha r14d, AST_KAULI
        ruka .pik_mwisho kama !=
        r14d = n32[ast_thamani + r13*4]
        linganisha r14d, OP_HUU
        ruka .pik_mwisho kama ==
        ; Uhamishaji wa kianzilishi cha N64 (8.5) ni wa baiti 8 —
        ; matokeo tayari ni ya baiti 8; cdqe ungefuta biti 32 za juu
        ; (mfano: "N64 x = 1 << 32" -> 4294967296 kwenye rax).
        linganisha r14d, OP_HAMISHA_KUSHOTO
        ruka .pik_shift_lengo64 kama ==
        linganisha r14d, OP_HAMISHA_KULIA
        ruka .pik_sio_shift64 kama !=
.pik_shift_lengo64:
        linganisha n32[kianzio_lengo64], 0
        ruka .pik_mwisho kama !=
.pik_sio_shift64:
        ; Operanda za anwani: jina la safu (kushoto au kulia) — matokeo
        ; ni anwani (iliyopunguzwa), si thamani ya hesabu; usipanue.
        r15d = n32[ast_kushoto + r13*4]
        r12d = n32[ast_kulia + r13*4]
        r7d = r15d
        ita ni_jina_la_safu
        pima r0d, r0d
        ruka .pik_mwisho kama !=
        r7d = r12d
        ita ni_jina_la_safu
        pima r0d, r0d
        ruka .pik_mwisho kama !=
        ; Aina ya matokeo: N8/N16/N32 yenye ishara, bila nyota
        r12d = r13d
        ita fumbua_aina
        pima r0d, r0d
        ruka .pik_mwisho kama ==
        linganisha r0d, 3
        ruka .pik_mwisho kama >a
        pima r3d, r3d
        ruka .pik_mwisho kama !=
        ; cdqe → 48 98: panua ishara ya eax hadi rax
        r0b = 0x48
        ita gen_baiti
        r0b = 0x98
        ita gen_baiti
.pik_mwisho:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; ni_wito_kielekezi: je, nodi ni wito kupitia kigezo cha N64/kielekezi?
;   edi = faharisi ya nodi
;   eax = 1 ndiyo, 0 la
;   Inaharibu rax, rcx, rdx, rdi, rsi na r8-r11; huhifadhi r12-r15.
; -------------------------------------------------------
ni_wito_kielekezi:
        sukuma r12
        sukuma r13
        sukuma r14
        r0d ^= r0d
        linganisha r7d, -1
        ruka .nwk_la kama ==
        r12d = r7d   ; nodi
        linganisha n32[ast_aina + r12*4], AST_WAMBILE
        ruka .nwk_la kama !=
        r13d = n32[ast_kulia + r12*4]   ; nodi ya mwitaji
        linganisha r13d, -1
        ruka .nwk_la kama ==
        linganisha n32[ast_aina + r13*4], AST_JINA
        ruka .nwk_la kama !=
        r13d = n32[ast_jina_off + r13*4]
        r13 = &[str_pool + r13]   ; anwani ya jina la mwitaji
        r14d ^= r14d
.nwk_skan_ndani:
        linganisha r14, n64[local_count]
        ruka .nwk_skan_ulimwengu kama >=a
        r7 = n64[local_name + r14*8]
        r6 = r13
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .nwk_ndani_ipo kama ==
        r14++
        ruka .nwk_skan_ndani
.nwk_ndani_ipo:
        ; Kigezo cha ndani cha N64 au kielekezi (si safu)
        linganisha n32[local_array_size + r14*4], 0
        ruka .nwk_la kama !=
        r0d = n32[local_star_count + r14*4]
        linganisha r0d, 0
        ruka .nwk_ndiyo kama >n
        linganisha n32[local_base_type + r14*4], 4
        ruka .nwk_ndiyo kama ==
        ruka .nwk_la
.nwk_skan_ulimwengu:
        r14d ^= r14d
.nwk_skan_ulimwengu_loop:
        linganisha r14, n64[global_count]
        ruka .nwk_la kama >=a
        r7 = n64[global_name + r14*8]
        r6 = r13
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .nwk_ulimwengu_ipo kama ==
        r14++
        ruka .nwk_skan_ulimwengu_loop
.nwk_ulimwengu_ipo:
        linganisha n32[global_is_array + r14*4], 0
        ruka .nwk_la kama !=
        r0d = n32[global_star_count + r14*4]
        linganisha r0d, 0
        ruka .nwk_ndiyo kama >n
        linganisha n32[global_base_type + r14*4], 4
        ruka .nwk_la kama !=
.nwk_ndiyo:
        r0d = 1
        vuta r14
        vuta r13
        vuta r12
        rudi
.nwk_la:
        r0d ^= r0d
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; badilisha_mpaka_wa_desimali: badilisha thamani (kwenye eax/rax au
; xmm0) hadi aina ya lengwa kwenye mpaka wa kamili/desimali —
; C-semantiki ya pandisha (8.6): nambari kamili inabadilishwa hadi
; D64 (cvtsi2sd); D64 inakatwa hadi sifuri ikiwa lengwa ni kamili
; (cvttsd2si). Kielekezi au muundo kwenye desimali ni kosa la sauti.
; Wito kupitia kielekezi haurudishi D64 (4.3) — kosa la sauti katika
; mazingira ya kianzio, ugawaji na rudisha (mazingira ya hoja ya D64
; hukaguliwa kwenye uzalishaji_wambile).
;   edi = nodi ya usemi
;   esi = aina ya lengwa (1-4 kamili, 7 D64)
;   edx = ukubwa wa lengwa kwa baiti (4 au 8)
; Matokeo: thamani inabaki eax/rax (kamili) au xmm0 (D64).
; Huhifadhi r12-r15; r8-r11, rdi, rsi zinaweza kuharibiwa.
; -------------------------------------------------------
badilisha_mpaka_wa_desimali:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        r13d = r7d   ; nodi
        r14d = r6d   ; aina ya lengwa
        r15d = r2d   ; ukubwa wa lengwa
        ; Lengwa la D64 lenye wito wa kielekezi — kosa la sauti (4.3)
        linganisha r14d, 7
        ruka .bmd_lengo_sio_d64 kama !=
        r7d = r13d
        ita ni_wito_kielekezi
        linganisha r0d, 0
        ruka .bmd_lengo_sio_d64 kama ==
        r7 = &[msg_kielekezi_d64]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.bmd_lengo_sio_d64:
        linganisha r13d, -1
        ruka .bmd_mwisho kama ==
        r12d = r13d
        ita fumbua_aina   ; eax = aina, ebx = nyota
        linganisha r0d, 0
        ruka .bmd_mwisho kama ==   ; isiyojulikana — hakuna ubadilishaji
        ; Lengwa ni D64: badilisha kamili hadi xmm0
        linganisha r14d, 7
        ruka .bmd_lengwa_kamili kama !=
        linganisha r0d, 7
        ruka .bmd_mwisho kama ==   ; tayari D64
        linganisha r0d, 4
        ruka .bmd_cvtsi2sd_rax kama ==
        linganisha r0d, 5
        ruka .bmd_cvtsi2sd_rax kama ==   ; W0 — baiti 8
        linganisha r0d, 1
        ruka .bmd_cvtsi2sd_eax kama ==
        linganisha r0d, 2
        ruka .bmd_cvtsi2sd_eax kama ==
        linganisha r0d, 3
        ruka .bmd_cvtsi2sd_eax kama ==
        ; kielekezi au muundo kwenye desimali — kosa la sauti
        ruka .bmd_kielekezi_kosa
.bmd_lengwa_kamili:
        ; Lengwa ni kamili: badilisha D64 hadi eax/rax
        linganisha r0d, 7
        ruka .bmd_mwisho kama !=   ; sio D64 — hakuna ubadilishaji
        linganisha r15d, 8
        ruka .bmd_cvttsd2si_rax kama ==
        ; cvttsd2si eax, xmm0 → F2 0F 2C C0 (kukata hadi sifuri)
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2C
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .bmd_mwisho
.bmd_cvttsd2si_rax:
        ; cvttsd2si rax, xmm0 → F2 48 0F 2C C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2C
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .bmd_mwisho
.bmd_cvtsi2sd_eax:
        ; cvtsi2sd xmm0, eax → F2 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .bmd_mwisho
.bmd_cvtsi2sd_rax:
        ; cvtsi2sd xmm0, rax → F2 48 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .bmd_mwisho
.bmd_kielekezi_kosa:
        r7 = &[msg_desi_kielekezi]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.bmd_mwisho:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_anwani_ya_nodi: zalisha msimbo wa anwani ya nodi
;   r12d = faharisi ya nodi
;   Hutoa msimbo unaoweka anwani kwenye rax
; -------------------------------------------------------
uzalishaji_anwani_ya_nodi:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        linganisha r12d, -1
        ruka .uan_sio kama ==
        r13d = n32[ast_aina + r12*4]

        linganisha r13d, AST_JINA
        ruka .uan_jina kama ==
        linganisha r13d, AST_ELEKEZA_JINA
        ruka .uan_mwanachama kama ==
        linganisha r13d, AST_ENEKEZA_FUNGO
        ruka .uan_mwanachama kama ==
        linganisha r13d, AST_KIELELEZO
        ruka .uan_kielelezo kama ==
        ruka .uan_tathmini

.uan_jina:
        ; Tafuta kati ya vigezo vya ndani
        r13d = n32[ast_jina_off + r12*4]
        r13 = &[str_pool + r13]
        r14d ^= r14d
.uan_jina_ndani:
        linganisha r14, n64[local_count]
        ruka .uan_jina_ulimwengu kama >=a
        r7 = n64[local_name + r14*8]
        r6 = r13
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .uan_jina_ndani_iko kama ==
        r14++
        ruka .uan_jina_ndani
.uan_jina_ndani_iko:
        ; lea rax, [rbp + ofseti] — ofseti hasi (vigezo chini ya rbp)
        r7d = n32[local_offset + r14*4]
        r7d = -r7d
        ; Paramu ya muundo mkubwa (kwa rejea): sloti ina KIELEKEZI —
        ; pakia kielekezi, si anwani ya sloti
        linganisha n32[local_kwa_rejea + r14*4], 0
        ruka .uan_jina_rejea kama !=
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x8D   ; lea r64, [rbp + disp32]
        ita gen_baiti
        r0b = 0x85   ; ModRM: r/m=rbp, reg=rax
        ita gen_baiti
        ita gen_neno4
        ruka .uan_mwisho
.uan_jina_rejea:
        ; mov rax, [rbp + disp32] — 48 8B 85 d32
        r0b = 0x48
        ita gen_baiti
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        ita gen_neno4
        ruka .uan_mwisho
.uan_jina_ulimwengu:
        r14d ^= r14d
.uan_jina_ulimwengu_mzunguko:
        linganisha r14, n64[global_count]
        ruka .uan_sio kama >=a
        r7 = n64[global_name + r14*8]
        r6 = r13
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .uan_jina_ulimwengu_iko kama ==
        r14++
        ruka .uan_jina_ulimwengu_mzunguko
.uan_jina_ulimwengu_iko:
        ; lea rax, [rip + kitu] — kujazwa na reloketi
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x8D   ; lea r64, [rip + disp32]
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ; Rekodi reloketi R_X86_64_PC32
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .uan_rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        r0d = r14d
        r0d += 2
        r0d = -r0d
        n32[rela_sym + r7*4] = r0d
        n32[rela_addend + r7*4] = -4
        n64[rela_count]++
.uan_jina_ulimwengu_skip:
        r7d = 0
        ita gen_neno4
        ruka .uan_mwisho
.uan_rela_jaa:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_rela_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.uan_mwanachama:
        ; Mwanachama wa muundo: anwani ya msingi + ofseti ya uga
        r15d = n32[ast_kushoto + r12*4]
        linganisha r15d, -1
        ruka .uan_sio kama ==
        ; Fumbua aina ya msingi
        sukuma r12
        r12d = r15d
        ita fumbua_aina
        vuta r12
        linganisha r2d, -1
        ruka .uan_sio kama ==
        r13d = r0d   ; aina ya msingi
        r14d = r3d   ; nyota za msingi
        ; Tafuta uga
        r8d = n32[ast_kulia + r12*4]
        linganisha r8d, -1
        ruka .uan_sio kama ==
        r9d = n32[ast_jina_off + r8*4]
        r6 = &[str_pool + r9]
        r7d = r2d
        ita tafuta_nyuga
        linganisha r0d, -1
        ruka .uan_sio kama ==
        r15d = r0d   ; ofseti ya uga
        ; Msingi wa muundo-thamani: anwani ya msingi; sivyo: thamani ya msingi
        linganisha r13d, 6
        ruka .uan_m_tathmini kama !=
        linganisha r14d, 0
        ruka .uan_m_tathmini kama !=
        sukuma r15
        r8d = n32[ast_kushoto + r12*4]
        r12d = r8d
        ita uzalishaji_anwani_ya_nodi
        vuta r15
        ruka .uan_m_ofseti
.uan_m_tathmini:
        sukuma r15
        r8d = n32[ast_kushoto + r12*4]
        r12d = r8d
        ita uzalishaji_ast
        vuta r15
.uan_m_ofseti:
        ; add rax, ofseti ya uga
        linganisha r15d, 0
        ruka .uan_mwisho kama ==
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x05   ; add rax, imm32
        ita gen_baiti
        r7d = r15d
        ita gen_neno4
        ruka .uan_mwisho

.uan_kielelezo:
        r7d = 1   ; namna ya anwani
        ita gen_kielelezo
        ruka .uan_mwisho

.uan_tathmini:
        ; Zingatia usemi: thamani yake ndiyo anwani (mf. *p)
        ita uzalishaji_ast
.uan_mwisho:
        r0d ^= r0d
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi
.uan_sio:
        r0d ^= r0d   ; hali batili — hakuna msimbo
        ruka .uan_mwisho

; -------------------------------------------------------
; uzalishaji_mwanachama: zalisha msimbo wa mwanachama wa muundo
;   r12d = nodi ya mwanachama (ELEKEZA_JINA / ENEKEZA_FUNGO)
;   Hutoa msimbo unaoweka thamani kwenye rax
;   Kwa muundo: anwani ya mwanachama ndiyo thamani
; -------------------------------------------------------
uzalishaji_mwanachama:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        ; Fumbua aina ya mwanachama kwanza
        ita fumbua_aina
        sukuma r0   ; aina
        sukuma r3   ; nyota

        ; Kisha anwani yake
        ita uzalishaji_anwani_ya_nodi

        vuta r14   ; nyota
        vuta r13   ; aina

        ; Nyota: paki baiti 8 — hata kwa pointer kwenda muundo,
        ; thamani yake ni pointer iliyo kwenye kumbukumbu
        linganisha r14d, 0
        ruka .um_pakia_64 kama >n
        ; Muundo-thamani: anwani ndiyo thamani
        linganisha r13d, 6
        ruka .um_mwisho kama ==
        linganisha r13d, 1
        ruka .um_pakia_8 kama ==
        linganisha r13d, 2
        ruka .um_pakia_16 kama ==
        linganisha r13d, 4
        ruka .um_pakia_64 kama ==
        linganisha r13d, 5
        ruka .um_pakia_64 kama ==
        linganisha r13d, 7
        ruka .um_pakia_d64 kama ==
        ; N32: mov eax, [rax] -> 8B 00
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .um_mwisho
.um_pakia_d64:
        ; D64 — movsd xmm0, [rax] -> f2 0f 10 00
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x10
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .um_mwisho
.um_pakia_8:
        ; movsx eax, byte [rax] -> 0F BE 00 — upanuzi wa ISHARA (8.20)
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xBE
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .um_mwisho
.um_pakia_16:
        ; movsx eax, word [rax] -> 0F BF 00 — upanuzi wa ISHARA (8.20)
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xBF
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .um_mwisho
.um_pakia_64:
        ; mov rax, [rax] -> 48 8B 00
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
.um_mwisho:
        r0d ^= r0d
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi


; -------------------------------------------------------
; uzalishaji_rudisha: zalisha msimbo kwa nodi ya rudisha
; -------------------------------------------------------
uzalishaji_rudisha:
        sukuma r12
        sukuma r13

        ; Kazi inayorudisha D64: thamani ya kurudi inabaki kwenye xmm0
        ; (hesabu ya D64 huweka matokeo hapo) na epilogue ni leave;ret,
        ; hivyo hakuna hatua ya ziada inayohitajika.

        r12d = r12d
        r13d = n32[ast_kushoto + r12*4]   ; usemi wa kurudisha

        linganisha r13d, -1
        ruka .return_void kama ==

        ; Zalisha usemi
        sukuma r12
        sukuma r13
        r12d = r13d
        ita uzalishaji_ast
        vuta r13
        vuta r12
        ; Thamani iko kwenye eax (au xmm0 kwa D64)

        ; Mpaka wa kamili/desimali kwenye kurudi (8.6): rudisha 21.5
        ; kutoka kwa kazi ya N32 inakata hadi 21; rudisha 5 kutoka
        ; kwa kazi ya D64 inapandisha hadi 5.0.
        linganisha n32[kazi_ret_aina], 7
        ruka .rudisha_bmd_d64 kama ==
        linganisha n32[kazi_ret_aina], 4
        ruka .rudisha_bmd_64 kama ==
        linganisha n32[kazi_ret_aina], 6
        ruka .rudisha_bmd_isha kama ==   ; sret — hakuna ubadilishaji
        linganisha n32[kazi_ret_aina], 5
        ruka .rudisha_bmd_isha kama ==   ; W0 — hakuna
        ruka .rudisha_bmd_32
.rudisha_bmd_d64:
        r6d = 7
        r2d = 8
        r7d = r13d
        ita badilisha_mpaka_wa_desimali
        ruka .rudisha_bmd_isha
.rudisha_bmd_64:
        r6d = 4
        r2d = 8
        r7d = r13d
        ita badilisha_mpaka_wa_desimali
        ruka .rudisha_bmd_isha
.rudisha_bmd_32:
        r6d = 3
        r2d = 4
        r7d = r13d
        ita badilisha_mpaka_wa_desimali
.rudisha_bmd_isha:
        ; Panua ishara ya matokeo ya N32 kwa kazi ya N64 (sawia na
        ; panua_ishara_ya_kauli kwenye kianzio na uwekaji).
        sukuma r12
        sukuma r13
        r7d = r13d
        ita panua_ishara_ya_kauli
        vuta r13
        vuta r12

        ; Kwa sret, nakili muundo hadi eneo la kurudia
        linganisha n32[kazi_ret_muundo_id], 0
        ruka .sio_nakala kama <n
        ; mov rdi, [rbp + 8]
        r0b = 0x48
        ita gen_baiti
        r0b = 0x8b
        ita gen_baiti
        r0b = 0x7d
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
        ; mov rsi, rax
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xc6
        ita gen_baiti
        ; mov ecx, ukubwa wa muundo
        r0b = 0xb9
        ita gen_baiti
        r7d = n32[kazi_ret_muundo_id]
        r7d = n32[muundo_ukubwa + r7*4]
        ita gen_neno4
        ; rep movsb
        r0b = 0xf3
        ita gen_baiti
        r0b = 0xa4
        ita gen_baiti
.sio_nakala:

        ; Ruka hadi mwisho wa kazi
        r0b = 0xe9   ; jmp rel32
        ita gen_baiti
        r7d = n32[text_buf_pos]
        ita gen_neno4   ; nafasi ya kujazwa
        r7 = n64[gen_return_label]
        r6d = r7d   ; lebo
        r7d = n32[text_buf_pos]
        r7d -= 4
        ita gen_fixup_ongeza
        ruka .done

.return_void:
        ; Ruka hadi mwisho wa kazi
        r0b = 0xe9   ; jmp rel32
        ita gen_baiti
        r7d = n32[text_buf_pos]
        ita gen_neno4
        r7 = n64[gen_return_label]
        r6d = r7d
        r7d = n32[text_buf_pos]
        r7d -= 4
        ita gen_fixup_ongeza

.done:
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_kauli_ya_binary: zalisha msimbo kwa operesheni binary
;   r12d = faharisi ya nodi
; -------------------------------------------------------
uzalishaji_kauli_ya_binary:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        r12d = r12d
        r13d = n32[ast_kushoto + r12*4]   ; kushoto
        r14d = n32[ast_kulia + r12*4]   ; kulia
        r15d = n32[ast_thamani + r12*4]   ; ishara

        ; Angalia ikiwa ni mfuatano wa herufi (kushoto == -1)
        linganisha r13d, -1
        ruka .do_string kama ==

        ; Angalia ikiwa ni assignment (=) — inahitaji utoaji maalum
        linganisha r15d, OP_SAWA
        ruka .do_assign kama ==

        ; Angalia ikiwa ni uchaguzi (?:) — operesheni haizalishwi mapema
        linganisha r15d, OP_HUU
        ruka .do_huu kama ==

        ; Kataa operesheni zisizofanya kazi kwa desimali (8.21):
        ; modulo, uhamishaji, NA/AU za biti na mantiki — ikiwa
        ; operanda yoyote ni D64. Jibu baya la kimya halikubaliki.
        linganisha r15d, OP_MODULO
        ruka .desi_operesheni_kagua kama ==
        linganisha r15d, OP_HAMISHA_KUSHOTO
        ruka .desi_operesheni_kagua kama ==
        linganisha r15d, OP_HAMISHA_KULIA
        ruka .desi_operesheni_kagua kama ==
        linganisha r15d, OP_NA
        ruka .desi_operesheni_kagua kama ==
        linganisha r15d, OP_AU
        ruka .desi_operesheni_kagua kama ==
        linganisha r15d, OP_NA_BITI
        ruka .desi_operesheni_kagua kama ==
        linganisha r15d, OP_AU_BITI
        ruka .desi_operesheni_kagua kama ==
        linganisha r15d, OP_XOR_BITI
        ruka .desi_operesheni_kagua kama ==
        ruka .desi_operesheni_sawa
.desi_operesheni_kagua:
        sukuma r12
        r12d = r13d
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .desi_operesheni_kosa kama ==
        sukuma r12
        r12d = r14d
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .desi_operesheni_sawa kama !=
.desi_operesheni_kosa:
        r7 = &[msg_desi_op]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.desi_operesheni_sawa:

        ; && na || zinahitaji mzunguko mfupi (short-circuit), sawa na
        ; uzalishaji_na/uzalishaji_au kwenye msingi/uzalishaji.swa.
        ; Bila hii, upande wa kulia unatathminiwa hata wakati kushoto
        ; tayari umeamua matokeo — dereferensi kama `j >= 0 && a[j]`
        ; zinavunjika kwa a[j] nje ya mipaka.
        linganisha r15d, OP_NA
        ruka .do_and_sc kama ==
        linganisha r15d, OP_AU
        ruka .do_or_sc kama ==

        ; Hesabu za kuelea (D64): kama operanda yoyote (kushoto AU
        ; kulia) ni ya kuelea, chukua njia ya SSE — thamani husafiri
        ; kupitia rafu kama baiti 8 (movq) na oparesheni hutumia
        ; xmm0/xmm1 (8.6: 2.5 < 3 na 3 == 3.0 ni za kuelea).
        ; Upana: operesheni ni ya baiti 8 (N64 au kielekezi) kwenye
        ; PANDE ZOTE MBILI — ili ugawanyo utumie cqo/idiv rcx badala
        ; ya cdq/idiv ecx (8.4: N32 + N64 = N64, hata kama kushoto
        ; ni N32).
        n32[gen_op_64bit] = 0
        sukuma r12
        r12d = r13d
        ita fumbua_aina
        vuta r12
        linganisha r0d, 4
        ruka .op64_ndiyo kama ==
        pima r3d, r3d
        ruka .op64_ndiyo kama >n
        sukuma r12
        r12d = r14d
        ita fumbua_aina
        vuta r12
        linganisha r0d, 4
        ruka .op64_ndiyo kama ==
        pima r3d, r3d
        ruka .op64_ndiyo kama >n
        ruka .op64_mwisho
.op64_ndiyo:
        n32[gen_op_64bit] = 1
.op64_mwisho:

        ; Kuelea: kushoto ni D64, au kulia ni D64 (8.6).
        ; Kielekezi au muundo pamoja na D64 ni kosa la sauti.
        sukuma r12
        r12d = r13d
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .sio_kuelea_kushoto_d kama !=
        r9d = 1   ; alama: operesheni ya kuelea
        ruka .kuelea_imepatikana
.sio_kuelea_kushoto_d:
        r9d = 0
        sukuma r12
        r12d = r14d
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .sio_kuelea kama !=
        r9d = 1
.kuelea_imepatikana:
        ; Kielekezi au muundo kwenye operesheni ya kuelea — kosa
        sukuma r12
        r12d = r13d
        ita fumbua_aina
        vuta r12
        pima r3d, r3d
        ruka .desi_kielekezi_kosa kama >n
        linganisha r0d, 6
        ruka .desi_kielekezi_kosa kama ==
        sukuma r12
        r12d = r14d
        ita fumbua_aina
        vuta r12
        pima r3d, r3d
        ruka .desi_kielekezi_kosa kama >n
        linganisha r0d, 6
        ruka .desi_kielekezi_kosa kama ==
        linganisha r15d, OP_JUMLISHA
        ruka .fl_add kama ==
        linganisha r15d, OP_TOA
        ruka .fl_sub kama ==
        linganisha r15d, OP_ZIDISHA
        ruka .fl_mul kama ==
        linganisha r15d, OP_GAWANYA
        ruka .fl_div kama ==
        linganisha r15d, OP_SAWA_SAWA
        ruka .fl_eq kama ==
        linganisha r15d, OP_SIO_SAWA
        ruka .fl_ne kama ==
        linganisha r15d, OP_KIDOGO
        ruka .fl_lt kama ==
        linganisha r15d, OP_KIDOGO_SAWA
        ruka .fl_le kama ==
        linganisha r15d, OP_KUBWA
        ruka .fl_gt kama ==
        linganisha r15d, OP_KUBWA_SAWA
        ruka .fl_ge kama ==
        ; Kuelea na ishara isiyojulikana — njia kamili itaanguka
        ruka .sio_kuelea
.desi_kielekezi_kosa:
        r7 = &[msg_desi_kielekezi]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.sio_kuelea:

        ; Hifadhi upana wa operesheni (baiti 4 au 8) kwenye rafu kabla ya
        ; kutathmini operanda. Kutathmini kunaweza kurudia kwa ndani
        ; uzalishaji_kauli_ya_binary na kuharibu gen_op_64bit; hivyo
        ; lazima tuuhifadhi kwa ajili ya operesheni hii tu.
        r2d = n32[gen_op_64bit]
        sukuma r2

        ; Zalisha upande wa kulia kwanza
        sukuma r12
        sukuma r15
        r12d = r14d
        ita uzalishaji_ast
        vuta r15
        vuta r12
        ; Operesheni ya baiti 8 yenye operanda ndogo yenye ishara:
        ; cdqe (48 98) — N8/N16/N32 hasi hupakiwa kwenye eax yenye
        ; ishara (movsx) huku biti za juu za rax zikiwa sifuri; bila
        ; cdqe jumlisho la 64-bit lingeona 0x00000000FFFFFFFF badala
        ; ya -1 (mnyororo wa .swa hupandisha ishara kila mara).
        ; [rsp] = gen_op_64bit iliyohifadhiwa.
        sukuma r0   ; hifadhi CT ya uzalishaji_ast
        linganisha n32[r4 + 8], 0
        ruka .cdqe_rhs_isha kama ==
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        r7d = r14d
        ita ni_jina_la_safu
        pima r0d, r0d
        ruka .cdqe_rhs_pika kama !=   ; safu — anwani, si thamani
        r12d = r14d
        ita fumbua_aina
        linganisha r0d, 1
        ruka .cdqe_rhs_pika kama <a   ; isiyojulikana — usiguse
        linganisha r0d, 3
        ruka .cdqe_rhs_pika kama >a   ; N64/W0/muundo/D64 — baiti 8 tayari
        pima r3d, r3d
        ruka .cdqe_rhs_pika kama !=   ; kielekezi — anwani
        r0b = 0x48
        ita gen_baiti
        r0b = 0x98
        ita gen_baiti
.cdqe_rhs_pika:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
.cdqe_rhs_isha:
        vuta r0   ; rejesha CT
        r1d = r0d   ; hifadhi kwa wakati wa kukusanya
        sukuma r1   ; hifadhi thamani ya wakati wa kukusanya
        ; Toa push rax — hifadhi thamani ya wakati wa utekelezaji
        r0b = 0x50
        ita gen_baiti

        ; Zalisha upande wa kushoto
        sukuma r12
        sukuma r15
        r12d = r13d
        ita uzalishaji_ast
        vuta r15
        vuta r12
        ; Sawa kwa upande wa kushoto; [rsp] = CT ya kulia, [rsp+8] =
        ; gen_op_64bit iliyohifadhiwa.
        sukuma r0   ; hifadhi CT ya uzalishaji_ast
        linganisha n32[r4 + 16], 0
        ruka .cdqe_lhs_isha kama ==
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        r7d = r13d
        ita ni_jina_la_safu
        pima r0d, r0d
        ruka .cdqe_lhs_pika kama !=
        r12d = r13d
        ita fumbua_aina
        linganisha r0d, 1
        ruka .cdqe_lhs_pika kama <a
        linganisha r0d, 3
        ruka .cdqe_lhs_pika kama >a
        pima r3d, r3d
        ruka .cdqe_lhs_pika kama !=
        r0b = 0x48
        ita gen_baiti
        r0b = 0x98
        ita gen_baiti
.cdqe_lhs_pika:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
.cdqe_lhs_isha:
        vuta r0   ; rejesha CT
        vuta r1   ; rejesha thamani ya kulia (wakati wa kukusanya)
        ; Toa pop rcx — rejesha thamani ya kulia (wakati wa utekelezaji)
        sukuma r0   ; hifadhi CT ya kushoto kabla ya kutoa
        r0b = 0x59
        ita gen_baiti
        vuta r0

        ; Rejesha upana wa operesheni hii kutoka rafu, ili .do_* watumie
        ; upana sahihi badala ya ule wa operesheni iliyopandwa ndani.
        vuta r2
        n32[gen_op_64bit] = r2d

        ; ======== HESABU YA ANWANI (C-semantiki) ========
        ; Kielekezi + kamili huzidisha upande wa namba kwa ukubwa wa
        ; kipengele: *(p + 1) ni p[1], si baiti ya 1, na *(1 + p) ni
        ; sawa (C-semantiki). (Mbegu ya zamani ilijumlisha kwa baiti —
        ; jibu baya la kimya: *(p + 1) lilisoma baiti 1 tu baada ya p.)
        ; Wakati wa utekelezaji hapa: rax = kushoto, rcx = kulia.
        ; Desimali hazifikii hapa (D64 huenda kwa .fl_* kabla ya
        ; kutathminiwa). p + q, p - q na n - p hazibadiliki — hazina
        ; kizidisho hapa (ukataji mkali ni wa mnyororo wa .swa).
        linganisha r15d, OP_JUMLISHA
        ruka .hesa_anza kama ==
        linganisha r15d, OP_TOA
        ruka .hesa_mwisho kama !=
.hesa_anza:
        sukuma r0   ; hifadhi CT ya kushoto
        sukuma r1   ; hifadhi CT ya kulia
        sukuma r13
        r12d = r13d
        ita fumbua_aina   ; eax=aina, ebx=nyota, edx=muundo id
        vuta r13
        r8d = r0d   ; aina msingi ya kushoto
        r9d = r3d   ; nyota za kushoto
        sukuma r2   ; hifadhi muundo id wa kushoto
        ; Kushoto ni jina la SAFU? Safu huoza hadi anwani; kipengele
        ; ni aina msingi pamoja na NYOTA zake moja kwa moja (safu ya
        ; kielekezi: kipengele ni anwani ya baiti 8).
        r7d = r13d
        ita ni_jina_la_safu   ; eax = 1 ikiwa ni safu
        pima r0d, r0d
        ruka .hesa_pn kama !=   ; kushoto ni safu — p + n
        pima r9d, r9d
        ruka .hesa_pn_kielekezi kama >n
        ruka .hesa_np_try   ; kushoto si anwani — jaribu n + p
.hesa_pn_kielekezi:
        r9d--   ; kielekezi: kipengele ni nyota - 1
.hesa_pn:
        ; ===== p + n (na p - n): kushoto ni kielekezi/safu =====
        ; Kulia lazima kiwe kamili rahisi: N8..N64 bila nyota, si
        ; safu. Kila kitu kingine (kielekezi, W0, muundo, D64,
        ; isiyojulikana, safu) kinarudi kwenye jumlisho la zamani.
        sukuma r8
        sukuma r9
        sukuma r14
        r7d = r14d
        ita ni_jina_la_safu
        pima r0d, r0d
        ruka .hesa_pn_sio kama !=
        r12d = r14d
        ita fumbua_aina   ; eax=aina ya kulia, ebx=nyota
        pima r3d, r3d
        ruka .hesa_pn_sio kama >n   ; kulia ni kielekezi
        linganisha r0d, 1
        ruka .hesa_pn_sio kama <a   ; isiyojulikana
        linganisha r0d, 4
        ruka .hesa_pn_sio kama >a   ; W0, muundo au D64
        vuta r14
        vuta r9
        vuta r8
        ; Kulia ni kamili — matokeo ni anwani: upana wa baiti 8
        ; (hata kwa kushoto la safu — anwani ya safu ni 64-bit).
        n32[gen_op_64bit] = 1
        ; N8/N16/N32 ya kulia: panua ishara — movsxd rcx, ecx
        ; (48 63 C9). Kigezo cha N32 hasi (-1) kimepakiwa kama
        ; 0xFFFFFFFF kwenye rejesta ya 64-bit (upanuzi wa sifuri);
        ; bila upanuzi huu kuzidisha na kujumlisha kungepoteza
        ; ishara ya faharisi hasi (p[-1]).
        linganisha r0d, 4
        ruka .hesa_pn_upanuzi_iko kama ==
        r0b = 0x48
        ita gen_baiti
        r0b = 0x63
        ita gen_baiti
        r0b = 0xC9
        ita gen_baiti
.hesa_pn_upanuzi_iko:
        r10d = n32[r4]   ; muundo id wa kushoto
        r4 += 8
        ita .hesa_ukubwa   ; r8d/r9d/r10d → r8d ukubwa
        ; Zidisha rcx (idadi ya vipengele) kwa ukubwa
        linganisha r8d, 1
        ruka .hesa_pn_ct kama <=a   ; ukubwa 0 au 1 — hakuna
        linganisha r8d, 2
        ruka .hesa_pn_mara_2 kama ==
        linganisha r8d, 4
        ruka .hesa_pn_mara_4 kama ==
        linganisha r8d, 8
        ruka .hesa_pn_mara_8 kama ==
        ; Ukubwa mwingine wowote (miundo): imul rcx, rcx, imm32
        r0b = 0x48
        ita gen_baiti
        r0b = 0x69
        ita gen_baiti
        r0b = 0xC9
        ita gen_baiti
        r7d = r8d
        ita gen_neno4
        ruka .hesa_pn_ct
.hesa_pn_mara_2:
        ; shl rcx, 1 (48 C1 E1 01)
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0b = 0xE1
        ita gen_baiti
        r0b = 1
        ita gen_baiti
        ruka .hesa_pn_ct
.hesa_pn_mara_4:
        ; shl rcx, 2
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0b = 0xE1
        ita gen_baiti
        r0b = 2
        ita gen_baiti
        ruka .hesa_pn_ct
.hesa_pn_mara_8:
        ; shl rcx, 3
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0b = 0xE1
        ita gen_baiti
        r0b = 3
        ita gen_baiti
.hesa_pn_ct:
        ; CT ya kulia pia inazidishwa — .do_add na .do_sub
        ; zinajumlisha kwa wakati wa kukusanya na matokeo yake
        ; lazima yalingane na ya wakati wa utekelezaji.
        vuta r1   ; CT ya kulia
        linganisha r8d, 1
        ruka .hesa_pn_ct_iko kama <=a
        r1d *= r8d
.hesa_pn_ct_iko:
        vuta r0   ; CT ya kushoto
        ruka .hesa_mwisho
.hesa_np_try:
        ; ===== n + p: kushoto ni KAMILI, kulia ni kielekezi/safu =====
        ; (toa yenye kushoto kamili — n - p — haibadiliki: mnyororo
        ; wa .swa ndio unaoikataa kwa sauti.)
        linganisha r15d, OP_TOA
        ruka .hesa_pn_sio_rahisi kama ==
        sukuma r8
        sukuma r9
        sukuma r14
        r7d = r14d
        ita ni_jina_la_safu
        r13d = r0d   ; alama: kulia ni safu (r13 huhifadhiwa na fumbua)
        r12d = r14d
        ita fumbua_aina   ; eax=aina ya kulia, ebx=nyota
        pima r13d, r13d
        ruka .hesa_np_anwani kama !=   ; safu — kipengele = (aina, nyota)
        pima r3d, r3d
        ruka .hesa_np_sio kama <=n   ; kulia si kielekezi — kama zamani
        r3d--   ; kipengele = nyota - 1
.hesa_np_anwani:
        ; Kushoto (n) lazima kiwe kamili rahisi 1..4 — aina yake
        ; iko chini ya r14/r9/r8 kwenye rafu (r8d = aina ya kushoto)
        r10d = n32[r4 + 16]
        linganisha r10d, 1
        ruka .hesa_np_sio kama <a
        linganisha r10d, 4
        ruka .hesa_np_sio kama >a
        vuta r14
        vuta r9
        vuta r8
        r4 += 8   ; toa muundo id wa kushoto
        sukuma r2   ; muundo id wa KULIA
        r8d = r0d   ; aina ya kipengele (msingi wa kulia)
        r9d = r3d   ; nyota za kipengele
        ; Matokeo ni anwani: upana wa baiti 8
        n32[gen_op_64bit] = 1
        ; N8/N16/N32 ya kushoto: panua ishara — cdqe (48 98)
        linganisha r10d, 4
        ruka .hesa_np_upanuzi_iko kama ==
        r0b = 0x48
        ita gen_baiti
        r0b = 0x98
        ita gen_baiti
.hesa_np_upanuzi_iko:
        r10d = n32[r4]   ; muundo id wa kulia
        r4 += 8
        ita .hesa_ukubwa   ; r8d/r9d/r10d → r8d ukubwa
        ; Zidisha rax (n) kwa ukubwa wa kipengele
        linganisha r8d, 1
        ruka .hesa_np_ct kama <=a   ; ukubwa 0 au 1 — hakuna
        linganisha r8d, 2
        ruka .hesa_np_mara_2 kama ==
        linganisha r8d, 4
        ruka .hesa_np_mara_4 kama ==
        linganisha r8d, 8
        ruka .hesa_np_mara_8 kama ==
        ; Ukubwa mwingine wowote (miundo): imul rax, rax, imm32
        r0b = 0x48
        ita gen_baiti
        r0b = 0x69
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        r7d = r8d
        ita gen_neno4
        ruka .hesa_np_ct
.hesa_np_mara_2:
        ; shl rax, 1 (48 C1 E0 01)
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0b = 0xE0
        ita gen_baiti
        r0b = 1
        ita gen_baiti
        ruka .hesa_np_ct
.hesa_np_mara_4:
        ; shl rax, 2
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0b = 0xE0
        ita gen_baiti
        r0b = 2
        ita gen_baiti
        ruka .hesa_np_ct
.hesa_np_mara_8:
        ; shl rax, 3
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0b = 0xE0
        ita gen_baiti
        r0b = 3
        ita gen_baiti
.hesa_np_ct:
        ; CT ya kushoto (n) nayo inazidishwa — uendelezi na .do_add
        vuta r1   ; CT ya kulia (pointer — haibadiliki)
        vuta r0   ; CT ya kushoto
        linganisha r8d, 1
        ruka .hesa_np_ct_iko kama <=a
        r0d *= r8d
.hesa_np_ct_iko:
        ruka .hesa_mwisho
.hesa_np_sio:
        ; Kulia si kielekezi wala safu — hakuna kizidisho
        vuta r14
        vuta r9
        vuta r8
.hesa_pn_sio_rahisi:
        ; Hakuna kizidisho (kushoto kamili na OP_TOA, au kulia si
        ; anwani) — sawazisha rafu na urudi kwenye jumlisho la zamani
        ruka .hesa_rejesha
.hesa_pn_sio:
        ; Kulia si kamili rahisi — hakuna kizidisho; sawazisha rafu
        vuta r14
        vuta r9
        vuta r8
.hesa_rejesha:
        r4 += 8   ; toa muundo id
        vuta r1   ; CT ya kulia
        vuta r0   ; CT ya kushoto
.hesa_mwisho:
        ruka .hesa_dispatch

.hesa_ukubwa:
        ; Kisaidizi cha ndani: ukubwa wa kipengele kwa baiti
        ;   r8d = aina msingi, r9d = nyota, r10d = muundo id
        ;   rax = ukubwa (1, 2, 4, 8, au ukubwa wa muundo)
        ; Huharibu rax pekee (na r8d ndilo matokeo).
        pima r9d, r9d
        ruka .hesa_ukubwa_8 kama >n   ; kipengele chenye nyota — anwani
        linganisha r8d, 1
        ruka .hesa_ukubwa_sio kama <a   ; isiyojulikana — hakuna kizidisho
        linganisha r8d, 1
        ruka .hesa_ukubwa_1 kama ==
        linganisha r8d, 2
        ruka .hesa_ukubwa_2 kama ==
        linganisha r8d, 3
        ruka .hesa_ukubwa_4 kama ==
        linganisha r8d, 6
        ruka .hesa_ukubwa_muundo kama ==
.hesa_ukubwa_8:
        ; N64 (4), W0 (5) na D64 (7) → baiti 8
        r8d = 8
        rudi
.hesa_ukubwa_muundo:
        ; Muundo: ukubwa halisi kutoka jedwali la miundo
        linganisha r10d, 0
        ruka .hesa_ukubwa_sio kama <n
        linganisha r10d, n32[muundo_count]
        ruka .hesa_ukubwa_sio kama >=a
        r8d = n32[muundo_ukubwa + r10*4]
        rudi
.hesa_ukubwa_4:
        r8d = 4
        rudi
.hesa_ukubwa_2:
        r8d = 2
        rudi
.hesa_ukubwa_1:
        r8d = 1
        rudi
.hesa_ukubwa_sio:
        r8d ^= r8d
        rudi
.hesa_dispatch:
        ; eax = kushoto (wakati wa kukusanya), ecx = kulia (wakati wa kukusanya)
        ; Fanya operesheni kwa wakati wa kukusanya NA utoe maelekezo
        linganisha r15d, OP_JUMLISHA
        ruka .do_add kama ==
        linganisha r15d, OP_TOA
        ruka .do_sub kama ==
        linganisha r15d, OP_ZIDISHA
        ruka .do_mul kama ==
        linganisha r15d, OP_GAWANYA
        ruka .do_div kama ==
        linganisha r15d, OP_MODULO
        ruka .do_mod kama ==
        linganisha r15d, OP_SAWA_SAWA
        ruka .do_eq kama ==
        linganisha r15d, OP_SIO_SAWA
        ruka .do_ne kama ==
        linganisha r15d, OP_KIDOGO
        ruka .do_lt kama ==
        linganisha r15d, OP_KUBWA
        ruka .do_gt kama ==
        linganisha r15d, OP_KIDOGO_SAWA
        ruka .do_le kama ==
        linganisha r15d, OP_KUBWA_SAWA
        ruka .do_ge kama ==
        linganisha r15d, OP_NA
        ruka .do_and kama ==
        linganisha r15d, OP_AU
        ruka .do_or kama ==
        linganisha r15d, OP_NA_BITI
        ruka .do_and kama ==
        linganisha r15d, OP_AU_BITI
        ruka .do_or kama ==
        linganisha r15d, OP_XOR_BITI
        ruka .do_xor kama ==
        linganisha r15d, OP_HAMISHA_KUSHOTO
        ruka .do_shl kama ==
        linganisha r15d, OP_HAMISHA_KULIA
        ruka .do_shr kama ==
        ; chaguo-msingi
        ruka .done

.do_add:
        r0d += r1d   ; wakati wa kukusanya
        sukuma r0   ; hifadhi CT kabla ya kutoa
        linganisha n32[gen_op_64bit], 0
        ruka .add_emit32 kama ==
        ; add rax, rcx → 48 01 c8
        r0b = 0x48
        ita gen_baiti
        r0b = 0x01
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .add_emit_mwisho
.add_emit32:
        ; add eax, ecx → 01 c8
        r0b = 0x01
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
.add_emit_mwisho:
        vuta r0
        ruka .done
.do_sub:
        r0d -= r1d   ; wakati wa kukusanya
        sukuma r0   ; hifadhi CT kabla ya kutoa
        linganisha n32[gen_op_64bit], 0
        ruka .sub_emit32 kama ==
        ; sub rax, rcx → 48 29 c8
        r0b = 0x48
        ita gen_baiti
        r0b = 0x29
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .sub_emit_mwisho
.sub_emit32:
        ; sub eax, ecx → 29 c8
        r0b = 0x29
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
.sub_emit_mwisho:
        vuta r0
        ruka .done
.do_mul:
        r0d *= r1d   ; wakati wa kukusanya
        sukuma r0   ; hifadhi CT kabla ya kutoa
        linganisha n32[gen_op_64bit], 0
        ruka .mul_emit32 kama ==
        ; imul rax, rcx → 48 0f af c1
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0f
        ita gen_baiti
        r0b = 0xaf
        ita gen_baiti
        r0b = 0xc1
        ita gen_baiti
        ruka .mul_emit_mwisho
.mul_emit32:
        ; imul eax, ecx → 0f af c1
        r0b = 0x0f
        ita gen_baiti
        r0b = 0xaf
        ita gen_baiti
        r0b = 0xc1
        ita gen_baiti
.mul_emit_mwisho:
        vuta r0
        ruka .done
.do_div:
        ; Epuka idiv kwa wakati wa kukusanya ikiwa kigawanyo ni sifuri
        linganisha r1d, 0
        ruka .div_skip_ct kama ==
        panua r0d   ; wakati wa kukusanya
        gawanya n r1d
.div_skip_ct:
        sukuma r0   ; hifadhi CT kabla ya kutoa
        linganisha n32[gen_op_64bit], 0
        ruka .div_emit32 kama ==
        ; cqo → 48 99 (baiti 8)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x99
        ita gen_baiti
        ; idiv rcx → 48 f7 f9
        r0b = 0x48
        ita gen_baiti
        r0b = 0xf7
        ita gen_baiti
        r0b = 0xf9
        ita gen_baiti
        ruka .div_emit_mwisho
.div_emit32:
        ; cdq → 99
        r0b = 0x99
        ita gen_baiti
        ; idiv ecx → f7 f9
        r0b = 0xf7
        ita gen_baiti
        r0b = 0xf9
        ita gen_baiti
.div_emit_mwisho:
        vuta r0
        ruka .done
.do_mod:
        ; Epuka idiv kwa wakati wa kukusanya ikiwa kigawanyo ni sifuri
        linganisha r1d, 0
        ruka .mod_skip_ct kama ==
        panua r0d   ; wakati wa kukusanya
        gawanya n r1d
        r0d = r2d
.mod_skip_ct:
        sukuma r0   ; hifadhi CT kabla ya kutoa
        linganisha n32[gen_op_64bit], 0
        ruka .mod_emit32 kama ==
        ; cqo → 48 99 (baiti 8)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x99
        ita gen_baiti
        ; idiv rcx → 48 f7 f9
        r0b = 0x48
        ita gen_baiti
        r0b = 0xf7
        ita gen_baiti
        r0b = 0xf9
        ita gen_baiti
        ; mov rax, rdx → 48 89 d0
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xd0
        ita gen_baiti
        ruka .mod_emit_mwisho
.mod_emit32:
        ; cdq → 99
        r0b = 0x99
        ita gen_baiti
        ; idiv ecx → f7 f9
        r0b = 0xf7
        ita gen_baiti
        r0b = 0xf9
        ita gen_baiti
        ; mov eax, edx → 89 d0
        r0b = 0x89
        ita gen_baiti
        r0b = 0xd0
        ita gen_baiti
.mod_emit_mwisho:
        vuta r0
        ruka .done
.do_eq:
        linganisha r0d, r1d   ; wakati wa kukusanya
        r0b = kama ==
        r0d = a r0b
        sukuma r0   ; hifadhi CT kabla ya kutoa
        linganisha n32[gen_op_64bit], 0
        ruka .eq_emit32 kama ==
        ; cmp rax, rcx → 48 39 c8 (baiti 8)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .eq_emit_mwisho
.eq_emit32:
        ; cmp eax, ecx → 39 c8
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
.eq_emit_mwisho:
        ; sete al → 0f 94 c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x94
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; movzx eax, al → 0f b6 c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0xb6
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        vuta r0
        ruka .done
.do_ne:
        linganisha r0d, r1d   ; wakati wa kukusanya
        r0b = kama !=
        r0d = a r0b
        sukuma r0   ; hifadhi CT kabla ya kutoa
        linganisha n32[gen_op_64bit], 0
        ruka .ne_emit32 kama ==
        ; cmp rax, rcx → 48 39 c8 (baiti 8)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .ne_emit_mwisho
.ne_emit32:
        ; cmp eax, ecx → 39 c8
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
.ne_emit_mwisho:
        ; setne al → 0f 95 c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x95
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; movzx eax, al → 0f b6 c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0xb6
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        vuta r0
        ruka .done
.do_lt:
        linganisha r0d, r1d   ; wakati wa kukusanya
        r0b = kama <n
        r0d = a r0b
        sukuma r0   ; hifadhi CT kabla ya kutoa
        linganisha n32[gen_op_64bit], 0
        ruka .lt_emit32 kama ==
        ; cmp rax, rcx → 48 39 c8 (baiti 8)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .lt_emit_mwisho
.lt_emit32:
        ; cmp eax, ecx → 39 c8
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
.lt_emit_mwisho:
        ; setl al → 0f 9c c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x9c
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; movzx eax, al → 0f b6 c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0xb6
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        vuta r0
        ruka .done
.do_gt:
        linganisha r0d, r1d   ; wakati wa kukusanya
        r0b = kama >n
        r0d = a r0b
        sukuma r0   ; hifadhi CT kabla ya kutoa
        linganisha n32[gen_op_64bit], 0
        ruka .gt_emit32 kama ==
        ; cmp rax, rcx → 48 39 c8 (baiti 8)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .gt_emit_mwisho
.gt_emit32:
        ; cmp eax, ecx → 39 c8
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
.gt_emit_mwisho:
        ; setg al → 0f 9f c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x9f
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; movzx eax, al → 0f b6 c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0xb6
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        vuta r0
        ruka .done
.do_le:
        linganisha r0d, r1d   ; wakati wa kukusanya
        r0b = kama <=n
        r0d = a r0b
        sukuma r0   ; hifadhi CT kabla ya kutoa
        linganisha n32[gen_op_64bit], 0
        ruka .le_emit32 kama ==
        ; cmp rax, rcx → 48 39 c8 (baiti 8)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .le_emit_mwisho
.le_emit32:
        ; cmp eax, ecx → 39 c8
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
.le_emit_mwisho:
        ; setle al → 0f 9e c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x9e
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; movzx eax, al → 0f b6 c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0xb6
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        vuta r0
        ruka .done
.do_ge:
        linganisha r0d, r1d   ; wakati wa kukusanya
        r0b = kama >=n
        r0d = a r0b
        sukuma r0   ; hifadhi CT kabla ya kutoa
        linganisha n32[gen_op_64bit], 0
        ruka .ge_emit32 kama ==
        ; cmp rax, rcx → 48 39 c8 (baiti 8)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .ge_emit_mwisho
.ge_emit32:
        ; cmp eax, ecx → 39 c8
        r0b = 0x39
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
.ge_emit_mwisho:
        ; setge al → 0f 9d c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x9d
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; movzx eax, al → 0f b6 c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0xb6
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        vuta r0
        ruka .done
.do_and:
        ; wakati wa kukusanya: and eax, ecx
        r0d &= r1d
        sukuma r0   ; hifadhi CT kabla ya kutoa
        ; NA ya biti kwa N64 ni ya baiti 8 (8.4): and rax, rcx -> 48 21 c8
        linganisha n32[gen_op_64bit], 0
        ruka .and_emit32 kama ==
        r0b = 0x48
        ita gen_baiti
        r0b = 0x21
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .and_emit_mwisho
.and_emit32:
        ; and eax, ecx -> 21 c8
        r0b = 0x21
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
.and_emit_mwisho:
        vuta r0
        ruka .done
.do_or:
        ; wakati wa kukusanya: or eax, ecx
        r0d |= r1d
        sukuma r0   ; hifadhi CT kabla ya kutoa
        ; AU ya biti kwa N64 ni ya baiti 8: or rax, rcx -> 48 09 c8
        linganisha n32[gen_op_64bit], 0
        ruka .or_emit32 kama ==
        r0b = 0x48
        ita gen_baiti
        r0b = 0x09
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .or_emit_mwisho
.or_emit32:
        ; or eax, ecx -> 09 c8
        r0b = 0x09
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
.or_emit_mwisho:
        vuta r0
        ruka .done
.do_xor:
        ; wakati wa kukusanya: xor eax, ecx
        r0d ^= r1d
        sukuma r0   ; hifadhi CT kabla ya kutoa
        ; XOR ya biti kwa N64 ni ya baiti 8: xor rax, rcx -> 48 31 c8
        linganisha n32[gen_op_64bit], 0
        ruka .xor_emit32 kama ==
        r0b = 0x48
        ita gen_baiti
        r0b = 0x31
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .xor_emit_mwisho
.xor_emit32:
        ; xor eax, ecx -> 31 c8
        r0b = 0x31
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
.xor_emit_mwisho:
        vuta r0
        ruka .done
.do_shl:
        ; Hifadhi operesheni kabla ya kutoa (al itaharibiwa na mwito)
        r8d = r0d   ; kushoto (wakati wa kukusanya)
        r9d = r1d   ; kulia (wakati wa kukusanya)
        ; Uhamishaji wa N64 ni wa baiti 8 (8.5): shl rax, cl -> 48 d3 e0
        linganisha n32[gen_op_64bit], 0
        ruka .shl_emit64 kama !=
        ; Kianzilishi cha N64: uhamishaji ni wa baiti 8 hata kama
        ; operanda zote ni N32 (mfano: "N64 x = 1 << 32").
        linganisha n32[kianzio_lengo64], 0
        ruka .shl_emit32 kama ==
.shl_emit64:
        r0b = 0x48
        ita gen_baiti
        r0b = 0xd3
        ita gen_baiti
        r0b = 0xe0
        ita gen_baiti
        ruka .shl_ct
.shl_emit32:
        ; shl eax, cl -> d3 e0
        r0b = 0xd3
        ita gen_baiti
        r0b = 0xe0
        ita gen_baiti
.shl_ct:
        ; wakati wa kukusanya — operesheni halisi baada ya kutoa
        linganisha r8d, -1
        ruka .shift_isiyojulikana kama ==
        linganisha r9d, -1
        ruka .shift_isiyojulikana kama ==
        linganisha n32[gen_op_64bit], 0
        ruka .shl_ct64 kama !=
        linganisha n32[kianzio_lengo64], 0
        ruka .shl_ct32 kama ==
.shl_ct64:
        r0 = r8
        r1 = r9
        r0 <<= r1b
        ruka .done
.shl_ct32:
        r0d = r8d
        r1d = r9d
        r0d <<= r1b
        ruka .done
.do_shr:
        ; Hifadhi operesheni kabla ya kutoa (al itaharibiwa na mwito)
        r8d = r0d   ; kushoto (wakati wa kukusanya)
        r9d = r1d   ; kulia (wakati wa kukusanya)
        ; Uhamishaji wa N64 ni wa baiti 8 (8.5): sar rax, cl -> 48 d3 f8
        linganisha n32[gen_op_64bit], 0
        ruka .shr_emit64 kama !=
        ; Kianzilishi cha N64: uhamishaji ni wa baiti 8 hata kama
        ; operanda zote ni N32 (mfano: "N64 x = 1 << 32").
        linganisha n32[kianzio_lengo64], 0
        ruka .shr_emit32 kama ==
.shr_emit64:
        r0b = 0x48
        ita gen_baiti
        r0b = 0xd3
        ita gen_baiti
        r0b = 0xf8
        ita gen_baiti
        ruka .shr_ct
.shr_emit32:
        ; sar eax, cl -> d3 f8
        r0b = 0xd3
        ita gen_baiti
        r0b = 0xf8
        ita gen_baiti
.shr_ct:
        ; wakati wa kukusanya — operesheni halisi baada ya kutoa
        linganisha r8d, -1
        ruka .shift_isiyojulikana kama ==
        linganisha r9d, -1
        ruka .shift_isiyojulikana kama ==
        linganisha n32[gen_op_64bit], 0
        ruka .shr_ct64 kama !=
        linganisha n32[kianzio_lengo64], 0
        ruka .shr_ct32 kama ==
.shr_ct64:
        r0 = r8
        r1 = r9
        r0 >>=n r1b
        ruka .done
.shr_ct32:
        r0d = r8d
        r1d = r9d
        r0d >>=n r1b
        ruka .done
.shift_isiyojulikana:
        r0d = -1
        ruka .done
.do_huu:
        ; Uchaguzi ?: — r13d = sharti, r14d = mfuatano (kweli, uwongo)
        ; Aina ya matokeo (8.6): D64 ikiwa tawi lolote ni D64 —
        ; hifadhi alama kwenye rafu kwa matawi yote mawili.
        sukuma r12
        r12d = n32[ast_kushoto + r14*4]
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .huu_alama_d64 kama ==
        sukuma r12
        r12d = n32[ast_kulia + r14*4]
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .huu_alama_d64 kama ==
        r0d ^= r0d   ; 0 = kamili
        ruka .huu_alama_iko
.huu_alama_d64:
        r0d = 1   ; 1 = D64
.huu_alama_iko:
        sukuma r0   ; [rsp] = alama ya D64

        ; Zalisha sharti
        sukuma r12
        r12d = r13d
        ita uzalishaji_ast
        vuta r12
        r8d = r0d   ; CT ya sharti

        ; test eax, eax -> 85 c0
        r0b = 0x85
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti

        ; je — ofseti itarekebishwa baadaye -> 0f 84
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r9d = n32[text_buf_pos]   ; nafasi ya fixup ya je
        r7d ^= r7d
        ita gen_neno4   ; kishikilia

        ; Tawi la kweli
        sukuma r12
        sukuma r8   ; hifadhi CT ya sharti
        sukuma r9   ; hifadhi fixup ya je
        r12d = n32[ast_kushoto + r14*4]
        ita uzalishaji_ast
        vuta r9
        vuta r8
        vuta r12
        r10d = r0d   ; CT ya kweli

        ; Mpaka wa kamili/desimali kwenye tawi la kweli (8.6):
        ; 1 ? 2.5 : 3 — matokeo D64, tawi la kamili linapandishwa.
        sukuma r12
        sukuma r8
        sukuma r9
        sukuma r10
        r12d = n32[ast_kushoto + r14*4]
        ita fumbua_aina
        vuta r10
        vuta r9
        vuta r8
        vuta r12
        linganisha n64[r4], 0   ; alama ya D64
        ruka .huu_kweli_kamili kama ==
        linganisha r0d, 7
        ruka .huu_kweli_iko kama ==
        linganisha r0d, 4
        ruka .huu_kweli_64 kama ==
        ; cvtsi2sd xmm0, eax → F2 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .huu_kweli_iko
.huu_kweli_64:
        ; cvtsi2sd xmm0, rax → F2 48 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .huu_kweli_iko
.huu_kweli_kamili:
        linganisha r0d, 7
        ruka .huu_kweli_iko kama !=
        ; cvttsd2si eax, xmm0 → F2 0F 2C C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2C
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
.huu_kweli_iko:

        ; jmp — ruka juu ya tawi la uwongo -> e9
        r0b = 0xe9
        ita gen_baiti
        r11d = n32[text_buf_pos]   ; nafasi ya fixup ya jmp
        r7d ^= r7d
        ita gen_neno4   ; kishikilia

        ; Rekebisha je: elekeza kwenye mwanzo wa tawi la uwongo
        r7d = n32[text_buf_pos]
        r7d -= r9d
        r7d -= 4
        r15d = n32[text_buf_pos]   ; hifadhi nafasi ya sasa
        n32[text_buf_pos] = r9d
        ita gen_neno4
        n32[text_buf_pos] = r15d   ; rejesha nafasi

        ; Tawi la uwongo
        sukuma r12
        sukuma r8   ; CT ya sharti
        sukuma r10   ; CT ya kweli
        sukuma r11   ; fixup ya jmp
        r12d = n32[ast_kulia + r14*4]
        ita uzalishaji_ast
        vuta r11
        vuta r10
        vuta r8
        vuta r12
        r1d = r0d   ; CT ya uwongo

        ; Mpaka wa kamili/desimali kwenye tawi la uwongo (8.6)
        sukuma r12
        sukuma r8
        sukuma r10
        sukuma r11
        sukuma r1
        r12d = n32[ast_kulia + r14*4]
        ita fumbua_aina
        vuta r1
        vuta r11
        vuta r10
        vuta r8
        vuta r12
        linganisha n64[r4], 0   ; alama ya D64
        ruka .huu_uwongo_kamili kama ==
        linganisha r0d, 7
        ruka .huu_uwongo_iko kama ==
        linganisha r0d, 4
        ruka .huu_uwongo_64 kama ==
        ; cvtsi2sd xmm0, eax → F2 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .huu_uwongo_iko
.huu_uwongo_64:
        ; cvtsi2sd xmm0, rax → F2 48 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .huu_uwongo_iko
.huu_uwongo_kamili:
        linganisha r0d, 7
        ruka .huu_uwongo_iko kama !=
        ; cvttsd2si eax, xmm0 → F2 0F 2C C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2C
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
.huu_uwongo_iko:

        ; Rekebisha jmp: elekeza baada ya tawi la uwongo
        r7d = n32[text_buf_pos]
        r7d -= r11d
        r7d -= 4
        r15d = n32[text_buf_pos]
        n32[text_buf_pos] = r11d
        ita gen_neno4
        n32[text_buf_pos] = r15d

        ; Chagua thamani ya wakati wa kukusanya
        linganisha r8d, -1
        ruka .huu_isiyojulikana kama ==
        pima r8d, r8d
        ruka .huu_chagua_uwongo kama ==
        r0d = r10d
        ruka .huu_mwisho
.huu_chagua_uwongo:
        r0d = r1d
        ruka .huu_mwisho
.huu_isiyojulikana:
        linganisha r10d, r1d
        ruka .huu_tofauti kama !=
        r0d = r10d
        ruka .huu_mwisho
.huu_tofauti:
        r0d = -1
.huu_mwisho:
        r4 += 8   ; toa alama ya D64
        ruka .done
.do_assign:
        ; Assignment: tathmini kulia, hifadhi kwa upande wa kushoto
        sukuma r12
        sukuma r15
        r12d = r14d   ; nodi ya usemi wa kulia
        ita uzalishaji_ast   ; toa msimbo wa kutathmini usemi
        vuta r15
        vuta r12
        r8d = r0d   ; hifadhi thamani ya wakati wa kukusanya

        ; Panua ishara ya matokeo ya hesabu ya binary kabla ya
        ; kuhifadhiwa kwenye lengwa la baiti 8 — sawia na
        ; panua_ishara_ndogo ya mnyororo wa .swa na kianzilishi
        ; cha tangazo (uzalishaji_tangazo). Anwani hazipanuliwi:
        ; kielekezi (nyota > 0) na jina la safu (lea) si thamani ya
        ; hesabu; ?: (OP_HUU) pia haijumuishwi kwa sababu fumbua_aina
        ; huukadiria kwa aina ya sharti, si ya matokeo.
        sukuma r8   ; hifadhi CT ya RHS kwenye rafu
        r7d = r14d
        ita panua_ishara_ya_kauli
        vuta r8

        ; Mpaka wa kamili/desimali kwenye ugawaji (8.6): D64 → kamili
        ; na kamili → D64, kulingana na aina ya lengwa (kushoto).
        sukuma r12
        r12d = r13d   ; nodi ya lengwa
        ita fumbua_aina   ; eax = aina, ebx = nyota
        vuta r12
        pima r3d, r3d
        ruka .as_bmd_isha kama !=   ; kielekezi — hakuna ubadilishaji
        linganisha r0d, 7
        ruka .as_bmd_d64 kama ==
        linganisha r0d, 4
        ruka .as_bmd_64 kama ==
        linganisha r0d, 1
        ruka .as_bmd_32 kama ==
        linganisha r0d, 2
        ruka .as_bmd_32 kama ==
        linganisha r0d, 3
        ruka .as_bmd_32 kama ==
        ruka .as_bmd_isha
.as_bmd_d64:
        r6d = 7
        r2d = 8
        r7d = r14d
        ita badilisha_mpaka_wa_desimali
        ruka .as_bmd_isha
.as_bmd_64:
        r6d = 4
        r2d = 8
        r7d = r14d
        ita badilisha_mpaka_wa_desimali
        ruka .as_bmd_isha
.as_bmd_32:
        r6d = 3
        r2d = 4
        r7d = r14d
        ita badilisha_mpaka_wa_desimali
.as_bmd_isha:

        ; Upande wa kushoto: jina la kigezo, faharisi ya safu, dereferensi
        ; au mwanachama wa muundo
        r3d = n32[ast_aina + r13*4]
        linganisha r3d, AST_JINA
        ruka .assign_jina kama ==
        linganisha r3d, AST_KIELELEZO
        ruka .assign_kielelezo kama ==
        linganisha r3d, AST_NYOTA_ELEKEZA
        ruka .assign_nyota kama ==
        linganisha r3d, AST_ELEKEZA_JINA
        ruka .assign_mwanachama kama ==
        linganisha r3d, AST_ENEKEZA_FUNGO
        ruka .assign_mwanachama kama ==
        ruka .assign_err

.assign_jina:
        ; Pata anwani ya jina la kigezo
        r9d = n32[ast_jina_off + r13*4]
        r9 = &[str_pool + r9]

        ; Tafuta kigezo kwenye orodha ya vigezo vya ndani
        r10d ^= r10d
.as_search:
        linganisha r10, n64[local_count]
        ruka .as_global_search kama >=a
        r7 = n64[local_name + r10*8]
        r6 = r9
        sukuma r8
        sukuma r9
        sukuma r10
        sukuma r11
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        ita linganisha_mfuatano
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        vuta r11
        vuta r10
        vuta r9
        vuta r8
        pima r0d, r0d
        ruka .as_found kama ==
        r10++
        ruka .as_search

.as_found:
        r7d = n32[local_offset + r10*4]
        r7d = -r7d
        ; Amua ukubwa wa hifadhi kulingana na aina ya kigezo
        r11d = n32[local_star_count + r10*4]
        linganisha r11d, 0
        ruka .as_local_store_64 kama >n
        r11d = n32[local_base_type + r10*4]
        linganisha r11d, 1
        ruka .as_local_store_8 kama ==
        linganisha r11d, 2
        ruka .as_local_store_16 kama ==
        linganisha r11d, 4
        ruka .as_local_store_64 kama ==
        linganisha r11d, 5
        ruka .as_local_store_64 kama ==
        linganisha r11d, 6
        ruka .as_local_store_muundo kama ==
        linganisha r11d, 7
        ruka .as_local_store_d64 kama ==
        ; N32 (3) au chaguo-msingi — baiti 4
        r0b = 0x89   ; mov [rbp+disp32], eax
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        ita gen_neno4
        ruka .as_local_store_done
.as_local_store_d64:
        ; D64 — movsd [rbp+disp32], xmm0 -> f2 0f 11 85 d32
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x11
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        ita gen_neno4
        ruka .as_local_store_done
.as_local_store_muundo:
        ; b = a (nakala ya muundo mzima): rax = anwani ya chanzo (RHS
        ; ya muundo hutoa anwani). Kwa paramu kwa rejea, sloti ina
        ; kielekezi — lengwa ni [kielekezi], si sloti yenyewe.
        linganisha n32[local_kwa_rejea + r10*4], 0
        ruka .as_muundo_lengwa_lea kama ==
        ; lea rdi, [rbp+disp32] hapo chini inabadilishwa: kwa rejea,
        ; mov rdi, [rbp+disp32] (48 8B BD d32) — pakia kielekezi
        sukuma r11
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        r13d = r7d   ; hifadhi ofseti hasi
        r0b = 0x48   ; mov rdi, [rbp+disp32]
        ita gen_baiti
        r0b = 0x8B
        ita gen_baiti
        r0b = 0xBD
        ita gen_baiti
        r7d = r13d
        ita gen_neno4
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        vuta r11
        ruka .as_muundo_nakili
.as_muundo_lengwa_lea:
        ; lea rdi, [rbp+disp32] — 48 8D BD d32
        sukuma r11
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        r13d = r7d
        r0b = 0x48
        ita gen_baiti
        r0b = 0x8D
        ita gen_baiti
        r0b = 0xBD
        ita gen_baiti
        r7d = r13d
        ita gen_neno4
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        vuta r11
.as_muundo_nakili:
        ; mov rsi, rax (48 89 C6) — chanzo (anwani ya muundo)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xC6
        ita gen_baiti
        ; mov ecx, ukubwa wa muundo (B9 d32)
        r0b = 0xB9
        ita gen_baiti
        r11d = n32[local_muundo_id + r10*4]
        linganisha r11d, 0
        ruka .as_muundo_ukubwa_8 kama <n
        linganisha r11d, n32[muundo_count]
        ruka .as_muundo_ukubwa_8 kama >=a
        r11d = n32[muundo_ukubwa + r11*4]
        ruka .as_muundo_ukubwa_iko
.as_muundo_ukubwa_8:
        r11d = 8
.as_muundo_ukubwa_iko:
        r7d = r11d
        ita gen_neno4
        ; rep movsb (F3 A4)
        r0b = 0xF3
        ita gen_baiti
        r0b = 0xA4
        ita gen_baiti
        r0d = r8d
        ruka .done
.as_local_store_8:
        r0b = 0x88   ; mov [rbp+disp32], al
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        ita gen_neno4
        ruka .as_local_store_done
.as_local_store_16:
        r0b = 0x66   ; mov [rbp+disp32], ax
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        ita gen_neno4
        ruka .as_local_store_done
.as_local_store_64:
        r0b = 0x48   ; mov [rbp+disp32], rax
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        ita gen_neno4
.as_local_store_done:
        r0d = r8d   ; rudisha thamani iliyowekwa
        ruka .done

        ; Kigezo hakikupatikana ndani — tafuta kati ya vigezo vya ulimwengu
.as_global_search:
        r10d ^= r10d
.as_global_search_loop:
        linganisha r10, n64[global_count]
        ruka .assign_err kama >=a
        r7 = n64[global_name + r10*8]
        r6 = r9
        sukuma r8
        sukuma r9
        sukuma r10
        sukuma r11
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        ita linganisha_mfuatano
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        vuta r11
        vuta r10
        vuta r9
        vuta r8
        pima r0d, r0d
        ruka .as_found_global kama ==
        r10++
        ruka .as_global_search_loop

.as_found_global:
        ; Kigezo cha ulimwengu — hifadhi kwa [rip+disp32]
        linganisha n32[global_is_array + r10*4], 0
        ruka .assign_err kama !=   ; safu bila faharisi — si lvalue
        r15d = n32[global_star_count + r10*4]
        linganisha r15d, 0
        ruka .as_store_64 kama >n   ; pointer — baiti 8
        r15d = n32[global_base_type + r10*4]
        linganisha r15d, 1
        ruka .as_store_8 kama ==
        linganisha r15d, 2
        ruka .as_store_16 kama ==
        linganisha r15d, 4
        ruka .as_store_64 kama ==
        linganisha r15d, 5
        ruka .as_store_64 kama ==
        linganisha r15d, 7
        ruka .as_store_d64 kama ==
        ; N32 (3) au chaguo-msingi
        r0b = 0x89   ; mov [rip+disp32], eax
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ruka .as_global_reloc

.as_store_d64:
        ; D64 — movsd [rip+disp32], xmm0 -> f2 0f 11 05 d32
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x11
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ruka .as_global_reloc

.as_store_8:
        r0b = 0x88   ; mov [rip+disp32], al
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ruka .as_global_reloc

.as_store_16:
        r0b = 0x66   ; mov [rip+disp32], ax
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ruka .as_global_reloc

.as_store_64:
        r0b = 0x48   ; mov [rip+disp32], rax
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti

.as_global_reloc:
        ; Ongeza rekebisho la R_X86_64_PC32 kwa kigezo cha ulimwengu
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .as_rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        r0d = r10d
        r0d += 2
        r0d = -r0d
        n32[rela_sym + r7*4] = r0d
        n32[rela_addend + r7*4] = -4
        n64[rela_count]++
.as_skip_global_reloc:
        ; Weka nafasi ya disp32 (baiti 4 za sifuri)
        r7d = 0
        ita gen_neno4
        r0d = r8d   ; rudisha thamani iliyowekwa
        ruka .done
.as_rela_jaa:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_rela_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

        ; Nodi ya KIELELEZO — hifadhi kwa [msingi + faharisi * ukubwa]
.assign_kielelezo:
        ; Hifadhi thamani ya upande wa kulia (tayari iko kwenye rax)
        r0b = 0x50   ; push rax — thamani
        ita gen_baiti

        r14d = n32[ast_kulia + r13*4]   ; nodi ya faharisi
        r12d = n32[ast_kushoto + r13*4]   ; nodi ya msingi (pointer)

        ; Amua ukubwa wa kipengele (r15d) — chaguo-msingi: baiti 4 (N32)
        r15d = 4
        n32[ak_kipengele_ni_muundo] = 0
        n32[ak_kipengele_ni_d64] = 0
        r3d = n32[ast_aina + r12*4]
        linganisha r3d, AST_JINA
        ruka .ak_size_done kama !=

        ; Ni AST_JINA — tafuta kwenye orodha ya vigezo vya ndani
        r9d = n32[ast_jina_off + r12*4]
        r9 = &[str_pool + r9]
        r10d ^= r10d
.ak_scan_locals:
        linganisha r10, n64[local_count]
        ruka .ak_scan_globals kama >=a   ; haikupatikana ndani — jaribu ulimwengu
        r7 = n64[local_name + r10*8]
        r6 = r9
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .ak_found_local kama ==
        r10++
        ruka .ak_scan_locals

.ak_scan_globals:
        ; Tafuta kati ya vigezo vya ulimwengu
        r10d ^= r10d
.ak_scan_globals_loop:
        linganisha r10, n64[global_count]
        ruka .ak_size_done kama >=a   ; haikupatikana kabisa — chaguo-msingi
        r7 = n64[global_name + r10*8]
        r6 = r9
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .ak_found_global kama ==
        r10++
        ruka .ak_scan_globals_loop

.ak_found_global:
        ; Safu ya ulimwengu: elementi ya safu ya nyota ina ukubwa 8,
        ; sivyo ukubwa wa aina msingi
        linganisha n32[global_is_array + r10*4], 0
        ruka .ak_found_global_safu kama !=

        ; Sio safu — kama .ak_found_local
        r11d = n32[global_star_count + r10*4]
        linganisha r11d, 0
        ruka .ak_size_done kama ==   ; sio pointer — hali isiyowezekana
        linganisha r11d, 1
        ruka .ak_set_size_8 kama >n   ; nyota >= 2 — ukubwa wa nyota ni 8 (x86-64)
        r11d = n32[global_base_type + r10*4]
        linganisha r11d, 1
        ruka .ak_set_size_1 kama ==
        linganisha r11d, 2
        ruka .ak_set_size_2 kama ==
        linganisha r11d, 4
        ruka .ak_set_size_8 kama ==
        linganisha r11d, 7
        ruka .ak_set_size_8 kama ==
        r15d = 4
        ruka .ak_size_done

.ak_found_global_safu:
        r11d = n32[global_star_count + r10*4]
        linganisha r11d, 0
        ruka .ak_set_size_8 kama >n   ; safu ya nyota — elementi ni pointer
        r11d = n32[global_base_type + r10*4]
        linganisha r11d, 1
        ruka .ak_set_size_1 kama ==
        linganisha r11d, 2
        ruka .ak_set_size_2 kama ==
        linganisha r11d, 4
        ruka .ak_set_size_8 kama ==
        linganisha r11d, 7
        ruka .ak_set_size_8 kama ==
        r15d = 4
        ruka .ak_size_done

.ak_found_local:
        ; Kigeu cha ndani chenye faharisi — pointer au safu ya ndani.
        ; Ukubwa wa elementi: safu -> pointer 8 (nyota >= 1) au aina
        ; msingi (nyota == 0); pointer -> aina msingi (nyota == 1) au
        ; 8 (nyota >= 2). Zamani safu tupu (nyota == 0) iliruka hadi
        ; .ak_size_done na r15d chakavu (4) — N8/N16/N64 zilivunjika.
        r11d = n32[local_array_size + r10*4]
        pima r11d, r11d
        ruka .ak_local_ni_safu kama !=
        ; --- Sio safu (pointer) ---
        r11d = n32[local_star_count + r10*4]
        linganisha r11d, 0
        ruka .ak_size_done kama ==   ; hali isiyowezekana
        linganisha r11d, 1
        ruka .ak_set_size_8 kama >n   ; nyota >= 2
        ruka .ak_local_aina_msingi
.ak_local_ni_safu:
        ; --- Safu ya ndani ---
        r11d = n32[local_star_count + r10*4]
        linganisha r11d, 0
        ruka .ak_set_size_8 kama >n   ; safu ya pointer -> elementi 8
.ak_local_aina_msingi:
        r11d = n32[local_base_type + r10*4]
        linganisha r11d, 1
        ruka .ak_set_size_1 kama ==
        linganisha r11d, 2
        ruka .ak_set_size_2 kama ==
        linganisha r11d, 4
        ruka .ak_set_size_8 kama ==
        linganisha r11d, 6
        ruka .ak_muundo_ukubwa kama ==
        linganisha r11d, 7
        ruka .ak_d64 kama ==
        ; N32 (3) au chaguo-msingi
        r15d = 4
        ruka .ak_size_done

.ak_d64:
        ; Kipengele cha D64: ukubwa wa baiti 8, thamani iko kwenye xmm0
        r15d = 8
        n32[ak_kipengele_ni_d64] = 1
        ruka .ak_size_done

.ak_muundo_ukubwa:
        ; Kipengele cha muundo: ukubwa kutoka jedwali, alama kwa nakili
        r11d = n32[local_muundo_id + r10*4]
        n32[ak_kipengele_ni_muundo] = 1
        linganisha r11d, 0
        ruka .ak_muundo_hakuna kama <n
        linganisha r11d, n32[muundo_count]
        ruka .ak_muundo_hakuna kama >=a
        r15d = n32[muundo_ukubwa + r11*4]
        ruka .ak_size_done
.ak_muundo_hakuna:
        r15d = 8
        ruka .ak_size_done

.ak_set_size_1:
        r15d = 1
        ruka .ak_size_done
.ak_set_size_2:
        r15d = 2
        ruka .ak_size_done
.ak_set_size_8:
        r15d = 8
        ; angukia .ak_size_done

.ak_size_done:
        ; r15d = ukubwa wa kipengele (1, 2, 4, 8, au ukubwa wa muundo)

        ; Tathmini usemi wa faharisi
        sukuma r12   ; hifadhi nodi ya msingi
        sukuma r8
        sukuma r15
        r12d = r14d
        ita uzalishaji_ast   ; eax = thamani ya faharisi
        vuta r15
        vuta r8
        vuta r12   ; rudisha nodi ya msingi

        ; cdqe (48 98) — panua ishara ya faharisi (hasi -> 64-bit hasi)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x98
        ita gen_baiti

        ; push rax — hifadhi faharisi kwenye rafu ya utekelezaji
        r0b = 0x50
        ita gen_baiti

        ; Tathmini usemi wa msingi
        sukuma r8
        sukuma r15
        ita uzalishaji_ast   ; eax = anwani ya msingi (pointer)
        vuta r15
        vuta r8

        ; pop rcx — rudisha faharisi
        r0b = 0x59
        ita gen_baiti

        ; Zidisha faharisi kwa ukubwa wa kipengele
        linganisha r15d, 1
        ruka .ak_no_shift kama ==
        linganisha r15d, 2
        ruka .ak_shift_1 kama ==
        linganisha r15d, 4
        ruka .ak_shift_2 kama ==
        linganisha r15d, 8
        ruka .ak_shift_3 kama ==
        ; Ukubwa mwingine (muundo wa baiti 12, 20, ...) — imul rcx, rcx, imm32
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x69   ; imul r/m64, r64, imm32
        ita gen_baiti
        r0b = 0xC9   ; ModRM: r/m=rcx, reg=rcx
        ita gen_baiti
        r7d = r15d
        ita gen_neno4
        ruka .ak_do_add

.ak_shift_2:
        ; shift_2 (kwa N32, ukubwa 4)
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0xC1   ; shl r/m64, imm8
        ita gen_baiti
        r0b = 0xE1   ; ModRM: r/m=rcx, reg=4(shl)
        ita gen_baiti
        r0b = 2   ; shl rcx, 2
        ita gen_baiti
        ruka .ak_do_add

.ak_shift_1:
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0b = 0xE1
        ita gen_baiti
        r0b = 1   ; shl rcx, 1
        ita gen_baiti
        ruka .ak_do_add

.ak_shift_3:
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0b = 0xE1
        ita gen_baiti
        r0b = 3   ; shl rcx, 3
        ita gen_baiti

.ak_do_add:
.ak_no_shift:
        ; add rax, rcx -> 48 01 C8
        r0b = 0x48   ; REX.W
        ita gen_baiti
        r0b = 0x01   ; add r/m64, r64
        ita gen_baiti
        r0b = 0xC8   ; ModRM: r/m=rax, reg=rcx
        ita gen_baiti

        ; pop rcx — rudisha thamani
        r0b = 0x59
        ita gen_baiti

        ; Hifadhi [rax], rcx kulingana na ukubwa
        linganisha n32[ak_kipengele_ni_muundo], 1
        ruka .ak_store_muundo kama ==
        linganisha n32[ak_kipengele_ni_d64], 1
        ruka .ak_store_d64 kama ==
        linganisha r15d, 1
        ruka .ak_store_8 kama ==
        linganisha r15d, 2
        ruka .ak_store_16 kama ==
        linganisha r15d, 8
        ruka .ak_store_64 kama ==

        ; N32: mov [rax], ecx -> 89 08
        r0b = 0x89
        ita gen_baiti
        r0b = 0x08   ; ModRM: [rax], reg=ecx
        ita gen_baiti
        r0d = r8d   ; rudisha thamani iliyowekwa
        ruka .done

.ak_store_d64:
        ; D64 — movsd [rax], xmm0 -> f2 0f 11 00 (thamani iko xmm0)
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x11
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        r0d = r8d   ; rudisha thamani iliyowekwa
        ruka .done

.ak_store_muundo:
        ; Nakili muundo mzima: rdi = lengwa (rax), rsi = chanzo (rcx)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xC7   ; mov rdi, rax
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xCE   ; mov rsi, rcx
        ita gen_baiti
        r0b = 0xB9   ; mov ecx, ukubwa
        ita gen_baiti
        r7d = r15d
        ita gen_neno4
        r0b = 0xF3
        ita gen_baiti
        r0b = 0xA4   ; rep movsb
        ita gen_baiti
        r0d = r8d
        ruka .done

.ak_store_8:
        ; mov [rax], cl -> 88 08
        r0b = 0x88
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
        r0d = r8d
        ruka .done

.ak_store_16:
        ; mov [rax], cx -> 66 89 08
        r0b = 0x66
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
        r0d = r8d
        ruka .done

.ak_store_64:
        ; mov [rax], rcx -> 48 89 08
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
        r0d = r8d
        ruka .done

        ; Nodi ya NYOTA_ELEKEZA — hifadhi kupitia pointer
.assign_nyota:
        ; Hifadhi thamani ya upande wa kulia (tayari iko kwenye rax)
        r0b = 0x50   ; push rax — thamani
        ita gen_baiti

        r12d = n32[ast_kushoto + r13*4]   ; nodi ya mtoto (pointer)

        ; Amua ukubwa wa kipengele (r15d) — chaguo-msingi: baiti 4 (N32)
        r15d = 4
        n32[ak_kipengele_ni_muundo] = 0
        n32[ak_kipengele_ni_d64] = 0
        r3d = n32[ast_aina + r12*4]
        linganisha r3d, AST_JINA
        ruka .an_size_done kama !=

        ; Ni AST_JINA — tafuta kwenye orodha ya vigezo vya ndani
        r9d = n32[ast_jina_off + r12*4]
        r9 = &[str_pool + r9]
        r10d ^= r10d
.an_scan_locals:
        linganisha r10, n64[local_count]
        ruka .an_scan_globals kama >=a   ; haikupatikana ndani — jaribu ulimwengu
        r7 = n64[local_name + r10*8]
        r6 = r9
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .an_found_local kama ==
        r10++
        ruka .an_scan_locals

.an_scan_globals:
        ; Tafuta kati ya vigezo vya ulimwengu
        r10d ^= r10d
.an_scan_globals_loop:
        linganisha r10, n64[global_count]
        ruka .an_size_done kama >=a   ; haikupatikana kabisa — chaguo-msingi
        r7 = n64[global_name + r10*8]
        r6 = r9
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .an_found_global kama ==
        r10++
        ruka .an_scan_globals_loop

.an_found_local:
        ; Kigezo cha ndani — pointer ikiwa star_count > 0
        r11d = n32[local_star_count + r10*4]
        linganisha r11d, 0
        ruka .an_size_done kama ==   ; sio pointer — chaguo-msingi N32
        ; Kielekezi-kiwili (*q = ...): lengwa ni kielekezi — baiti 8
        linganisha r11d, 1
        ruka .an_set_size_8 kama >a
        r11d = n32[local_base_type + r10*4]
        linganisha r11d, 1
        ruka .an_set_size_1 kama ==
        linganisha r11d, 2
        ruka .an_set_size_2 kama ==
        linganisha r11d, 4
        ruka .an_set_size_8 kama ==
        linganisha r11d, 5
        ruka .an_set_size_8 kama ==
        linganisha r11d, 6
        ruka .an_muundo_ukubwa kama ==
        linganisha r11d, 7
        ruka .an_d64 kama ==
        r15d = 4
        ruka .an_size_done

.an_d64:
        ; D64* — kipengele ni D64: ukubwa wa baiti 8, thamani iko xmm0
        r15d = 8
        n32[ak_kipengele_ni_d64] = 1
        ruka .an_size_done

.an_muundo_ukubwa:
        ; *p = muundo: ukubwa kutoka jedwali, alama kwa nakili
        r11d = n32[local_muundo_id + r10*4]
        n32[ak_kipengele_ni_muundo] = 1
        linganisha r11d, 0
        ruka .an_muundo_hakuna kama <n
        linganisha r11d, n32[muundo_count]
        ruka .an_muundo_hakuna kama >=a
        r15d = n32[muundo_ukubwa + r11*4]
        ruka .an_size_done
.an_muundo_hakuna:
        r15d = 8
        ruka .an_size_done

.an_found_global:
        ; Kigezo cha ulimwengu — pointer au safu ni anwani, tumia aina msingi
        r11d = n32[global_star_count + r10*4]
        linganisha r11d, 0
        ruka .an_global_base kama >n   ; pointer — tumia aina msingi
        ; Kielekezi-kiwili cha ulimwengu (*gq = ...): baiti 8 (9.2)
        ; — angalia tena kabla ya .an_global_base kutumia aina msingi
        linganisha r11d, 1
        ruka .an_global_kielekezi_kiwili kama >a
        ruka .an_size_done
.an_global_kielekezi_kiwili:
        r11d = n32[global_star_count + r10*4]
        ruka .an_set_size_8
        linganisha n32[global_is_array + r10*4], 0
        ruka .an_global_base kama !=   ; safu — anwani, tumia aina msingi
        r15d = 4
        ruka .an_size_done   ; kigeu rahisi — chaguo-msingi

.an_global_base:
        r11d = n32[global_base_type + r10*4]
        linganisha r11d, 1
        ruka .an_set_size_1 kama ==
        linganisha r11d, 2
        ruka .an_set_size_2 kama ==
        linganisha r11d, 4
        ruka .an_set_size_8 kama ==
        linganisha r11d, 5
        ruka .an_set_size_8 kama ==
        r15d = 4
        ruka .an_size_done

.an_set_size_1:
        r15d = 1
        ruka .an_size_done
.an_set_size_2:
        r15d = 2
        ruka .an_size_done
.an_set_size_8:
        r15d = 8
        ; angukia .an_size_done

.an_size_done:
        ; Tathmini usemi wa pointer
        sukuma r8
        sukuma r15
        ita uzalishaji_ast   ; eax = anwani (pointer)
        vuta r15
        vuta r8

        ; pop rcx — rudisha thamani
        r0b = 0x59
        ita gen_baiti

        ; Hifadhi [rax], rcx kulingana na ukubwa
        linganisha n32[ak_kipengele_ni_muundo], 1
        ruka .an_store_muundo kama ==
        linganisha n32[ak_kipengele_ni_d64], 1
        ruka .an_store_d64 kama ==
        linganisha r15d, 1
        ruka .an_store_8 kama ==
        linganisha r15d, 2
        ruka .an_store_16 kama ==
        linganisha r15d, 8
        ruka .an_store_64 kama ==

        ; N32: mov [rax], ecx -> 89 08
        r0b = 0x89
        ita gen_baiti
        r0b = 0x08   ; ModRM: [rax], reg=ecx
        ita gen_baiti
        r0d = r8d   ; rudisha thamani iliyowekwa
        ruka .done

.an_store_d64:
        ; D64 — movsd [rax], xmm0 -> f2 0f 11 00 (thamani iko xmm0)
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x11
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        r0d = r8d   ; rudisha thamani iliyowekwa
        ruka .done

.an_store_muundo:
        ; Nakili muundo mzima: rdi = lengwa (rax), rsi = chanzo (rcx)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xC7   ; mov rdi, rax
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xCE   ; mov rsi, rcx
        ita gen_baiti
        r0b = 0xB9   ; mov ecx, ukubwa
        ita gen_baiti
        r7d = r15d
        ita gen_neno4
        r0b = 0xF3
        ita gen_baiti
        r0b = 0xA4   ; rep movsb
        ita gen_baiti
        r0d = r8d
        ruka .done

.an_store_8:
        ; mov [rax], cl -> 88 08
        r0b = 0x88
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
        r0d = r8d
        ruka .done

.an_store_16:
        ; mov [rax], cx -> 66 89 08
        r0b = 0x66
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
        r0d = r8d
        ruka .done

.an_store_64:
        ; mov [rax], rcx -> 48 89 08
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
        r0d = r8d
        ruka .done

        ; Uwekaji wa mwanachama wa muundo — m.chanzo = ... au p->inayofuata = ...
.assign_mwanachama:
        ; Hifadhi thamani ya upande wa kulia (tayari iko kwenye rax)
        r0b = 0x50   ; push rax — thamani
        ita gen_baiti

        ; Amua aina ya mwanachama kwa wakati wa kukusanya
        sukuma r8
        sukuma r13
        sukuma r14
        sukuma r15
        r12d = r13d
        ita fumbua_aina   ; eax=aina, ebx=nyota, edx=muundo
        r9d = r0d   ; aina ya msingi
        r10d = r3d   ; idadi ya nyota
        r11d = r2d   ; id ya muundo (-1 ikiwa si muundo)
        vuta r15
        vuta r14
        vuta r13
        vuta r8

        ; Nakala ya muundo mzima? (aina 6, bila nyota)
        linganisha r9d, 6
        ruka .am_kawaida kama !=
        linganisha r10d, 0
        ruka .am_nakala kama ==

.am_kawaida:
        ; Tathmini anwani ya mwanachama (matokeo kwenye rax)
        sukuma r8
        sukuma r9
        sukuma r10
        sukuma r13
        sukuma r15
        r12d = r13d
        ita uzalishaji_anwani_ya_nodi   ; rax = anwani ya mwanachama
        vuta r15
        vuta r13
        vuta r10
        vuta r9
        vuta r8

        ; pop rcx — rudisha thamani kutoka kwenye rafu
        r0b = 0x59
        ita gen_baiti

        ; Hifadhi [rax], rcx kulingana na ukubwa wa aina
        linganisha r10d, 0
        ruka .am_store_64 kama >n   ; pointer — baiti 8
        linganisha r9d, 7
        ruka .am_store_d64 kama ==
        linganisha r9d, 1
        ruka .am_store_8 kama ==
        linganisha r9d, 2
        ruka .am_store_16 kama ==
        linganisha r9d, 4
        ruka .am_store_64 kama ==
        linganisha r9d, 5
        ruka .am_store_64 kama ==
        ; N32: mov [rax], ecx -> 89 08
        r0b = 0x89
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
        r0d = r8d
        ruka .done

.am_store_8:
        ; mov [rax], cl -> 88 08
        r0b = 0x88
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
        r0d = r8d
        ruka .done

.am_store_16:
        ; mov [rax], cx -> 66 89 08
        r0b = 0x66
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
        r0d = r8d
        ruka .done

.am_store_64:
        ; mov [rax], rcx -> 48 89 08
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
        r0d = r8d
        ruka .done

.am_store_d64:
        ; movsd [rax], xmm0 -> f2 0f 11 00
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x11
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        r0d = r8d
        ruka .done

.am_nakala:
        ; Nakala ya muundo mzima: chanzo (anwani) iko kwenye rafu,
        ; lengo ni anwani ya mwanachama
        sukuma r8
        sukuma r11
        sukuma r13
        sukuma r15
        r12d = r13d
        ita uzalishaji_anwani_ya_nodi   ; rax = anwani ya lengo
        vuta r15
        vuta r13
        vuta r11
        vuta r8

        ; mov rdi, rax — lengo
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xC7
        ita gen_baiti
        ; pop rsi — chanzo
        r0b = 0x5E
        ita gen_baiti
        ; mov ecx, ukubwa wa muundo
        r0b = 0xB9
        ita gen_baiti
        r7d = n32[muundo_ukubwa + r11*4]
        ita gen_neno4
        ; rep movsb
        r0b = 0xF3
        ita gen_baiti
        r0b = 0xA4
        ita gen_baiti
        r0d = r8d
        ruka .done

.assign_err:
        ; Uwekaji usiotumika — arifu na usitishe
        r7 = &[msg_assignerr]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.do_string:
        ; r13d = -1 (kiashiria cha mfuatano)
        ; r14d = -1 (haitumiki)
        ; r15d = urefu wa baiti (pamoja na '\0')
        ; r12d = faharisi ya nodi ya AST

        sukuma r6
        sukuma r7
        sukuma r1

        r8d = n32[ast_jina_off + r12*4]   ; ofseti ya mfuatano kwenye str_pool
        r9d = r15d   ; urefu wa baiti

        ; Nakili mfuatano kutoka str_pool hadi data_buf
        r1 = n64[data_buf_pos]
        r10d = r1d   ; hifadhi ofseti kwa addend
        r1d = r9d
        r6 = str_pool
        r6 += r8
        r7 = &[data_buf + r10]
        mwelekeo_mbele
        nakili
        r1 = r9
        n64[data_buf_pos] += r1

        vuta r1
        vuta r7
        vuta r6

        ; LEA RAX, [RIP + disp32] — pakia anwani ya mfuatano
        ; 48 8d 05 XX XX XX XX
        r0b = 0x48
        ita gen_baiti
        r0b = 0x8d
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti

        ; Ongeza rekebisho la .data
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .string_rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        n32[rela_sym + r7*4] = -1   ; kiashiria: tumia .data section
        r10d -= 4
        n32[rela_addend + r7*4] = r10d   ; addend = data_offset - 4
        n64[rela_count]++
.skip_string_reloc:
        ; Weka nafasi ya disp32 (baiti 4 za sifuri)
        r7d = 0
        ita gen_neno4
        ruka .string_rela_endelea
.string_rela_jaa:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_rela_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.string_rela_endelea:

        ; Ulinganisho wa mifuatano hauwezi kukunjwa wakati wa kukusanya
        r0d = -1
        ruka .done
.do_and_sc:
        ; && kwa mzunguko mfupi:
        ;   kushoto; test; je si_kweli; kulia; test; je si_kweli;
        ;   mov eax,1; jmp mwisho; si_kweli: mov eax,0; mwisho:
        sukuma r12
        r12d = r13d   ; kushoto
        ita uzalishaji_ast
        vuta r12
        r8d = r0d   ; CT ya kushoto

        ; test eax, eax -> 85 c0
        r0b = 0x85
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; je -> 0f 84 + kishikilia
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r9d = n32[text_buf_pos]   ; fixup 1: baada ya kushoto
        r7d ^= r7d
        ita gen_neno4

        sukuma r8   ; CT ya kushoto
        sukuma r9   ; fixup 1
        sukuma r12
        r12d = r14d   ; kulia
        ita uzalishaji_ast
        vuta r12
        vuta r9
        vuta r8
        r10d = r0d   ; CT ya kulia

        ; test eax, eax
        r0b = 0x85
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; je -> 0f 84 + kishikilia
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r11d = n32[text_buf_pos]   ; fixup 2: baada ya kulia
        r7d ^= r7d
        ita gen_neno4

        ; mov eax, 1 -> b8 01 00 00 00
        r0b = 0xb8
        ita gen_baiti
        r7d = 1
        ita gen_neno4
        ; jmp -> e9 + kishikilia
        r0b = 0xe9
        ita gen_baiti
        r15d = n32[text_buf_pos]   ; fixup 3: jmp ya mwisho
        r7d ^= r7d
        ita gen_neno4

        ; Rekebisha fixup 1 na 2: elekeza kwenye si_kweli (hapa)
        r7d = n32[text_buf_pos]
        r7d -= r9d
        r7d -= 4
        r0d = n32[text_buf_pos]   ; hifadhi nafasi ya sasa
        n32[text_buf_pos] = r9d
        ita gen_neno4
        n32[text_buf_pos] = r0d
        r7d = n32[text_buf_pos]
        r7d -= r11d
        r7d -= 4
        r0d = n32[text_buf_pos]
        n32[text_buf_pos] = r11d
        ita gen_neno4
        n32[text_buf_pos] = r0d

        ; si_kweli: mov eax, 0 -> b8 00 00 00 00
        r0b = 0xb8
        ita gen_baiti
        r7d ^= r7d
        ita gen_neno4

        ; Rekebisha fixup 3: jmp ya mwisho -> hapa (mwisho)
        r7d = n32[text_buf_pos]
        r7d -= r15d
        r7d -= 4
        r0d = n32[text_buf_pos]
        n32[text_buf_pos] = r15d
        ita gen_neno4
        n32[text_buf_pos] = r0d

        ; CT: kushoto ni 0 -> 0; kushoto si 0 -> (kulia si 0 -> 1, sivyo 0)
        linganisha r8d, -1
        ruka .and_ct_isiyojulikana kama ==
        pima r8d, r8d
        ruka .and_ct_sifuri kama ==
        linganisha r10d, -1
        ruka .and_ct_isiyojulikana kama ==
        pima r10d, r10d
        ruka .and_ct_sifuri kama ==
        r0d = 1
        ruka .done
.and_ct_sifuri:
        r0d ^= r0d
        ruka .done
.and_ct_isiyojulikana:
        r0d = -1
        ruka .done
.do_or_sc:
        ; || kwa mzunguko mfupi:
        ;   kushoto; test; jne kweli; kulia; test; jne kweli;
        ;   mov eax,0; jmp mwisho; kweli: mov eax,1; mwisho:
        sukuma r12
        r12d = r13d   ; kushoto
        ita uzalishaji_ast
        vuta r12
        r8d = r0d   ; CT ya kushoto

        ; test eax, eax -> 85 c0
        r0b = 0x85
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; jne -> 0f 85 + kishikilia
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        r9d = n32[text_buf_pos]   ; fixup 1: baada ya kushoto
        r7d ^= r7d
        ita gen_neno4

        sukuma r8   ; CT ya kushoto
        sukuma r9   ; fixup 1
        sukuma r12
        r12d = r14d   ; kulia
        ita uzalishaji_ast
        vuta r12
        vuta r9
        vuta r8
        r10d = r0d   ; CT ya kulia

        ; test eax, eax
        r0b = 0x85
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; jne -> 0f 85 + kishikilia
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        r11d = n32[text_buf_pos]   ; fixup 2: baada ya kulia
        r7d ^= r7d
        ita gen_neno4

        ; mov eax, 0 -> b8 00 00 00 00
        r0b = 0xb8
        ita gen_baiti
        r7d ^= r7d
        ita gen_neno4
        ; jmp -> e9 + kishikilia
        r0b = 0xe9
        ita gen_baiti
        r15d = n32[text_buf_pos]   ; fixup 3: jmp ya mwisho
        r7d ^= r7d
        ita gen_neno4

        ; Rekebisha fixup 1 na 2: elekeza kwenye kweli (hapa)
        r7d = n32[text_buf_pos]
        r7d -= r9d
        r7d -= 4
        r0d = n32[text_buf_pos]   ; hifadhi nafasi ya sasa
        n32[text_buf_pos] = r9d
        ita gen_neno4
        n32[text_buf_pos] = r0d
        r7d = n32[text_buf_pos]
        r7d -= r11d
        r7d -= 4
        r0d = n32[text_buf_pos]
        n32[text_buf_pos] = r11d
        ita gen_neno4
        n32[text_buf_pos] = r0d

        ; kweli: mov eax, 1 -> b8 01 00 00 00
        r0b = 0xb8
        ita gen_baiti
        r7d = 1
        ita gen_neno4

        ; Rekebisha fixup 3: jmp ya mwisho -> hapa (mwisho)
        r7d = n32[text_buf_pos]
        r7d -= r15d
        r7d -= 4
        r0d = n32[text_buf_pos]
        n32[text_buf_pos] = r15d
        ita gen_neno4
        n32[text_buf_pos] = r0d

        ; CT: kushoto si 0 -> 1; kushoto ni 0 -> (kulia si 0 -> 1, sivyo 0)
        linganisha r8d, -1
        ruka .or_ct_isiyojulikana kama ==
        pima r8d, r8d
        ruka .or_ct_moja kama !=
        linganisha r10d, -1
        ruka .or_ct_isiyojulikana kama ==
        pima r10d, r10d
        ruka .or_ct_moja kama !=
        r0d ^= r0d
        ruka .done
.or_ct_moja:
        r0d = 1
        ruka .done
.or_ct_isiyojulikana:
        r0d = -1
        ruka .done

; -----------------------------------------------------------
; Njia za hesabu za kuelea (D64) — xmm0/xmm1
; -----------------------------------------------------------
.fl_rhs:
        ; Tathmini kulia → xmm0; hifadhi kwenye rafu kama baiti 8.
        sukuma r12
        sukuma r15
        r12d = r14d
        ita uzalishaji_ast
        vuta r15
        vuta r12
        ; Kamili → D64 (8.6): cvtsi2sd kabla ya movq — operesheni
        ; mchanganyiko kama 5.5 * 2 inapandisha 2 hadi 2.0.
        sukuma r12
        r12d = r14d
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .fl_rhs_kulia_d64 kama ==
        linganisha r0d, 4
        ruka .fl_rhs_kulia_64 kama ==
        ; cvtsi2sd xmm0, eax → F2 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .fl_rhs_kulia_iko
.fl_rhs_kulia_64:
        ; cvtsi2sd xmm0, rax → F2 48 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
.fl_rhs_kulia_iko:
        ; movq rax, xmm0 -> 66 48 0F 7E C0 ; push rax -> 50
        r0b = 0x66
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x7E
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        r0b = 0x50
        ita gen_baiti
        ; Tathmini kushoto → xmm0.
        sukuma r12
        sukuma r15
        r12d = r13d
        ita uzalishaji_ast
        vuta r15
        vuta r12
        ; Kamili → D64 kwa kushoto (8.6)
        sukuma r12
        r12d = r13d
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .fl_rhs_kushoto_d64 kama ==
        linganisha r0d, 4
        ruka .fl_rhs_kushoto_64 kama ==
        ; cvtsi2sd xmm0, eax → F2 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .fl_rhs_kushoto_iko
.fl_rhs_kushoto_64:
        ; cvtsi2sd xmm0, rax → F2 48 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
.fl_rhs_kushoto_iko:
        ; pop rcx -> 59 ; movq xmm1, rcx -> 66 48 0F 6E C9
        r0b = 0x59
        ita gen_baiti
        r0b = 0x66
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x6E
        ita gen_baiti
        r0b = 0xC9
        ita gen_baiti
        rudi
.fl_rhs_kulia_d64:
        ; movq rax, xmm0 -> 66 48 0F 7E C0 ; push rax -> 50
        r0b = 0x66
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x7E
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        r0b = 0x50
        ita gen_baiti
        ; Tathmini kushoto → xmm0.
        sukuma r12
        sukuma r15
        r12d = r13d
        ita uzalishaji_ast
        vuta r15
        vuta r12
        ; Kamili → D64 kwa kushoto (8.6)
        sukuma r12
        r12d = r13d
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .fl_rhs_kushoto_d64 kama ==
        linganisha r0d, 4
        ruka .fl_rhs_kushoto_64 kama ==
        ; cvtsi2sd xmm0, eax → F2 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .fl_rhs_kushoto_iko
.fl_rhs_kushoto_d64:
        ; pop rcx -> 59 ; movq xmm1, rcx -> 66 48 0F 6E C9
        r0b = 0x59
        ita gen_baiti
        r0b = 0x66
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x6E
        ita gen_baiti
        r0b = 0xC9
        ita gen_baiti
        rudi

.fl_add:
        ita .fl_rhs
        ; addsd xmm0, xmm1 -> f2 0f 58 c1
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x58
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0d = -1
        ruka .done
.fl_sub:
        ita .fl_rhs
        ; subsd xmm0, xmm1 -> f2 0f 5c c1
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x5C
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0d = -1
        ruka .done
.fl_mul:
        ita .fl_rhs
        ; mulsd xmm0, xmm1 -> f2 0f 59 c1
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x59
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0d = -1
        ruka .done
.fl_div:
        ita .fl_rhs
        ; divsd xmm0, xmm1 -> f2 0f 5e c1
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x5E
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0d = -1
        ruka .done
.fl_eq:
        ita .fl_rhs
        ; ucomisd xmm0, xmm1 -> 66 0f 2e c1
        r0b = 0x66
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2E
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        ; sete al -> 0f 94 c0 ; movzx eax, al -> 0f b6 c0
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x94
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xB6
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .done
.fl_ne:
        ita .fl_rhs
        r0b = 0x66
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2E
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        ; setne al -> 0f 95 c0
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x95
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xB6
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .done
.fl_lt:
        ita .fl_rhs
        r0b = 0x66
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2E
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        ; setb al -> 0f 92 c0 (xmm0 < xmm1)
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x92
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xB6
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .done
.fl_le:
        ita .fl_rhs
        r0b = 0x66
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2E
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        ; setbe al -> 0f 96 c0
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x96
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xB6
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .done
.fl_gt:
        ita .fl_rhs
        r0b = 0x66
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2E
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        ; seta al -> 0f 97 c0 (xmm0 > xmm1)
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x97
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xB6
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .done
.fl_ge:
        ita .fl_rhs
        r0b = 0x66
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2E
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        ; setae al -> 0f 93 c0
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x93
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xB6
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .done
.done:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_wambile: zalisha msimbo kwa wito wa kazi
;   r12d = faharisi ya nodi
;   matokeo kwenye eax
; -------------------------------------------------------
uzalishaji_wambile:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        sukuma n64[hoja_d64]
        sukuma n64[hoja_d64 + 8]
        sukuma n64[hoja_reg]
        sukuma n64[hoja_reg + 8]
        sukuma n64[hoja_gp]
        sukuma n64[hoja_xmm]
        sukuma 0   ; [rsp] = alama ya mwitaji (wito wa kielekezi)

        r12d = r12d
        r13d = n32[ast_kulia + r12*4]   ; nodi ya mwitaji (jina la kazi au la kigezo)
        r14d = n32[ast_kushoto + r12*4]   ; orodha ya hoja

        ; --- Wito wa kielekezi? ---
        ; Mwitaji ni KIGEZO (cha ndani au cha ulimwengu) chenye aina ya
        ; N64 au kielekezi (nyota) — kigezo kama hicho hushikilia ANWANI
        ; ya kazi isiyo na saini (vipimo vya lugha 4.3). Hoja hupangwa
        ; kwa aina zao wenyewe (D64 → xmm, nyingine → GP), na wito
        ; wenyewe ni "call r11" (anwani katika r11). Hakuna ukaguzi wa
        ; idadi wala ubadilishaji wa hoja: jina la kigezo litakosa kwenye
        ; func_ret (faharisi -1) na hoja zitapita kama za mkia wa
        ; kutofautiana.
        ; [rsp] = 0 kazi moja kwa moja, 1 kigezo cha ndani (data = ofseti
        ; chanya ya sloti), 2 kigezo cha ulimwengu (data = faharisi yake).
        r8d ^= r8d
        linganisha n32[ast_aina + r13*4], AST_JINA
        ruka .wito_mwitaji_iko kama !=   ; si jina rahisi — njia ya zamani
        r9d = n32[ast_jina_off + r13*4]
        r9 = &[str_pool + r9]   ; anwani ya jina la mwitaji
        r10d ^= r10d
.wk_skan_ndani:
        linganisha r10, n64[local_count]
        ruka .wk_skan_ulimwengu kama >=a
        r7 = n64[local_name + r10*8]
        r6 = r9
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .wk_ndani_ipo kama ==
        r10++
        ruka .wk_skan_ndani
.wk_ndani_ipo:
        ; Kigezo cha ndani: N64 au kielekezi (nyota) ndicho kinachoweza
        ; kuitwa; safu na aina nyingine zinarudi kwenye njia ya zamani
        linganisha n32[local_array_size + r10*4], 0
        ruka .wito_mwitaji_iko kama !=
        r11d = n32[local_star_count + r10*4]
        linganisha r11d, 0
        ruka .wk_ndani_kazi kama >n
        linganisha n32[local_base_type + r10*4], 4   ; N64
        ruka .wito_mwitaji_iko kama !=
.wk_ndani_kazi:
        r8d = 1
        r0d = n32[local_offset + r10*4]   ; ofseti chanya ya sloti
        r11d = r0d
        ruka .wk_kigezo_ipo
.wk_skan_ulimwengu:
        r10d ^= r10d
.wk_skan_ulimwengu_loop:
        linganisha r10, n64[global_count]
        ruka .wito_mwitaji_iko kama >=a
        r7 = n64[global_name + r10*8]
        r6 = r9
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .wk_ulimwengu_ipo kama ==
        r10++
        ruka .wk_skan_ulimwengu_loop
.wk_ulimwengu_ipo:
        linganisha n32[global_is_array + r10*4], 0
        ruka .wito_mwitaji_iko kama !=
        r11d = n32[global_star_count + r10*4]
        linganisha r11d, 0
        ruka .wk_ulimwengu_kazi kama >n
        linganisha n32[global_base_type + r10*4], 4   ; N64
        ruka .wito_mwitaji_iko kama !=
.wk_ulimwengu_kazi:
        r8d = 2
        r11d = r10d   ; faharisi ya ulimwengu
.wk_kigezo_ipo:
        n32[r4] = r8d
        n32[r4+4] = r11d
        ; Kuanguka: jina la mwitaji linabaki (kigezo) — func_ret inakosa
.wito_mwitaji_iko:
        ; Pata jina la kazi (mwitaji ni jina la kazi moja kwa moja)
        r13d = n32[ast_jina_off + r13*4]
        r13 = &[str_pool + r13]
.wito_jina_iko:

        ; Hesabu idadi ya hoja
        r15d ^= r15d
        r8d = r14d
.count_args:
        linganisha r8d, -1
        ruka .count_iko kama ==
        r15d++
        r8d = n32[ast_nne + r8*4]
        ruka .count_args

.count_iko:
        ; --- Ukaguzi wa idadi ya hoja (8.16) ---
        ; Tafuta kazi kwenye jedwali la func_ret_* (r13 = jina).
        ; Faharisi inahifadhiwa kwenye rafu kwa ukaguzi wa vigezo
        ; (8.15) na mpaka wa D64 kwenye hoja (8.6); -1 ikiwa kazi
        ; haijulikani (nje au builtin).
        ; Wito wa KIELEKEZI hauna saini (4.3): ruka utafutaji huu —
        ; faharisi -1 inatosha (hoja zina aina zao wenyewe, hakuna
        ; ukaguzi wa idadi). Muhimu: jina la kigezo cha ulimwengu
        ; linaweza kuwa kwenye func_ret kama kumbukumbu ya jaribio
        ; la changanua_kazi — ukaguzi wa idadi ungekosea.
        linganisha n32[r4], 0
        ruka .hoja_idadi_kielekezi kama !=
        r8d ^= r8d
        r9d = -1
.hoja_idadi_skan:
        linganisha r8, n64[func_ret_count]
        ruka .hoja_idadi_acha kama >=a
        r7 = n64[func_ret_name + r8*8]
        r6 = r13
        sukuma r8
        sukuma r9
        sukuma r10
        sukuma r11
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        ita linganisha_mfuatano
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        vuta r11
        vuta r10
        vuta r9
        vuta r8
        linganisha r0d, 0
        ruka .hoja_idadi_iko kama ==
        r8++
        ruka .hoja_idadi_skan
.hoja_idadi_iko:
        r9d = r8d   ; faharisi ya kazi
        ; andika/andika_stderr ni za kutofautiana — ruka ukaguzi
        ; (mkia wao hupokea aina yoyote kwa ABI)
        r6 = r13
        r7 = &[jina_andika]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .hoja_idadi_acha_var kama ==
        r6 = r13
        r7 = &[jina_andika_stderr]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .hoja_idadi_acha_var kama ==
        r2d = n32[func_ret_params + r9*4]
        linganisha r2d, r15d
        ruka .hoja_idadi_sawa kama ==
        ; Kosa: idadi si sahihi — "Hitilafu: idadi ya hoja kwa 'f' si
        ; sahihi (N badala ya M)". edx (idadi inayotarajiwa) huhifadhiwa
        ; kwenye rafu — andika_mfuatano inaharibu rdx (zamani ujumbe
        ; ulichapisha nambari ya takataka).
        sukuma r9
        sukuma r2
        r7 = &[msg_idadi_hoja_1]
        ita andika_mfuatano
        r7 = r13
        ita andika_mfuatano
        r7 = &[msg_idadi_hoja_2]
        ita andika_mfuatano
        r7d = r15d
        ita andika_nambari
        r7 = &[msg_idadi_hoja_3]
        ita andika_mfuatano
        vuta r2
        r7d = r2d
        ita andika_nambari
        r7 = &[msg_idadi_hoja_4]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.hoja_idadi_sawa:
        sukuma r9   ; faharisi (inatolewa .baada_ya_wito)
        ruka .eval_args
.hoja_idadi_acha_var:
        r9d = -1   ; mkia wa kutofautiana — hakuna ukaguzi
.hoja_idadi_acha:
        sukuma r9   ; faharisi au -1
        ruka .eval_args
.hoja_idadi_kielekezi:
        ; Wito wa kielekezi: hakuna saini — hakuna ukaguzi wa hoja
        r9d = -1
        sukuma r9
.eval_args:
        ; Kikomo cha ABI ya mbegu: hoja 16 (sawa na mnyororo wa .swa —
        ; 8.16). Zaidi ya hapo ni kosa la sauti, si kuacha kimya.
        linganisha r15d, 16
        ruka .hoja16_kosa kama >a
        ; Tathmini kila hoja na kusukuma matokeo kwenye rafu
        r8d = r14d
        r9d ^= r9d
        n64[hoja_gp] = 0
        n64[hoja_xmm] = 0
.eval_loop:
        linganisha r8d, -1
        ruka .pop_args kama ==
        ; Hoja zote zinatathminiwa na kusukumwa — hoja 7+ zitabaki rafu

        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        sukuma r8
        sukuma r9

        r12d = r8d
        ita uzalishaji_ast   ; matokeo kwenye eax/xmm0

        ; Hoja ya D64 inakuja kwenye xmm0 (hesabu ya kuelea), si rax.
        ; Kumbuka aina yake na faharisi ya rejesta (gp/xmm) kwa ABI.
        r12d = n32[r4+8]   ; nodi ya hoja (r8 iliyohifadhiwa)
        ita fumbua_aina   ; eax = aina msingi
        r10 = n64[r4]   ; faharisi ya hoja (r9 iliyohifadhiwa)
        ; Panua ishara ya hoja ndogo (N8/N16/N32) — 8.10: andika("%u",
        ; 0 - 1) lazima ichapishe 18446744073709551615, si 4294967295
        ; (cdqe hupanua -1 hadi biti 64 zote).
        linganisha r0d, 3
        ruka .hoja_cdqe_isha kama >a
        pima r3d, r3d
        ruka .hoja_cdqe_isha kama !=
        ; Safu kama hoja hutoa ANWANI (lea) — sio thamani ya hesabu:
        ; cdqe kwenye biti 32 za chini za anwani ingeharibu anwani.
        sukuma r0
        sukuma r3
        r7d = n32[r4 + 24]   ; nodi ya hoja ([rsp]=rbx, [rsp+8]=rax, [rsp+16]=r9)
        ita ni_jina_la_safu
        pima r0d, r0d
        ruka .hoja_cdqe_safu kama !=
        vuta r3
        vuta r0
        sukuma r0
        sukuma r3
        r0b = 0x48   ; cdqe → 48 98
        ita gen_baiti
        r0b = 0x98
        ita gen_baiti
        vuta r3
        vuta r0
        ruka .hoja_cdqe_isha
.hoja_cdqe_safu:
        vuta r3
        vuta r0
.hoja_cdqe_isha:
        ; --- Ukaguzi wa aina ya hoja (8.15) na mpaka wa D64 (8.6) ---
        ; Rafu: [rsp]=aina hoja, [rsp+8]=nyota hoja, [rsp+16]=r9,
        ; [rsp+24]=r8 (nodi), ... [rsp+64]=faharisi ya kazi (au -1)
        sukuma r3   ; nyota ya hoja
        sukuma r0   ; aina ya hoja
        ; 8.11: muundo wa kamba halisi (hoja ya KWANZA ya andika/
        ; andika_stderr) — viungwa %d %s %c %% pekee; %u/%x vya
        ; halisi vinakataliwa kwa sauti
        linganisha n32[r4 + 16], 0   ; faharisi ya hoja
        ruka .hoja_sio_kwanza kama !=
        r6 = r13
        r7 = &[jina_andika]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .hoja_kamba_kagua kama ==
        r6 = r13
        r7 = &[jina_andika_stderr]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .hoja_sio_kwanza kama !=
.hoja_kamba_kagua:
        r7d = n32[r4 + 24]   ; nodi ya hoja
        ita kagua_muundo_wa_kamba
.hoja_sio_kwanza:
        r8d = n32[r4 + 64]   ; faharisi ya kazi
        linganisha r8d, 0
        ruka .hoja_param_acha kama <n
        ; Mkia wa kutofautiana: andika/andika_stderr (hoja 2+),
        ; andika_ndani (hoja 3+) — ruka ukaguzi (ABI hupitisha
        ; mkia kwa rejesta za N64 bila kukagua aina).
        r9d = n32[r4 + 16]   ; faharisi ya hoja
        pima r9d, r9d
        ruka .hoja_param_sio_mkia kama ==
        r6 = r13
        r7 = &[jina_andika]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .hoja_param_acha kama ==
        r6 = r13
        r7 = &[jina_andika_stderr]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .hoja_param_acha kama ==
        linganisha r9d, 2
        ruka .hoja_param_sio_mkia kama <n
        r6 = r13
        r7 = &[jina_andika_ndani]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .hoja_param_acha kama ==
.hoja_param_sio_mkia:
        ; param_aina/param_nyota kutoka kwenye jedwali (kigezo cha
        ; faharisi ya hoja ndani ya mlango wa kazi; rekodi: hoja 16)
        r11d = r8d
        r11d <<= 4   ; faharisi ya kazi * 16
        r11d += n32[r4 + 16]   ; + faharisi ya hoja
        r8d = a8[func_ret_paina + r11]
        r11d = a8[func_ret_pnyota + r11]
        sukuma r11   ; [rsp] = param_nyota
        sukuma r8   ; [rsp+8] = param_aina
        ; --- 8.15: kielekezi dhidi ya namba ---
        ; Aina ya hoja isiyojulikana — ruka (halisi za kamba n.k.)
        linganisha n32[r4 + 16], 0
        ruka .hoja_kagua_isha kama ==
        r9d = 0   ; arg_ptr
        linganisha n32[r4 + 24], 0   ; nyota ya hoja
        ruka .hoja_arg_ptr_ndiyo kama >n
        r7d = n32[r4 + 40]   ; nodi ya hoja (r12-r15 huhifadhiwa)
        ita ni_jina_la_safu
        pima r0d, r0d
        ruka .hoja_arg_ptr_hapana kama ==
.hoja_arg_ptr_ndiyo:
        r9d = 1
.hoja_arg_ptr_hapana:
        r11d = 0   ; param_ptr
        linganisha n32[r4 + 8], 0   ; param_nyota
        ruka .hoja_param_ptr_ndiyo kama >n
        ruka .hoja_param_ptr_iko
.hoja_param_ptr_ndiyo:
        r11d = 1
.hoja_param_ptr_iko:
        linganisha r9d, r11d
        ruka .hoja_kagua_isha kama ==
        ; Kosa la sauti: kielekezi dhidi ya namba (mdudu wa 2026-09-01:
        ; N32 kwa kigezo cha kielekezi ilianguka SEGV wakati wa kukimbia)
        r7 = &[msg_kielekezi_namba_1]
        ita andika_mfuatano
        r7 = r13
        ita andika_mfuatano
        r7 = &[msg_kielekezi_namba_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.hoja_kagua_isha:
        ; --- Mpaka wa kamili/desimali kwenye hoja (8.6) ---
        linganisha n32[r4], 7   ; param_aina == D64
        ruka .hoja_bmd_d64 kama ==
        linganisha n32[r4], 4   ; param_aina == N64
        ruka .hoja_bmd_kamili64 kama ==
        linganisha n32[r4], 1
        ruka .hoja_bmd_kamili32 kama ==
        linganisha n32[r4], 2
        ruka .hoja_bmd_kamili32 kama ==
        linganisha n32[r4], 3
        ruka .hoja_bmd_kamili32 kama ==
        ruka .hoja_bmd_isha
.hoja_bmd_d64:
        ; Hoja ya kamili → D64 (cvtsi2sd) — thamani huenda kwenye xmm0.
        ; Wito kupitia kielekezi kama hoja ya parameta ya D64 haurudishi
        ; D64 (4.3) — kosa la sauti. Nodi ya hoja iko kwenye [rsp+40].
        sukuma r8
        sukuma r9
        sukuma r10
        r7d = n32[r4 + 40 + 24]   ; nodi ya hoja (baada ya push 3)
        ita ni_wito_kielekezi
        vuta r10
        vuta r9
        vuta r8
        linganisha r0d, 0
        ruka .hoja_bmd_d64_sawa kama ==
        r7 = &[msg_kielekezi_d64]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.hoja_bmd_d64_sawa:
        linganisha n32[r4 + 16], 7   ; tayari D64
        ruka .hoja_bmd_isha kama ==
        linganisha n32[r4 + 16], 4   ; N64 → cvtsi2sd rax
        ruka .hoja_bmd_d64_rax kama ==
        linganisha n32[r4 + 16], 5   ; W0 → cvtsi2sd rax
        ruka .hoja_bmd_d64_rax kama ==
        ; cvtsi2sd xmm0, eax → F2 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        ruka .hoja_bmd_d64_iko
.hoja_bmd_d64_rax:
        ; cvtsi2sd xmm0, rax → F2 48 0F 2A C0
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2A
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
.hoja_bmd_d64_iko:
        n32[r4 + 16] = 7   ; aina inayofaa: D64
        ruka .hoja_bmd_isha
.hoja_bmd_kamili32:
        ; Hoja ya D64 → kamili (cvttsd2si eax)
        linganisha n32[r4 + 16], 7
        ruka .hoja_bmd_isha kama !=
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2C
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        n32[r4 + 16] = 3   ; aina inayofaa: N32
        ruka .hoja_bmd_isha
.hoja_bmd_kamili64:
        ; Hoja ya D64 → N64 (cvttsd2si rax)
        linganisha n32[r4 + 16], 7
        ruka .hoja_bmd_isha kama !=
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x2C
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        n32[r4 + 16] = 4   ; aina inayofaa: N64
.hoja_bmd_isha:
        r4 += 16   ; toa param_aina na param_nyota
.hoja_param_acha:
        ; Hakuna ukaguzi (kazi isiyojulikana, mkia wa kutofautiana)
        ; — rejesha aina na nyota za hoja (rafu: [rsp]=aina, [rsp+8]=nyota)
        vuta r0   ; aina ya hoja (inayofaa)
        vuta r3   ; nyota ya hoja
        n8[hoja_d64 + r10] = 0
        linganisha r0d, 7
        ruka .hoja_sio_d64 kama !=
        n8[hoja_d64 + r10] = 1
        r11 = n64[hoja_xmm]
        n8[hoja_reg + r10] = r11b
        n64[hoja_xmm]++
        ; movq rax, xmm0 -> 66 48 0F 7E C0 ; kisha push rax -> 50
        r0b = 0x66
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x7E
        ita gen_baiti
        r0b = 0xC0
        ita gen_baiti
        r0b = 0x50
        ita gen_baiti
        ruka .hoja_sukumwa
.hoja_sio_d64:
        ; Safu kama hoja (8.22): thamani yake ni ANWANI (lea), si
        ; muundo — pata_a(safu, 1) hupitisha msingi wa safu kama
        ; kielekezi. Zamani safu ya miundo ilinakiliwa kama muundo
        ; mmoja (kipengele cha kwanza pekee) na mwendo ukaharibika.
        ; TAHADHARI: ni_jina_la_safu inaharibu rax na rbx — zihifadhi.
        sukuma r0   ; aina ya hoja
        sukuma r3   ; nyota za hoja
        r12d = n32[r4 + 24]   ; nodi ya hoja ([rsp]=rbx, [rsp+8]=rax, [rsp+16]=r9)
        r7d = r12d
        ita ni_jina_la_safu
        pima r0d, r0d
        ruka .hoja_sio_safu kama ==
        vuta r3
        vuta r0
        r11 = n64[hoja_gp]
        n8[hoja_reg + r10] = r11b
        n64[hoja_gp]++
        r0b = 0x50   ; push rax — anwani ya msingi
        ita gen_baiti
        ruka .hoja_sukumwa
.hoja_sio_safu:
        vuta r3
        vuta r0
        ; Muundo kwa thamani: usemi wa muundo hutoa ANWANI. Hoja ndogo
        ; (<=8B) hupakiwa kwa thamani; hoja kubwa (>8B) hupitishwa kwa
        ; rejea — nakala kwenye bafa ya data (kama sret) na kielekezi.
        linganisha r0d, 6
        ruka .hoja_sio_muundo kama !=
        linganisha r3d, 0
        ruka .hoja_sio_muundo kama !=
        ; Usajili wa rejesta ya GP (kama hoja ya kawaida)
        r11 = n64[hoja_gp]
        n8[hoja_reg + r10] = r11b
        n64[hoja_gp]++
        ; Ukubwa wa muundo kutoka jedwali (edx = muundo id)
        sukuma r8
        sukuma r9
        sukuma r10
        sukuma r11
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        linganisha r2d, 0
        ruka .hm_hakuna_ukubwa kama <n
        linganisha r2d, n32[muundo_count]
        ruka .hm_hakuna_ukubwa kama >=a
        r14d = n32[muundo_ukubwa + r2*4]
        ruka .hm_ukubwa_iko
.hm_hakuna_ukubwa:
        r14d = 8
.hm_ukubwa_iko:
        linganisha r14d, 8
        ruka .hm_kubwa kama >n
        ; Hoja ndogo (<=8B): pakia thamani kutoka [rax]
        linganisha r14d, 4
        ruka .hm_pakia_64 kama >n
        linganisha r14d, 2
        ruka .hm_pakia_16 kama ==
        linganisha r14d, 1
        ruka .hm_pakia_8 kama ==
        ; N32 au 3-4B: mov eax, [rax] -> 8B 00
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .hm_sukumwa
.hm_pakia_64:
        ; mov rax, [rax] -> 48 8B 00
        r0b = 0x48
        ita gen_baiti
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .hm_sukumwa
.hm_pakia_16:
        ; movzx eax, word [rax] -> 0F B7 00
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xB7
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .hm_sukumwa
.hm_pakia_8:
        ; movzx eax, byte [rax] -> 0F B6 00
        r0b = 0x0F
        ita gen_baiti
        r0b = 0xB6
        ita gen_baiti
        r0b = 0x00
        ita gen_baiti
        ruka .hm_sukumwa
.hm_kubwa:
        ; Hoja kubwa (>8B): nakala kwenye data_buf, kisha sukuma kielekezi
        r15d = r14d   ; ukubwa (kwa gen_neno4)
        r10 = n64[data_buf_pos]
        r11d = r10d
        n64[data_buf_pos] += r15
        linganisha n64[data_buf_pos], DATA_BUF_SIZE
        ruka .hm_nafasi kama <=a
        r7 = &[msg_databuf]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.hm_nafasi:
        ; lea rdi, [rip+disp32] — 48 8D 3D + reloketi ya .data
        r0b = 0x48
        ita gen_baiti
        r0b = 0x8D
        ita gen_baiti
        r0b = 0x3D
        ita gen_baiti
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .hm_rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        n32[rela_sym + r7*4] = -1
        r11d -= 4
        n32[rela_addend + r7*4] = r11d
        n64[rela_count]++
        ruka .hm_skip_reloc
.hm_rela_jaa:
        r7 = &[msg_rela_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.hm_skip_reloc:
        r7d = 0
        ita gen_neno4
        ; push rdi (57) — hifadhi anwani ya MWANZO wa nakala (rep movsb
        ; inasogeza rdi mwishoni mwa bafa)
        r0b = 0x57
        ita gen_baiti
        ; mov rsi, rax (48 89 C6) — chanzo
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xC6
        ita gen_baiti
        ; mov ecx, ukubwa (B9 + d32)
        r0b = 0xB9
        ita gen_baiti
        r7d = r15d
        ita gen_neno4
        ; rep movsb (F3 A4)
        r0b = 0xF3
        ita gen_baiti
        r0b = 0xA4
        ita gen_baiti
        ; pop rdi (5F) — rudisha anwani ya mwanzo
        r0b = 0x5F
        ita gen_baiti
        ; push rdi (57) — sukuma kielekezi cha nakala kama hoja
        r0b = 0x57
        ita gen_baiti
        ruka .hm_mwisho
.hm_sukumwa:
        ; push rax (50) — thamani
        r0b = 0x50
        ita gen_baiti
.hm_mwisho:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        vuta r11
        vuta r10
        vuta r9
        vuta r8
        ruka .hoja_sukumwa
.hoja_sio_muundo:
        r11 = n64[hoja_gp]
        n8[hoja_reg + r10] = r11b
        n64[hoja_gp]++
        ; Sukuma matokeo kwenye rafu ya utekelezaji (push rax = 0x50)
        r0b = 0x50
        ita gen_baiti
.hoja_sukumwa:

        vuta r9
        vuta r8
        vuta r15
        vuta r14
        vuta r13
        vuta r12

        r9d++
        r8d = n32[ast_nne + r8*4]
        ruka .eval_loop

.pop_args:
        ; Toa hoja kutoka rafu na kuziweka kwenye rejista
        ; Hoja zilisukumwa kwa mpangilio: arg1, arg2, ..., argN
        ; Rafu sasa: [argN, ..., arg2, arg1] (juu kwenda chini)
        ;
        ; Makubaliano ya mpokeaji (na ya ABI): rejista = hoja 1..6
        ; (rdi, rsi, rdx, rcx, r8, r9); hoja 7..N kwenye rafu kwa
        ; mpangilio wa kinyume, arg7 juu kabisa wakati wa wito.
        ;
        ; Kwa N > 6: toa hoja za ziada (argN..arg7) kwenye rejista za
        ; muda (rax, r10, r11), kisha toa sita kwenye r9..rdi, kisha
        ; rudisha za ziada kwa mpangilio wa kutoa ili arg7 ibaki juu.
        ; Rejista za muda hazina thamani hai hapa: matokeo ya hoja
        ; yako rafu, na lea ya sret hutolewa baadaye kwenye .do_call.

        linganisha r15d, 6
        ruka .pop_regs kama <=a
        ; Hoja 7+: ABI ya rafu. D64 iliyochanganywa na hoja 7+
        ; haisaidiwi (mnyororo wa .swa hauhitaji).
        linganisha n64[hoja_xmm], 0
        ruka .d64_hoja8_kosa kama !=
        ; Hoja 7-9: rejista tatu za muda (rax, r10, r11) — njia ya
        ; zamani. Hoja 10-16: zile za ziada huhamishwa chini ya rafu.
        linganisha r15d, 9
        ruka .scratch_pop kama <=a
.extras16:
        ; Hoja za ziada (E = r15d - 6) ziko juu ya rafu kwa mpangilio
        ; wa kinyume (argN juu). Zinatolewa moja-moja na kuwekwa
        ; CHINI ya rafu kwa mpangilio sahihi (arg7 chini kabisa):
        ; pop rax kisha mov [rsp + hasi], rax — jozi inayotumia
        ; ofseti -16j (j = nambari ya jozi). Rejesta tatu za muda
        ; hazitoshi kwa hoja 10-16, kwa hiyo rafu yenyewe ni eneo la
        ; kuhifadhia (nafuu: rafu inakua chini kama kawaida).
        ; Jozi 1 (argN) — ofseti -16
        r0b = 0x58
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r0b = 0x24
        ita gen_baiti
        r7d = -16
        ita gen_neno4
        linganisha r15d, 7
        ruka .pop_regs kama ==
        ; Jozi 2 — ofseti -32
        r0b = 0x58
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r0b = 0x24
        ita gen_baiti
        r7d = -32
        ita gen_neno4
        linganisha r15d, 8
        ruka .pop_regs kama ==
        ; Jozi 3 — ofseti -48
        r0b = 0x58
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r0b = 0x24
        ita gen_baiti
        r7d = -48
        ita gen_neno4
        linganisha r15d, 9
        ruka .pop_regs kama ==
        ; Jozi 4 — ofseti -64
        r0b = 0x58
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r0b = 0x24
        ita gen_baiti
        r7d = -64
        ita gen_neno4
        linganisha r15d, 10
        ruka .pop_regs kama ==
        ; Jozi 5 — ofseti -80
        r0b = 0x58
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r0b = 0x24
        ita gen_baiti
        r7d = -80
        ita gen_neno4
        linganisha r15d, 11
        ruka .pop_regs kama ==
        ; Jozi 6 — ofseti -96
        r0b = 0x58
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r0b = 0x24
        ita gen_baiti
        r7d = -96
        ita gen_neno4
        linganisha r15d, 12
        ruka .pop_regs kama ==
        ; Jozi 7 — ofseti -112
        r0b = 0x58
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r0b = 0x24
        ita gen_baiti
        r7d = -112
        ita gen_neno4
        linganisha r15d, 13
        ruka .pop_regs kama ==
        ; Jozi 8 — ofseti -128
        r0b = 0x58
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r0b = 0x24
        ita gen_baiti
        r7d = -128
        ita gen_neno4
        linganisha r15d, 14
        ruka .pop_regs kama ==
        ; Jozi 9 — ofseti -144
        r0b = 0x58
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r0b = 0x24
        ita gen_baiti
        r7d = -144
        ita gen_neno4
        linganisha r15d, 15
        ruka .pop_regs kama ==
        ; Jozi 10 (arg7) — ofseti -160
        r0b = 0x58
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r0b = 0x24
        ita gen_baiti
        r7d = -160
        ita gen_neno4
        ruka .pop_regs
.d64_hoja8_kosa:
        r7 = &[msg_d64_wito]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.hoja16_kosa:
        r7 = &[msg_hoja16]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.h9_ya_builtin:
        ; Builtin (ukubwa/wito_wa_mfumo/tekeleza) yenye hoja 10+ —
        ; ABI yao maalum haipangiki na rafu ya .extras16
        r7 = &[msg_hoja9]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.scratch_pop:
        ; pop rax = 58
        r0b = 0x58
        ita gen_baiti
        linganisha r15d, 7
        ruka .pop_regs kama ==
        ; pop r10 = 41 5A
        r0b = 0x41
        ita gen_baiti
        r0b = 0x5A
        ita gen_baiti
        linganisha r15d, 8
        ruka .pop_regs kama ==
        ; pop r11 = 41 5B
        r0b = 0x41
        ita gen_baiti
        r0b = 0x5B
        ita gen_baiti
.pop_regs:
        ; Pangilia hoja 1..6 kwenye rejista za GP/XMM kwa mpangilio wa
        ; ABI ya System V. hoja_d64[i] na hoja_reg[i] zimejazwa wakati
        ; wa kutathmini hoja.
        r1d = r15d   ; idadi ya hoja (N)
        linganisha r1d, 6
        ruka .pop_loop kama <=a
        r1d = 6   ; hoja 7-9 zimetolewa kwenye scratch
.pop_loop:
        r1d--
        ruka .do_call kama hasi   ; ecx < 0 -> tumemaliza
        linganisha n8[hoja_d64 + r1], 0
        ruka .pop_gp kama ==
        ; D64 -> movsd xmmN, [rsp] (F2 0F 10 /r + SIB) ; add rsp, 8
        r10d = a8[hoja_reg + r1]
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x10
        ita gen_baiti
        r0d = r10d
        r0d <<= 3
        r0d |= 4   ; mod=00, reg=xmmN, rm=100 (SIB)
        ita gen_baiti
        r0b = 0x24   ; SIB: base=rsp
        ita gen_baiti
        r0b = 0x48
        ita gen_baiti
        r0b = 0x83
        ita gen_baiti
        r0b = 0xC4
        ita gen_baiti
        r0b = 0x08   ; add rsp, 8
        ita gen_baiti
        ruka .pop_loop
.pop_gp:
        r10d = a8[hoja_reg + r1]
        linganisha r10d, 0
        ruka .g_rdi kama ==
        linganisha r10d, 1
        ruka .g_rsi kama ==
        linganisha r10d, 2
        ruka .g_rdx kama ==
        linganisha r10d, 3
        ruka .g_rcx kama ==
        linganisha r10d, 4
        ruka .g_r8 kama ==
        ; r10d == 5 -> pop r9 (41 59)
        r0b = 0x41
        ita gen_baiti
        r0b = 0x59
        ita gen_baiti
        ruka .pop_loop
.g_r8:
        r0b = 0x41
        ita gen_baiti
        r0b = 0x58
        ita gen_baiti
        ruka .pop_loop
.g_rcx:
        r0b = 0x59
        ita gen_baiti
        ruka .pop_loop
.g_rdx:
        r0b = 0x5A
        ita gen_baiti
        ruka .pop_loop
.g_rsi:
        r0b = 0x5E
        ita gen_baiti
        ruka .pop_loop
.g_rdi:
        r0b = 0x5F
        ita gen_baiti
        ruka .pop_loop

.do_call:
        ; Hoja 10-16 (njia ya .extras16): hoja za ziada zimekwisha
        ; kuhamishwa chini — sawazisha rafu hadi arg7: sub rsp,
        ; (16E + 48) ambapo E = r15d - 6 (48 81 EC + d32).
        linganisha r15d, 10
        ruka .do_call_zamani kama <a
        r0b = 0x48
        ita gen_baiti
        r0b = 0x81
        ita gen_baiti
        r0b = 0xEC
        ita gen_baiti
        r7d = r15d
        r7d -= 6
        r7d = r7d * 16
        r7d += 48
        ita gen_neno4
        ruka .sio_rudisha
.do_call_zamani:
        ; Rudisha hoja za ziada kwenye rafu kwa mpangilio uleule wa kutoa:
        ; kusukuma argN kwanza, arg7 mwisho, ili arg7 ibaki juu ya rafu.
        linganisha r15d, 6
        ruka .sio_rudisha kama <=a
        ; push rax = 50
        r0b = 0x50
        ita gen_baiti
        linganisha r15d, 7
        ruka .sio_rudisha kama ==
        ; push r10 = 41 52
        r0b = 0x41
        ita gen_baiti
        r0b = 0x52
        ita gen_baiti
        linganisha r15d, 8
        ruka .sio_rudisha kama ==
        ; push r11 = 41 53
        r0b = 0x41
        ita gen_baiti
        r0b = 0x53
        ita gen_baiti
.sio_rudisha:
        ; Builtin ya ukubwa(aina) — kokotoa ukubwa wakati wa kukusanya
        ; (sawa na uzalishaji.swa). N8=1, N16=2, N32=4, N64=8, D64=8,
        ; muundo = ukubwa wake; jina lisilojulikana = 4.
        r7 = r13
        r6 = &[jina_ukubwa]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .sio_builtin_ukubwa kama !=
        ; Hoja lazima iwe jina la aina (mf. ukubwa(N32)) — vinginevyo
        ; ni wito wa kawaida kwa kazi ya mtumiaji (sawa na uzalishaji.swa)
        linganisha r14d, -1
        ruka .sio_builtin_ukubwa kama ==
        r8d = n32[ast_aina + r14*4]
        linganisha r8d, AST_JINA
        ruka .sio_builtin_ukubwa kama !=
        ; Ukubwa unachukua hoja moja pekee — hoja 10+ (rafu ya
        ; .extras16) hazipangiki na njia hii ya haraka
        linganisha r15d, 10
        ruka .h9_ya_builtin kama >=a
        r15d = -1   ; ukubwa (chaguo-msingi: 4)
        r15d = n32[ast_jina_off + r14*4]
        r15 = &[str_pool + r15]
        ; KWANZA: jina la muundo (jina la mtumiaji) -- KABLA ya majina
        ; ya aina za msingi, ili muundo ULIOTANGAZWA KWA MAKUSUDI lenye
        ; jina linalofanana na aina ya msingi (n8/n16/n32/n64/d64)
        ; kipewe kipaumbele juu ya usomaji wa kimakosa kama primitive
        ; (hati/mipaka.md #10 -- jina la muundo/kigezo lililo HASA
        ; n8/n16/n32/n64/d64 lilikuwa likirudisha ukubwa wa aina ya
        ; msingi badala ya ukubwa halisi wa muundo). Kama HAKUNA muundo
        ; wa jina hilo, anguka kwenye ukaguzi wa majina ya aina za
        ; msingi kama zamani -- tabia kwa majina yasiyogongana (idadi
        ; kubwa zaidi ya matumizi halisi) HAIBADILIKI KABISA.
        r7d = n32[ast_jina_off + r14*4]
        ita tafuta_muundo
        linganisha r0d, -1
        ruka .uk_jaribu_n8_ndogo kama ==
        linganisha r0d, n32[muundo_count]
        ruka .uk_jaribu_n8_ndogo kama >=a
        r15d = n32[muundo_ukubwa + r0*4]
        ruka .ukubwa_toa
.uk_jaribu_n8_ndogo:
        r7 = r15
        r6 = &[tn_n8_ndogo]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .uk_jaribu_n16_ndogo kama !=
        r15d = 1
        ruka .ukubwa_toa
.uk_jaribu_n16_ndogo:
        r7 = r15
        r6 = &[tn_n16_ndogo]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .uk_jaribu_n32_ndogo kama !=
        r15d = 2
        ruka .ukubwa_toa
.uk_jaribu_n32_ndogo:
        r7 = r15
        r6 = &[tn_n32_ndogo]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .uk_jaribu_n64_ndogo kama !=
        r15d = 4
        ruka .ukubwa_toa
.uk_jaribu_n64_ndogo:
        r7 = r15
        r6 = &[tn_n64_ndogo]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .uk_jaribu_d64_ndogo kama !=
        r15d = 8
        ruka .ukubwa_toa
.uk_jaribu_d64_ndogo:
        r7 = r15
        r6 = &[tn_d64_ndogo]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .ukubwa_toa_sio_muundo kama !=
        r15d = 8
        ruka .ukubwa_toa
.ukubwa_toa_sio_muundo:
        r15d = 4
.ukubwa_toa:
        ; Hoja tayari imetolewa na .pop_args (pop rdi) — rafu iko sawia.
        ; mov eax, imm32 — B8 + d32
        r0b = 0xB8
        ita gen_baiti
        r7d = r15d
        ita gen_neno4
        ruka .baada_ya_wito
.sio_builtin_ukubwa:
        ; Builtin ya wito_wa_mfumo — badala ya wito halisi, pangilia hoja
        ; kwa ABI ya syscall (sawa na builtin ya uzalishaji.swa):
        ; rax=namba, rdi=a1, rsi=a2, rdx=a3, r10=a4, r8=a5, r9=0.
        ; Hoja ya 7 (ikiwa ipo) inatolewa na pop r9.
        r7 = r13
        r6 = &[jina_wito_mfumo]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .sio_builtin_syscall kama !=
        ; ABI ya syscall inachukua hoja 7 pekee (saini ya maktaba) —
        ; hoja 10+ (rafu ya .extras16) hazipangiki hapa
        linganisha r15d, 10
        ruka .h9_ya_builtin kama >=a
        ; mov r10, r8 — 4D 89 C2 (a4: hoja ya 5)
        r0b = 0x4D
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xC2
        ita gen_baiti
        ; mov r8, r9 — 4D 89 C8 (a5: hoja ya 6). lugha-swa/swa#311: bila
        ; hii, a5 ilipotea kimya na r8 ilibaki na a4 (kioo cha #303/#304
        ; kwenye uzalishaji.swa). LAZIMA iwe KABLA ya pop r9 ya chini.
        r0b = 0x4D
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xC8
        ita gen_baiti
        ; mov rax, rdi — 48 89 F8 (namba ya syscall)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xF8
        ita gen_baiti
        ; mov rdi, rsi — 48 89 F7 (a1)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xF7
        ita gen_baiti
        ; mov rsi, rdx — 48 89 D6 (a2)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xD6
        ita gen_baiti
        ; mov rdx, rcx — 48 89 CA (a3)
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xCA
        ita gen_baiti
        ; pop r9 — 41 59 (hoja ya 7: ofseti, daima 0 kwenye maktaba).
        ; KWA MASHARTI: r9 inatolewa tu wakati hoja ya 7 ipo (r15d >= 7).
        ; Awali ilitolewa bila masharti — kwa wito wenye hoja < 7, rafu
        ; iliteleza +8 kwa kila wito na push zilizofuata ziliandika
        ; kwenye sloti za vigezo vya ndani (uharibifu wa rafu).
        linganisha r15d, 7
        ruka .syscall_hoja7_hamna kama <n
        r0b = 0x41
        ita gen_baiti
        r0b = 0x59
        ita gen_baiti
.syscall_hoja7_hamna:
        ; syscall — 0F 05
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ; Safisha hoja 8+ zilizobaki kwenye rafu (add rsp, (r15d-7)*8).
        ; .do_call ilisukuma a7 juu — pop r9 tayari imeondoa a7, kwa
        ; hivyo a8..aN (N-7 maneno) zinaondolewa hapa.
        linganisha r15d, 8
        ruka .syscall_rafu_safi kama <n
        ; add rsp, imm32 = 48 81 C4 + (r15d - 7) * 8
        r0b = 0x48
        ita gen_baiti
        r0b = 0x81
        ita gen_baiti
        r0b = 0xC4
        ita gen_baiti
        r7d = r15d
        r7d -= 7
        r7d = r7d * 8
        ita gen_neno4
.syscall_rafu_safi:
        ruka .baada_ya_wito
.sio_builtin_syscall:
        ; Builtin ya tekeleza — ita bafa ya JIT kama kazi N32(N32, N8**).
        ; Hoja (kazi, argc, argv, ofseti) ziko rdi/rsi/rdx/rcx kwa
        ; mpangilio wa kawaida → r11=kazi, rdi=argc, rsi=argv+ofseti*8,
        ; al=0, call r11. Sawa na builtin ya uzalishaji.swa.
        r7 = r13
        r6 = &[jina_tekeleza]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .sio_builtin_tekeleza kama !=
        ; Tekeleza inachukua hoja 4 pekee — hoja 10+ hazipangiki hapa
        linganisha r15d, 10
        ruka .h9_ya_builtin kama >=a
        ; mov r11, rdi — 49 89 FB
        r0b = 0x49
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xFB
        ita gen_baiti
        ; mov rdi, rsi — 48 89 F7
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xF7
        ita gen_baiti
        ; mov rsi, rdx — 48 89 D6
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xD6
        ita gen_baiti
        ; mov rdx, rcx — 48 89 CA
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xCA
        ita gen_baiti
        ; shl rdx, 3 — 48 C1 E2 03
        r0b = 0x48
        ita gen_baiti
        r0b = 0xC1
        ita gen_baiti
        r0b = 0xE2
        ita gen_baiti
        r0b = 3
        ita gen_baiti
        ; add rsi, rdx — 48 01 D6
        r0b = 0x48
        ita gen_baiti
        r0b = 0x01
        ita gen_baiti
        r0b = 0xD6
        ita gen_baiti
        ; mov al, 0 — B0 00
        r0b = 0xB0
        ita gen_baiti
        r0b = 0
        ita gen_baiti
        ; call r11 — 41 FF D3
        r0b = 0x41
        ita gen_baiti
        r0b = 0xFF
        ita gen_baiti
        r0b = 0xD3
        ita gen_baiti
        ruka .baada_ya_wito
.sio_builtin_tekeleza:
        ; Kwa wito wa kazi inayorudisha muundo, weka r10 = eneo la muda la .data
        sukuma r12
        sukuma r8
        sukuma r9
        sukuma r10
        sukuma r11
        sukuma r7
        sukuma r6
        r8d ^= r8d
.cr_scan:
        linganisha r8, n64[kazi_ret_idadi]
        ruka .cr_sio kama >=a
        r7 = r13
        r9d = n32[kazi_ret_jina + r8*4]
        r6 = &[str_pool + r9]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .cr_ipatikana kama ==
        r8++
        ruka .cr_scan
.cr_ipatikana:
        r7d = n32[kazi_ret_muundo_jina + r8*4]
        ita tafuta_muundo
        linganisha r0d, -1
        ruka .cr_sio kama ==
        ; rax = faharisi ya muundo
        r9d = n32[muundo_ukubwa + r0*4]
        r10 = n64[data_buf_pos]
        r11d = r10d
        n64[data_buf_pos] += r9
        linganisha n64[data_buf_pos], DATA_BUF_SIZE
        ruka .cr_nafasi kama <=a
        r7 = &[msg_databuf]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.cr_nafasi:
        ; lea r10, [rip + disp32]
        r0b = 0x4c
        ita gen_baiti
        r0b = 0x8d
        ita gen_baiti
        r0b = 0x15
        ita gen_baiti
        ; Rekebisho la .data — kama .do_string
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .cr_rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        n32[rela_sym + r7*4] = -1
        r11d -= 4
        n32[rela_addend + r7*4] = r11d
        n64[rela_count]++
        ruka .cr_skip_reloc
.cr_rela_jaa:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_rela_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.cr_skip_reloc:
        r7d = 0
        ita gen_neno4
.cr_sio:
        vuta r6
        vuta r7
        vuta r11
        vuta r10
        vuta r9
        vuta r8
        vuta r12

        ; --- Wito wa kielekezi: badala ya "call rel32" ya kazi, pakia
        ; anwani ya kigezo kwenye r11 na toa "call r11" (41 FF D3) ---
        ; Rafu: [rsp] = faharisi ya kazi, [rsp+8] = alama ya mwitaji.
        linganisha n32[r4 + 8], 0
        ruka .wito_moja_kwa_moja kama ==
        linganisha n32[r4 + 8], 1
        ruka .wk_toa_ndani kama ==
        ; Ulimwengu: mov r11, [rip + disp32] — 4C 8B 1D d32
        r0b = 0x4C
        ita gen_baiti
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x1D
        ita gen_baiti
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .wito_rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        r0d = n32[r4 + 12]   ; faharisi ya ulimwengu
        r0d += 2
        r0d = -r0d   ; msimbo hasi wa ulimwengu (-gidx-2)
        n32[rela_sym + r7*4] = r0d
        n32[rela_addend + r7*4] = -4
        n64[rela_count]++
        r7d = 0
        ita gen_neno4
        ruka .wk_toa_wito
.wk_toa_ndani:
        ; Ndani: mov r11, [rbp + disp32] — 4C 8B 9D d32 (REX.W+R)
        r0b = 0x4C
        ita gen_baiti
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x9D
        ita gen_baiti
        r7d = n32[r4 + 12]   ; ofseti chanya ya sloti
        r7d = -r7d
        ita gen_neno4
.wk_toa_wito:
        ; call r11 — 41 FF D3
        r0b = 0x41
        ita gen_baiti
        r0b = 0xFF
        ita gen_baiti
        r0b = 0xD3
        ita gen_baiti
        ruka .wito_rela_endelea   ; usiongeze nje — hakuna alama mpya
.wito_moja_kwa_moja:

        ; Toa "call" — opcode E8 ikifuatiwa na rel32
        r0b = 0xe8
        ita gen_baiti

        ; Ongeza alama ya nje kwenye orodha ya nje na tengeneza rekebisho
        r7 = n64[extern_count]
        linganisha r7, MAX_EXTERNS - 1
        ruka .extern_full kama >=a
        r2 = &[extern_name]
        n64[r2 + r7*8] = r13
        n64[extern_count]++
        r14d = r7d   ; hifadhi faharisi ya nje
        ruka .gen_reloc
.extern_full:
        ; Kosa LAUTI — kurejea faharisi 0 kimya ni uharibifu
        r7 = &[msg_extern_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.gen_reloc:
        ; Ongeza rekebisho
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .wito_rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        n32[rela_sym + r7*4] = r14d
        n32[rela_addend + r7*4] = -4
        n64[rela_count]++
.skip_reloc:
        ; Weka nafasi ya rel32 (baiti 4 za sifuri)
        r7d = 0
        ita gen_neno4
        ruka .wito_rela_endelea
.wito_rela_jaa:
        ; Kosa LAUTI — uharibifu wa kimya hauruhusiwi
        r7 = &[msg_rela_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.wito_rela_endelea:

        ; Safisha hoja za rafu zaidi ya sita baada ya wito
        ; Hoja 7+ zilibaki rafu wakati wa call — ziondoe sasa
        linganisha r15d, 6
        ruka .sio_kusafisha kama <=a
        ; add rsp, imm32 = 48 81 C4 + (r15d - 6) * 8
        r0b = 0x48
        ita gen_baiti
        r0b = 0x81
        ita gen_baiti
        r0b = 0xC4
        ita gen_baiti
        ; Hoja 10-16 (njia ya .extras16): rafu ya ziada iko chini —
        ; usawa ni (16E + 48) = 16(r15d-6) + 48
        linganisha r15d, 10
        ruka .kusafisha_zamani kama <a
        r7d = r15d
        r7d -= 6
        r7d = r7d * 16
        r7d += 48
        ita gen_neno4
        ruka .sio_kusafisha
.kusafisha_zamani:
        r7d = r15d
        r7d -= 6
        r7d = r7d * 8
        ita gen_neno4
.sio_kusafisha:

        ; Matokeo yatakuwa kwenye eax baada ya wito
.baada_ya_wito:
        r4 += 8   ; toa faharisi ya kazi (kutoka .count_iko)
        vuta r3   ; toa alama ya mwitaji (wito wa kielekezi)
        vuta n64[hoja_xmm]
        vuta n64[hoja_gp]
        vuta n64[hoja_reg + 8]
        vuta n64[hoja_reg]
        vuta n64[hoja_d64 + 8]
        vuta n64[hoja_d64]
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_vunja: zalisha msimbo kwa taarifa ya vunja
;   huongeza fixup ya jmp kwenye orodha ya break_fixup_pos
;   uzalishaji_wakati utarekebisha fixup hizi baadaye
; -------------------------------------------------------
uzalishaji_vunja:
        sukuma r12
        sukuma r7

        ; jmp rel32 yenye kishikilia
        r0b = 0xe9
        ita gen_baiti
        r12d = n32[text_buf_pos]   ; nafasi ya fixup
        r7d ^= r7d
        ita gen_neno4   ; kishikilia cha baiti 4

        ; Ongeza nafasi ya fixup kwenye orodha
        r0 = n64[break_fixup_count]
        linganisha r0, 65536
        ruka .breakfix_jaa kama >=a
        n32[break_fixup_pos + r0*4] = r12d
        n64[break_fixup_count]++
.overflow:
        vuta r7
        vuta r12
        rudi
.breakfix_jaa:
        r7 = &[msg_breakfix_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; uzalishaji_endelea: zalisha endelea (jump hadi mwanzo wa kitanzi)
;   huongeza fixup ya jmp kwenye orodha ya continue_fixup_pos
;   uzalishaji_wakati utarekebisha fixup hizi baadaye
; -------------------------------------------------------
uzalishaji_endelea:
        sukuma r12
        sukuma r7

        ; jmp rel32 yenye kishikilia
        r0b = 0xe9
        ita gen_baiti
        r12d = n32[text_buf_pos]   ; nafasi ya fixup
        r7d ^= r7d
        ita gen_neno4   ; kishikilia cha baiti 4

        ; Ongeza nafasi ya fixup kwenye orodha
        r0 = n64[continue_fixup_count]
        linganisha r0, 65536
        ruka .continuefix_jaa kama >=a
        n32[continue_fixup_pos + r0*4] = r12d
        n64[continue_fixup_count]++
.overflow:
        vuta r7
        vuta r12
        rudi
.continuefix_jaa:
        r7 = &[msg_breakfix_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; uzalishaji_kama: zalisha msimbo kwa taarifa ya kama/sivyo
;   r12d = faharisi ya nodi
; -------------------------------------------------------
uzalishaji_kama:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        r12d = r12d
        r13d = n32[ast_kushoto + r12*4]   ; hali
        r14d = n32[ast_kulia + r12*4]   ; mwili
        r15d = n32[ast_tiga + r12*4]   ; sivyo (au -1)

        ; Zalisha hali → matokeo kwenye eax
        sukuma r12
        r12d = r13d
        ita uzalishaji_ast
        vuta r12

        ; test eax, eax
        r0b = 0x85
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti

        ; jz — tutarekebisha ofseti baadaye
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti

        ; Hifadhi nafasi ya fixup na andika kishikilia (placeholder)
        r8d = n32[text_buf_pos]   ; nafasi ya fixup ya je
        r7d ^= r7d
        ita gen_neno4   ; andika baiti 4 za 0 (kishikilia)

        ; Zalisha mwili wa kama
        sukuma n64[local_count]   ; upeo wa kizuizi: hifadhi hesabu ya vigezo vya ndani
        sukuma r12
        sukuma r8   ; hifadhi r8d (nafasi ya fixup ya je) — uzalishaji_ast inaharibu r8d
        r12d = r14d
        ita uzalishaji_ast
        vuta r8
        vuta r12
        vuta n64[local_count]   ; rejesha upeo wa nje

        ; Angalia ikiwa kuna tawi la sivyo
        linganisha r15d, -1
        ruka .no_sivyo kama ==

        ; ===== Kuna sivyo =====
        ; Toa jmp isiyo na masharti kuruka juu ya mwili wa sivyo
        r0b = 0xe9   ; jmp rel32
        ita gen_baiti
        r9d = n32[text_buf_pos]   ; hifadhi nafasi ya fixup ya jmp
        r7d ^= r7d
        ita gen_neno4   ; kishikilia cha jmp

        ; Rekebisha je: elekeza kwenye mwanzo wa mwili wa sivyo
        r7d = n32[text_buf_pos]   ; hapa ndipo mwili wa sivyo unaanzia
        r7d -= r8d   ; umbali kutoka fixup
        r7d -= 4   ; toa ukubwa wa kishikilia chenyewe

        r10d = n32[text_buf_pos]   ; hifadhi nafasi ya sasa
        n32[text_buf_pos] = r8d   ; rudi kwenye nafasi ya fixup
        ita gen_neno4   ; andika ofseti sahihi ya je
        n32[text_buf_pos] = r10d   ; rejesha nafasi

        ; Zalisha mwili wa sivyo
        sukuma n64[local_count]   ; upeo wa kizuizi: hifadhi hesabu ya vigezo vya ndani
        sukuma r12
        sukuma r9   ; hifadhi r9d (nafasi ya fixup ya jmp) — uzalishaji_ast inaharibu r9d
        r12d = r15d
        ita uzalishaji_ast
        vuta r9
        vuta r12
        vuta n64[local_count]   ; rejesha upeo wa nje

        ; Rekebisha jmp: elekeza baada ya mwili wa sivyo
        r7d = n32[text_buf_pos]   ; mwisho wa mwili wa sivyo
        r7d -= r9d   ; umbali kutoka fixup ya jmp
        r7d -= 4   ; toa ukubwa wa kishikilia

        r10d = n32[text_buf_pos]   ; hifadhi nafasi ya sasa
        n32[text_buf_pos] = r9d   ; rudi kwenye fixup ya jmp
        ita gen_neno4   ; andika ofseti sahihi ya jmp
        n32[text_buf_pos] = r10d   ; rejesha nafasi

        ruka .done

.no_sivyo:
        ; Rekebisha je: elekeza baada ya mwili wa kama
        r7d = n32[text_buf_pos]   ; mwisho wa mwili
        r7d -= r8d   ; umbali kutoka fixup
        r7d -= 4   ; toa ukubwa wa kishikilia

        r9d = n32[text_buf_pos]   ; hifadhi nafasi ya sasa
        n32[text_buf_pos] = r8d   ; rudi kwenye nafasi ya fixup
        ita gen_neno4   ; andika ofseti sahihi ya je
        n32[text_buf_pos] = r9d   ; rejesha nafasi

.done:
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_wakati: zalisha msimbo kwa kitanzi cha wakati
;   r12d = faharisi ya nodi
;   hutumia break_fixup_pos kurekebisha vunja
; -------------------------------------------------------
uzalishaji_wakati:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        r13d = n32[ast_kushoto + r12*4]   ; hali ya kitanzi
        r14d = n32[ast_kulia + r12*4]   ; mwili wa kitanzi

        ; Anzisha ya kwa (ast_tiga) — itolewe kabla ya kitanzi
        r15d = n32[ast_tiga + r12*4]
        linganisha r15d, -1
        ruka .hakuna_anzisha kama ==
        sukuma r12
        sukuma r13
        sukuma r14
        r12d = r15d
        ita uzalishaji_ast
        vuta r14
        vuta r13
        vuta r12
.hakuna_anzisha:

        ; Rekodi mwanzo wa kitanzi
        r15d = n32[text_buf_pos]   ; start_pos

        ; Hifadhi hali ya vunja ya awali (kwa vitanzi vilivyo ndani)
        ; Heshima sasa inakuwa base — fixups za kitanzi hiki zitaanza hapa,
        ; si kwenye 0, ili zisiharibu nafasi za fixups za vitanzi vya nje
        r0 = n64[break_fixup_count]
        sukuma r0

        ; Hifadhi hali ya endelea ya awali (kwa vitanzi vilivyo ndani)
        ; Kama hapo juu: hesabu inakuwa base, hairejeshwi kwenye 0
        r0 = n64[continue_fixup_count]
        sukuma r0
        ; Alama ya has_step ya kwa (kulia ya block ya mwili)
        r9d = 0
        linganisha n32[ast_kulia + r14*4], -777777
        ruka .sio_hatua_loop kama !=
        r9d = 1
.sio_hatua_loop:
        sukuma r9

        ; Zalisha hali (kitanzi kipofu: ruka hali na jz)
        linganisha r13d, -1
        ruka .kitanzi_kipofu kama ==
        sukuma r12
        r12d = r13d
        ita uzalishaji_ast
        vuta r12

        ; test eax, eax
        r0b = 0x85
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti

        ; jz rel32 yenye kishikilia (ikiwa hali ni sifuri, toka kitanzi)
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r8d = n32[text_buf_pos]   ; nafasi ya fixup ya jz
        r7d ^= r7d
        ita gen_neno4   ; kishikilia cha baiti 4

.kitanzi_kipofu:

        ; Zalisha mwili wa kitanzi
        sukuma n64[local_count]   ; upeo wa kizuizi: hifadhi hesabu ya vigezo vya ndani
        sukuma r12
        sukuma r8
        sukuma r15
        r12d = r14d
        ita uzalishaji_ast
        vuta r15
        vuta r8
        vuta r12
        vuta n64[local_count]   ; rejesha upeo wa nje

        ; jmp rel32 kurudi mwanzo wa kitanzi
        r0b = 0xe9
        ita gen_baiti
        r9d = n32[text_buf_pos]   ; nafasi ya fixup ya jmp
        r7d ^= r7d
        ita gen_neno4   ; kishikilia cha baiti 4

        ; Kokotoa ofseti ya kuruka nyuma: start_pos - fixup_pos - 4
        r7d = r15d   ; start_pos
        r7d -= r9d   ; start_pos - fixup_pos
        r7d -= 4   ; start_pos - fixup_pos - 4
        r10d = n32[text_buf_pos]
        n32[text_buf_pos] = r9d
        ita gen_neno4   ; andika ofseti sahihi ya jmp
        n32[text_buf_pos] = r10d

        ; Rekebisha jz: elekeza mwisho wa kitanzi
        ; (kitanzi kipofu: hakuna jz — ruka; hali inasomwa upya kutoka AST
        ; kwa sababu r13d imeharibiwa na mkusanyaji wa mwili)
        linganisha n32[ast_kushoto + r12*4], -1
        ruka .kitanzi_kipofu_jz_done kama ==
        r7d = n32[text_buf_pos]   ; mwisho wa kitanzi
        r7d -= r8d   ; umbali kutoka fixup
        r7d -= 4   ; toa ukubwa wa kishikilia
        r10d = n32[text_buf_pos]
        n32[text_buf_pos] = r8d
        ita gen_neno4   ; andika ofseti sahihi ya jz
        n32[text_buf_pos] = r10d
.kitanzi_kipofu_jz_done:

        ; Lengo la endelea: start_pos au nafasi ya hatua (semantiki ya C)
        vuta r9   ; has_step
        n32[cl_lengo] = r15d   ; chaguo-msingi: start_pos
        pima r9d, r9d
        ruka .sio_hatua_lengo kama ==
        r0 = n64[cl_hatua]
        n64[cl_lengo] = r0
.sio_hatua_lengo:

        ; Toa mipaka ya awali kutoka rafu
        vuta r14   ; base ya endelea
        vuta r13   ; base ya vunja

        ; Rekebisha vunja zote: zielekeze mwisho wa kitanzi
        ; Anza kutoka base, si 0, ili kuhifadhi fixups za vitanzi vya nje
        r9d = n32[text_buf_pos]   ; lengo = mwisho wa kitanzi
        r1d = r13d
.fix_breaks:
        linganisha r1d, n32[break_fixup_count]
        ruka .fix_breaks_done kama >=a
        r7d = n32[break_fixup_pos + r1*4]   ; nafasi ya fixup ya vunja hii
        sukuma r1
        r10d = r9d
        r10d -= r7d   ; target - fixup_pos
        r10d -= 4   ; target - fixup_pos - 4
        r11d = n32[text_buf_pos]
        n32[text_buf_pos] = r7d
        r7d = r10d
        ita gen_neno4   ; andika ofseti sahihi ya jmp
        n32[text_buf_pos] = r11d
        vuta r1
        r1d++
        ruka .fix_breaks
.fix_breaks_done:
        n64[break_fixup_count] = r13   ; tupa fixups za ndani: rejesha base

        ; Rekebisha endelea zote: zielekeze mwanzo wa kitanzi
        r1d = r14d
.fix_continues:
        linganisha r1d, n32[continue_fixup_count]
        ruka .fix_continues_done kama >=a
        r7d = n32[continue_fixup_pos + r1*4]   ; nafasi ya fixup ya endelea hii
        sukuma r1
        r10d = n32[cl_lengo]   ; lengo = hatua au mwanzo
        r10d -= r7d   ; target - fixup_pos
        r10d -= 4   ; target - fixup_pos - 4
        r11d = n32[text_buf_pos]
        n32[text_buf_pos] = r7d
        r7d = r10d
        ita gen_neno4   ; andika ofseti sahihi ya jmp
        n32[text_buf_pos] = r11d
        vuta r1
        r1d++
        ruka .fix_continues
.fix_continues_done:
        n64[continue_fixup_count] = r14   ; tupa fixups za ndani: rejesha base

        r0d ^= r0d   ; wakati haitoi thamani
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_fanya: zalisha msimbo kwa kitanzi cha fanya..wakati
;   r12d = faharisi ya nodi (kushoto=hali, kulia=mwili)
;   Mpangilio: mwili huzalishwa KWANZA, kisha hali, kisha jz
;   ya kutoka; jmp ya mwisho inarudi mwanzo wa mwili. endelea
;   inaruka hadi hali (semantiki ya C ya fanya..wakati); vunja
;   inaruka hadi mwisho wa kitanzi. Hufuata muundo wa
;   uzalishaji_wakati: mipaka ya fixups iko kwenye rafu.
; -------------------------------------------------------
uzalishaji_fanya:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        r13d = n32[ast_kushoto + r12*4]   ; hali ya kitanzi
        r14d = n32[ast_kulia + r12*4]   ; mwili wa kitanzi

        ; Hifadhi hali ya vunja ya awali (kwa vitanzi vilivyo ndani)
        r0 = n64[break_fixup_count]
        sukuma r0
        ; Hifadhi hali ya endelea ya awali
        r0 = n64[continue_fixup_count]
        sukuma r0

        ; Rekodi mwanzo wa mwili — lengo la jmp ya kurudi nyuma
        r15d = n32[text_buf_pos]   ; mwili_pos

        ; Zalisha mwili — mwili hutekelezwa mara moja kabla ya hali
        sukuma n64[local_count]   ; upeo wa kizuizi: hifadhi hesabu ya vigezo vya ndani
        sukuma r12
        sukuma r15
        r12d = r14d
        ita uzalishaji_ast
        vuta r15
        vuta r12
        vuta n64[local_count]   ; rejesha upeo wa nje

        ; Lengo la endelea ni hali: endelea inaruka hadi tathmini
        ; ya sharti, si mwisho wa mwili (semantiki ya C)
        r0 = n64[text_buf_pos]   ; hali_pos
        n64[cl_lengo] = r0

        ; Zalisha hali — faharisi yake imeharibiwa iwapo na mwili;
        ; isome upya kutoka AST
        sukuma r12
        sukuma r13
        sukuma r15
        r12d = n32[ast_kushoto + r12*4]
        ita uzalishaji_ast
        vuta r15
        vuta r13
        vuta r12

        ; test eax, eax
        r0b = 0x85
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti

        ; jz rel32 yenye kishikilia (hali ni sifuri — toka kitanzi)
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x84
        ita gen_baiti
        r8d = n32[text_buf_pos]   ; nafasi ya fixup ya jz
        r7d ^= r7d
        ita gen_neno4   ; kishikilia cha baiti 4

        ; jmp rel32 kurudi mwanzo wa mwili
        r0b = 0xe9
        ita gen_baiti
        r9d = n32[text_buf_pos]   ; nafasi ya fixup ya jmp
        r7d ^= r7d
        ita gen_neno4   ; kishikilia cha baiti 4

        ; Kokotoa ofseti ya kuruka nyuma: mwili_pos - fixup_pos - 4
        r7d = r15d   ; mwili_pos
        r7d -= r9d   ; mwili_pos - fixup_pos
        r7d -= 4   ; mwili_pos - fixup_pos - 4
        r10d = n32[text_buf_pos]
        n32[text_buf_pos] = r9d
        ita gen_neno4   ; andika ofseti sahihi ya jmp
        n32[text_buf_pos] = r10d

        ; Rekebisha jz: elekeza mwisho wa kitanzi
        r7d = n32[text_buf_pos]   ; mwisho wa kitanzi
        r7d -= r8d   ; umbali kutoka fixup
        r7d -= 4   ; toa ukubwa wa kishikilia
        r10d = n32[text_buf_pos]
        n32[text_buf_pos] = r8d
        ita gen_neno4   ; andika ofseti sahihi ya jz
        n32[text_buf_pos] = r10d

        ; Toa mipaka ya awali kutoka rafu
        vuta r14   ; base ya endelea
        vuta r13   ; base ya vunja

        ; Rekebisha vunja zote: zielekeze mwisho wa kitanzi
        ; Anza kutoka base, si 0, ili kuhifadhi fixups za vitanzi vya nje
        r9d = n32[text_buf_pos]   ; lengo = mwisho wa kitanzi
        r1d = r13d
.fanya_fix_breaks:
        linganisha r1d, n32[break_fixup_count]
        ruka .fanya_fix_breaks_done kama >=a
        r7d = n32[break_fixup_pos + r1*4]   ; nafasi ya fixup ya vunja hii
        sukuma r1
        r10d = r9d
        r10d -= r7d   ; target - fixup_pos
        r10d -= 4   ; target - fixup_pos - 4
        r11d = n32[text_buf_pos]
        n32[text_buf_pos] = r7d
        r7d = r10d
        ita gen_neno4   ; andika ofseti sahihi ya jmp
        n32[text_buf_pos] = r11d
        vuta r1
        r1d++
        ruka .fanya_fix_breaks
.fanya_fix_breaks_done:
        n64[break_fixup_count] = r13   ; tupa fixups za ndani: rejesha base

        ; Rekebisha endelea zote: zielekeze hali ya kitanzi
        r1d = r14d
.fanya_fix_continues:
        linganisha r1d, n32[continue_fixup_count]
        ruka .fanya_fix_continues_done kama >=a
        r7d = n32[continue_fixup_pos + r1*4]   ; nafasi ya fixup ya endelea hii
        sukuma r1
        r10d = n32[cl_lengo]   ; lengo = hali ya kitanzi
        r10d -= r7d   ; target - fixup_pos
        r10d -= 4   ; target - fixup_pos - 4
        r11d = n32[text_buf_pos]
        n32[text_buf_pos] = r7d
        r7d = r10d
        ita gen_neno4   ; andika ofseti sahihi ya jmp
        n32[text_buf_pos] = r11d
        vuta r1
        r1d++
        ruka .fanya_fix_continues
.fanya_fix_continues_done:
        n64[continue_fixup_count] = r14   ; tupa fixups za ndani: rejesha base

        r0d ^= r0d   ; fanya haitoi thamani
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_block: zalisha msimbo kwa block
;   r12d = faharisi ya nodi
; -------------------------------------------------------
uzalishaji_block:
        sukuma r12
        sukuma r13
        sukuma n64[local_count]   ; upeo wa kizuizi: hifadhi hesabu ya vigezo vya ndani

        r12d = r12d
        r13d = n32[ast_kushoto + r12*4]   ; taarifa ya kwanza

.loop:
        linganisha r13d, -1
        ruka .done kama ==

        ; Alama ya hatua ya kwa: rekodi nafasi yake kwa endelea
        linganisha n32[ast_kulia + r13*4], -777777
        ruka .sio_hatua_kw kama !=
        r0 = n64[text_buf_pos]
        n64[cl_hatua] = r0
.sio_hatua_kw:

        sukuma r12
        sukuma r13
        r12d = r13d
        ita uzalishaji_ast
        vuta r13
        vuta r12

        r13d = n32[ast_nne + r13*4]   ; taarifa inayofuata
        ruka .loop
.done:
        vuta n64[local_count]   ; rejesha upeo wa nje
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_kazi: zalisha msimbo kwa kazi nzima
;   r12d = faharisi ya nodi
; -------------------------------------------------------
uzalishaji_kazi:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        sukuma r5

        r12d = r12d
        r13d = n32[ast_thamani + r12*4]   ; aina ya kurudi
        r14d = n32[ast_kulia + r12*4]   ; mwili
        r15d = n32[ast_jina_off + r12*4]   ; ofseti ya jina

        ; Tambua kazi inayorudisha muundo (sret)
        linganisha r13d, 6
        ruka .sio_sret kama !=
        r8d = n32[ast_tiga + r12*4]
        linganisha r8d, -1
        ruka .sio_sret kama ==
        n32[kazi_ret_aina] = 6
        r7d = r8d
        ita tafuta_muundo
        n32[kazi_ret_muundo_id] = r0d
        ruka .sret_imewekwa
.sio_sret:
        n32[kazi_ret_aina] = r13d   ; aina halisi ya kurudi (N32/N64/D64 n.k.)
        n32[kazi_ret_muundo_id] = -1
.sret_imewekwa:

        ; Weka upya vigezo vya ndani
        n64[local_count] = 0

        ; Ongeza lebo ya kazi
        r7 = n64[label_count]
        linganisha r7, MAX_LABELS - 1
        ruka .skip_label kama >=a
        r6 = &[str_pool + r15]

        ; Kagua marudio ya jina la kazi. Swa haina maeneo ya majina:
        ; jina la ngazi ya juu (kazi yenye mwili, kigezo cha ulimwengu,
        ; au muundo) ni la ulimwengu. Zamani ufafanuzi wa pili ulipita
        ; kimya na wa kwanza ukashinda — hatari kwa maktaba zilizo-
        ; unganishwa kwa cat. Sasa ni kosa la kufa, sawa na mnyororo
        ; wa .swa. Matamko ya mbele hayasajili lebo, kwa hiyo haya-
        ; gongani. linganisha_mfuatano huhifadhi rdi na rsi.
        r1d ^= r1d
.kagua_kazi_lebo:
        linganisha r1, n64[label_count]
        ruka .kagua_kazi_ulimwengu kama >=a
        sukuma r1
        r7 = n64[label_name + r1*8]
        ita linganisha_mfuatano
        vuta r1
        linganisha r0d, 0
        ruka .kosa_kazi_marudio kama ==
        r1++
        ruka .kagua_kazi_lebo
.kagua_kazi_ulimwengu:
        r1d ^= r1d
.kagua_kazi_ulimwengu_loop:
        linganisha r1, n64[global_count]
        ruka .kagua_kazi_miundo kama >=a
        sukuma r1
        r7 = n64[global_name + r1*8]
        ita linganisha_mfuatano
        vuta r1
        linganisha r0d, 0
        ruka .kosa_jina_aina_mbili kama ==
        r1++
        ruka .kagua_kazi_ulimwengu_loop
.kagua_kazi_miundo:
        r1d ^= r1d
.kagua_kazi_miundo_loop:
        linganisha r1, n64[muundo_count]
        ruka .kagua_kazi_sawa kama >=a
        sukuma r1
        r7d = n32[muundo_jina_off + r1*4]
        r7 = &[str_pool + r7]
        ita linganisha_mfuatano
        vuta r1
        linganisha r0d, 0
        ruka .kosa_jina_aina_mbili kama ==
        r1++
        ruka .kagua_kazi_miundo_loop
.kagua_kazi_sawa:
        ; Soma upya hesabu ya lebo: linganisha_mfuatano huhifadhi rdi,
        ; lakini rdi ilibadilishwa na skan kuwa kielekezi cha jina.
        r7 = n64[label_count]
        n64[label_name + r7*8] = r6
        r0d = n32[text_buf_pos]
        n32[label_offset + r7*4] = r0d
        n64[label_count]++

        ; Hifadhi faharisi ya lebo
        r13 = r7
        ruka .gen_code
.kosa_kazi_marudio:
        sukuma r6   ; jina la kazi (hupotea kwa andika)
        r7 = &[msg_kazi_marudio_1]
        ita andika_mfuatano
        vuta r7
        ita andika_mfuatano
        r7 = &[msg_kazi_marudio_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.kosa_jina_aina_mbili:
        sukuma r6   ; jina lenye mgongano
        r7 = &[msg_jina_aina_mbili_1]
        ita andika_mfuatano
        vuta r7
        ita andika_mfuatano
        r7 = &[msg_jina_aina_mbili_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.skip_label:
        ; Kosa LAUTI — kurejea faharisi 0 kimya ni uharibifu
        r7 = &[msg_label_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.gen_code:
        ; push r10 — hifadhi kielekezi cha eneo la kurudia
        ; (baada ya kusajili lebo, ili lebo iwe inafunika push r10)
        linganisha n32[kazi_ret_muundo_id], 0
        ruka .sio_push_r10 kama <n
        r0b = 0x41
        ita gen_baiti
        r0b = 0x52
        ita gen_baiti
.sio_push_r10:

        ; Weka upya hesabu ya lebo za ndani kwa kila kazi
        ; (fixups hutatuliwa mwishoni mwa kila kazi, hivyo nambari
        ;  za lebo zinaweza kuanza upya hapa bila mgongano)
        n64[gen_label_count] = 0

        ; Tengeneza lebo ya kurudi
        ita gen_label_mpya
        n64[gen_return_label] = r0

        ; Weka stack frame
        ; push rbp
        r0b = 0x55
        ita gen_baiti
        ; mov rbp, rsp
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xe5
        ita gen_baiti

        ; Tenga nafasi ya rafu kwa vigezo vya ndani
        ; sub rsp, imm32 — tutaweka baada ya kujua ukubwa
        ; Kwa sasa, weka nafasi ya baiti 4 kwa imm32
        r8d = n32[text_buf_pos]   ; hifadhi nafasi ya kurekebisha
        sukuma r8
        r0b = 0x48
        ita gen_baiti
        r0b = 0x81
        ita gen_baiti
        r0b = 0xec
        ita gen_baiti
        r0b = 0   ; imm32 — baiti 4, zitajazwa baadaye
        ita gen_baiti
        r0b = 0
        ita gen_baiti
        r0b = 0
        ita gen_baiti
        r0b = 0
        ita gen_baiti

        ; Hifadhi vigezo vya kazi (parameters) kwenye rafu
        sukuma r14   ; hifadhi nodi ya mwili
        sukuma r13   ; hifadhi faharisi ya lebo

        r10d = n32[ast_kushoto + r12*4]   ; orodha ya vigezo
        r11d ^= r11d   ; faharisi ya hoja (0-5)
        ; r13 (imehifadhiwa kwenye rafu hapo juu) ni kikaunzi cha
        ; rejesta ya GP inayofuata: hoja za GP huchukua rdi, rsi, rdx,
        ; rcx, r8, r9 kwa mpangilio (ABI ya System V), hoja za D64
        ; huchukua xmm0-xmm7 kando yake.
        r13d ^= r13d   ; faharisi ya rejesta ya GP inayofuata
.param_loop:
        linganisha r10d, -1
        ruka .params_done kama ==
        ; Hoja zote zinasajiliwa — zaidi ya 6 zimekuja kupitia rafu ya mwitaji

        ; Sajili kigezo kwenye orodha ya ndani
        r7 = n64[local_count]
        r15d = n32[ast_jina_off + r10*4]
        r1 = &[str_pool + r15]
        n64[local_name + r7*8] = r1

        ; Kokotoa ofseti ya rafu: (local_count + 1) * 8
        r8d = r7d
        r8d++
        r8d = r8d * 8
        n32[local_offset + r7*4] = r8d
        ; Hifadhi aina msingi na idadi ya nyota kwa hoja pia
        r15d = n32[ast_thamani + r10*4]
        n32[local_base_type + r7*4] = r15d
        r15d = n32[ast_tiga + r10*4]
        n32[local_star_count + r7*4] = r15d
        ; Kigezo kinaweza kuwa cha aina ya muundo — tafuta kitambulisho chake
        r15d = -1
        linganisha n32[local_base_type + r7*4], 6   ; 6 = aina ya muundo
        ruka .param_sio_muundo kama !=
        r15d = n32[ast_kushoto + r10*4]   ; ofseti ya jina la muundo au -1
        linganisha r15d, -1
        ruka .param_sio_muundo kama ==
        sukuma r10   ; hifadhi hali ya mzunguko
        sukuma r11
        sukuma r7
        sukuma r12
        r7d = r15d
        ita tafuta_muundo   ; eax = kitambulisho cha muundo au -1
        vuta r12
        vuta r7
        vuta r11
        vuta r10
        r15d = r0d
.param_sio_muundo:
        n32[local_muundo_id + r7*4] = r15d
        n32[local_array_size + r7*4] = 0   ; si safu ya ndani
        ; Kihifadhi ukubwa wa paramu ya muundo na alama ya rejea:
        ; muundo >8B hupitishwa kwa rejea (sloti ina kielekezi)
        sukuma r7
        sukuma r15
        r7 = n r15d
        linganisha r7, 0
        ruka .param_ukubwa_hakuna kama <n
        linganisha r7, n64[muundo_count]
        ruka .param_ukubwa_hakuna kama >=a
        r15d = n32[muundo_ukubwa + r7*4]
        ruka .param_ukubwa_iko
.param_ukubwa_hakuna:
        r15d = 8
.param_ukubwa_iko:
        r7 = n64[r4 + 8]   ; faharisi ya kigezo cha ndani
        n32[local_muundo_ukubwa + r7*4] = r15d
        n32[local_kwa_rejea + r7*4] = 0
        linganisha r15d, 8
        ruka .param_sio_rejea kama <=n
        n32[local_kwa_rejea + r7*4] = 1
.param_sio_rejea:
        vuta r15
        vuta r7
        n64[local_count]++

        ; Toa maelekezo ya kuhifadhi hoja kwenye rafu
        ; Amua kama tunahitaji kuhifadhi baiti 8 (nyota/N64/W0) au 4 (N32/chaguo-msingi)
        r8d = -r8d   ; ofseti hasi kwa rbp

        ; Hoja ya 7 au zaidi inakaa kwenye rafu ya mwitaji, si kwenye rejista
        linganisha r11d, 6
        ruka .store_stack_param kama >=a

        ; Angalia kama kigezo ni cha baiti 8
        r14d = n32[ast_tiga + r10*4]   ; star_count
        linganisha r14d, 0
        ruka .store_64 kama >n
        r14d = n32[ast_thamani + r10*4]   ; base_type
        linganisha r14d, 4   ; N64
        ruka .store_64 kama ==
        linganisha r14d, 5   ; W0
        ruka .store_64 kama ==
        linganisha r14d, 7   ; D64
        ruka .store_d64 kama ==
        linganisha r14d, 2   ; N16
        ruka .store_16 kama ==
        linganisha r14d, 1   ; N8
        ruka .store_8 kama ==
        linganisha r14d, 6   ; muundo
        ruka .store_muundo kama ==
        ; N32
        ruka .store_32

.store_muundo:
        ; Muundo kwa thamani: baiti 8 zote (thamani au kielekezi kwa
        ; rejea) — sloti ya baiti 8 inashikilia zote
        ruka .store_64

.store_d64:
        ; D64 inafika kwenye rejesta ya XMM inayofuata ya ABI:
        ; xmmN ambapo N = idadi ya hoja za D64 zilizotangulia.
        ; Hoja zote za rejesta hapa ni GP au D64, hivyo
        ; N = r11d - r13d (zote zilizotangulia toa zile za GP).
        ; movsd [rbp + disp8], xmmN → F2 0F 11 45|4D|55|5D|65|6D|75|7D XX
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x11
        ita gen_baiti
        r0d = r11d
        r0d -= r13d
        r0d <<= 3
        r0d |= 0x45   ; mod=01 (disp8), reg=xmmN, rm=101 (rbp)
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param

.store_32:
        ; Hoja ya GP ya baiti 4: rejesta inayofuata ya GP
        r9d = r13d
        r13d++
        linganisha r9d, 0
        ruka .try_arg1_32 kama !=
        ; mov [rbp + disp8], edi → 89 7D XX
        r0b = 0x89
        ita gen_baiti
        r0b = 0x7D
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param
.try_arg1_32:
        linganisha r9d, 1
        ruka .try_arg2_32 kama !=
        ; mov [rbp + disp8], esi → 89 75 XX
        r0b = 0x89
        ita gen_baiti
        r0b = 0x75
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param
.try_arg2_32:
        linganisha r9d, 2
        ruka .try_arg3_32 kama !=
        ; mov [rbp + disp8], edx → 89 55 XX
        r0b = 0x89
        ita gen_baiti
        r0b = 0x55
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param
.try_arg3_32:
        linganisha r9d, 3
        ruka .try_arg4_32 kama !=
        ; mov [rbp + disp8], ecx → 89 4D XX
        r0b = 0x89
        ita gen_baiti
        r0b = 0x4D
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param
.try_arg4_32:
        linganisha r9d, 4
        ruka .try_arg5_32 kama !=
        ; mov [rbp + disp8], r8d → 44 89 45 XX
        r0b = 0x44
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x45
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param
.try_arg5_32:
        ; mov [rbp + disp8], r9d → 44 89 4D XX
        r0b = 0x44
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x4D
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param

; -------------------------------------------------------
; Hoja ya 7 au zaidi: haziko kwenye rejista bali kwenye rafu
; ya mwitaji. Baada ya push rbp (na push r10 kwa sret):
; hoja i (1-basi) iko kwenye [rbp + 8*(i-5) + (sret ? 8 : 0)]
; -------------------------------------------------------
.store_stack_param:
        ; Kokotoa ofseti chanya: 8 * (r11d - 4), +8 kwa sret
        r9d = r11d
        r9d -= 4
        r9d <<= 3
        linganisha n32[kazi_ret_muundo_id], 0
        ruka .stack_param_hakuna_sret kama <n
        r9d += 8
.stack_param_hakuna_sret:

        ; Angalia kama kigezo ni cha baiti 8
        r14d = n32[ast_tiga + r10*4]
        linganisha r14d, 0
        ruka .stack_param_64 kama >n
        r14d = n32[ast_thamani + r10*4]
        linganisha r14d, 4   ; N64
        ruka .stack_param_64 kama ==
        linganisha r14d, 5   ; W0
        ruka .stack_param_64 kama ==
        linganisha r14d, 6   ; muundo — baiti 8 (thamani au kielekezi)
        ruka .stack_param_64 kama ==

        ; mov eax, [rbp + disp8] — 8B 45 XX
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x45
        ita gen_baiti
        r0b = r9b
        ita gen_baiti
        ; mov [rbp + disp8], eax — 89 45 YY
        r0b = 0x89
        ita gen_baiti
        r0b = 0x45
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param

.stack_param_64:
        ; mov rax, [rbp + disp8] — 48 8B 45 XX
        r0b = 0x48
        ita gen_baiti
        r0b = 0x8B
        ita gen_baiti
        r0b = 0x45
        ita gen_baiti
        r0b = r9b
        ita gen_baiti
        ; mov [rbp + disp8], rax — 48 89 45 YY
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x45
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param

.store_64:
        ; Hoja ya GP ya baiti 8: rejesta inayofuata ya GP
        r9d = r13d
        r13d++
        linganisha r9d, 0
        ruka .try_arg1_64 kama !=
        ; mov [rbp + disp8], rdi → 48 89 7D XX
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x7D
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param
.try_arg1_64:
        linganisha r9d, 1
        ruka .try_arg2_64 kama !=
        ; mov [rbp + disp8], rsi → 48 89 75 XX
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x75
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param
.try_arg2_64:
        linganisha r9d, 2
        ruka .try_arg3_64 kama !=
        ; mov [rbp + disp8], rdx → 48 89 55 XX
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x55
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param
.try_arg3_64:
        linganisha r9d, 3
        ruka .try_arg4_64 kama !=
        ; mov [rbp + disp8], rcx → 48 89 4D XX
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x4D
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param
.try_arg4_64:
        linganisha r9d, 4
        ruka .try_arg5_64 kama !=
        ; mov [rbp + disp8], r8 → 4C 89 45 XX
        r0b = 0x4C
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x45
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param
.try_arg5_64:
        ; mov [rbp + disp8], r9 → 4C 89 4D XX
        r0b = 0x4C
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0x4D
        ita gen_baiti
        r0b = r8b
        ita gen_baiti
        ruka .next_param

.store_8:
        ; Kwa N8, tunatumia kusajili kwa 32-bit cmpa mov, kisha kuhifadhi baiti
        ; Hii ni rahisi zaidi — tunahifadhi kama 32-bit cmpa mov kwa sasa
        ; TODO: hifadhi baiti moja kwa usahihi
        ruka .store_32

.store_16:
        ; Kwa N16, tunahifadhi kama 32-bit kwa sasa
        ; TODO: hifadhi neno kwa usahihi
        ruka .store_32
.next_param:
        r11d++
        r10d = n32[ast_nne + r10*4]   ; kigezo kinachofuata
        ruka .param_loop
.params_done:
        vuta r13   ; rejesha faharisi ya lebo
        vuta r14   ; rejesha nodi ya mwili

        ; frame_wapi: sehemu ya kwanza ya ndani ni baada ya vigezo vyote
        r7 = n64[local_count]
        r7++
        r7 = r7 * 8
        n64[frame_wapi] = r7

        ; Zalisha mwili
        linganisha r14d, -1
        ruka .no_body kama ==
        sukuma r12
        r12d = r14d
        ita uzalishaji_ast
        vuta r12
.no_body:

        ; Rekebisha ukubwa wa rafu
        vuta r8
        r7 = n64[frame_wapi]
        r7 += 15
        r7 &= ~15   ; pangilia kwa 16

        ; Hoja za rafu zaidi ya 6: ikiwa idadi yao ni isiyo ya kawaida,
        ; mwito uliingia na rsp iliyobadilika kwa 8 — rekebisha fremu
        ; ili rsp iwe 16-aligned kabla ya miito ya ndani
        r9d = 0
        r10d = n32[ast_kushoto + r12*4]
.fr_count_params:
        linganisha r10d, -1
        ruka .fr_counted kama ==
        r9d++
        r10d = n32[ast_nne + r10*4]
        ruka .fr_count_params
.fr_counted:
        linganisha r9d, 6
        ruka .fr_hakuna_pad kama <=a
        r9d -= 6
        pima r9b, 1
        ruka .fr_hakuna_pad kama ==
        ; Hoja za rafu zisizo za kawaida: non-sret anahitaji +8,
        ; sret anaingia tayari aligned — hakuna nyongeza kwake
        linganisha n32[kazi_ret_muundo_id], 0
        ruka .fr_imepita kama >=n
        r7 += 8
        ruka .fr_imepita
.fr_hakuna_pad:
        ; Kwa sret, push r10 tayari imetumia baiti 8 — ongeza ili mwili ubaki 16-aligned
        linganisha n32[kazi_ret_muundo_id], 0
        ruka .fr_imepita kama <n
        r7 += 8
.fr_imepita:
        ; r8 ina nafasi ya baiti ya sub rsp — tunaweka imm32
        n32[text_buf + r8 + 3] = r7d

        ; Weka lebo ya kurudi hapa — kabla ya epilogue
        r7 = n64[gen_return_label]
        r6d = r7d
        r7d = n32[text_buf_pos]
        ita gen_weka_lebo

        ; Kwa sret, rudisha kielekezi cha eneo la kurudia kwenye rax
        linganisha n32[kazi_ret_muundo_id], 0
        ruka .epilogue kama <n
        ; mov rax, [rbp + 8]
        r0b = 0x48
        ita gen_baiti
        r0b = 0x8b
        ita gen_baiti
        r0b = 0x45
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti

        ; Epilogue
.epilogue:
        ; leave
        r0b = 0xc9
        ita gen_baiti
        ; Kwa sret, toa nafasi ya r10 iliyohifadhiwa
        linganisha n32[kazi_ret_muundo_id], 0
        ruka .sio_sret_epilogue kama <n
        ; add rsp, 8
        r0b = 0x48
        ita gen_baiti
        r0b = 0x83
        ita gen_baiti
        r0b = 0xc4
        ita gen_baiti
        r0b = 0x08
        ita gen_baiti
.sio_sret_epilogue:
        ; ret
        r0b = 0xc3
        ita gen_baiti

        ; Rekebisha fixups
        ita gen_fixup_jaza

        ; Weka ukubwa wa lebo
        r7 = n64[label_count]
        r7--
        r0d = n32[text_buf_pos]
        r0d -= n32[label_offset + r7*4]
        n32[label_size + r7*4] = r0d

        vuta r5
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; gen_fixup_jaza: jaza fixups zote zilizosubiri
; -------------------------------------------------------
gen_fixup_jaza:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        r12 = n64[gen_fixup_count]
        r13d ^= r13d
.loop:
        linganisha r13, r12
        ruka .done kama >=a

        r14d = n32[gen_fixup_offset + r13*4]
        r15d = n32[gen_fixup_label + r13*4]

        ; Tafuta nafasi ya lebo kutoka gen_label_pos
        r0d = n32[gen_label_pos + r15*4]
        r0d -= r14d
        r0d -= 4   ; rekebisha kwa urefu wa jmp rel32
        n32[text_buf + r14] = r0d

        r13++
        ruka .loop
.done:
        n64[gen_fixup_count] = 0
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; uzalishaji_ast: linda kuu la uzalishaji
;   r12d = faharisi ya nodi
;   matokeo kwenye eax (kama inafaa)
; -------------------------------------------------------
uzalishaji_ast:
        sukuma r12
        sukuma r3

        linganisha r12d, -1
        ruka .return_neg1 kama ==

        r3d = n32[ast_aina + r12*4]

        linganisha r3d, AST_NAMBA
        ruka .call_nambari kama ==
        linganisha r3d, AST_JINA
        ruka .call_jina kama ==
        linganisha r3d, AST_RUDISHA
        ruka .call_rudisha kama ==
        linganisha r3d, AST_TANGAZO
        ruka .call_tangazo kama ==
        linganisha r3d, AST_KAULI
        ruka .call_kauli kama ==
        linganisha r3d, AST_WAMBILE
        ruka .call_wambile kama ==
        linganisha r3d, AST_KAMA
        ruka .call_kama kama ==
        linganisha r3d, AST_BLOCK
        ruka .call_block kama ==
        linganisha r3d, AST_KAZI
        ruka .call_kazi kama ==
        linganisha r3d, AST_KIELELEZO
        ruka .call_kielelezo kama ==
        linganisha r3d, AST_ALAMA_ELEKEZA
        ruka .call_anwani_ya kama ==
        linganisha r3d, AST_NYOTA_ELEKEZA
        ruka .call_nyota_ya kama ==
        linganisha r3d, AST_WAKATI
        ruka .call_wakati kama ==
        linganisha r3d, AST_FANYA
        ruka .call_fanya kama ==
        linganisha r3d, AST_VUNJA
        ruka .call_vunja kama ==

        linganisha r3d, AST_ENDELEA
        ruka .call_endelea kama ==

        ; Wanachama wa muundo: m.chanzo (nukta) na p->inayofuata (mshale)
        linganisha r3d, AST_ELEKEZA_JINA
        ruka .call_mwanachama kama ==
        linganisha r3d, AST_ENEKEZA_FUNGO
        ruka .call_mwanachama kama ==

        ; Unari hasi: -usemi (AST_HASILI)
        linganisha r3d, AST_HASILI
        ruka .call_hasili kama ==
        ; Kukanusha kimantiki: !usemi (AST_MAKOSA)
        linganisha r3d, AST_MAKOSA
        ruka .call_makosa kama ==
        ; Kukanusha biti: ~usemi (AST_MAKOSA_BITI)
        linganisha r3d, AST_MAKOSA_BITI
        ruka .call_makosa_biti kama ==

        linganisha r3d, AST_HALISI_D
        ruka .call_halisi_d kama ==

        ; Chaguo-msingi: rudisha 0
        r0d ^= r0d
        ruka .done

.call_halisi_d:
        ita uzalishaji_halisi_d
        ruka .done

.call_nambari:
        ita uzalishaji_nambari
        ruka .done
.call_jina:
        ita uzalishaji_jina
        ruka .done
.call_rudisha:
        ita uzalishaji_rudisha
        r0d ^= r0d   ; rudisha haina thamani
        ruka .done
.call_tangazo:
        ita uzalishaji_tangazo
        ruka .done
.call_kauli:
        ita uzalishaji_kauli_ya_binary
        ruka .done
.call_wambile:
        ita uzalishaji_wambile
        ruka .done
.call_kama:
        ita uzalishaji_kama
        r0d ^= r0d
        ruka .done
.call_block:
        ita uzalishaji_block
        r0d ^= r0d
        ruka .done
.call_kazi:
        ita uzalishaji_kazi
        r0d ^= r0d
        ruka .done
.call_kielelezo:
        ita uzalishaji_kielelezo
        ruka .done
.call_anwani_ya:
        ita uzalishaji_anwani_ya
        ruka .done
.call_nyota_ya:
        ita uzalishaji_nyota_ya
        ruka .done
.call_wakati:
        ita uzalishaji_wakati
        r0d ^= r0d
        ruka .done
.call_fanya:
        ita uzalishaji_fanya
        r0d ^= r0d
        ruka .done
.call_vunja:
        ita uzalishaji_vunja
        r0d ^= r0d
        ruka .done

.call_endelea:
        ita uzalishaji_endelea
        r0d ^= r0d
        ruka .done
.call_mwanachama:
        ita uzalishaji_mwanachama
        ruka .done

.call_hasili:
        r12d = n32[ast_kushoto + r12*4]
        ; Kuelea? (operanda ni D64) — zidisha kwa -1.0
        ; (xorpd yenye operanda ya kumbukumbu imeonekana kuvunjika
        ; kwenye VM ya mtumiaji — SI_KERNEL — wakati movsd/mulsd m64
        ; zinafanya kazi; mulsd kwa -1.0 ni sawa na inayobebeka.)
        sukuma r12
        ita fumbua_aina
        vuta r12
        linganisha r0d, 7
        ruka .hasili_kamili kama !=

        ita uzalishaji_ast   ; operanda → xmm0

        ; Thabiti ya -1.0 (0xBFF0000000000000) kwenye .data
        r0 = n64[data_buf_pos]
        r0 += 7
        r0 &= ~7
        r1 = r0   ; mwanzo wa thabiti
        r0 += 8
        linganisha r0, DATA_BUF_SIZE
        ruka .hasili_data_jaa kama >a
        n64[data_buf_pos] = r0
        n32[data_buf + r1] = 0
        n32[data_buf + r1 + 4] = 0xBFF00000

        ; mulsd xmm0, [disp32] -> f2 0f 59 05 d32
        r0b = 0xF2
        ita gen_baiti
        r0b = 0x0F
        ita gen_baiti
        r0b = 0x59
        ita gen_baiti
        r0b = 0x05
        ita gen_baiti
        ; RELA ya .data (addend = data_offset - 4)
        r7 = n64[rela_count]
        linganisha r7, MAX_RELOCS - 1
        ruka .hasili_rela_jaa kama >=a
        r2d = n32[text_buf_pos]
        n32[rela_offset + r7*4] = r2d
        n32[rela_sym + r7*4] = -1
        r1d -= 4
        n32[rela_addend + r7*4] = r1d
        n64[rela_count]++
        r7d = 0
        ita gen_neno4

        r0d = -1   ; CT haijulikani
        ruka .done
.hasili_rela_jaa:
        r7 = &[msg_rela_full]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.hasili_data_jaa:
        r7 = &[msg_databuf]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.hasili_kamili:
        ita uzalishaji_ast
        ; N64 au kielekezi: kukanusha kwa baiti 8 — mov rcx, rax;
        ; xor eax, eax; sub rax, rcx (0 - thamani), sawa na mnyororo
        ; wa .swa kwa upana wa baiti 8.
        sukuma r12
        ita fumbua_aina
        vuta r12
        linganisha r0d, 4
        ruka .hasili_64 kama ==
        pima r3d, r3d
        ruka .hasili_64 kama >n
        ; neg eax → f7 d8
        r0b = 0xf7
        ita gen_baiti
        r0b = 0xd8
        ita gen_baiti
        ; cdqe → 48 98: panua ishara hadi baiti 8 (N64 x = -30 lazima
        ; ihifadhiwe kama -30, si 4294967266 — upanuzi wa sifuri).
        r0b = 0x48
        ita gen_baiti
        r0b = 0x98
        ita gen_baiti
        r0d = -r0d
        ruka .done
.hasili_64:
        ; mov rcx, rax → 48 89 c1
        r0b = 0x48
        ita gen_baiti
        r0b = 0x89
        ita gen_baiti
        r0b = 0xc1
        ita gen_baiti
        ; xor eax, eax → 31 c0
        r0b = 0x31
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; sub rax, rcx → 48 29 c8
        r0b = 0x48
        ita gen_baiti
        r0b = 0x29
        ita gen_baiti
        r0b = 0xc8
        ita gen_baiti
        ruka .done

.call_makosa:
        ; r13 huwekwa kwa operanda: uzalishaji_ast na fumbua_aina
        ; huhifadhi r13 (zote mbili hupushia r13-r15)
        r13d = n32[ast_kushoto + r12*4]   ; operanda
        r12d = r13d
        ita uzalishaji_ast
        ; ! kwenye D64 haikubaliki (8.8) — thamani iko xmm0, si eax
        r12d = r13d
        ita fumbua_aina
        linganisha r0d, 7
        ruka .makosa_d64_kosa kama ==
        ; N64 (au kielekezi): test rax, rax → 48 85 c0
        linganisha r0d, 4
        ruka .makosa_test64 kama ==
        pima r3d, r3d
        ruka .makosa_test64 kama >n
        ; test eax,eax → 85 c0
        r0b = 0x85
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ruka .makosa_test_iko
.makosa_test64:
        r0b = 0x48
        ita gen_baiti
        r0b = 0x85
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
.makosa_test_iko:
        ; sete al → 0f 94 c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0x94
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        ; movzx eax, al → 0f b6 c0
        r0b = 0x0f
        ita gen_baiti
        r0b = 0xb6
        ita gen_baiti
        r0b = 0xc0
        ita gen_baiti
        pima r0d, r0d
        r0b = kama ==
        r0d = a r0b
        ruka .done
.makosa_d64_kosa:
        r7 = &[msg_kiambishi_1]
        ita andika_mfuatano
        r7 = &[msg_kiambishi_si]
        ita andika_mfuatano
        r7 = &[msg_kiambishi_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.call_makosa_biti:
        r13d = n32[ast_kushoto + r12*4]   ; operanda (r13 huhifadhiwa na zote mbili)
        r12d = r13d
        ita uzalishaji_ast
        ; ~ kwenye D64 haikubaliki (8.8)
        r12d = r13d
        ita fumbua_aina
        linganisha r0d, 7
        ruka .makosa_biti_d64_kosa kama ==
        ; N64 (au kielekezi): not rax → 48 f7 d0
        linganisha r0d, 4
        ruka .makosa_biti_not64 kama ==
        pima r3d, r3d
        ruka .makosa_biti_not64 kama >n
        ; not eax → f7 d0
        r0b = 0xf7
        ita gen_baiti
        r0b = 0xd0
        ita gen_baiti
        ; cdqe → 48 98: N64 d = ~0 lazima iwe -1, si 4294967295
        ; (upanuzi wa ishara baada ya kukanusha kwa biti 32).
        r0b = 0x48
        ita gen_baiti
        r0b = 0x98
        ita gen_baiti
        r0d = ~r0d
        ruka .done
.makosa_biti_not64:
        r0b = 0x48
        ita gen_baiti
        r0b = 0xf7
        ita gen_baiti
        r0b = 0xd0
        ita gen_baiti
        r0d = ~r0d
        ruka .done
.makosa_biti_d64_kosa:
        r7 = &[msg_kiambishi_1]
        ita andika_mfuatano
        r7 = &[msg_kiambishi_tilde]
        ita andika_mfuatano
        r7 = &[msg_kiambishi_2]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

.return_neg1:
        r0d = -1
.done:
        vuta r3
        vuta r12
        rudi

; =============================================================================
; Sehemu ya 7: Kitoa ELF (ELF Emitter)
; =============================================================================

; -------------------------------------------------------
; toa_elf: toa ELF .o kamili kwa stdout
; -------------------------------------------------------
toa_elf:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        ; Kokotoa ofseti za sehemu
        r12d = n32[text_buf_pos]   ; text_size
        r13d = n32[data_buf_pos]   ; data_size

        ; symtab: 1 (null) + lebo + vigeu vya ulimwengu + nje
        r14 = n64[label_count]
        r14 += n64[global_count]
        r14 += n64[extern_count]
        r14++   ; +1 kwa null
        r14 = r14 * 24   ; baiti 24 kwa ingizo
        r15d = r14d   ; symtab_size

        ; strtab: hesabu ukubwa kwa kutembea majina yote
        ita toa_elf_hesabu_strtab
        r13d = r0d   ; strtab_size

        ; rela: 24 baiti kwa ingizo
        r14 = n64[rela_count]
        r14 = r14 * 24
        r2d = r14d   ; rela_size

        ; Ofseti za sehemu
        ; text_off = 64
        ; data_off = 64 + text_size
        ; symtab_off = data_off + data_size
        ; strtab_off = symtab_off + symtab_size
        ; rela_off = strtab_off + strtab_size
        ; shstrtab_off = rela_off + rela_size
        ; shoff = shstrtab_off + 55

        r8d = 64   ; text_off
        r9d = r8d
        r9d += r12d   ; data_off
        r10d = r9d
        r10d += n32[data_buf_pos]   ; symtab_off
        r11d = r10d
        r11d += r15d   ; strtab_off
        r12d = r11d
        r12d += r13d   ; rela_off (tunatumia strtab_size kwenye r13)
        r13d = r12d
        r13d += r2d   ; shstrtab_off
        r14d = r13d
        r14d += SHSTRTAB_SIZE   ; shoff

        ; Hifadhi ofseti muhimu kwenye stack
        sukuma r15   ; symtab_size
        sukuma r10   ; symtab_off
        sukuma r12   ; rela_off
        sukuma r13   ; shstrtab_off
        sukuma r14   ; shoff

        ; 1. Andika kichwa cha ELF
        ita toa_elf_kichwa

        ; 2. Andika .text
        r6 = &[text_buf]
        r2d = n32[text_buf_pos]
        linganisha r2d, 0
        ruka .skip_text kama ==
        ita sys_write_buf
.skip_text:

        ; 3. Andika .data
        r6 = &[data_buf]
        r2d = n32[data_buf_pos]
        linganisha r2d, 0
        ruka .skip_data kama ==
        ita sys_write_buf
.skip_data:

        ; 4. Andika .symtab
        ita toa_elf_symtab

        ; 5. Andika .strtab
        ita toa_elf_strtab

        ; 6. Andika .rela.text
        ita toa_elf_rela

        ; 7. Andika .shstrtab
        ita toa_elf_shstrtab

        ; 8. Andika vichwa vya sehemu
        vuta r14   ; shoff
        vuta r13   ; shstrtab_off
        vuta r12   ; rela_off
        vuta r10   ; symtab_off
        vuta r15   ; symtab_size
        ; Tunahitaji strtab_size na strtab_off pia
        ; Hizo ziko kwenye r11 na r13 (kabla ya kubadilishwa)
        ita toa_elf_sehemu_vichwa

        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; toa_elf_hesabu_strtab: hesabu ukubwa wa .strtab
;   rax = ukubwa
; -------------------------------------------------------
toa_elf_hesabu_strtab:
        sukuma r12
        sukuma r13
        sukuma r14

        ; Anza na baiti 1 kwa "\0"
        r14d = 1

        ; Pitia lebo zote
        r12d ^= r12d
        r13 = n64[label_count]
.lebo_loop:
        linganisha r12, r13
        ruka .lebo_done kama >=a
        r7 = n64[label_name + r12*8]
        ita urefu_wa_mfuatano
        r14 += r0
        r14++   ; +1 kwa '\0'
        r12++
        ruka .lebo_loop
.lebo_done:

        ; Pitia nje zote
        r12d ^= r12d
        r13 = n64[extern_count]
.nje_loop:
        linganisha r12, r13
        ruka .nje_done kama >=a
        r7 = n64[extern_name + r12*8]
        ita urefu_wa_mfuatano
        r14 += r0
        r14++
        r12++
        ruka .nje_loop
.nje_done:

        ; Pitia vigeu vya ulimwengu
        r12d ^= r12d
        r13 = n64[global_count]
.ulimwengu_loop:
        linganisha r12, r13
        ruka .ulimwengu_done kama >=a
        r7 = n64[global_name + r12*8]
        ita urefu_wa_mfuatano
        r14 += r0
        r14++
        r12++
        ruka .ulimwengu_loop
.ulimwengu_done:

        r0d = r14d
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; toa_elf_kichwa: andika kichwa cha ELF kwa stdout
;   inatumia ofseti zilizo kwenye stack
; -------------------------------------------------------
toa_elf_kichwa:
        ; Hujenga na kuandika kichwa kamili cha ELF (baiti 64)
        ; Kichwa kina sehemu tatu:
        ;   1. Baiti  0-39: e_ident, e_type, e_machine, e_version, e_entry, e_phoff
        ;   2. Baiti 40-47: e_shoff (inakokotolewa wakati wa utekelezaji)
        ;   3. Baiti 48-63: e_flags, e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx
        ;
        ; Thamani ya e_shoff inapitishwa kupitia stack (r14 kwenye toa_elf)

        ; 1. Andika baiti 0-39 za kiolezo
        r6 = &[ehdr_template]
        r2 = 40
        ita sys_write_buf

        ; 2. Andika e_shoff (baiti 40-47) — thamani iliyokokotolewa
        ; Inasomwa kutoka stack: toa_elf ilisukuma r14 (shoff) kabla ya kuita
        ; Kwa wakati huu, [rsp] = return address, [rsp+8] = r14 (shoff)
        sukuma r5
        r5 = r4
        r7 = n64[r5+16]   ; shoff kutoka stack ya toa_elf
        vuta r5
        ita andika_neno8_moja_kwa_moja

        ; 3. Andika baiti 48-63 za kiolezo (e_flags hadi mwisho)
        r6 = &[ehdr_template + 48]
        r2 = 16
        ita sys_write_buf

        rudi

; -------------------------------------------------------
; toa_elf_symtab: andika .symtab kwa stdout
; -------------------------------------------------------
toa_elf_symtab:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        ; Ingizo la null
        r7d = 0
        ita andika_neno4_moja_kwa_moja   ; st_name
        ita andika_neno4_moja_kwa_moja   ; st_info + st_other + st_shndx (zote 0)
        ita andika_neno8_moja_kwa_moja   ; st_value
        ita andika_neno8_moja_kwa_moja   ; st_size

        ; Alama ya sehemu: .text (faharisi 1)
        r7d = 0   ; st_name = 0
        ita andika_neno4_moja_kwa_moja
        r7b = 3   ; STB_LOCAL | STT_SECTION
        ita andika_baiti_moja_kwa_moja
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        r7w = 1   ; st_shndx = .text
        ita andika_neno2_moja_kwa_moja
        r7d = 0   ; st_value
        ita andika_neno8_moja_kwa_moja
        r7d = 0   ; st_size
        ita andika_neno8_moja_kwa_moja

        ; Alama ya sehemu: .data (faharisi 2)
        r7d = 0   ; st_name = 0
        ita andika_neno4_moja_kwa_moja
        r7b = 3   ; STB_LOCAL | STT_SECTION
        ita andika_baiti_moja_kwa_moja
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        r7w = 2   ; st_shndx = .data
        ita andika_neno2_moja_kwa_moja
        r7d = 0   ; st_value
        ita andika_neno8_moja_kwa_moja
        r7d = 0   ; st_size
        ita andika_neno8_moja_kwa_moja

        ; Kokotoa ofseti za strtab kwa kila lebo
        ; Ofseti ya kwanza baada ya \0 ni 1
        r14d = 1

        ; Ingizo kwa kila lebo (kazi)
        r12d ^= r12d
        r13 = n64[label_count]
.lebo_loop:
        linganisha r12, r13
        ruka .lebo_done kama >=a

        ; st_name = ofseti kwenye strtab
        r7d = r14d
        ita andika_neno4_moja_kwa_moja

        ; st_info = 18 (STB_GLOBAL | STT_FUNC)
        r7b = 18
        ita andika_baiti_moja_kwa_moja
        ; st_other = 0
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        ; st_shndx = 1 (.text)
        r7w = 1
        ita andika_neno2_moja_kwa_moja

        ; st_value = ofseti kwenye .text
        r7d = n32[label_offset + r12*4]
        ita andika_neno8_moja_kwa_moja

        ; st_size = ukubwa wa kazi
        r7d = n32[label_size + r12*4]
        ita andika_neno8_moja_kwa_moja

        ; Sasisha ofseti ya strtab
        r7 = n64[label_name + r12*8]
        ita urefu_wa_mfuatano
        r14d += r0d
        r14d++   ; +1 kwa '\0'

        r12++
        ruka .lebo_loop
.lebo_done:

        ; Ingizo kwa kila nje
        r12d ^= r12d
        r13 = n64[extern_count]
.nje_loop:
        linganisha r12, r13
        ruka .nje_done kama >=a

        r7d = r14d
        ita andika_neno4_moja_kwa_moja
        r7b = 0   ; STB_LOCAL, STT_NOTYPE (UNDEF)
        ita andika_baiti_moja_kwa_moja
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        r7w = 0   ; st_shndx = 0 (UNDEF)
        ita andika_neno2_moja_kwa_moja
        ; st_value = 0
        ita andika_neno8_moja_kwa_moja
        ; st_size = 0
        ita andika_neno8_moja_kwa_moja

        r7 = n64[extern_name + r12*8]
        ita urefu_wa_mfuatano
        r14d += r0d
        r14d++

        r12++
        ruka .nje_loop
.nje_done:

        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; toa_elf_strtab: andika .strtab kwa stdout
; -------------------------------------------------------
toa_elf_strtab:
        sukuma r12
        sukuma r13
        sukuma r14

        ; Anza na '\0'
        r7b = 0
        ita andika_baiti_moja_kwa_moja

        ; Andika majina ya lebo
        r12d ^= r12d
        r13 = n64[label_count]
.lebo_loop:
        linganisha r12, r13
        ruka .lebo_done kama >=a
        r7 = n64[label_name + r12*8]
        ita andika_mfuatano
        r12++
        ruka .lebo_loop
.lebo_done:

        ; Andika majina ya nje
        r12d ^= r12d
        r13 = n64[extern_count]
.nje_loop:
        linganisha r12, r13
        ruka .nje_done kama >=a
        r7 = n64[extern_name + r12*8]
        ita andika_mfuatano
        r12++
        ruka .nje_loop
.nje_done:

        ; Andika majina ya vigezo vya ulimwengu
        r12d ^= r12d
        r13 = n64[global_count]
.ulimwengu_loop:
        linganisha r12, r13
        ruka .ulimwengu_done kama >=a
        r7 = n64[global_name + r12*8]
        ita andika_mfuatano
        r12++
        ruka .ulimwengu_loop
.ulimwengu_done:

        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; toa_elf_rela: andika .rela.text kwa stdout
; -------------------------------------------------------
toa_elf_rela:
        sukuma r12
        sukuma r13

        r12d ^= r12d
        r13 = n64[rela_count]
.loop:
        linganisha r12, r13
        ruka .done kama >=a

        ; r_offset
        r7d = n32[rela_offset + r12*4]
        ita andika_neno8_moja_kwa_moja
        ; r_info = ELF64_R_INFO(sym, R_X86_64_PC32)
        ; Aina = 2 (R_X86_64_PC32)
        r7d = n32[rela_sym + r12*4]
        ; Angalia ikiwa ni rekebisho la .data (rela_sym == -1)
        linganisha r7d, -1
        ruka .reloc_extern kama !=
        ; Rekebisho la .data: tumia faharisi ya sehemu 2 (.data)
        r7d = 2
        ruka .reloc_info
.reloc_extern:
        ; Rekebisho la nje: faharisi = 3 + label_count + global_count + extern_idx
        r7d += 3
        r7d += n32[label_count]
        r7d += n32[global_count]
.reloc_info:
        r7 <<= 32
        r7 |= 2
        ita andika_neno8_moja_kwa_moja
        ; r_addend kutoka rela_addend (inaweza kuwa hasi)
        r7 = n32[rela_addend + r12*4]
        ita andika_neno8_moja_kwa_moja

        r12++
        ruka .loop
.done:
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; toa_elf_shstrtab: andika .shstrtab kwa stdout
; -------------------------------------------------------
toa_elf_shstrtab:
        r6 = &[shstrtab_data]
        r2d = SHSTRTAB_SIZE
        ita sys_write_buf
        rudi

; -------------------------------------------------------
; toa_elf_sehemu_vichwa: andika vichwa vya sehemu kwa stdout
;   r8 = text_off, r9 = data_off, r10 = symtab_off
;   r11 = strtab_off (imebadilishwa), r12 = rela_off, r13 = shstrtab_off
;   r14 = shoff, r15 = symtab_size
;   pia inahitaji strtab_size
; -------------------------------------------------------
toa_elf_sehemu_vichwa:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        ; Hali ni ngumu kwa sababu tumepoteza baadhi ya maadili.
        ; Kwa sasa, tunatoa vichwa vya sehemu vilivyo ngumu.
        ; Hii ni ya muda — tutakokotoa upya.

        ; NULL sehemu (baiti 64 za sifuri)
        r1d = 16
        r7d ^= r7d
.null_loop:
        sukuma r1
        ita andika_neno4_moja_kwa_moja
        vuta r1
        zunguka .null_loop

        ; Kwa sasa tunatoa vichwa vilivyo ngumu kwa sehemu zilizobaki
        ; Hii itarekebishwa wakati uzalishaji kamili utakapofanya kazi

        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; =============================================================================
; Sehemu ya 8: Programu Kuu (_start)
; =============================================================================

anza:
        ; Weka stack frame ya msingi
        r5d ^= r5d
        r5 = r4

        ; Weka upya hali ya mkusanyaji
        n64[compiler_state] = 0
        n64[token_count] = 0
        n64[token_pos] = 0
        n64[ast_count] = 0
        n64[str_pool_pos] = 0
        n64[text_buf_pos] = 0
        n64[data_buf_pos] = 0
        n64[label_count] = 0
        n64[extern_count] = 0
        n64[rela_count] = 0
        n64[global_count] = 0
        n64[bss_size] = 0
        n64[local_count] = 0
        n64[gen_label_count] = 0
        n64[gen_fixup_count] = 0

        ; Weka '\0' mwanzoni mwa bwawa la herufi
        n8[str_pool] = 0
        n64[str_pool_pos]++

        ; Angalia hoja za mstari wa amri
        vuta r0   ; argc
        n64[tmp_argc] = r0
        linganisha r0, 1
        ruka .tumia_stdin kama <=n

        ; Tuna hoja — argv[1] inaweza kuwa "--exe" au jina la faili
        vuta r7   ; argv[0] — ruka
        vuta r7   ; argv[1]
        r6 = &[jina_exe_flag]
        ita linganisha_mfuatano
        linganisha r0d, 0
        ruka .soma_faili_argv1 kama !=
        n8[exe_mode] = 1
        ; Kama kuna argv[2], soma faili — sivyo tumia stdin
        r0 = n64[tmp_argc]
        linganisha r0, 3
        ruka .tumia_stdin kama <n
        vuta r7   ; argv[2]
        ita soma_chanzo_kutoka_faili
        ruka .anza_kukusanya

.soma_faili_argv1:
        ita soma_chanzo_kutoka_faili
        ruka .anza_kukusanya

.tumia_stdin:
        ; Soma kutoka stdin
        ita soma_chanzo_kutoka_stdin

.anza_kukusanya:
        ; Changanua chanzo kuwa tokeni
        ita changanua_chanzo

        ; Changanua tokeni kuwa AST
        ita changanua_programu
        r12d = r0d   ; mzizi wa AST

        linganisha r12d, -1
        ruka .parse_error kama ==

        ; Zalisha msimbo kutoka AST
        ; Pitia matamko yote kwenye mzizi
        r13d = n32[ast_kushoto + r12*4]   ; tamko la kwanza
.gen_loop:
        linganisha r13d, -1
        ruka .gen_done kama ==

        linganisha n32[ast_aina + r13*4], AST_KAZI
        ruka .gen_next kama !=

        ; Angalia ikiwa kazi ina mwili (sio tangazo la mbele)
        linganisha n32[ast_kulia + r13*4], -1
        ruka .gen_next kama ==

        sukuma r12
        sukuma r13
        r12d = r13d
        ita uzalishaji_ast
        vuta r13
        vuta r12

.gen_next:
        r13d = n32[ast_nne + r13*4]
        ruka .gen_loop

.gen_done:
        ; Toa ELF kwa stdout — hali ya exe inatoa ET_EXEC tuli
        ; moja kwa moja (hakuna ld, hakuna libc): 0% bootstrap gap.
        linganisha n8[exe_mode], 0
        ruka .toa_o kama ==
        ita toa_exe
        r7d ^= r7d
        ita sys_exit
.toa_o:
        ita toa_elf_rahisi

        ; Toka kwa mafanikio
        r7d ^= r7d
        ita sys_exit

.parse_error:
        r7 = &[msg_parseerr]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit

; -------------------------------------------------------
; toa_exe: toa ET_EXEC tuli moja kwa moja — hakuna ld, hakuna libc.
;   Hii ndiyo hatua ya 0% bootstrap gap: mbegu inajenga exe ya
;   stage1 bila kiunganishi chochote.
;   Mpangilio wa faili: kichwa (64) + phdr (56) + stub ya _start
;   (28) + .text + .data. .bss inafunikwa na p_memsz pekee.
;   Awamu ya 1: rekebisha RELA zote kwenye text_buf (disp32).
;   Awamu ya 2: tafuta ofseti ya main.
;   Awamu ya 3: toa kila kitu kwa stdout.
; -------------------------------------------------------
toa_exe:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15
        sukuma r3

        r12d = n32[text_buf_pos]   ; text_size
        r15d = n32[data_buf_pos]   ; data_size

        ; === Awamu ya 1: rekebisha RELA ===
        ; Ulimwengu -> data_vaddr + off (+data_size kwa bss);
        ; .data -> data_vaddr + (addend + 4); nje -> lebo ya ndani
        ; kwa jina (wito wa mbele uliandikwa kama nje).
        ; disp32 = tgt - pos - 4 (stub ya 28 hubatilika pande zote).
        r13d ^= r13d
.rela_loop:
        linganisha r13, n64[rela_count]
        ruka .rela_done kama >=a
        r14d = n32[rela_offset + r13*4]   ; pos
        r0d = n32[rela_sym + r13*4]   ; sym
        r1d = n32[rela_addend + r13*4]   ; addend

        linganisha r0d, -1
        ruka .rela_sehemu kama ==
        linganisha r0d, -1
        ruka .rela_nje kama >n
        ; --- Ulimwengu: gidx = -sym - 2 ---
        r0d = -r0d
        r0d -= 2
        r2d = n32[global_offset + r0*4]
        linganisha n32[global_is_bss + r0*4], 0
        ruka .rela_ulimwengu_tgt kama ==
        r2d += r15d   ; bss -> baada ya .data
.rela_ulimwengu_tgt:
        r2d += r12d   ; + text_size (data_vaddr = text_vaddr + text_size)
        ruka .rela_andika

.rela_sehemu:
        ; Rekebisho la .data: addend = data_offset - 4 (imefupishwa
        ; katika mbegu, si -4 kawaida). disp32 = S + addend - P:
        ; (text_size + data_offset) - 4 - pos = text_size + addend - pos.
        ; Ongeza 4 hapa kwa sababu .rela_andika huondoa pos + 4.
        r2d = r12d
        r2d += r1d
        r2d += 4
        ruka .rela_andika

.rela_nje:
        ; Tafuta lebo ya ndani kwa jina extern_name[sym].
        sukuma r13
        sukuma r14
        r3 = n64[extern_name + r0*8]
        r1d ^= r1d
.rela_nje_scan:
        linganisha r1, n64[label_count]
        ruka .rela_nje_sio kama >=a
        r7 = n64[label_name + r1*8]
        r6 = r3
        sukuma r1
        ita linganisha_mfuatano
        vuta r1
        linganisha r0d, 0
        ruka .rela_nje_iko kama ==
        r1++
        ruka .rela_nje_scan
.rela_nje_iko:
        r2d = n32[label_offset + r1*4]
        ruka .rela_nje_safu
.rela_nje_sio:
        ; Kazi iliyoitwa haijafafanuliwa popote. Zamani hii ilikuwa
        ; ikitulia kimya kwa anwani 0 na kuleta SEGV wakati wa
        ; utekelezaji — k.m. `husisha { faili.swa }` hailiwii mbegu
        ; (chanzo kinapaswa kuunganishwa) na makosa ya tahajia ya
        ; majina ya kazi yalipita hadi kwenye mchakato. Sasa inalia
        ; kwa sauti wakati wa kukusanya.
        r7 = &[msg_kazi_kukosa]
        ita andika_mfuatano
        r7 = r3   ; jina la kazi
        ita andika_mfuatano
        r7 = &[msg_mstari_mpya]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.rela_nje_safu:
        vuta r14
        vuta r13

.rela_andika:
        r2d -= r14d
        r2d -= 4   ; disp32 = tgt - pos - 4
        n32[text_buf + r14] = r2d   ; andika disp32 (baiti 4, LE)
        r13++
        ruka .rela_loop
.rela_done:

        ; === Awamu ya 1.5: rekebisha anwani za kazi kwenye .data ===
        ; Kianzio cha ulimwengu "= &jina_la_kazi" kiliandika SIFURI na
        ; kurekodi sloti yake — sasa andika anwani kamili ya kazi
        ; (0x400078 + ofseti ya lebo; kama rekebisho la .data upande wa
        ; wito). Jina lisilokuwa na lebo (wala kazi ya ndani) ni kosa
        ; la sauti — sawa na wito wa kazi usiojulikana.
        r8d ^= r8d
.dka_loop:
        linganisha r8, n64[data_kazi_anwani_idadi]
        ruka .dka_done kama >=a
        r9d = n32[data_kazi_anwani_jina + r8*4]
        r9 = &[str_pool + r9]   ; anwani ya jina la kazi
        r1d ^= r1d
.dka_skan:
        linganisha r1, n64[label_count]
        ruka .dka_kukosa kama >=a
        r7 = n64[label_name + r1*8]
        r6 = r9
        sukuma r8
        sukuma r9
        sukuma r1
        ita linganisha_mfuatano
        vuta r1
        vuta r9
        vuta r8
        linganisha r0d, 0
        ruka .dka_iko kama ==
        r1++
        ruka .dka_skan
.dka_iko:
        ; Andika anwani kamili ya kazi kwenye sloti (baiti 8, LE).
        ; Msingi wa msimbo: 0x400078 (kichwa+phdr) + stub ya baiti 28
        ; = 0x400094; kazi ya kwanza ya .text iko hapo.
        r0d = n32[label_offset + r1*4]
        r0d += 0x400094   ; msingi wa msimbo wa exe
        r2d = n32[data_kazi_anwani_ofseti + r8*4]
        n32[data_buf + r2] = r0d
        n32[data_buf + r2 + 4] = 0
        r8++
        ruka .dka_loop
.dka_kukosa:
        ; Kosa la sauti: kazi haijafafanuliwa (hakuna lebo ya ndani)
        r7 = &[msg_kazi_kukosa]
        ita andika_mfuatano
        r7 = r9
        ita andika_mfuatano
        r7 = &[msg_mstari_mpya]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.dka_done:

        ; === Awamu ya 2: tafuta ofseti ya main ===
        r1d ^= r1d
.main_scan:
        linganisha r1, n64[label_count]
        ruka .main_kukosa kama >=a
        r7 = n64[label_name + r1*8]
        r6 = &[jina_main]
        sukuma r1
        ita linganisha_mfuatano
        vuta r1
        linganisha r0d, 0
        ruka .main_iko kama ==
        r1++
        ruka .main_scan
.main_iko:
        r3d = n32[label_offset + r1*4]   ; main_off
        ruka .main_ok
.main_kukosa:
        r7 = &[msg_main_kukosa]
        ita andika_mfuatano
        r7d = 1
        ita sys_exit
.main_ok:

        ; === Awamu ya 3: toa kichwa + phdr + stub + text + data ===

        ; --- Kichwa cha ELF (baiti 64) ---
        ; e_ident: 7F 45 4C 46 02 01 01 00 + sufuri
        r7d = 0x464C457F
        ita andika_neno4_moja_kwa_moja
        r7d = 0x00010102
        ita andika_neno4_moja_kwa_moja
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        ; e_type=2 (EXEC), e_machine=0x3E
        r7d = 0x003E0002
        ita andika_neno4_moja_kwa_moja
        ; e_version=1
        r7d = 1
        ita andika_neno4_moja_kwa_moja
        ; e_entry = 0x400078
        r7d = 0x400078
        ita andika_neno4_moja_kwa_moja
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        ; e_phoff = 64
        r7d = 64
        ita andika_neno4_moja_kwa_moja
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        ; e_shoff = 0
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        ; e_flags = 0
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        ; e_ehsize=64, e_phentsize=56
        r7d = 0x00380040
        ita andika_neno4_moja_kwa_moja
        ; e_phnum=1, e_shentsize=0
        r7d = 1
        ita andika_neno4_moja_kwa_moja
        ; e_shnum=0, e_shstrndx=0
        r7d = 0
        ita andika_neno4_moja_kwa_moja

        ; --- Kichwa cha programu (baiti 56): PT_LOAD, RWX, p_offset=0 ---
        r7d = 1   ; p_type = PT_LOAD
        ita andika_neno4_moja_kwa_moja
        r7d = 7   ; p_flags = R|W|X
        ita andika_neno4_moja_kwa_moja
        r7 = 0   ; p_offset = 0
        ita andika_neno8_moja_kwa_moja
        r7 = 0x400000   ; p_vaddr
        ita andika_neno8_moja_kwa_moja
        r7 = 0x400000   ; p_paddr
        ita andika_neno8_moja_kwa_moja
        ; p_filesz = 120 (kichwa+phdr) + 28 (stub) + text + data
        r14d = r12d
        r14d += r15d
        r14d += 148
        r7 = r14
        ita andika_neno8_moja_kwa_moja
        ; p_memsz = filesz + bss
        r14d += n32[bss_size]
        r7 = r14
        ita andika_neno8_moja_kwa_moja
        r7 = 0x1000   ; p_align
        ita andika_neno8_moja_kwa_moja

        ; --- Stub ya _start (baiti 28) ---
        ; Maneno 7 ya N32 — sawa na uzalishaji.swa (kipande32).
        ; 48 8B 3C 24 — mov rdi, [rsp] (argc)
        r7d = 607947592
        ita andika_neno4_moja_kwa_moja
        ; 48 8D 74 24 — lea rsi, [rsp+8] (argv), baiti ya mwisho kwenye neno linalofuata
        r7d = 611618120
        ita andika_neno4_moja_kwa_moja
        ; 08 B0 00 E8 — mwisho wa lea + mov al,0 + call (disp32 inafuata)
        r7d = 3892359176
        ita andika_neno4_moja_kwa_moja
        ; disp32 = main_off + 12 (wito uko baiti 11-14, kifuatacho 16)
        r7d = r3d
        r7d += 12
        ita andika_neno4_moja_kwa_moja
        ; 48 89 C7 B8 — mov rdi, rax + mwanzo wa mov eax, 60
        r7d = 3100084552
        ita andika_neno4_moja_kwa_moja
        ; 3C 00 00 00 — mwisho wa mov eax, 60
        r7d = 60
        ita andika_neno4_moja_kwa_moja
        ; 0F 05 00 00 — syscall + padding
        r7d = 1295
        ita andika_neno4_moja_kwa_moja

        ; --- .text (stub tayari imetolewa) ---
        r1d ^= r1d
.text_loop:
        linganisha r1d, r12d
        ruka .text_done kama >=a
        r7d = a8[text_buf + r1]
        sukuma r1
        ita andika_baiti_moja_kwa_moja
        vuta r1
        r1++
        ruka .text_loop
.text_done:

        ; --- .data ---
        r1d ^= r1d
.data_loop:
        linganisha r1d, r15d
        ruka .data_done kama >=a
        r7d = a8[data_buf + r1]
        sukuma r1
        ita andika_baiti_moja_kwa_moja
        vuta r1
        r1++
        ruka .data_loop
.data_done:

        vuta r3
        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; toa_elf_rahisi: toleo rahisi la kutoa ELF
;   Hii inajenga ELF .o moja kwa moja kwa kutumia
;   vibafa vilivyojazwa na vizalishe.
; -------------------------------------------------------
toa_elf_rahisi:
        sukuma r12
        sukuma r13
        sukuma r14
        sukuma r15

        ; Kokotoa ukubwa na ofseti zote
        r12d = n32[text_buf_pos]   ; text_size
        r0d = n32[data_buf_pos]   ; data_size
        r3d = r0d

        ; Hesabu symtab_size
        r14 = n64[label_count]   ; idadi ya lebo
        r14 += n64[global_count]   ; + vigeu vya ulimwengu
        ; Nje zisizo-duplicate (kwa sasa tunachukulia zote ni za kipekee)
        r15 = n64[extern_count]
        r14 += r15
        r14 += 4   ; +1 kwa null + 3 za alama za sehemu (.text, .data, .bss)
        r14 = r14 * 24
        r13d = r14d   ; symtab_size

        ; Hesabu ukubwa wa strtab
        ; Anza na 1 kwa '\0' ya kwanza
        r14d = 1

        ; Ongeza urefu wa kila jina la lebo
        r1d ^= r1d
.str_loop:
        linganisha r1, n64[label_count]
        ruka .str_done_labels kama >=a
        r7 = n64[label_name + r1*8]
        sukuma r1
        ita urefu_wa_mfuatano
        vuta r1
        r14d += r0d
        r14d++   ; +1 kwa '\0'
        r1++
        ruka .str_loop
.str_done_labels:

        ; Ongeza majina ya vigeu vya ulimwengu
        r1d ^= r1d
.str_global_loop:
        linganisha r1, n64[global_count]
        ruka .str_done_globals kama >=a
        r7 = n64[global_name + r1*8]
        sukuma r1
        ita urefu_wa_mfuatano
        vuta r1
        r14d += r0d
        r14d++
        r1++
        ruka .str_global_loop
.str_done_globals:

        ; Ongeza majina ya nje
        r1d ^= r1d
.str_extern_loop:
        linganisha r1, n64[extern_count]
        ruka .str_done_externs kama >=a
        r7 = n64[extern_name + r1*8]
        sukuma r1
        ita urefu_wa_mfuatano
        vuta r1
        r14d += r0d
        r14d++
        r1++
        ruka .str_extern_loop
.str_done_externs:

        r10d = r14d   ; strtab_size

        ; rela_size
        r14 = n64[rela_count]
        r14 = r14 * 24
        r11d = r14d   ; rela_size

        ; Panga ofseti
        r8d = 64   ; text_off (baada ya kichwa cha ELF)
        r9d = r8d
        r9d += r12d   ; data_off
        r7d = r9d
        r7d += r3d   ; symtab_off
        r0d = r7d
        r0d += r13d   ; strtab_off
        r6d = r0d
        r6d += r10d   ; rela_off
        r2d = r6d
        r2d += r11d   ; shstrtab_off
        r1d = r2d
        r1d += SHSTRTAB_SIZE   ; shoff

        ; Hifadhi kwenye stack
        sukuma r7   ; symtab_off
        sukuma r0   ; strtab_off
        sukuma r6   ; rela_off
        sukuma r2   ; shstrtab_off
        sukuma r1   ; shoff
        sukuma r13   ; symtab_size
        sukuma r10   ; strtab_size

        ; === ANDIKA KICHWA CHA ELF ===

        ; Magic na EI
        r7d = 0x464c457f   ; ELF magic (little-endian)
        ; Andika baiti kwa baiti kwenye bafa la muda, kisha toa
        ; Tunajenga kichwa kwenye tmp_buf
        r15 = &[tmp_buf]

        ; e_ident[0:4] = ELF magic
        n32[r15] = 0x464c457f
        ; e_ident[4] = EI_CLASS (2)
        n8[r15 + 4] = 2
        ; e_ident[5] = EI_DATA (1)
        n8[r15 + 5] = 1
        ; e_ident[6] = EI_VERSION (1)
        n8[r15 + 6] = 1
        ; e_ident[7] = EI_OSABI (0)
        n8[r15 + 7] = 0
        ; e_ident[8:16] = padding
        n64[r15 + 8] = 0
        ; e_type = ET_REL (1)
        n16[r15 + 16] = 1
        ; e_machine = EM_X86_64 (62)
        n16[r15 + 18] = 62
        ; e_version = 1
        n32[r15 + 20] = 1
        ; e_entry = 0
        n64[r15 + 24] = 0
        ; e_phoff = 0
        n64[r15 + 32] = 0
        ; e_shoff = itajazwa
        vuta r0   ; strtab_size (tunachukua kutoka stack vibaya)
        vuta r3   ; symtab_size
        vuta r1   ; shoff
        n64[r15 + 40] = r1
        ; e_flags = 0
        n32[r15 + 48] = 0
        ; e_ehsize = 64
        n16[r15 + 52] = 64
        ; e_phentsize = 0
        n16[r15 + 54] = 0
        ; e_phnum = 0
        n16[r15 + 56] = 0
        ; e_shentsize = 64
        n16[r15 + 58] = 64
        ; e_shnum = 8 (.null, .text, .data, .symtab, .strtab, .rela.text, .shstrtab, .bss)
        n16[r15 + 60] = 8
        ; e_shstrndx = 6 (.shstrtab iko kabla ya .bss)
        n16[r15 + 62] = 6

        ; Andika kichwa (baiti 64) kwa stdout
        r6 = &[tmp_buf]
        r2d = 64
        ita sys_write_buf

        ; Rejesha maadili kutoka stack
        ; Sasa stack ina: symtab_off, strtab_off, rela_off, shstrtab_off
        ; Tunazihitaji baadaye kwa vichwa vya sehemu
        vuta r15   ; symtab_off (tulivuta vibaya, rekebisha)
        vuta r14   ; strtab_off
        vuta r13   ; rela_off
        vuta r12   ; shstrtab_off
        ; shoff tayari imetumiwa

        ; === ANDIKA .text ===
        r6 = &[text_buf]
        r2d = n32[text_buf_pos]
        linganisha r2d, 0
        ruka .skip_text kama ==
        ita sys_write_buf
.skip_text:

        ; === ANDIKA .data ===
        r6 = &[data_buf]
        r2d = n32[data_buf_pos]
        linganisha r2d, 0
        ruka .skip_data kama ==
        ita sys_write_buf
.skip_data:

        ; === ANDIKA .symtab ===
        sukuma r15   ; symtab_off (hifadhi kwa vichwa vya sehemu)
        sukuma r14   ; strtab_off
        sukuma r13   ; rela_off
        sukuma r12   ; shstrtab_off

        ita toa_elf_symtab_rahisi

        ; === ANDIKA .strtab ===
        ita toa_elf_strtab_rahisi

        ; === ANDIKA .rela.text ===
        ita toa_elf_rela_rahisi

        ; === ANDIKA .shstrtab ===
        r6 = &[shstrtab_data]
        r2d = SHSTRTAB_SIZE
        ita sys_write_buf

        ; === ANDIKA VICHWA VYA SEHEMU ===
        vuta r12   ; shstrtab_off
        vuta r13   ; rela_off
        vuta r14   ; strtab_off
        vuta r15   ; symtab_off

        ita toa_elf_vichwa_vya_sehemu_rahisi

        vuta r15
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; toa_elf_symtab_rahisi: toleo rahisi la .symtab
; -------------------------------------------------------
toa_elf_symtab_rahisi:
        sukuma r12
        sukuma r13
        sukuma r14

        ; Ingizo la null (baiti 24 za sifuri)
        r1d = 6
        r7d ^= r7d
.null_loop:
        sukuma r1
        ita andika_neno4_moja_kwa_moja
        vuta r1
        zunguka .null_loop

        ; Alama ya sehemu: .text (faharisi 1)
        r7d = 0   ; st_name = 0
        ita andika_neno4_moja_kwa_moja
        r7b = 3   ; STB_LOCAL | STT_SECTION
        ita andika_baiti_moja_kwa_moja
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        r7w = 1   ; st_shndx = .text
        ita andika_neno2_moja_kwa_moja
        r7d = 0   ; st_value = 0
        ita andika_neno8_moja_kwa_moja
        r7d = 0   ; st_size = 0
        ita andika_neno8_moja_kwa_moja

        ; Alama ya sehemu: .data (faharisi 2)
        r7d = 0   ; st_name = 0
        ita andika_neno4_moja_kwa_moja
        r7b = 3   ; STB_LOCAL | STT_SECTION
        ita andika_baiti_moja_kwa_moja
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        r7w = 2   ; st_shndx = .data
        ita andika_neno2_moja_kwa_moja
        r7d = 0   ; st_value = 0
        ita andika_neno8_moja_kwa_moja
        r7d = 0   ; st_size = 0
        ita andika_neno8_moja_kwa_moja

        ; Alama ya sehemu: .bss (faharisi 3)
        r7d = 0   ; st_name = 0
        ita andika_neno4_moja_kwa_moja
        r7b = 3   ; STB_LOCAL | STT_SECTION
        ita andika_baiti_moja_kwa_moja
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        r7w = 7   ; st_shndx = .bss (sehemu ya 7)
        ita andika_neno2_moja_kwa_moja
        r7d = 0   ; st_value = 0
        ita andika_neno8_moja_kwa_moja
        r7d = 0   ; st_size = 0
        ita andika_neno8_moja_kwa_moja

        ; Kokotoa ofseti za strtab kwa kila jina
        r14d = 1   ; ofseti ya kwanza baada ya '\0'

        ; Andika lebo
        r12d ^= r12d
        r13 = n64[label_count]
.lebo_loop:
        linganisha r12, r13
        ruka .lebo_done kama >=a

        r7d = r14d
        ita andika_neno4_moja_kwa_moja
        r7b = 18   ; STB_GLOBAL | STT_FUNC
        ita andika_baiti_moja_kwa_moja
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        r7w = 1   ; .text
        ita andika_neno2_moja_kwa_moja
        r7d = n32[label_offset + r12*4]
        ita andika_neno8_moja_kwa_moja
        r7d = n32[label_size + r12*4]
        ita andika_neno8_moja_kwa_moja

        r7 = n64[label_name + r12*8]
        ita urefu_wa_mfuatano
        r14d += r0d
        r14d++

        r12++
        ruka .lebo_loop
.lebo_done:

        ; Andika vigeu vya ulimwengu
        r12d ^= r12d
        r13 = n64[global_count]
.ulimwengu_loop:
        linganisha r12, r13
        ruka .ulimwengu_done kama >=a

        r7d = r14d
        ita andika_neno4_moja_kwa_moja
        r7b = 17   ; STB_GLOBAL | STT_OBJECT
        ita andika_baiti_moja_kwa_moja
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        ; st_shndx = 2 (.data) au 7 (.bss) kulingana na global_is_bss
        r7d = n32[global_is_bss + r12*4]
        linganisha r7d, 0
        ruka .ulimwengu_data kama ==
        r7w = 7   ; .bss
        ruka .ulimwengu_shndx
.ulimwengu_data:
        r7w = 2   ; .data
.ulimwengu_shndx:
        ita andika_neno2_moja_kwa_moja
        r7d = n32[global_offset + r12*4]
        ita andika_neno8_moja_kwa_moja
        r7d = n32[global_size + r12*4]
        ita andika_neno8_moja_kwa_moja

        r7 = n64[global_name + r12*8]
        ita urefu_wa_mfuatano
        r14d += r0d
        r14d++

        r12++
        ruka .ulimwengu_loop
.ulimwengu_done:

        ; Andika nje
        r12d ^= r12d
        r13 = n64[extern_count]
.nje_loop:
        linganisha r12, r13
        ruka .nje_done kama >=a

        r7d = r14d
        ita andika_neno4_moja_kwa_moja
        r7b = 16   ; STB_GLOBAL | STT_FUNC (UNDEF kwa kuwa shndx=0)
        ita andika_baiti_moja_kwa_moja
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        r7w = 0   ; UNDEF
        ita andika_neno2_moja_kwa_moja
        r7d = 0
        ita andika_neno8_moja_kwa_moja
        r7d = 0
        ita andika_neno8_moja_kwa_moja

        r7 = n64[extern_name + r12*8]
        ita urefu_wa_mfuatano
        r14d += r0d
        r14d++

        r12++
        ruka .nje_loop
.nje_done:

        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; toa_elf_strtab_rahisi: toleo rahisi la .strtab
; -------------------------------------------------------
toa_elf_strtab_rahisi:
        sukuma r12
        sukuma r13

        ; '\0'
        r7b = 0
        ita andika_baiti_moja_kwa_moja

        ; Majina ya lebo
        r12d ^= r12d
        r13 = n64[label_count]
.lebo_loop:
        linganisha r12, r13
        ruka .lebo_done kama >=a
        r7 = n64[label_name + r12*8]
        ita andika_mfuatano
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        r12++
        ruka .lebo_loop
.lebo_done:

        ; Majina ya vigeu vya ulimwengu
        r12d ^= r12d
        r13 = n64[global_count]
.ulimwengu_loop:
        linganisha r12, r13
        ruka .ulimwengu_done kama >=a
        r7 = n64[global_name + r12*8]
        ita andika_mfuatano
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        r12++
        ruka .ulimwengu_loop
.ulimwengu_done:

        ; Majina ya nje
        r12d ^= r12d
        r13 = n64[extern_count]
.nje_loop:
        linganisha r12, r13
        ruka .nje_done kama >=a
        r7 = n64[extern_name + r12*8]
        ita andika_mfuatano
        r7b = 0
        ita andika_baiti_moja_kwa_moja
        r12++
        ruka .nje_loop
.nje_done:

        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; toa_elf_rela_rahisi: toleo rahisi la .rela.text
; -------------------------------------------------------
toa_elf_rela_rahisi:
        sukuma r12
        sukuma r13
        sukuma r14

        r12d ^= r12d
        r13 = n64[rela_count]

        ; Kokotoa faharisi ya alama kwa kila rekebisho
        ; Alama za lebo zinaanza baada ya null: faharisi = 1
        ; Nje zinaanza baada ya lebo zote: faharisi = 1 + label_count
.loop:
        linganisha r12, r13
        ruka .done kama >=a

        ; r_offset
        r7d = n32[rela_offset + r12*4]
        ita andika_neno8_moja_kwa_moja

        ; r_info (aina = 2 kwa R_X86_64_PC32, sym = faharisi)
        r14d = n32[rela_sym + r12*4]
        ; Angalia ikiwa ni rekebisho la .data (rela_sym == -1)
        linganisha r14d, -1
        ruka .reloc_global kama !=
        ; Rekebisho la .data: tumia faharisi ya sehemu 2
        r14d = 2
        ruka .reloc_info
.reloc_global:
        ; Angalia ikiwa ni rekebisho la kigezo cha ulimwengu (rela_sym <= -2)
        linganisha r14d, -1
        ruka .reloc_extern kama >n
        ; Faharisi ya alama = 4 (null + .text + .data + .bss) + label_count + global_idx
        r14d = -r14d
        r14d -= 2   ; global_idx = -(rela_sym + 2)
        r0 = n64[label_count]
        r14d += r0d
        r14d += 4
        ruka .reloc_info
.reloc_extern:
        ; Faharisi ya alama = 4 (null + .text + .data + .bss) + label_count + global_count + extern_idx
        r14d += 4
        r0 = n64[label_count]
        r14d += r0d
        r14d += n32[global_count]
.reloc_info:
        r14 <<= 32
        r14 |= 2   ; R_X86_64_PC32
        r7 = r14
        ita andika_neno8_moja_kwa_moja

        ; r_addend kutoka rela_addend (inaweza kuwa hasi)
        r7 = n32[rela_addend + r12*4]
        ita andika_neno8_moja_kwa_moja

        r12++
        ruka .loop
.done:
        vuta r14
        vuta r13
        vuta r12
        rudi

; -------------------------------------------------------
; toa_elf_vichwa_vya_sehemu_rahisi: andika vichwa vya sehemu
;   Tunaandika vichwa 8 (0 hadi 7)
;   Tunahitaji kuhesabu upya ofseti zote hapa
; -------------------------------------------------------
toa_elf_vichwa_vya_sehemu_rahisi:
        ; Kwa sasa tunatoa vichwa vilivyo ngumu kwa sehemu zilizobaki
        ; Hii itarekebishwa baadaye

        ; Tunahitaji kukokotoa tena ofseti zote.
        ; Badala ya kufanya hivyo, tunaandika vichwa kwa mkono.

        ; Data tunayoihitaji:
        ; text_size = [text_buf_pos]
        ; data_size = [data_buf_pos]
        ; symtab_size = (3 + label_count + global_count + extern_count) * 24
        ; strtab_size = tunahitaji kuhesabu
        ; rela_size = rela_count * 24

        ; Hebu tukokotoe ofseti:

        ; text_off = 64
        ; data_off = 64 + text_size
        ; symtab_off = data_off + data_size
        ; strtab_off = symtab_off + symtab_size
        ; rela_off = strtab_off + strtab_size
        ; shstrtab_off = rela_off + rela_size
        ; shoff = shstrtab_off + 55

        ; 0: NULL (baiti 64 za sifuri)
        r1d = 16
        r7d ^= r7d
.null_loop:
        sukuma r1
        ita andika_neno4_moja_kwa_moja
        vuta r1
        zunguka .null_loop

        ; 1: .text — sh_name=1, SHT_PROGBITS (1), SHF_ALLOC|SHF_EXECINSTR (6),
        ;    offset=64, size=text_size, align=16
        r7d = 1   ; sh_name
        ita andika_neno4_moja_kwa_moja
        r7d = 1   ; sh_type = PROGBITS
        ita andika_neno4_moja_kwa_moja
        r7 = 6   ; sh_flags
        ita andika_neno8_moja_kwa_moja
        r7 = 0   ; sh_addr
        ita andika_neno8_moja_kwa_moja
        r7d = 64   ; sh_offset
        ita andika_neno8_moja_kwa_moja
        r7d = n32[text_buf_pos]   ; sh_size
        ita andika_neno8_moja_kwa_moja
        r7d = 0   ; sh_link
        ita andika_neno4_moja_kwa_moja
        r7d = 0   ; sh_info
        ita andika_neno4_moja_kwa_moja
        r7 = 16   ; sh_addralign
        ita andika_neno8_moja_kwa_moja
        r7 = 0   ; sh_entsize
        ita andika_neno8_moja_kwa_moja

        ; 2: .data — sh_name=7, SHT_PROGBITS (1), SHF_WRITE|SHF_ALLOC (3)
        r7d = 7
        ita andika_neno4_moja_kwa_moja
        r7d = 1
        ita andika_neno4_moja_kwa_moja
        r7 = 3
        ita andika_neno8_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja
        r7d = 64
        r7d += n32[text_buf_pos]
        ita andika_neno8_moja_kwa_moja
        r7d = n32[data_buf_pos]
        ita andika_neno8_moja_kwa_moja
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        r7 = 1
        ita andika_neno8_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja

        ; 3: .symtab — sh_name=18, SHT_SYMTAB (2), link=4 (.strtab), info=1
        r7d = 18
        ita andika_neno4_moja_kwa_moja
        r7d = 2
        ita andika_neno4_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja
        ; sh_offset = data_off + data_size (itakokotolewa)
        ; Kwa sasa, tunaikadiria:
        r7d = 64
        r7d += n32[text_buf_pos]
        r7d += n32[data_buf_pos]
        ita andika_neno8_moja_kwa_moja
        ; sh_size = symtab_size
        r14 = n64[label_count]
        r14 += n64[global_count]
        r14 += n64[extern_count]
        r14 += 4   ; +1 kwa null + 3 za alama za sehemu (.text, .data, .bss)
        r14 = r14 * 24
        r7d = r14d
        ita andika_neno8_moja_kwa_moja
        r7d = 4   ; sh_link = .strtab
        ita andika_neno4_moja_kwa_moja
        r7d = 4   ; sh_info = faharisi ya alama ya kwanza ya ulimwengu (baada ya .text, .data, .bss)
        ita andika_neno4_moja_kwa_moja
        r7 = 8   ; sh_addralign
        ita andika_neno8_moja_kwa_moja
        r7 = 24   ; sh_entsize
        ita andika_neno8_moja_kwa_moja

        ; 4: .strtab — sh_name=26, SHT_STRTAB (3)
        r7d = 26
        ita andika_neno4_moja_kwa_moja
        r7d = 3
        ita andika_neno4_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja
        ; sh_offset = baada ya symtab
        r7d = 64
        r7d += n32[text_buf_pos]
        r7d += n32[data_buf_pos]
        r7d += r14d
        ita andika_neno8_moja_kwa_moja
        ; sh_size = strtab_size (tunakokotoa kwa kutumia toa_elf_hesabu_strtab)
        sukuma r14
        ita toa_elf_hesabu_strtab
        vuta r14
        r7d = r0d
        ita andika_neno8_moja_kwa_moja
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        r7 = 1
        ita andika_neno8_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja

        ; 5: .rela.text — sh_name=34, SHT_RELA (4), link=3 (.symtab), info=1 (.text)
        r7d = 34
        ita andika_neno4_moja_kwa_moja
        r7d = 4
        ita andika_neno4_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja
        ; sh_offset = baada ya strtab
        ; Tutumie makadirio
        r7d = 64
        r7d += n32[text_buf_pos]
        r7d += n32[data_buf_pos]
        r7d += r14d   ; symtab_size
        sukuma r7   ; Hifadhi offset iliyokokotolewa
        sukuma r14
        sukuma r0
        ita toa_elf_hesabu_strtab
        vuta r15
        vuta r14
        vuta r7   ; Rejesha offset iliyokokotolewa
        r7d += r0d   ; + strtab_size
        ita andika_neno8_moja_kwa_moja
        ; sh_size = rela_count * 24
        r7 = n64[rela_count]
        r7 = r7 * 24
        r7d = r7d
        ita andika_neno8_moja_kwa_moja
        r7d = 3   ; sh_link = .symtab
        ita andika_neno4_moja_kwa_moja
        r7d = 1   ; sh_info = .text
        ita andika_neno4_moja_kwa_moja
        r7 = 8
        ita andika_neno8_moja_kwa_moja
        r7 = 24
        ita andika_neno8_moja_kwa_moja

        ; 6: .shstrtab — sh_name=45, SHT_STRTAB (3)
        r7d = 45
        ita andika_neno4_moja_kwa_moja
        r7d = 3
        ita andika_neno4_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja
        ; sh_offset = baada ya rela.text
        r7d = 64
        r7d += n32[text_buf_pos]
        r7d += n32[data_buf_pos]
        r7d += r14d   ; symtab_size tuliyohifadhi
        sukuma r7   ; Hifadhi offset iliyokokotolewa
        sukuma r0
        ita toa_elf_hesabu_strtab
        vuta r1
        vuta r7   ; Rejesha offset iliyokokotolewa
        r7d += r0d   ; + strtab_size
        r1 = n64[rela_count]
        r1 = r1 * 24
        r7d += r1d   ; + rela_size
        ita andika_neno8_moja_kwa_moja
        r7d = SHSTRTAB_SIZE
        ita andika_neno8_moja_kwa_moja
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        r7d = 0
        ita andika_neno4_moja_kwa_moja
        r7 = 1
        ita andika_neno8_moja_kwa_moja
        r7 = 0
        ita andika_neno8_moja_kwa_moja

        ; 7: .bss — sh_name=13, SHT_NOBITS (8), SHF_WRITE|SHF_ALLOC (3)
        ; .bss haichukui nafasi kwenye faili (SHT_NOBITS)
        r7d = 13   ; sh_name = ".bss"
        ita andika_neno4_moja_kwa_moja
        r7d = 8   ; sh_type = NOBITS
        ita andika_neno4_moja_kwa_moja
        r7 = 3   ; sh_flags = WRITE|ALLOC
        ita andika_neno8_moja_kwa_moja
        r7 = 0   ; sh_addr
        ita andika_neno8_moja_kwa_moja
        r7 = 0   ; sh_offset = 0 (hakuna data kwenye faili)
        ita andika_neno8_moja_kwa_moja
        r7 = n64[bss_size]   ; sh_size = ukubwa wa .bss
        ita andika_neno8_moja_kwa_moja
        r7d = 0   ; sh_link
        ita andika_neno4_moja_kwa_moja
        r7d = 0   ; sh_info
        ita andika_neno4_moja_kwa_moja
        r7 = 8   ; sh_addralign
        ita andika_neno8_moja_kwa_moja
        r7 = 0   ; sh_entsize
        ita andika_neno8_moja_kwa_moja

        rudi

