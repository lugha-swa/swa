fafanua AST_ELEKEZA = 18
fafanua AST_ENEKEZA_JINA = 19
fafanua AST_LINGA_JINA = 20
fafanua AST_NYOTA_JINA = 21
fafanua AST_FUNGO_ELEKEZA = 22
