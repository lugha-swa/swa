// ==========================================================
// uzalishaji_wasm.swa :: Kizalishe cha WebAssembly (kwa kivinjari)
//
// Backend ya PILI, sambamba na uzalishaji.swa (x86-64/ELF) -- kutoka
// AST ile ile (baada ya kuunganishwa kwa kazi ndogo, ukaguzi wa
// kisemantiki, LICM, SSCSE -- sawa na uzalishaji.swa, angalia
// stage1.swa main()). Hutoa moduli ya WebAssembly (binary, si WAT)
// moja kwa moja kwenye stdout. Hakuna wat2wasm, hakuna tegemezi la
// nje -- sawa na falsafa ya mradi mzima.
//
// AWAMU YA 1 (wigo wa sasa): n32 pekee -- hesabu, ulinganisho,
// &&/||, kama/sivyo, wakati (+vunja/endelea/kwa), wito wa kazi,
// rudisha. HAKUNA: vielekezi, safu, d64/D32, miundo, vigezo vya
// ulimwengu, I/O (andika), tenga(), wito_wa_mfumo. Ujenzi wowote
// ulio nje ya wigo huu UNATOA KOSA LA WAZI, si baiti mbovu za kimya.
//
// KANUNI YA MAJINA: kila kitambulisho cha ngazi ya juu hapa
// kimeambatanishwa na "wasm_" -- Swa haina namespace, na
// uzalishaji.swa ina majina ya jumla (andika_baiti, bafa_text, n.k.)
// ambayo yangegongana kimya kimya. Vitu vya KUSHIRIKIWA (kutoka
// uzalishaji.swa/msambazaji.swa, VISIVYOBADILISHWA hapa):
// ni_desimali_enc, ukubwa_kutoka_enc, ni_muundo_enc,
// ni_bila_ishara_enc, jina_linganisha, safu za AST (ast_aina,
// ast_kushoto, ast_kulia, ast_tiga, ast_nne, ast_thamani,
// ast_jina_off, ast_pool), viainishi AST_*.
// ==========================================================

// -------------------------------------------------------
// Sehemu 0: Bafa na visaidizi vya msingi vya baiti
//
// WASM inahitaji urefu wa LEB128 kabla ya maudhui ya kila sehemu na
// kila mwili wa kazi -- urefu HAUJULIKANI mpaka maudhui yamalizike.
// x86-64 haihitaji hili (jump offsets ni fixed-width, zinaweza
// kurekebishwa baadaye kwa fixup). Sehemu za Type na Code LAZIMA
// zisitangamane -- entries za aina zote pamoja kwenye SEHEMU MOJA
// (Type section), na miili ya kazi zote pamoja kwenye SEHEMU NYINGINE
// (Code section) -- hivyo bafa NNE, si moja:
//   wasm_fn_buf    -- mwili wa kazi MOJA ya SASA (locals+maagizo+0x0B),
//                     inasafishwa kwa kila kazi
//   wasm_type_buf  -- inakusanya entries za AINA za kazi ZOTE (functype
//                     bytes, hazihitaji urefu wa mtu binafsi -- kila
//                     moja ni self-delimiting kwa hesabu zake wenyewe),
//                     KATIKA MZUNGUKO MZIMA wa kazi zote, si kwa kazi
//                     moja pekee
//   wasm_sec_buf   -- inakusanya entries za MWILI za kazi ZOTE (Code
//                     section -- kila entry INAHITAJI urefu wake kwa
//                     sababu miili ina urefu tofauti-tofauti), KATIKA
//                     MZUNGUKO MZIMA wa kazi zote
//   wasm_bafu      -- moduli ya mwisho, inatolewa MARA MOJA mwishoni
// -------------------------------------------------------

n8 wasm_chombo[524288];
n32 wasm_chombo_wapi = 0;

n8 wasm_chombo_cha_kazi[65536];
n32 wasm_kazi_wapi = 0;

n8 wasm_chombo_cha_aina[16384];
n32 wasm_aina_wapi = 0;

n8 wasm_chombo_cha_sehemu[262144];
n32 wasm_sehemu_wapi = 0;

// Ni bafa gani "ya sasa" inayopokea baiti? 0=wasm_bafu, 1=wasm_fn_buf,
// 2=wasm_sec_buf (Code), 3=wasm_type_buf (Type).
n32 wasm_chombo_sasa = 0;

// -------------------------------------------------------
// Sehemu 0b (Awamu 2): Data section (mfuatano halisi) na jedwali la
// mfuatano lililokusanywa. TOFAUTI na wasm_baiti/wasm_bafu_sasa
// zilizopo: wasm_data_buf HUANDIKWA MOJA KWA MOJA kwa faharisi (SI
// kupitia wasm_baiti) kwa sababu mkusanyiko wa mfuatano hutokea
// KATIKATI ya uzalishaji wa mwili wa kazi (wasm_bafu_sasa==1 wakati
// huo) -- kupitia wasm_baiti kungeharibu hali ya kimataifa ya bafa
// inayoshughulikiwa.
// -------------------------------------------------------

n8 wasm_chombo_cha_data[65536];
n32 wasm_data_wapi = 0;
n32 WASM_DATA_MSINGI = 1024;  // ofseti ya kwanza ya kumbukumbu kwa data (0..1023 imehifadhiwa)

n32 WASM_UPEO_MFUATANO = 128;
n32 wasm_umbali_wa_mfuatano[128];   // ofseti YA KUMBUKUMBU (WASM linear memory) ya kila mfuatano wa kipekee
n32 wasm_idadi_ya_mifuatano = 0;

n32 wasm_tenga_kutumika = 0;
n32 wasm_tenga_faharasa = 0;
n32 WASM_ULIMWENGU_WA_AKIBA = 0;  // faharisi pekee ya WASM Global (heap pointer)

// -------------------------------------------------------
// Sehemu 0c: Sehemu ya Uingizaji (Import) -- kazi za `nje "<moduli>"`
// (daraja la mashine, awamu 4) huingizwa kama (moduli, alama).
// Function index space ya WASM inaamuru: uingizaji 0..I-1 KWANZA,
// KISHA kazi za ndani I..I+N-1 -- `wasm_import_idadi` (= idadi ya
// kazi za nje) ni nyongeza inayohitajika kwenye KILA mahali
// panapoandika faharisi ya kazi ya NDANI (call/export/function-section
// type index) -- SI kwenye wito wa uingizaji wenyewe.
// -------------------------------------------------------

n32 wasm_idadi_ya_uingizaji = 0;

// Kioo cha wasm_op_call lakini kwa kazi za NDANI (mtumiaji/tenga) --
// inaongeza wasm_import_idadi kiotomatiki. Kazi za uingizaji (kazi za
// nje) zinaitwa na wasm_op_call ghafi (faharisi 0..I-1 moja
// kwa moja), SI kupitia hii.
w0 wasm_kitendo_ita_kazi(n32 faharasa_ya_kazi) {
    wasm_kitendo_ita(faharasa_ya_kazi + wasm_idadi_ya_uingizaji);
}

// Kusanya herufi halisi (mfuatano) kwenye wasm_data_buf -- kioo cha
// kusanya_herufi (uzalishaji.swa) lakini kinacholenga kumbukumbu ya
// WASM (ofseti ya n32) badala ya lebo ya x86-64. `raw` ni maandishi
// GHAFI ya tokeni (yanayoanza na `"`, angalia uzalishaji_kitambulisho
// kwa muundo ule ule). Hurudisha OFSETI YA KUMBUKUMBU ya baiti za
// kwanza za mfuatano (zilizoishia \0), zikiwa tayari zimeandikwa
// (au zilizopo tayari, ikiwa mfuatano huu umeshahifadhiwa -- dedup
// kwa kulinganisha baiti zilizodondolewa moja kwa moja).
n32 wasm_ongeza_mfuatano(n8* ghafi) {
    n8 muda[4096];
    n32 mwanzo = 1;
    n32 mwisho_ = mwanzo;
    wakati (ghafi[mwisho_] != 0) {
        kama (ghafi[mwisho_] == 92) { mwisho_ = mwisho_ + 2; endelea; }
        kama (ghafi[mwisho_] == 34) { acha; }
        mwisho_ = mwisho_ + 1;
    }

    n32 urefu = 0;
    n32 j = mwanzo;
    wakati (j < mwisho_) {
        kama (ghafi[j] == 92) {
            n32 c = ghafi[j + 1];
            kama (c == 110) { muda[urefu] = 10; }
            sivyo { kama (c == 116) { muda[urefu] = 9; }
            sivyo { kama (c == 48) { muda[urefu] = 0; }
            sivyo { muda[urefu] = c; } } }
            urefu = urefu + 1;
            j = j + 2;
        } sivyo {
            muda[urefu] = ghafi[j];
            urefu = urefu + 1;
            j = j + 1;
        }
    }
    muda[urefu] = 0;  // null terminator -- mkataba wa majaribio ya "mfuatano"

    // Dedup: linganisha baiti zilizodondolewa (ikiwemo \0 ya mwisho)
    // dhidi ya kila mfuatano ulioshahifadhiwa.
    n32 i = 0;
    wakati (i < wasm_idadi_ya_mifuatano) {
        n32 o = wasm_umbali_wa_mfuatano[i] - WASM_DATA_MSINGI;
        n32 sawa = 1;
        n32 k = 0;
        wakati (k <= urefu) {
            kama (wasm_chombo_cha_data[o + k] != muda[k]) { sawa = 0; acha; }
            k = k + 1;
        }
        kama (sawa) { rudisha wasm_umbali_wa_mfuatano[i]; }
        i = i + 1;
    }

    kama (wasm_idadi_ya_mifuatano >= WASM_UPEO_MFUATANO || wasm_data_wapi + urefu + 1 >= 65536) {
        andika_kosa("KOSA: wasm -- jedwali la mfuatano halisi (Awamu 2) limejaa\n");
        wasm_kosa = 1;
        rudisha WASM_DATA_MSINGI;
    }

    n32 umbali_wa_kumbukumbu = WASM_DATA_MSINGI + wasm_data_wapi;
    n32 k2 = 0;
    wakati (k2 <= urefu) {
        wasm_chombo_cha_data[wasm_data_wapi] = muda[k2];
        wasm_data_wapi = wasm_data_wapi + 1;
        k2 = k2 + 1;
    }
    wasm_umbali_wa_mfuatano[wasm_idadi_ya_mifuatano] = umbali_wa_kumbukumbu;
    wasm_idadi_ya_mifuatano = wasm_idadi_ya_mifuatano + 1;
    rudisha umbali_wa_kumbukumbu;
}

// Alama ya kosa la nje ya wigo (Awamu 1) -- imewekwa mahali popote
// ujenzi usiotumika unapatikana; uzalishaji_wasm_kuu huangalia hii
// baada ya kutembea kila kazi na kutoka bila kutoa moduli mbovu.
n32 wasm_kosa = 0;

w0 wasm_baiti(n32 b) {
    kama (wasm_chombo_sasa == 1) {
        kama (wasm_kazi_wapi < 65536) {
            wasm_chombo_cha_kazi[wasm_kazi_wapi] = b & 255;
            wasm_kazi_wapi = wasm_kazi_wapi + 1;
        } sivyo {
            andika_kosa("KOSA: wasm_fn_buf imefurika\n");
            wasm_kosa = 1;
        }
        rudisha;
    }
    kama (wasm_chombo_sasa == 2) {
        kama (wasm_sehemu_wapi < 262144) {
            wasm_chombo_cha_sehemu[wasm_sehemu_wapi] = b & 255;
            wasm_sehemu_wapi = wasm_sehemu_wapi + 1;
        } sivyo {
            andika_kosa("KOSA: wasm_sec_buf imefurika\n");
            wasm_kosa = 1;
        }
        rudisha;
    }
    kama (wasm_chombo_sasa == 3) {
        kama (wasm_aina_wapi < 16384) {
            wasm_chombo_cha_aina[wasm_aina_wapi] = b & 255;
            wasm_aina_wapi = wasm_aina_wapi + 1;
        } sivyo {
            andika_kosa("KOSA: wasm_type_buf imefurika\n");
            wasm_kosa = 1;
        }
        rudisha;
    }
    kama (wasm_chombo_wapi < 524288) {
        wasm_chombo[wasm_chombo_wapi] = b & 255;
        wasm_chombo_wapi = wasm_chombo_wapi + 1;
    } sivyo {
        andika_kosa("KOSA: wasm_bafu imefurika\n");
        wasm_kosa = 1;
    }
}

// LEB128 isiyo na ishara -- kwa urefu wa sehemu, idadi, faharisi
// (zote hasi za Awamu 1 hazitokei; ikitokea hasi, ni mdudu wa ndani).
w0 wasm_leb_a(n32 v) {
    n32 zaidi = 1;
    wakati (zaidi) {
        n32 b7 = v & 127;
        v = (v >> 7) & 33554431;  // shift ya biti bila ishara (v ni >=0 hapa)
        kama (v != 0) {
            wasm_baiti(b7 | 128);
        } sivyo {
            wasm_baiti(b7);
            zaidi = 0;
        }
    }
}

// LEB128 yenye ishara -- kwa i32.const pekee.
w0 wasm_leb_n(n32 v) {
    n32 zaidi = 1;
    wakati (zaidi) {
        n32 b7 = v & 127;
        v = v >> 7;  // shift ya biti ya kuhifadhi ishara (>> ya Swa kwenye n32 ni ya hesabu)
        n32 biti_ya_ishara = b7 & 64;
        kama ((v == 0 && biti_ya_ishara == 0) || (v == 0 - 1 && biti_ya_ishara != 0)) {
            wasm_baiti(b7);
            zaidi = 0;
        } sivyo {
            wasm_baiti(b7 | 128);
        }
    }
}

// Nakili baiti n za bafu ya CHANZO (id: 1=fn_buf, 2=sec_buf) kuingia
// bafu ya SASA, ukiandika urefu wa LEB128 kabla -- hii NDIYO
// inayochukua nafasi ya "backpatch" ya x86-64.
w0 wasm_hamisha_kutoka_kazi() {
    wasm_leb_a(wasm_kazi_wapi);
    n32 i = 0;
    n32 lengwa_zamani = wasm_chombo_sasa;
    wakati (i < wasm_kazi_wapi) {
        n8 b = wasm_chombo_cha_kazi[i];
        wasm_chombo_sasa = lengwa_zamani;
        wasm_baiti(b);
        i = i + 1;
    }
    wasm_kazi_wapi = 0;
}

// -------------------------------------------------------
// Sehemu 1: Opcodes za msingi (majina wazi badala ya namba tupu)
// -------------------------------------------------------

n32 WASM_I32 = 127;  // 0x7F -- aina ya thamani i32 (na blocktype yenye matokeo)
n32 WASM_UBETI_TUPU = 64;  // 0x40 -- blocktype tupu (hakuna matokeo)

w0 wasm_kitendo_mwisho() { wasm_baiti(11); }        // 0x0B
w0 wasm_kitendo_ubeti(n32 aina_ya_ubeti) { wasm_baiti(2); wasm_baiti(aina_ya_ubeti & 255); }   // 0x02
w0 wasm_kitendo_mzunguko(n32 aina_ya_ubeti) { wasm_baiti(3); wasm_baiti(aina_ya_ubeti & 255); }    // 0x03
w0 wasm_kitendo_kama(n32 aina_ya_ubeti) { wasm_baiti(4); wasm_baiti(aina_ya_ubeti & 255); }      // 0x04
w0 wasm_kitendo_sivyo() { wasm_baiti(5); }        // 0x05
w0 wasm_kitendo_ruka(n32 kina) { wasm_baiti(12); wasm_leb_a(kina); }     // 0x0C
w0 wasm_kitendo_ruka_kama(n32 kina) { wasm_baiti(13); wasm_leb_a(kina); }  // 0x0D
w0 wasm_kitendo_ita(n32 faharasa) { wasm_baiti(16); wasm_leb_a(faharasa); }     // 0x10
w0 wasm_kitendo_rudi() { wasm_baiti(15); }     // 0x0F
w0 wasm_kitendo_tupa() { wasm_baiti(26); }       // 0x1A
w0 wasm_kitendo_unreachable() { wasm_baiti(0); } // 0x00

w0 wasm_kitendo_pata_ndani(n32 faharasa) { wasm_baiti(32); wasm_leb_a(faharasa); }  // 0x20
w0 wasm_kitendo_weka_ndani(n32 faharasa) { wasm_baiti(33); wasm_leb_a(faharasa); }  // 0x21
w0 wasm_kitendo_weka_ndani_na_baki(n32 faharasa) { wasm_baiti(34); wasm_leb_a(faharasa); }  // 0x22

w0 wasm_kitendo_i32_namba(n32 v) { wasm_baiti(65); wasm_leb_n(v); }    // 0x41

w0 wasm_kitendo_i32_ni_sifuri() { wasm_baiti(69); }   // 0x45
w0 wasm_kitendo_i32_sawa() { wasm_baiti(70); }    // 0x46
w0 wasm_kitendo_i32_ne() { wasm_baiti(71); }    // 0x47
w0 wasm_kitendo_i32_chini_n() { wasm_baiti(72); }  // 0x48
w0 wasm_kitendo_i32_juu_n() { wasm_baiti(74); }  // 0x4A
w0 wasm_kitendo_i32_le_s() { wasm_baiti(76); }  // 0x4C
w0 wasm_kitendo_i32_ge_s() { wasm_baiti(78); }  // 0x4E

w0 wasm_kitendo_i32_jumlisha() { wasm_baiti(106); }  // 0x6A
w0 wasm_kitendo_i32_toa() { wasm_baiti(107); }  // 0x6B
w0 wasm_kitendo_i32_zidisha() { wasm_baiti(108); }  // 0x6C
w0 wasm_kitendo_i32_gawanya_n() { wasm_baiti(109); }  // 0x6D
w0 wasm_kitendo_i32_baki_n() { wasm_baiti(111); }  // 0x6F
w0 wasm_kitendo_i32_na() { wasm_baiti(113); }  // 0x71
w0 wasm_kitendo_i32_au() { wasm_baiti(114); }   // 0x72
w0 wasm_kitendo_i32_au_pekee() { wasm_baiti(115); }  // 0x73

// Awamu 2: kumbukumbu, globals, na ukuaji wa kumbukumbu.
// i32.load/i32.store: align=2 (mzani wa asili wa baiti 4), offset=0
// KILA WAKATI -- anwani kamili tayari imekokotolewa kwenye stack
// (base+idx*4) kabla ya agizo hili, si kupitia offset ya ModRM-kama
// ya WASM (tofauti na SIB ya x86-64, WASM haina "scaled index",
// hesabu yote ni ya wazi kwenye stack).
w0 wasm_kitendo_i32_soma() { wasm_baiti(40); wasm_leb_a(2); wasm_leb_a(0); }   // 0x28
w0 wasm_kitendo_i32_hifadhi() { wasm_baiti(54); wasm_leb_a(2); wasm_leb_a(0); }  // 0x36

w0 wasm_kitendo_pata_ulimwengu(n32 faharasa) { wasm_baiti(35); wasm_leb_a(faharasa); }  // 0x23
w0 wasm_kitendo_weka_ulimwengu(n32 faharasa) { wasm_baiti(36); wasm_leb_a(faharasa); }  // 0x24

w0 wasm_kitendo_ukubwa_wa_kumbukumbu() { wasm_baiti(63); wasm_baiti(0); }  // 0x3F 0x00 (memidx=0)
w0 wasm_kitendo_panua_kumbukumbu() { wasm_baiti(64); wasm_baiti(0); }  // 0x40 0x00 (memidx=0)

// -------------------------------------------------------
// Sehemu 2: Jedwali la kazi za ngazi ya juu (kwa faharisi za `call`)
// -------------------------------------------------------

n32 WASM_UPEO_KAZI = 256;
n8* wasm_ghala_la_majina_ya_kazi;  // huhifadhi majina (nakala kutoka ast_pool)
n32 wasm_umbali_wa_jina_la_kazi[256];
n32 wasm_nodi_ya_kazi[256];
n32 wasm_idadi_ya_kazi = 0;
n32 wasm_ghala_la_majina_ya_kazi_wapi = 1;

// Je, kazi yenye faharisi kidx (kutoka wasm_tafuta_kazi) inarudisha
// w0 (tupu)? Inahitajika kuamua kama wito-kama-taarifa unahitaji
// "drop" baada yake -- WASM inakataa "drop" bila thamani kwenye rafu
// (imepatikana kwa jaribio halisi: kazi_tupu(5) kama taarifa ilitoa
// "not enough arguments on the stack for drop").
n32 wasm_kazi_ni_w0(n32 faharasa_ya_kazi) {
    rudisha wasm_ni_w0_usimbaji(thamani_ya_nodi[wasm_nodi_ya_kazi[faharasa_ya_kazi]]);
}

// -------------------------------------------------------
// Sehemu 2b (Awamu 4): vigezo vya ulimwengu na jedwali la kazi
// -------------------------------------------------------
// Kigezo cha ulimwengu (n32 au kielekezi) ni WASM Global yenye
// kubadilika; faharisi 0 ni heap pointer ya tenga(), hivyo kigezo i
// cha mtumiaji ni global 1+i. Hii ndiyo hali inayodumu kati ya
// matukio (kaunta ya kubofya, n.k.) -- locals hufa kazi inaporudi.
//
// &kazi ni faharisi ya kazi kwenye jedwali (Table 0). Jedwali lina
// kazi zote za ndani kwa mpangilio wa faharisi zao, hivyo faharisi ya
// jedwali ni faharisi ya ndani ya kazi. Jedwali linatolewa nje kama
// "jedwali" ili JS iite msikilizaji: jedwali.get(kazi)(id).
n32 WASM_UPEO_ULIMWENGU = 256;
n8* wasm_jina_la_ulimwengu[256];
n32 wasm_kianzio_cha_ulimwengu[256];
n32 wasm_idadi_ya_vigeu_vya_ulimwengu = 0;
n32 wasm_jedwali_linatumika = 0;

n32 wasm_tafuta_ulimwengu(n8* jina) {
    n32 i = 0;
    wakati (i < wasm_idadi_ya_vigeu_vya_ulimwengu) {
        kama (jina_linganisha(wasm_jina_la_ulimwengu[i], jina)) { rudisha i; }
        i = i + 1;
    }
    rudisha -1;
}

n32 wasm_tafuta_kazi(n8* jina) {
    n32 i = 0;
    wakati (i < wasm_idadi_ya_kazi) {
        kama (jina_linganisha(wasm_ghala_la_majina_ya_kazi + wasm_umbali_wa_jina_la_kazi[i], jina)) {
            rudisha i;
        }
        i = i + 1;
    }
    rudisha -1;
}

// -------------------------------------------------------
// Sehemu 3: Jedwali la "locals" za kazi ya SASA (paramu + vigezo
// vya ndani vyote, pamoja na vilivyopachikwa ndani ya kama/wakati)
// -------------------------------------------------------

n32 WASM_UPEO_WA_VYA_NDANI = 128;
n8* wasm_jina_la_cha_ndani[128];
n32 wasm_idadi_ya_vya_ndani = 0;
n32 wasm_idadi_ya_vigezo_vya_ndani = 0;  // ngapi kati ya hizo ni paramu (0..P-1)

n32 wasm_tafuta_cha_ndani(n8* jina) {
    n32 i = 0;
    wakati (i < wasm_idadi_ya_vya_ndani) {
        kama (jina_linganisha(wasm_jina_la_cha_ndani[i], jina)) { rudisha i; }
        i = i + 1;
    }
    rudisha -1;
}

// Ongeza local mpya (kama haijasajiliwa tayari kwa jina hilo --
// kigezo chenye jina linalofanana kwenye wigo tofauti/kilichopachikwa
// kinashiriki nafasi moja, kama x86-64's pata_au_unda_kigeu_ukubwa).
n32 wasm_ongeza_cha_ndani(n8* jina) {
    n32 iliyopo = wasm_tafuta_cha_ndani(jina);
    kama (iliyopo >= 0) { rudisha iliyopo; }
    kama (wasm_idadi_ya_vya_ndani >= WASM_UPEO_WA_VYA_NDANI) {
        andika_kosa("KOSA: wasm -- vigezo vingi mno kwenye kazi moja (kikomo %d)\n", WASM_UPEO_WA_VYA_NDANI);
        wasm_kosa = 1;
        rudisha 0;
    }
    wasm_jina_la_cha_ndani[wasm_idadi_ya_vya_ndani] = jina;
    n32 faharasa = wasm_idadi_ya_vya_ndani;
    wasm_idadi_ya_vya_ndani = wasm_idadi_ya_vya_ndani + 1;
    rudisha faharasa;
}

// Je, enc hii ni n32/n32 (aina PEKEE inayoungwa mkono kwenye Awamu 1
// kwa vigezo/paramu/matokeo yenye thamani)? enc==0 ni "aina imeachwa"
// (chaguo-msingi n32, angalia ukubwa_kutoka_enc); enc==288 ni n32/n32
// ya wazi (encode_aina(familia=1,upana=32,mshale=0) -- herufi kubwa
// na ndogo hutoa familia SAWA, angalia changanua_aina_tokeni). Kila
// enc nyingine (kielekezi -- isiyo sawa; D32/d64 -- familia 3; n8/
// n16/n64 -- upana tofauti; muundo -- hasi; w0 -- 1280) iko NJE ya
// wigo kwa nafasi hii.
n32 wasm_ni_n32_usimbaji(n32 usimbaji) {
    kama (usimbaji == 0) { rudisha 1; }
    kama (usimbaji == 288) { rudisha 1; }
    rudisha 0;
}

// Awamu 2: n32 YA KAWAIDA (juu) AU kielekezi KIMOJA kwenda n32
// (encode_aina(familia=1,upana=32,mshale=1) == 289). Kielekezi
// mara-mbili (n32**, mshale=3 -> 291) na kielekezi kwenda aina
// nyingine yoyote HUBAKI nje ya wigo -- huanguka kwenye kesi ya
// mwisho (0) hapa chini kwa makusudi, bila ubaguzi wowote wa ziada.
n32 wasm_ni_n32_au_kielekezi_usimbaji(n32 usimbaji) {
    kama (wasm_ni_n32_usimbaji(usimbaji)) { rudisha 1; }
    kama (usimbaji == 289) { rudisha 1; }
    // n8* (mfuatano): anwani ya i32 kama kielekezi kingine. Kusoma baiti
    // kupitia *p / p[i] bado kunakataliwa: aina ya kipengele ni n8.
    kama (usimbaji == 265) { rudisha 1; }
    rudisha 0;
}

// Je, enc hii ni w0/w0 (aina PEKEE inayoungwa mkono kwa aina ya
// matokeo isiyo na thamani)? encode_aina(familia=5,upana=0,mshale=0).
n32 wasm_ni_w0_usimbaji(n32 usimbaji) {
    rudisha (usimbaji == 1280);
}

// Angalia enc (NA idadi ya safu, kama ipo) ya tangazo la kigezo
// (parameta au la ndani) -- ripoti KOSA la wazi (wasm_kosa=1) kama
// ni nje ya wigo, badala ya kukubali kimya na kuzalisha moduli isiyo
// sahihi (mfano n32* ingekuwa ikitibiwa kama n32 ya kawaida bila
// ukaguzi huu -- imepatikana kwa jaribio halisi la n2.swa:
// "n32* p = 0;" lilipita kimya). `safu_count` (kutoka ast_tiga[node]
// ya AST_TANGAZO, si var_node -- 0 kama si safu, pitisha 0 kwenye
// paramu ambazo haziwezi kuwa safu kisintaksia) NAYO inakaguliwa:
// bila hii, "n32 arr[3];" isiyoguswa kamwe ilikuwa ikisajiliwa
// kimya kama local MOJA ya i32 (ukubwa mbaya) badala ya kukataliwa
// -- imepatikana kwenye ukaguzi wa Kandemark, PR #260.
w0 wasm_kagua_usimbaji_kigezo(n8* jina, n32 usimbaji, n32 idadi_ya_safu) {
    kama (wasm_ni_n32_au_kielekezi_usimbaji(usimbaji) == 0 || idadi_ya_safu > 0) {
        andika_kosa("KOSA: wasm -- aina ya kigezo '%s' iko nje ya wigo wa Awamu 2 (n32 na n32* pekee vinaungwa mkono -- hakuna safu ya ndani ya ukubwa maalum/d64/d32/muundo/upana mwingine/kielekezi-cha-kielekezi)\n", jina);
        wasm_kosa = 1;
    }
}

// Pasi ya awali: tembea mnyororo wa taarifa ukikusanya kila
// AST_TANGAZO (11) unaoweza kufikiwa kupitia kama/wakati zilizopachikwa
// -- WASM inataka locals ZOTE zitangazwe KABLA ya agizo lolote la
// mwili wa kazi, tofauti na x86-64 (rbp-offset polepole).
w0 wasm_kusanya_vya_ndani(n32 nodi) {
    kama (nodi == -1) { rudisha; }
    n32 aina = aina_ya_nodi[nodi];
    kama (aina == NODI_TANGAZO) {
        n32 nodi_ya_kigeu = nodi_ya_kushoto[nodi];
        wasm_kagua_usimbaji_kigezo(ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kigeu], thamani_ya_nodi[nodi_ya_kigeu], tatu_ya_nodi[nodi]);
        wasm_ongeza_cha_ndani(ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kigeu]);
    }
    kama (aina == NODI_KAMA) {
        wasm_kusanya_vya_ndani(nodi_ya_kulia[nodi]);  // then
        n32 sivyo_nodi = tatu_ya_nodi[nodi];
        kama (sivyo_nodi != -1) { wasm_kusanya_vya_ndani(nodi_ya_kushoto[sivyo_nodi]); }
    }
    kama (aina == NODI_WAKATI) {
        // ast_tiga[node] ni init ya kwa (inaweza kuwa AST_TANGAZO
        // yenyewe -- kigezo cha kwa(n32 i=0;...) ni local pia).
        n32 kianzio = tatu_ya_nodi[nodi];
        kama (kianzio != -1 && aina_ya_nodi[kianzio] == NODI_TANGAZO) {
            n32 kigeu_nodi2 = nodi_ya_kushoto[kianzio];
            wasm_kagua_usimbaji_kigezo(ghala_la_majina + umbali_wa_jina_la_nodi[kigeu_nodi2], thamani_ya_nodi[kigeu_nodi2], tatu_ya_nodi[kianzio]);
            wasm_ongeza_cha_ndani(ghala_la_majina + umbali_wa_jina_la_nodi[kigeu_nodi2]);
        }
        wasm_kusanya_vya_ndani(nodi_ya_kulia[nodi]);  // mwili
    }
    kama (aina == NODI_UBETI) {
        wasm_kusanya_vya_ndani(nodi_ya_kushoto[nodi]);
    }
    wasm_kusanya_vya_ndani(nne_ya_nodi[nodi]);
}

// -------------------------------------------------------
// Sehemu 4: Kina cha kiota cha WASM (block/loop/if zilizo wazi) na
// malengo ya vunja/endelea (angalia maelezo kamili karibu na
// uzalishaji_wasm_wakati)
// -------------------------------------------------------

n32 wasm_kina = 0;  // idadi ya block/loop/if zilizo WAZI sasa

n32 WASM_UPEO_KIOTA_MZUNGUKO = 16;
n32 wasm_mzunguko_undani = 0;
n32 wasm_kina_cha_acha[16];     // kina KILIPOFUNGULIWA block ya "acha"
n32 wasm_endelea_kina[16];   // kina KILIPOFUNGULIWA lengwa la "endelea"
n32 wasm_ina_hatua[16];      // 1 = kwa yenye hatua (block ya ziada ya endelea bado wazi)

// -------------------------------------------------------
// Sehemu 5: Usemi (matokeo huishia juu ya stack ya WASM -- i32 moja)
// -------------------------------------------------------

w0 wasm_usemi(n32 nodi, n32 nodi_ya_kazi);
w0 wasm_taja_anwani(n32 nodi, n32 nodi_ya_kazi);

// AST_TAJA (29): *ptr (faharasa==-1) au arr[idx] (faharasa!=-1).
// Hutoa ANWANI (offset ya i32 kwenye kumbukumbu) juu ya stack, BILA
// kupakia thamani -- inatumika na wasm_taja_thamani (kusoma) NA
// wasm_usemi/wasm_taarifa kwa AST_KUMBUKA (&arr[idx]/&*ptr) na
// uhifadhi (arr[idx] = x). Awamu 2: kipengele cha n32 pekee (baiti
// 4 kila kimoja) -- hesabu ya faharasa*4 ni ya wazi kila wakati,
// hakuna aina nyingine ya ukubwa inayoungwa mkono.
w0 wasm_taja_anwani(n32 nodi, n32 nodi_ya_kazi) {
    kama (wasm_ni_n32_au_kielekezi_usimbaji(thamani_ya_nodi[nodi]) == 0) {
        andika_kosa("KOSA: wasm -- kipengele/nyoosha hii iko nje ya wigo wa Awamu 2 (kipengele cha n32 pekee)\n");
        wasm_kosa = 1;
        rudisha;
    }
    n32 msingi_wake = nodi_ya_kushoto[nodi];
    n32 faharasa = nodi_ya_kulia[nodi];
    wasm_usemi(msingi_wake, nodi_ya_kazi);
    kama (faharasa != -1) {
        wasm_usemi(faharasa, nodi_ya_kazi);
        wasm_kitendo_i32_namba(4);
        wasm_kitendo_i32_zidisha();
        wasm_kitendo_i32_jumlisha();
    }
}

w0 wasm_taja_thamani(n32 nodi, n32 nodi_ya_kazi) {
    wasm_taja_anwani(nodi, nodi_ya_kazi);
    wasm_kitendo_i32_soma();
}

n32 wasm_ni_ulinganisho(n32 aina) {
    rudisha (aina == NODI_SAWA || aina == NODI_TOFAUTI_SI || aina == NODI_CHINI ||
             aina == NODI_JUU || aina == NODI_CHINI_SAWA || aina == NODI_JUU_SAWA);
}

w0 wasm_zalisha_ulinganisho(n32 nodi) {
    n32 aina = aina_ya_nodi[nodi];
    kama (aina == NODI_SAWA) { wasm_kitendo_i32_sawa(); rudisha; }
    kama (aina == NODI_TOFAUTI_SI) { wasm_kitendo_i32_ne(); rudisha; }
    kama (aina == NODI_CHINI) { wasm_kitendo_i32_chini_n(); rudisha; }
    kama (aina == NODI_JUU) { wasm_kitendo_i32_juu_n(); rudisha; }
    kama (aina == NODI_CHINI_SAWA) { wasm_kitendo_i32_le_s(); rudisha; }
    kama (aina == NODI_JUU_SAWA) { wasm_kitendo_i32_ge_s(); rudisha; }
}

// Sharti la jumla (ulinganisho, &&, ||, au usemi mwingine wowote)
// -> i32 moja juu ya stack (0/1). && na || ni USEMI wa muundo (if
// wenye blocktype=i32), si mnyororo wa lebo kama x86-64 -- WASM
// if/else inaweza kubeba aina ya matokeo moja kwa moja.
w0 wasm_sharti(n32 nodi) {
    kama (nodi == -1) {
        andika_kosa("KOSA: wasm -- sharti tupu halikubaliki\n");
        wasm_kosa = 1;
        rudisha;
    }
    n32 aina = aina_ya_nodi[nodi];
    kama (aina == NODI_NA) {  // A && B
        wasm_sharti(nodi_ya_kushoto[nodi]);
        wasm_kitendo_kama(WASM_I32); wasm_kina = wasm_kina + 1;
            wasm_sharti(nodi_ya_kulia[nodi]);
        wasm_kitendo_sivyo();
            wasm_kitendo_i32_namba(0);
        wasm_kitendo_mwisho(); wasm_kina = wasm_kina - 1;
        rudisha;
    }
    kama (aina == NODI_AU) {  // A || B
        wasm_sharti(nodi_ya_kushoto[nodi]);
        wasm_kitendo_kama(WASM_I32); wasm_kina = wasm_kina + 1;
            wasm_kitendo_i32_namba(1);
        wasm_kitendo_sivyo();
            wasm_sharti(nodi_ya_kulia[nodi]);
        wasm_kitendo_mwisho(); wasm_kina = wasm_kina - 1;
        rudisha;
    }
    kama (aina == NODI_SI) {  // !A
        wasm_sharti(nodi_ya_kushoto[nodi]);
        wasm_kitendo_i32_ni_sifuri();
        rudisha;
    }
    kama (wasm_ni_ulinganisho(aina)) {
        wasm_usemi(nodi_ya_kushoto[nodi], -1);
        wasm_usemi(nodi_ya_kulia[nodi], -1);
        wasm_zalisha_ulinganisho(nodi);
        rudisha;
    }
    // Usemi mwingine wowote (kigezo, wito, n.k.) -- 0 = uwongo,
    // isiyo sifuri = kweli, sawa na C.
    wasm_usemi(nodi, -1);
}

w0 wasm_usemi(n32 nodi, n32 nodi_ya_kazi) {
    kama (nodi == -1) { rudisha; }
    n32 aina = aina_ya_nodi[nodi];

    kama (aina == NODI_NAMBARI) {
        kama (nodi_ya_kulia[nodi] == 1) {
            andika_kosa("KOSA: wasm -- namba halisi ya n64 kubwa haitumiki bado (Awamu 1: n32 pekee)\n");
            wasm_kosa = 1;
            rudisha;
        }
        wasm_kitendo_i32_namba(thamani_ya_nodi[nodi]);
        rudisha;
    }

    kama (aina == NODI_KITAMBULISHO) {
        n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[nodi];

        // Herufi halisi (mfuatano) -- inaanza na '"' (34), sawa na
        // uzalishaji_kitambulisho (uzalishaji.swa). Kigeu na mfuatano
        // ZOTE ni AST_KITAMBULISHO -- hakuna nodi tofauti ya AST.
        kama (jina[0] == 34) {
            n32 umbali_wa_kumbukumbu = wasm_ongeza_mfuatano(jina);
            wasm_kitendo_i32_namba(umbali_wa_kumbukumbu);
            rudisha;
        }

        n32 faharasa = wasm_tafuta_cha_ndani(jina);
        kama (faharasa < 0) {
            n32 g = wasm_tafuta_ulimwengu(jina);
            kama (g >= 0) {
                wasm_kitendo_pata_ulimwengu(1 + g);
                rudisha;
            }
            andika_kosa("KOSA: wasm -- kigezo kisichojulikana au nje ya wigo: %s\n", jina);
            wasm_kosa = 1;
            rudisha;
        }
        wasm_kitendo_pata_ndani(faharasa);
        rudisha;
    }

    kama (aina == NODI_TAJA) {
        wasm_taja_thamani(nodi, nodi_ya_kazi);
        rudisha;
    }

    kama (aina == NODI_KUMBUKA) {
        n32 hoja_ya_agizo = nodi_ya_kushoto[nodi];
        // Awamu 4: &kazi -- faharisi ya kazi kwenye jedwali (Table 0).
        kama (hoja_ya_agizo != -1 && aina_ya_nodi[hoja_ya_agizo] == NODI_KITAMBULISHO) {
            n32 kf = wasm_tafuta_kazi(ghala_la_majina + umbali_wa_jina_la_nodi[hoja_ya_agizo]);
            kama (kf >= 0) {
                wasm_jedwali_linatumika = 1;
                wasm_kitendo_i32_namba(kf);
                rudisha;
            }
        }
        kama (hoja_ya_agizo == -1 || aina_ya_nodi[hoja_ya_agizo] != NODI_TAJA) {
            andika_kosa("KOSA: wasm -- '&' inaungwa mkono TU kwa &arr[idx]/&*ptr kwenye Awamu 2 (si '&kigezo' cha ndani -- WASM 'locals' hazina anwani ya kumbukumbu, tofauti na rbp-offset za x86-64)\n");
            wasm_kosa = 1;
            rudisha;
        }
        wasm_taja_anwani(hoja_ya_agizo, nodi_ya_kazi);
        rudisha;
    }

    kama (aina == NODI_JUMLISHA || aina == NODI_TOFAUTI || aina == NODI_ZIDISHA ||
          aina == NODI_GAWANYA || aina == NODI_BAKI || aina == NODI_BITI_AU ||
          aina == NODI_BITI_NA || aina == NODI_AU_PEKEE) {
        wasm_usemi(nodi_ya_kushoto[nodi], nodi_ya_kazi);
        wasm_usemi(nodi_ya_kulia[nodi], nodi_ya_kazi);
        kama (aina == NODI_JUMLISHA) { wasm_kitendo_i32_jumlisha(); }
        kama (aina == NODI_TOFAUTI) { wasm_kitendo_i32_toa(); }
        kama (aina == NODI_ZIDISHA) { wasm_kitendo_i32_zidisha(); }
        kama (aina == NODI_GAWANYA) { wasm_kitendo_i32_gawanya_n(); }
        kama (aina == NODI_BAKI) { wasm_kitendo_i32_baki_n(); }
        kama (aina == NODI_BITI_AU) { wasm_kitendo_i32_au(); }
        kama (aina == NODI_BITI_NA) { wasm_kitendo_i32_na(); }
        kama (aina == NODI_AU_PEKEE) { wasm_kitendo_i32_au_pekee(); }
        rudisha;
    }

    kama (wasm_ni_ulinganisho(aina) || aina == NODI_NA || aina == NODI_AU || aina == NODI_SI) {
        wasm_sharti(nodi);
        rudisha;
    }

    kama (aina == NODI_WITO) {
        n32 jina_la_nodi = nodi_ya_kushoto[nodi];
        n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[jina_la_nodi];

        // tenga(n): kazi MAALUM ya Awamu 2 -- HAKUNA kazi halisi ya
        // Swa yenye jina hili kwenye WASM (kumbukumbu.swa halisi
        // hutumia mmap/wito_wa_mfumo, ambayo hayapo kwenye WASM
        // kabisa) -- inatambuliwa KWA JINA moja kwa moja, KABLA ya
        // kutafuta kwenye jedwali la kazi za mtumiaji (kioo cha jinsi
        // ukubwa() inavyotambuliwa kwenye uzalishaji.swa, mstari
        // ~3811). Uzalishaji: itwa helper iliyojengwa na
        // wasm_jenga_tenga_helper (bump allocator + memory.grow).
        kama (jina_linganisha(jina, "tenga")) {
            n32 hoja_t = nodi_ya_kulia[nodi];
            kama (hoja_t == -1) {
                andika_kosa("KOSA: wasm -- tenga() inahitaji hoja moja (ukubwa wa baiti)\n");
                wasm_kosa = 1;
                rudisha;
            }
            wasm_usemi(hoja_t, nodi_ya_kazi);
            wasm_tenga_kutumika = 1;
            wasm_kitendo_ita_kazi(wasm_tenga_faharasa);
            rudisha;
        }

        // Kazi ya nje (daraja la mashine, awamu 4): uingizaji wa WASM.
        // Faharisi za uingizaji ni 0..I-1 (mpangilio wa kigeni_kazi_*),
        // hivyo wito hautumii wasm_import_idadi.
        n32 kigeni_k = kigeni_kazi_kwa_jina(jina);
        kama (kigeni_k >= 0) {
            n32 hoja_k = nodi_ya_kulia[nodi];
            wakati (hoja_k != -1) {
                wasm_usemi(hoja_k, nodi_ya_kazi);
                hoja_k = tatu_ya_nodi[hoja_k];
            }
            wasm_kitendo_ita(kigeni_k);
            rudisha;
        }

        n32 faharasa_ya_kazi = wasm_tafuta_kazi(jina);
        kama (faharasa_ya_kazi < 0) {
            andika_kosa("KOSA: wasm -- kazi haitumiki (nje ya wigo, au haijulikani): %s\n", jina);
            wasm_kosa = 1;
            rudisha;
        }
        // Hoja: kushoto-kwenda-kulia (asili ya stack ya WASM -- TOFAUTI
        // na x86-64 iliyotathmini kulia-kwenda-kushoto kwa sababu za
        // rejesta zake. Salama kwa Awamu 1 -- hakuna madhara ya pembeni
        // yanayoonekana bila I/O/vigezo vya ulimwengu).
        n32 hoja = nodi_ya_kulia[nodi];
        wakati (hoja != -1) {
            wasm_usemi(hoja, nodi_ya_kazi);
            hoja = tatu_ya_nodi[hoja];
        }
        wasm_kitendo_ita_kazi(faharasa_ya_kazi);
        rudisha;
    }

    andika_kosa("KOSA: wasm -- usemi huu haukubaliki kwenye Awamu 1 (aina ya AST=%d)\n", aina);
    wasm_kosa = 1;
}

// -------------------------------------------------------
// Sehemu 6: Taarifa (statements)
// -------------------------------------------------------

w0 wasm_taarifa(n32 nodi, n32 nodi_ya_kazi);

w0 wasm_wakati(n32 nodi, n32 nodi_ya_kazi) {
    n32 sharti = nodi_ya_kushoto[nodi];
    n32 maudhui = nodi_ya_kulia[nodi];
    n32 kianzio = tatu_ya_nodi[nodi];
    n32 ina_hatua = (thamani_ya_nodi[nodi] == 0 - 777777);

    kama (kianzio != -1) {
        kama (aina_ya_nodi[kianzio] == NODI_TANGAZO) {
            n32 nodi_ya_kigeu = nodi_ya_kushoto[kianzio];
            n32 thamani_ya_kianzio = nodi_ya_kulia[kianzio];
            n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kigeu];
            n32 faharasa = wasm_tafuta_cha_ndani(jina);
            kama (thamani_ya_kianzio != -1) {
                wasm_usemi(thamani_ya_kianzio, nodi_ya_kazi);
            } sivyo {
                wasm_kitendo_i32_namba(0);
            }
            wasm_kitendo_weka_ndani(faharasa);
        } sivyo {
            wasm_taarifa(kianzio, nodi_ya_kazi);
        }
    }

    kama (wasm_mzunguko_undani >= WASM_UPEO_KIOTA_MZUNGUKO) {
        andika_kosa("KOSA: wasm -- vitanzi vilivyopachikwa mno (kikomo %d)\n", WASM_UPEO_KIOTA_MZUNGUKO);
        wasm_kosa = 1;
        rudisha;
    }
    n32 faharasa_ya_mzunguko = wasm_mzunguko_undani;
    wasm_mzunguko_undani = wasm_mzunguko_undani + 1;
    wasm_ina_hatua[faharasa_ya_mzunguko] = ina_hatua;

    // block $vunja { loop $juu { <sharti>; eqz; br_if (kwenda $vunja);
    //   [block $endelea { <mwili> }]  <-- pekee kama ina_hatua
    //   <mwili>                       <-- kama HAINA hatua
    //   br (kwenda $juu) } }
    wasm_kitendo_ubeti(WASM_UBETI_TUPU); wasm_kina = wasm_kina + 1;
    wasm_kina_cha_acha[faharasa_ya_mzunguko] = wasm_kina;

    wasm_kitendo_mzunguko(WASM_UBETI_TUPU); wasm_kina = wasm_kina + 1;
    n32 juu_kina = wasm_kina;
    kama (ina_hatua == 0) { wasm_endelea_kina[faharasa_ya_mzunguko] = juu_kina; }

    kama (sharti != -1) {
        wasm_sharti(sharti);
        wasm_kitendo_i32_ni_sifuri();
        wasm_kitendo_ruka_kama(wasm_kina - wasm_kina_cha_acha[faharasa_ya_mzunguko]);
    }

    kama (ina_hatua) {
        wasm_kitendo_ubeti(WASM_UBETI_TUPU); wasm_kina = wasm_kina + 1;
        wasm_endelea_kina[faharasa_ya_mzunguko] = wasm_kina;
    }

    wasm_taarifa(maudhui, nodi_ya_kazi);

    kama (ina_hatua && wasm_ina_hatua[faharasa_ya_mzunguko] != 0 - 999999) {
        // AST_BLOCK{-777777} (hatua) ndani ya mwili tayari ilifunga
        // block ya "endelea" yenyewe (angalia wasm_taarifa) -- hapa
        // hakuna kufanya tena. Alama -999999 = imeshafungwa.
    }

    wasm_kitendo_ruka(wasm_kina - juu_kina);
    wasm_kitendo_mwisho(); wasm_kina = wasm_kina - 1;  // loop
    wasm_kitendo_mwisho(); wasm_kina = wasm_kina - 1;  // block $vunja

    wasm_mzunguko_undani = wasm_mzunguko_undani - 1;
}

w0 wasm_kama(n32 nodi, n32 nodi_ya_kazi) {
    n32 sharti = nodi_ya_kushoto[nodi];
    n32 maudhui_ya_basi = nodi_ya_kulia[nodi];
    n32 sivyo_nodi = tatu_ya_nodi[nodi];
    n32 maudhui_ya_sivyo = -1;
    kama (sivyo_nodi != -1) { maudhui_ya_sivyo = nodi_ya_kushoto[sivyo_nodi]; }

    wasm_sharti(sharti);
    kama (maudhui_ya_sivyo != -1) {
        wasm_kitendo_kama(WASM_UBETI_TUPU); wasm_kina = wasm_kina + 1;
        wasm_taarifa(maudhui_ya_basi, nodi_ya_kazi);
        wasm_kitendo_sivyo();
        wasm_taarifa(maudhui_ya_sivyo, nodi_ya_kazi);
        wasm_kitendo_mwisho(); wasm_kina = wasm_kina - 1;
    } sivyo {
        wasm_kitendo_kama(WASM_UBETI_TUPU); wasm_kina = wasm_kina + 1;
        wasm_taarifa(maudhui_ya_basi, nodi_ya_kazi);
        wasm_kitendo_mwisho(); wasm_kina = wasm_kina - 1;
    }
}

w0 wasm_taarifa(n32 nodi, n32 nodi_ya_kazi) {
    kama (nodi == -1) { rudisha; }
    n32 aina = aina_ya_nodi[nodi];

    kama (aina == NODI_RUDISHA) {
        n32 usemi = nodi_ya_kushoto[nodi];
        kama (usemi != -1) { wasm_usemi(usemi, nodi_ya_kazi); }
        wasm_kitendo_rudi();
        rudisha;  // hakuna ndugu -- msururu unaisha
    }

    kama (aina == NODI_ACHA) {
        kama (wasm_mzunguko_undani > 0) {
            n32 faharasa = wasm_mzunguko_undani - 1;
            wasm_kitendo_ruka(wasm_kina - wasm_kina_cha_acha[faharasa]);
        }
        rudisha;
    }

    kama (aina == NODI_ENDELEA) {
        kama (wasm_mzunguko_undani > 0) {
            n32 faharasa = wasm_mzunguko_undani - 1;
            wasm_kitendo_ruka(wasm_kina - wasm_endelea_kina[faharasa]);
        }
        rudisha;
    }

    kama (aina == NODI_TANGAZO) {
        n32 nodi_ya_kigeu = nodi_ya_kushoto[nodi];
        n32 nodi_ya_kianzio = nodi_ya_kulia[nodi];
        n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kigeu];
        n32 faharasa = wasm_tafuta_cha_ndani(jina);
        kama (nodi_ya_kianzio != -1) {
            wasm_usemi(nodi_ya_kianzio, nodi_ya_kazi);
        } sivyo {
            wasm_kitendo_i32_namba(0);
        }
        wasm_kitendo_weka_ndani(faharasa);
    } sivyo { kama (aina == NODI_ASIMILIA) {
            n32 kushoto = nodi_ya_kushoto[nodi];
            n32 kulia = nodi_ya_kulia[nodi];

            // arr[idx] = x / *ptr = x -- anwani KWANZA (chini ya
            // stack), kisha thamani (juu), kisha i32.store (inayotaka
            // [anwani, thamani] kwa mpangilio huu HASA).
            kama (aina_ya_nodi[kushoto] == NODI_TAJA) {
                wasm_taja_anwani(kushoto, nodi_ya_kazi);
                wasm_usemi(kulia, nodi_ya_kazi);
                wasm_kitendo_i32_hifadhi();
                // MUHIMU: endelea kwenye ndugu inayofuata (ast_nne) --
                // TOFAUTI na AST_RUDISHA (ambayo KWELI inamaliza
                // msururu), ugawaji ni taarifa ya KAWAIDA, mfululizo
                // unaendelea baada yake. `rudisha;` peke yake HAPA (bila
                // wito huu) ilikuwa ikifuta KIMYA taarifa zote zilizobaki
                // kwenye kitanzi (mfano `i = i + 1;` baada ya
                // `arr[i] = x;`) -- ilisababisha kitanzi kisichokwisha
                // cha kweli (i haiongezeki kamwe). Imepatikana kwa
                // jaribio halisi (jaribio_safu_n32.swa: node ilining'inia
                // milele wakati wa kuendesha, si kosa la kukusanya).
                wasm_taarifa(nne_ya_nodi[nodi], nodi_ya_kazi);
                rudisha;
            }

            kama (aina_ya_nodi[kushoto] != NODI_KITAMBULISHO) {
                andika_kosa("KOSA: wasm -- ugawaji huu haukubaliki kwenye Awamu 2 (muundo/aina nyingine)\n");
                wasm_kosa = 1;
                rudisha;
            }
            n8* jina2 = ghala_la_majina + umbali_wa_jina_la_nodi[kushoto];
            n32 faharasa2 = wasm_tafuta_cha_ndani(jina2);
            kama (faharasa2 < 0) {
                n32 g2 = wasm_tafuta_ulimwengu(jina2);
                kama (g2 < 0) {
                    andika_kosa("KOSA: wasm -- kigezo kisichojulikana: %s\n", jina2);
                    wasm_kosa = 1;
                    rudisha;
                }
                wasm_usemi(kulia, nodi_ya_kazi);
                wasm_kitendo_weka_ulimwengu(1 + g2);
            } sivyo {
                wasm_usemi(kulia, nodi_ya_kazi);
                wasm_kitendo_weka_ndani(faharasa2);
            }
        } sivyo { kama (aina == NODI_WITO) {
                n32 jina_nodi_w = nodi_ya_kushoto[nodi];
                n8* jina_w = ghala_la_majina + umbali_wa_jina_la_nodi[jina_nodi_w];

                // tenga(n); kama taarifa peke yake -- inarudisha
                // thamani KILA WAKATI (si kama kazi za kawaida
                // ambazo zinaweza kuwa w0) -- LAZIMA itupwe daima,
                // vinginevyo WASM inakataa moduli (thamani iliyobaki
                // juu ya stack mwishoni mwa block). MUHIMU: `sivyo`
                // hapa (SI `rudisha;` peke yake baada ya block ya
                // kwanza) -- vinginevyo njia ya jumla ya AST_WITO
                // ingeendelea kutekelezwa BAADAYE kimya, ikizalisha
                // wasm_usemi mara MBILI (jaribio halisi lilifichua
                // hitilafu ya "unreachable" wakati wa kukimbia kwa
                // sababu ya bug hii hii ikiwa pamoja na tatizo la
                // sibling -- angalia jaribio_tenga_kama_taarifa.swa).
                // Kazi ya nje isiyo w0 NAYO inarudisha thamani, kama
                // tenga() -- uingizaji hauko kwenye wasm_kazi_node[],
                // hivyo wasm_tafuta_kazi ingerudisha -1 na kuruka drop
                // KIMAKOSA, ikiacha thamani juu ya rafu.
                n32 kigeni_w = kigeni_kazi_kwa_jina(jina_w);
                kama (jina_linganisha(jina_w, "tenga") || (kigeni_w >= 0 && kigeni_ni_w0(kigeni_w) == 0)) {
                    wasm_usemi(nodi, nodi_ya_kazi);
                    wasm_kitendo_tupa();
                } sivyo {
                    n32 faharasa_ya_kazi_w = wasm_tafuta_kazi(jina_w);
                    wasm_usemi(nodi, nodi_ya_kazi);
                    // Tupa matokeo ya wito kama taarifa -- LAKINI PEKEE
                    // kama kazi inarudisha thamani (si w0), la sivyo
                    // hakuna kilicho kwenye rafu ya kutupa.
                    kama (faharasa_ya_kazi_w >= 0 && wasm_kazi_ni_w0(faharasa_ya_kazi_w) == 0) {
                        wasm_kitendo_tupa();
                    }
                }
            } sivyo { kama (aina == NODI_KAMA) {
                    wasm_kama(nodi, nodi_ya_kazi);
                } sivyo { kama (aina == NODI_WAKATI) {
                        wasm_wakati(nodi, nodi_ya_kazi);
                    } sivyo { kama (aina == NODI_UBETI) {
                            kama (nodi_ya_kulia[nodi] == 0 - 777777) {
                                // Alama ya "hatua" ya kwa: funga block ya
                                // "endelea" HAPA (hatua inayofuata ni MSIMBO
                                // WA HATUA, unaopaswa kuwa NJE ya block hiyo
                                // ili endelea iishie hapa na kuiendesha) --
                                // angalia maelezo kamili juu ya wasm_wakati.
                                kama (wasm_mzunguko_undani > 0) {
                                    n32 faharasa3 = wasm_mzunguko_undani - 1;
                                    kama (wasm_ina_hatua[faharasa3]) {
                                        wasm_kitendo_mwisho(); wasm_kina = wasm_kina - 1;
                                        wasm_ina_hatua[faharasa3] = 0 - 999999;  // imeshafungwa
                                    }
                                }
                            }
                            wasm_taarifa(nodi_ya_kushoto[nodi], nodi_ya_kazi);
                        } sivyo {
                            andika_kosa("KOSA: wasm -- taarifa hii haikubaliki kwenye Awamu 1 (aina ya AST=%d)\n", aina);
                            wasm_kosa = 1;
                        } } } } } }

    wasm_taarifa(nne_ya_nodi[nodi], nodi_ya_kazi);
}

// -------------------------------------------------------
// Sehemu 7: Kazi moja -- pasi ya locals + mwili -> entry ya Type
// (kwenye wasm_type_buf, YA PAMOJA na kazi zote) na entry ya Code
// (kwenye wasm_sec_buf, YA PAMOJA na kazi zote) -- HAZICHANGANYIKI
// (angalia maelezo ya Sehemu 0).
// -------------------------------------------------------

w0 wasm_jenga_kazi(n32 nodi_ya_kazi) {
    // Weka upya jedwali la locals kwa kazi hii
    wasm_idadi_ya_vya_ndani = 0;

    // Paramu -- faharisi 0..P-1
    n32 nparam = 0;
    n32 pn = nodi_ya_kulia[nodi_ya_kazi];
    wakati (pn != -1) {
        wasm_kagua_usimbaji_kigezo(ghala_la_majina + umbali_wa_jina_la_nodi[pn], thamani_ya_nodi[pn], 0);
        wasm_ongeza_cha_ndani(ghala_la_majina + umbali_wa_jina_la_nodi[pn]);
        nparam = nparam + 1;
        pn = nodi_ya_kulia[pn];
    }
    wasm_idadi_ya_vigezo_vya_ndani = nparam;

    // Vigezo vya ndani (ikiwemo vilivyopachikwa) -- faharisi P..P+L-1
    n32 maudhui = tatu_ya_nodi[nodi_ya_kazi];
    wasm_kusanya_vya_ndani(maudhui);
    n32 idadi_ya_vya_ndani = wasm_idadi_ya_vya_ndani - nparam;

    // ---- Type entry: (nparam x i32) -> i32 (au tupu kwa w0/w0) ----
    // -- imeongezwa kwenye wasm_type_buf, INAYOENDELEA kati ya kazi
    // (haisafishwi hapa) -- entries za functype ni self-delimiting
    // kwa hesabu zao wenyewe, hazihitaji urefu wa mtu binafsi.
    n32 usimbaji_wa_matokeo = thamani_ya_nodi[nodi_ya_kazi];
    n32 ni_w0 = wasm_ni_w0_usimbaji(usimbaji_wa_matokeo);
    kama (ni_w0 == 0 && wasm_ni_n32_usimbaji(usimbaji_wa_matokeo) == 0) {
        andika_kosa("KOSA: wasm -- aina ya matokeo iko nje ya wigo wa Awamu 1 (n32 au w0 pekee zinaungwa mkono)\n");
        wasm_kosa = 1;
    }
    wasm_chombo_sasa = 3;
    wasm_baiti(96);  // 0x60 -- func type tag
    wasm_leb_a(nparam);
    n32 pi = 0;
    wakati (pi < nparam) { wasm_baiti(WASM_I32); pi = pi + 1; }
    kama (ni_w0) {
        wasm_leb_a(0);
    } sivyo {
        wasm_leb_a(1);
        wasm_baiti(WASM_I32);
    }

    // ---- Code entry: locals + mwili -- jengwa kwenye wasm_fn_buf
    // (mwili wa kazi HII PEKEE), kisha kunakiliwa (na urefu wake wa
    // LEB128 mbele) kuingia wasm_sec_buf, INAYOENDELEA kati ya kazi.
    wasm_chombo_sasa = 1;
    wasm_kazi_wapi = 0;
    kama (idadi_ya_vya_ndani > 0) {
        wasm_leb_a(1);  // kundi 1 la locals (aina moja: i32)
        wasm_leb_a(idadi_ya_vya_ndani);
        wasm_baiti(WASM_I32);
    } sivyo {
        wasm_leb_a(0);
    }

    wasm_kina = 0;
    wasm_mzunguko_undani = 0;
    wasm_taarifa(maudhui, nodi_ya_kazi);
    // "unreachable" kabla ya mwisho wa kazi -- WASM huthibitisha
    // aina za rafu KIMUUNDO (bila kufuatilia kwamba matawi YOTE ya
    // kama/sivyo tayari yamerudisha), hivyo "fallthru" ya kazi
    // inayorudisha i32 INAHITAJI thamani kwenye rafu HATA kama kwa
    // MANTIKI njia hiyo haiwezekani kufikiwa (mfano: kama/sivyo zote
    // mbili zina rudisha wazi) -- imepatikana kwa jaribio halisi
    // (t3.swa: "expected 1 elements on the stack for fallthru").
    // "unreachable" ina aina ya polymorphic (inakidhi kigezo chochote),
    // hivyo inatatua tatizo la uthibitishaji bila kuathiri utekelezaji
    // halisi (chanzo sahihi haifiki hapa kamwe). Kazi za w0 hazihitaji
    // hii (fallthru yao haihitaji thamani).
    kama (ni_w0 == 0) { wasm_kitendo_unreachable(); }
    wasm_kitendo_mwisho();

    // Nakili mwili wa kazi (wasm_fn_buf) kuingia sec_buf ikiwa na
    // urefu wake wa LEB128 mbele -- hii NDIYO "backpatch" ya WASM.
    wasm_chombo_sasa = 2;
    wasm_hamisha_kutoka_kazi();
}

// -------------------------------------------------------
// Sehemu 8: Moduli nzima
// -------------------------------------------------------

w0 wasm_utangulizi() {
    wasm_baiti(0); wasm_baiti(97); wasm_baiti(115); wasm_baiti(109);  // \0asm
    wasm_baiti(1); wasm_baiti(0); wasm_baiti(0); wasm_baiti(0);        // toleo 1
}

// Baiti ngapi ambazo wasm_uleb128(v) ingeandika, BILA kuziandika --
// inahitajika kukokotoa ukubwa wa sehemu KABLA ya kuuandika (sawa na
// tatizo lile lile la "urefu haujulikani mpaka mwisho").
n32 wasm_ukubwa_wa_leb_a(n32 v) {
    n32 n = 1;
    v = (v >> 7) & 33554431;
    wakati (v != 0) {
        n = n + 1;
        v = (v >> 7) & 33554431;
    }
    rudisha n;
}

// Baiti ngapi ambazo wasm_sleb128(v) ingeandika, BILA kuziandika --
// kioo cha wasm_uleb128_ukubwa lakini kwa hesabu ya ishara (LEB128
// yenye ishara inaisha tofauti na isiyo na ishara -- angalia
// wasm_sleb128 kwa sharti kamili).
n32 wasm_ukubwa_wa_leb_n(n32 v) {
    n32 n = 0;
    n32 zaidi = 1;
    wakati (zaidi) {
        n32 b7 = v & 127;
        v = v >> 7;
        n32 biti_ya_ishara = b7 & 64;
        n = n + 1;
        kama ((v == 0 && biti_ya_ishara == 0) || (v == 0 - 1 && biti_ya_ishara != 0)) {
            zaidi = 0;
        }
    }
    rudisha n;
}

// Memory section (id=5, Awamu 2): hesabu(=1) + limits (flag=0x00,
// min PEKEE -- hakuna max iliyotangazwa, memory.grow inaruhusiwa
// hadi kikomo cha injini). min_pages inakokotolewa kutoka data +
// heap ya awali (angalia uzalishaji_wasm_kuu).
w0 wasm_andika_sehemu_ya_kumbukumbu(n32 kiwango_cha_chini_cha_kurasa) {
    wasm_chombo_sasa = 0;
    wasm_baiti(5);
    n32 maudhui = wasm_ukubwa_wa_leb_a(1) + 1 + wasm_ukubwa_wa_leb_a(kiwango_cha_chini_cha_kurasa);
    wasm_leb_a(maudhui);
    wasm_leb_a(1);
    wasm_baiti(0);
    wasm_leb_a(kiwango_cha_chini_cha_kurasa);
}

// Global section (id=6, Awamu 2): global MOJA -- i32 inayobadilika
// (heap pointer, WASM_HEAP_GLOBAL_IDX=0), thamani ya awali =
// heap_init (baada ya data section -- angalia uzalishaji_wasm_kuu).
w0 wasm_andika_ulimwengu_sehemu(n32 kianzio_cha_akiba) {
    wasm_chombo_sasa = 0;
    wasm_baiti(6);
    n32 idadi = 1 + wasm_idadi_ya_vigeu_vya_ulimwengu;
    n32 maudhui = wasm_ukubwa_wa_leb_a(idadi) + 1 + 1 + 1 + wasm_ukubwa_wa_leb_n(kianzio_cha_akiba) + 1;
    n32 g = 0;
    wakati (g < wasm_idadi_ya_vigeu_vya_ulimwengu) {
        maudhui = maudhui + 1 + 1 + 1 + wasm_ukubwa_wa_leb_n(wasm_kianzio_cha_ulimwengu[g]) + 1;
        g = g + 1;
    }
    wasm_leb_a(maudhui);
    wasm_leb_a(idadi);
    wasm_baiti(WASM_I32);
    wasm_baiti(1);  // mutable = kweli
    wasm_baiti(65); wasm_leb_n(kianzio_cha_akiba);  // i32.const heap_init
    wasm_kitendo_mwisho();
    // Awamu 4: vigezo vya ulimwengu vya mtumiaji (global 1..N)
    g = 0;
    wakati (g < wasm_idadi_ya_vigeu_vya_ulimwengu) {
        wasm_baiti(WASM_I32);
        wasm_baiti(1);
        wasm_baiti(65); wasm_leb_n(wasm_kianzio_cha_ulimwengu[g]);
        wasm_kitendo_mwisho();
        g = g + 1;
    }
}

// Table section (id=4, Awamu 4): jedwali MOJA la funcref lenye nafasi
// kwa kila kazi ya ndani. Linaandikwa tu likitumika (&kazi), ili
// moduli zisizo na matukio zibaki kama zilivyokuwa.
w0 wasm_andika_sehemu_ya_jedwali() {
    kama (wasm_jedwali_linatumika == 0) { rudisha; }
    wasm_chombo_sasa = 0;
    wasm_baiti(4);
    wasm_leb_a(wasm_ukubwa_wa_leb_a(1) + 1 + 1 + wasm_ukubwa_wa_leb_a(wasm_idadi_ya_kazi));
    wasm_leb_a(1);
    wasm_baiti(112);  // 0x70 funcref
    wasm_baiti(0);    // mipaka: min pekee
    wasm_leb_a(wasm_idadi_ya_kazi);
}

// Element section (id=9, Awamu 4): segment MOJA amilifu ya jedwali 0
// kuanzia ofseti 0: kazi zote za ndani kwa mpangilio wao, hivyo
// jedwali[i] ni kazi ya ndani i (faharisi kamili i + uingizaji).
w0 wasm_andika_kipengele_sehemu() {
    kama (wasm_jedwali_linatumika == 0) { rudisha; }
    n32 orodha = wasm_ukubwa_wa_leb_a(wasm_idadi_ya_kazi);
    n32 i = 0;
    wakati (i < wasm_idadi_ya_kazi) {
        orodha = orodha + wasm_ukubwa_wa_leb_a(i + wasm_idadi_ya_uingizaji);
        i = i + 1;
    }
    wasm_chombo_sasa = 0;
    wasm_baiti(9);
    wasm_leb_a(wasm_ukubwa_wa_leb_a(1) + 1 + 3 + orodha);
    wasm_leb_a(1);
    wasm_leb_a(0);                              // aina 0: amilifu, jedwali 0, funcidx
    wasm_baiti(65); wasm_leb_n(0); wasm_kitendo_mwisho(); // ofseti: i32.const 0
    wasm_leb_a(wasm_idadi_ya_kazi);
    i = 0;
    wakati (i < wasm_idadi_ya_kazi) {
        wasm_leb_a(i + wasm_idadi_ya_uingizaji);
        i = i + 1;
    }
}

// Data section (id=11, Awamu 2): segment MOJA amilifu (memidx=0,
// offset=WASM_DATA_MSINGI) ikiwa na mfuatano YOTE yaliyokusanywa
// yamewekwa pamoja (wasm_data_buf, urefu=wasm_data_wapi). Ikiwa
// hakuna mfuatano lolote lililotumika, sehemu nzima inarukwa
// (moduli bila mfuatano haihitaji Data section kabisa).
w0 wasm_andika_data_sehemu() {
    kama (wasm_data_wapi == 0) { rudisha; }
    wasm_chombo_sasa = 0;
    wasm_baiti(11);
    n32 umbali_usemi_ukubwa = 1 + wasm_ukubwa_wa_leb_n(WASM_DATA_MSINGI) + 1;
    n32 ukubwa_wa_kipande = wasm_ukubwa_wa_leb_a(0) + umbali_usemi_ukubwa + wasm_ukubwa_wa_leb_a(wasm_data_wapi) + wasm_data_wapi;
    n32 maudhui = wasm_ukubwa_wa_leb_a(1) + ukubwa_wa_kipande;
    wasm_leb_a(maudhui);
    wasm_leb_a(1);
    wasm_leb_a(0);  // memidx = 0 (segment amilifu)
    wasm_baiti(65); wasm_leb_n(WASM_DATA_MSINGI); wasm_kitendo_mwisho();  // offset expr
    wasm_leb_a(wasm_data_wapi);
    n32 i = 0;
    wakati (i < wasm_data_wapi) { wasm_baiti(wasm_chombo_cha_data[i]); i = i + 1; }
}

// tenga(n) helper -- kazi iliyojengwa KWA MKONO (si kutoka AST ya
// mtumiaji), imeongezwa kwenye jedwali la kazi KAMA KAZI YA MWISHO
// (faharisi = wasm_tenga_idx, iliyowekwa baada ya Pitio la 1 --
// angalia uzalishaji_wasm_kuu) PEKEE ikiwa kweli imetumika
// (wasm_tenga_kutumika). Bump allocator rahisi: hoja=ukubwa
// uliopangwa juu hadi baiti 4; kama heap mpya inavuka ukurasa wa
// SASA (memory.size()*65536), memory.grow() kurasa za ziada
// zinazohitajika KABLA ya kuendelea -- kama grow inashindwa
// (inarudisha -1), "unreachable" (trap ya wakati wa kukimbia, sawa
// na jinsi mradi mzima unavyoshughulikia kushindwa kwa mmap kwenye
// x86-64 -- angalia mipaka.md #190).
w0 wasm_jenga_tenga_msaidizi() {
    wasm_chombo_sasa = 3;
    wasm_baiti(96);
    wasm_leb_a(1); wasm_baiti(WASM_I32);
    wasm_leb_a(1); wasm_baiti(WASM_I32);

    wasm_chombo_sasa = 1;
    wasm_kazi_wapi = 0;
    wasm_leb_a(1);
    wasm_leb_a(3);
    wasm_baiti(WASM_I32);

    // local1 = heap wa zamani (matokeo)
    wasm_kitendo_pata_ulimwengu(WASM_ULIMWENGU_WA_AKIBA);
    wasm_kitendo_weka_ndani(1);

    // local2 = (param0 + 3) & ~3  (kupanga juu hadi baiti 4)
    wasm_kitendo_pata_ndani(0);
    wasm_kitendo_i32_namba(3);
    wasm_kitendo_i32_jumlisha();
    wasm_kitendo_i32_namba(0 - 4);
    wasm_kitendo_i32_na();
    wasm_kitendo_weka_ndani(2);

    // local3 = heap mpya = local1 + local2
    wasm_kitendo_pata_ndani(1);
    wasm_kitendo_pata_ndani(2);
    wasm_kitendo_i32_jumlisha();
    wasm_kitendo_weka_ndani(3);

    // kama local3 > memory.size()*65536: kuza kumbukumbu
    wasm_kitendo_pata_ndani(3);
    wasm_kitendo_ukubwa_wa_kumbukumbu();
    wasm_kitendo_i32_namba(65536);
    wasm_kitendo_i32_zidisha();
    wasm_kitendo_i32_juu_n();
    wasm_kitendo_kama(WASM_UBETI_TUPU);
        wasm_kitendo_pata_ndani(3);
        wasm_kitendo_ukubwa_wa_kumbukumbu();
        wasm_kitendo_i32_namba(65536);
        wasm_kitendo_i32_zidisha();
        wasm_kitendo_i32_toa();
        wasm_kitendo_i32_namba(65535);
        wasm_kitendo_i32_jumlisha();
        wasm_kitendo_i32_namba(65536);
        wasm_kitendo_i32_gawanya_n();
        wasm_kitendo_panua_kumbukumbu();
        wasm_kitendo_i32_namba(0 - 1);
        wasm_kitendo_i32_sawa();
        wasm_kitendo_kama(WASM_UBETI_TUPU);
            wasm_kitendo_unreachable();
        wasm_kitendo_mwisho();
    wasm_kitendo_mwisho();

    // heap_ptr = local3; matokeo = local1
    wasm_kitendo_pata_ndani(3);
    wasm_kitendo_weka_ulimwengu(WASM_ULIMWENGU_WA_AKIBA);
    wasm_kitendo_pata_ndani(1);
    wasm_kitendo_mwisho();

    wasm_chombo_sasa = 2;
    wasm_hamisha_kutoka_kazi();
}

// Andika sehemu kamili (id + urefu wa sehemu + hesabu + maudhui ya
// chanzo) kuingia MODULI YA MWISHO. Hutumika kwa Type (id=1, chanzo=
// wasm_type_buf) na Code (id=10, chanzo=wasm_sec_buf) -- zote mbili
// zina umbo lile lile: hesabu(uleb128) + entries.
w0 wasm_andika_sehemu_kutoka(n32 kitambulisho, n32 idadi, n8* chanzo, n32 urefu_chanzo) {
    wasm_chombo_sasa = 0;
    wasm_baiti(kitambulisho);
    n32 jumla = wasm_ukubwa_wa_leb_a(idadi) + urefu_chanzo;
    wasm_leb_a(jumla);
    wasm_leb_a(idadi);
    n32 i = 0;
    wakati (i < urefu_chanzo) { wasm_baiti(chanzo[i]); i = i + 1; }
}

// Function section (id=3): hesabu + [faharisi_ya_aina]* -- faharisi
// ya aina == faharisi ya kazi (miongoni mwa za NDANI, 0..N-1) + I
// (aina 0..I-1 ni za uingizaji, zilizoandikwa KWANZA kwenye
// wasm_type_buf na wasm_andika_aina_uingizaji -- angalia
// uzalishaji_wasm_kuu). Hesabu ya kazi (wasm_kazi_idadi) YENYEWE
// haibadiliki -- Function section inaorodhesha kazi za NDANI PEKEE,
// uingizaji hauorodheshwi hapa (angalia Import section badala yake).
w0 wasm_andika_sehemu_ya_kazi() {
    n32 faharasa_ya_baiti = 0;
    n32 j = 0;
    wakati (j < wasm_idadi_ya_kazi) { faharasa_ya_baiti = faharasa_ya_baiti + wasm_ukubwa_wa_leb_a(j + wasm_idadi_ya_uingizaji); j = j + 1; }
    wasm_chombo_sasa = 0;
    wasm_baiti(3);
    n32 jumla = wasm_ukubwa_wa_leb_a(wasm_idadi_ya_kazi) + faharasa_ya_baiti;
    wasm_leb_a(jumla);
    wasm_leb_a(wasm_idadi_ya_kazi);
    n32 i = 0;
    wakati (i < wasm_idadi_ya_kazi) { wasm_leb_a(i + wasm_idadi_ya_uingizaji); i = i + 1; }
}

// Aina (Type entries) za kazi za nje -- huandikwa KWANZA kwenye
// wasm_type_buf, ili aina ya uingizaji i iwe faharisi i na kazi za
// mtumiaji zianze baada yake. Hoja na matokeo: n32 au kielekezi
// (i32) pekee -- wigo wa WASM wa Swa.
n32 kigeni_ni_w0(n32 k) {
    rudisha thamani_ya_nodi[kigeni_nodi_ya_kazi[k]] == 1280;  // w0
}

w0 wasm_andika_aina_uingizaji() {
    wasm_chombo_sasa = 3;
    n32 k = 0;
    wakati (k < kigeni_idadi_ya_kazi) {
        n32 f = kigeni_nodi_ya_kazi[k];
        n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kushoto[f]];
        kama (kigeni_kazi_ya_ziada[k]) {
            andika_kosa("KOSA: wasm -- kazi ya nje '%s': hoja za ziada (...) hazipo kwenye WASM\n", jina);
            wasm_kosa = 1;
        }
        kama (kigeni_ni_w0(k) == 0 && wasm_ni_n32_au_kielekezi_usimbaji(thamani_ya_nodi[f]) == 0) {
            andika_kosa("KOSA: wasm -- kazi ya nje '%s': matokeo lazima yawe n32, kielekezi au w0\n", jina);
            wasm_kosa = 1;
        }
        n32 idadi = 0;
        n32 pn = nodi_ya_kulia[f];
        wakati (pn != -1) {
            kama (wasm_ni_n32_au_kielekezi_usimbaji(thamani_ya_nodi[pn]) == 0) {
                andika_kosa("KOSA: wasm -- kazi ya nje '%s': hoja lazima ziwe n32 au kielekezi\n", jina);
                wasm_kosa = 1;
            }
            idadi = idadi + 1;
            pn = nodi_ya_kulia[pn];
        }
        wasm_baiti(96);
        wasm_leb_a(idadi);
        n32 j = 0;
        wakati (j < idadi) { wasm_baiti(WASM_I32); j = j + 1; }
        kama (kigeni_ni_w0(k)) { wasm_leb_a(0); } sivyo { wasm_leb_a(1); wasm_baiti(WASM_I32); }
        k = k + 1;
    }
    kama (kigeni_idadi_ya_data > 0) {
        andika_kosa("KOSA: wasm -- data ya nje haipo kwenye WASM (kazi za nje pekee)\n");
        wasm_kosa = 1;
    }
}

// Entry moja ya Import section: uleb128(len(moduli)) + moduli +
// uleb128(len(alama)) + alama + kind (func) + uleb128(faharisi_ya_aina).
// Moduli ni mfuatano wa `nje "<moduli>"`, alama ni jina lao.
n32 wasm_ukubwa_wa_jina(n8* s) {
    n32 l = urefu_wa_jina(s);
    rudisha wasm_ukubwa_wa_leb_a(l) + l;
}

w0 wasm_andika_jina(n8* s) {
    n32 l = urefu_wa_jina(s);
    wasm_leb_a(l);
    n32 i = 0;
    wakati (i < l) { wasm_baiti(s[i]); i = i + 1; }
}

// Import section (id=2): kila kazi ya nje. LAZIMA iandikwe KATI ya
// Type(1) na Function(3). Haiandikwi kabisa ikiwa hakuna uingizaji.
w0 wasm_andika_sehemu_uingizaji() {
    kama (kigeni_idadi_ya_kazi == 0) { rudisha; }
    n32 maudhui = wasm_ukubwa_wa_leb_a(kigeni_idadi_ya_kazi);
    n32 k = 0;
    wakati (k < kigeni_idadi_ya_kazi) {
        maudhui = maudhui + wasm_ukubwa_wa_jina(kigeni_ghala + kigeni_maktaba_umbali[kigeni_kazi_maktaba[k]]);
        maudhui = maudhui + wasm_ukubwa_wa_jina(kigeni_ghala + kigeni_umbali_wa_alama_ya_kazi[k]);
        maudhui = maudhui + 1 + wasm_ukubwa_wa_leb_a(k);
        k = k + 1;
    }
    wasm_chombo_sasa = 0;
    wasm_baiti(2);
    wasm_leb_a(maudhui);
    wasm_leb_a(kigeni_idadi_ya_kazi);
    k = 0;
    wakati (k < kigeni_idadi_ya_kazi) {
        wasm_andika_jina(kigeni_ghala + kigeni_maktaba_umbali[kigeni_kazi_maktaba[k]]);
        wasm_andika_jina(kigeni_ghala + kigeni_umbali_wa_alama_ya_kazi[k]);
        wasm_baiti(0);  // kind = func
        wasm_leb_a(k);
        k = k + 1;
    }
}

// Export section (id=7): "anza" (func) NA "memory" (Awamu 2 -- ili
// majaribio yaweze kusoma instance.exports.memory.buffer moja kwa
// moja kutoka Node).
w0 wasm_andika_sehemu_ya_uhamishaji(n32 faharasa_ya_kazi_ya_anza) {
    n32 ukubwa_wa_faharasa = wasm_ukubwa_wa_leb_a(faharasa_ya_kazi_ya_anza);
    n32 jina_ukubwa1 = wasm_ukubwa_wa_leb_a(4) + 4;  // "anza"
    n32 ingizo1 = jina_ukubwa1 + 1 + ukubwa_wa_faharasa;
    n32 jina_ukubwa2 = wasm_ukubwa_wa_leb_a(6) + 6;  // "memory"
    n32 ingizo2 = jina_ukubwa2 + 1 + wasm_ukubwa_wa_leb_a(0);
    n32 hesabu = 2;
    n32 ingizo3 = 0;
    kama (wasm_jedwali_linatumika) {
        hesabu = 3;
        ingizo3 = wasm_ukubwa_wa_leb_a(7) + 7 + 1 + wasm_ukubwa_wa_leb_a(0);  // "jedwali"
    }
    n32 ukubwa_wa_maudhui = wasm_ukubwa_wa_leb_a(hesabu) + ingizo1 + ingizo2 + ingizo3;
    wasm_chombo_sasa = 0;
    wasm_baiti(7);
    wasm_leb_a(ukubwa_wa_maudhui);
    wasm_leb_a(hesabu);
    wasm_leb_a(4);
    wasm_baiti(97); wasm_baiti(110); wasm_baiti(122); wasm_baiti(97);  // "anza"
    wasm_baiti(0);  // aina = func
    wasm_leb_a(faharasa_ya_kazi_ya_anza);
    wasm_leb_a(6);
    wasm_baiti(109); wasm_baiti(101); wasm_baiti(109); wasm_baiti(111); wasm_baiti(114); wasm_baiti(121);  // "memory"
    wasm_baiti(2);  // aina = memtype
    wasm_leb_a(0);
    kama (wasm_jedwali_linatumika) {
        wasm_leb_a(7);
        wasm_baiti(106); wasm_baiti(101); wasm_baiti(100); wasm_baiti(119); wasm_baiti(97); wasm_baiti(108); wasm_baiti(105);  // "jedwali"
        wasm_baiti(1);  // aina = table
        wasm_leb_a(0);
    }
}

n32 uzalishaji_wasm_kuu(n32 nodi_ya_programu) {
    wasm_kosa = 0;
    wasm_chombo_wapi = 0;
    wasm_kazi_wapi = 0;
    wasm_aina_wapi = 0;
    wasm_sehemu_wapi = 0;
    wasm_idadi_ya_kazi = 0;
    wasm_ghala_la_majina_ya_kazi_wapi = 1;
    wasm_chombo_sasa = 0;
    wasm_data_wapi = 0;
    wasm_idadi_ya_mifuatano = 0;
    wasm_tenga_kutumika = 0;
    wasm_idadi_ya_uingizaji = kigeni_idadi_ya_kazi;
    wasm_idadi_ya_vigeu_vya_ulimwengu = 0;
    wasm_jedwali_linatumika = 0;

    // Awamu 3: aina za kazi 6 zilizoingizwa zaandikwa KWANZA kwenye
    // wasm_type_buf (faharisi 0..5) -- KABLA ya Pitio la 1/2 la kazi
    // za mtumiaji (ambazo zitaanza kwenye faharisi ya aina 6+).
    wasm_andika_aina_uingizaji();

    // Pitio la 1: sajili kazi ZOTE za ngazi ya juu (kwa faharisi za
    // `call`) KABLA ya kuzalisha mwili wowote -- wito wa mbele
    // unahitaji hili.
    n8 ghala_la_majina_ndani[16384];
    wasm_ghala_la_majina_ya_kazi = ghala_la_majina_ndani;
    n32 gn = nodi_ya_kushoto[nodi_ya_programu];
    wakati (gn != -1) {
        // Kazi za nje ni uingizaji, si kazi za ndani
        kama (aina_ya_nodi[gn] == NODI_KAZI && kigeni_kazi_kwa_jina(ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kushoto[gn]]) >= 0) {
            gn = nne_ya_nodi[gn];
            endelea;
        }
        kama (aina_ya_nodi[gn] == NODI_KAZI) {
            kama (wasm_idadi_ya_kazi >= WASM_UPEO_KAZI) {
                andika_kosa("KOSA: wasm -- kazi nyingi mno (kikomo %d)\n", WASM_UPEO_KAZI);
                rudisha 1;
            }
            n32 jina_la_nodi = nodi_ya_kushoto[gn];
            n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[jina_la_nodi];
            n32 urefu = urefu_wa_jina(jina);
            n32 umbali = wasm_ghala_la_majina_ya_kazi_wapi;
            n32 ci = 0;
            wakati (ci < urefu) {
                wasm_ghala_la_majina_ya_kazi[umbali + ci] = jina[ci];
                ci = ci + 1;
            }
            wasm_ghala_la_majina_ya_kazi[umbali + urefu] = 0;
            wasm_ghala_la_majina_ya_kazi_wapi = umbali + urefu + 1;
            wasm_umbali_wa_jina_la_kazi[wasm_idadi_ya_kazi] = umbali;
            wasm_nodi_ya_kazi[wasm_idadi_ya_kazi] = gn;
            wasm_idadi_ya_kazi = wasm_idadi_ya_kazi + 1;
        } sivyo { kama (aina_ya_nodi[gn] == NODI_TANGAZO_ULIMWENGU) {
                // Awamu 4: n32 au kielekezi, kianzio cha namba halisi au
                // mfuatano halisi (au hakuna -> 0). Safu za ulimwengu bado
                // haziko kwenye wigo.
                n8* gjina = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kushoto[gn]];
                n32 kianzio_cha_ulimwengu = nodi_ya_kulia[gn];
                kama (wasm_ni_n32_au_kielekezi_usimbaji(thamani_ya_nodi[gn]) == 0) {
                    andika_kosa("KOSA: wasm -- kigezo cha ulimwengu '%s': n32 au kielekezi pekee kwenye Awamu 4\n", gjina);
                    rudisha 1;
                }
                kama (tatu_ya_nodi[gn] != -1) {
                    andika_kosa("KOSA: wasm -- safu ya ulimwengu '%s' haiko kwenye wigo wa Awamu 4\n", gjina);
                    rudisha 1;
                }
                kama (wasm_idadi_ya_vigeu_vya_ulimwengu >= WASM_UPEO_ULIMWENGU) {
                    andika_kosa("KOSA: wasm -- vigezo vya ulimwengu vingi mno (kikomo %d)\n", WASM_UPEO_ULIMWENGU);
                    rudisha 1;
                }
                n32 thamani_g = 0;
                kama (kianzio_cha_ulimwengu != -1) {
                    n8* gtxt = ghala_la_majina + umbali_wa_jina_la_nodi[kianzio_cha_ulimwengu];
                    kama (aina_ya_nodi[kianzio_cha_ulimwengu] == NODI_NAMBARI && nodi_ya_kulia[kianzio_cha_ulimwengu] != 1) {
                        thamani_g = thamani_ya_nodi[kianzio_cha_ulimwengu];
                    } sivyo { kama (aina_ya_nodi[kianzio_cha_ulimwengu] == NODI_KITAMBULISHO && gtxt[0] == 34) {
                            thamani_g = wasm_ongeza_mfuatano(gtxt);
                        } sivyo {
                            andika_kosa("KOSA: wasm -- kianzio cha kigezo cha ulimwengu '%s' lazima kiwe namba halisi au mfuatano halisi\n", gjina);
                            rudisha 1;
                        } }
                }
                wasm_jina_la_ulimwengu[wasm_idadi_ya_vigeu_vya_ulimwengu] = gjina;
                wasm_kianzio_cha_ulimwengu[wasm_idadi_ya_vigeu_vya_ulimwengu] = thamani_g;
                wasm_idadi_ya_vigeu_vya_ulimwengu = wasm_idadi_ya_vigeu_vya_ulimwengu + 1;
            } sivyo { kama (aina_ya_nodi[gn] != NODI_MUUNDO) {
                andika_kosa("KOSA: wasm -- ujenzi wa ngazi ya juu haukubaliki (aina ya AST=%d)\n", aina_ya_nodi[gn]);
                rudisha 1;
            } } }
        gn = nne_ya_nodi[gn];
    }

    n32 faharasa_ya_kazi_ya_anza = wasm_tafuta_kazi("anza");
    kama (faharasa_ya_kazi_ya_anza < 0) {
        faharasa_ya_kazi_ya_anza = wasm_tafuta_kazi("main");
        kama (faharasa_ya_kazi_ya_anza >= 0) { onya_neno_la_zamani("main", "anza"); }
    }
    kama (faharasa_ya_kazi_ya_anza < 0) {
        andika_kosa("KOSA: wasm -- hakuna kazi 'anza'\n");
        rudisha 1;
    }
    // Awamu 3: export inahitaji faharisi ya function-index-space
    // KAMILI (baada ya kazi 6 za uingizaji), si faharisi ya ndani tu.
    faharasa_ya_kazi_ya_anza = faharasa_ya_kazi_ya_anza + wasm_idadi_ya_uingizaji;

    // Faharisi ya helper ya tenga() imewekwa SASA (mara tu baada ya
    // Pitio la 1, idadi ya kazi za mtumiaji ikiwa imekamilika kikamilifu)
    // -- itatumika kama faharisi ya kudumu kwenye kila `call` ya
    // tenga() ndani ya Pitio la 2, kabla helper yenyewe haijajengwa.
    wasm_tenga_faharasa = wasm_idadi_ya_kazi;

    // Pitio la 2: jenga kila kazi -- Type entry huingia wasm_type_buf
    // na Code entry huingia wasm_sec_buf, ZOTE MBILI zikiendelea
    // (hazisafishwi) kati ya kazi, hivyo faharisi ya mpangilio wa
    // kazi (i) ni faharisi ya aina (Type index) NA faharisi ya kazi
    // (Function/Code index) KWA WAKATI MMOJA -- angalia
    // wasm_andika_function_sehemu (0..N-1 moja kwa moja).
    n32 i = 0;
    wakati (i < wasm_idadi_ya_kazi) {
        wasm_jenga_kazi(wasm_nodi_ya_kazi[i]);
        i = i + 1;
    }

    kama (wasm_kosa) { rudisha 1; }

    // Awamu 2: helper ya tenga() -- kazi ya MWISHO (faharisi
    // wasm_tenga_idx == wasm_kazi_idadi ya sasa), imeongezwa PEKEE
    // ikiwa kweli imetumika popote kwenye Pitio la 2 hapo juu.
    kama (wasm_tenga_kutumika) {
        wasm_jenga_tenga_msaidizi();
        wasm_idadi_ya_kazi = wasm_idadi_ya_kazi + 1;
    }

    kama (wasm_kosa) { rudisha 1; }

    // Heap huanza mara tu baada ya data (mfuatano) yote, iliyopangwa
    // juu hadi baiti 4. Kurasa za awali za kumbukumbu (min_pages)
    // zinahitajika kutosha KUSHIKILIA data + heap ya awali kabla ya
    // memory.grow yoyote kuhitajika wakati wa kukimbia.
    n32 kianzio_cha_akiba = WASM_DATA_MSINGI + wasm_data_wapi;
    kianzio_cha_akiba = (kianzio_cha_akiba + 3) & (0 - 4);
    n32 kiwango_cha_chini_cha_kurasa = (kianzio_cha_akiba + 65535) / 65536;
    kama (kiwango_cha_chini_cha_kurasa < 1) { kiwango_cha_chini_cha_kurasa = 1; }

    // ---- Assemble moduli: kichwa -> Type -> Import -> Function ->
    // Memory -> Global -> Export -> Code -> Data (mpangilio
    // ulioamriwa na kiwango cha WASM kwa faharisi ya sehemu:
    // 1,2,3,5,6,7,10,11) ----
    // MUHIMU: wasm_jenga_kazi/wasm_jenga_tenga_helper ya mwisho huacha
    // wasm_bafu_sasa == 2 (sec_buf) -- lazima irudishwe kwa 0
    // (wasm_bafu) HAPA kabla ya kuandika kichwa, la sivyo kichwa
    // huingia kimya kwenye sec_buf (mdudu halisi uliopatikana kwa
    // kujaribu t1.swa: "asm"+toleo ilijitokeza MWISHONI mwa faili
    // badala ya MWANZONI).
    wasm_chombo_sasa = 0;
    wasm_utangulizi();
    // Hesabu ya Type section ni kazi za NDANI (wasm_kazi_idadi) +
    // uingizaji 6 (Awamu 3) -- wasm_type_buf sasa ina aina ZOTE mbili
    // (uingizaji zimeandikwa kwanza na wasm_andika_aina_uingizaji).
    wasm_andika_sehemu_kutoka(1, wasm_idadi_ya_kazi + wasm_idadi_ya_uingizaji, wasm_chombo_cha_aina, wasm_aina_wapi);
    wasm_andika_sehemu_uingizaji();
    wasm_andika_sehemu_ya_kazi();
    wasm_andika_sehemu_ya_jedwali();
    wasm_andika_sehemu_ya_kumbukumbu(kiwango_cha_chini_cha_kurasa);
    wasm_andika_ulimwengu_sehemu(kianzio_cha_akiba);
    wasm_andika_sehemu_ya_uhamishaji(faharasa_ya_kazi_ya_anza);
    wasm_andika_kipengele_sehemu();
    wasm_andika_sehemu_kutoka(10, wasm_idadi_ya_kazi, wasm_chombo_cha_sehemu, wasm_sehemu_wapi);
    wasm_andika_data_sehemu();

    kama (wasm_kosa) { rudisha 1; }

    mfumo_andika(1, wasm_chombo, wasm_chombo_wapi);
    rudisha 0;
}

// -------------------------------------------------------
// --wasm-js: daraja la JS (daraja la mashine, awamu 4)
// -------------------------------------------------------
// Kivinjari hukubali JS na WASM pekee, hivyo daraja lenyewe ni JS --
// lakini huandikwa na mkusanyaji, kama kichwa cha ELF, si kwa mkono.
// Ni la jumla: shughuli 14 za kumbukumbu ya vitu (pata, weka, ita,
// mfuatano, kazi ...). Mantiki yote ya DOM iko kwenye Swa
// (msingi/maktaba/kivinjari.swa).
w0 wasm_js_mstari(n8* s) {
    mfumo_andika(1, s, urefu_wa_jina(s));
    mfumo_andika(1, "\n", 1);
}

w0 wasm_andika_kiolesura_js() {
    wasm_js_mstari("// swa-js.js -- daraja la JS la Swa. Limetolewa na `swa --wasm-js`; usilihariri.");
    wasm_js_mstari("// Halina mantiki ya programu: Swa hufanya kila kitu kupitia uingizaji wa");
    wasm_js_mstari("// moduli 'js' (msingi/maktaba/kivinjari.swa). Kitu cha JS hushikwa kwa");
    wasm_js_mstari("// namba (kishiko): 0 = tupu, 1 = nodi kuu.");
    wasm_js_mstari("(function (nje) {");
    wasm_js_mstari("    'use strict';");
    wasm_js_mstari("    function unganisha(nodi_kuu) {");
    wasm_js_mstari("        const vitu = [undefined, nodi_kuu];");
    wasm_js_mstari("        const huru = [];");
    wasm_js_mstari("        const msimbuaji = new TextDecoder('utf-8');");
    wasm_js_mstari("        let kumbukumbu = null;");
    wasm_js_mstari("        let jedwali = null;");
    wasm_js_mstari("        function shika(x) {");
    wasm_js_mstari("            const h = huru.length > 0 ? huru.pop() : vitu.length;");
    wasm_js_mstari("            vitu[h] = x;");
    wasm_js_mstari("            return h;");
    wasm_js_mstari("        }");
    wasm_js_mstari("        function soma(p) {");
    wasm_js_mstari("            const b = new Uint8Array(kumbukumbu.buffer);");
    wasm_js_mstari("            let m = p;");
    wasm_js_mstari("            while (b[m] !== 0) { m = m + 1; }");
    wasm_js_mstari("            return msimbuaji.decode(b.subarray(p, m));");
    wasm_js_mstari("        }");
    wasm_js_mstari("        function achilia(h) {");
    wasm_js_mstari("            if (h > 1 && h < vitu.length && vitu[h] !== undefined) { vitu[h] = undefined; huru.push(h); }");
    wasm_js_mstari("        }");
    wasm_js_mstari("        const js = {");
    wasm_js_mstari("            nodi_kuu: () => 1,");
    wasm_js_mstari("            kimataifa: (jina) => shika(globalThis[soma(jina)]),");
    wasm_js_mstari("            pata: (h, sifa) => shika(vitu[h][soma(sifa)]),");
    wasm_js_mstari("            weka: (h, sifa, t) => { vitu[h][soma(sifa)] = vitu[t]; },");
    wasm_js_mstari("            ita0: (h, njia) => shika(vitu[h][soma(njia)]()),");
    wasm_js_mstari("            ita1: (h, njia, a) => shika(vitu[h][soma(njia)](vitu[a])),");
    wasm_js_mstari("            ita2: (h, njia, a, b) => shika(vitu[h][soma(njia)](vitu[a], vitu[b])),");
    wasm_js_mstari("            ita3: (h, njia, a, b, c) => shika(vitu[h][soma(njia)](vitu[a], vitu[b], vitu[c])),");
    wasm_js_mstari("            mfuatano: (p) => shika(soma(p)),");
    wasm_js_mstari("            namba: (n) => shika(n),");
    wasm_js_mstari("            kwa_namba: (h) => Number(vitu[h]) | 0,");
    wasm_js_mstari("            kazi: (k) => shika(function (...hoja) {");
    wasm_js_mstari("                const vs = hoja.map(shika);");
    wasm_js_mstari("                try { return jedwali.get(k)(...vs); } finally { vs.forEach(achilia); }");
    wasm_js_mstari("            }),");
    wasm_js_mstari("            achilia: achilia,");
    wasm_js_mstari("        };");
    wasm_js_mstari("        function weka_moduli(exports) {");
    wasm_js_mstari("            kumbukumbu = exports.memory;");
    wasm_js_mstari("            jedwali = exports.jedwali || null;");
    wasm_js_mstari("        }");
    wasm_js_mstari("        return { js, weka_moduli, vitu };");
    wasm_js_mstari("    }");
    wasm_js_mstari("    async function anzishaSwa(chanzo, nodi_kuu, ziada) {");
    wasm_js_mstari("        const baiti = typeof chanzo === 'string' ? await (await fetch(chanzo)).arrayBuffer() : chanzo;");
    wasm_js_mstari("        if (nodi_kuu === undefined && globalThis.document) { nodi_kuu = globalThis.document.body; }");
    wasm_js_mstari("        const d = unganisha(nodi_kuu);");
    wasm_js_mstari("        const uingizaji = Object.assign({ js: d.js }, ziada || {});");
    wasm_js_mstari("        const { instance } = await WebAssembly.instantiate(baiti, uingizaji);");
    wasm_js_mstari("        d.weka_moduli(instance.exports);");
    wasm_js_mstari("        const matokeo = instance.exports.anza();");
    wasm_js_mstari("        return { instance, matokeo, vitu: d.vitu };");
    wasm_js_mstari("    }");
    wasm_js_mstari("    nje.anzishaSwa = anzishaSwa;");
    wasm_js_mstari("    if (typeof module !== 'undefined' && module.exports) { module.exports = { anzishaSwa }; }");
    wasm_js_mstari("})(typeof globalThis !== 'undefined' ? globalThis : this);");
}
