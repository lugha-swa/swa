// ==========================================================
// uzalishaji_wasm.swa :: Kizalishe cha WebAssembly (kwa kivinjari)
//
// Backend ya PILI, sambamba na uzalishaji.swa (x86-64/ELF) -- kutoka
// AST ile ile (baada ya kuunganishwa kwa kazi ndogo, ukaguzi wa
// kisemantiki, LICM, SSCSE -- sawa na uzalishaji.swa, angalia
// stage1.swa main()). Hutoa moduli ya WebAssembly (binary, si WAT)
// moja kwa moja kwenye stdout. Hakuna wat2wasm, hakuna tegemezi la
// nje -- sawa na falsafa ya mradi mzima.
//
// AWAMU YA 1 (wigo wa sasa): n32 pekee -- hesabu, ulinganisho,
// &&/||, kama/sivyo, wakati (+vunja/endelea/kwa), wito wa kazi,
// rudisha. HAKUNA: vielekezi, safu, d64/D32, miundo, vigezo vya
// ulimwengu, I/O (andika), tenga(), wito_wa_mfumo. Ujenzi wowote
// ulio nje ya wigo huu UNATOA KOSA LA WAZI, si baiti mbovu za kimya.
//
// KANUNI YA MAJINA: kila kitambulisho cha ngazi ya juu hapa
// kimeambatanishwa na "wasm_" -- Swa haina namespace, na
// uzalishaji.swa ina majina ya jumla (andika_baiti, bafa_text, n.k.)
// ambayo yangegongana kimya kimya. Vitu vya KUSHIRIKIWA (kutoka
// uzalishaji.swa/msambazaji.swa, VISIVYOBADILISHWA hapa):
// ni_desimali_enc, ukubwa_kutoka_enc, ni_muundo_enc,
// ni_bila_ishara_enc, jina_linganisha, safu za AST (ast_aina,
// ast_kushoto, ast_kulia, ast_tiga, ast_nne, ast_thamani,
// ast_jina_off, ast_pool), viainishi AST_*.
// ==========================================================

// -------------------------------------------------------
// Sehemu 0: Bafa na visaidizi vya msingi vya baiti
//
// WASM inahitaji urefu wa LEB128 kabla ya maudhui ya kila sehemu na
// kila mwili wa kazi -- urefu HAUJULIKANI mpaka maudhui yamalizike.
// x86-64 haihitaji hili (jump offsets ni fixed-width, zinaweza
// kurekebishwa baadaye kwa fixup). Sehemu za Type na Code LAZIMA
// zisitangamane -- entries za aina zote pamoja kwenye SEHEMU MOJA
// (Type section), na miili ya kazi zote pamoja kwenye SEHEMU NYINGINE
// (Code section) -- hivyo bafa NNE, si moja:
//   wasm_fn_buf    -- mwili wa kazi MOJA ya SASA (locals+maagizo+0x0B),
//                     inasafishwa kwa kila kazi
//   wasm_type_buf  -- inakusanya entries za AINA za kazi ZOTE (functype
//                     bytes, hazihitaji urefu wa mtu binafsi -- kila
//                     moja ni self-delimiting kwa hesabu zake wenyewe),
//                     KATIKA MZUNGUKO MZIMA wa kazi zote, si kwa kazi
//                     moja pekee
//   wasm_sec_buf   -- inakusanya entries za MWILI za kazi ZOTE (Code
//                     section -- kila entry INAHITAJI urefu wake kwa
//                     sababu miili ina urefu tofauti-tofauti), KATIKA
//                     MZUNGUKO MZIMA wa kazi zote
//   wasm_bafu      -- moduli ya mwisho, inatolewa MARA MOJA mwishoni
// -------------------------------------------------------

n8 wasm_bafu[524288];
n32 wasm_bafu_wapi = 0;

n8 wasm_fn_buf[65536];
n32 wasm_fn_wapi = 0;

n8 wasm_type_buf[16384];
n32 wasm_type_wapi = 0;

n8 wasm_sec_buf[262144];
n32 wasm_sec_wapi = 0;

// Ni bafa gani "ya sasa" inayopokea baiti? 0=wasm_bafu, 1=wasm_fn_buf,
// 2=wasm_sec_buf (Code), 3=wasm_type_buf (Type).
n32 wasm_bafu_sasa = 0;

// -------------------------------------------------------
// Sehemu 0b (Awamu 2): Data section (mfuatano halisi) na jedwali la
// mfuatano lililokusanywa. TOFAUTI na wasm_baiti/wasm_bafu_sasa
// zilizopo: wasm_data_buf HUANDIKWA MOJA KWA MOJA kwa faharisi (SI
// kupitia wasm_baiti) kwa sababu mkusanyiko wa mfuatano hutokea
// KATIKATI ya uzalishaji wa mwili wa kazi (wasm_bafu_sasa==1 wakati
// huo) -- kupitia wasm_baiti kungeharibu hali ya kimataifa ya bafa
// inayoshughulikiwa.
// -------------------------------------------------------

n8 wasm_data_buf[65536];
n32 wasm_data_wapi = 0;
n32 WASM_DATA_MSINGI = 1024;  // ofseti ya kwanza ya kumbukumbu kwa data (0..1023 imehifadhiwa)

n32 WASM_MAX_MFUATANO = 128;
n32 wasm_str_off[128];   // ofseti YA KUMBUKUMBU (WASM linear memory) ya kila mfuatano wa kipekee
n32 wasm_str_idadi = 0;

n32 wasm_tenga_kutumika = 0;
n32 wasm_tenga_idx = 0;
n32 WASM_HEAP_GLOBAL_IDX = 0;  // faharisi pekee ya WASM Global (heap pointer)

// -------------------------------------------------------
// Sehemu 0c (Awamu 3): Sehemu ya Uingizaji (Import) -- kazi 6 za JS
// (daraja la DOM) zinazoingizwa kama (module="env", field=<jina>).
// Function index space ya WASM inaamuru: uingizaji 0..I-1 KWANZA,
// KISHA kazi za ndani I..I+N-1 -- `wasm_import_idadi` (=6, imara)
// ni nyongeza inayohitajika kwenye KILA mahali panapoandika faharisi
// ya kazi ya NDANI (call/export/function-section type index) -- SI
// kwenye wito wa kazi za uingizaji zenyewe (hizo tayari ziko 0..5).
// -------------------------------------------------------

n32 wasm_import_idadi = 0;

// Kioo cha wasm_op_call lakini kwa kazi za NDANI (mtumiaji/tenga) --
// inaongeza wasm_import_idadi kiotomatiki. Kazi za uingizaji (dom_*/
// console_andika) zinaitwa na wasm_op_call ghafi (faharisi 0..5 moja
// kwa moja), SI kupitia hii.
w0 wasm_op_call_kazi(n32 kidx) {
    wasm_op_call(kidx + wasm_import_idadi);
}

// Kusanya herufi halisi (mfuatano) kwenye wasm_data_buf -- kioo cha
// kusanya_herufi (uzalishaji.swa) lakini kinacholenga kumbukumbu ya
// WASM (ofseti ya n32) badala ya lebo ya x86-64. `raw` ni maandishi
// GHAFI ya tokeni (yanayoanza na `"`, angalia uzalishaji_kitambulisho
// kwa muundo ule ule). Hurudisha OFSETI YA KUMBUKUMBU ya baiti za
// kwanza za mfuatano (zilizoishia \0), zikiwa tayari zimeandikwa
// (au zilizopo tayari, ikiwa mfuatano huu umeshahifadhiwa -- dedup
// kwa kulinganisha baiti zilizodondolewa moja kwa moja).
n32 wasm_ongeza_mfuatano(n8* raw) {
    n8 tmp[4096];
    n32 start = 1;
    n32 end_ = start;
    wakati (raw[end_] != 0) {
        kama (raw[end_] == 92) { end_ = end_ + 2; endelea; }
        kama (raw[end_] == 34) { vunja; }
        end_ = end_ + 1;
    }

    n32 len = 0;
    n32 j = start;
    wakati (j < end_) {
        kama (raw[j] == 92) {
            n32 c = raw[j + 1];
            kama (c == 110) { tmp[len] = 10; }
            sivyo { kama (c == 116) { tmp[len] = 9; }
            sivyo { kama (c == 48) { tmp[len] = 0; }
            sivyo { tmp[len] = c; } } }
            len = len + 1;
            j = j + 2;
        } sivyo {
            tmp[len] = raw[j];
            len = len + 1;
            j = j + 1;
        }
    }
    tmp[len] = 0;  // null terminator -- mkataba wa majaribio ya "mfuatano"

    // Dedup: linganisha baiti zilizodondolewa (ikiwemo \0 ya mwisho)
    // dhidi ya kila mfuatano ulioshahifadhiwa.
    n32 i = 0;
    wakati (i < wasm_str_idadi) {
        n32 o = wasm_str_off[i] - WASM_DATA_MSINGI;
        n32 sawa = 1;
        n32 k = 0;
        wakati (k <= len) {
            kama (wasm_data_buf[o + k] != tmp[k]) { sawa = 0; vunja; }
            k = k + 1;
        }
        kama (sawa) { rudisha wasm_str_off[i]; }
        i = i + 1;
    }

    kama (wasm_str_idadi >= WASM_MAX_MFUATANO || wasm_data_wapi + len + 1 >= 65536) {
        andika_stderr("KOSA: wasm -- jedwali la mfuatano halisi (Awamu 2) limejaa\n");
        wasm_kosa = 1;
        rudisha WASM_DATA_MSINGI;
    }

    n32 mem_off = WASM_DATA_MSINGI + wasm_data_wapi;
    n32 k2 = 0;
    wakati (k2 <= len) {
        wasm_data_buf[wasm_data_wapi] = tmp[k2];
        wasm_data_wapi = wasm_data_wapi + 1;
        k2 = k2 + 1;
    }
    wasm_str_off[wasm_str_idadi] = mem_off;
    wasm_str_idadi = wasm_str_idadi + 1;
    rudisha mem_off;
}

// Alama ya kosa la nje ya wigo (Awamu 1) -- imewekwa mahali popote
// ujenzi usiotumika unapatikana; uzalishaji_wasm_kuu huangalia hii
// baada ya kutembea kila kazi na kutoka bila kutoa moduli mbovu.
n32 wasm_kosa = 0;

w0 wasm_baiti(n32 b) {
    kama (wasm_bafu_sasa == 1) {
        kama (wasm_fn_wapi < 65536) {
            wasm_fn_buf[wasm_fn_wapi] = b & 255;
            wasm_fn_wapi = wasm_fn_wapi + 1;
        } sivyo {
            andika_stderr("KOSA: wasm_fn_buf imefurika\n");
            wasm_kosa = 1;
        }
        rudisha;
    }
    kama (wasm_bafu_sasa == 2) {
        kama (wasm_sec_wapi < 262144) {
            wasm_sec_buf[wasm_sec_wapi] = b & 255;
            wasm_sec_wapi = wasm_sec_wapi + 1;
        } sivyo {
            andika_stderr("KOSA: wasm_sec_buf imefurika\n");
            wasm_kosa = 1;
        }
        rudisha;
    }
    kama (wasm_bafu_sasa == 3) {
        kama (wasm_type_wapi < 16384) {
            wasm_type_buf[wasm_type_wapi] = b & 255;
            wasm_type_wapi = wasm_type_wapi + 1;
        } sivyo {
            andika_stderr("KOSA: wasm_type_buf imefurika\n");
            wasm_kosa = 1;
        }
        rudisha;
    }
    kama (wasm_bafu_wapi < 524288) {
        wasm_bafu[wasm_bafu_wapi] = b & 255;
        wasm_bafu_wapi = wasm_bafu_wapi + 1;
    } sivyo {
        andika_stderr("KOSA: wasm_bafu imefurika\n");
        wasm_kosa = 1;
    }
}

// LEB128 isiyo na ishara -- kwa urefu wa sehemu, idadi, faharisi
// (zote hasi za Awamu 1 hazitokei; ikitokea hasi, ni mdudu wa ndani).
w0 wasm_uleb128(n32 v) {
    n32 zaidi = 1;
    wakati (zaidi) {
        n32 b7 = v & 127;
        v = (v >> 7) & 33554431;  // shift ya biti bila ishara (v ni >=0 hapa)
        kama (v != 0) {
            wasm_baiti(b7 | 128);
        } sivyo {
            wasm_baiti(b7);
            zaidi = 0;
        }
    }
}

// LEB128 yenye ishara -- kwa i32.const pekee.
w0 wasm_sleb128(n32 v) {
    n32 zaidi = 1;
    wakati (zaidi) {
        n32 b7 = v & 127;
        v = v >> 7;  // shift ya biti ya kuhifadhi ishara (>> ya Swa kwenye n32 ni ya hesabu)
        n32 ishara_bit = b7 & 64;
        kama ((v == 0 && ishara_bit == 0) || (v == 0 - 1 && ishara_bit != 0)) {
            wasm_baiti(b7);
            zaidi = 0;
        } sivyo {
            wasm_baiti(b7 | 128);
        }
    }
}

// Nakili baiti n za bafu ya CHANZO (id: 1=fn_buf, 2=sec_buf) kuingia
// bafu ya SASA, ukiandika urefu wa LEB128 kabla -- hii NDIYO
// inayochukua nafasi ya "backpatch" ya x86-64.
w0 wasm_hamisha_kutoka_fn() {
    wasm_uleb128(wasm_fn_wapi);
    n32 i = 0;
    n32 lengwa_zamani = wasm_bafu_sasa;
    wakati (i < wasm_fn_wapi) {
        n8 b = wasm_fn_buf[i];
        wasm_bafu_sasa = lengwa_zamani;
        wasm_baiti(b);
        i = i + 1;
    }
    wasm_fn_wapi = 0;
}

// -------------------------------------------------------
// Sehemu 1: Opcodes za msingi (majina wazi badala ya namba tupu)
// -------------------------------------------------------

n32 WASM_I32 = 127;  // 0x7F -- aina ya thamani i32 (na blocktype yenye matokeo)
n32 WASM_VOID_BT = 64;  // 0x40 -- blocktype tupu (hakuna matokeo)

w0 wasm_op_end() { wasm_baiti(11); }        // 0x0B
w0 wasm_op_block(n32 bt) { wasm_baiti(2); wasm_baiti(bt & 255); }   // 0x02
w0 wasm_op_loop(n32 bt) { wasm_baiti(3); wasm_baiti(bt & 255); }    // 0x03
w0 wasm_op_if(n32 bt) { wasm_baiti(4); wasm_baiti(bt & 255); }      // 0x04
w0 wasm_op_else() { wasm_baiti(5); }        // 0x05
w0 wasm_op_br(n32 kina) { wasm_baiti(12); wasm_uleb128(kina); }     // 0x0C
w0 wasm_op_br_if(n32 kina) { wasm_baiti(13); wasm_uleb128(kina); }  // 0x0D
w0 wasm_op_call(n32 idx) { wasm_baiti(16); wasm_uleb128(idx); }     // 0x10
w0 wasm_op_return() { wasm_baiti(15); }     // 0x0F
w0 wasm_op_drop() { wasm_baiti(26); }       // 0x1A
w0 wasm_op_unreachable() { wasm_baiti(0); } // 0x00

w0 wasm_op_local_get(n32 idx) { wasm_baiti(32); wasm_uleb128(idx); }  // 0x20
w0 wasm_op_local_set(n32 idx) { wasm_baiti(33); wasm_uleb128(idx); }  // 0x21
w0 wasm_op_local_tee(n32 idx) { wasm_baiti(34); wasm_uleb128(idx); }  // 0x22

w0 wasm_op_i32_const(n32 v) { wasm_baiti(65); wasm_sleb128(v); }    // 0x41

w0 wasm_op_i32_eqz() { wasm_baiti(69); }   // 0x45
w0 wasm_op_i32_eq() { wasm_baiti(70); }    // 0x46
w0 wasm_op_i32_ne() { wasm_baiti(71); }    // 0x47
w0 wasm_op_i32_lt_s() { wasm_baiti(72); }  // 0x48
w0 wasm_op_i32_gt_s() { wasm_baiti(74); }  // 0x4A
w0 wasm_op_i32_le_s() { wasm_baiti(76); }  // 0x4C
w0 wasm_op_i32_ge_s() { wasm_baiti(78); }  // 0x4E

w0 wasm_op_i32_add() { wasm_baiti(106); }  // 0x6A
w0 wasm_op_i32_sub() { wasm_baiti(107); }  // 0x6B
w0 wasm_op_i32_mul() { wasm_baiti(108); }  // 0x6C
w0 wasm_op_i32_div_s() { wasm_baiti(109); }  // 0x6D
w0 wasm_op_i32_rem_s() { wasm_baiti(111); }  // 0x6F
w0 wasm_op_i32_and() { wasm_baiti(113); }  // 0x71
w0 wasm_op_i32_or() { wasm_baiti(114); }   // 0x72
w0 wasm_op_i32_xor() { wasm_baiti(115); }  // 0x73

// Awamu 2: kumbukumbu, globals, na ukuaji wa kumbukumbu.
// i32.load/i32.store: align=2 (mzani wa asili wa baiti 4), offset=0
// KILA WAKATI -- anwani kamili tayari imekokotolewa kwenye stack
// (base+idx*4) kabla ya agizo hili, si kupitia offset ya ModRM-kama
// ya WASM (tofauti na SIB ya x86-64, WASM haina "scaled index",
// hesabu yote ni ya wazi kwenye stack).
w0 wasm_op_i32_load() { wasm_baiti(40); wasm_uleb128(2); wasm_uleb128(0); }   // 0x28
w0 wasm_op_i32_store() { wasm_baiti(54); wasm_uleb128(2); wasm_uleb128(0); }  // 0x36

w0 wasm_op_global_get(n32 idx) { wasm_baiti(35); wasm_uleb128(idx); }  // 0x23
w0 wasm_op_global_set(n32 idx) { wasm_baiti(36); wasm_uleb128(idx); }  // 0x24

w0 wasm_op_memory_size() { wasm_baiti(63); wasm_baiti(0); }  // 0x3F 0x00 (memidx=0)
w0 wasm_op_memory_grow() { wasm_baiti(64); wasm_baiti(0); }  // 0x40 0x00 (memidx=0)

// -------------------------------------------------------
// Sehemu 2: Jedwali la kazi za ngazi ya juu (kwa faharisi za `call`)
// -------------------------------------------------------

n32 WASM_MAX_KAZI = 256;
n8* wasm_kazi_jina_pool;  // huhifadhi majina (nakala kutoka ast_pool)
n32 wasm_kazi_jina_off[256];
n32 wasm_kazi_node[256];
n32 wasm_kazi_idadi = 0;
n32 wasm_kazi_jina_pool_wapi = 1;

// Je, kazi yenye faharisi kidx (kutoka wasm_tafuta_kazi) inarudisha
// w0 (tupu)? Inahitajika kuamua kama wito-kama-taarifa unahitaji
// "drop" baada yake -- WASM inakataa "drop" bila thamani kwenye rafu
// (imepatikana kwa jaribio halisi: kazi_tupu(5) kama taarifa ilitoa
// "not enough arguments on the stack for drop").
n32 wasm_kazi_ni_w0(n32 kidx) {
    rudisha wasm_ni_w0_enc(ast_thamani[wasm_kazi_node[kidx]]);
}

n32 wasm_tafuta_kazi(n8* jina) {
    n32 i = 0;
    wakati (i < wasm_kazi_idadi) {
        kama (jina_linganisha(wasm_kazi_jina_pool + wasm_kazi_jina_off[i], jina)) {
            rudisha i;
        }
        i = i + 1;
    }
    rudisha -1;
}

// -------------------------------------------------------
// Sehemu 3: Jedwali la "locals" za kazi ya SASA (paramu + vigezo
// vya ndani vyote, pamoja na vilivyopachikwa ndani ya kama/wakati)
// -------------------------------------------------------

n32 WASM_MAX_LOCALS = 128;
n8* wasm_local_jina[128];
n32 wasm_local_idadi = 0;
n32 wasm_local_paramu_idadi = 0;  // ngapi kati ya hizo ni paramu (0..P-1)

n32 wasm_tafuta_local(n8* jina) {
    n32 i = 0;
    wakati (i < wasm_local_idadi) {
        kama (jina_linganisha(wasm_local_jina[i], jina)) { rudisha i; }
        i = i + 1;
    }
    rudisha -1;
}

// Ongeza local mpya (kama haijasajiliwa tayari kwa jina hilo --
// kigezo chenye jina linalofanana kwenye wigo tofauti/kilichopachikwa
// kinashiriki nafasi moja, kama x86-64's pata_au_unda_kigeu_ukubwa).
n32 wasm_ongeza_local(n8* jina) {
    n32 iliyopo = wasm_tafuta_local(jina);
    kama (iliyopo >= 0) { rudisha iliyopo; }
    kama (wasm_local_idadi >= WASM_MAX_LOCALS) {
        andika_stderr("KOSA: wasm -- vigezo vingi mno kwenye kazi moja (kikomo %d)\n", WASM_MAX_LOCALS);
        wasm_kosa = 1;
        rudisha 0;
    }
    wasm_local_jina[wasm_local_idadi] = jina;
    n32 idx = wasm_local_idadi;
    wasm_local_idadi = wasm_local_idadi + 1;
    rudisha idx;
}

// Je, enc hii ni n32/n32 (aina PEKEE inayoungwa mkono kwenye Awamu 1
// kwa vigezo/paramu/matokeo yenye thamani)? enc==0 ni "aina imeachwa"
// (chaguo-msingi n32, angalia ukubwa_kutoka_enc); enc==288 ni n32/n32
// ya wazi (encode_aina(familia=1,upana=32,mshale=0) -- herufi kubwa
// na ndogo hutoa familia SAWA, angalia changanua_aina_tokeni). Kila
// enc nyingine (kielekezi -- isiyo sawa; D32/d64 -- familia 3; n8/
// n16/n64 -- upana tofauti; muundo -- hasi; w0 -- 1280) iko NJE ya
// wigo kwa nafasi hii.
n32 wasm_ni_n32_enc(n32 enc) {
    kama (enc == 0) { rudisha 1; }
    kama (enc == 288) { rudisha 1; }
    rudisha 0;
}

// Awamu 2: n32 YA KAWAIDA (juu) AU kielekezi KIMOJA kwenda n32
// (encode_aina(familia=1,upana=32,mshale=1) == 289). Kielekezi
// mara-mbili (n32**, mshale=3 -> 291) na kielekezi kwenda aina
// nyingine yoyote HUBAKI nje ya wigo -- huanguka kwenye kesi ya
// mwisho (0) hapa chini kwa makusudi, bila ubaguzi wowote wa ziada.
n32 wasm_ni_n32_au_kielekezi_enc(n32 enc) {
    kama (wasm_ni_n32_enc(enc)) { rudisha 1; }
    kama (enc == 289) { rudisha 1; }
    rudisha 0;
}

// Je, enc hii ni w0/w0 (aina PEKEE inayoungwa mkono kwa aina ya
// matokeo isiyo na thamani)? encode_aina(familia=5,upana=0,mshale=0).
n32 wasm_ni_w0_enc(n32 enc) {
    rudisha (enc == 1280);
}

// Angalia enc (NA idadi ya safu, kama ipo) ya tangazo la kigezo
// (parameta au la ndani) -- ripoti KOSA la wazi (wasm_kosa=1) kama
// ni nje ya wigo, badala ya kukubali kimya na kuzalisha moduli isiyo
// sahihi (mfano n32* ingekuwa ikitibiwa kama n32 ya kawaida bila
// ukaguzi huu -- imepatikana kwa jaribio halisi la n2.swa:
// "n32* p = 0;" lilipita kimya). `safu_count` (kutoka ast_tiga[node]
// ya AST_TANGAZO, si var_node -- 0 kama si safu, pitisha 0 kwenye
// paramu ambazo haziwezi kuwa safu kisintaksia) NAYO inakaguliwa:
// bila hii, "n32 arr[3];" isiyoguswa kamwe ilikuwa ikisajiliwa
// kimya kama local MOJA ya i32 (ukubwa mbaya) badala ya kukataliwa
// -- imepatikana kwenye ukaguzi wa Kandemark, PR #260.
w0 wasm_kagua_enc_kigezo(n8* jina, n32 enc, n32 safu_count) {
    kama (wasm_ni_n32_au_kielekezi_enc(enc) == 0 || safu_count > 0) {
        andika_stderr("KOSA: wasm -- aina ya kigezo '%s' iko nje ya wigo wa Awamu 2 (n32 na n32* pekee vinaungwa mkono -- hakuna safu ya ndani ya ukubwa maalum/d64/d32/muundo/upana mwingine/kielekezi-cha-kielekezi)\n", jina);
        wasm_kosa = 1;
    }
}

// Pasi ya awali: tembea mnyororo wa taarifa ukikusanya kila
// AST_TANGAZO (11) unaoweza kufikiwa kupitia kama/wakati zilizopachikwa
// -- WASM inataka locals ZOTE zitangazwe KABLA ya agizo lolote la
// mwili wa kazi, tofauti na x86-64 (rbp-offset polepole).
w0 wasm_kusanya_locals(n32 node) {
    kama (node == -1) { rudisha; }
    n32 aina = ast_aina[node];
    kama (aina == AST_TANGAZO) {
        n32 var_node = ast_kushoto[node];
        wasm_kagua_enc_kigezo(ast_pool + ast_jina_off[var_node], ast_thamani[var_node], ast_tiga[node]);
        wasm_ongeza_local(ast_pool + ast_jina_off[var_node]);
    }
    kama (aina == AST_KAMA) {
        wasm_kusanya_locals(ast_kulia[node]);  // then
        n32 sivyo_node = ast_tiga[node];
        kama (sivyo_node != -1) { wasm_kusanya_locals(ast_kushoto[sivyo_node]); }
    }
    kama (aina == AST_WAKATI) {
        // ast_tiga[node] ni init ya kwa (inaweza kuwa AST_TANGAZO
        // yenyewe -- kigezo cha kwa(n32 i=0;...) ni local pia).
        n32 init = ast_tiga[node];
        kama (init != -1 && ast_aina[init] == AST_TANGAZO) {
            n32 var_node2 = ast_kushoto[init];
            wasm_kagua_enc_kigezo(ast_pool + ast_jina_off[var_node2], ast_thamani[var_node2], ast_tiga[init]);
            wasm_ongeza_local(ast_pool + ast_jina_off[var_node2]);
        }
        wasm_kusanya_locals(ast_kulia[node]);  // mwili
    }
    kama (aina == AST_BLOCK) {
        wasm_kusanya_locals(ast_kushoto[node]);
    }
    wasm_kusanya_locals(ast_nne[node]);
}

// -------------------------------------------------------
// Sehemu 4: Kina cha kiota cha WASM (block/loop/if zilizo wazi) na
// malengo ya vunja/endelea (angalia maelezo kamili karibu na
// uzalishaji_wasm_wakati)
// -------------------------------------------------------

n32 wasm_kina = 0;  // idadi ya block/loop/if zilizo WAZI sasa

n32 WASM_MAX_KIOTA_MZUNGUKO = 16;
n32 wasm_mzunguko_undani = 0;
n32 wasm_vunja_kina[16];     // kina KILIPOFUNGULIWA block ya "vunja"
n32 wasm_endelea_kina[16];   // kina KILIPOFUNGULIWA lengwa la "endelea"
n32 wasm_ina_hatua[16];      // 1 = kwa yenye hatua (block ya ziada ya endelea bado wazi)

// -------------------------------------------------------
// Sehemu 5: Usemi (matokeo huishia juu ya stack ya WASM -- i32 moja)
// -------------------------------------------------------

w0 wasm_usemi(n32 node, n32 kazi_node);
w0 wasm_taja_anwani(n32 node, n32 kazi_node);

// AST_TAJA (29): *ptr (faharasa==-1) au arr[idx] (faharasa!=-1).
// Hutoa ANWANI (offset ya i32 kwenye kumbukumbu) juu ya stack, BILA
// kupakia thamani -- inatumika na wasm_taja_thamani (kusoma) NA
// wasm_usemi/wasm_taarifa kwa AST_KUMBUKA (&arr[idx]/&*ptr) na
// uhifadhi (arr[idx] = x). Awamu 2: kipengele cha n32 pekee (baiti
// 4 kila kimoja) -- hesabu ya faharasa*4 ni ya wazi kila wakati,
// hakuna aina nyingine ya ukubwa inayoungwa mkono.
w0 wasm_taja_anwani(n32 node, n32 kazi_node) {
    kama (wasm_ni_n32_au_kielekezi_enc(ast_thamani[node]) == 0) {
        andika_stderr("KOSA: wasm -- kipengele/nyoosha hii iko nje ya wigo wa Awamu 2 (kipengele cha n32 pekee)\n");
        wasm_kosa = 1;
        rudisha;
    }
    n32 base = ast_kushoto[node];
    n32 idx = ast_kulia[node];
    wasm_usemi(base, kazi_node);
    kama (idx != -1) {
        wasm_usemi(idx, kazi_node);
        wasm_op_i32_const(4);
        wasm_op_i32_mul();
        wasm_op_i32_add();
    }
}

w0 wasm_taja_thamani(n32 node, n32 kazi_node) {
    wasm_taja_anwani(node, kazi_node);
    wasm_op_i32_load();
}

n32 wasm_ni_ulinganisho(n32 aina) {
    rudisha (aina == AST_SAWA || aina == AST_TOFAUTI_SI || aina == AST_CHINI ||
             aina == AST_JUU || aina == AST_CHINI_SAWA || aina == AST_JUU_SAWA);
}

w0 wasm_toa_ulinganisho(n32 node) {
    n32 aina = ast_aina[node];
    kama (aina == AST_SAWA) { wasm_op_i32_eq(); rudisha; }
    kama (aina == AST_TOFAUTI_SI) { wasm_op_i32_ne(); rudisha; }
    kama (aina == AST_CHINI) { wasm_op_i32_lt_s(); rudisha; }
    kama (aina == AST_JUU) { wasm_op_i32_gt_s(); rudisha; }
    kama (aina == AST_CHINI_SAWA) { wasm_op_i32_le_s(); rudisha; }
    kama (aina == AST_JUU_SAWA) { wasm_op_i32_ge_s(); rudisha; }
}

// Sharti la jumla (ulinganisho, &&, ||, au usemi mwingine wowote)
// -> i32 moja juu ya stack (0/1). && na || ni USEMI wa muundo (if
// wenye blocktype=i32), si mnyororo wa lebo kama x86-64 -- WASM
// if/else inaweza kubeba aina ya matokeo moja kwa moja.
w0 wasm_sharti(n32 node) {
    kama (node == -1) {
        andika_stderr("KOSA: wasm -- sharti tupu halikubaliki\n");
        wasm_kosa = 1;
        rudisha;
    }
    n32 aina = ast_aina[node];
    kama (aina == AST_NA) {  // A && B
        wasm_sharti(ast_kushoto[node]);
        wasm_op_if(WASM_I32); wasm_kina = wasm_kina + 1;
            wasm_sharti(ast_kulia[node]);
        wasm_op_else();
            wasm_op_i32_const(0);
        wasm_op_end(); wasm_kina = wasm_kina - 1;
        rudisha;
    }
    kama (aina == AST_AU) {  // A || B
        wasm_sharti(ast_kushoto[node]);
        wasm_op_if(WASM_I32); wasm_kina = wasm_kina + 1;
            wasm_op_i32_const(1);
        wasm_op_else();
            wasm_sharti(ast_kulia[node]);
        wasm_op_end(); wasm_kina = wasm_kina - 1;
        rudisha;
    }
    kama (aina == AST_SI) {  // !A
        wasm_sharti(ast_kushoto[node]);
        wasm_op_i32_eqz();
        rudisha;
    }
    kama (wasm_ni_ulinganisho(aina)) {
        wasm_usemi(ast_kushoto[node], -1);
        wasm_usemi(ast_kulia[node], -1);
        wasm_toa_ulinganisho(node);
        rudisha;
    }
    // Usemi mwingine wowote (kigezo, wito, n.k.) -- 0 = uwongo,
    // isiyo sifuri = kweli, sawa na C.
    wasm_usemi(node, -1);
}

w0 wasm_usemi(n32 node, n32 kazi_node) {
    kama (node == -1) { rudisha; }
    n32 aina = ast_aina[node];

    kama (aina == AST_NAMBARI) {
        kama (ast_kulia[node] == 1) {
            andika_stderr("KOSA: wasm -- namba halisi ya n64 kubwa haitumiki bado (Awamu 1: n32 pekee)\n");
            wasm_kosa = 1;
            rudisha;
        }
        wasm_op_i32_const(ast_thamani[node]);
        rudisha;
    }

    kama (aina == AST_KITAMBULISHO) {
        n8* jina = ast_pool + ast_jina_off[node];

        // Herufi halisi (mfuatano) -- inaanza na '"' (34), sawa na
        // uzalishaji_kitambulisho (uzalishaji.swa). Kigeu na mfuatano
        // ZOTE ni AST_KITAMBULISHO -- hakuna nodi tofauti ya AST.
        kama (jina[0] == 34) {
            n32 mem_off = wasm_ongeza_mfuatano(jina);
            wasm_op_i32_const(mem_off);
            rudisha;
        }

        n32 idx = wasm_tafuta_local(jina);
        kama (idx < 0) {
            andika_stderr("KOSA: wasm -- kigezo kisichojulikana au nje ya wigo: %s\n", jina);
            wasm_kosa = 1;
            rudisha;
        }
        wasm_op_local_get(idx);
        rudisha;
    }

    kama (aina == AST_TAJA) {
        wasm_taja_thamani(node, kazi_node);
        rudisha;
    }

    kama (aina == AST_KUMBUKA) {
        n32 operand = ast_kushoto[node];
        kama (operand == -1 || ast_aina[operand] != AST_TAJA) {
            andika_stderr("KOSA: wasm -- '&' inaungwa mkono TU kwa &arr[idx]/&*ptr kwenye Awamu 2 (si '&kigezo' cha ndani -- WASM 'locals' hazina anwani ya kumbukumbu, tofauti na rbp-offset za x86-64)\n");
            wasm_kosa = 1;
            rudisha;
        }
        wasm_taja_anwani(operand, kazi_node);
        rudisha;
    }

    kama (aina == AST_JUMLISHA || aina == AST_TOFAUTI || aina == AST_ZIDISHA ||
          aina == AST_GAWANYA || aina == AST_MODULO || aina == AST_BIT_AU ||
          aina == AST_BIT_NA || aina == AST_XOR) {
        wasm_usemi(ast_kushoto[node], kazi_node);
        wasm_usemi(ast_kulia[node], kazi_node);
        kama (aina == AST_JUMLISHA) { wasm_op_i32_add(); }
        kama (aina == AST_TOFAUTI) { wasm_op_i32_sub(); }
        kama (aina == AST_ZIDISHA) { wasm_op_i32_mul(); }
        kama (aina == AST_GAWANYA) { wasm_op_i32_div_s(); }
        kama (aina == AST_MODULO) { wasm_op_i32_rem_s(); }
        kama (aina == AST_BIT_AU) { wasm_op_i32_or(); }
        kama (aina == AST_BIT_NA) { wasm_op_i32_and(); }
        kama (aina == AST_XOR) { wasm_op_i32_xor(); }
        rudisha;
    }

    kama (wasm_ni_ulinganisho(aina) || aina == AST_NA || aina == AST_AU || aina == AST_SI) {
        wasm_sharti(node);
        rudisha;
    }

    kama (aina == AST_WITO) {
        n32 jina_node = ast_kushoto[node];
        n8* jina = ast_pool + ast_jina_off[jina_node];

        // tenga(n): kazi MAALUM ya Awamu 2 -- HAKUNA kazi halisi ya
        // Swa yenye jina hili kwenye WASM (kumbukumbu.swa halisi
        // hutumia mmap/wito_wa_mfumo, ambayo hayapo kwenye WASM
        // kabisa) -- inatambuliwa KWA JINA moja kwa moja, KABLA ya
        // kutafuta kwenye jedwali la kazi za mtumiaji (kioo cha jinsi
        // ukubwa() inavyotambuliwa kwenye uzalishaji.swa, mstari
        // ~3811). Uzalishaji: itwa helper iliyojengwa na
        // wasm_jenga_tenga_helper (bump allocator + memory.grow).
        kama (jina_linganisha(jina, "tenga")) {
            n32 hoja_t = ast_kulia[node];
            kama (hoja_t == -1) {
                andika_stderr("KOSA: wasm -- tenga() inahitaji hoja moja (ukubwa wa baiti)\n");
                wasm_kosa = 1;
                rudisha;
            }
            wasm_usemi(hoja_t, kazi_node);
            wasm_tenga_kutumika = 1;
            wasm_op_call_kazi(wasm_tenga_idx);
            rudisha;
        }

        // Awamu 3: daraja la DOM -- kazi 6 zilizoingizwa (Import
        // section), zinazotambuliwa KWA JINA (kioo HASA cha jinsi
        // "tenga" hapo juu inavyotambuliwa) -- hazina AST_KAZI wala
        // tamko lolote la Swa, uzalishaji_wasm pekee unazitambua.
        // Faharisi za uingizaji ni 0..5 HASA (imara, angalia
        // wasm_andika_sehemu_uingizaji) -- HAZIHITAJI wasm_import_idadi.
        kama (jina_linganisha(jina, "dom_unda")) {
            n32 h1 = ast_kulia[node];
            kama (h1 == -1) { andika_stderr("KOSA: wasm -- dom_unda() inahitaji hoja moja (tagPtr)\n"); wasm_kosa = 1; rudisha; }
            wasm_usemi(h1, kazi_node);
            wasm_op_call(0);
            rudisha;
        }
        kama (jina_linganisha(jina, "dom_weka_maandishi")) {
            n32 h1 = ast_kulia[node];
            kama (h1 == -1 || ast_tiga[h1] == -1) { andika_stderr("KOSA: wasm -- dom_weka_maandishi() inahitaji hoja mbili (id, textPtr)\n"); wasm_kosa = 1; rudisha; }
            wasm_usemi(h1, kazi_node);
            wasm_usemi(ast_tiga[h1], kazi_node);
            wasm_op_call(1);
            rudisha;
        }
        kama (jina_linganisha(jina, "dom_weka_sifa")) {
            n32 h1 = ast_kulia[node];
            kama (h1 == -1 || ast_tiga[h1] == -1 || ast_tiga[ast_tiga[h1]] == -1) { andika_stderr("KOSA: wasm -- dom_weka_sifa() inahitaji hoja tatu (id, namePtr, valPtr)\n"); wasm_kosa = 1; rudisha; }
            wasm_usemi(h1, kazi_node);
            wasm_usemi(ast_tiga[h1], kazi_node);
            wasm_usemi(ast_tiga[ast_tiga[h1]], kazi_node);
            wasm_op_call(2);
            rudisha;
        }
        kama (jina_linganisha(jina, "dom_ambatanisha")) {
            n32 h1 = ast_kulia[node];
            kama (h1 == -1 || ast_tiga[h1] == -1) { andika_stderr("KOSA: wasm -- dom_ambatanisha() inahitaji hoja mbili (mzaziId, mtotoId)\n"); wasm_kosa = 1; rudisha; }
            wasm_usemi(h1, kazi_node);
            wasm_usemi(ast_tiga[h1], kazi_node);
            wasm_op_call(3);
            rudisha;
        }
        kama (jina_linganisha(jina, "dom_mzizi")) {
            wasm_op_call(4);
            rudisha;
        }
        kama (jina_linganisha(jina, "console_andika")) {
            n32 h1 = ast_kulia[node];
            kama (h1 == -1) { andika_stderr("KOSA: wasm -- console_andika() inahitaji hoja moja (ptr)\n"); wasm_kosa = 1; rudisha; }
            wasm_usemi(h1, kazi_node);
            wasm_op_call(5);
            rudisha;
        }

        n32 kidx = wasm_tafuta_kazi(jina);
        kama (kidx < 0) {
            andika_stderr("KOSA: wasm -- kazi haitumiki (nje ya wigo, au haijulikani): %s\n", jina);
            wasm_kosa = 1;
            rudisha;
        }
        // Hoja: kushoto-kwenda-kulia (asili ya stack ya WASM -- TOFAUTI
        // na x86-64 iliyotathmini kulia-kwenda-kushoto kwa sababu za
        // rejesta zake. Salama kwa Awamu 1 -- hakuna madhara ya pembeni
        // yanayoonekana bila I/O/vigezo vya ulimwengu).
        n32 hoja = ast_kulia[node];
        wakati (hoja != -1) {
            wasm_usemi(hoja, kazi_node);
            hoja = ast_tiga[hoja];
        }
        wasm_op_call_kazi(kidx);
        rudisha;
    }

    andika_stderr("KOSA: wasm -- usemi huu haukubaliki kwenye Awamu 1 (aina ya AST=%d)\n", aina);
    wasm_kosa = 1;
}

// -------------------------------------------------------
// Sehemu 6: Taarifa (statements)
// -------------------------------------------------------

w0 wasm_taarifa(n32 node, n32 kazi_node);

w0 wasm_wakati(n32 node, n32 kazi_node) {
    n32 cond = ast_kushoto[node];
    n32 body = ast_kulia[node];
    n32 init = ast_tiga[node];
    n32 ina_hatua = (ast_thamani[node] == 0 - 777777);

    kama (init != -1) {
        kama (ast_aina[init] == AST_TANGAZO) {
            n32 var_node = ast_kushoto[init];
            n32 init_val = ast_kulia[init];
            n8* jina = ast_pool + ast_jina_off[var_node];
            n32 idx = wasm_tafuta_local(jina);
            kama (init_val != -1) {
                wasm_usemi(init_val, kazi_node);
            } sivyo {
                wasm_op_i32_const(0);
            }
            wasm_op_local_set(idx);
        } sivyo {
            wasm_taarifa(init, kazi_node);
        }
    }

    kama (wasm_mzunguko_undani >= WASM_MAX_KIOTA_MZUNGUKO) {
        andika_stderr("KOSA: wasm -- vitanzi vilivyopachikwa mno (kikomo %d)\n", WASM_MAX_KIOTA_MZUNGUKO);
        wasm_kosa = 1;
        rudisha;
    }
    n32 mzunguko_idx = wasm_mzunguko_undani;
    wasm_mzunguko_undani = wasm_mzunguko_undani + 1;
    wasm_ina_hatua[mzunguko_idx] = ina_hatua;

    // block $vunja { loop $juu { <sharti>; eqz; br_if (kwenda $vunja);
    //   [block $endelea { <mwili> }]  <-- pekee kama ina_hatua
    //   <mwili>                       <-- kama HAINA hatua
    //   br (kwenda $juu) } }
    wasm_op_block(WASM_VOID_BT); wasm_kina = wasm_kina + 1;
    wasm_vunja_kina[mzunguko_idx] = wasm_kina;

    wasm_op_loop(WASM_VOID_BT); wasm_kina = wasm_kina + 1;
    n32 juu_kina = wasm_kina;
    kama (ina_hatua == 0) { wasm_endelea_kina[mzunguko_idx] = juu_kina; }

    kama (cond != -1) {
        wasm_sharti(cond);
        wasm_op_i32_eqz();
        wasm_op_br_if(wasm_kina - wasm_vunja_kina[mzunguko_idx]);
    }

    kama (ina_hatua) {
        wasm_op_block(WASM_VOID_BT); wasm_kina = wasm_kina + 1;
        wasm_endelea_kina[mzunguko_idx] = wasm_kina;
    }

    wasm_taarifa(body, kazi_node);

    kama (ina_hatua && wasm_ina_hatua[mzunguko_idx] != 0 - 999999) {
        // AST_BLOCK{-777777} (hatua) ndani ya mwili tayari ilifunga
        // block ya "endelea" yenyewe (angalia wasm_taarifa) -- hapa
        // hakuna kufanya tena. Alama -999999 = imeshafungwa.
    }

    wasm_op_br(wasm_kina - juu_kina);
    wasm_op_end(); wasm_kina = wasm_kina - 1;  // loop
    wasm_op_end(); wasm_kina = wasm_kina - 1;  // block $vunja

    wasm_mzunguko_undani = wasm_mzunguko_undani - 1;
}

w0 wasm_kama(n32 node, n32 kazi_node) {
    n32 cond = ast_kushoto[node];
    n32 then_body = ast_kulia[node];
    n32 sivyo_node = ast_tiga[node];
    n32 else_body = -1;
    kama (sivyo_node != -1) { else_body = ast_kushoto[sivyo_node]; }

    wasm_sharti(cond);
    kama (else_body != -1) {
        wasm_op_if(WASM_VOID_BT); wasm_kina = wasm_kina + 1;
        wasm_taarifa(then_body, kazi_node);
        wasm_op_else();
        wasm_taarifa(else_body, kazi_node);
        wasm_op_end(); wasm_kina = wasm_kina - 1;
    } sivyo {
        wasm_op_if(WASM_VOID_BT); wasm_kina = wasm_kina + 1;
        wasm_taarifa(then_body, kazi_node);
        wasm_op_end(); wasm_kina = wasm_kina - 1;
    }
}

w0 wasm_taarifa(n32 node, n32 kazi_node) {
    kama (node == -1) { rudisha; }
    n32 aina = ast_aina[node];

    kama (aina == AST_RUDISHA) {
        n32 expr = ast_kushoto[node];
        kama (expr != -1) { wasm_usemi(expr, kazi_node); }
        wasm_op_return();
        rudisha;  // hakuna ndugu -- msururu unaisha
    }

    kama (aina == AST_VUNJA) {
        kama (wasm_mzunguko_undani > 0) {
            n32 idx = wasm_mzunguko_undani - 1;
            wasm_op_br(wasm_kina - wasm_vunja_kina[idx]);
        }
        rudisha;
    }

    kama (aina == AST_ENDELEA) {
        kama (wasm_mzunguko_undani > 0) {
            n32 idx = wasm_mzunguko_undani - 1;
            wasm_op_br(wasm_kina - wasm_endelea_kina[idx]);
        }
        rudisha;
    }

    kama (aina == AST_TANGAZO) {
        n32 var_node = ast_kushoto[node];
        n32 init_node = ast_kulia[node];
        n8* jina = ast_pool + ast_jina_off[var_node];
        n32 idx = wasm_tafuta_local(jina);
        kama (init_node != -1) {
            wasm_usemi(init_node, kazi_node);
        } sivyo {
            wasm_op_i32_const(0);
        }
        wasm_op_local_set(idx);
    } sivyo { kama (aina == AST_ASIMILIA) {
            n32 lhs = ast_kushoto[node];
            n32 rhs = ast_kulia[node];

            // arr[idx] = x / *ptr = x -- anwani KWANZA (chini ya
            // stack), kisha thamani (juu), kisha i32.store (inayotaka
            // [anwani, thamani] kwa mpangilio huu HASA).
            kama (ast_aina[lhs] == AST_TAJA) {
                wasm_taja_anwani(lhs, kazi_node);
                wasm_usemi(rhs, kazi_node);
                wasm_op_i32_store();
                // MUHIMU: endelea kwenye ndugu inayofuata (ast_nne) --
                // TOFAUTI na AST_RUDISHA (ambayo KWELI inamaliza
                // msururu), ugawaji ni taarifa ya KAWAIDA, mfululizo
                // unaendelea baada yake. `rudisha;` peke yake HAPA (bila
                // wito huu) ilikuwa ikifuta KIMYA taarifa zote zilizobaki
                // kwenye kitanzi (mfano `i = i + 1;` baada ya
                // `arr[i] = x;`) -- ilisababisha kitanzi kisichokwisha
                // cha kweli (i haiongezeki kamwe). Imepatikana kwa
                // jaribio halisi (jaribio_safu_n32.swa: node ilining'inia
                // milele wakati wa kuendesha, si kosa la kukusanya).
                wasm_taarifa(ast_nne[node], kazi_node);
                rudisha;
            }

            kama (ast_aina[lhs] != AST_KITAMBULISHO) {
                andika_stderr("KOSA: wasm -- ugawaji huu haukubaliki kwenye Awamu 2 (muundo/aina nyingine)\n");
                wasm_kosa = 1;
                rudisha;
            }
            n8* jina2 = ast_pool + ast_jina_off[lhs];
            n32 idx2 = wasm_tafuta_local(jina2);
            kama (idx2 < 0) {
                andika_stderr("KOSA: wasm -- kigezo kisichojulikana: %s\n", jina2);
                wasm_kosa = 1;
                rudisha;
            }
            wasm_usemi(rhs, kazi_node);
            wasm_op_local_set(idx2);
        } sivyo { kama (aina == AST_WITO) {
                n32 jina_node_w = ast_kushoto[node];
                n8* jina_w = ast_pool + ast_jina_off[jina_node_w];

                // tenga(n); kama taarifa peke yake -- inarudisha
                // thamani KILA WAKATI (si kama kazi za kawaida
                // ambazo zinaweza kuwa w0) -- LAZIMA itupwe daima,
                // vinginevyo WASM inakataa moduli (thamani iliyobaki
                // juu ya stack mwishoni mwa block). MUHIMU: `sivyo`
                // hapa (SI `rudisha;` peke yake baada ya block ya
                // kwanza) -- vinginevyo njia ya jumla ya AST_WITO
                // ingeendelea kutekelezwa BAADAYE kimya, ikizalisha
                // wasm_usemi mara MBILI (jaribio halisi lilifichua
                // hitilafu ya "unreachable" wakati wa kukimbia kwa
                // sababu ya bug hii hii ikiwa pamoja na tatizo la
                // sibling -- angalia jaribio_tenga_kama_taarifa.swa).
                // Awamu 3: dom_unda/dom_mzizi NAZO zinarudisha thamani
                // (id) KILA WAKATI, kama tenga() -- kioo HASA cha
                // sababu ile ile (uingizaji hauko kwenye wasm_kazi_
                // node[], hivyo wasm_tafuta_kazi ingerudisha -1 na
                // kuruka drop KIMAKOSA, ikiacha thamani juu ya rafu).
                kama (jina_linganisha(jina_w, "tenga") || jina_linganisha(jina_w, "dom_unda") || jina_linganisha(jina_w, "dom_mzizi")) {
                    wasm_usemi(node, kazi_node);
                    wasm_op_drop();
                } sivyo {
                    n32 kidx_w = wasm_tafuta_kazi(jina_w);
                    wasm_usemi(node, kazi_node);
                    // Tupa matokeo ya wito kama taarifa -- LAKINI PEKEE
                    // kama kazi inarudisha thamani (si w0), la sivyo
                    // hakuna kilicho kwenye rafu ya kutupa.
                    kama (kidx_w >= 0 && wasm_kazi_ni_w0(kidx_w) == 0) {
                        wasm_op_drop();
                    }
                }
            } sivyo { kama (aina == AST_KAMA) {
                    wasm_kama(node, kazi_node);
                } sivyo { kama (aina == AST_WAKATI) {
                        wasm_wakati(node, kazi_node);
                    } sivyo { kama (aina == AST_BLOCK) {
                            kama (ast_kulia[node] == 0 - 777777) {
                                // Alama ya "hatua" ya kwa: funga block ya
                                // "endelea" HAPA (hatua inayofuata ni MSIMBO
                                // WA HATUA, unaopaswa kuwa NJE ya block hiyo
                                // ili endelea iishie hapa na kuiendesha) --
                                // angalia maelezo kamili juu ya wasm_wakati.
                                kama (wasm_mzunguko_undani > 0) {
                                    n32 idx3 = wasm_mzunguko_undani - 1;
                                    kama (wasm_ina_hatua[idx3]) {
                                        wasm_op_end(); wasm_kina = wasm_kina - 1;
                                        wasm_ina_hatua[idx3] = 0 - 999999;  // imeshafungwa
                                    }
                                }
                            }
                            wasm_taarifa(ast_kushoto[node], kazi_node);
                        } sivyo {
                            andika_stderr("KOSA: wasm -- taarifa hii haikubaliki kwenye Awamu 1 (aina ya AST=%d)\n", aina);
                            wasm_kosa = 1;
                        } } } } } }

    wasm_taarifa(ast_nne[node], kazi_node);
}

// -------------------------------------------------------
// Sehemu 7: Kazi moja -- pasi ya locals + mwili -> entry ya Type
// (kwenye wasm_type_buf, YA PAMOJA na kazi zote) na entry ya Code
// (kwenye wasm_sec_buf, YA PAMOJA na kazi zote) -- HAZICHANGANYIKI
// (angalia maelezo ya Sehemu 0).
// -------------------------------------------------------

w0 wasm_jenga_kazi(n32 kazi_node) {
    // Weka upya jedwali la locals kwa kazi hii
    wasm_local_idadi = 0;

    // Paramu -- faharisi 0..P-1
    n32 nparam = 0;
    n32 pn = ast_kulia[kazi_node];
    wakati (pn != -1) {
        wasm_kagua_enc_kigezo(ast_pool + ast_jina_off[pn], ast_thamani[pn], 0);
        wasm_ongeza_local(ast_pool + ast_jina_off[pn]);
        nparam = nparam + 1;
        pn = ast_kulia[pn];
    }
    wasm_local_paramu_idadi = nparam;

    // Vigezo vya ndani (ikiwemo vilivyopachikwa) -- faharisi P..P+L-1
    n32 body = ast_tiga[kazi_node];
    wasm_kusanya_locals(body);
    n32 nlocals_ndani = wasm_local_idadi - nparam;

    // ---- Type entry: (nparam x i32) -> i32 (au tupu kwa w0/w0) ----
    // -- imeongezwa kwenye wasm_type_buf, INAYOENDELEA kati ya kazi
    // (haisafishwi hapa) -- entries za functype ni self-delimiting
    // kwa hesabu zao wenyewe, hazihitaji urefu wa mtu binafsi.
    n32 ret_enc = ast_thamani[kazi_node];
    n32 ni_w0 = wasm_ni_w0_enc(ret_enc);
    kama (ni_w0 == 0 && wasm_ni_n32_enc(ret_enc) == 0) {
        andika_stderr("KOSA: wasm -- aina ya matokeo iko nje ya wigo wa Awamu 1 (n32 au w0 pekee zinaungwa mkono)\n");
        wasm_kosa = 1;
    }
    wasm_bafu_sasa = 3;
    wasm_baiti(96);  // 0x60 -- func type tag
    wasm_uleb128(nparam);
    n32 pi = 0;
    wakati (pi < nparam) { wasm_baiti(WASM_I32); pi = pi + 1; }
    kama (ni_w0) {
        wasm_uleb128(0);
    } sivyo {
        wasm_uleb128(1);
        wasm_baiti(WASM_I32);
    }

    // ---- Code entry: locals + mwili -- jengwa kwenye wasm_fn_buf
    // (mwili wa kazi HII PEKEE), kisha kunakiliwa (na urefu wake wa
    // LEB128 mbele) kuingia wasm_sec_buf, INAYOENDELEA kati ya kazi.
    wasm_bafu_sasa = 1;
    wasm_fn_wapi = 0;
    kama (nlocals_ndani > 0) {
        wasm_uleb128(1);  // kundi 1 la locals (aina moja: i32)
        wasm_uleb128(nlocals_ndani);
        wasm_baiti(WASM_I32);
    } sivyo {
        wasm_uleb128(0);
    }

    wasm_kina = 0;
    wasm_mzunguko_undani = 0;
    wasm_taarifa(body, kazi_node);
    // "unreachable" kabla ya mwisho wa kazi -- WASM huthibitisha
    // aina za rafu KIMUUNDO (bila kufuatilia kwamba matawi YOTE ya
    // kama/sivyo tayari yamerudisha), hivyo "fallthru" ya kazi
    // inayorudisha i32 INAHITAJI thamani kwenye rafu HATA kama kwa
    // MANTIKI njia hiyo haiwezekani kufikiwa (mfano: kama/sivyo zote
    // mbili zina rudisha wazi) -- imepatikana kwa jaribio halisi
    // (t3.swa: "expected 1 elements on the stack for fallthru").
    // "unreachable" ina aina ya polymorphic (inakidhi kigezo chochote),
    // hivyo inatatua tatizo la uthibitishaji bila kuathiri utekelezaji
    // halisi (chanzo sahihi haifiki hapa kamwe). Kazi za w0 hazihitaji
    // hii (fallthru yao haihitaji thamani).
    kama (ni_w0 == 0) { wasm_op_unreachable(); }
    wasm_op_end();

    // Nakili mwili wa kazi (wasm_fn_buf) kuingia sec_buf ikiwa na
    // urefu wake wa LEB128 mbele -- hii NDIYO "backpatch" ya WASM.
    wasm_bafu_sasa = 2;
    wasm_hamisha_kutoka_fn();
}

// -------------------------------------------------------
// Sehemu 8: Moduli nzima
// -------------------------------------------------------

w0 wasm_kichwa() {
    wasm_baiti(0); wasm_baiti(97); wasm_baiti(115); wasm_baiti(109);  // \0asm
    wasm_baiti(1); wasm_baiti(0); wasm_baiti(0); wasm_baiti(0);        // toleo 1
}

// Baiti ngapi ambazo wasm_uleb128(v) ingeandika, BILA kuziandika --
// inahitajika kukokotoa ukubwa wa sehemu KABLA ya kuuandika (sawa na
// tatizo lile lile la "urefu haujulikani mpaka mwisho").
n32 wasm_uleb128_ukubwa(n32 v) {
    n32 n = 1;
    v = (v >> 7) & 33554431;
    wakati (v != 0) {
        n = n + 1;
        v = (v >> 7) & 33554431;
    }
    rudisha n;
}

// Baiti ngapi ambazo wasm_sleb128(v) ingeandika, BILA kuziandika --
// kioo cha wasm_uleb128_ukubwa lakini kwa hesabu ya ishara (LEB128
// yenye ishara inaisha tofauti na isiyo na ishara -- angalia
// wasm_sleb128 kwa sharti kamili).
n32 wasm_sleb128_ukubwa(n32 v) {
    n32 n = 0;
    n32 zaidi = 1;
    wakati (zaidi) {
        n32 b7 = v & 127;
        v = v >> 7;
        n32 ishara_bit = b7 & 64;
        n = n + 1;
        kama ((v == 0 && ishara_bit == 0) || (v == 0 - 1 && ishara_bit != 0)) {
            zaidi = 0;
        }
    }
    rudisha n;
}

// Memory section (id=5, Awamu 2): hesabu(=1) + limits (flag=0x00,
// min PEKEE -- hakuna max iliyotangazwa, memory.grow inaruhusiwa
// hadi kikomo cha injini). min_pages inakokotolewa kutoka data +
// heap ya awali (angalia uzalishaji_wasm_kuu).
w0 wasm_andika_memory_sehemu(n32 min_pages) {
    wasm_bafu_sasa = 0;
    wasm_baiti(5);
    n32 content = wasm_uleb128_ukubwa(1) + 1 + wasm_uleb128_ukubwa(min_pages);
    wasm_uleb128(content);
    wasm_uleb128(1);
    wasm_baiti(0);
    wasm_uleb128(min_pages);
}

// Global section (id=6, Awamu 2): global MOJA -- i32 inayobadilika
// (heap pointer, WASM_HEAP_GLOBAL_IDX=0), thamani ya awali =
// heap_init (baada ya data section -- angalia uzalishaji_wasm_kuu).
w0 wasm_andika_global_sehemu(n32 heap_init) {
    wasm_bafu_sasa = 0;
    wasm_baiti(6);
    n32 init_sz = 1 + wasm_sleb128_ukubwa(heap_init) + 1;
    n32 content = wasm_uleb128_ukubwa(1) + 1 + 1 + init_sz;
    wasm_uleb128(content);
    wasm_uleb128(1);
    wasm_baiti(WASM_I32);
    wasm_baiti(1);  // mutable = kweli
    wasm_baiti(65); wasm_sleb128(heap_init);  // i32.const heap_init
    wasm_op_end();
}

// Data section (id=11, Awamu 2): segment MOJA amilifu (memidx=0,
// offset=WASM_DATA_MSINGI) ikiwa na mfuatano YOTE yaliyokusanywa
// yamewekwa pamoja (wasm_data_buf, urefu=wasm_data_wapi). Ikiwa
// hakuna mfuatano lolote lililotumika, sehemu nzima inarukwa
// (moduli bila mfuatano haihitaji Data section kabisa).
w0 wasm_andika_data_sehemu() {
    kama (wasm_data_wapi == 0) { rudisha; }
    wasm_bafu_sasa = 0;
    wasm_baiti(11);
    n32 offset_expr_sz = 1 + wasm_sleb128_ukubwa(WASM_DATA_MSINGI) + 1;
    n32 seg_sz = wasm_uleb128_ukubwa(0) + offset_expr_sz + wasm_uleb128_ukubwa(wasm_data_wapi) + wasm_data_wapi;
    n32 content = wasm_uleb128_ukubwa(1) + seg_sz;
    wasm_uleb128(content);
    wasm_uleb128(1);
    wasm_uleb128(0);  // memidx = 0 (segment amilifu)
    wasm_baiti(65); wasm_sleb128(WASM_DATA_MSINGI); wasm_op_end();  // offset expr
    wasm_uleb128(wasm_data_wapi);
    n32 i = 0;
    wakati (i < wasm_data_wapi) { wasm_baiti(wasm_data_buf[i]); i = i + 1; }
}

// tenga(n) helper -- kazi iliyojengwa KWA MKONO (si kutoka AST ya
// mtumiaji), imeongezwa kwenye jedwali la kazi KAMA KAZI YA MWISHO
// (faharisi = wasm_tenga_idx, iliyowekwa baada ya Pitio la 1 --
// angalia uzalishaji_wasm_kuu) PEKEE ikiwa kweli imetumika
// (wasm_tenga_kutumika). Bump allocator rahisi: hoja=ukubwa
// uliopangwa juu hadi baiti 4; kama heap mpya inavuka ukurasa wa
// SASA (memory.size()*65536), memory.grow() kurasa za ziada
// zinazohitajika KABLA ya kuendelea -- kama grow inashindwa
// (inarudisha -1), "unreachable" (trap ya wakati wa kukimbia, sawa
// na jinsi mradi mzima unavyoshughulikia kushindwa kwa mmap kwenye
// x86-64 -- angalia mipaka.md #190).
w0 wasm_jenga_tenga_helper() {
    wasm_bafu_sasa = 3;
    wasm_baiti(96);
    wasm_uleb128(1); wasm_baiti(WASM_I32);
    wasm_uleb128(1); wasm_baiti(WASM_I32);

    wasm_bafu_sasa = 1;
    wasm_fn_wapi = 0;
    wasm_uleb128(1);
    wasm_uleb128(3);
    wasm_baiti(WASM_I32);

    // local1 = heap wa zamani (matokeo)
    wasm_op_global_get(WASM_HEAP_GLOBAL_IDX);
    wasm_op_local_set(1);

    // local2 = (param0 + 3) & ~3  (kupanga juu hadi baiti 4)
    wasm_op_local_get(0);
    wasm_op_i32_const(3);
    wasm_op_i32_add();
    wasm_op_i32_const(0 - 4);
    wasm_op_i32_and();
    wasm_op_local_set(2);

    // local3 = heap mpya = local1 + local2
    wasm_op_local_get(1);
    wasm_op_local_get(2);
    wasm_op_i32_add();
    wasm_op_local_set(3);

    // kama local3 > memory.size()*65536: kuza kumbukumbu
    wasm_op_local_get(3);
    wasm_op_memory_size();
    wasm_op_i32_const(65536);
    wasm_op_i32_mul();
    wasm_op_i32_gt_s();
    wasm_op_if(WASM_VOID_BT);
        wasm_op_local_get(3);
        wasm_op_memory_size();
        wasm_op_i32_const(65536);
        wasm_op_i32_mul();
        wasm_op_i32_sub();
        wasm_op_i32_const(65535);
        wasm_op_i32_add();
        wasm_op_i32_const(65536);
        wasm_op_i32_div_s();
        wasm_op_memory_grow();
        wasm_op_i32_const(0 - 1);
        wasm_op_i32_eq();
        wasm_op_if(WASM_VOID_BT);
            wasm_op_unreachable();
        wasm_op_end();
    wasm_op_end();

    // heap_ptr = local3; matokeo = local1
    wasm_op_local_get(3);
    wasm_op_global_set(WASM_HEAP_GLOBAL_IDX);
    wasm_op_local_get(1);
    wasm_op_end();

    wasm_bafu_sasa = 2;
    wasm_hamisha_kutoka_fn();
}

// Andika sehemu kamili (id + urefu wa sehemu + hesabu + maudhui ya
// chanzo) kuingia MODULI YA MWISHO. Hutumika kwa Type (id=1, chanzo=
// wasm_type_buf) na Code (id=10, chanzo=wasm_sec_buf) -- zote mbili
// zina umbo lile lile: hesabu(uleb128) + entries.
w0 wasm_andika_sehemu_kutoka(n32 id, n32 idadi, n8* chanzo, n32 urefu_chanzo) {
    wasm_bafu_sasa = 0;
    wasm_baiti(id);
    n32 jumla = wasm_uleb128_ukubwa(idadi) + urefu_chanzo;
    wasm_uleb128(jumla);
    wasm_uleb128(idadi);
    n32 i = 0;
    wakati (i < urefu_chanzo) { wasm_baiti(chanzo[i]); i = i + 1; }
}

// Function section (id=3): hesabu + [faharisi_ya_aina]* -- faharisi
// ya aina == faharisi ya kazi (miongoni mwa za NDANI, 0..N-1) + 6
// (Awamu 3: aina 0..5 ni za uingizaji, zilizoandikwa KWANZA kwenye
// wasm_type_buf na wasm_andika_aina_uingizaji -- angalia
// uzalishaji_wasm_kuu). Hesabu ya kazi (wasm_kazi_idadi) YENYEWE
// haibadiliki -- Function section inaorodhesha kazi za NDANI PEKEE,
// uingizaji hauorodheshwi hapa (angalia Import section badala yake).
w0 wasm_andika_function_sehemu() {
    n32 idx_bytes = 0;
    n32 j = 0;
    wakati (j < wasm_kazi_idadi) { idx_bytes = idx_bytes + wasm_uleb128_ukubwa(j + wasm_import_idadi); j = j + 1; }
    wasm_bafu_sasa = 0;
    wasm_baiti(3);
    n32 jumla = wasm_uleb128_ukubwa(wasm_kazi_idadi) + idx_bytes;
    wasm_uleb128(jumla);
    wasm_uleb128(wasm_kazi_idadi);
    n32 i = 0;
    wakati (i < wasm_kazi_idadi) { wasm_uleb128(i + wasm_import_idadi); i = i + 1; }
}

// Aina (Type entries) za kazi 6 zilizoingizwa (Awamu 3) -- huandikwa
// KWANZA kwenye wasm_type_buf (kabla ya Pitio la 2 la kazi za
// mtumiaji, angalia uzalishaji_wasm_kuu), ili ziwe faharisi 0..5
// HASA na kazi za mtumiaji zianze kwenye faharisi 6+.
w0 wasm_andika_aina_uingizaji() {
    wasm_bafu_sasa = 3;
    // dom_unda(i32) -> i32
    wasm_baiti(96); wasm_uleb128(1); wasm_baiti(WASM_I32); wasm_uleb128(1); wasm_baiti(WASM_I32);
    // dom_weka_maandishi(i32, i32) -> ()
    wasm_baiti(96); wasm_uleb128(2); wasm_baiti(WASM_I32); wasm_baiti(WASM_I32); wasm_uleb128(0);
    // dom_weka_sifa(i32, i32, i32) -> ()
    wasm_baiti(96); wasm_uleb128(3); wasm_baiti(WASM_I32); wasm_baiti(WASM_I32); wasm_baiti(WASM_I32); wasm_uleb128(0);
    // dom_ambatanisha(i32, i32) -> ()
    wasm_baiti(96); wasm_uleb128(2); wasm_baiti(WASM_I32); wasm_baiti(WASM_I32); wasm_uleb128(0);
    // dom_mzizi() -> i32
    wasm_baiti(96); wasm_uleb128(0); wasm_uleb128(1); wasm_baiti(WASM_I32);
    // console_andika(i32) -> ()
    wasm_baiti(96); wasm_uleb128(1); wasm_baiti(WASM_I32); wasm_uleb128(0);
}

// Ukubwa (baiti, bila kuandika) wa entry moja ya Import section:
// uleb128(len("env"))+"env" + uleb128(len(jina))+jina + kind(1 baiti)
// + uleb128(faharisi_ya_aina).
n32 wasm_uingizaji_entry_ukubwa(n8* jina, n32 type_idx) {
    n32 jl = jina_urefu(jina);
    rudisha wasm_uleb128_ukubwa(3) + 3 + wasm_uleb128_ukubwa(jl) + jl + 1 + wasm_uleb128_ukubwa(type_idx);
}

w0 wasm_andika_uingizaji_entry(n8* jina, n32 type_idx) {
    n32 jl = jina_urefu(jina);
    wasm_uleb128(3); wasm_baiti(101); wasm_baiti(110); wasm_baiti(118);  // "env"
    wasm_uleb128(jl);
    n32 i = 0;
    wakati (i < jl) { wasm_baiti(jina[i]); i = i + 1; }
    wasm_baiti(0);  // kind = func
    wasm_uleb128(type_idx);
}

// Import section (id=2, Awamu 3): kazi 6 za JS (daraja la DOM +
// console_andika kwa utatuzi), zote (module="env", kind=func).
// LAZIMA iandikwe KATI ya Type(1) na Function(3) kwenye mkutano wa
// moduli (angalia uzalishaji_wasm_kuu).
w0 wasm_andika_sehemu_uingizaji() {
    n8* n0 = "dom_unda";
    n8* n1 = "dom_weka_maandishi";
    n8* n2 = "dom_weka_sifa";
    n8* n3 = "dom_ambatanisha";
    n8* n4 = "dom_mzizi";
    n8* n5 = "console_andika";
    n32 content = wasm_uleb128_ukubwa(6)
        + wasm_uingizaji_entry_ukubwa(n0, 0) + wasm_uingizaji_entry_ukubwa(n1, 1)
        + wasm_uingizaji_entry_ukubwa(n2, 2) + wasm_uingizaji_entry_ukubwa(n3, 3)
        + wasm_uingizaji_entry_ukubwa(n4, 4) + wasm_uingizaji_entry_ukubwa(n5, 5);
    wasm_bafu_sasa = 0;
    wasm_baiti(2);
    wasm_uleb128(content);
    wasm_uleb128(6);
    wasm_andika_uingizaji_entry(n0, 0);
    wasm_andika_uingizaji_entry(n1, 1);
    wasm_andika_uingizaji_entry(n2, 2);
    wasm_andika_uingizaji_entry(n3, 3);
    wasm_andika_uingizaji_entry(n4, 4);
    wasm_andika_uingizaji_entry(n5, 5);
}

// Export section (id=7): "main" (func) NA "memory" (Awamu 2 -- ili
// majaribio yaweze kusoma instance.exports.memory.buffer moja kwa
// moja kutoka Node).
w0 wasm_andika_export_sehemu(n32 main_idx) {
    n32 idx_sz = wasm_uleb128_ukubwa(main_idx);
    n32 jina_sz1 = wasm_uleb128_ukubwa(4) + 4;  // "main"
    n32 entry1 = jina_sz1 + 1 + idx_sz;
    n32 jina_sz2 = wasm_uleb128_ukubwa(6) + 6;  // "memory"
    n32 entry2 = jina_sz2 + 1 + wasm_uleb128_ukubwa(0);
    n32 content_sz = wasm_uleb128_ukubwa(2) + entry1 + entry2;
    wasm_bafu_sasa = 0;
    wasm_baiti(7);
    wasm_uleb128(content_sz);
    wasm_uleb128(2);  // hesabu ya export: 2
    wasm_uleb128(4);
    wasm_baiti(109); wasm_baiti(97); wasm_baiti(105); wasm_baiti(110);  // "main"
    wasm_baiti(0);  // aina = func
    wasm_uleb128(main_idx);
    wasm_uleb128(6);
    wasm_baiti(109); wasm_baiti(101); wasm_baiti(109); wasm_baiti(111); wasm_baiti(114); wasm_baiti(121);  // "memory"
    wasm_baiti(2);  // aina = memtype
    wasm_uleb128(0);
}

n32 uzalishaji_wasm_kuu(n32 mzizi) {
    wasm_kosa = 0;
    wasm_bafu_wapi = 0;
    wasm_fn_wapi = 0;
    wasm_type_wapi = 0;
    wasm_sec_wapi = 0;
    wasm_kazi_idadi = 0;
    wasm_kazi_jina_pool_wapi = 1;
    wasm_bafu_sasa = 0;
    wasm_data_wapi = 0;
    wasm_str_idadi = 0;
    wasm_tenga_kutumika = 0;
    wasm_import_idadi = 6;

    // Awamu 3: aina za kazi 6 zilizoingizwa zaandikwa KWANZA kwenye
    // wasm_type_buf (faharisi 0..5) -- KABLA ya Pitio la 1/2 la kazi
    // za mtumiaji (ambazo zitaanza kwenye faharisi ya aina 6+).
    wasm_andika_aina_uingizaji();

    // Pitio la 1: sajili kazi ZOTE za ngazi ya juu (kwa faharisi za
    // `call`) KABLA ya kuzalisha mwili wowote -- wito wa mbele
    // unahitaji hili.
    n8 jina_pool_ndani[16384];
    wasm_kazi_jina_pool = jina_pool_ndani;
    n32 gn = ast_kushoto[mzizi];
    wakati (gn != -1) {
        kama (ast_aina[gn] == AST_KAZI) {
            kama (wasm_kazi_idadi >= WASM_MAX_KAZI) {
                andika_stderr("KOSA: wasm -- kazi nyingi mno (kikomo %d)\n", WASM_MAX_KAZI);
                rudisha 1;
            }
            n32 jina_node = ast_kushoto[gn];
            n8* jina = ast_pool + ast_jina_off[jina_node];
            n32 urefu = jina_urefu(jina);
            n32 off = wasm_kazi_jina_pool_wapi;
            n32 ci = 0;
            wakati (ci < urefu) {
                wasm_kazi_jina_pool[off + ci] = jina[ci];
                ci = ci + 1;
            }
            wasm_kazi_jina_pool[off + urefu] = 0;
            wasm_kazi_jina_pool_wapi = off + urefu + 1;
            wasm_kazi_jina_off[wasm_kazi_idadi] = off;
            wasm_kazi_node[wasm_kazi_idadi] = gn;
            wasm_kazi_idadi = wasm_kazi_idadi + 1;
        } sivyo { kama (ast_aina[gn] != AST_MUUNDO) {
                andika_stderr("KOSA: wasm -- ujenzi wa ngazi ya juu haukubaliki kwenye Awamu 1 (aina ya AST=%d -- vigezo vya ulimwengu havitumiki)\n", ast_aina[gn]);
                rudisha 1;
            } }
        gn = ast_nne[gn];
    }

    n32 main_idx = wasm_tafuta_kazi("main");
    kama (main_idx < 0) {
        andika_stderr("KOSA: wasm -- hakuna kazi 'main'\n");
        rudisha 1;
    }
    // Awamu 3: export inahitaji faharisi ya function-index-space
    // KAMILI (baada ya kazi 6 za uingizaji), si faharisi ya ndani tu.
    main_idx = main_idx + wasm_import_idadi;

    // Faharisi ya helper ya tenga() imewekwa SASA (mara tu baada ya
    // Pitio la 1, idadi ya kazi za mtumiaji ikiwa imekamilika kikamilifu)
    // -- itatumika kama faharisi ya kudumu kwenye kila `call` ya
    // tenga() ndani ya Pitio la 2, kabla helper yenyewe haijajengwa.
    wasm_tenga_idx = wasm_kazi_idadi;

    // Pitio la 2: jenga kila kazi -- Type entry huingia wasm_type_buf
    // na Code entry huingia wasm_sec_buf, ZOTE MBILI zikiendelea
    // (hazisafishwi) kati ya kazi, hivyo faharisi ya mpangilio wa
    // kazi (i) ni faharisi ya aina (Type index) NA faharisi ya kazi
    // (Function/Code index) KWA WAKATI MMOJA -- angalia
    // wasm_andika_function_sehemu (0..N-1 moja kwa moja).
    n32 i = 0;
    wakati (i < wasm_kazi_idadi) {
        wasm_jenga_kazi(wasm_kazi_node[i]);
        i = i + 1;
    }

    kama (wasm_kosa) { rudisha 1; }

    // Awamu 2: helper ya tenga() -- kazi ya MWISHO (faharisi
    // wasm_tenga_idx == wasm_kazi_idadi ya sasa), imeongezwa PEKEE
    // ikiwa kweli imetumika popote kwenye Pitio la 2 hapo juu.
    kama (wasm_tenga_kutumika) {
        wasm_jenga_tenga_helper();
        wasm_kazi_idadi = wasm_kazi_idadi + 1;
    }

    kama (wasm_kosa) { rudisha 1; }

    // Heap huanza mara tu baada ya data (mfuatano) yote, iliyopangwa
    // juu hadi baiti 4. Kurasa za awali za kumbukumbu (min_pages)
    // zinahitajika kutosha KUSHIKILIA data + heap ya awali kabla ya
    // memory.grow yoyote kuhitajika wakati wa kukimbia.
    n32 heap_init = WASM_DATA_MSINGI + wasm_data_wapi;
    heap_init = (heap_init + 3) & (0 - 4);
    n32 min_pages = (heap_init + 65535) / 65536;
    kama (min_pages < 1) { min_pages = 1; }

    // ---- Assemble moduli: kichwa -> Type -> Import -> Function ->
    // Memory -> Global -> Export -> Code -> Data (mpangilio
    // ulioamriwa na kiwango cha WASM kwa faharisi ya sehemu:
    // 1,2,3,5,6,7,10,11) ----
    // MUHIMU: wasm_jenga_kazi/wasm_jenga_tenga_helper ya mwisho huacha
    // wasm_bafu_sasa == 2 (sec_buf) -- lazima irudishwe kwa 0
    // (wasm_bafu) HAPA kabla ya kuandika kichwa, la sivyo kichwa
    // huingia kimya kwenye sec_buf (mdudu halisi uliopatikana kwa
    // kujaribu t1.swa: "asm"+toleo ilijitokeza MWISHONI mwa faili
    // badala ya MWANZONI).
    wasm_bafu_sasa = 0;
    wasm_kichwa();
    // Hesabu ya Type section ni kazi za NDANI (wasm_kazi_idadi) +
    // uingizaji 6 (Awamu 3) -- wasm_type_buf sasa ina aina ZOTE mbili
    // (uingizaji zimeandikwa kwanza na wasm_andika_aina_uingizaji).
    wasm_andika_sehemu_kutoka(1, wasm_kazi_idadi + wasm_import_idadi, wasm_type_buf, wasm_type_wapi);
    wasm_andika_sehemu_uingizaji();
    wasm_andika_function_sehemu();
    wasm_andika_memory_sehemu(min_pages);
    wasm_andika_global_sehemu(heap_init);
    wasm_andika_export_sehemu(main_idx);
    wasm_andika_sehemu_kutoka(10, wasm_kazi_idadi, wasm_sec_buf, wasm_sec_wapi);
    wasm_andika_data_sehemu();

    kama (wasm_kosa) { rudisha 1; }

    sys_andika(1, wasm_bafu, wasm_bafu_wapi);
    rudisha 0;
}
