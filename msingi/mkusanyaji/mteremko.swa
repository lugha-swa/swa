husisha { mkusanyaji/msambazaji.swa }

// ==========================================================
// mteremko.swa :: Kiteremshi cha AST→IR cha Swa
//
// Hubadilisha AST (safu-bapa) iliyochanganuliwa na
// msambazaji.swa kuwa IR ya kiwango cha kati.
//
// IR hii inatumiwa na uzalishaji.swa kuzalisha
// msimbo wa mashine badala ya kutumia AST moja kwa moja.
//
// Manufaa:
//   - Usafishaji wa alloca-in-loop (hoji hadi bloku ya kuingilia)
//   - Ushughulikiaji wa sret kwa miundo inayorudishwa
//   - Urahisi wa utekelezaji wa uboreshaji wa baadaye
// ==========================================================

// -------------------------------------------------------
// Aina za Thamani ya IR
// -------------------------------------------------------
// Familia 5 za aina za Swa kwenye IR.
// Encoding inafanana na ile ya msambazaji.swa:
//   familia << 8 | upana_idx << 3 | mshale
// Familia: 1=N, 2=A, 3=D, 4=B, 5=W, 6=Muundo (jina)
// -------------------------------------------------------

n32 IR_AINA_TUPU = 0;  // void
n32 IR_AINA_KIELEKEZI = -1;  // pointer (encoded specially)
n32 IR_AINA_KAZI_ELEKEZI = -2;  // function pointer

// -------------------------------------------------------
// Aina za Amri za IR
// -------------------------------------------------------
n32 IR_JUMLISHA = 1;
n32 IR_TOFAUTI = 2;
n32 IR_ZIDISHA = 3;
n32 IR_GAWANYA = 4;
n32 IR_SAWA = 5;
n32 IR_TOFAUTI_SI = 6;
n32 IR_CHINI = 7;
n32 IR_JUU = 8;
n32 IR_CHINI_SAWA = 9;
n32 IR_JUU_SAWA = 10;
n32 IR_NA = 11;
n32 IR_AU = 12;
n32 IR_SI = 13;
n32 IR_HAMISHA_K = 14;  // <<
n32 IR_HAMISHA_KULIA = 15;  // >>
n32 IR_BIT_NA = 16;  // &
n32 IR_BIT_AU = 17;  // |
n32 IR_ASIMILIA = 18;  // =
n32 IR_MODULO = 19;  // asilimia (%)

// Vipengele vya juu
n32 IR_WITO = 20;  // function call
n32 IR_RUDISHA = 21;  // return value
n32 IR_RUDISHA_TUPU = 22;  // return void
n32 IR_TAJA = 23;  // load (dereference)
n32 IR_KUMBUKA = 24;  // store (assign to pointer)
n32 IR_ANWANI_YA = 25;  // address-of
n32 IR_ACHILIA = 27;  // heap free
n32 IR_SEHEMU_DOT = 28;  // struct field access (.)
n32 IR_SEHEMU_MSHALE = 29;  // struct field via pointer (->)
n32 IR_SAFU_ELEM = 30;  // array element access

// Mtiririko
n32 IR_RUKA = 40;  // unconditional branch
n32 IR_RUKA_KAMA = 41;  // conditional branch
n32 IR_RUKA_SIVYO = 42;  // conditional branch (negated)
n32 IR_VUNJA = 43;
n32 IR_ENDELEA = 44;
n32 IR_CHAGUA = 45;  // switch

// Vihalisi
n32 IR_NAMBARI = 50;
n32 IR_HALISI_D = 51;  // float literal
n32 IR_MFUATANO = 52;
n32 IR_KWELI = 53;
n32 IR_UONGO = 54;
n32 IR_TUPU = 55;

// Aina za AST/IR zinazotumiwa na mteremko lakini hazitolewi na
// msambazaji (nodi za IR hushiriki nafasi ya majina ya AST)
n32 AST_KIPINDI = 56;  // kitanzi cha kwa (IR)
n32 IR_TERNARY = 60;  // IR ya ternary

// -------------------------------------------------------
// Safu za IR (bapa, kama AST)
// -------------------------------------------------------
// Kila nodi ya IR ina: aina, aina_data (type encoding),
// thamani (int literal), kushoto, kulia, tiga (extra child).
//
// MUHIMU: ukubwa umeongezwa kutoka 65536 hadi 1,048,576 pamoja na
// ast_aina[]/ast_idadi (msambazaji.swa) kwa sababu idadi ya nodi za
// IR huongezeka sanjari na idadi ya nodi za AST (kila kazi
// inayoteremshwa huzalisha angalau nodi moja ya IR kwa kila nodi ya
// AST) — mradi halisi unaovuka kikomo cha AST cha zamani ungevuka
// hiki pia. `ir_node_mpya` haikuwa na ukaguzi wa mipaka KABISA
// (tofauti na `node_mpya` ya AST) — imeongezwa hapa chini, kwa
// sababu bila hiyo kufurika kungeandika nje ya mipaka kimya kimya
// (uharibifu wa kumbukumbu), si hata hitilafu safi kama AST.
// -------------------------------------------------------
n32 ir_aina[1048576];
n32 ir_aina_data[1048576];  // type encoding kwa kila nodi
n32 ir_thamani[1048576];  // nambari halisi / offset
n32 ir_kushoto[1048576];
n32 ir_kulia[1048576];
n32 ir_tiga[1048576];
n32 ir_nne[1048576];  // mnyororo wa taarifa
n32 ir_idadi = 0;

n8 ir_pool[524288];  // dimbwi la majina/mifuatano
n32 ir_pool_wapi = 0;
n32 ir_jina_off[1048576];

// -------------------------------------------------------
// Mazingira ya kuteremsha
// -------------------------------------------------------
muundo Mteremshi {
    n32 kazi_node;  // nodi ya kazi inayoteremshwa sasa
    n32 kazi_ret_enc;  // encoding ya aina ya kurudi
    n32 ndani_ya_kitanzi;  // kina cha kitanzi (kwa vunja/endelea)
    n32 lebo_vunja;  // IR nodi ya kuvunjia kitanzi
    n32 lebo_endelea;  // IR nodi ya kuendelea kitanzi
    n32 bloku_sasa;  // bloku inayojengwa sasa
    n32 makosa;  // idadi ya makosa wakati wa kuteremsha
};

// -------------------------------------------------------
// Kitenzi-njia cha nodi ya IR
// -------------------------------------------------------
n32 ir_node_mpya(n32 aina, n32 aina_data, n32 thamani, n32 kushoto, n32 kulia) {
    kama (ir_idadi >= 1048576) {
        andika_stderr("; DEB: HITILAFU ir_node_mpya imefurika! idadi=%d aina=%d\n", ir_idadi, aina);
        rudisha -1;
    }
    n32 idx = ir_idadi;
    ir_aina[idx] = aina;
    ir_aina_data[idx] = aina_data;
    ir_thamani[idx] = thamani;
    ir_kushoto[idx] = kushoto;
    ir_kulia[idx] = kulia;
    ir_tiga[idx] = -1;
    ir_nne[idx] = -1;
    ir_jina_off[idx] = 0;
    ir_idadi = ir_idadi + 1;
    rudisha idx;
}

// -------------------------------------------------------
// Nakili jina ndani ya ir_pool
// -------------------------------------------------------
w0 ir_hifadhi_jina(n32 node, n8* maandishi, n64 urefu) {
    n32 off = ir_pool_wapi;
    ir_jina_off[node] = off;
    ir_pool_wapi = off + urefu + 1;
    n32 i = 0;
    wakati (i < urefu) {
        ir_pool[off + i] = maandishi[i];
        i = i + 1;
    }
    ir_pool[off + urefu] = 0;
}

// ==========================================================
// KITEREMSHI — hubadilisha AST → IR
// ==========================================================

// -------------------------------------------------------
// Pata aina ya data ya nodi ya AST
// -------------------------------------------------------
n32 pata_aina_data(n32 node) {
    kama (node == -1) { rudisha 0; }
    rudisha ast_thamani[node];
}

// -------------------------------------------------------
// Teremsha usemi wa AST hadi nodi ya IR
// Rudisha idx ya nodi ya IR, au -1 kwa hitilafu
// -------------------------------------------------------
n32 teremsha_usemi(Mteremshi* t, n32 node);

// -------------------------------------------------------
// Teremsha programu nzima
// -------------------------------------------------------
n32 teremsha(Mteremshi* t, n32 mzizi) {
    ir_idadi = 0;
    ir_pool_wapi = 0;
    t->makosa = 0;

    n32 kwanza_ir = -1;
    n32 prev_ir = -1;

    n32 node = ast_kushoto[mzizi];
    wakati (node != -1) {
        n32 aina = ast_aina[node];
        n32 ir_node = -1;

        kama (aina == AST_KAZI) {
            ir_node = teremsha_kazi(t, node);
        } sivyo { kama (aina == AST_MUUNDO) {
                // Miundo haihitaji kuteremshwa — inatumika kwa aina tu
                ir_node = ir_node_mpya(AST_MUUNDO, 0, 0, -1, -1);
                ir_kushoto[ir_node] = ast_kushoto[node];  // jina
                ir_kulia[ir_node] = ast_kulia[node];  // sehemu
            } sivyo { kama (aina == AST_TANGAZO_ULIMWENGU) {
                    ir_node = teremsha_tangazo_ulimwengu(t, node);
                } } }

        kama (ir_node != -1) {
            kama (prev_ir == -1) { kwanza_ir = ir_node; }
            sivyo { ir_nne[prev_ir] = ir_node; }
            prev_ir = ir_node;
        }

        node = ast_nne[node];
    }

    rudisha kwanza_ir;
}

// -------------------------------------------------------
// Teremsha tangazo la ulimwengu
// -------------------------------------------------------
n32 teremsha_tangazo_ulimwengu(Mteremshi* t, n32 node) {
    n32 jina = ast_kushoto[node];
    n32 init = ast_kulia[node];

    n32 ir_tangazo = ir_node_mpya(AST_TANGAZO_ULIMWENGU, 0, 0, jina, -1);
    ir_tiga[ir_tangazo] = init;
    rudisha ir_tangazo;
}

// -------------------------------------------------------
// Teremsha kazi nzima
// -------------------------------------------------------
n32 teremsha_kazi(Mteremshi* t, n32 node) {
    t->kazi_node = node;
    t->ndani_ya_kitanzi = 0;
    t->lebo_vunja = -1;
    t->lebo_endelea = -1;

    n32 jina = ast_kushoto[node];
    n32 params = ast_kulia[node];
    n32 body = ast_tiga[node];
    n32 ret_enc = ast_thamani[node];  // aina ya kurudi

    t->kazi_ret_enc = ret_enc;

    n32 ir_kazi = ir_node_mpya(AST_KAZI, ret_enc, 0, jina, params);

    // Teremsha mwili wa kazi
    n32 ir_mwili = -1;
    n32 prev_stmt = -1;

    kama (body != -1) {
        n32 stmt = body;
        wakati (stmt != -1) {
            n32 ir_stmt = teremsha_taarifa(t, stmt);
            kama (ir_stmt != -1) {
                kama (prev_stmt == -1) { ir_mwili = ir_stmt; }
                sivyo { ir_nne[prev_stmt] = ir_stmt; }
                prev_stmt = ir_stmt;
            }
            stmt = ast_nne[stmt];
        }
    }

    ir_tiga[ir_kazi] = ir_mwili;
    rudisha ir_kazi;
}

// -------------------------------------------------------
// Teremsha taarifa
// -------------------------------------------------------
n32 teremsha_taarifa(Mteremshi* t, n32 node) {
    kama (node == -1) { rudisha -1; }

    n32 aina = ast_aina[node];

    kama (aina == AST_RUDISHA) {
        n32 expr = ast_kushoto[node];
        n32 ir_expr = -1;
        kama (expr != -1) { ir_expr = teremsha_usemi(t, expr); }
        rudisha ir_node_mpya(IR_RUDISHA, t->kazi_ret_enc, 0, ir_expr, -1);
    }

    kama (aina == AST_VUNJA) {
        rudisha ir_node_mpya(IR_VUNJA, 0, 0, -1, -1);
    }

    kama (aina == AST_ENDELEA) {
        rudisha ir_node_mpya(IR_ENDELEA, 0, 0, -1, -1);
    }

    kama (aina == AST_TANGAZO) {
        // Tangazo la ndani: aina jina [= usemi];
        n32 aina_data = ast_thamani[node];
        n32 var = ast_kushoto[node];
        n32 init = ast_kulia[node];

        n32 ir_tangazo = ir_node_mpya(AST_TANGAZO, aina_data, 0, var, -1);
        kama (init != -1) {
            n32 ir_init = teremsha_usemi(t, init);
            ir_kulia[ir_tangazo] = ir_init;
        }
        // Safu: ukubwa uko kwenye ast_tiga
        kama (ast_tiga[node] != -1) {
            ir_tiga[ir_tangazo] = ast_tiga[node];
        }
        rudisha ir_tangazo;
    }

    kama (aina == AST_ASIMILIA) {
        // Ugawaji: aina = usemi
        n32 targ = ast_kushoto[node];
        n32 val = ast_kulia[node];

        // Kama target ni kitambulisho, ni ugawaji rahisi
        // Kama target ni taja (*ptr), ni kuhifadhi
        kama (ast_aina[targ] == AST_TAJA) {
            // *ptr = val → kumbuka
            n32 ir_ptr = teremsha_usemi(t, ast_kushoto[targ]);
            n32 ir_val = teremsha_usemi(t, val);
            rudisha ir_node_mpya(IR_KUMBUKA, 0, 0, ir_ptr, ir_val);
        }

        // Ugawaji wa kawaida
        n32 ir_targ = teremsha_usemi(t, targ);
        n32 ir_val = teremsha_usemi(t, val);
        rudisha ir_node_mpya(IR_ASIMILIA, 0, 0, ir_targ, ir_val);
    }

    // Kama, wakati, kwa, chagua — huteremshwa kama vielezi
    kama (aina == AST_KAMA || aina == AST_WAKATI || aina == AST_KIPINDI || aina == AST_CHAGUA) {
        rudisha teremsha_usemi(t, node);
    }

    // Kifungio tupu (mwili tupu wa kazi { } au taarifa tupu ';') —
    // hakuna msimbo wa IR; ruka kimya bila kosa.
    kama (aina == AST_BLOCK) { rudisha -1; }

    // Usemi kama taarifa (mf. wito wa kazi;)
    n32 ir_expr = teremsha_usemi(t, node);
    kama (ir_expr != -1) { rudisha ir_expr; }

    t->makosa = t->makosa + 1;
    rudisha -1;
}

// ==========================================================
// KITEREMSHI WA USEMI
// ==========================================================

// -------------------------------------------------------
// Teremsha usemi wa AST hadi nodi ya IR
// -------------------------------------------------------
n32 teremsha_usemi(Mteremshi* t, n32 node) {
    kama (node == -1) { rudisha -1; }

    n32 aina = ast_aina[node];
    n32 kushoto = ast_kushoto[node];
    n32 kulia = ast_kulia[node];
    n32 tiga = ast_tiga[node];

    // Vihalisi
    kama (aina == AST_NAMBARI) {
        n32 val = ast_thamani[node];
        rudisha ir_node_mpya(IR_NAMBARI, 0, val, -1, -1);
    }

    kama (aina == AST_HALISI_D) {
        // Desimali halisi: baiti za d64 ziko kwenye dimbwi; ast_thamani
        // ina ofseti ya dimbwi (baiti 8).
        n32 ir_d = ir_node_mpya(IR_HALISI_D, 0, 0, -1, -1);
        ir_thamani[ir_d] = ast_thamani[node];
        rudisha ir_d;
    }

    kama (aina == AST_MFUATANO) {
        n32 ir = ir_node_mpya(IR_MFUATANO, 0, 0, -1, -1);
        ir_hifadhi_jina(ir, ast_pool + ast_jina_off[node],
        urefu_wa_mfuatano(ast_pool + ast_jina_off[node]));
        rudisha ir;
    }

    // Vitambulisho
    kama (aina == AST_KITAMBULISHO) {
        n32 ir = ir_node_mpya(AST_KITAMBULISHO, 0, 0, -1, -1);
        ir_hifadhi_jina(ir, ast_pool + ast_jina_off[node],
        urefu_wa_mfuatano(ast_pool + ast_jina_off[node]));
        rudisha ir;
    }

    // Hesabu
    kama (aina == AST_JUMLISHA) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_JUMLISHA, 0, 0, l, r);
    }

    kama (aina == AST_TOFAUTI) {
        kama (kulia == -1) {
            // Unary minus: 0 - expr
            n32 zero = ir_node_mpya(IR_NAMBARI, 0, 0, -1, -1);
            n32 expr = teremsha_usemi(t, kushoto);
            rudisha ir_node_mpya(IR_TOFAUTI, 0, 0, zero, expr);
        }
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_TOFAUTI, 0, 0, l, r);
    }

    kama (aina == AST_ZIDISHA) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_ZIDISHA, 0, 0, l, r);
    }

    kama (aina == AST_GAWANYA) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_GAWANYA, 0, 0, l, r);
    }

    kama (aina == AST_MODULO) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_MODULO, 0, 0, l, r);
    }

    // Ulinganishi
    kama (aina == AST_SAWA) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_SAWA, 0, 0, l, r);
    }

    kama (aina == AST_TOFAUTI_SI) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_TOFAUTI_SI, 0, 0, l, r);
    }

    kama (aina == AST_CHINI) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_CHINI, 0, 0, l, r);
    }

    kama (aina == AST_JUU) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_JUU, 0, 0, l, r);
    }

    kama (aina == AST_CHINI_SAWA) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_CHINI_SAWA, 0, 0, l, r);
    }

    kama (aina == AST_JUU_SAWA) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_JUU_SAWA, 0, 0, l, r);
    }

    // Mantiki
    kama (aina == AST_NA) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_NA, 0, 0, l, r);
    }

    kama (aina == AST_AU) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_AU, 0, 0, l, r);
    }

    kama (aina == AST_SI) {
        n32 expr = teremsha_usemi(t, kushoto);
        rudisha ir_node_mpya(IR_SI, 0, 0, expr, -1);
    }

    // Bitwise
    kama (aina == AST_HAMISHA_KUSHOTO) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_HAMISHA_K, 0, 0, l, r);
    }

    kama (aina == AST_HAMISHA_KULIA) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_HAMISHA_KULIA, 0, 0, l, r);
    }

    kama (aina == AST_BIT_NA) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_BIT_NA, 0, 0, l, r);
    }

    kama (aina == AST_BIT_AU) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_BIT_AU, 0, 0, l, r);
    }

    kama (aina == AST_XOR) {
        n32 l = teremsha_usemi(t, kushoto);
        n32 r = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(AST_XOR, 0, 0, l, r);
    }

    kama (aina == AST_KINYUME) {
        n32 expr = teremsha_usemi(t, kushoto);
        rudisha ir_node_mpya(AST_KINYUME, 0, 0, expr, -1);
    }

    // Ternary
    kama (aina == AST_TERNARY) {
        n32 cond = teremsha_usemi(t, kushoto);
        n32 kweli_val = teremsha_usemi(t, kulia);
        n32 sikweli_val = teremsha_usemi(t, tiga);
        n32 ir_t = ir_node_mpya(IR_TERNARY, 0, 0, cond, kweli_val);
        ir_tiga[ir_t] = sikweli_val;
        rudisha ir_t;
    }

    // Wito wa kazi
    kama (aina == AST_WITO) {
        n32 fn_name = kushoto;
        n32 args = kulia;
        n32 ir_wito = ir_node_mpya(IR_WITO, 0, 0, fn_name, args);
        // Tiga hutumika kwa matokeo ya wito
        ir_tiga[ir_wito] = tiga;
        rudisha ir_wito;
    }

    // Kumbukumbu
    kama (aina == AST_TAJA) {
        n32 ptr = teremsha_usemi(t, kushoto);
        rudisha ir_node_mpya(IR_TAJA, 0, 0, ptr, -1);
    }

    kama (aina == AST_KUMBUKA) {
        n32 ptr = teremsha_usemi(t, kushoto);
        rudisha ir_node_mpya(IR_ANWANI_YA, 0, 0, ptr, -1);
    }

    kama (aina == AST_ACHILIA) {
        n32 ptr = teremsha_usemi(t, kushoto);
        rudisha ir_node_mpya(IR_ACHILIA, 0, 0, ptr, -1);
    }

    // Sehemu za muundo
    kama (aina == AST_SEHEMU_DOT) {
        n32 base = teremsha_usemi(t, kushoto);
        n32 field = kulia;
        n32 ir_sehemu = ir_node_mpya(IR_SEHEMU_DOT, 0, 0, base, field);
        ir_hifadhi_jina(ir_sehemu, ast_pool + ast_jina_off[field],
        urefu_wa_mfuatano(ast_pool + ast_jina_off[field]));
        rudisha ir_sehemu;
    }

    kama (aina == AST_SEHEMU_MSHALE) {
        n32 base = teremsha_usemi(t, kushoto);
        n32 field = kulia;
        n32 ir_sehemu = ir_node_mpya(IR_SEHEMU_MSHALE, 0, 0, base, field);
        ir_hifadhi_jina(ir_sehemu, ast_pool + ast_jina_off[field],
        urefu_wa_mfuatano(ast_pool + ast_jina_off[field]));
        rudisha ir_sehemu;
    }

    // Safu
    kama (aina == AST_SAFU) {
        // arr[idx] inawakilishwa kwa AST_TAJA yenye kushoto=base, kulia=idx
        // Hii inatoka kwenye changanua_usemi_upande
        kama (ast_aina[kushoto] == AST_KITAMBULISHO) {
            n32 base = kushoto;
            n32 idx = teremsha_usemi(t, kulia);
            rudisha ir_node_mpya(IR_SAFU_ELEM, 0, 0, base, idx);
        }
        // Orodha halisi: {a, b, c}
        n32 ir_safu = ir_node_mpya(AST_SAFU, 0, 0, kushoto, -1);
        rudisha ir_safu;
    }

    // Kama — inateremshwa kama usemi wenye matawi
    kama (aina == AST_KAMA) {
        n32 cond = teremsha_usemi(t, kushoto);
        n32 then_body = teremsha_taarifa(t, kulia);
        n32 else_body = -1;
        kama (tiga != -1) { else_body = teremsha_taarifa(t, tiga); }
        n32 ir_kama = ir_node_mpya(AST_KAMA, 0, 0, cond, then_body);
        ir_tiga[ir_kama] = else_body;
        rudisha ir_kama;
    }

    // Wakati
    kama (aina == AST_WAKATI) {
        n32 old_ndani = t->ndani_ya_kitanzi;
        n32 old_vunja = t->lebo_vunja;
        n32 old_endelea = t->lebo_endelea;

        t->ndani_ya_kitanzi = 1;
        t->lebo_vunja = ir_node_mpya(IR_RUKA, 0, 0, -1, -1);
        t->lebo_endelea = ir_node_mpya(IR_RUKA, 0, 0, -1, -1);

        n32 cond = teremsha_usemi(t, kushoto);
        n32 body = teremsha_taarifa(t, kulia);
        n32 ir_wakati = ir_node_mpya(AST_WAKATI, 0, 0, cond, body);
        ir_tiga[ir_wakati] = t->lebo_vunja;

        t->ndani_ya_kitanzi = old_ndani;
        t->lebo_vunja = old_vunja;
        t->lebo_endelea = old_endelea;

        rudisha ir_wakati;
    }

    // Kwa (for loop)
    kama (aina == AST_KIPINDI) {
        n32 old_ndani = t->ndani_ya_kitanzi;
        n32 old_vunja = t->lebo_vunja;
        n32 old_endelea = t->lebo_endelea;

        t->ndani_ya_kitanzi = 1;
        t->lebo_vunja = ir_node_mpya(IR_RUKA, 0, 0, -1, -1);
        t->lebo_endelea = ir_node_mpya(IR_RUKA, 0, 0, -1, -1);

        n32 init = teremsha_usemi(t, kushoto);
        n32 cond = teremsha_usemi(t, ast_thamani[node]);
        n32 step = teremsha_usemi(t, tiga);
        n32 body = teremsha_taarifa(t, kulia);
        n32 ir_kwa = ir_node_mpya(AST_KIPINDI, 0, 0, cond, body);
        ir_kushoto[ir_kwa] = init;
        ir_tiga[ir_kwa] = step;

        t->ndani_ya_kitanzi = old_ndani;
        t->lebo_vunja = old_vunja;
        t->lebo_endelea = old_endelea;

        rudisha ir_kwa;
    }

    // Chagua (switch)
    kama (aina == AST_CHAGUA) {
        n32 tested = teremsha_usemi(t, kushoto);
        n32 cases = teremsha_taarifa(t, kulia);
        n32 ir_chagua = ir_node_mpya(IR_CHAGUA, 0, 0, tested, cases);
        // Mwili wa sivyo (chaguo-msingi) uko ast_tiga ya nodi ya chagua
        ir_tiga[ir_chagua] = teremsha_taarifa(t, tiga);
        rudisha ir_chagua;
    }

    // Sivyo (else clause — inaunganishwa kwenye ir_tiga ya kama)
    kama (aina == AST_SIVYO) {
        n32 body = teremsha_taarifa(t, kushoto);
        rudisha body;
    }

    // Hali (case — inatumika ndani ya chagua)
    kama (aina == AST_HALI) {
        n32 label = teremsha_usemi(t, kushoto);
        n32 body = teremsha_taarifa(t, kulia);
        n32 ir_hali = ir_node_mpya(AST_HALI, 0, 0, label, body);
        rudisha ir_hali;
    }

    // ASIMILIA (=) katika muktadha wa usemi — mfano b = (a = 42)
    kama (aina == AST_ASIMILIA) {
        n32 ir_targ = teremsha_usemi(t, kushoto);
        n32 ir_val = teremsha_usemi(t, kulia);
        rudisha ir_node_mpya(IR_ASIMILIA, 0, 0, ir_targ, ir_val);
    }

    t->makosa = t->makosa + 1;
    rudisha -1;
}
