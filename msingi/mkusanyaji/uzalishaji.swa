    andika_baiti(modrm);
    andika_baiti((256 - off) & 255);
}

// movsd xmmN, [rbp + disp8] — pakia D64 kutoka rafu (F2 0F 10 /r)
W0 andika_movsd_xmm_rbp_off(N32 reg, N32 off) {
    andika_baiti(242);  // F2
    andika_baiti(15);  // 0F
    andika_baiti(16);  // 10
