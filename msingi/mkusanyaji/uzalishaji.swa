    kama (off < 128) {
        andika_baiti(137);
        andika_baiti(69);
        andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(137);
        andika_baiti(133);
        andika_disp32_ya_off(off);
    }
}

