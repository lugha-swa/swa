// lea eax, [rbp+disp8] — anwani ya kigeu cha ndani (8D 45 xx) au (8D 85 xxxx)
w0 andika_lea_eax_rbp_ofseti(n32 ofseti) {
    kama (ofseti < 128) {
        andika_baiti(141); andika_baiti(69); andika_baiti((256 - ofseti) & 255);
    } sivyo {
        andika_baiti(141); andika_baiti(133);
        andika_disp32_ya_ofseti(ofseti);
    }
}

// mov eax, [rbp + disp8] (8B 45 xx) au [rbp+disp32] (8B 85 xxxx)
// off ni umbali chanya kutoka kwa rbp (k.m. 4, 8, 12)
