// divsd xmm0, xmm1  (F2 0F 5E C1)
w0 andika_divsd_xmm0_xmm1() { andika_baiti(242); andika_baiti(15); andika_baiti(94); andika_baiti(193); }

// === SSE2 — jozi za d64 (128-bit, elementi mbili kwa wakati mmoja) ===
// Kutumika PEKEE na uvektishaji wa kitanzi (simd_*, karibu na
// uzalishaji_wakati). SSE2 ni sehemu ya msingi ya x86-64 -- CPU YOYOTE
// ya 64-bit inaiunga mkono bila masharti, hivyo hakuna haja ya kuchunguza
// uwezo wa CPU wakati wa kuendesha (kinyume na AVX/upana mpana zaidi).
//
// movupd (isiyo-patanishwa) inatumika kila mahali -- SI movapd. Bafa za
// tenga() (kumbukumbu.swa) hazithibitishi upatanifu wa baiti-16, hivyo
// movapd ingeweza kuanguka (#GP) kwa nasibu kutegemea anwani ya ugawaji
// -- hitilafu ya vipindi visivyoweza kutabirika. Gharama ndogo ya ziada
// ya movupd dhidi ya movapd ni sahihi zaidi kuliko hatari hiyo.
//
// movupd xmm0, [rax]  (66 0F 10 00) -- pakia jozi ya d64 kutoka [rax]
w0 andika_movupd_xmm0_mem_rax() { andika_baiti(102); andika_baiti(15); andika_baiti(16); andika_baiti(0); }
// movupd xmm1, [rax]  (66 0F 10 08)
w0 andika_movupd_xmm1_mem_rax() { andika_baiti(102); andika_baiti(15); andika_baiti(16); andika_baiti(8); }
// movupd [rax], xmm0  (66 0F 11 00) -- hifadhi jozi ya d64 hadi [rax]
w0 andika_movupd_mem_rax_xmm0() { andika_baiti(102); andika_baiti(15); andika_baiti(17); andika_baiti(0); }
// addpd xmm0, xmm1  (66 0F 58 C1)
w0 andika_addpd_xmm0_xmm1() { andika_baiti(102); andika_baiti(15); andika_baiti(88); andika_baiti(193); }
// subpd xmm0, xmm1  (66 0F 5C C1)
w0 andika_subpd_xmm0_xmm1() { andika_baiti(102); andika_baiti(15); andika_baiti(92); andika_baiti(193); }
// mulpd xmm0, xmm1  (66 0F 59 C1) -- HAKUNA divpd kwa uangalifu ule ule
// unaotumika kwa uwiano wa scalar (/) na (%): hakuna operesheni ya
// mgawanyo inayovektishwa mahali popote kwenye awamu hii.
w0 andika_mulpd_xmm0_xmm1() { andika_baiti(102); andika_baiti(15); andika_baiti(89); andika_baiti(193); }

// === SSE — ulinganishi ===
// comiss xmm0, xmm1  (0F 2F C1)
w0 andika_comiss_xmm0_xmm1() { andika_baiti(15); andika_baiti(47); andika_baiti(193); }
// comisd xmm0, xmm1  (66 0F 2F C1)
w0 andika_comisd_xmm0_xmm1() { andika_baiti(102); andika_baiti(15); andika_baiti(47); andika_baiti(193); }

// === SSE — ubadilishaji ===
// cvtsi2sd xmm0, eax  (F2 0F 2A C0) — n32 → d64
w0 andika_cvtsi2sd_xmm0_eax() { andika_baiti(242); andika_baiti(15); andika_baiti(42); andika_baiti(192); }
// cvtsi2sd xmm0, rax  (F2 48 0F 2A C0) — n64 → d64
w0 andika_cvtsi2sd_xmm0_rax() { andika_baiti(242); andika_baiti(72); andika_baiti(15); andika_baiti(42); andika_baiti(192); }
// cvtsi2ss xmm0, rax  (F3 48 0F 2A C0) — n64 → D32
w0 andika_cvtsi2ss_xmm0_rax() { andika_baiti(243); andika_baiti(72); andika_baiti(15); andika_baiti(42); andika_baiti(192); }
// cvttsd2si eax, xmm0  (F2 0F 2C C0) — d64 → n32
w0 andika_cvttsd2si_eax_xmm0() { andika_baiti(242); andika_baiti(15); andika_baiti(44); andika_baiti(192); }
// cvttsd2si rax, xmm0  (F2 48 0F 2C C0) — d64 → n64
w0 andika_cvttsd2si_rax_xmm0() { andika_baiti(242); andika_baiti(72); andika_baiti(15); andika_baiti(44); andika_baiti(192); }
// cvttss2si rax, xmm0  (F3 48 0F 2C C0) — D32 → n64
w0 andika_cvttss2si_rax_xmm0() { andika_baiti(243); andika_baiti(72); andika_baiti(15); andika_baiti(44); andika_baiti(192); }

// Aina (enc) ya usemi kama mkaguzi anavyoiona. Halisi kamili ina
// enc kwenye ast_nne (ast_thamani ni thamani yenyewe); HALISI_D ni
// d64; wito unarudisha aina ya kazi kwenye jedwali la mkaguzi.
n32 aina_ya_usemi(n32 nodi) {
    kama (nodi == -1) { rudisha 0; }
    n32 a = mti_aina[nodi];
    kama (a == 4) { rudisha mti_nne[nodi]; }  // halisi kamili: enc iko ast_nne
    kama (a == 45) { rudisha mti_nne[nodi]; }  // desimali halisi: d64 (832)
    kama (a >= 20) { kama (a <= 25) { rudisha USIMBAJI_ULINGANISHI; } }  // ulinganishi: 0/1 kwenye eax
    kama (a == 8) {
        // Wito: aina ya kurudi ya kazi iliyosajiliwa na mkaguzi
        n8* jina = mti_dimbwi + mti_jina_ofseti[mti_kushoto[nodi]];
        n32 j = 0;
        wakati (j < kazi_matokeo_idadi) {
            // TAHADHARI: mkaguzi huandika majina kwenye kazi_jina_pool
            // (ofseti ziko kazi_ret_jina_off) — kazi_ret_pool haijawahi
            // kujazwa, hivyo ulinganisho ungekosa na aina ya kurudi
            // ya wito ingebaki 0 (jibu baya la `rudisha f()`).
            kama (jina_linganisha(kazi_jina_dimbwi + kazi_matokeo_jina_ofseti[j], jina)) { rudisha kazi_matokeo_aina[j]; }
            j = j + 1;
        }
    }
    rudisha mti_thamani[nodi];
}

// Badilisha thamani ya usemi (kwenye eax/rax au xmm0) hadi aina ya
// lengwa kwenye mpaka wa kamili/desimali — C-semantiki ya pandisha:
// nambari kamili inabadilishwa hadi d64/D32 (cvtsi2sd/cvtsi2ss);
// desimali inakatwa hadi sifuri ikiwa lengwa ni kamili
// (cvttsd2si/cvttss2si). Mchanganyiko usiowezekana (kielekezi,
// boole, miundo) unakataliwa kwa sauti — jibu baya halikubaliki.
w0 badili_mpaka_wa_desimali(n32 nodi, n32 usimbaji_lengwa) {
    kama (usimbaji_lengwa <= 0) { rudisha; }
    n32 usimbaji = aina_ya_usemi(nodi);
    kama (usimbaji <= 0) { rudisha; }
    kama (ni_desimali_usimbaji(usimbaji_lengwa) == 0) {
        kama (ni_desimali_usimbaji(usimbaji) == 0) { rudisha; }
    }
    // Lengwa ni desimali: badilisha nambari kamili hadi xmm0
    kama (ni_desimali_usimbaji(usimbaji_lengwa)) {
        kama (ni_desimali_usimbaji(usimbaji)) {
            // Desimali kwa desimali: upana ukitofautiana (D32/d64),
            // badilisha kupitia cvtsd2ss/cvtss2sd. Hapo awali ilirudi
            // kimya na D32 ilibaki na thamani ya d64 — jibu baya.
            n32 saizi_l2 = ukubwa_kutoka_usimbaji(usimbaji_lengwa);
            n32 saizi_e2 = ukubwa_kutoka_usimbaji(usimbaji);
            kama (saizi_l2 == saizi_e2) { rudisha; }  // tayari iko xmm0
            kama (saizi_l2 >= 8) {
                // cvtss2sd xmm0, xmm0 (F3 0F 5A C0) — D32 hadi d64
                andika_baiti(243); andika_baiti(15); andika_baiti(90); andika_baiti(192);
            } sivyo {
                // cvtsd2ss xmm0, xmm0 (F2 0F 5A C0) — d64 hadi D32
                andika_baiti(242); andika_baiti(15); andika_baiti(90); andika_baiti(192);
            }
            rudisha;
        }
        n32 familia = (usimbaji / 256) % 256;
        n32 ni_kamili = 0;
        kama (familia == 1) { ni_kamili = 1; }
        kama (familia == 2) { ni_kamili = 1; }
        kama (ni_kamili) {
            kama ((usimbaji / 2) * 2 != usimbaji) {
                andika_stderr("Hitilafu: kielekezi kwenye operesheni ya desimali\n");
                wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
            }
            n32 saizi_l = ukubwa_kutoka_usimbaji(usimbaji_lengwa);
            n32 saizi_e = ukubwa_kutoka_usimbaji(usimbaji);
            kama (saizi_l >= 8) {
                kama (saizi_e >= 8) { andika_cvtsi2sd_xmm0_rax(); }
                sivyo { andika_cvtsi2sd_xmm0_eax(); }
            } sivyo {
                kama (saizi_e >= 8) { andika_cvtsi2ss_xmm0_rax(); }
                sivyo { andika_cvtsi2ss_xmm0_eax(); }
            }
            rudisha;
        }
        kama (usimbaji == USIMBAJI_ULINGANISHI) {
            // matokeo ya ulinganishi yako eax (0 au 1)
            kama (ukubwa_kutoka_usimbaji(usimbaji_lengwa) >= 8) { andika_cvtsi2sd_xmm0_eax(); }
            sivyo { andika_cvtsi2ss_xmm0_eax(); }
            rudisha;
        }
        andika_stderr("Hitilafu: aina isiyo kamili kwenye operesheni ya desimali (enc=%d)\n", usimbaji);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        rudisha;
    }
    // Lengwa ni kamili, chanzo ni desimali: kata hadi sifuri
    n32 familia_l = (usimbaji_lengwa / 256) % 256;
    n32 ni_kamili_l = 0;
    kama (familia_l == 1) { ni_kamili_l = 1; }
    kama (familia_l == 2) { ni_kamili_l = 1; }
    kama (ni_kamili_l) {
        kama ((usimbaji_lengwa / 2) * 2 != usimbaji_lengwa) {
            andika_stderr("Hitilafu: desimali kwenye operesheni ya kielekezi\n");
            wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        }
        n32 saizi_l = ukubwa_kutoka_usimbaji(usimbaji_lengwa);
        n32 saizi_e = ukubwa_kutoka_usimbaji(usimbaji);
        kama (saizi_l >= 8) {
            kama (saizi_e >= 8) { andika_cvttsd2si_rax_xmm0(); }
            sivyo { andika_cvttss2si_rax_xmm0(); }
        } sivyo {
            kama (saizi_e >= 8) { andika_cvttsd2si_eax_xmm0(); }
            sivyo { andika_cvttss2si_eax_xmm0(); }
        }
        rudisha;
    }
    andika_stderr("Hitilafu: desimali haiwezi kupewa aina hii (enc=%d)\n", usimbaji_lengwa);
    wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
}

// Kataa kwa sauti: operesheni (modulo, hamisha, biti, mantiki)
// haifanyi kazi kwa desimali — jibu baya halikubaliki. Inaangalia
// operesheni zenyewe kupitia aina_ya_usemi, si enc ya nodi: ulinganishi
// wa d64 una enc ya d64 lakini tokeo lake ni B1 kwenye eax.
w0 kataa_operesheni_ya_desimali(n32 nodi) {
    kama (ni_desimali_usimbaji(aina_ya_usemi(mti_kushoto[nodi]))) {
        andika_stderr("Hitilafu: operesheni hii haifanyi kazi kwa desimali\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    kama (ni_desimali_usimbaji(aina_ya_usemi(mti_kulia[nodi]))) {
        andika_stderr("Hitilafu: operesheni hii haifanyi kazi kwa desimali\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
}

// === Usajili wa uhamishaji kwa vigezo vya ulimwengu ===
// Huhifadhi nafasi katika bafa_text inayohitaji kurekebishwa
// na faharisi ya kigeu cha ulimwengu.
w0 andika_rela_ulimwengu(n32 urekebishaji_faharasa) {
    // Safisha push inayosubiri KWANZA -- kazi hii inarekodi
    // bafa_text_wapi kama nafasi ya kurekebisha baadaye, hivyo
    // LAZIMA ionekane nafasi HALISI (angalia maelezo kamili juu ya
    // png_safisha, mwanzo wa faili hili).
    png_safisha();
    kama (rela_idadi < 65536) {
        rela_text_ofseti[rela_idadi] = bafa_text_wapi;
        rela_nje_id[rela_idadi] = -1;  // alama: sio nje
        rela_ulimwengu_faharasa[rela_idadi] = urekebishaji_faharasa;
        rela_idadi = rela_idadi + 1;
    } sivyo {
        // lugha-swa/swa#298 -- darasa lile lile la mdudu (#189/#197/
        // #199/#200/#292/#295): kuendelea kimya hapa kungeacha
        // disp32 ya rip-relative ikiwa 0 milele, ikisababisha
        // ufikiaji WA UONGO wa kigezo cha ulimwengu kimya kimya.
        andika_stderr("KOSA: jedwali la urekebishaji (rela_*) limejaa (kikomo 65536) — anwani hii haitarekebishwa sahihi\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
}

// === RIP-relative — vigezo vya ulimwengu ===
// mov eax, [rip + disp32]  (8B 05 xx xx xx xx)
w0 andika_mov_eax_rip_rel(n32 urekebishaji_faharasa) {
    andika_baiti(139);
    andika_baiti(5);
    // Weka uhamishaji (relocation) kwa kigeu cha ulimwengu
    andika_rela_ulimwengu(urekebishaji_faharasa);
    andika_neno4(0);  // itajazwa na kiunganishi
}

// mov rax, [rip + disp32]  (48 8B 05 xx xx xx xx)
w0 andika_mov_rax_rip_rel(n32 urekebishaji_faharasa) {
    andika_baiti(72);
    andika_baiti(139);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_faharasa);
    andika_neno4(0);
}

// lea rax, [rip + disp32] (48 8D 05 xx xx xx xx) — anwani ya kigeu cha ulimwengu
w0 andika_lea_rax_rip_rel(n32 urekebishaji_faharasa) {
    andika_baiti(72);
    andika_baiti(141);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_faharasa);
    andika_neno4(0);
}

// mov [rip + disp32], eax  (89 05 xx xx xx xx)
w0 andika_mov_rip_rel_eax(n32 urekebishaji_faharasa) {
    andika_baiti(137);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_faharasa);
    andika_neno4(0);
}

// mov [rip + disp32], rax  (48 89 05 xx xx xx xx)
w0 andika_mov_rip_rel_rax(n32 urekebishaji_faharasa) {
    andika_baiti(72);
    andika_baiti(137);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_faharasa);
    andika_neno4(0);
}

// mov [rip + disp32], al  (88 05 xx xx xx xx)
w0 andika_mov_rip_rel_al(n32 urekebishaji_faharasa) {
    andika_baiti(136);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_faharasa);
    andika_neno4(0);
}

// mov [rip + disp32], ax  (66 89 05 xx xx xx xx)
w0 andika_mov_rip_rel_ax16(n32 urekebishaji_faharasa) {
    andika_baiti(102);  // kiambishi awali cha operesheni ya baiti 2
    andika_baiti(137);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_faharasa);
    andika_neno4(0);
}

// movsx eax, byte [rip + disp32]  (0F BE 05 xx xx xx xx)
w0 andika_movsx_eax_rip_rel_b1(n32 urekebishaji_faharasa) {
    andika_baiti(15);
    andika_baiti(190);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_faharasa);
    andika_neno4(0);
}

// movsx eax, word [rip + disp32]  (0F BF 05 xx xx xx xx)
w0 andika_movsx_eax_rip_rel_b2(n32 urekebishaji_faharasa) {
    andika_baiti(15);
    andika_baiti(191);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_faharasa);
    andika_neno4(0);
}

// movzx eax, byte [rip + disp32]  (0F B6 05 xx xx xx xx)
w0 andika_movzx_eax_rip_rel_b1(n32 urekebishaji_faharasa) {
    andika_baiti(15);
    andika_baiti(182);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_faharasa);
    andika_neno4(0);
}

// movzx eax, word [rip + disp32]  (0F B7 05 xx xx xx xx)
w0 andika_movzx_eax_rip_rel_b2(n32 urekebishaji_faharasa) {
    andika_baiti(15);
    andika_baiti(183);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_faharasa);
    andika_neno4(0);
}

// Msaidizi: hifadhi thamani kutoka rax/eax/ax/al hadi [rip+disp32]
// kwa kigeu cha ulimwengu, kulingana na usimbaji wa aina.
// Desimali hutumia movsd/movss [rip+disp32], xmm0.
w0 andika_mov_rip_rel_ax(n32 usimbaji, n32 urekebishaji_faharasa) {
    kama (ni_desimali_usimbaji(usimbaji)) {
        n32 uk = ukubwa_kutoka_usimbaji(usimbaji);
        kama (uk >= 8) { andika_baiti(242); andika_baiti(15); andika_baiti(17); andika_baiti(5); }
        sivyo { andika_baiti(243); andika_baiti(15); andika_baiti(17); andika_baiti(5); }
        andika_rela_ulimwengu(urekebishaji_faharasa);
        andika_neno4(0);
        rudisha;
    }
    n32 uk = ukubwa_kutoka_usimbaji(usimbaji);
    kama (uk >= 8) {
        andika_mov_rip_rel_rax(urekebishaji_faharasa);
    } sivyo { kama (uk >= 4) {
            andika_mov_rip_rel_eax(urekebishaji_faharasa);
        } sivyo { kama (uk >= 2) {
                andika_mov_rip_rel_ax16(urekebishaji_faharasa);
            } sivyo {
                andika_mov_rip_rel_al(urekebishaji_faharasa);
            } } }
}

// Msaidizi: pakia thamani kutoka [rip+disp32] hadi eax/rax kwa upana
// sahihi na upanuzi wa ishara/sifuri kwa aina ndogo.
// Desimali hutumia movsd/movss xmm0, [rip+disp32].
w0 andika_mov_ax_rip_rel(n32 usimbaji, n32 urekebishaji_faharasa) {
    kama (ni_desimali_usimbaji(usimbaji)) {
        n32 uk = ukubwa_kutoka_usimbaji(usimbaji);
        kama (uk >= 8) { andika_baiti(242); andika_baiti(15); andika_baiti(16); andika_baiti(5); }
        sivyo { andika_baiti(243); andika_baiti(15); andika_baiti(16); andika_baiti(5); }
        andika_rela_ulimwengu(urekebishaji_faharasa);
        andika_neno4(0);
        rudisha;
    }
    n32 uk = ukubwa_kutoka_usimbaji(usimbaji);
    kama (uk >= 8) {
        andika_mov_rax_rip_rel(urekebishaji_faharasa);
    } sivyo { kama (uk >= 4) {
            andika_mov_eax_rip_rel(urekebishaji_faharasa);
        } sivyo { kama (uk >= 2) {
                // Aina ya baiti 2: panua kwa ishara au sifuri
                kama (ni_bila_ishara_usimbaji(usimbaji)) {
                    andika_movzx_eax_rip_rel_b2(urekebishaji_faharasa);
                } sivyo {
                    andika_movsx_eax_rip_rel_b2(urekebishaji_faharasa);
                }
            } sivyo {
                // Aina ya baiti 1: panua kwa ishara au sifuri
                kama (ni_bila_ishara_usimbaji(usimbaji)) {
                    andika_movzx_eax_rip_rel_b1(urekebishaji_faharasa);
                } sivyo {
                    andika_movsx_eax_rip_rel_b1(urekebishaji_faharasa);
                }
            } } }
}


// === Visaidizi vya usambazaji wa aina ===
// Rudisha 1 ikiwa encoding ni ya desimali (familia D=3).
// MUHIMU (lugha-swa/swa#181): kielekezi kwenda d64/D32 (mfano
// d64*, mshale=1, enc isiyo sawa/ODD) LINA familia==3 ile ile ya
// d64 yenyewe -- lakini KIELEKEZI (anwani, GP register) SI thamani
// ya desimali (xmm) kamwe, hata kama kinaelekeza d64. Bila ukaguzi
// huu, kila operesheni inayotumia ni_desimali_enc kuamua "je,
// tumie xmm0 au eax/rax?" ilishughulikia d64*/D32* kama d64/D32
// halisi -- kufanya d64* kutofanya kazi KABISA (dereference,
// fahirisi, hesabu ya kielekezi, ugawaji wa awali, yote).
n32 ni_desimali_usimbaji(n32 usimbaji) {
    kama (usimbaji == 0) { rudisha 0; }
    kama ((usimbaji / 2) * 2 != usimbaji) { rudisha 0; }  // kielekezi -- anwani, si desimali
    n32 familia = (usimbaji / 256) % 256;
    kama (familia == 3) { rudisha 1; }
    rudisha 0;
}

// Rudisha 1 ikiwa encoding inahitaji usajili wa 64-bit
n32 ni_aina_ya_64bit(n32 usimbaji) {
    kama (usimbaji == 0) { rudisha 0; }
    // Hesabu ya / na * (mbegu ina hitilafu katika & na >>)
    kama ((usimbaji / 2) * 2 != usimbaji) { rudisha 1; }  // kielekezi = baiti 8
    n32 familia = (usimbaji / 256) % 256;
    n32 upana = usimbaji - (familia * 256);
    kama (familia >= 1 && familia <= 5) {
        rudisha (upana >= 64);
    }
    rudisha 0;  // miundo na aina nyingine
}

// Rudisha 1 ikiwa encoding ni bila ishara (familia A=2, B=4, W=5)
// Aina hizi hutumia div (si idiv), shr (si sar), setb/seta (si setl/setg)
// Alama ya ndani ya matokeo ya ulinganishi (== != < > <= >=): 0 au 1
// kwenye eax. SI aina ya lugha, na SI familia b -- familia b ni mifumo
// ya biti (angalia B1_ENC kwenye mkaguzi.swa). Thamani 1025 ni isiyo
// sawa kimakusudi: usemi_ni_kielekezi huitofautisha kwa aina ya nodi.
n32 USIMBAJI_ULINGANISHI = 1025;

n32 ni_bila_ishara_usimbaji(n32 usimbaji) {
    kama (usimbaji == 0) { rudisha 0; }
    n32 familia = (usimbaji / 256) % 256;
    kama (familia == 2) { rudisha 1; }
    kama (familia == 4) { rudisha 1; }
    kama (familia == 5) { rudisha 1; }
    rudisha 0;
}

// call rel32 (E8 + offset)
w0 andika_call_bandari(n32 ofseti) {
