}

// mov ecx, imm32 (B9 + imm32) — hurekebisha rcx kiotomatiki
w0 andika_mov_ecx_imm32(n32 v) {
    andika_baiti(185);
    andika_neno4(v);
}

// rep movsb (F3 A4) — nakili rcx baiti kutoka [rsi] hadi [rdi]
w0 andika_rep_movsb() {
    andika_baiti(243); andika_baiti(164);
}

// lea rax, [rbp+disp8] (48 8D 45 disp8) — toleo la 64-bit
w0 andika_lea_rax_rbp_ofseti(n32 ofseti) {
    kama (ofseti < 128) {
        andika_baiti(72); andika_baiti(141); andika_baiti(69);
        andika_baiti((256 - ofseti) & 255);
    } sivyo {
        andika_baiti(72); andika_baiti(141); andika_baiti(133);
        andika_disp32_ya_ofseti(ofseti);
    }
}

// lea rdi, [rbp+disp8] (48 8D 7D disp8) au [rbp+disp32] (48 8D BD xxxx)
w0 andika_lea_rdi_rbp_ofseti(n32 ofseti) {
    kama (ofseti < 128) {
        andika_baiti(72); andika_baiti(141); andika_baiti(125);
        andika_baiti((256 - ofseti) & 255);
    } sivyo {
        andika_baiti(72); andika_baiti(141); andika_baiti(189);
        andika_disp32_ya_ofseti(ofseti);
    }
}

