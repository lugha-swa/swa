// Toa lea rax, [rip + disp32] kwa lebo, ikiwa ni pamoja na kurekebisha kuruka mbele
// -------------------------------------------------------
// Lebo za kazi (kwa jedwali la alama)
// -------------------------------------------------------

// lugha-swa/swa#298 -- ukubwa wa ZAMANI (2048) ulikuwa karibu sana na
// idadi halisi ya kazi za mradi mkubwa (Dominion's mchezo.swa tayari
// ina kazi 1000+ na inaendelea kukua) -- ongezwa (mara 32) kuendana
// na kazi_idadi/kazi_ret_idadi (mkaguzi.swa, tayari 65536) ambazo
// zinahesabu KITU KILE KILE (jumla ya kazi za mradi mzima).
n32 lebo_nafasi[65536];
n8* lebo_jina[65536];
n32 lebo_matokeo_usimbaji[65536];  // encoding ya aina ya kurudi ya kazi
n32 lebo_idadi = 0;

w0 lebo_hifadhi(n8* jina, n32 matokeo_usimbaji) {
    // Safisha push inayosubiri KWANZA -- angalia maelezo kamili juu
    // ya png_safisha, mwanzo wa faili hili.
    png_safisha();
    kama (lebo_idadi < 65536) {
        lebo_jina[lebo_idadi] = jina;
        lebo_nafasi[lebo_idadi] = bafa_text_wapi;
        lebo_matokeo_usimbaji[lebo_idadi] = matokeo_usimbaji;
        lebo_idadi = lebo_idadi + 1;
    } sivyo {
        // lugha-swa/swa#298 -- hii ilikuwa ikichapisha KOSA kisha
        // kuendelea kimya (kazi haikusajiliwa KABISA kwenye jedwali
        // la lebo, ikisababisha wito wowote kwake baadaye kuonekana
        // "haijafafanuliwa" kimakosa, au mbaya zaidi, lebo_idadi
        // ikibaki ikilingana na kazi tofauti). Sasa inasimamisha.
        andika_stderr("KOSA: jedwali la lebo za kazi (lebo_*) limejaa (kikomo 65536) kwenye kazi '%s' — mradi una kazi nyingi mno\n", jina);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
}

// -------------------------------------------------------
// Lebo za kuruka (za mtiririko wa udhibiti ndani ya kazi)
// -------------------------------------------------------

n32 lebo_bafa_nafasi[65536];
n32 lebo_bafa_imewekwa[65536];
n32 lebo_bafa_idadi = 0;

n32 urekebishaji_nafasi[65536];
n32 urekebishaji_lebo[65536];
n32 urekebishaji_idadi = 0;

// Hali ya exe: 1 = toa ET_EXEC ya kujitegemea badala ya .o.
n32 hali_exe_sasa = 0;

// Msaidizi wa kuongeza kuingia kwa fixup (na ulinzi wa mipaka)
w0 weka_urekebishaji(n32 lebo_id) {
    // Safisha push inayosubiri KWANZA -- angalia maelezo kamili juu
    // ya png_safisha, mwanzo wa faili hili.
    png_safisha();
    kama (urekebishaji_idadi < 65536) {
        urekebishaji_nafasi[urekebishaji_idadi] = bafa_text_wapi;
        urekebishaji_lebo[urekebishaji_idadi] = lebo_id;
        urekebishaji_idadi = urekebishaji_idadi + 1;
    } sivyo {
        // lugha-swa/swa#298 -- kuendelea kimya hapa kunaacha agizo la
        // LEA lililotolewa hivi punde (toa_lea_rax_kwa_lebo) likiwa
        // na disp32 ya 0 (ya muda) MILELE -- haitafikiwa kamwe na
        // weka_lebo, ikisababisha anwani YA UONGO kuandikwa kimya.
        andika_stderr("KOSA: jedwali la fixup (fixup_*) limejaa (kikomo 65536)\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
}

// Toa lea rax, [rip + disp32] kwa lebo, ikiwa ni pamoja na kurekebisha kuruka mbele
w0 toa_lea_rax_kwa_lebo(n32 lebo_id) {
    andika_lea_rax_rip();  // 48 8D 05
    weka_urekebishaji(lebo_id);
    andika_neno4(0);  // thamani ya muda; itarekebishwa na weka_lebo
}

n32 mzunguko_lebo_endelea[16];
n32 mzunguko_lebo_hatua[16];  // lebo ya hatua ya kwa (semantiki ya C ya endelea)
n32 mzunguko_lebo_toka[16];
n32 mzunguko_undani = 0;

n32 lebo_bafa_mpya() {
    // lugha-swa/swa#298 -- hii ilikuwa ikirudisha -1 KIMYA; waitaji
    // wengi (mfano matamko ya kitanzi cha kwa/wakati) hawaangalii
    // matokeo kabla ya kuyatumia kama faharisi ya lebo -- sawa na
    // hatari iliyoandikwa kwenye #199 kwa node_mpya(). Sasa
    // inasimamisha ukusanyaji kwenye chanzo badala ya kutegemea kila
    // mwitaji kukagua.
    kama (lebo_bafa_idadi >= 65536) {
        andika_stderr("KOSA: jedwali la lebo za kuruka (lebo_buf_*) limejaa (kikomo 65536)\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    n32 id = lebo_bafa_idadi;
    lebo_bafa_idadi = lebo_bafa_idadi + 1;
    lebo_bafa_imewekwa[id] = 0;
    rudisha id;
}

// Weka lebo mahali pa sasa na rekebisha marekebisho yanayoiendea
w0 weka_lebo(n32 lebo_id) {
    // MUHIMU ZAIDI ya nafasi zote za png_safisha (angalia maelezo
    // kamili mwanzo wa faili hili): hii ndiyo hasa mahali ambapo
    // lengo la kuruka linarekodiwa. Kama push ingesubiri bila
    // kusafishwa hapa, mtiririko wa udhibiti ungeweza kuruka MOJA KWA
    // MOJA kati ya push (isiyotolewa) na pop inayotarajiwa --
    // ikisoma thamani isiyokusudiwa kutoka rafuni. png_safisha
    // kabla ya kurekodi bafa_text_wapi inahakikisha lebo HAIWEZI
    // KAMWE kuangukia katikati ya push/pop iliyoahirishwa.
    png_safisha();
    lebo_bafa_nafasi[lebo_id] = bafa_text_wapi;
    lebo_bafa_imewekwa[lebo_id] = 1;
    n32 i = 0;
    wakati (i < urekebishaji_idadi) {
        kama (urekebishaji_lebo[i] == lebo_id) {
            n32 nafasi_hii = urekebishaji_nafasi[i];
            n32 ofseti = bafa_text_wapi - (nafasi_hii + 4);
            bafa_text[nafasi_hii] = ofseti & 255;
            bafa_text[nafasi_hii + 1] = (ofseti >> 8) & 255;
            bafa_text[nafasi_hii + 2] = (ofseti >> 16) & 255;
            bafa_text[nafasi_hii + 3] = (ofseti >> 24) & 255;
        }
        i = i + 1;
    }
}

// Toa je rel32 kwa lebo (inashughulikia kuruka nyuma na mbele)
w0 toa_je_lebo(n32 lebo_id) {
    andika_baiti(15); andika_baiti(132);
    kama (lebo_bafa_imewekwa[lebo_id]) {
        n32 ofseti = lebo_bafa_nafasi[lebo_id] - (bafa_text_wapi + 4);
        andika_neno4(ofseti);
    } sivyo {
        weka_urekebishaji(lebo_id);
        andika_neno4(0);
    }
}

// Toa jne rel32 kwa lebo
w0 toa_jne_lebo(n32 lebo_id) {
    andika_baiti(15); andika_baiti(133);
    kama (lebo_bafa_imewekwa[lebo_id]) {
        n32 ofseti = lebo_bafa_nafasi[lebo_id] - (bafa_text_wapi + 4);
        andika_neno4(ofseti);
    } sivyo {
        weka_urekebishaji(lebo_id);
        andika_neno4(0);
    }
}

// Toa jmp rel32 kwa lebo
w0 toa_jmp_lebo(n32 lebo_id) {
    andika_baiti(233);
    kama (lebo_bafa_imewekwa[lebo_id]) {
        n32 ofseti = lebo_bafa_nafasi[lebo_id] - (bafa_text_wapi + 4);
        andika_neno4(ofseti);
    } sivyo {
        weka_urekebishaji(lebo_id);
        andika_neno4(0);
    }
}

// -------------------------------------------------------
// Visaidizi vya kuandika vipengele vya ELF (moja kwa moja)
// -------------------------------------------------------

w0 andika_elf_sym(n32 st_name, n32 st_info, n32 st_shndx, n32 st_value, n32 st_size) {
    andika_neno4_moja_kwa_moja(st_name);
    andika_baiti_moja_kwa_moja(st_info & 255);
    andika_baiti_moja_kwa_moja(0);
    andika_neno2_moja_kwa_moja(st_shndx);
    andika_neno8_moja_kwa_moja(st_value, 0);
    andika_neno8_moja_kwa_moja(st_size, 0);
}

w0 andika_elf_shdr(n32 sh_name, n32 sh_type, n32 sh_bendera, n32 sh_ofseti,
n32 sh_size, n32 sh_link, n32 sh_info,
n32 sh_addralign, n32 sh_entsize) {
    andika_neno4_moja_kwa_moja(sh_name);
    andika_neno4_moja_kwa_moja(sh_type);
    andika_neno8_moja_kwa_moja(sh_bendera, 0);
    andika_neno8_moja_kwa_moja(0, 0);
    andika_neno8_moja_kwa_moja(sh_ofseti, 0);
    andika_neno8_moja_kwa_moja(sh_size, 0);
    andika_neno4_moja_kwa_moja(sh_link);
    andika_neno4_moja_kwa_moja(sh_info);
    andika_neno8_moja_kwa_moja(sh_addralign, 0);
    andika_neno8_moja_kwa_moja(sh_entsize, 0);
}

// -------------------------------------------------------
// Kutoa ELF header (64 baiti, moja kwa moja)
// -------------------------------------------------------
w0 andika_elf_kichwa(n32 shoff, n32 shnum, n32 shstrndx) {
    andika_baiti_moja_kwa_moja(127); andika_baiti_moja_kwa_moja(69);
    andika_baiti_moja_kwa_moja(76); andika_baiti_moja_kwa_moja(70);
    andika_baiti_moja_kwa_moja(2);
    andika_baiti_moja_kwa_moja(1);
    andika_baiti_moja_kwa_moja(1);
    andika_baiti_moja_kwa_moja(0);
    andika_neno8_moja_kwa_moja(0, 0);
    andika_neno2_moja_kwa_moja(1);
    andika_neno2_moja_kwa_moja(62);
    andika_neno4_moja_kwa_moja(1);
    andika_neno8_moja_kwa_moja(0, 0);
    andika_neno8_moja_kwa_moja(0, 0);
    andika_neno8_moja_kwa_moja(shoff, 0);
    andika_neno4_moja_kwa_moja(0);
    andika_neno2_moja_kwa_moja(64);
    andika_neno2_moja_kwa_moja(0);
    andika_neno2_moja_kwa_moja(0);
    andika_neno2_moja_kwa_moja(64);
    andika_neno2_moja_kwa_moja(shnum);
    andika_neno2_moja_kwa_moja(shstrndx);
}

// -------------------------------------------------------
// Kutoa sehemu za ELF (moja kwa moja)
// -------------------------------------------------------
w0 andika_shstrtab() {
    // \0 .text \0 .data \0 .bss \0 .symtab \0 .strtab \0 .rela.text \0 .shstrtab \0
    andika_baiti_moja_kwa_moja(0);
    // .text (offset=1)
    andika_baiti_moja_kwa_moja(46); andika_baiti_moja_kwa_moja(116);
    andika_baiti_moja_kwa_moja(101); andika_baiti_moja_kwa_moja(120);
    andika_baiti_moja_kwa_moja(116); andika_baiti_moja_kwa_moja(0);
    // .data (offset=7)
    andika_baiti_moja_kwa_moja(46); andika_baiti_moja_kwa_moja(100);
    andika_baiti_moja_kwa_moja(97); andika_baiti_moja_kwa_moja(116);
    andika_baiti_moja_kwa_moja(97); andika_baiti_moja_kwa_moja(0);
    // .bss (offset=13)
    andika_baiti_moja_kwa_moja(46); andika_baiti_moja_kwa_moja(98);
    andika_baiti_moja_kwa_moja(115); andika_baiti_moja_kwa_moja(115);
    andika_baiti_moja_kwa_moja(0);
    // .symtab (offset=18)
    andika_baiti_moja_kwa_moja(46); andika_baiti_moja_kwa_moja(115);
    andika_baiti_moja_kwa_moja(121); andika_baiti_moja_kwa_moja(109);
    andika_baiti_moja_kwa_moja(116); andika_baiti_moja_kwa_moja(97);
    andika_baiti_moja_kwa_moja(98); andika_baiti_moja_kwa_moja(0);
    // .strtab (offset=26)
    andika_baiti_moja_kwa_moja(46); andika_baiti_moja_kwa_moja(115);
    andika_baiti_moja_kwa_moja(116); andika_baiti_moja_kwa_moja(114);
    andika_baiti_moja_kwa_moja(116); andika_baiti_moja_kwa_moja(97);
    andika_baiti_moja_kwa_moja(98); andika_baiti_moja_kwa_moja(0);
    // .rela.text (offset=34)
    andika_baiti_moja_kwa_moja(46); andika_baiti_moja_kwa_moja(114);
    andika_baiti_moja_kwa_moja(101); andika_baiti_moja_kwa_moja(108);
    andika_baiti_moja_kwa_moja(97); andika_baiti_moja_kwa_moja(46);
    andika_baiti_moja_kwa_moja(116); andika_baiti_moja_kwa_moja(101);
    andika_baiti_moja_kwa_moja(120); andika_baiti_moja_kwa_moja(116);
    andika_baiti_moja_kwa_moja(0);
    // .shstrtab (offset=45)
    andika_baiti_moja_kwa_moja(46); andika_baiti_moja_kwa_moja(115);
    andika_baiti_moja_kwa_moja(104); andika_baiti_moja_kwa_moja(115);
    andika_baiti_moja_kwa_moja(116); andika_baiti_moja_kwa_moja(114);
    andika_baiti_moja_kwa_moja(116); andika_baiti_moja_kwa_moja(97);
    andika_baiti_moja_kwa_moja(98); andika_baiti_moja_kwa_moja(0);
}

// -------------------------------------------------------
// Usimamizi wa vigeu vya ndani
// -------------------------------------------------------

n8 kigeu_dimbwi[1024];
n32 kigeu_dimbwi_wapi = 1;
n32 kigeu_jina_ofseti[64];
n32 kigeu_rbp_ofseti[64];  // umbali chanya kutoka rbp (k.m. 4, 8, 12)
n32 kigeu_usimbaji[64];  // usimbaji wa aina kwa upakiaji sahihi wa upana
n32 kigeu_ni_safu[64];  // 1 = safu ya ndani (rejeleo la jina ni LEA, si upakiaji)
n32 kigeu_ukubwa[64];  // baiti zote za kigeu (safu: kipengele x idadi) -- kwa ukubwa(jina)
n32 kigeu_idadi = 0;
n32 kigeu_rafu_idadi = 0;  // jumla ya baiti za vigeu kwenye rafu
n32 frame_imeshinda = 0;  // 1 kama rafu ilianzishwa
n32 sub_rsp_nafasi = 0;  // nafasi ya thamani katika sub rsp kwa ajili ya kurekebisha

n8* kazi_ya_sasa_jina = 0;  // jina la kazi inayozalishwa sasa -- kwa ujumbe wa makosa
n32 mm_inafanya = 0;  // 1 ikiwa kazi ya sasa inarudisha muundo
n32 mm_ofseti = 0;  // ofseti ya rbp kwa kielekezi cha sret
n32 mm_bafa_ofseti = 0;  // ofseti ya rbp kwa bafa ya muda ya sret (upande wa mpigaji)
n32 mm_bafa_upeo = 0;  // ukubwa mkubwa wa muundo uliotengwa kwa sret buf

// Muundo mkubwa (>8B) kama hoja kwa thamani hupitishwa KWA REJEA:
// mpigaji ananakili muundo kwenye bafa yake ya wito na kusukuma
// kielekezi; mpokeaji anapakia kielekezi kutoka kwenye sloti.
n32 kigeu_kwa_rejea[64];  // 1 = paramu ya muundo inayopitishwa kwa rejea
n32 wito_bafa_ofseti = 0;  // ofseti ya rbp kwa bafa ya nakala za miundo ya wito
n32 wito_bafa_upeo = 0;  // ukubwa wa bafa (uliokokotolewa na kipitishi awali)
n32 wito_bafa_haja = 0;  // juu ya haja ya nakala kwenye wito wa sasa (wakati wa kipitishi)
n32 wito_mm_haja = 0;  // 1 ikiwa kazi ya sasa inaita kazi inayorudisha muundo
// Bafa ya sret-hoja: matokeo ya wito unaorudisha muundo (sret) kama
// hoja ya wito mwingine hunakiliwa MARA MOJA hapa — bafa ya sret ya
// pamoja inaweza kuandikwa tena na wito unaofuata wa hoja nyingine
// (halaiki: tofauti(tengeneza(2), tengeneza(5))). Kina kimoja cha
// hoja_undani kinatumia sehemu yake ya bafa (mapande 8).
n32 mm_hoja_bafa_ofseti = 0;  // ofseti ya rbp kwa bafa ya nakala za sret-hoja
n32 mm_hoja_bafa_upeo = 0;  // ukubwa wa bafa (uliokokotolewa na kipitishi awali)
n32 mm_hoja_haja = 0;  // juu ya haja ya nakala za sret-hoja (wakati wa kipitishi)
n32 uzalishaji_mzizi = 0;  // mzizi wa AST (kwa utafutaji wa kazi za ndani)

// -------------------------------------------------------
// Ugawaji wa rejesta (register allocation), awamu ya 1
//
// rbx, r12, r13, r14, r15 (callee-saved kwenye System V ABI) hazitumiwi
// KABISA na uzalishaji wa msimbo hapo awali -- kila thamani, hata ile
// inayotumika mara kadhaa mfululizo, huandikwa kwenye rafu ([rbp-off])
// kisha kupakiwa tena, hata kama hakuna wito wa kazi kati ya matumizi
// mawili. Hii ni sababu kuu ya Swa kuwa 3.7x-17.6x polepole kuliko C
// kwenye vipimo vya haraka vilivyofanywa kikao hiki.
//
// Wigo wa awamu hii (KWA MAKUSUDI mdogo, kuepuka hatari ya kuharibu
// msimbo sahihi): VIGEZO VYA NDANI (tangazo la ndani ya mwili wa kazi)
// PEKEE -- si vigezo vya paramu -- vinavyokidhi YOTE yafuatayo
// vinaweza kuishi kwenye rejesta badala ya rafu:
//   1. Aina kamili ya nambari isiyo kielekezi (n8/n16/n32/n64) --
//      SI d32/d64 (rejesta za xmm ni suala tofauti kabisa), SI
//      kielekezi cha aina yoyote (kuepuka utata wa vigezo
//      vinavyotumika kama msingi wa .sehemu/->sehemu -- angalia
//      maelezo kwenye eligibility check), SI muundo, SI safu.
//   2. Anwani yake haichukuliwi KAMWE ndani ya kazi (&kigezo) --
//      rejesta haina anwani, hivyo &kigezo cha rejesta haiwezekani
//      kuwakilishwa kwa usahihi. Kigezo chochote chenye &kigezo
//      popote ndani ya kazi KINABAKI KWENYE RAFU (kama ilivyokuwa).
//
// Rejesta 5 zinapatikana; kigezo cha 6+ kinachokidhi masharti
// kinabaki kwenye rafu (hakuna spilling -- ni kigezo cha 1-5 cha
// KWANZA kilichotangazwa (kwa mpangilio wa AST) TU kinachopewa
// rejesta).
//
// TANBIHI MUHIMU: uteuzi wa mgombea (tambua_tangazo_pass) na
// ugunduzi wa &kigezo (tambua_anwani_pass) ni PITIO MBILI KAMILI
// ZA PEKEE (SI ndani ya kusanya_vigeu_vya_ndani iliyopo) -- kwa
// makusudi, ili kuepuka kugusa kabisa mantiki nyeti iliyopo tayari
// ya kusanya_vigeu_vya_ndani (ukubwa wa rafu, sret, bafa za wito).
// Pia: kwa kufanya PITIO MBILI kamili (kwanza kusanya majina yote ya
// mgombea, KISHA kutafuta & kwa majina hayo), tunaepuka hitilafu ya
// mpangilio -- &x inayotokea KABLA ya x kutangazwa kwenye mpangilio
// wa AST (usiowezekana kwa lugha hii, lakini si lazima ufanane na
// mpangilio wa maandishi ya chanzo) bado inagunduliwa kwa usahihi.
n32 REGISTA_HALISI_0 = 3;   // rbx
n32 REGISTA_HALISI_1 = 12;  // r12
n32 REGISTA_HALISI_2 = 13;  // r13
n32 REGISTA_HALISI_3 = 14;  // r14
n32 REGISTA_HALISI_4 = 15;  // r15

n32 regista_halisi_kwa_id(n32 id) {
    kama (id == 0) { rudisha REGISTA_HALISI_0; }
    kama (id == 1) { rudisha REGISTA_HALISI_1; }
    kama (id == 2) { rudisha REGISTA_HALISI_2; }
    kama (id == 3) { rudisha REGISTA_HALISI_3; }
    rudisha REGISTA_HALISI_4;
}

// -1 = kigezo hiki kiko kwenye rafu (tabia ya asili); 0-4 = faharisi
// ya rejesta (angalia regista_halisi_kwa_id).
n32 kigeu_reg[64];

// Majina ya wagombea (kutoka tambua_tangazo_pass), na alama ya
// "haramu" (anwani imechukuliwa mahali fulani -- tambua_anwani_pass).
n8* rega_kandida_jina[16];
n32 rega_kandida_haramu[16];
n32 rega_kandida_idadi = 0;

// Rejesta ngapi zinatumika kwenye KAZI YA SASA (0-5) -- huamua ni
// ngapi zinasukumwa (push) kwenye utangulizi na kutolewa (pop) kwenye
// kila mahali pa kutoka (rudisha na mwisho wa kazi).
n32 rega_tumika_idadi = 0;

// push/pop reg64 kwa nambari HALISI ya rejesta ya x86-64 (0-15).
// push reg: [REX.B kama reg>=8] + (0x50 + (reg & 7))
// pop reg:  [REX.B kama reg>=8] + (0x58 + (reg & 7))
w0 andika_push_reg64(n32 reg) {
    kama (reg >= 8) { andika_baiti(65); }
    andika_baiti(80 + (reg - ((reg / 8) * 8)));
}
w0 andika_pop_reg64(n32 reg) {
    kama (reg >= 8) { andika_baiti(65); }
    andika_baiti(88 + (reg - ((reg / 8) * 8)));
}

// mov rax, <reg-halisi> -- pakia thamani NZIMA ya rejesta ya kudumu
// hadi rax (baiti 8 zote, kwa sababu andishi la kigezo kwenye
// rejesta huhifadhiwa KIKAMILIFU kilichopanuliwa tayari -- angalia
// sawazisha_eax_kwa_enc).
// REX = 0x48 | (0x04 kama reg>=8, REX.R kwa uwanja wa reg) | 0
// ModRM = 0xC0 | ((reg&7)<<3) | 0(rax kama rm)
w0 andika_mov_rax_reg64(n32 reg) {
    n32 rexr = 0;
    kama (reg >= 8) { rexr = 4; }
    andika_baiti(72 + rexr);
    andika_baiti(137);
    n32 reg7 = reg - ((reg / 8) * 8);
    andika_baiti(192 + (reg7 * 8));
}

// mov <reg-halisi>, rax -- hifadhi rax NZIMA (baiti 8) kwenye rejesta
// ya kudumu. Piga sawazisha_eax_kwa_enc KWANZA kama upana wa aina ni
// mdogo kuliko baiti 8, la sivyo baiti za juu za rejesta zitabaki na
// takataka kutoka hesabu iliyopita.
// REX = 0x48 | 0 | (0x01 kama reg>=8, REX.B kwa uwanja wa rm)
// ModRM = 0xC0 | (0<<3, rax kama reg) | (reg&7)
w0 andika_mov_reg64_rax(n32 reg) {
    n32 rexb = 0;
    kama (reg >= 8) { rexb = 1; }
    andika_baiti(72 + rexb);
    andika_baiti(137);
    n32 reg7 = reg - ((reg / 8) * 8);
    andika_baiti(192 + reg7);
}

// mov rcx, <reg-halisi> -- pakia thamani NZIMA ya rejesta ya kudumu
// hadi rcx (sawa na andika_mov_rax_reg64, ila rcx (001) badala ya
// rax (000) kama uwanja wa rm) -- inatumiwa na ugawaji wa rejesta wa
// vigezo vya muda vya usemi (Sethi-Ullman, angalia su_zalisha_ndani)
// kuleta thamani iliyoshikiliwa kwenye rejesta ya kudumu bila
// kuchafua rax, ambayo tayari ina upande mwingine wa operesheni.
// REX = 0x48 | (0x04 kama reg>=8, REX.R kwa uwanja wa reg) | 0
// ModRM = 0xC1 | ((reg&7)<<3) | 1(rcx kama rm)
w0 andika_mov_rcx_reg64(n32 reg) {
    n32 rexr = 0;
    kama (reg >= 8) { rexr = 4; }
    andika_baiti(72 + rexr);
    andika_baiti(137);
    n32 reg7 = reg - ((reg / 8) * 8);
    andika_baiti(193 + (reg7 * 8));
}

// Kabla ya kuandika thamani (eax/rax) ndani ya rejesta ya kudumu,
// LAZIMA ipanuliwe kwa usahihi (movzx/movsx) kwa upana wa aina yake
// -- vinginevyo usomaji baadaye (unaonakili REJESTA NZIMA hadi rax
// moja kwa moja, angalia andika_mov_rax_reg64) ungerudisha baiti za
// juu zisizo sahihi kwa aina ndogo (n8/n16). Hii ni sawa kabisa na
// kanuni inayotumika kwenye upakiaji wa kumbukumbu (angalia
// andika_mov_ax_na_rbp_off) -- ila hapa tunaipanua REJESTA-KWA-REJESTA
// badala ya KUMBUKUMBU-KWA-REJESTA.
w0 sawazisha_eax_kwa_usimbaji(n32 usimbaji) {
    n32 uk = ukubwa_kutoka_usimbaji(usimbaji);
    kama (uk == 1) {
        kama (ni_bila_ishara_usimbaji(usimbaji)) { andika_movzx_eax_al(); }
        sivyo { andika_movsx_eax_al(); }
    } sivyo { kama (uk == 2) {
            kama (ni_bila_ishara_usimbaji(usimbaji)) { andika_movzx_eax_ax16(); }
            sivyo { andika_movsx_eax_ax16(); }
        } }
    // uk>=4: eax tayari ni sahihi -- "mov eax,..." hupanua kwa sifuri
    // hadi rax kiotomatiki (ABI ya x86-64), na uk==8 hutumia rax yote
    // moja kwa moja tayari.
}

// Je, enc hii ni mgombea salama wa kudumu kwenye rejesta? PEKEE
// n8/n16/n32/n64 ISIYO KIELEKEZI -- angalia maelezo kamili hapo juu
// kwa sababu ya kuzuia vielekezi (hata vya aina za msingi): enc chanya
// ina upana%4==0 kwa n8/n16/n32/n64 zote (8,16,32,64 -- zote ni
// tarakimu za 4), hivyo enc%4 inatoa BITI ZA MSHALE KWA USAHIHI bila
// utata -- enc%4 != 0 inamaanisha ni kielekezi (mfano n32* ina
// enc=289, 289%4=1). Hii inaepuka kabisa haja ya kufuatilia matumizi
// ya kigezo kama msingi wa .sehemu/->sehemu (ambayo hutumia njia
// TOFAUTI KABISA za var_rbp_off[i] -- angalia uzalishaji_sehemu_dot
// na wenzake -- ambazo hazijafikiwa na rekebisho hili KWA MAKUSUDI).
n32 ni_mgombea_rejista(n32 usimbaji) {
    kama (usimbaji <= 0) { rudisha 0; }
    kama (ni_desimali_usimbaji(usimbaji)) { rudisha 0; }
    kama (ni_muundo_usimbaji(usimbaji)) { rudisha 0; }
    kama ((usimbaji - ((usimbaji / 4) * 4)) != 0) { rudisha 0; }  // enc % 4 != 0 -> kielekezi
    rudisha 1;
}

// PITIO 1/2: kusanya majina ya WAGOMBEA WOTE (tangazo la ndani,
// scalar, isiyo kielekezi/desimali/muundo/safu) kwenye mwili wa kazi.
// Muundo wa utembeaji ni NAKALA HALISI ya kusanya_vigeu_vya_ndani
// (angalia maelezo yake kwa sababu ya kila ubaguzi wa ruka_tiga/
// ruka_nne) -- LAZIMA ifanane kabisa, la sivyo tungeweza kufikia
// thamani isiyo nodi ya AST (mfano ofseti ya sehemu iliyohifadhiwa
// kwenye ast_tiga/ast_nne kwa aina fulani za nodi) kama node_id,
// tukisababisha usomaji nje ya mipaka.
w0 tambua_tangazo_pass(n32 nodi) {
    kama (nodi < 0) { rudisha; }
    kama (nodi >= 1048576) { rudisha; }
    kama (kvn_imetembelewa[nodi] == kvn_kizazi) { rudisha; }
    kvn_imetembelewa[nodi] = kvn_kizazi;
    n32 aina = mti_aina[nodi];

    kama (aina == 50) {  // AST_BLOCK
        tambua_tangazo_pass(mti_kushoto[nodi]);
        tambua_tangazo_pass(mti_nne[nodi]);
        rudisha;
    }

    kama (aina == 11) {  // AST_TANGAZO
        n32 kigeu_nodi = mti_kushoto[nodi];
        n32 usimbaji = mti_thamani[kigeu_nodi];
        kama (usimbaji == 0) { usimbaji = mti_thamani[nodi]; }
        n32 ni_safu = 0;
        kama (mti_tiga[nodi] > 0) { ni_safu = 1; }
        kama (ni_safu == 0 && ni_mgombea_rejista(usimbaji)) {
            kama (rega_kandida_idadi < 16) {
                n8* jina = mti_dimbwi + mti_jina_ofseti[kigeu_nodi];
                rega_kandida_jina[rega_kandida_idadi] = jina;
                rega_kandida_haramu[rega_kandida_idadi] = 0;
                rega_kandida_idadi = rega_kandida_idadi + 1;
            }
        }
        tambua_tangazo_pass(mti_kulia[nodi]);
        tambua_tangazo_pass(mti_nne[nodi]);
        rudisha;
    }

    kama (aina == 4) { rudisha; }  // NAMBARI -- si nodi halisi kwenye tiga/nne

    tambua_tangazo_pass(mti_kushoto[nodi]);
    tambua_tangazo_pass(mti_kulia[nodi]);
    n32 ruka_tiga = 0;
    kama (aina >= 6) { kama (aina <= 25) { ruka_tiga = 1; } }
    kama (aina >= 31) { kama (aina <= 32) { ruka_tiga = 1; } }
    kama (aina >= 39) { kama (aina <= 43) { ruka_tiga = 1; } }
    kama (aina == 49) { ruka_tiga = 1; }
    kama (aina == 29) { ruka_tiga = 1; }
    kama (aina == 5) { ruka_tiga = 1; }
    kama (aina == 33 || aina == 34 || aina == 35 || aina == 44) { ruka_tiga = 1; }
    kama (ruka_tiga == 0) { tambua_tangazo_pass(mti_tiga[nodi]); }
    n32 ruka_nne = 0;
    kama (aina == 33 || aina == 34) { ruka_nne = 1; }
    kama (aina == 45) { ruka_nne = 1; }
    kama (aina == 4) { ruka_nne = 1; }
    kama (ruka_nne == 0) { tambua_tangazo_pass(mti_nne[nodi]); }
    kama (aina == 15) {
        n32 tv = mti_thamani[nodi];
        kama (tv != -1) { kama (tv != 0) { tambua_tangazo_pass(tv); } }
    }
}

// PITIO 2/2: tafuta &kigezo (AST_KUMBUKA, aina==30) kwa jina lolote
// lililo kwenye orodha ya wagombea, na uweke alama ya "haramu" --
// muundo wa utembeaji NI SAWA na tambua_tangazo_pass (na
// kusanya_vigeu_vya_ndani).
w0 tambua_anwani_pass(n32 nodi) {
    kama (nodi < 0) { rudisha; }
    kama (nodi >= 1048576) { rudisha; }
    kama (kvn_imetembelewa[nodi] == kvn_kizazi) { rudisha; }
    kvn_imetembelewa[nodi] = kvn_kizazi;
    n32 aina = mti_aina[nodi];

    kama (aina == 30) {  // AST_KUMBUKA -- &usemi
        n32 hoja = mti_kushoto[nodi];
        kama (hoja != -1 && mti_aina[hoja] == 5) {
            n8* opjina = mti_dimbwi + mti_jina_ofseti[hoja];
            n32 ci = 0;
            wakati (ci < rega_kandida_idadi) {
                kama (jina_linganisha(rega_kandida_jina[ci], opjina)) {
                    rega_kandida_haramu[ci] = 1;
                }
                ci = ci + 1;
            }
        }
    }

    kama (aina == 50) {
        tambua_anwani_pass(mti_kushoto[nodi]);
        tambua_anwani_pass(mti_nne[nodi]);
        rudisha;
    }
    kama (aina == 11) {
        tambua_anwani_pass(mti_kulia[nodi]);
        tambua_anwani_pass(mti_nne[nodi]);
        rudisha;
    }
    kama (aina == 4) { rudisha; }

    // MUHIMU (mdudu HALISI uliogunduliwa kwa jaribio, si dhana):
    // AST_WITO (8) hutumia ast_tiga KWENYE KILA NODI YA HOJA kama
    // KIUNGO CHA HOJA INAYOFUATA -- SI maana ya kawaida ya aina ya
    // hiyo nodi (mfano kwa KITAMBULISHO/aina==5, ast_tiga kawaida ni
    // "ofseti za sehemu au -1", lakini nafasi ya hoja inaipa maana
    // TOFAUTI KABISA). Ukaguzi wa ruka_tiga hapa chini ni SAHIHI kwa
    // nodi katika muktadha wa KAWAIDA (SI nafasi ya hoja) -- ukitumika
    // moja kwa moja kwenye nodi ya kwanza ya hoja (kupitia ast_kulia
    // hapo chini), ungezuia (ruka_tiga) mnyororo wa hoja zilizosalia
    // kila wakati hoja ya kwanza ikiwa ni aina iliyo kwenye orodha ya
    // ruka_tiga (KITAMBULISHO, hesabu, n.k. -- karibu KILA hoja halisi)
    // -- hivyo &kigezo kilichopitishwa kama hoja ya PILI (au zaidi)
    // KAMWE kisingegunduliwa, na kigezo hicho kingekuwa mgombea WA
    // UONGO wa rejesta, kikisababisha uharibifu wa kimya wa data
    // (iligunduliwa: andika_herufi(faili, b) -- &bb ni hoja ya PILI
    // ya sys_andika, bb ilipewa rejesta kimakosa, ikaandika baiti za
    // takataka badala ya herufi halisi).
    kama (aina == 8) {
        tambua_anwani_pass(mti_kushoto[nodi]);  // callee (kwa wito usio wa moja kwa moja, nadra)
        n32 a_w = mti_kulia[nodi];
        wakati (a_w != -1) {
            n32 a_w_ijayo = mti_tiga[a_w];  // hifadhi kiungo KABLA ya kujirudia
            kama (a_w >= 0 && a_w < 1048576 && mti_aina[a_w] == 30) {
                // &hoja moja kwa moja: shughulikia HAPA moja kwa moja
                // (SI kwa kuiita tambua_anwani_pass(a_w) upya -- aina==30
                // haiko kwenye orodha ya ruka_tiga, hivyo ingejaribu
                // kufuata ast_tiga[a_w] kama mtoto wa kawaida badala ya
                // kiungo cha hoja inayofuata, ikichanganya mnyororo).
                kama (kvn_imetembelewa[a_w] != kvn_kizazi) {
                    kvn_imetembelewa[a_w] = kvn_kizazi;
                    n32 hoja = mti_kushoto[a_w];
                    kama (hoja != -1 && mti_aina[hoja] == 5) {
                        n8* opjina2 = mti_dimbwi + mti_jina_ofseti[hoja];
                        n32 ci2 = 0;
                        wakati (ci2 < rega_kandida_idadi) {
                            kama (jina_linganisha(rega_kandida_jina[ci2], opjina2)) {
                                rega_kandida_haramu[ci2] = 1;
                            }
                            ci2 = ci2 + 1;
                        }
                    }
                }
            } sivyo {
                // Aina nyingine yoyote (KITAMBULISHO, hesabu, wito
                // uliopachikwa, ternary, n.k.) -- ZOTE tayari ziko
                // kwenye orodha ya ruka_tiga/ruka_nne (isipokuwa 30),
                // kwa hiyo kuita tambua_anwani_pass(a_w) moja kwa moja
                // ni SALAMA: itaruka ast_tiga[a_w] chake yenyewe (kiungo
                // cha hoja, kinachoshughulikiwa na kitanzi hiki), lakini
                // itatembelea watoto wake halisi (kushoto/kulia/nne
                // inavyofaa) kwa usahihi -- ikiwemo wito uliopachikwa
                // (utaingia tena tawi hili la aina==8 kwa mnyororo wake
                // mwenyewe wa hoja).
                tambua_anwani_pass(a_w);
            }
            a_w = a_w_ijayo;
        }
        // MUHIMU (mdudu WA PILI HALISI uliogunduliwa, si dhana): AST_WITO
        // haiko kwenye orodha ya ruka_nne, hivyo ast_nne[node] (taarifa
        // INAYOFUATA kwenye mnyororo wa block, WAKATI wito huu ni taarifa
        // yenyewe -- si ndani ya usemi mkubwa zaidi) LAZIMA itembelewe --
        // `rudisha;` ya moja kwa moja hapa (bila hii) ilikatiza kabisa
        // utembeaji WOTE baada ya TAARIFA YOYOTE ya wito wa peke yake
        // (mfano "piga_kazi(x, y);" pekee, si sehemu ya kama/ugawaji),
        // ikisababisha vigezo vyote vilivyotangazwa BAADAYE kwenye block
        // hiyo hiyo kuachwa bila kuchunguzwa kabisa na tambua_anwani_pass
        // (ingawa VYAKUCHUNGUZWA na tambua_tangazo_pass, ambayo haina
        // dosari hii -- ikizalisha wagombea "halali" wa uongo ambao &wao
        // haukuwahi kupimwa). Kama node ni ndani ya usemi mkubwa zaidi
        // (si taarifa ya block moja kwa moja), ast_nne[node] ni -1 hapa,
        // na tambua_anwani_pass(-1) ni kitendo tulivu (rudisha ya papo
        // hapo) -- salama bila masharti.
        tambua_anwani_pass(mti_nne[nodi]);
        rudisha;
    }

    tambua_anwani_pass(mti_kushoto[nodi]);
    tambua_anwani_pass(mti_kulia[nodi]);
    n32 ruka_tiga = 0;
    kama (aina >= 6) { kama (aina <= 25) { ruka_tiga = 1; } }
    kama (aina >= 31) { kama (aina <= 32) { ruka_tiga = 1; } }
    kama (aina >= 39) { kama (aina <= 43) { ruka_tiga = 1; } }
    kama (aina == 49) { ruka_tiga = 1; }
    kama (aina == 29) { ruka_tiga = 1; }
    kama (aina == 5) { ruka_tiga = 1; }
    kama (aina == 33 || aina == 34 || aina == 35 || aina == 44) { ruka_tiga = 1; }
    kama (ruka_tiga == 0) { tambua_anwani_pass(mti_tiga[nodi]); }
    n32 ruka_nne = 0;
    kama (aina == 33 || aina == 34) { ruka_nne = 1; }
    kama (aina == 45) { ruka_nne = 1; }
    kama (aina == 4) { ruka_nne = 1; }
    kama (ruka_nne == 0) { tambua_anwani_pass(mti_nne[nodi]); }
    kama (aina == 15) {
        n32 tv = mti_thamani[nodi];
        kama (tv != -1) { kama (tv != 0) { tambua_anwani_pass(tv); } }
    }
}

// Baada ya pitio zote mbili kukamilika: gawa rejesta 0-4 kwa
// wagombea 5 wa KWANZA (mpangilio wa AST) wasio na alama ya haramu.
w0 finalisha_ugawaji_rejista() {
    rega_tumika_idadi = 0;
    n32 ci = 0;
    wakati (ci < rega_kandida_idadi) {
        kama (rega_kandida_haramu[ci] == 0 && rega_tumika_idadi < 5) {
            n32 vi = 0;
            wakati (vi < kigeu_idadi) {
                kama (jina_linganisha(kigeu_dimbwi + kigeu_jina_ofseti[vi], rega_kandida_jina[ci])) {
                    kigeu_reg[vi] = rega_tumika_idadi;
                    rega_tumika_idadi = rega_tumika_idadi + 1;
                    vunja;
                }
                vi = vi + 1;
            }
        }
        ci = ci + 1;
    }
}

// -------------------------------------------------------
// Usimamizi wa alama za nje (kazi za maktaba kama printf)
// -------------------------------------------------------

n8 nje_dimbwi[32768];
n32 nje_dimbwi_wapi = 1;
n32 nje_jina_ofseti[2048];
n32 nje_idadi = 0;

// -------------------------------------------------------
// Marekebisho ya uhusianisho (relocations) kwa .rela.text
// -------------------------------------------------------

n32 rela_text_ofseti[65536];  // nafasi katika bafa_text inayohitaji kurekebishwa
n32 rela_nje_id[65536];  // faharisi ya alama ya nje
n32 rela_ulimwengu_faharasa[65536];  // kwa ajili ya vigezo vya ulimwengu (>0 = ulimwengu)
n32 rela_idadi = 0;

// -------------------------------------------------------
// Herufi halisi (string literals) zilizokusanywa
// -------------------------------------------------------

// lugha-swa/swa#295 -- ukubwa wa ZAMANI (str_off/str_len/str_lebo_id[1024],
// str_buf[16384]) ulikuwa mdogo mno kwa miradi mikubwa: mradi halisi
// (Dominion's mchezo.swa, ~1136 kazi) hufikia zaidi ya herufi halisi
// 1024 za KIPEKEE kwa urahisi. Kulikuwa na ukaguzi wa kufurika
// uliopo tayari (kusanya_herufi chini) LAKINI ulichapisha KOSA
// kisha UKAENDELEA kimya (hakuna exit) -- kurudisha -1 bila
// kusimamisha ukusanyaji. -1 hiyo ilipofika uzalishaji_kitambulisho,
// LEA ya anwani ya mfuatano ILIRUKWA KABISA (hakuna agizo
// lililotolewa), ikiacha rejesta (rax) na THAMANI YA ZAMANI isiyo
// husiana (k.m. anwani ya mfuatano mwingine uliopita tayari) --
// hii ndiyo "anwani za string literal zinazochanganyikiwa" za #295.
// Suluhisho: (1) ongeza ukubwa (mara 64 kwa idadi, mara 64 kwa
// bafa) kutoa nafasi ya kutosha, NA (2) badilisha ukaguzi wa
// kufurika kusimamisha ukusanyaji (exit 1) badala ya kuendelea --
// angalia kusanya_herufi() chini.
n8 mfuatano_bafa[1048576];
n32 mfuatano_ofseti[65536];
n32 mfuatano_urefu[65536];
n32 mfuatano_bafa_wapi = 1;
n32 mfuatano_idadi = 0;
n32 mfuatano_lebo_id[65536];

// Constants za desimali halisi (d64) — ofseti ya dimbwi (baiti 8) kwa kila moja.
// MUHIMU (lugha-swa/swa#192): kikomo hiki NI CHA KILA TOKEO (occurrence),
// SI cha thamani za KIPEKEE (distinct values) -- hakuna deduplication
// kabisa: kila mara herufi ya d64 (mfano 0.5) inapotokea popote kwenye
// chanzo, hifadhi mpya huundwa, hata kama thamani ile ile tayari
// ipo. Mradi halisi wenye faili nyingi za husisha na hesabu nyingi za
// d64 (mfano moduli za utawala/uchumi za Dominion) hufikia kikomo cha
// 1024 kwa URAHISI. Kikomo kikifikiwa, desimali_halisi_hifadhi
// hurudisha -1 KIMYA (bila ujumbe wa hitilafu, tofauti na jedwali
// dada kwenye faili hili) -- -1 hupitishwa kama lebo_id kwenye
// weka_fixup, ikiandika kiingilio cha fixup kisichoweza KUFAFANULIWA
// kamwe (hakuna lebo halisi ni -1), kwa hiyo displacement ya
// rip-relative ya `movsd xmm0,[rip+disp32]` YA HERUFI HIYO HUBAKI 0
// (thamani ya muda) MILELE -- ikisoma baiti za maagizo yanayofuata
// kama nambari, kimya kimya, bila hitilafu ya kukusanya wala
// kuanguka. Hii ilisababisha uharibifu wa "kimya" wa thamani
// zilizosomwa kutoka kwa usemi kama `g->utulivu == 0.6` kwenye
// mradi halisi (angalia jaribio dogo kamili kwenye issue #192).
n32 desimali_ofseti[65536];
n32 desimali_lebo_id[65536];
n32 desimali_idadi = 0;

// Sehemu za tungo za builtin ya andika — zinaandikwa mwishoni mwa .text
// kama tungo, ili JIT iweze kuzifikia kwa rip-relative.
//
// UKUBWA (lugha-swa/swa#232): bafa hii inahifadhi sehemu za maandishi
// halisi za KILA wito wa andika/andika_stderr katika UKUSANYAJI MZIMA
// (imewekwa upya mara MOJA tu, kwenye uzalishaji_kuu/uzalishaji_jit —
// angalia chini ya faili hili). Ilikuwa 4096 baiti / sehemu 1024, na
// sehemu_tungo_hifadhi() ilipofurika ilirudisha -1 KIMYA (tovuti za
// wito zinaziruka sehemu bila onyo lolote wakati lebo < 0). Kwa
// programu ndogo hii haikuwahi kufikiwa, lakini kukusanya mkusanyaji
// huu MWENYEWE (zima.swa, mamia ya wito wa andika_stderr wenye
// maandishi ya makosa marefu katika msambazaji.swa, mkaguzi.swa,
// uzalishaji.swa, stage1.swa n.k.) hufikia na kupita kikomo hicho
// kwa urahisi. Matokeo: sehemu za maandishi (hasa zile zinazotokea
// BAADAYE katika mpangilio wa ukusanyaji, kama ujumbe wa makosa wa
// stage1.swa mwenyewe) hupotea kimya, na kubaki tu ubadilishaji wa
// %s -- dalili halisi ya #232 (jenerali-2 ya kujiendeleza hupoteza
// maandishi yanayozunguka %s). Kumbuka mbegu.bin (mzalishaji wa
// jenerali-1) ni mkusanyaji wa kwanza tofauti kabisa, ulioandikwa kwa
// mkono, hautumii bafa hii -- ndiyo maana jenerali-1 daima ni sahihi
// na mdudu huu haugundulikani hadi jenerali-2 (mkusanyaji
// aliyekusanywa NA mkusanyaji huu huu) atakapojaribiwa. Kikomo
// kimeongezwa mara nyingi (16x baiti, 8x idadi ya sehemu) ili kubaki
// salama hata mkusanyaji ukikua zaidi; kufurika sasa pia kunaandika
// onyo kwenye stderr badala ya kunyamaza.
//
// SASISHO (lugha-swa/swa#298): ONYO-kisha-kuendelea bado ni darasa
// lile lile la mdudu lililoonekana mara kwa mara kwenye mradi huu
// (#189/#197/#199/#200/#232/#292/#295) -- kuendelea kuepuka onyo
// pekee KUNAACHA maandishi yakipotea kimya kwenye programu
// iliyozalishwa (executable bado inatoka safi, matokeo yake tu
// yakiwa na sehemu za maandishi zilizokosekana). Ukubwa umeongezwa
// zaidi (16x baiti, 8x idadi) na ukaguzi sasa unasimamisha
// ukusanyaji badala ya kuendelea.
n8 sehemu_bafa[1048576];
n32 sehemu_ofseti[65536];
n32 sehemu_urefu[65536];
n32 sehemu_lebo_id[65536];
n32 sehemu_idadi = 0;
n32 sehemu_bafa_wapi = 1;

// -------------------------------------------------------
// Bafa za muda kwa ajili ya hoja za wito
// -------------------------------------------------------

n32 hoja_nodi[32];
n32 hoja_usimbaji[32];
n32 hoja_idadi = 0;
// Meza za paramu za kazi inayotolewa (uzalishaji_kazi) — za kimataifa
// kwa sababu hoja za rafu (7+) pia zinahitaji kusajiliwa.
n32 kigezo_ofseti[16];
n32 kigezo_usimbaji[16];
// Chelezo: wito wa ndani (hoja yenyewe ikiwa wito) hufuta meza ya hoja
// ya wito wa nje wakati wa tathmini — nakili kwenye bafa hizi kwanza.
// Kina kinatoa nafasi kwa viwango 8 vya wito vilivyopachikwa.
n32 hoja_undani = 0;
n32 ni_mfumo_wito = 0;
n32 ni_tekeleza_wito = 0;
n32 ni_andika_nje = 0;
n32 hoja_nodi_bk[256];
n32 hoja_usimbaji_bk[256];
n32 hoja_muundo_bk[256];  // ukubwa wa muundo mkubwa (>8B) kwenye hoja au 0

// -------------------------------------------------------
// Ofseti za majina ya nje kwenye strtab
// -------------------------------------------------------

n32 strtab_nje_ofseti[2048];

// -------------------------------------------------------
// Anwani za kazi (&jina_la_kazi) — marekebisho ya mwishoni
// -------------------------------------------------------
// &jina_la_kazi linatoa lea rax, [rip + disp32] na disp32 (sifuri kwa
// muda) likaandikishwa hapa. Lebo zote za kazi zinajulikana mwishoni
// mwa kukusanya (baada ya kazi zote kutolewa) — rekebisha_anwani_za_kazi
// hukokotoa disp32 = nafasi_ya_lebo - (nafasi + 4). Rip-relatif ya
// ndani ya bafa inafanya kazi kwa hali zote (exe, .o na JIT) kwa
// sababu marejeo na lengwa ziko kwenye bafa moja (zinasogea pamoja).
// lugha-swa/swa#298 -- ukubwa umeongezwa (512->8192, mara 16): kila
// tokeo la &jina_la_kazi (mfano kuhifadhi kielekezi cha kazi kwenye
// jedwali la event-dispatch, muundo unaotumika sana kwenye Dominion)
// huongeza hesabu hii, na miradi mikubwa yenye jedwali mengi ya
// vielekezi vya kazi inaweza kukaribia 512 kwa urahisi zaidi.
n32 anwani_kazi_nafasi[8192];  // nafasi ya disp32 katika bafa_text
n8* anwani_kazi_jina[8192];  // jina la kazi (kielekezi katika ast_pool)
n32 anwani_kazi_idadi = 0;

// Kianzio cha ulimwengu cha anwani ya kazi (&jina_la_kazi) — slot ya
// baiti 8 katika bafa_data (sifuri kwa muda). Rip-relatif haiwezekani
// kwenye .data (sehemu tofauti na .text): rekebisha_anwani_za_data
// huiandikia anwani kamili ya exe (4194424 + nafasi ya lebo) mwishoni
// mwa kukusanya — kwa hiyo hali ya .o haikubaliwi (uchunguzi wa awali).
n32 anwani_data_nafasi[512];  // nafasi ya slot (baiti 8) katika bafa_data
n8* anwani_data_jina[512];  // jina la kazi (kielekezi katika ast_pool)
n32 anwani_data_idadi = 0;

// # Visaidizi vya jina — vilihamishwa kutoka mteremko.swa (iliyofutwa)

n32 jina_urefu(n8* s) {
    n32 n = 0;
    wakati (s[n] != 0) { n = n + 1; }
    rudisha n;
}

// Rekebisha disp32 zote za anwani za kazi (&jina_la_kazi). Huitwa
// mwishoni mwa kukusanya — baada ya kazi ZOTE (na lebo zao) kutolewa,
// kabla ya kuandika sehemu za pato. &jina la kazi lisilojulikana linalia
// kwa sauti, sawa na wito wa kazi isiyofafanuliwa.
w0 rekebisha_anwani_za_kazi() {
    n32 fi = 0;
    wakati (fi < anwani_kazi_idadi) {
        n32 nafasi = kazi_nafasi_kwa_jina(anwani_kazi_jina[fi]);
        kama (nafasi < 0) {
            andika_stderr("Hitilafu: kazi haijafafanuliwa: %s\n", anwani_kazi_jina[fi]);
            wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        }
        andika_disp32_kwenye(bafa_text, anwani_kazi_nafasi[fi], nafasi - (anwani_kazi_nafasi[fi] + 4));
        fi = fi + 1;
    }
}

// Rekebisha kianzio cha ulimwengu cha anwani ya kazi (&jina_la_kazi):
// slot ya bafa_data inapata anwani kamili ya msimbo wa kazi =
// 4194424 (0x400078 — msingi wa .text wa exe, kama RELA za wito wa
// nje katika uzalishaji_exe) + nafasi ya lebo. Hali ya .o haifiki
// hapa (uchunguzi wa awali unaikataa — inahitaji RELA ya kiunganishi).
w0 rekebisha_anwani_za_data() {
    n32 fi = 0;
    wakati (fi < anwani_data_idadi) {
        n32 nafasi = kazi_nafasi_kwa_jina(anwani_data_jina[fi]);
        kama (nafasi < 0) {
            andika_stderr("Hitilafu: kazi haijafafanuliwa: %s\n", anwani_data_jina[fi]);
            wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        }
        n32 thamani = 4194424 + nafasi;
        n32 pi = anwani_data_nafasi[fi];
        n32 bd = 0;
        wakati (bd < 8) {
            bafa_data[pi + bd] = thamani - ((thamani / 256) * 256);
            thamani = thamani / 256;
            bd = bd + 1;
        }
        fi = fi + 1;
    }
}

w0 jina_hifadhi(n8* dimbwi, n32* wapi, n8* jina) {
    n32 i = 0;
    wakati (jina[i] != 0) {
        dimbwi[*wapi + i] = jina[i];
        i = i + 1;
    }
    dimbwi[*wapi + i] = 0;
    *wapi = *wapi + i + 1;
}

// -------------------------------------------------------
// Kokotoa ukubwa wa baiti kutoka kwa usimbaji wa aina
// Umbizo: ((familia << 8) | upana_bits | mshale_bit)
// -------------------------------------------------------
n32 ukubwa_kutoka_usimbaji(n32 usimbaji) {
    kama (usimbaji == 0) { rudisha 4; }  // chaguo-msingi: n32
    // Hesabu ya / na * (mbegu ina hitilafu katika & na >>)
    kama ((usimbaji / 2) * 2 != usimbaji) { rudisha 8; }  // kielekezi → baiti 8 (x86-64)
    // Aina za miundo — encoding hasi ina kianzio cha jina kwenye dimbwi
    kama (usimbaji < 0) {
        n32 name_ofseti = ((-usimbaji) / 2) - 1;
        rudisha ukubwa_wa_muundo_kwa_jina(mti_dimbwi + name_ofseti);
    }
    n32 familia = (usimbaji / 256) % 256;
    n32 upana = usimbaji - (familia * 256);  // upana_bits + biti za mshale (0, 1, au 2)
    // Mshale wa pili ni biti ya 2 — ondoa biti za mshale kabla ya kupima upana
    kama ((upana / 4) * 4 != upana) { rudisha 8; }  // kielekezi cha pili
    kama (familia >= 1 && familia <= 5) { rudisha upana / 8; }
    rudisha 4;  // chaguo-msingi
}

// Ukubwa wa kipengele cha safu kutoka enc ya nodi ya TAJA.
// enc hasi isiyo sawa (-2k+1) ni safu ya miundo (P s[3]) — biti ya
// mshale imebaki kutoka kwa mshale wa safu, na ukubwa_kutoka_enc
// ingeleta 8 (kielekezi) badala ya ukubwa wa muundo. Iondoe hapa
// ili s[1].b na ndugu zake zisiingiliane kimya.
n32 ukubwa_wa_kipengele(n32 usimbaji) {
    n32 saizi = ukubwa_kutoka_usimbaji(usimbaji);
    kama (usimbaji < 0) {
        kama ((usimbaji / 2) * 2 != usimbaji) {
            // lugha-swa/swa#185: enc hasi isiyo sawa inaweza kuwa
            // TYPE* (mshale=1, safu ya miundo iliyopachikwa
            // iliyoporomoka kuwa kielekezi -- "P s[3]", kipengele ni
            // thamani iliyopachikwa) AU TYPE** (mshale=3, safu HALISI
            // ya vielekezi -- "P** vitu", kipengele ni kielekezi cha
            // baiti 8). Tofautisha kwa enc_hasi_ni_mshale_wa_pili.
            kama (usimbaji_hasi_ni_mshale_wa_pili(usimbaji)) {
                saizi = 8;
            } sivyo {
                n32 name_ofseti_1 = ((0 - (usimbaji - 1)) / 2) - 1;
                saizi = ukubwa_wa_muundo_kwa_jina(mti_dimbwi + name_ofseti_1);
            }
        }
    }
    rudisha saizi;
}

// -------------------------------------------------------
// Tafuta au unda kigeu cha ndani kwa jina na usimbaji wa aina
// enc: usimbaji wa aina (kwa upakiaji sahihi wa upana baadaye)
// -------------------------------------------------------
n32 pata_au_unda_kigeu_ukubwa(n8* jina, n32 saizi, n32 usimbaji) {
    n32 i = 0;
    wakati (i < kigeu_idadi) {
        n8* vjina = kigeu_dimbwi + kigeu_jina_ofseti[i];
        kama (jina_linganisha(vjina, jina)) { rudisha i; }
        i = i + 1;
    }
    kama (kigeu_idadi >= 64) {
        // lugha-swa/swa#298 -- hii ilikuwa ikiweka text_imefurika=1
        // kisha KUENDELEA (rudisha 0) -- lakini text_imefurika
        // haikuwahi kusomwa popote (bendera iliyokufa), kwa hiyo
        // ukusanyaji uliendelea kimya na kigezo cha 65+ kilijihesabu
        // kama slot 0, LIKIANDIKA JUU ya kigezo cha kwanza kimya kimya.
        // Sasa inasimamisha ukusanyaji mara moja.
        andika_stderr("KOSA [%s]: vigezo vya ndani vimezidi 64\n", kazi_ya_sasa_jina);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    kama (1 == 1) {
        n32 ofseti = kigeu_dimbwi_wapi;
        jina_hifadhi(kigeu_dimbwi, &kigeu_dimbwi_wapi, jina);
        kigeu_jina_ofseti[kigeu_idadi] = ofseti;
        kigeu_rbp_ofseti[kigeu_idadi] = kigeu_rafu_idadi + saizi;  // umbali kutoka rbp
        kigeu_usimbaji[kigeu_idadi] = usimbaji;  // hifadhi usimbaji kwa upakiaji wa upana
        kigeu_ni_safu[kigeu_idadi] = 0;
        kigeu_ukubwa[kigeu_idadi] = saizi;
        kigeu_rafu_idadi = kigeu_rafu_idadi + saizi;
        kigeu_idadi = kigeu_idadi + 1;
        rudisha kigeu_idadi - 1;
    }
    rudisha -1;
}

// Kisaidizi cha upatani wa nyuma — chaguo-msingi n32 (baiti 4)
n32 pata_au_unda_kigeu(n8* jina) {
    rudisha pata_au_unda_kigeu_ukubwa(jina, 4, 1028);  // 1028 = n32: familia 1, upana 32
}

// -------------------------------------------------------
// Tafuta alama ya nje; unda ikiwa haipo
// -------------------------------------------------------
n32 pata_au_unda_nje(n8* jina) {
    n32 i = 0;
    wakati (i < nje_idadi) {
        n8* njina = nje_dimbwi + nje_jina_ofseti[i];
        kama (jina_linganisha(njina, jina)) { rudisha i; }
        i = i + 1;
    }
    kama (nje_idadi < 2048) {
        n32 ofseti = nje_dimbwi_wapi;
        jina_hifadhi(nje_dimbwi, &nje_dimbwi_wapi, jina);
        nje_jina_ofseti[nje_idadi] = ofseti;
        nje_idadi = nje_idadi + 1;
        rudisha nje_idadi - 1;
    }
    // lugha-swa/swa#298 -- kurudisha -1 kimya kuliacha nje_id batili
    // ikiandikwa kwenye rela_nje_id (angalia andika_baiti_nje) --
    // kiunganishi kingeandika kiingilio cha RELA kinachoelekeza kwenye
    // alama ya nje ISIYOSAHIHI kimya kimya. Sasa inasimamisha.
    andika_stderr("KOSA: jedwali la alama za nje (nje_*) limejaa (kikomo 2048) kwa alama '%s'\n", jina);
    wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    rudisha -1;
}

// -------------------------------------------------------
// Kusanya herufi halisi (string literals) kwenye bafa
// Utorokaji hubadilishwa wakati wa kunakili (8.18: kamba za DATA
// za ndani zilibaki na baiti ghafi za "\n" badala ya 0x0A).
// Jedwali: \n → 10, \t → 9, \0 → 0; vingine (\\, \", \%, n.k.)
// hudondosha kufyeka — sawa na mbegu.
// -------------------------------------------------------
n32 kusanya_herufi(n8* ghafi) {
    // Ruka nukuu ya kufungua
    n32 mwanzo = 1;
    // Tafuta nukuu ya kufunga (ruka utorokaji wa \" kama jozi)
    n32 mwisho_ = mwanzo;
    wakati (ghafi[mwisho_] != 0) {
        kama (ghafi[mwisho_] == 92) { mwisho_ = mwisho_ + 2; endelea; }
        kama (ghafi[mwisho_] == 34) { vunja; }
        mwisho_ = mwisho_ + 1;
    }
    n32 urefu = mwisho_ - mwanzo;  // urefu wa mfuatano ghafi (bila nukuu)

    // Angalia kama tayari imekusanywa (ulinganisho kwa baiti ghafi —
    // kamba yenye utorokaji huwa na toleo lake mwenyewe)
    n32 i = 0;
    wakati (i < mfuatano_idadi) {
        n32 o = mfuatano_ofseti[i];
        n32 l = mfuatano_urefu[i];
        kama (l == urefu + 1) {  // +1 kwa null terminator
            n32 j = 0;
            n32 sawa = 1;
            wakati (j < urefu) {
                kama (mfuatano_bafa[o + j] != ghafi[mwanzo + j]) { sawa = 0; vunja; }
                j = j + 1;
            }
            kama (sawa) { rudisha i; }
        }
        i = i + 1;
    }

    // Ongeza mpya — badilisha utorokaji wakati wa kunakili
    //
    // MUHIMU (#295): kikomo hiki LAZIMA kisimamishe ukusanyaji kwa
    // sauti (exit 1) -- SI kuchapisha KOSA kisha kuendelea kimya.
    // Kuendelea kimya kulisababisha kusanya_herufi kurudisha -1,
    // ambayo ilifanya uzalishaji_kitambulisho KURUKA KABISA agizo
    // la LEA la anwani ya mfuatano -- rejesta ilibaki na thamani ya
    // zamani isiyohusiana (anwani ya mfuatano mwingine uliotangulia),
    // ikitoa "PASS: B" badala ya maandishi sahihi (angalia #295).
    // Namba hizi mbili (65536/1048576) LAZIMA zilingane na ukubwa wa
    // tangazo la str_off/str_len/str_lebo_id na str_buf juu ya faili
    // hili (Swa haina sizeof/lengthof -- kumbuka #197).
    kama (mfuatano_idadi >= 65536 || mfuatano_bafa_wapi + urefu + 1 >= 1048576) {
        andika_stderr("KOSA: jedwali la mfuatano halisi (str_*) limejaa (kikomo cha idadi 65536, au bafa ya baiti 1048576) — programu hii ina herufi halisi nyingi mno kwa jumla\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    kama (mfuatano_idadi < 65536 && mfuatano_bafa_wapi + urefu + 1 < 1048576) {
        n32 o = mfuatano_bafa_wapi;
        n32 j = 0;  // faharisi ya chanzo
        n32 w = 0;  // faharisi ya lengwa (baada ya utorokaji)
        wakati (j < urefu) {
            n8 ch = ghafi[mwanzo + j];
            kama (ch == 92 && j + 1 < urefu) {
                n8 e = ghafi[mwanzo + j + 1];
                kama (e == 110) { ch = 10; j = j + 1; }  // \n
                sivyo { kama (e == 116) { ch = 9; j = j + 1; }  // \t
                    sivyo { kama (e == 48) { ch = 0; j = j + 1; }  // \0
                        sivyo { ch = e; j = j + 1; } } }  // \\ \" \% \x ...
            }
            mfuatano_bafa[o + w] = ch;
            w = w + 1;
            j = j + 1;
        }
        mfuatano_bafa[o + w] = 0;  // null terminator
        mfuatano_ofseti[mfuatano_idadi] = o;
        mfuatano_urefu[mfuatano_idadi] = w + 1;
        mfuatano_bafa_wapi = o + w + 1;
        mfuatano_idadi = mfuatano_idadi + 1;
        rudisha mfuatano_idadi - 1;
    }
    rudisha -1;
}

// -------------------------------------------------------
// Utoaji wa kama (if/else) — AST_KAMA (9)
// -------------------------------------------------------
// -------------------------------------------------------
// Ulinganishi wa moja kwa moja (cmp+jcc) kwa sharti la kama/wakati/kwa
// -------------------------------------------------------
// Njia ya JUMLA (uzalishaji_sawa/tofauti_si/chini/juu/chini_sawa/
// juu_sawa, juu ya faili hili) daima hutoa thamani KAMILI ya 0/1
// (cmp, KISHA setcc al, KISHA movzx eax,al) kwa sababu thamani hiyo
// inaweza kuhitajika kwa matumizi mengine (kuhifadhiwa kwenye kigezo,
// kurudishwa, kutumika ndani ya usemi mwingine). LAKINI: pale sharti
// la kama/wakati/kwa LENYEWE ni ulinganishi HUO HUO moja kwa moja
// (kwa mfano "kama (a < b)" au "wakati (i < n)" -- si "kama (f())"
// wala "kama (x)" peke yake), thamani ya 0/1 haihitajiki KAMWE --
// mahali pekee inapotumika ni KUAMUA tawi gani kuchukua. Katika kesi
// hiyo, cmp/comisd YENYEWE tayari imeweka bendera (flags) za CPU
// zinazohitajika -- setcc+movzx+test ni KAZI TATU za ziada
// zinazotoa tu thamani ya kati (0/1) ili KISHA kuijaribu tena na
// "test" -- badala yake tunaruka moja kwa moja kutoka cmp/comisd
// hadi jcc inayolingana.
//
// UGUNDUZI (kutoka disassembly ya majaribio mengi kikao hiki):
// muundo huu (cmp; setcc; movzx; test; jcc) unatokea kwenye KILA
// sharti la kama/wakati/kwa la mradi huu -- ndiyo muundo wa
// uzalishaji unaotokea mara nyingi ZAIDI kuliko mwingine wowote.
//
// UTAMBUZI: NI WA KIMUUNDO TU (ast_aina[cond] ni mojawapo ya vinodi
// sita vya ulinganishi), SI uchambuzi wa matumizi (data-flow) -- kwa
// sababu nafasi ya "sharti la kama/wakati/kwa" haina mtumiaji
// mwingine yeyote wa thamani hiyo KWA UJENZI (ni sehemu ya AST_KAMA/
// AST_WAKATI YENYEWE, si sehemu ya usemi mwingine), hivyo hakuna
// haja ya kuthibitisha "haitumiki mahali pengine" -- ni dhahiri
// tayari kutoka mahali unapoitwa.
//
// WIGO: vinodi sita vya ulinganishi TU (==, !=, <, >, <=, >=) --
// SI && wala || (hizo tayari zinatoa matawi yake zenyewe kwa
// mizunguko mifupi, si thamani ya moja kwa moja kutathminiwa hapa --
// kazi ya baadaye kuungan[isha] na hizo pia, nje ya wigo wa sasa).
n32 ni_ulinganisho_moja_kwa_moja(n32 nodi) {
    kama (nodi == -1) { rudisha 0; }
    n32 a = mti_aina[nodi];
    rudisha (a == MTI_SAWA || a == MTI_TOFAUTI_SI || a == MTI_CHINI ||
             a == MTI_JUU || a == MTI_CHINI_SAWA || a == MTI_JUU_SAWA);
}

// Toa uzalishaji wa PANDE ZOTE MBILI za nodi ya ulinganishi na cmp/
// comisd YENYEWE (bila setcc/movzx) -- NAKALA ya kimuundo ya mistari
// ya mwanzo ya uzalishaji_sawa/chini/juu/n.k. (hazijaguswa, zinabaki
// kwa njia ya jumla). Baada ya kazi hii kurudi, bendera za CPU
// tayari zimewekwa sahihi kwa jcc inayolingana na aina ya nodi.
w0 toa_ulinganisho_cmp(n32 nodi, n32 kazi_nodi) {
    n32 usimbaji = mti_thamani[nodi];
    toa_cmp_pande_mbili(nodi, kazi_nodi, usimbaji);
}

// Msingi wa PEKEE kwa kutoa jcc yoyote ya rel32 kwa lebo (mnyororo
// ule ule wa kuruka nyuma/mbele unaotumika na toa_je_lebo/
// toa_jne_lebo zilizopo -- kila jcc ya 2-baiti-opcode (0F 8x)
// hutumia utaratibu ule ule wa lebo_buf_imewekwa/weka_fixup). Baiti
// ya pili ya opcode (0F 8x) inapitishwa kama hoja badala ya
// kuandikwa mara nane tofauti.
w0 toa_jcc_lebo(n32 baiti2, n32 lebo_id) {
    andika_baiti(15); andika_baiti(baiti2);
    kama (lebo_bafa_imewekwa[lebo_id]) {
        n32 ofseti = lebo_bafa_nafasi[lebo_id] - (bafa_text_wapi + 4);
        andika_neno4(ofseti);
    } sivyo {
        weka_urekebishaji(lebo_id);
        andika_neno4(0);
    }
}

// jl/jg/jle/jge (ishara) na jb/ja/jbe/jae (bila ishara/desimali) --
// baiti ya pili sawa KABISA na setl/setg/setle/setge/setb/seta/
// setbe/setae zilizopo tayari (0F 9x -> 0F 8x, nibble ile ile ya
// sharti -- angalia weka_setcc_kwa_enc juu ya faili hili, ambayo
// tayari inatumia utambuzi HUO HUO wa ni_desimali_enc||ni_bila_
// ishara_enc kuchagua kati ya jozi hizi mbili za maagizo).
w0 toa_jl_lebo(n32 lebo_id)  { toa_jcc_lebo(140, lebo_id); }
w0 toa_jg_lebo(n32 lebo_id)  { toa_jcc_lebo(143, lebo_id); }
w0 toa_jle_lebo(n32 lebo_id) { toa_jcc_lebo(142, lebo_id); }
w0 toa_jge_lebo(n32 lebo_id) { toa_jcc_lebo(141, lebo_id); }
w0 toa_jb_lebo(n32 lebo_id)  { toa_jcc_lebo(130, lebo_id); }
w0 toa_ja_lebo(n32 lebo_id)  { toa_jcc_lebo(135, lebo_id); }
w0 toa_jbe_lebo(n32 lebo_id) { toa_jcc_lebo(134, lebo_id); }
w0 toa_jae_lebo(n32 lebo_id) { toa_jcc_lebo(131, lebo_id); }

// Toa jcc ya mwelekeo WA MOJA KWA MOJA (kuruka kama sharti ni KWELI)
// kwa nodi ya ulinganishi -- kutumika mahali kuruka kunapaswa
// kutokea TU pale sharti ni kweli (mwili wa wakati/kwa).
//
// JEDWALI (limethibitishwa dhidi ya weka_setcc_kwa_enc juu ya faili
// hili -- mwelekeo 0/1/2/3 = </>/<=/>=, ni_desimali_enc||ni_bila_
// ishara_enc huchagua safu):
//   AST_SAWA        -> je   (0F 84)
//   AST_TOFAUTI_SI  -> jne  (0F 85)
//   AST_CHINI       -> jl (ishara, 0F 8C)  / jb (bila ishara/desimali, 0F 82)
//   AST_JUU         -> jg (0F 8F)          / ja (0F 87)
//   AST_CHINI_SAWA  -> jle (0F 8E)         / jbe (0F 86)
//   AST_JUU_SAWA    -> jge (0F 8D)         / jae (0F 83)
w0 toa_jcc_moja_kwa_moja_lebo(n32 nodi, n32 lebo_id) {
    n32 aina = mti_aina[nodi];
    n32 usimbaji = mti_thamani[nodi];
    n32 bila_ishara = (ni_desimali_usimbaji(usimbaji) || ni_bila_ishara_usimbaji(usimbaji));
    kama (aina == MTI_SAWA) { toa_je_lebo(lebo_id); rudisha; }
    kama (aina == MTI_TOFAUTI_SI) { toa_jne_lebo(lebo_id); rudisha; }
    kama (bila_ishara) {
        kama (aina == MTI_CHINI) { toa_jb_lebo(lebo_id); rudisha; }
        kama (aina == MTI_JUU) { toa_ja_lebo(lebo_id); rudisha; }
        kama (aina == MTI_CHINI_SAWA) { toa_jbe_lebo(lebo_id); rudisha; }
        toa_jae_lebo(lebo_id);  // AST_JUU_SAWA
        rudisha;
    }
    kama (aina == MTI_CHINI) { toa_jl_lebo(lebo_id); rudisha; }
    kama (aina == MTI_JUU) { toa_jg_lebo(lebo_id); rudisha; }
    kama (aina == MTI_CHINI_SAWA) { toa_jle_lebo(lebo_id); rudisha; }
    toa_jge_lebo(lebo_id);  // AST_JUU_SAWA
}

// Toa jcc ya mwelekeo WA KINYUME (kuruka kama sharti ni SIVYO) kwa
// nodi ya ulinganishi -- kutumika mahali kuruka kunapaswa kutokea TU
// pale sharti ni SIVYO (tawi la kama -- ruka kwenda else/mwisho
// pale sharti halikutimia). Kinyume cha kila uhusiano: < <-> >=,
// > <-> <=, == <-> !=. Jedwali kamili (limekaguliwa mara mbili
// dhidi ya jedwali la toa_jcc_moja_kwa_moja_lebo hapo juu):
//   AST_SAWA        -> jne (0F 85)   [kinyume cha je]
//   AST_TOFAUTI_SI  -> je  (0F 84)   [kinyume cha jne]
//   AST_CHINI       -> jge (0F 8D) / jae (0F 83)   [kinyume cha </jb]
//   AST_JUU         -> jle (0F 8E) / jbe (0F 86)   [kinyume cha >/ja]
//   AST_CHINI_SAWA  -> jg  (0F 8F) / ja  (0F 87)   [kinyume cha <=/jbe]
//   AST_JUU_SAWA    -> jl  (0F 8C) / jb  (0F 82)   [kinyume cha >=/jae]
w0 toa_jcc_kinyume_lebo(n32 nodi, n32 lebo_id) {
    n32 aina = mti_aina[nodi];
    n32 usimbaji = mti_thamani[nodi];
    n32 bila_ishara = (ni_desimali_usimbaji(usimbaji) || ni_bila_ishara_usimbaji(usimbaji));
    kama (aina == MTI_SAWA) { toa_jne_lebo(lebo_id); rudisha; }
    kama (aina == MTI_TOFAUTI_SI) { toa_je_lebo(lebo_id); rudisha; }
    kama (bila_ishara) {
        kama (aina == MTI_CHINI) { toa_jae_lebo(lebo_id); rudisha; }
        kama (aina == MTI_JUU) { toa_jbe_lebo(lebo_id); rudisha; }
        kama (aina == MTI_CHINI_SAWA) { toa_ja_lebo(lebo_id); rudisha; }
        toa_jb_lebo(lebo_id);  // AST_JUU_SAWA
        rudisha;
    }
    kama (aina == MTI_CHINI) { toa_jge_lebo(lebo_id); rudisha; }
    kama (aina == MTI_JUU) { toa_jle_lebo(lebo_id); rudisha; }
    kama (aina == MTI_CHINI_SAWA) { toa_jg_lebo(lebo_id); rudisha; }
    toa_jl_lebo(lebo_id);  // AST_JUU_SAWA
}

// -------------------------------------------------------
// Ulinganishi wa moja kwa moja ndani ya && / || (AST_NA/AST_AU) kwenye
// sharti la kama/wakati/kwa
// -------------------------------------------------------
// PR iliyotangulia (angalia maelezo marefu juu ya
// ni_ulinganisho_moja_kwa_moja) ILIACHA && na || nje ya wigo kimakusudi
// kwa sababu tayari zina mzunguko mfupi (short-circuit) wa kujitegemea
// -- LAKINI kila "leg" moja moja ya && / || bado ilikuwa ikitathminiwa
// kwa njia ya JUMLA (cmp;setcc;movzx) kabla ya kujaribiwa na test+jcc
// tena na uzalishaji_na/uzalishaji_au -- muundo ULE ULE uliopotea
// kwenye sharti rahisi. Kazi hizi mbili zinatumika kama "kizuizi
// kimoja" kwa kila leg: ikiwa leg YENYEWE ni ulinganishi wa moja kwa
// moja, ruka moja kwa moja kwa cmp/comisd+jcc; vinginevyo (leg ni
// kigezo, wito wa kazi, AU && / || NYINGINE iliyowekwa ndani -- yaani
// ISIYO mojawapo ya vinodi sita vya ulinganishi), rudi kwenye njia ya
// JUMLA (uzalishaji_usemi + test + jcc) -- hii ndiyo inayoshughulikia
// UPANDE WOWOTE wa NA/AU ulioota ndani (mfano "(a<b && c<d) || e<f")
// KWA USAHIHI KILA WAKATI bila kazi hizi kuhitaji kujua chochote
// kuhusu kina cha ndani: uzalishaji_usemi(leg,...) huita
// uzalishaji_na/uzalishaji_au (isiyobadilishwa, bado sahihi kabisa)
// kwa leg yoyote ambayo SI ulinganishi wa moja kwa moja -- fursa
// iliyokosekana TU (kizazi cha polepole zaidi), si hatari ya usahihi.
//
// toa_leg_na_shindwa: "ruka kwenda lebo_shindwa ikiwa leg hii ni
// SIVYO" -- semantiki ya && (kila leg lazima iwe kweli, la sivyo
// jumla ni sivyo mara moja, ikifunga mzunguko mfupi). Kutumika kwa
// (1) kila leg ya kama (A && B) [lebo_shindwa = lebo_sivyo_kweli], (2)
// leg ya KWANZA ya wakati/kwa (A && B) [lebo_shindwa = lebo_exit], na
// (3) leg ya PILI ya kama/wakati (A || B) [lebo_shindwa = lebo
// inayowakilisha "jumla ni sivyo" ya muktadha huo -- angalia matumizi
// kwenye uzalishaji_kama/uzalishaji_wakati chini].
w0 toa_leg_na_shindwa(n32 leg, n32 lebo_shindwa, n32 kazi_nodi) {
    kama (ni_ulinganisho_moja_kwa_moja(leg)) {
        toa_ulinganisho_cmp(leg, kazi_nodi);
        toa_jcc_kinyume_lebo(leg, lebo_shindwa);
    } sivyo {
        uzalishaji_usemi(leg, kazi_nodi);
        andika_test_eax_eax();
        toa_je_lebo(lebo_shindwa);
    }
}

// toa_leg_au_kweli: "ruka kwenda lebo_kweli ikiwa leg hii ni KWELI" --
// semantiki ya || (leg YOYOTE ikiwa kweli, jumla ni kweli mara moja,
// ikifunga mzunguko mfupi). Kioo cha toa_leg_na_shindwa hapo juu.
// Kutumika kwa (1) kila leg ya wakati/kwa (A || B) [lebo_kweli =
// lebo_body moja kwa moja], (2) leg ya KWANZA ya kama (A || B)
// [lebo_kweli = lebo mpya "lebo_kweli_mapema" iliyowekwa mbele ya
// mwili wa then -- angalia uzalishaji_kama], na (3) leg ya PILI ya
// wakati/kwa (A && B) [lebo_kweli = lebo_body, ikiwa leg ya kwanza
// tayari imethibitika kweli].
w0 toa_leg_au_kweli(n32 leg, n32 lebo_kweli, n32 kazi_nodi) {
    kama (ni_ulinganisho_moja_kwa_moja(leg)) {
        toa_ulinganisho_cmp(leg, kazi_nodi);
        toa_jcc_moja_kwa_moja_lebo(leg, lebo_kweli);
    } sivyo {
        uzalishaji_usemi(leg, kazi_nodi);
        andika_test_eax_eax();
        toa_jne_lebo(lebo_kweli);
    }
}

w0 uzalishaji_kama(n32 nodi, n32 kazi_nodi) {
    n32 sharti = mti_kushoto[nodi];
    n32 basi_mwili = mti_kulia[nodi];
    n32 else_mwili = -1;
    n32 sivyo_nodi = mti_tiga[nodi];
    kama (sivyo_nodi != -1) {
        else_mwili = mti_kushoto[sivyo_nodi];
    }

    n32 lebo_else = lebo_bafa_mpya();
    n32 lebo_mwisho = lebo_bafa_mpya();
    n32 lebo_sivyo_kweli = lebo_mwisho;
    kama (else_mwili != -1) { lebo_sivyo_kweli = lebo_else; }

    n32 sharti_aina = -1;
    kama (sharti != -1) { sharti_aina = mti_aina[sharti]; }

    kama (ni_ulinganisho_moja_kwa_moja(sharti)) {
        toa_ulinganisho_cmp(sharti, kazi_nodi);
        toa_jcc_kinyume_lebo(sharti, lebo_sivyo_kweli);
    } sivyo { kama (sharti_aina == MTI_NA) {
            // A && B (angalia maelezo kamili juu ya toa_leg_na_shindwa):
            // kila leg ikiruka kwenda lebo_sivyo_kweli ikiwa ni SIVYO --
            // B haitathminiwi kabisa ikiwa A tayari ni sivyo (mzunguko
            // mfupi). Zote mbili zikiwa kweli, tunaanguka moja kwa
            // moja kwenye mwili wa then (sawa kabisa na muundo wa
            // asili wa kama).
            toa_leg_na_shindwa(mti_kushoto[sharti], lebo_sivyo_kweli, kazi_nodi);
            toa_leg_na_shindwa(mti_kulia[sharti], lebo_sivyo_kweli, kazi_nodi);
        } sivyo { kama (sharti_aina == MTI_AU) {
            // A || B (angalia maelezo kamili juu ya toa_leg_au_kweli):
            // A ikiwa kweli inaruka moja kwa moja kwenda
            // lebo_kweli_mapema (lebo MPYA, iliyowekwa mbele kabisa ya
            // mwili wa then hapa chini) -- B HAITATHMINIWI kabisa
            // (mzunguko mfupi). B (ikiwa A ni sivyo) ndiyo inayoamua
            // matokeo ya mwisho kikamilifu -- ikiwa B pia ni sivyo,
            // ruka kwenda lebo_sivyo_kweli; ikiwa B ni kweli, anguka
            // moja kwa moja kwenye lebo_kweli_mapema (iko mstari
            // mmoja tu chini).
            n32 lebo_kweli_mapema = lebo_bafa_mpya();
            toa_leg_au_kweli(mti_kushoto[sharti], lebo_kweli_mapema, kazi_nodi);
            toa_leg_na_shindwa(mti_kulia[sharti], lebo_sivyo_kweli, kazi_nodi);
            weka_lebo(lebo_kweli_mapema);
        } sivyo {
            uzalishaji_usemi(sharti, kazi_nodi);
            andika_test_eax_eax();
            toa_je_lebo(lebo_sivyo_kweli);
        } } }

    kama (else_mwili != -1) {
        uzalishaji_taarifa(basi_mwili, kazi_nodi);
        toa_jmp_lebo(lebo_mwisho);
        weka_lebo(lebo_else);
        uzalishaji_taarifa(else_mwili, kazi_nodi);
        weka_lebo(lebo_mwisho);
    } sivyo {
        uzalishaji_taarifa(basi_mwili, kazi_nodi);
        weka_lebo(lebo_mwisho);
    }
}

// -------------------------------------------------------
// Uvektishaji wa kitanzi (auto-vectorization), awamu ya kwanza —
// SSE2 packed-double kwa vitanzi vya elementi rahisi vya safu.
//
// Huu ni ugunduzi wa muundo MAALUM sana, si ubadilishaji wa AST kama
// LICM/kuunganisha kazi ndogo -- unatoa MAAGIZO TOFAUTI KABISA
// (addpd/mulpd/subpd + movupd) badala ya kuandika upya mti kisha
// kutumia uzalishaji uliopo. Kwa sababu hiyo, muundo unaokubalika ni
// mwembamba zaidi kuliko LICM au kuunganisha kazi ndogo kimakusudi:
//
//   wakati (i < bound) {
//       c[i] = a[i] OP b[i];   // OP ni +, -, au *  (d64 pekee)
//       i = i + 1;
//   }
//
// Masharti (yote lazima yatimizwe, la sivyo njia ya kawaida ya scalar
// inatumika bila mabadiliko -- HAKUNA njia ya kati ya "nusu-vektishwa"):
//   1. Hakuna kianzio cha kwa (ast_tiga[node] == -1), na si kitanzi cha
//      hatua/fanya (ast_thamani[node] si -777777 wala -777778) -- LICM
//      ilikataa kianzio cha kwa kwa sababu ile ile (kianzio hutekelezwa
//      NDANI ya nodi ile ile kabla ya sharti la kwanza).
//   2. Sharti ni AST_CHINI (i < bound) hasa -- si <=, >, wala !=.
//   3. i ni kitambulisho, bound ni kitambulisho AU namba halisi (si
//      wito wa kazi wala usemi tata -- lazima iwe salama kusoma MARA
//      MOJA tu na kuhifadhiwa, kwa kuwa mwili haugusi kamwe kigezo cha
//      bound: masharti #6-7 chini yanahakikisha hilo).
//   4. i ni n32 hasa (enc == 288) -- si n64, si kielekezi, si desimali.
//      Hii inaruhusu kutumia maagizo ya 32-bit moja kwa moja bila
//      matawi ya upana, na inalingana na jinsi vihesabu vya kitanzi
//      vinavyoandikwa kwa kawaida kwenye msimbo huu.
//   5. Mwili ni AST_BLOCK yenye TAARIFA MBILI HASA, kwa mpangilio huu:
//      (a) c[i] = a[i] OP b[i]  (b) i = i + 1. Mpangilio mwingine
//      (ongezeko kabla ya ugawaji) HAUKUBALIWI -- ni nadra na
//      haujajaribiwa, mwembamba zaidi ni salama zaidi.
//   6. c, a, b ni vitambulisho VITATU (vinaweza kufanana, mfano
//      c[i]=c[i]+a[i]), kila kimoja d64* halisi (ni_desimali_enc na
//      ukubwa_kutoka_enc==8) -- si D32*, si muundo, si n64*.
//   7. Fahirisi ya safu ZOTE TATU ni KITAMBULISHO SAWA na i HASA --
//      HAKUNA ongezeko (a[i+1] HAIKUBALIWI) na HAKUNA fahirisi tata
//      (a[i*n+j] HAIKUBALIWI, ndiyo maana matriki HAIENDANI na awamu
//      hii -- kitanzi chake cha ndani kina fahirisi tata NA
//      operesheni MBILI zilizounganishwa, angalia MATOKEO.md).
//   8. Ongezeko ni "i = i + 1" hasa -- si "i += 1" (angalia jinsi hiyo
//      inavyosambazwa -- kama ni AST_ASIMILIA ile ile ya i=i+1 baada
//      ya usambazaji, sharti hili litapita vilevile), si "i++", wala
//      hatua nyingine yoyote.
//
// Bila alama zozote za kuaminika za muundo huu (kwa mfano fahirisi
// tata au OP zaidi ya moja), kitanzi kizima kinaachwa BILA KUGUSWA --
// hakuna majaribio ya "kuvektisha kwa sehemu".
// -------------------------------------------------------

// Jina la kipekee la kigezo cha muda kinachohifadhi thamani ya bound
// (kikomo cha juu cha kitanzi) mara moja tu -- angalia maelezo kwenye
// simd_zalisha kuhusu kwa nini ni salama kusoma bound mara moja pekee.
n8 sambamba_jina_bafa[768];  // 32 * 24
n32 sambamba_jina_idadi = 0;

n8* sambamba_jina_mpya() {
    kama (sambamba_jina_idadi >= 32) { rudisha 0; }
    n32 sloti = sambamba_jina_idadi;
    sambamba_jina_idadi = sambamba_jina_idadi + 1;
    n8* bafa = sambamba_jina_bafa + (sloti * 24);
    bafa[0] = 95;   // _
    bafa[1] = 95;   // _
    bafa[2] = 115;  // s
    bafa[3] = 105;  // i
    bafa[4] = 109;  // m
    bafa[5] = 100;  // d
    bafa[6] = 95;   // _
    bafa[7] = 98;   // b
    n32 n = sloti;
    n32 nafasi_hii = 8;
    kama (n == 0) {
        bafa[nafasi_hii] = 48;  // '0'
        nafasi_hii = nafasi_hii + 1;
    } sivyo {
        n32 muda = n;
        n32 ndj = 0;
        wakati (muda > 0) { ndj = ndj + 1; muda = muda / 10; }
        n32 mwisho = nafasi_hii + ndj;
        muda = n;
        n32 p2 = mwisho - 1;
        wakati (muda > 0) {
            bafa[p2] = 48 + (muda % 10);
            muda = muda / 10;
            p2 = p2 - 1;
        }
        nafasi_hii = mwisho;
    }
    bafa[nafasi_hii] = 0;
    rudisha bafa;
}

// Rudisha 1 ikiwa nodi ni kitambulisho chenye jina sawa na `jina`.
n32 sambamba_ni_kitambulisho_jina(n32 nodi, n8* jina) {
    kama (nodi == -1) { rudisha 0; }
    kama (mti_aina[nodi] != 5) { rudisha 0; }  // AST_KITAMBULISHO
    rudisha jina_linganisha(mti_dimbwi + mti_jina_ofseti[nodi], jina);
}

// Toa msimbo wa kitanzi kilichovektishwa. Inaitwa TU baada ya
// simd_jaribu_kitanzi kuthibitisha muundo kikamilifu.
w0 sambamba_zalisha(n32 nodi, n32 bound_nodi, n32 ctr_nodi, n32 lv, n32 a_nodi,
                n32 b_nodi, n32 kitendo_aina, n32 taarifa1, n32 taarifa2, n32 kazi_nodi) {
    // Hifadhi thamani ya bound MARA MOJA TU kwenye kigezo cha muda cha
    // ndani. Hii ni salama kwa sababu masharti #5-#8 hapo juu
    // yanahakikisha mwili wa kitanzi hauandiki KAMWE kigezo cha bound
    // (unagusa tu i na kumbukumbu ya safu kupitia c/a/b) -- kwa hiyo
    // thamani yake haiwezi kubadilika wakati wa kitanzi, tofauti na
    // msimbo wa kawaida unaosoma upya sharti kila zunguko.
    n8* bjina = sambamba_jina_mpya();
    n32 bvidx = pata_au_unda_kigeu_ukubwa(bjina, 4, 288);
    uzalishaji_usemi(bound_nodi, kazi_nodi);
    andika_mov_rbp_ofseti_ax(288, kigeu_rbp_ofseti[bvidx]);

    n32 lebo_vec_kagua = lebo_bafa_mpya();
    n32 lebo_vec_mwili = lebo_bafa_mpya();
    n32 lebo_mkia_kagua = lebo_bafa_mpya();
    n32 lebo_mkia_mwili = lebo_bafa_mpya();
    n32 lebo_toka = lebo_bafa_mpya();

    toa_jmp_lebo(lebo_vec_kagua);

    // --- Awamu ya jozi: inashughulikia i na i+1 kwa maagizo ya SSE2 ---
    weka_lebo(lebo_vec_mwili);
    // Anwani za c[i], b[i], a[i] -- zinasukumwa kwa mpangilio wa
    // NYUMA ili kuvuta kwa mpangilio a, b, c (LIFO).
    uzalishaji_anwani_ya_usemi(lv, kazi_nodi);       // rax = &c[i]
    andika_push_rax();
    uzalishaji_anwani_ya_usemi(b_nodi, kazi_nodi);   // rax = &b[i]
    andika_push_rax();
    uzalishaji_anwani_ya_usemi(a_nodi, kazi_nodi);   // rax = &a[i]
    andika_push_rax();
    andika_pop_rax();                                // rax = &a[i]
    andika_movupd_xmm0_mem_rax();                    // xmm0 = a[i], a[i+1]
    andika_pop_rax();                                // rax = &b[i]
    andika_movupd_xmm1_mem_rax();                    // xmm1 = b[i], b[i+1]
    kama (kitendo_aina == 6) { andika_addpd_xmm0_xmm1(); }        // AST_JUMLISHA
    sivyo { kama (kitendo_aina == 7) { andika_subpd_xmm0_xmm1(); } // AST_TOFAUTI
        sivyo { andika_mulpd_xmm0_xmm1(); } }                 // AST_ZIDISHA
    andika_pop_rax();                                // rax = &c[i]
    andika_movupd_mem_rax_xmm0();                    // c[i], c[i+1] = matokeo
    // i += 2 -- tekeleza ongezeko lililopo MARA MBILI badala ya
    // kuandika upya "i = i + 2" wenyewe: hutumia tena msimbo wa
    // ongezeko ULIOTHIBITISHWA tayari na usambazaji/ukaguzi badala ya
    // kuunda njia mpya inayoweza kuwa na kasoro.
    uzalishaji_asimilia(taarifa2, kazi_nodi);
    uzalishaji_asimilia(taarifa2, kazi_nodi);
    toa_jmp_lebo(lebo_vec_kagua);

    // --- Sharti la awamu ya jozi: (i + 1) < bound ---
    weka_lebo(lebo_vec_kagua);
    andika_pakia_kigeu_kwa_usimbaji(288, kigeu_rbp_ofseti[bvidx]);  // eax = bound
    sukuma_thamani(288);
    uzalishaji_usemi(ctr_nodi, kazi_nodi);                 // eax = i
    andika_add_eax_imm32(1);                               // eax = i + 1
    vuta_thamani_rcx(288);                                 // ecx = bound
    uzalishaji_cmp_kwa_usimbaji(288);
    weka_setcc_kwa_usimbaji(288, 0);  // (i+1) < bound
    andika_movzx_eax_al();
    andika_test_eax_eax();
    toa_jne_lebo(lebo_vec_mwili);

    // --- Sharti la awamu ya mabaki: i < bound (elementi moja iliyobaki
    // kama idadi ya jumla ni isiyo sawa -- kamwe si zaidi ya moja) ---
    weka_lebo(lebo_mkia_kagua);
    andika_pakia_kigeu_kwa_usimbaji(288, kigeu_rbp_ofseti[bvidx]);  // eax = bound
    sukuma_thamani(288);
    uzalishaji_usemi(ctr_nodi, kazi_nodi);                 // eax = i
    vuta_thamani_rcx(288);                                 // ecx = bound
    uzalishaji_cmp_kwa_usimbaji(288);
    weka_setcc_kwa_usimbaji(288, 0);  // i < bound
    andika_movzx_eax_al();
    andika_test_eax_eax();
    toa_jne_lebo(lebo_mkia_mwili);
    toa_jmp_lebo(lebo_toka);

    // Elementi ya mwisho (scalar, njia ya kawaida iliyothibitishwa
    // tayari) -- kamwe haitatekelezwa zaidi ya mara moja.
    weka_lebo(lebo_mkia_mwili);
    uzalishaji_asimilia(taarifa1, kazi_nodi);
    uzalishaji_asimilia(taarifa2, kazi_nodi);
    toa_jmp_lebo(lebo_mkia_kagua);

    weka_lebo(lebo_toka);
}

// Jaribu kutambua muundo wa uvektishaji. Kama unafanana kikamilifu,
// hutoa msimbo wa SSE2 na kurudisha 1 (uzalishaji_wakati huacha hapo
// hapo). Vinginevyo hurudisha 0 bila kutoa BAITI YOYOTE -- njia ya
// kawaida ya scalar inaendelea bila kubadilika kabisa.
n32 sambamba_jaribu_kitanzi(n32 nodi, n32 kazi_nodi) {
    kama (mti_tiga[nodi] != -1) { rudisha 0; }        // kianzio cha kwa
    kama (mti_thamani[nodi] == -777777) { rudisha 0; }  // hatua ya kwa
    kama (mti_thamani[nodi] == -777778) { rudisha 0; }  // fanya (do-while)

    n32 sharti = mti_kushoto[nodi];
    n32 mwili = mti_kulia[nodi];
    kama (sharti == -1 || mwili == -1) { rudisha 0; }
    kama (mti_aina[sharti] != 22) { rudisha 0; }  // AST_CHINI (<) pekee

    n32 ctr_nodi = mti_kushoto[sharti];
    n32 bound_nodi = mti_kulia[sharti];
    kama (ctr_nodi == -1 || bound_nodi == -1) { rudisha 0; }
    kama (mti_aina[ctr_nodi] != 5) { rudisha 0; }  // i ni kitambulisho
    n32 aina_bound = mti_aina[bound_nodi];
    kama (aina_bound != 5 && aina_bound != 4) { rudisha 0; }  // kigezo au namba halisi

    n32 cmp_usimbaji = mti_thamani[sharti];
    kama (cmp_usimbaji != 288) { rudisha 0; }  // i (na hivyo aina ya ulinganishi) ni n32 hasa

    n8* ctr_jina = mti_dimbwi + mti_jina_ofseti[ctr_nodi];

    // MUHIMU: mwili wa kitanzi HAUFUNGWI kwenye AST_BLOCK -- kama
    // changanua_bloku (msambazaji.swa) inavyoonyesha, taarifa za {}
    // zinaunganishwa MOJA KWA MOJA kupitia ast_nne, bila kifuniko
    // chochote (AST_BLOCK ni alama ya "mwili tupu" TU). Kwa hiyo
    // "taarifa mbili hasa" ni: stmt1 = body, stmt2 = ast_nne[stmt1],
    // na ast_nne[stmt2] == -1 (hakuna ya tatu).
    n32 taarifa1 = mwili;
    kama (mti_aina[taarifa1] == 50) { rudisha 0; }  // AST_BLOCK == mwili tupu
    n32 taarifa2 = mti_nne[taarifa1];
    kama (taarifa2 == -1) { rudisha 0; }
    kama (mti_nne[taarifa2] != -1) { rudisha 0; }   // TAARIFA MBILI hasa, si zaidi

    // stmt2 lazima iwe "i = i + 1" hasa
    kama (mti_aina[taarifa2] != 37) { rudisha 0; }  // AST_ASIMILIA
    n32 s2l = mti_kushoto[taarifa2];
    n32 s2r = mti_kulia[taarifa2];
    kama (sambamba_ni_kitambulisho_jina(s2l, ctr_jina) == 0) { rudisha 0; }
    kama (s2r == -1 || mti_aina[s2r] != 6) { rudisha 0; }  // AST_JUMLISHA
    n32 incl = mti_kushoto[s2r];
    n32 ongezeko = mti_kulia[s2r];
    kama (sambamba_ni_kitambulisho_jina(incl, ctr_jina) == 0) { rudisha 0; }
    kama (ongezeko == -1 || mti_aina[ongezeko] != 4) { rudisha 0; }  // namba halisi
    kama (mti_kulia[ongezeko] == 1) { rudisha 0; }  // namba ya n64 kwenye dimbwi -- kataa
    kama (mti_thamani[ongezeko] != 1) { rudisha 0; }  // lazima iwe hasa 1

    // stmt1 lazima iwe "c[i] = a[i] OP b[i]"
    kama (mti_aina[taarifa1] != 37) { rudisha 0; }  // AST_ASIMILIA
    n32 lv = mti_kushoto[taarifa1];
    n32 rv = mti_kulia[taarifa1];
    kama (lv == -1 || rv == -1) { rudisha 0; }
    kama (mti_aina[lv] != 29) { rudisha 0; }  // AST_TAJA
    n32 c_faharasa = mti_kulia[lv];
    kama (sambamba_ni_kitambulisho_jina(c_faharasa, ctr_jina) == 0) { rudisha 0; }
    n32 c_base = mti_kushoto[lv];
    kama (c_base == -1 || mti_aina[c_base] != 5) { rudisha 0; }
    n32 lv_usimbaji = mti_thamani[lv];
    kama (ni_desimali_usimbaji(lv_usimbaji) == 0) { rudisha 0; }
    kama (ukubwa_kutoka_usimbaji(lv_usimbaji) != 8) { rudisha 0; }  // d64 pekee, si D32

    n32 kitendo_aina = mti_aina[rv];
    kama (kitendo_aina != 6 && kitendo_aina != 7 && kitendo_aina != 31) { rudisha 0; }  // +, -, *
    n32 a_nodi = mti_kushoto[rv];
    n32 b_nodi = mti_kulia[rv];
    kama (a_nodi == -1 || b_nodi == -1) { rudisha 0; }
    kama (mti_aina[a_nodi] != 29 || mti_aina[b_nodi] != 29) { rudisha 0; }  // AST_TAJA zote mbili
    n32 a_faharasa = mti_kulia[a_nodi];
    n32 b_faharasa = mti_kulia[b_nodi];
    kama (sambamba_ni_kitambulisho_jina(a_faharasa, ctr_jina) == 0) { rudisha 0; }
    kama (sambamba_ni_kitambulisho_jina(b_faharasa, ctr_jina) == 0) { rudisha 0; }
    n32 a_base = mti_kushoto[a_nodi];
    n32 b_base = mti_kushoto[b_nodi];
    kama (a_base == -1 || mti_aina[a_base] != 5) { rudisha 0; }
    kama (b_base == -1 || mti_aina[b_base] != 5) { rudisha 0; }
    n32 a_usimbaji = mti_thamani[a_nodi];
    n32 b_usimbaji = mti_thamani[b_nodi];
    kama (ni_desimali_usimbaji(a_usimbaji) == 0 || ukubwa_kutoka_usimbaji(a_usimbaji) != 8) { rudisha 0; }
    kama (ni_desimali_usimbaji(b_usimbaji) == 0 || ukubwa_kutoka_usimbaji(b_usimbaji) != 8) { rudisha 0; }

    // Muundo umethibitishwa kikamilifu -- toa msimbo wa SSE2. stmt1 na
    // stmt2 hapa hazina tena ast_nne kwa madhumuni ya
    // uzalishaji_asimilia (haitumiki), lakini ZINGATIA: simd_zalisha
    // huita uzalishaji_asimilia moja kwa moja (si uzalishaji_taarifa),
    // hivyo mnyororo wao wa ast_nne (unaoelekeza kwa taarifa
    // inayofuata NJE ya kitanzi) HAUGUSWI kamwe -- salama.
    sambamba_zalisha(nodi, bound_nodi, ctr_nodi, lv, a_nodi, b_nodi, kitendo_aina, taarifa1, taarifa2, kazi_nodi);
    rudisha 1;
}

// Uzalishaji wa wakati (while) — AST_WAKATI (10)
w0 uzalishaji_wakati(n32 nodi, n32 kazi_nodi) {
    n32 sharti = mti_kushoto[nodi];
    n32 mwili = mti_kulia[nodi];
    n32 kianzio = mti_tiga[nodi];  // kwa (for) loop init, ikiwa ipo

    kama (sambamba_jaribu_kitanzi(nodi, kazi_nodi)) { rudisha; }

    // Toa msimbo wa anzisha (kwa ajili ya kwa loop)
    // Init inatekelezwa mara moja kabla ya kitanzi
    kama (kianzio != -1) {
        n32 aina_kianzio = mti_aina[kianzio];
        kama (aina_kianzio == 11) {  // AST_TANGAZO
            n32 kigeu_nodi = mti_kushoto[kianzio];
            n32 kianzio_thamani = mti_kulia[kianzio];
            n8* kigeu_jina = mti_dimbwi + mti_jina_ofseti[kigeu_nodi];
            n32 saizi = ukubwa_kutoka_usimbaji(mti_thamani[kigeu_nodi]);
            kama (mti_tiga[kianzio] > 0) { saizi = saizi * mti_tiga[kianzio]; }
            n32 kigeu_usimbaji_thamani = mti_thamani[kigeu_nodi];
            n32 vidx = pata_au_unda_kigeu_ukubwa(kigeu_jina, saizi, kigeu_usimbaji_thamani);
            kama (vidx >= 0) {
                n32 ofseti = kigeu_rbp_ofseti[vidx];
                kama (mti_tiga[kianzio] > 0) {
                    // Safu ya ndani ndani ya kitanzi-cha-kwa
                    kigeu_ni_safu[vidx] = 1;
                } sivyo { kama (kianzio_thamani != -1) {
                        uzalishaji_usemi(kianzio_thamani, kazi_nodi);
                        // MUHIMU: tangazo la ndani ya kichwa cha kwa-loop
                        // haliingii kwenye pitio la tambua_tangazo_pass
                        // (aina==10 iko kwenye ruka_tiga huko), hivyo
                        // HALIWEZI kamwe kuwa var_reg[vidx]>=0 kwa jina
                        // JIPYA -- LAKINI ikiwa jina hili linafanana na
                        // kigezo kilichoshatangazwa mahali pengine
                        // kwenye kazi hii (mfano "i" ikitumika mara
                        // mbili), pata_au_unda_kigeu_ukubwa hapo juu
                        // ingerudisha kiashiria KILE KILE -- angalia
                        // var_reg kwa usalama badala ya kudhania -1.
                        kama (kigeu_reg[vidx] >= 0) {
                            sawazisha_eax_kwa_usimbaji(kigeu_usimbaji_thamani);
                            andika_mov_reg64_rax(regista_halisi_kwa_id(kigeu_reg[vidx]));
                        } sivyo {
                            andika_mov_rbp_ofseti_ax(kigeu_usimbaji_thamani, ofseti);
                        }
                    } sivyo {
                        andika_xor_eax_eax();
                        kama (kigeu_reg[vidx] >= 0) {
                            andika_mov_reg64_rax(regista_halisi_kwa_id(kigeu_reg[vidx]));
                        } sivyo {
                            andika_mov_rbp_ofseti_ax(kigeu_usimbaji_thamani, ofseti);
                        }
                    } }
            }
        }
        sivyo {
            // AST_ASIMILIA au usemi mwingine
            uzalishaji_usemi(kianzio, kazi_nodi);
        }
    }

    n32 lebo_mwili = lebo_bafa_mpya();
    n32 lebo_sharti = lebo_bafa_mpya();
    n32 lebo_toka = lebo_bafa_mpya();
    n32 ni_fanya = 0;  // -777778 = kitanzi cha fanya (mwili-kwanza)

    kama (mzunguko_undani >= 16) {
        // lugha-swa/swa#298 -- hii ilikuwa ikiweka text_imefurika=1
        // (bendera iliyokufa, haikuwahi kusomwa) kisha KUENDELEA --
        // mzunguko_lebo_endelea/hatua/toka[16] ingeandikwa nje ya
        // mipaka kimya (au kutumia tena nafasi ya kiwango cha 16,
        // ikivuruga endelea/vunja za kitanzi cha nje). Sasa inasimamisha
        // ukusanyaji mara moja.
        andika_stderr("KOSA: upeo wa kupandikiza kitanzi (kikomo 16) umefikiwa\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    } sivyo {
        // Kitanzi cha kwa chenye hatua: endelea inaruka kwenye HATUA
        // (semantiki ya C), si kwenye hali. Alama ya -777777 kwenye
        // ast_thamani ya wakati ina maana hatua ipo (imewekwa na
        // msambazaji). Lebo ya hatua imetengwa MAPEMA — kifungio cha
        // hatua kitaweka weka_lebo hapo wakati kinakusanywa.
        // Alama ya -777778 = kitanzi cha FANYA (do-while): mwili
        // hukimbia mara moja kabla ya sharti — hakuna kuruka kwa
        // awali hadi sharti (kuweka-lebo kwa mwili ni kuingilia).
        // endelea ndani ya fanya inaruka hadi SHARTI (semantiki ya
        // C ya do-while) — lebo_cond hapa chini.
        n32 ina_hatua = (mti_thamani[nodi] == -777777);
        ni_fanya = (mti_thamani[nodi] == -777778);
        mzunguko_lebo_hatua[mzunguko_undani] = lebo_bafa_mpya();
        kama (ina_hatua) {
            mzunguko_lebo_endelea[mzunguko_undani] = mzunguko_lebo_hatua[mzunguko_undani];
        } sivyo {
            mzunguko_lebo_endelea[mzunguko_undani] = lebo_sharti;
        }
        mzunguko_lebo_toka[mzunguko_undani] = lebo_toka;
        mzunguko_undani = mzunguko_undani + 1;
    }

    // wakati (na kwa) huanza kwa kuruka hadi sharti; fanya huanza
    // na mwili wake mara moja (mwili hukimbia angalau mara moja).
    kama (ni_fanya == 0) {
        toa_jmp_lebo(lebo_sharti);
    }

    weka_lebo(lebo_mwili);
    uzalishaji_taarifa(mwili, kazi_nodi);

    weka_lebo(lebo_sharti);
    kama (sharti == -1) {
        // Hali iliyoachwa wazi = kweli daima (semantiki ya C):
        // kwa (i = 0; ; i = i + 1) na kwa (;;) ni vitanzi visivyoisha
        // hadi vunja au rudisha. Hapo awali -1 ilitolewa kama usemi
        // usiotoa kitu — mwili haukuwahi kutekelezwa (jibu baya la kimya).
        andika_mov_eax(1);
        andika_test_eax_eax();
        toa_jne_lebo(lebo_mwili);
    } sivyo {
        n32 sharti_aina2 = mti_aina[sharti];
        kama (ni_ulinganisho_moja_kwa_moja(sharti)) {
            // Sharti la wakati/kwa/fanya LENYEWE ni ulinganishi moja
            // kwa moja -- ruka moja kwa moja kwa cmp/comisd+jcc badala
            // ya cmp;setcc;movzx;test;jcc (angalia maelezo kamili juu
            // ya ni_ulinganisho_moja_kwa_moja, kabla ya uzalishaji_kama).
            toa_ulinganisho_cmp(sharti, kazi_nodi);
            toa_jcc_moja_kwa_moja_lebo(sharti, lebo_mwili);
        } sivyo { kama (sharti_aina2 == MTI_NA) {
                // A && B (angalia maelezo juu ya toa_leg_na_shindwa/
                // toa_leg_au_kweli, kabla ya uzalishaji_kama): A ikiwa
                // sivyo, jumla ni sivyo mara moja -- ruka moja kwa
                // moja kwenda lebo_exit (mzunguko mfupi, B
                // HAITATHMINIWI kabisa). B (ikiwa A tayari ni kweli)
                // ndiyo inayoamua -- ikiwa B ni kweli, ruka kwenda
                // lebo_body; ikiwa B ni sivyo, anguka moja kwa moja
                // kwenye lebo_exit (weka_lebo yake iko mara moja chini
                // ya kizuizi hiki).
                toa_leg_na_shindwa(mti_kushoto[sharti], lebo_toka, kazi_nodi);
                toa_leg_au_kweli(mti_kulia[sharti], lebo_mwili, kazi_nodi);
            } sivyo { kama (sharti_aina2 == MTI_AU) {
                // A || B: leg YOYOTE ikiwa kweli inaruka moja kwa moja
                // kwenda lebo_body (mzunguko mfupi -- B haitathminiwi
                // ikiwa A tayari ni kweli). Zote mbili zikiwa sivyo,
                // tunaanguka moja kwa moja kwenye lebo_exit.
                toa_leg_au_kweli(mti_kushoto[sharti], lebo_mwili, kazi_nodi);
                toa_leg_au_kweli(mti_kulia[sharti], lebo_mwili, kazi_nodi);
            } sivyo {
                uzalishaji_usemi(sharti, kazi_nodi);
                andika_test_eax_eax();
                toa_jne_lebo(lebo_mwili);
            } } }
    }

    weka_lebo(lebo_toka);

    mzunguko_undani = mzunguko_undani - 1;
}

// -------------------------------------------------------
// Utoaji wa chagua (switch) — AST_CHAGUA (14)
// Hutumia mnyororo wa kama-ikiwa (if-else chain)
// -------------------------------------------------------

// Toa thamani ya lebo ya hali kwenye rax. Mkaguzi ameidhinisha lebo
// kuwa halisi ya nambari (chanya au hasi); hii inashughulikia n32,
// n64 (alama ast_kulia == 1), na toa-unari (-N). Kwa kinga, usemi
// mwingine wowote unatathminiwa kama usemi wa kawaida.
w0 uzalishaji_lebo_ya_hali(n32 lebo_nodi, n32 kazi_nodi) {
    n32 ni_hasi = 0;
    n32 halisi = lebo_nodi;
    kama (mti_aina[lebo_nodi] == 7) {  // toa-unari: -N
        kama (mti_kushoto[lebo_nodi] == -1) {
            ni_hasi = 1;
            halisi = mti_kulia[lebo_nodi];
        }
    }
    kama (mti_aina[halisi] == 4) {
        kama (mti_kulia[halisi] == 1) {
            // n64 halisi: baiti 8 kwenye dimbwi — mov rax, imm64
            n32 ofseti = mti_thamani[halisi];
            andika_baiti(72);  // 0x48 — REX.W
            andika_baiti(184);  // 0xB8 — mov rax, imm64
            n32 bi = 0;
            wakati (bi < 8) {
                andika_baiti(mti_dimbwi[ofseti + bi]);
                bi = bi + 1;
            }
            kama (ni_hasi) { andika_neg_rax(); }
        } sivyo {
            andika_mov_eax(mti_thamani[halisi]);
            kama (ni_hasi) { andika_neg_eax(); }
        }
        rudisha;
    }
    // Kinga pekee — mkaguzi hukataa lebo zisizo halisi kwa sauti.
    uzalishaji_usemi(lebo_nodi, kazi_nodi);
}

w0 uzalishaji_chagua(n32 nodi, n32 kazi_nodi) {
    n32 imepimwa_nodi = mti_kushoto[nodi];
    n32 hali_orodha = mti_kulia[nodi];
    n32 chaguo_msingi_mwili = mti_tiga[nodi];  // mwili wa sivyo (chaguo-msingi)

    // Tathmini thamani ya skrutini
    uzalishaji_usemi(imepimwa_nodi, kazi_nodi);

    // Hifadhi thamani kwenye rafu kwa ajili ya kulinganisha
    andika_push_rax();  // push thamani ya skrutini

    // Upana wa ulinganisho unafuatwa na aina ya skrutini: n64 (na
    // kielekezi) zinalinganishwa kwa 64-bit; n8/n16/n32 kwa 32-bit.
    // Ulinganisho wa 32-bit kwa lebo za n64 unakata kwa sifuri —
    // semantiki ya C (lebo inabadilishwa hadi aina ya skrutini).
    n32 saizi_selecta = ukubwa_kutoka_usimbaji(aina_ya_usemi(imepimwa_nodi));
    n32 ni_pana = 0;
    kama (saizi_selecta >= 8) { ni_pana = 1; }

    // Tengeneza lebo za mwisho na chaguo-msingi
    n32 lebo_mwisho = lebo_bafa_mpya();
    n32 lebo_chaguo_msingi = lebo_bafa_mpya();

    // Tembea kila hali
    n32 ukaguzi = hali_orodha;
    wakati (ukaguzi != -1) {
        n32 lebo_nodi = mti_kushoto[ukaguzi];
        n32 case_mwili = mti_kulia[ukaguzi];

        // Tathmini thamani ya lebo kwenye rax (halisi au toa-unari)
        uzalishaji_lebo_ya_hali(lebo_nodi, kazi_nodi);
        andika_push_rax();  // hifadhi thamani ya lebo

        // Linganisha thamani ya skrutini na thamani ya hali.
        // Skrutini iko kwenye rafu ([rsp]); lebo inatolewa kwenye rcx,
        // skrutini kwenye rax, ikilinganishwa, kisha skrutini
        // inarudishwa kwenye rafu kwa rax — hali inayofuata
        // inalinganishwa na skrutini, si na lebo ya zamani.
        andika_pop_rcx();  // rcx = thamani ya lebo
        andika_pop_rax();  // rax = thamani ya skrutini
        kama (ni_pana) { andika_cmp_rax_rcx(); }
        sivyo { andika_cmp_eax_ecx(); }
        andika_push_rax();  // rudisha thamani ya skrutini kwenye rafu

        n32 lebo_kesi = lebo_bafa_mpya();
        toa_jne_lebo(lebo_kesi);  // ruka ikiwa hailingani

        // Mwili wa hali
        kama (case_mwili != -1) {
            uzalishaji_taarifa(case_mwili, kazi_nodi);
        }
        toa_jmp_lebo(lebo_mwisho);  // ruka hadi mwisho baada ya hali

        weka_lebo(lebo_kesi);  // lebo ya kulinganisha inayofuata

        ukaguzi = mti_nne[ukaguzi];
    }

    // Chaguo-msingi: mwili wa sivyo (kama upo). Hapa hufikiwa tu
    // wakati hali ZOTE hazikulingana.
    weka_lebo(lebo_chaguo_msingi);

    kama (chaguo_msingi_mwili != -1) {
        uzalishaji_taarifa(chaguo_msingi_mwili, kazi_nodi);
    }

    // Safisha rafu (ondoa thamani ya skrutini iliyobaki)
    andika_pop_rcx();

    weka_lebo(lebo_mwisho);
}

// -------------------------------------------------------
// Utoaji wa wito wa kazi — AST_WITO (8)
// -------------------------------------------------------
// =========================================================
// Kawira (--kernel, hali_exe_sasa==2): kazi za msaada za vga_andika()
// -- anwani mbili za kudumu: 0x9000 (kaka/cursor, n32 moja, chini ya
// eneo la kupakia kernel 0x100000 -- HAKUNA sehemu ya .data kwenye
// hali hii, hivyo hali hii ya kudumu HAILAZIMU kuwa "kigezo cha
// ulimwengu" cha Swa, ni maelezo ya ndani ya uzalishaji pekee), na
// 0xB8000 (VGA text buffer, 80x25, herufi+attribute kila baiti
// mbili -- mkataba wa maunzi ya kudumu, si uchaguzi wetu).
//
// Mkataba wa ModRM/SIB unaotumika mara kwa mara hapa chini: anwani
// KAMILI (absolute disp32, bila base/index register) -- ModRM=04
// (mod=00,reg=<tofauti>,rm=100 "SIB inafuata"), SIB=25 (scale=00,
// index=100 "hakuna", base=101 "hakuna base, disp32 pekee") --
// KISHA disp32 (anwani, 4 baiti, little-endian). Hii inafanya kazi
// KWA USALAMA kwa sababu kiini.s (Kawira) tayari imeweka identity-map
// ya MB 2 za kwanza za kumbukumbu (angalia hati/mipaka.md ya Kawira,
// Sehemu 1) -- 0x9000 na 0xB8000 zote mbili ziko chini ya mpaka huo.
// =========================================================

// Andika herufi MOJA (thamani inayojulikana WAKATI WA KUKUSANYA) kwenye
// nafasi ya sasa ya kaka, kisha ongeza kaka kwa 1. Rejesta rax/rbx/rcx
// zinahifadhiwa kwa push/pop -- HAZIATHIRI hali ya usemi unaozunguka.
w0 kernel_vga_andika_herufi(n32 ch) {
    andika_baiti(80);  // push rax
    andika_baiti(83);  // push rbx
    andika_baiti(81);  // push rcx

    // mov eax, [0x9000]  (kaka ya sasa)
    andika_baiti(139); andika_baiti(4); andika_baiti(37); andika_neno4(36864);
    // mov ebx, eax
    andika_baiti(137); andika_baiti(195);
    // add ebx, ebx  (ebx = kaka*2 -- baiti mbili kwa kila kiini cha VGA)
    andika_baiti(1); andika_baiti(219);
    // mov ecx, 0xB8000
    andika_baiti(185); andika_neno4(753664);
    // add ebx, ecx  (ebx = anwani KAMILI ya VGA kwa kiini hiki)
    andika_baiti(1); andika_baiti(203);
    // mov byte [ebx], ch
    andika_baiti(198); andika_baiti(3); andika_baiti(ch & 255);
    // mov byte [ebx+1], 0x0F  (attribute: nyeupe juu ya nyeusi)
    andika_baiti(198); andika_baiti(67); andika_baiti(1); andika_baiti(15);
    // inc eax
    andika_baiti(255); andika_baiti(192);
    // mov [0x9000], eax  (hifadhi kaka mpya)
    andika_baiti(137); andika_baiti(4); andika_baiti(37); andika_neno4(36864);

    andika_baiti(89);  // pop rcx
    andika_baiti(91);  // pop rbx
    andika_baiti(88);  // pop rax
}

// Andika herufi MOJA ya WAKATI WA KUKIMBIA (thamani tayari iko kwenye
// eax wakati kazi hii inapoitwa) -- KIOO cha kernel_vga_andika_herufi
// hapo juu, LAKINI chanzo cha thamani ni REGISTER (eax), SI immediate
// ya wakati wa kukusanya -- muhimu kwa kibodi (Sehemu 3): scancode
// inajulikana TU wakati wa kukimbia. Rejesta rax/rbx/rcx/rdx
// zinahifadhiwa kwa push/pop -- HAZIATHIRI hali ya usemi unaozunguka,
// sawa na kernel_vga_andika_herufi.
w0 kernel_vga_andika_herufi_rt() {
    andika_baiti(82);  // push rdx
    // mov edx, eax  (hifadhi thamani ya herufi KABLA eax kutumika kwa kaka)
    andika_baiti(137); andika_baiti(194);

    andika_baiti(80);  // push rax
    andika_baiti(83);  // push rbx
    andika_baiti(81);  // push rcx

    // mov eax, [0x9000]  (kaka ya sasa)
    andika_baiti(139); andika_baiti(4); andika_baiti(37); andika_neno4(36864);
    // mov ebx, eax
    andika_baiti(137); andika_baiti(195);
    // add ebx, ebx  (ebx = kaka*2)
    andika_baiti(1); andika_baiti(219);
    // mov ecx, 0xB8000
    andika_baiti(185); andika_neno4(753664);
    // add ebx, ecx  (ebx = anwani KAMILI ya VGA kwa kiini hiki)
    andika_baiti(1); andika_baiti(203);
    // mov byte [ebx], dl  (REGISTER-TO-MEMORY -- tofauti pekee ya
    // kimuundo na kernel_vga_andika_herufi, ambayo hutumia immediate)
    andika_baiti(136); andika_baiti(19);
    // mov byte [ebx+1], 0x0F  (attribute: nyeupe juu ya nyeusi)
    andika_baiti(198); andika_baiti(67); andika_baiti(1); andika_baiti(15);
    // inc eax  (eax bado = kaka -- edx/ebx/ecx pekee zimeguswa tangu upakiaji)
    andika_baiti(255); andika_baiti(192);
    // mov [0x9000], eax  (hifadhi kaka mpya)
    andika_baiti(137); andika_baiti(4); andika_baiti(37); andika_neno4(36864);

    andika_baiti(89);  // pop rcx
    andika_baiti(91);  // pop rbx
    andika_baiti(88);  // pop rax
    andika_baiti(90);  // pop rdx
}

// vga_herufi(usemi) -- hoja ni USEMI WOWOTE (si lazima iwe halisi),
// unaotathminiwa WAKATI WA KUKIMBIA kupitia injini ya kawaida ya
// usemi (uzalishaji_usemi -- KIOO cha jinsi hoja za kawaida za wito
// zinavyotathminiwa, angalia uzalishaji_wito karibu na uzalishaji_usemi
// (hoja_nodes_bk...)) -- TOFAUTI na uzalishaji_vga_andika (ambayo
// inahitaji mfuatano halisi pekee, haiwezi kuandika herufi
// iliyokokotolewa wakati wa kukimbia).
w0 uzalishaji_vga_herufi(n32 nodi, n32 kazi_nodi) {
    n32 a0 = mti_kulia[nodi];
    kama (a0 == -1) {
        andika_stderr("KOSA: --kernel -- vga_herufi() inahitaji hoja moja (usemi)\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    uzalishaji_usemi(a0, kazi_nodi);
    kernel_vga_andika_herufi_rt();
}

// kbd_scancode() -- soma "PS/2 data port" (0x60): baiti ya mwisho ya
// scancode kutoka kwa kidhibiti cha kibodi (8042). Hakuna hoja;
// thamani inabaki kwenye eax baada ya kuitwa (mkataba wa kurudi wa
// hali hii, kioo cha jinsi ukubwa()/urefu() zinavyorudisha). Kusoma
// port ya I/O kwa IN/OUT haihitaji ruhusa maalum kwenye ring 0 (CPL=0)
// -- hakuna TSS I/O bitmap inayohitajika hapa.
w0 uzalishaji_kbd_scancode(n32 nodi, n32 kazi_nodi) {
    // xor eax, eax  (safisha nusu ya juu KABLA -- "in al" inaandika AL
    // pekee, HAIPANUZI sifuri moja kwa moja)
    andika_baiti(49); andika_baiti(192);
    // in al, 0x60
    andika_baiti(228); andika_baiti(96);
}

// Songesha kaka kwenda mwanzo wa mstari unaofuata (mfano wa "\n") --
// kaka_mpya = ((kaka / 80) + 1) * 80. Rejesta rax/rcx/rdx zinahifadhiwa.
w0 kernel_vga_andika_mstari_mpya() {
    andika_baiti(80);  // push rax
    andika_baiti(81);  // push rcx
    andika_baiti(82);  // push rdx

    // mov eax, [0x9000]
    andika_baiti(139); andika_baiti(4); andika_baiti(37); andika_neno4(36864);
    // xor edx, edx  (thibitisha nusu ya juu ya dividend ni sifuri kabla ya div)
    andika_baiti(49); andika_baiti(210);
    // mov ecx, 80
    andika_baiti(185); andika_neno4(80);
    // div ecx  (eax = kaka/80, edx = kaka%80 -- edx hatuitumii)
    andika_baiti(247); andika_baiti(241);
    // inc eax  (mstari unaofuata)
    andika_baiti(255); andika_baiti(192);
    // mov ecx, 80
    andika_baiti(185); andika_neno4(80);
    // mul ecx  (eax = (mstari_unaofuata) * 80 -- thamani ndogo, edx haizingatiwi)
    andika_baiti(247); andika_baiti(225);
    // mov [0x9000], eax
    andika_baiti(137); andika_baiti(4); andika_baiti(37); andika_neno4(36864);

    andika_baiti(90);  // pop rdx
    andika_baiti(89);  // pop rcx
    andika_baiti(88);  // pop rax
}

// vga_andika("...") -- hoja LAZIMA iwe mfuatano halisi (literal),
// SI kigezo (toleo la kwanza -- kioo cha jinsi andika() inavyohitaji
// halisi kwa njia yake ya haraka ya kukusanya). Herufi zinatolewa
// MOJA BAADA YA NYINGINE (haziungwi kwenye kitanzi cha wakati wa
// kukimbia) -- rahisi na sahihi kwa mfuatano mfupi wa ujumbe wa
// kernel; utorokaji unaotambuliwa: \n (mstari mpya), \\, \" (herufi
// halisi) -- nyingine yoyote inatolewa kama herufi iliyofuata
// backslash moja kwa moja (backslash yenyewe inaruka).
w0 uzalishaji_vga_andika(n32 nodi, n32 kazi_nodi) {
    n32 a0 = mti_kulia[nodi];
    kama (a0 == -1 || mti_aina[a0] != 5) {
        andika_stderr("KOSA: --kernel -- vga_andika() inahitaji hoja moja ya mfuatano halisi (si kigezo)\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    n8* umbo = mti_dimbwi + mti_jina_ofseti[a0];
    kama (umbo[0] != 34) {
        andika_stderr("KOSA: --kernel -- vga_andika() inahitaji mfuatano halisi (kuanzia na nukuu)\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    n32 urefu_m = jina_urefu(umbo);  // jumla, ikiwa na nukuu mbili
    n32 p = 1;  // baada ya nukuu ya mwanzo
    wakati (p < urefu_m - 1) {
        n8 ch = umbo[p];
        kama (ch == 92 && p + 1 < urefu_m - 1) {  // '\'
            n8 inayofuata = umbo[p + 1];
            kama (inayofuata == 110) {  // \n -- mstari mpya
                kernel_vga_andika_mstari_mpya();
            } sivyo {
                // \\ , \" , au utorokaji usiotambuliwa -- herufi
                // iliyofuata backslash inatolewa moja kwa moja.
                kernel_vga_andika_herufi(inayofuata);
            }
            p = p + 2;
        } sivyo {
            kernel_vga_andika_herufi(ch);
            p = p + 1;
        }
    }
}

// Ukaguzi wa wigo wa --kernel (hali_exe_sasa==2): tembea AST NZIMA
// KABLA ya msimbo wowote kutolewa, ukikataa ujenzi ulio nje ya wigo
// kwa kosa la wazi (kioo cha wasm_kagua_enc_kigezo, Awamu 1 ya WASM).
// PIA inathibitisha kernel_main ni kazi ya KWANZA iliyotangazwa --
// bila hii, "call kernel_main" ya kiini.s (Kawira, Sehemu 1) ingeruka
// kwenye ofseti 0 ya pato ambayo SI kernel_main halisi.
w0 kernel_kagua_wigo(n32 mzizi) {
    n32 kwanza_kazi_jina_sawa = 0;
    n32 kwanza_kazi_imeonekana = 0;
    n32 nodi = mti_kushoto[mzizi];
    wakati (nodi != -1) {
        kama (mti_aina[nodi] == MTI_KAZI) {
            kama (mti_tiga[nodi] != -1) {  // ina mwili (si tamko la mbele)
                kama (kwanza_kazi_imeonekana == 0) {
                    kwanza_kazi_imeonekana = 1;
                    n8* jkwanza = mti_dimbwi + mti_jina_ofseti[mti_kushoto[nodi]];
                    kama (jina_linganisha(jkwanza, "kernel_main")) { kwanza_kazi_jina_sawa = 1; }
                }
                kernel_kagua_kazi_mwili(nodi);
            }
        } sivyo { kama (mti_aina[nodi] == MTI_MUUNDO) {
                andika_stderr("KOSA: --kernel -- miundo (muundo) yako nje ya wigo (hakuna kumbukumbu inayosimamiwa bado)\n");
                wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
            } sivyo { kama (mti_aina[nodi] == MTI_TANGAZO_ULIMWENGU) {
                    andika_stderr("KOSA: --kernel -- vigezo vya ulimwengu (global) viko nje ya wigo\n");
                    wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
                } } }
        nodi = mti_nne[nodi];
    }
    kama (kwanza_kazi_imeonekana == 0) {
        andika_stderr("KOSA: --kernel -- hakuna kazi 'kernel_main'\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    kama (kwanza_kazi_jina_sawa == 0) {
        andika_stderr("KOSA: --kernel -- 'kernel_main' LAZIMA iwe kazi ya KWANZA iliyotangazwa kwenye chanzo (angalia hati/mipaka.md ya Kawira)\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
}

// Tembea taarifa za mwili wa kazi MOJA, ukikataa D32/D64 na 'chagua'
// popote zinapoonekana (miundo/globals tayari zimekaguliwa ngazi ya
// juu na kernel_kagua_wigo).
w0 kernel_kagua_kazi_mwili(n32 kazi_nodi) {
    n32 matokeo_usimbaji = mti_thamani[kazi_nodi];
    kama (ni_desimali_usimbaji(matokeo_usimbaji)) {
        andika_stderr("KOSA: --kernel -- d32/d64 ziko nje ya wigo (aina ya kurudi)\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    n32 pn = mti_kulia[kazi_nodi];
    wakati (pn != -1) {
        kama (ni_desimali_usimbaji(mti_thamani[pn])) {
            andika_stderr("KOSA: --kernel -- d32/d64 ziko nje ya wigo (aina ya hoja)\n");
            wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        }
        pn = mti_nne[pn];
    }
    kernel_kagua_taarifa(mti_tiga[kazi_nodi]);
}

w0 kernel_kagua_taarifa(n32 nodi) {
    kama (nodi == -1) { rudisha; }
    n32 aina = mti_aina[nodi];
    kama (aina == MTI_CHAGUA) {
        andika_stderr("KOSA: --kernel -- 'chagua' iko nje ya wigo\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    kama (aina == MTI_TANGAZO && ni_desimali_usimbaji(mti_thamani[mti_kushoto[nodi]])) {
        andika_stderr("KOSA: --kernel -- d32/d64 ziko nje ya wigo (tangazo la ndani)\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    kama (aina == MTI_KAMA) {
        // Muundo (uzalishaji_kama, karibu na mstari 3196): cond=
        // ast_kushoto, then_body=ast_kulia, "sivyo" wrapper node
        // (ikiwa ipo) = ast_tiga, else_body = ast_kushoto[sivyo_node].
        kernel_kagua_taarifa(mti_kulia[nodi]);
        n32 sivyo_nodi = mti_tiga[nodi];
        kama (sivyo_nodi != -1) {
            kernel_kagua_taarifa(mti_kushoto[sivyo_nodi]);
        }
    }
    kama (aina == MTI_WAKATI) {
        // Muundo (uzalishaji_wakati, karibu na mstari 3540): cond=
        // ast_kushoto, body=ast_kulia, init (kwa "kwa"-loop)=ast_tiga.
        n32 kianzio = mti_tiga[nodi];
        kama (kianzio != -1) { kernel_kagua_taarifa(kianzio); }
        kernel_kagua_taarifa(mti_kulia[nodi]);
    }
    kama (aina == MTI_KIZUIZI) {
        // Kioo cha wasm_taarifa (uzalishaji_wasm.swa): mwili wa block
        // (hatua ya "kwa") uko ast_kushoto.
        kernel_kagua_taarifa(mti_kushoto[nodi]);
    }
    kernel_kagua_taarifa(mti_nne[nodi]);  // ndugu inayofuata
}

// Kazi TOFAUTI (si sehemu ya uzalishaji_kuu moja kwa moja) kwa
// makusudi -- vigeu vyake vya ndani (kri/kpos/knje_idx/knafasi)
// visingeweza kuongezwa moja kwa moja kwenye uzalishaji_kuu bila
// kuvunja kikomo cha "vigezo vya ndani vimezidi 64" (uzalishaji_kuu
// tayari iko karibu na kikomo -- imegunduliwa kwa vitendo: kuzijumlisha
// hapo kuligeuza ujenzi wa stage1 kutoka kwa stage1 kuwa batili).
// Rekebisha (patch) kila `rela_idadi` ya --kernel (hali_exe==2) kwa
// anwani ya JAMAA (relative) ndani ya bafa_text pekee -- angalia
// maelezo kamili ya SABABU (mdudu wa RELA usioshughulikiwa) kwenye
// maoni ya uzalishaji_kuu karibu na mahali hii inapoitwa.
w0 kernel_rekebisha_rela() {
    n32 kri = 0;
    wakati (kri < rela_idadi) {
        n32 kpos = rela_text_ofseti[kri];
        n32 knje_faharasa = rela_nje_id[kri];
        kama (knje_faharasa == -1) {
            andika_stderr("KOSA: --kernel -- kigezo cha ulimwengu (global) kimeonekana kwenye urekebishaji (haipaswi kutokea -- kernel_kagua_wigo ilishakataa)\n");
            wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        }
        n32 knafasi = kazi_nafasi_kwa_jina(nje_dimbwi + nje_jina_ofseti[knje_faharasa]);
        kama (knafasi < 0) {
            andika_stderr("Hitilafu: kazi haijafafanuliwa: %s\n", nje_dimbwi + nje_jina_ofseti[knje_faharasa]);
            wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        }
        andika_disp32_kwenye(bafa_text, kpos, knafasi - (kpos + 4));
        kri = kri + 1;
    }
}

// ==========================================================
// Hoja za wito kwa System V kamili (hoja za rafu zikichanganyika)
// ==========================================================
// Hoja za namba huchukua rdi, rsi, rdx, rcx, r8, r9; za desimali
// xmm0-xmm7; zinazozidi huenda rafuni KWA MPANGILIO WA HOJA, bila
// kujali aina. Kitanzi cha pop cha uzalishaji_wito ni sahihi tu ikiwa
// hakuna hoja ya rejesta baada ya hoja ya rafu.

n32 wito_gp_jumla = 0;
n32 wito_xmm_jumla = 0;
n32 wito_rafu_j[32];

n32 hoja_ni_desimali(n32 msingi, n8* callee, n32 j) {
    n32 usimbaji = hoja_usimbaji_bk[msingi + j];
    n32 usimbaji_p = mkaguzi_tafuta_kigezo_usimbaji(callee, j);
    kama (usimbaji_p > 0) { usimbaji = usimbaji_p; }
    rudisha ni_desimali_usimbaji(usimbaji);
}

// Rudisha 1 ikiwa hoja ya rejesta inafuata hoja ya rafu. Hujaza
// wito_gp_jumla / wito_xmm_jumla (jumla halisi, kwa usafishaji).
n32 hoja_zimechanganyika(n32 msingi, n32 hoja_n, n8* callee, n32 gp_anza) {
    n32 gp = gp_anza;
    n32 xmm = 0;
    n32 rafu_imeonekana = 0;
    n32 imechanganyika = 0;
    n32 j = 0;
    wakati (j < hoja_n) {
        kama (hoja_ni_desimali(msingi, callee, j)) {
            kama (xmm < 8) { kama (rafu_imeonekana) { imechanganyika = 1; } }
            sivyo { rafu_imeonekana = 1; }
            xmm = xmm + 1;
        } sivyo {
            kama (gp < 6) { kama (rafu_imeonekana) { imechanganyika = 1; } }
            sivyo { rafu_imeonekana = 1; }
            gp = gp + 1;
        }
        j = j + 1;
    }
    wito_gp_jumla = gp;
    wito_xmm_jumla = xmm;
    rudisha imechanganyika;
}

// mov <rejesta ya hoja ya namba nambari>, [rsp + d32]
w0 andika_pakia_gp_hoja_rsp(n32 nambari, n32 d) {
    n32 rex = 72;     // 48: REX.W
    n32 msimbo = 7;   // rdi
    kama (nambari == 1) { msimbo = 6; }   // rsi
    kama (nambari == 2) { msimbo = 2; }   // rdx
    kama (nambari == 3) { msimbo = 1; }   // rcx
    kama (nambari == 4) { rex = 76; msimbo = 0; }  // r8 (4C: REX.W|REX.R)
    kama (nambari == 5) { rex = 76; msimbo = 1; }  // r9
    andika_baiti(rex); andika_baiti(139);
    andika_baiti(132 + msimbo * 8); andika_baiti(36);
    andika_neno4(d);
}

// movsd/movss xmmN, [rsp + d32]
w0 andika_pakia_xmm_hoja_rsp(n32 nambari, n32 baiti_8, n32 d) {
    kama (baiti_8) { andika_baiti(242); } sivyo { andika_baiti(243); }
    andika_baiti(15); andika_baiti(16);
    andika_baiti(132 + nambari * 8); andika_baiti(36);
    andika_neno4(d);
}

// Hoja zote ziko rafuni (hoja 0 juu kabisa; ikiwa arg0_moja, hoja 0 iko
// tayari kwenye rdi/xmm0 na haimo rafuni). Pakia za rejesta kwa ofseti,
// kisha bana za rafu ziwe juu kwa mpangilio wa hoja.
w0 hoja_kwa_sysv(n32 msingi, n32 hoja_n, n8* callee, n32 hoja0_moja, n32 gp_anza) {
    n32 gp = gp_anza;
    n32 xmm = 0;
    n32 rafu = 0;
    n32 j = 0;
    wakati (j < hoja_n) {
        n32 ni_d = hoja_ni_desimali(msingi, callee, j);
        n32 sloti = j - hoja0_moja;
        kama (j == 0 && hoja0_moja == 1) {
            kama (ni_d) { xmm = xmm + 1; } sivyo { gp = gp + 1; }
        } sivyo { kama (ni_d) {
            kama (xmm < 8) {
                n32 usimbaji = hoja_usimbaji_bk[msingi + j];
                n32 usimbaji_p = mkaguzi_tafuta_kigezo_usimbaji(callee, j);
                kama (usimbaji_p > 0) { usimbaji = usimbaji_p; }
                andika_pakia_xmm_hoja_rsp(xmm, ukubwa_kutoka_usimbaji(usimbaji) >= 8, sloti * 8);
            } sivyo {
                wito_rafu_j[rafu] = sloti;
                rafu = rafu + 1;
            }
            xmm = xmm + 1;
        } sivyo {
            kama (gp < 6) {
                andika_pakia_gp_hoja_rsp(gp, sloti * 8);
            } sivyo {
                wito_rafu_j[rafu] = sloti;
                rafu = rafu + 1;
            }
            gp = gp + 1;
        } }
        j = j + 1;
    }
    n32 sloti_zote = hoja_n - hoja0_moja;
    n32 k = rafu - 1;
    wakati (k >= 0) {
        n32 kutoka = wito_rafu_j[k];
        n32 kwenda = sloti_zote - rafu + k;
        kama (kutoka != kwenda) {
            // mov r11, [rsp+kutoka*8]; mov [rsp+kwenda*8], r11
            andika_baiti(76); andika_baiti(139); andika_baiti(156); andika_baiti(36);
            andika_neno4(kutoka * 8);
            andika_baiti(76); andika_baiti(137); andika_baiti(156); andika_baiti(36);
            andika_neno4(kwenda * 8);
        }
        k = k - 1;
    }
    kama (sloti_zote - rafu > 0) {
        // add rsp, imm32 -- ondoa sloti za hoja za rejesta
        andika_baiti(72); andika_baiti(129); andika_baiti(196);
        andika_neno4((sloti_zote - rafu) * 8);
    }
}

w0 uzalishaji_wito(n32 nodi, n32 kazi_nodi) {
    ni_mfumo_wito = 0;
    ni_tekeleza_wito = 0;
    ni_andika_nje = 0;
    n32 callee_nodi = mti_kushoto[nodi];
    n8* callee = mti_dimbwi + mti_jina_ofseti[callee_nodi];

    // --kernel (hali_exe_sasa==2, Kawira): I/O ya Linux (syscalls,
    // andika, tekeleza) HAIPO -- hakuna kernel ya chini kuipokea.
    // vga_andika ni MPYA, PEKEE inayoruhusiwa kwa I/O, inatambuliwa
    // KWA JINA (kioo cha jinsi "ukubwa"/"urefu" tayari zinatambuliwa
    // hapa juu, na jinsi Awamu 3 ya WASM ilivyoongeza dom_unda).
    kama (hali_exe_sasa == 2) {
        kama (jina_linganisha(callee, "vga_andika")) {
            uzalishaji_vga_andika(nodi, kazi_nodi);
            rudisha;
        }
        kama (jina_linganisha(callee, "vga_herufi")) {
            uzalishaji_vga_herufi(nodi, kazi_nodi);
            rudisha;
        }
        kama (jina_linganisha(callee, "kbd_scancode")) {
            uzalishaji_kbd_scancode(nodi, kazi_nodi);
            rudisha;
        }
        kama (jina_linganisha(callee, "wito_wa_mfumo") || jina_linganisha(callee, "andika") ||
        jina_linganisha(callee, "andika_stderr") || jina_linganisha(callee, "tekeleza") ||
        jina_linganisha(callee, "tenga") || jina_linganisha(callee, "achilia_arena")) {
            andika_stderr("KOSA: --kernel -- '%s' iko nje ya wigo (hakuna syscalls/I/O ya Linux kwenye ring 0, tumia vga_andika() pekee)\n", callee);
            wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        }
    }

    // Wito maalum wa ukubwa(aina) — kokotoa ukubwa wakati wa kukusanya
    // (sizeof). Hoja ni jina la aina; hatutoi wito wa kweli.
    kama (jina_linganisha(callee, "ukubwa")) {
        n32 a0 = mti_kulia[nodi];
        kama (a0 != -1 && mti_aina[a0] == 5) {  // KITAMBULISHO — jina la aina au kigeu
            andika_mov_eax(ukubwa_wa_jina(mti_dimbwi + mti_jina_ofseti[a0]));
            rudisha;
        }
    }

    // Wito maalum wa urefu(safu) — idadi ya vipengele vilivyotangazwa
    // vya safu ya ULIMWENGU (global) yenye ukubwa maalum, kokotoa
    // wakati wa kukusanya (lengthof). Hoja ni jina la kigezo cha safu
    // (SI aina, SI kigezo cha ndani/paramu -- toleo la kwanza
    // linashughulikia safu za ulimwengu pekee, angalia maelezo ya
    // data_ulimwengu_idadi_ya_kipengele juu ya faili hili). Kigezo
    // kisicho safu ya ulimwengu ni hitilafu WAZI ya kukusanya, si
    // tabia ya kimya isiyo sahihi -- lugha-swa/swa#197 ilitokana na
    // namba mbili zilizowekwa kwa mkono zisizoendana; kipengele hiki
    // kipya lazima kisianzishe aina mpya ya uharibifu wa kimya.
    kama (jina_linganisha(callee, "urefu")) {
        n32 a0 = mti_kulia[nodi];
        kama (a0 != -1 && mti_aina[a0] == 5) {  // KITAMBULISHO
            n8* jina_a = mti_dimbwi + mti_jina_ofseti[a0];
            n32 gi = 0;
            n32 imepatikana = 0;
            wakati (gi < data_ulimwengu_idadi) {
                n8* gjina = mti_dimbwi + data_ulimwengu_jina_ofseti[gi];
                kama (jina_linganisha(gjina, jina_a) && data_ulimwengu_ni_safu[gi] == 1) {
                    andika_mov_eax(data_ulimwengu_idadi_ya_kipengele[gi]);
                    imepatikana = 1;
                    gi = data_ulimwengu_idadi;  // toka kwenye kitanzi
                } sivyo {
                    gi = gi + 1;
                }
            }
            kama (imepatikana == 0) {
                andika_stderr("Hitilafu: urefu(%s) -- '%s' si safu ya ulimwengu (global) yenye ukubwa maalum. urefu() ya toleo hili inashughulikia tu safu za ulimwengu zilizotangazwa moja kwa moja (mfano n8 x[1024];), si vigezo vya ndani wala paramu.\n", jina_a, jina_a);
                wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
            }
            rudisha;
        }
        andika_stderr("Hitilafu: urefu(...) inahitaji hoja moja ya kitambulisho cha safu ya ulimwengu.\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }

    // Wito wa mfumo (syscall) — builtin: hoja (namba, a1..a5) zinapangwa
    // kwa ABI ya syscall: rax=namba, rdi=a1, rsi=a2, rdx=a3, r10=a4, r8=a5, r9=0.
    kama (jina_linganisha(callee, "wito_wa_mfumo")) {
        ni_mfumo_wito = 1;
    }

    // tekeleza — builtin ya JIT: ita bafa ya kumbukumbu kama kazi
    // n32(n32, n8**). Hoja (kazi, argc, argv, ofseti) zinafika kwenye
    // rdi/rsi/rdx/rcx kwa mpangilio wa kawaida; builtin inazipanga:
    // rdi=argc, rsi=argv+ofseti*8, al=0, call r11 (kazi).
    kama (jina_linganisha(callee, "tekeleza")) {
        ni_tekeleza_wito = 1;
    }

    // Wito maalum wa andika/andika_stderr — uchapishaji wakati wa kukusanya.
    // Codegen inachanganua muundo na kutoa wito wa kazi za ndani za
    // kuchapisha (andika_sehemu, andika_n64, andika_mfuatano, andika_baiti).
    kama (jina_linganisha(callee, "andika") || jina_linganisha(callee, "andika_stderr")) {
        n32 a0 = mti_kulia[nodi];
        // Kama kazi za kuchapisha za ndani hazipo (program ya mtumiaji
        // bila maktaba), angukia kwenye wito wa nje wa C (andika ya muda).
        kama (kazi_nafasi_kwa_jina("andika_sehemu") < 0) { ni_andika_nje = 1; }
        kama (a0 != -1 && mti_aina[a0] == 5 && ni_andika_nje == 0) {
            n8* umbo = mti_dimbwi + mti_jina_ofseti[a0];
            // Njia ya kukusanya-wakati inatumika kwa halisi ya kamba
            // PEKEE (mwanzo wake ni nukuu ya mwanzo). Kigeu kama umbo
            // (mf. andika(bafa)) kinapaswa kuingia kwenye wito wa
            // kawaida — andika_ndani huchakata umbo wakati wa
            // kukimbia. Zamani jina la kigeu lenyewe lilitumiwa kama
            // umbo (herufi ya kwanza na ya mwisho zikipotea kimya,
            // mf. bafa ikichapishwa "af").
            kama (umbo[0] == 34) {
                n32 fd = 1;
                kama (jina_linganisha(callee, "andika_stderr")) { fd = 2; }
                n32 urefu_m = jina_urefu(umbo);
                n32 h = mti_tiga[a0];
                n32 p = 1;  // baada ya nukuu ya mwanzo
                n32 mwanzo_sehemu = 1;
                wakati (p < urefu_m) {
                    // Utorokaji (\n, \\, \%, ...): ruka jozi nzima ili
                    // ibaki kwenye sehemu — sehemu_tungo_hifadhi huitafsiri
                    // (8.2: \% lilionekana kama direktiba ya '%' na kula
                    // herufi iliyofuata; \% sasa inachapisha asilimia).
                    kama (umbo[p] == 92) {
                        kama (p + 1 < urefu_m) { p = p + 2; } sivyo { p = p + 1; }
                    } sivyo { kama (umbo[p] == 37) {  // '%'
                        kama (p > mwanzo_sehemu) {
                            n32 lebo = sehemu_tungo_hifadhi(umbo + mwanzo_sehemu, p - mwanzo_sehemu);
                            kama (lebo >= 0) { andika_wito_sehemu(fd, lebo, sehemu_urefu[sehemu_idadi - 1]); }
                        }
                        n8 sp = umbo[p + 1];
                        kama (sp == 37) {  // %% — asilimia halisi (hatumii hoja)
                            andika_mov_eax(37);
                            andika_wito_baiti(fd);
                        } sivyo { kama (h != -1) {
                                kama (sp == 100) {  // %d
                                    // lugha-swa/swa#305: `enc_h` HAPO AWALI
                                    // ilitumia `ast_thamani[h]`/`ast_nne[h]`
                                    // moja kwa moja -- hii HUKAMATA TU usemi
                                    // ulio HALISI YA DESIMALI YENYEWE (aina==45),
                                    // SI usemi WOWOTE wa d64 (wito wa kazi,
                                    // operesheni ya hisabati, kigezo cha d64).
                                    // `aina_ya_usemi(h)` ndiyo kazi SAHIHI ya
                                    // kutambua aina ya usemi WOWOTE (inatumika
                                    // kila mahali pengine kwenye faili hili).
                                    // Bila marekebisho haya, usemi wa d64
                                    // (mfano `x * 1000.0` au wito wa kazi
                                    // unaorudisha d64) uliacha thamani kwenye
                                    // xmm0 (ABI ya desimali), LAKINI
                                    // andika_wito_n64 husoma rax -- rax
                                    // ilibaki na TAKATAKA ya hesabu
                                    // iliyotangulia (mfano anwani ya
                                    // kumbukumbu), ikichapishwa KIMYA bila
                                    // hitilafu. Suluhisho: ikiwa usemi ni
                                    // desimali, tumia `badili_mpaka_wa_desimali`
                                    // (kazi ILIYOPO tayari, inayotumika
                                    // kwenye kila mahali pengine panapohitaji
                                    // mpaka wa kamili/desimali) kuibadilisha
                                    // hadi n64 kwenye rax (cvttsd2si/
                                    // cvttss2si) KABLA ya kuichapisha.
                                    n32 usimbaji_h = aina_ya_usemi(h);
                                    uzalishaji_usemi(h, kazi_nodi);
                                    kama (ni_desimali_usimbaji(usimbaji_h)) {
                                        badili_mpaka_wa_desimali(h, encode_aina(1, 64, 0));
                                    } sivyo { kama (ukubwa_kutoka_usimbaji(usimbaji_h) < 8) { andika_cdqe(); } }
                                    andika_wito_n64(fd);
                                } sivyo { kama (sp == 115) {  // %s
                                        uzalishaji_usemi(h, kazi_nodi);
                                        andika_wito_mfuatano(fd);
                                    } sivyo { kama (sp == 99) {  // %c
                                            uzalishaji_usemi(h, kazi_nodi);
                                            andika_wito_baiti(fd);
                                        } } }
                                h = mti_tiga[h];
                            } }
                        p = p + 2;
                        mwanzo_sehemu = p;
                    } sivyo {
                        p = p + 1;
                    } }
                }
                kama (urefu_m - 1 > mwanzo_sehemu) {
                    n32 lebo = sehemu_tungo_hifadhi(umbo + mwanzo_sehemu, urefu_m - 1 - mwanzo_sehemu);
                    kama (lebo >= 0) { andika_wito_sehemu(fd, lebo, sehemu_urefu[sehemu_idadi - 1]); }
                }
                rudisha;
            }
        }
    }

    // Angalia kama kazi ni ya ndani na ikiwa inarudisha muundo (sret)
    n32 ni_ndani = 0; n32 ndani_ofseti = 0;
    n32 callee_matokeo_usimbaji = 0; n32 callee_ni_mm = 0; n32 mm_size = 0;
    n32 l = 0;
    wakati (l < lebo_idadi) {
        kama (jina_linganisha(lebo_jina[l], callee)) {
            ni_ndani = 1; ndani_ofseti = lebo_nafasi[l];
            callee_matokeo_usimbaji = lebo_matokeo_usimbaji[l];
            kama (ni_muundo_usimbaji(callee_matokeo_usimbaji)) {
                callee_ni_mm = 1;
                kama (callee_matokeo_usimbaji < 0) {
                    n32 name_ofseti = ((-callee_matokeo_usimbaji) / 2) - 1;
                    kama ((callee_matokeo_usimbaji / 2) * 2 != callee_matokeo_usimbaji) { name_ofseti = name_ofseti + 1; }
                    mm_size = ukubwa_wa_muundo_kwa_jina(mti_dimbwi + name_ofseti);
                }
                kama (mm_size == 0) { mm_size = 8; }
                // Panga kwa 16
                kama ((mm_size & 15) != 0) {
                    mm_size = mm_size + (16 - (mm_size & 15));
                }
            }
            vunja;
        }
        l = l + 1;
    }
    // Kazi ya nje: kipande chake huandikwa baada ya kazi zote, hivyo
    // lebo yake haipo bado -- matokeo ya muundo hujulikana kutoka kichwa.
    kama (ni_ndani == 0) {
        n32 kg_k = kigeni_kazi_kwa_jina(callee);
        kama (kg_k >= 0) {
            n32 kg_matokeo = mti_thamani[kigeni_kazi_nodi[kg_k]];
            kama (ni_muundo_usimbaji(kg_matokeo)) {
                callee_ni_mm = 1;
                mm_size = ukubwa_kutoka_usimbaji(kg_matokeo);
                kama ((mm_size & 15) != 0) {
                    mm_size = mm_size + (16 - (mm_size & 15));
                }
            }
        }
    }

    // Wito wa kielekezi cha kazi: callee ni kigeu/paramu chenye anwani
    // (k.m. bafa ya JIT au &jina_la_kazi) — vigeu vya ndani na paramu
    // zimeandikishwa kwenye var_idadi na uzalishaji_kazi. Kielekezi
    // hupakiwa na wito hutolewa kwa call r11. Kigeu cha ulimwengu
    // kinafuatwa hapa pia — mzalishaji_kitambulisho hukipakia kutoka
    // kwa rip-rel.
    n32 ni_kielekezi = 0;
    kama (ni_ndani == 0) {
        n32 vi = 0;
        wakati (vi < kigeu_idadi) {
            kama (jina_linganisha(kigeu_dimbwi + kigeu_jina_ofseti[vi], callee)) {
                ni_kielekezi = 1;
                vunja;
            }
            vi = vi + 1;
        }
    }
    kama (ni_kielekezi == 0) {
        n32 gi = 0;
        wakati (gi < data_ulimwengu_idadi) {
            n8* gjina = mti_dimbwi + data_ulimwengu_jina_ofseti[gi];
            kama (jina_linganisha(gjina, callee)) {
                ni_kielekezi = 1;
                vunja;
            }
            gi = gi + 1;
        }
    }

    // Kusanya hoja kwenye safu (tumia bafa ya ulimwengu)
    // Hoja zimefungwa kupitia ast_tiga katika mchanganuzi wa Swa
    hoja_idadi = 0;
    n32 a = mti_kulia[nodi];
    wakati (a != -1) {
        kama (hoja_idadi < 32) {
            hoja_nodi[hoja_idadi] = a;
            hoja_usimbaji[hoja_idadi] = mti_thamani[a];
            kama (mti_aina[a] == 45) { hoja_usimbaji[hoja_idadi] = mti_nne[a]; }  // HALISI_D: enc iko ast_nne
            kama (mti_aina[a] == 4) { hoja_usimbaji[hoja_idadi] = mti_nne[a]; }  // AST_NAMBARI: enc iko ast_nne (thamani iko ast_thamani)
            // lugha-swa/swa#295 -- AST_SAWA..AST_JUU_SAWA (20-25,
            // ulinganishi == != < > <= >=): ast_thamani ya nodi hizi
            // ni aina ya OPERANDI zilizolinganishwa (angalia
            // mkaguzi_kagua_usemi() kwenye mkaguzi.swa -- ulinganishi
            // hupita kupitia mantiki ile ile ya kupandisha aina
            // inayotumika na hesabu), SI aina ya MATOKEO ya
            // ulinganishi (ambayo NI DAIMA 0/1, ENC_ULINGANISHI -- angalia
            // aina_ya_usemi() juu ya faili hili, ambayo tayari ina
            // ubaguzi huu kwa matumizi mengine). Bila ubaguzi huu
            // hapa pia, hoja ya ulinganishi (k.m.
            // f(mvutano == 0.0, "...") ambapo mvutano ni d64)
            // ilichukuliwa kimakosa kama hoja ya d64 -- ikisababisha
            // uzalishaji_wito kubadilisha matokeo ya B1 (tayari
            // kwenye eax) kuwa xmm0 (cvtsi2sd) badala ya kuliacha
            // kwenye eax/rdi, ikivuruga mpangilio wa rejesta za hoja
            // zilizofuata (hoja ya mfuatano ikaishia kwenye rejesta
            // isiyo sahihi, ikisoma thamani ya zamani isiyohusiana --
            // "anwani za string literal zinazochanganyikiwa" ya #295).
            kama (mti_aina[a] >= 20 && mti_aina[a] <= 25) { hoja_usimbaji[hoja_idadi] = USIMBAJI_ULINGANISHI; }
            hoja_idadi = hoja_idadi + 1;
        } sivyo {
            // Ulinzi wa ziada: mkaguzi.swa tayari inakataa wito wenye
            // hoja zaidi ya 16 kabla ya kufika hapa (kikomo hiki cha 32
            // hakipaswi kufikiwa kwa kawaida) -- kama ujumbe huu
            // umeonekana, njia ya ukaguzi imepitwa mahali fulani.
            andika_stderr("KOSA: bafa ya hoja za wito (hoja_nodes/hoja_enc) imejaa (kikomo 32) — hii haipaswi kutokea, mkaguzi anapaswa kuwa amekataa wito huu tayari\n");
            wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        }
        a = mti_tiga[a];  // hoja inayofuata kupitia ast_tiga
    }

    // Nakili meza ya hoja kwenye chelezo: wito wa ndani wakati wa tathmini
    // utaandika tena hoja_nodes/hoja_enc/hoja_idadi za kimataifa.
    // Kila kina cha wito kina nafasi yake (32 × 8).
    hoja_undani = hoja_undani + 1;
    kama (hoja_undani > 8) { hoja_undani = 8; }
    n32 msingi = (hoja_undani - 1) * 32;
    n32 hoja_n = hoja_idadi;
    n32 hb = 0;
    wakati (hb < hoja_n) {
        hoja_nodi_bk[msingi + hb] = hoja_nodi[hb];
        hoja_usimbaji_bk[msingi + hb] = hoja_usimbaji[hb];
        hoja_muundo_bk[msingi + hb] = 0;  // usafishe alama ya zamani
        hb = hb + 1;
    }

    // Tathmini hoja kutoka kulia kwenda kushoto, sukuma kwenye rafu
    // Hifadhi thamani kwenye rafu ili zisipotee wakati wa kutathmini hoja nyingine
    // Hoja ya KWANZA (namba 0) hutathminiwa MWISHO na kuvutwa KWANZA; kwa
    // wito wa kawaida (si sret, si syscall, si tekeleza, si wito wa
    // kielekezi) haihitaji kupita rafuni: namba kamili -> mov rdi, rax;
    // desimali inabaki xmm0. Kila kitu kingine kinabaki kama zamani.
    // (bendera za ni_syscall_wito n.k. ni za ulimwengu na huandikwa upya
    // na wito ulioota ndani ya hoja, kwa hiyo hali inarekodiwa hapa.)
    n32 kuna_muundo = 0;   // nakala za miundo hutegemea sloti za rafu [rsp + j*8]
    n32 kk = 0;
    wakati (kk < hoja_n) {
        kama (ni_muundo_usimbaji(hoja_usimbaji_bk[msingi + kk])) { kuna_muundo = 1; }
        kk = kk + 1;
    }
    n32 wito_wa_kawaida = 0;
    kama (kuna_muundo == 0 && ni_mfumo_wito == 0 && ni_tekeleza_wito == 0 && ni_kielekezi == 0 && callee_ni_mm == 0) {
        wito_wa_kawaida = 1;
    }
    n32 hoja0_moja = 0;
    n32 i = hoja_n - 1;
    n32 jumla_sh = 0;
    wakati (i >= 0) {
        n32 usimbaji_h = hoja_usimbaji_bk[msingi + i];
        kama (ni_muundo_usimbaji(usimbaji_h)) {
            // Muundo kwa thamani: usemi wa muundo hutoa ANWANI
            n32 ukubwa_h = ukubwa_kutoka_usimbaji(usimbaji_h);
            kama (ukubwa_h == 0) { ukubwa_h = 4; }
            uzalishaji_anwani_ya_usemi(hoja_nodi_bk[msingi + i], kazi_nodi);
            kama (ukubwa_h > 8) {
                // Muundo mkubwa: sukuma anwani sasa; nakili kwenye bafa
                // ya muda inafanyika baada ya hoja zote (tathmini za
                // wito wa ndani zisiharishe bafa)
                kama (mti_aina[hoja_nodi_bk[msingi + i]] == 8) {
                    // Wito unaorudisha muundo (sret): nakili MARA MOJA
                    // kwenye bafa ya sret-hoja — bafa ya sret ya pamoja
                    // inaweza kuandikwa tena na wito unaofuata wa hoja
                    // nyingine. Kina cha hoja_undani kinachagua panda
                    // lake (wito wa ndani usiingiliane na wa nje).
                    n32 panda = (hoja_undani - 1) * mm_hoja_haja;
                    andika_mov_rsi_rax();  // rsi = bafa ya sret (chanzo)
                    andika_lea_rdi_rbp_ofseti(mm_hoja_bafa_ofseti - panda - jumla_sh);  // rdi = lengwa
                    andika_mov_ecx_imm32(ukubwa_h);
                    andika_rep_movsb();
                    andika_lea_rax_rbp_ofseti(mm_hoja_bafa_ofseti - panda - jumla_sh);  // rax = anwani ya nakala
                    jumla_sh = jumla_sh + ukubwa_h;
                }
                hoja_muundo_bk[msingi + i] = ukubwa_h;
                andika_push_rax();
            } sivyo {
                // Muundo mdogo: pakia thamani (baiti zilizopangwa 4/8)
                pakia_thamani_ya_muundo(ukubwa_h);
                andika_push_rax();
            }
        } sivyo {
            uzalishaji_usemi(hoja_nodi_bk[msingi + i], kazi_nodi);
            // Mpaka wa kamili/desimali kwenye hoja: hoja inabadilishwa
            // hadi aina ya parameta (jedwali la mkaguzi) — f(5) kwa
            // parameta ya d64 inatoa 5.0, f(2.5) kwa n32 inatoa 2.
            n32 usimbaji_hoja = hoja_usimbaji_bk[msingi + i];
            n32 usimbaji_kigezo = mkaguzi_tafuta_kigezo_usimbaji(callee, i);
            kama (usimbaji_kigezo > 0) { usimbaji_hoja = usimbaji_kigezo; }
            badili_mpaka_wa_desimali(hoja_nodi_bk[msingi + i], usimbaji_hoja);
            kama (i == 0 && wito_wa_kawaida == 1) {
                kama (ni_desimali_usimbaji(usimbaji_hoja) == 0) { andika_mov_rdi_rax(); }
                hoja0_moja = 1;
            } sivyo {
                sukuma_thamani(usimbaji_hoja);
            }
        }
        i = i - 1;
    }

    // Nakili miundo mikubwa kwenye bafa ya muda ya fremu (baada ya
    // tathmini zote — wito wa ndani hautengenezi nakala zilizokwisha
    // kukumbukwa). Sloti ya hoja inabadilishwa kuwa kielekezi cha bafa.
    // KUMBUKA: sloti lazima ielekeze kwenye NAKALA (lengwa), si kwenye
    // chanzo — la sivyo mabadiliko ya kigezo ndani ya kazi inayoitwa
    // yangegusa kigeu cha mpigaji moja kwa moja (semantiki ya thamani
    // imevunjwa).
    n32 jumla_w = 0;
    n32 j_w = 0;
    wakati (j_w < hoja_n) {
        n32 ukubwa_w = hoja_muundo_bk[msingi + j_w];
        kama (ukubwa_w != 0) {
            kama (mti_aina[hoja_nodi_bk[msingi + j_w]] == 8) {
                // Wito unaorudisha muundo (sret): nakala yake tayari
                // imefanywa mara moja kwenye bafa ya sret-hoja (bafa
                // ya sret ya pamoja inaweza kuandikwa tena na wito
                // unaofuata wa hoja nyingine) — usinakili tena.
                jumla_w = jumla_w + ukubwa_w;
                j_w = j_w + 1;
                endelea;
            }
            kama (jumla_w + ukubwa_w > wito_bafa_upeo) {
                andika_stderr("Hitilafu: bafa ya miundo ya wito imejaa (kubwa mno)\n");
                wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
            }
            andika_mov_rax_rsp_disp32(j_w * 8);  // rax = kielekezi cha chanzo
            andika_mov_rsi_rax();  // rsi = chanzo
            andika_lea_rdi_rbp_ofseti(wito_bafa_ofseti - jumla_w);  // rdi = lengwa
            andika_push_rdi();  // hifadhi anwani ya MWANZO wa nakala (rep movsb inasogeza rdi)
            andika_mov_ecx_imm32(ukubwa_w);
            andika_rep_movsb();
            andika_pop_rcx();  // rcx = anwani ya mwanzo wa nakala
            andika_mov_rsp_disp32_rcx(j_w * 8);  // sloti = kielekezi cha nakala
            jumla_w = jumla_w + ukubwa_w;
        }
        j_w = j_w + 1;
    }

    // Kwa wito wa kielekezi: pakia anwani ya kazi kwenye r11
    kama (ni_kielekezi) {
        uzalishaji_usemi(callee_nodi, kazi_nodi);  // rax = kielekezi
        andika_mov_r11_rax();
    }

    // Vuta hoja kutoka rafu kwenda kwa rejesta kwa mpangilio wa kushoto kwenda kulia
    // Fuatilia rejesta za GP na XMM kando — ABI ya System V AMD64
    // Hoja za desimali (float/double) huenda kwa xmm0-xmm7
    // Hoja za kawaida (int/ptr) huenda kwa rdi, rsi, rdx, rcx, r8, r9
    n32 gp_reg = 0; n32 xmm_reg = 0;
    kama (callee_ni_mm) { gp_reg = 1; }  // rdi imetengwa kwa kielekezi cha sret
    // MUHIMU (lugha-swa/swa#184): gp_reg/xmm_reg hapo juu VIMEKOMEA
    // (6 na 8 mtawalia) -- havifai kuhesabu JUMLA HALISI ya hoja za
    // kila aina, kwa sababu usafishaji wa rafu (chini, "Safisha hoja
    // za rafu zilizobaki") unahitaji kujua ni hoja NGAPI HALISI
    // zilibaki kwenye rafu bila kupakiwa kwenye rejesta -- si idadi
    // ya jumla ya hoja (hoja_n) tu. Kabla ya rekebisho hili, hesabu
    // ya usafishaji ilikuwa `hoja_n - 6` bila kujali kama hoja
    // zilizozidi 6 zilikuwa za GP au za XMM -- kazi yenye jumla ya
    // vigezo 7 (kielekezi 1 + d64 6) ilipakiwa KAMILI kwenye rejesta
    // (GP 1/6, XMM 6/8, hakuna kilichobaki rafuni), lakini
    // usafishaji ulifanya `add rsp, 8` HALISI YA UONGO kila wito --
    // ikisogeza rsp juu bila sababu kwa kila wito ndani ya kitanzi,
    // hadi kuharibu sehemu za kumbukumbu za mwitaji (rekodi ya
    // 2026-09: kaunta ya kitanzi cha mwitaji ilibadilika baada ya
    // wito 1-2 tu).
    n32 n_gp_jumla = 0; n32 n_xmm_jumla = 0;
    kama (callee_ni_mm) { n_gp_jumla = 1; }

    n32 j = 0;
    // Hoja ya rafu ikifuatiwa na hoja ya rejesta (mf. n64 saba + d64):
    // kuvuta (pop) kwa mpangilio hakufai -- hoja ya rafu iliyobaki juu
    // ingesomwa kama ile ya rejesta inayofuata. Njia ya System V kamili
    // hupakia kwa ofseti na kubana hoja za rafu (hoja_kwa_sysv). Mipangilio
    // mingine yote hubaki na kitanzi cha pop chini, baiti zile zile.
    kama (hoja_zimechanganyika(msingi, hoja_n, callee, gp_reg) != 0) {
        hoja_kwa_sysv(msingi, hoja_n, callee, hoja0_moja, gp_reg);
        n_gp_jumla = wito_gp_jumla;
        n_xmm_jumla = wito_xmm_jumla;
        j = hoja_n;
    }
    wakati (j < hoja_n) {
        // Aina ya hoja kama ilivyosukumwa: parameta ya d64 inabadilisha
        // hoja ya kamili hadi xmm0 — vuta kwa rejesta ya parameta.
        n32 usimbaji = hoja_usimbaji_bk[msingi + j];
        n32 usimbaji_p = mkaguzi_tafuta_kigezo_usimbaji(callee, j);
        kama (usimbaji_p > 0) { usimbaji = usimbaji_p; }
        kama (ni_desimali_usimbaji(usimbaji)) {
            n_xmm_jumla = n_xmm_jumla + 1;
            kama (j == 0 && hoja0_moja == 1) {
                xmm_reg = xmm_reg + 1;   // tayari xmm0 (haikusukumwa)
            } sivyo { kama (xmm_reg < 8) {
                // Vuta thamani ya desimali moja kwa moja kwenye rejesta
                // sahihi ya XMM: movsd/movss xmmN, [rsp]; add rsp, 8
                // (pop_xmm0 + movapd ilikuwa ikiharibu xmm0 ya hoja ya kwanza)
                // Upana wa D32 ni baiti 4 (movss); d64 ni baiti 8 (movsd).
                n32 saizi_h = ukubwa_kutoka_usimbaji(usimbaji);
                kama (saizi_h < 8) {
                    // movss xmmN, [rsp] (F3 0F 10 /r)
                    andika_baiti(243); andika_baiti(15); andika_baiti(16);
                } sivyo {
                    // movsd xmmN, [rsp] (F2 0F 10 /r)
                    andika_baiti(242); andika_baiti(15); andika_baiti(16);
                }
                n32 modrm = (xmm_reg & 7) * 8 + 4;  // mod=00, reg=xmmN, rm=100
                andika_baiti(modrm);
                andika_baiti(36);  // SIB: msingi rsp
                // add rsp, 8 (48 83 C4 08)
                andika_baiti(72); andika_baiti(131); andika_baiti(196); andika_baiti(8);
                xmm_reg = xmm_reg + 1;
            } }
            // TODO: rafu overflow — hoja zilizozidi rejesta 8 za XMM hazijasogezwa.
            // rsp imebadilika kutokana na pop za hoja zilizotangulia, lakini hoja
            // iliyozidi inasalia kwenye nafasi yake ya awali kwenye rafu.
            // Hili lilikuwepo hata kabla ya mabadiliko ya XMM. Linahitaji kurekebishwa
            // kwa hoja za GP na XMM zote — angalia pia mstari wa 1483.
        } sivyo {
            n_gp_jumla = n_gp_jumla + 1;
            kama (j == 0 && hoja0_moja == 1) {
                gp_reg = gp_reg + 1;     // tayari rdi (haikusukumwa)
            } sivyo { kama (gp_reg < 6) {
                kama (gp_reg == 0) { andika_pop_rdi(); }
                sivyo { kama (gp_reg == 1) { andika_pop_rsi(); }
                    sivyo { kama (gp_reg == 2) { andika_pop_rdx(); }
                        sivyo { kama (gp_reg == 3) { andika_pop_rcx(); }
                            sivyo { kama (gp_reg == 4) { andika_pop_r8(); }
                                sivyo { andika_pop_r9(); } } } } }
                gp_reg = gp_reg + 1;
            } }
            // TODO: rafu overflow — hoja zilizozidi rejesta 6 za GP hazijasogezwa.
            // rsp imebadilika lakini hoja iliyozidi haijasogezwa.
            // Hili lilikuwepo kabla ya mabadiliko ya XMM. Linahitaji kurekebishwa
            // pamoja na kesi ya XMM — angalia pia mstari wa 1472.
        }
        j = j + 1;
    }

    // Kwa sret: tumia bafa ya muda iliyotengwa kwenye fremu
    kama (callee_ni_mm) {
        // Tumia mov+sub badala ya lea kwa sababu ofseti inaweza kuwa > 127
        andika_mov_rax_rbp();  // mov rax, rbp
        andika_sub_rax_imm32(mm_bafa_ofseti);  // sub rax, sret_buf_off
        andika_mov_rdi_rax();  // mov rdi, rax
    }

    // MUHIMU (uchunguzi wa gharama ya wito): "mov al, N" (idadi ya
    // rejesta za XMM zilizotumika) ilikuwa ikiandikwa HAPA bila masharti
    // kabla ya KILA wito -- ni sharti la ABI ya SysV KWA WITO WA
    // NJE (external) VARIADIC PEKEE (mfano printf ya libc), ili kazi
    // hiyo ijue idadi ya hoja za xmm bila kuchunguza aina zake. Callee
    // ZOTE zinazowezekana kwenye lugha hii ni: (1) kazi za Swa zenye
    // idadi thabiti ya hoja (ni_ndani -- ikiwemo `andika`/`andika_stderr`
    // pale njia ya haraka ya `andika_sehemu` haipo, angalia ni_andika_nje
    // juu), (2) wito wa kielekezi (ni_kielekezi -- kielekezi HAKIWEZI
    // kuundwa isipokuwa kupitia `&jina_la_kazi`, hivyo lengwa ni kazi ya
    // Swa ile ile), (3) syscall ya moja kwa moja (ni_syscall_wito --
    // agizo la "syscall" halisi haliangalii AL kamwe, ni mkataba wa
    // WITO wa kazi TU), (4) `tekeleza` (ni_tekeleza_wito -- inaruka
    // kwenye kazi nyingine ya Swa yenye mkataba wake maalum, si ABI ya
    // kawaida). Hakuna njia ya kuita kazi HALISI ya nje yenye varargs
    // (hakuna FFI kwenye lugha hii) -- "mov al" hii haikuwa na maana
    // KAMWE. Imeondolewa; `andika_mov_al` (juu ya faili hili) inabaki
    // kwa matumizi ya baadaye endapo FFI itaongezwa.

    kama (ni_mfumo_wito) {
        // Pangilia rafu kwa hoja 8+: hoja 7+ zilibaki kwenye rafu kwa
        // mpangilio wa a7..aN (aN juu) — sukuma kinyume ili a7 iwe juu
        // (pop r9 hapo chini itachukua ofseti, sawa na mbegu.swm).
        // N=8: pop r11, pop rax, push r11, push rax.
        // N=9: pia pop r10, push r10 (rax, r10, r11 ni rejesta za muda
        // za syscall — zinaandikwa tena na mpangilio wa ABI hapo chini).
        kama (hoja_n == 8) {
            andika_baiti(65); andika_baiti(91);  // pop r11 (41 5B)
            andika_pop_rax();                    // pop rax (58)
            andika_baiti(65); andika_baiti(83);  // push r11 (41 53)
            andika_push_rax();                   // push rax (50)
        } sivyo { kama (hoja_n == 9) {
            andika_baiti(65); andika_baiti(91);  // pop r11 (41 5B)
            andika_pop_rax();                    // pop rax (58)
            andika_baiti(65); andika_baiti(90);  // pop r10 (41 5A)
            andika_baiti(65); andika_baiti(83);  // push r11 (41 53)
            andika_push_rax();                   // push rax (50)
            andika_baiti(65); andika_baiti(82);  // push r10 (41 52)
        } }
        // Pangilia hoja kwa ABI ya syscall:
        // rdi=namba, rsi=a1, rdx=a2, rcx=a3, r8=a4, r9=a5 →
        // rax=namba, rdi=a1, rsi=a2, rdx=a3, r10=a4, r8=a5, r9=0
        andika_baiti(77); andika_baiti(137); andika_baiti(194);  // mov r10, r8 (4D 89 C2) — a4 (bendera)
        // lugha-swa/swa#303 -- a5 (r9 ya mkataba wa wito) LAZIMA inakiliwa
        // kwenda r8 HAPA, KABLA r9 haijaandikwa tena na `pop r9` ya chini.
        // Bila mstari huu, a5 ilipotea kimya na r8 ilibaki na thamani ya a4.
        andika_baiti(77); andika_baiti(137); andika_baiti(200);  // mov r8, r9 (4D 89 C8) — a5
        andika_baiti(72); andika_baiti(137); andika_baiti(248);  // mov rax, rdi (48 89 F8)
        andika_baiti(72); andika_baiti(137); andika_baiti(247);  // mov rdi, rsi (48 89 F7)
        andika_baiti(72); andika_baiti(137); andika_baiti(214);  // mov rsi, rdx (48 89 D6)
        andika_baiti(72); andika_baiti(137); andika_baiti(202);  // mov rdx, rcx (48 89 CA)
        // pop r9 (41 59) — hoja ya 7 (ofseti). KWA MASHARTI: r9
        // inatolewa tu wakati hoja 7 ipo. Awali ilitolewa bila masharti —
        // kwa wito wenye hoja < 7 rafu iliteleza +8 kwa kila wito na
        // push zilizofuata ziliandika kwenye sloti za vigezo vya ndani.
        kama (hoja_n > 6) { andika_pop_r9(); }
        andika_baiti(15); andika_baiti(5);  // syscall (0F 05)
    } sivyo { kama (ni_tekeleza_wito) {
            // tekeleza(kazi, argc, argv, ofseti): rdi=kazi, rsi=argc,
            // rdx=argv, rcx=ofseti → r11=kazi, rdi=argc, rsi=argv+ofseti*8,
            // al=0, call r11.
            andika_baiti(73); andika_baiti(137); andika_baiti(251);  // mov r11, rdi (49 89 FB)
            andika_baiti(72); andika_baiti(137); andika_baiti(247);  // mov rdi, rsi (48 89 F7)
            andika_baiti(72); andika_baiti(137); andika_baiti(214);  // mov rsi, rdx (48 89 D6)
            andika_baiti(72); andika_baiti(137); andika_baiti(202);  // mov rdx, rcx (48 89 CA)
            andika_baiti(72); andika_baiti(193); andika_baiti(226);  // shl rdx, 3 (48 C1 E2 03)
            andika_baiti(3);
            andika_baiti(72); andika_baiti(1); andika_baiti(214);  // add rsi, rdx (48 01 D6)
            andika_baiti(176); andika_baiti(0);  // mov al, 0 (B0 00)
            andika_baiti(65); andika_baiti(255); andika_baiti(211);  // call r11 (41 FF D3)
        } sivyo { kama (ni_kielekezi) {
                andika_call_r11();  // call r11
            } sivyo {
                // Kazi ya nje yenye `...`: kipande hakijui idadi ya hoja za
                // rafu wala za xmm -- mpigaji huziweka: r11 = sloti za rafu,
                // eax = rejesta za xmm zilizotumika (al ya System V).
                kigeni_andaa_wito_wa_ziada(callee, hoja_n, msingi, n_gp_jumla, n_xmm_jumla);
                andika_baiti(232);  // call rel32
                kama (ni_ndani) {
                    n32 ofseti = ndani_ofseti - (bafa_text_wapi + 4);
                    andika_neno4(ofseti);
                } sivyo {
                    n32 nje_id = pata_au_unda_nje(callee);
                    kama (rela_idadi < 65536) {
                        rela_text_ofseti[rela_idadi] = bafa_text_wapi;
                        rela_nje_id[rela_idadi] = nje_id;
                        rela_idadi = rela_idadi + 1;
                    } sivyo {
                        // lugha-swa/swa#298 -- angalia maelezo kamili
                        // juu ya andika_rela_ulimwengu.
                        andika_stderr("KOSA: jedwali la urekebishaji (rela_*) limejaa (kikomo 65536) — wito wa '%s' hautarekebishwa sahihi\n", callee);
                        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
                    }
                    andika_neno4(0);
                }
            } } }

    // Safisha hoja za rafu zilizobaki. MUHIMU (lugha-swa/swa#184):
    // idadi ya hoja zilizobaki HALISI kwenye rafu HAIWEZI kukokotolewa
    // kutoka hoja_n (jumla ya hoja, bila kujali aina) -- lazima
    // ikokotolewe kwa KILA aina ya rejesta kando, kwa sababu GP
    // (rejesta 6) na XMM (rejesta 8) zina kikomo TOFAUTI. Kazi yenye
    // jumla ya hoja 7+ ambazo zote zinapakia KAMILI kwenye rejesta
    // (mfano GP 1 + d64 6, jumla 7) haziachi CHOCHOTE rafuni --
    // `hoja_n - 6` ya zamani ingedai kimakosa hoja 1 imebaki, na
    // `add rsp, 8` ya uongo hiyo ingesogeza rsp bila sababu kwa kila
    // wito, ikijikusanya hadi kuharibu kumbukumbu ya mwitaji.
    kama (ni_mfumo_wito) {
        // Syscall ina ABI yake tofauti kabisa (tazama hapo juu) -- si
        // mgawanyo wa GP/XMM wa SysV, formula ya zamani inabaki sahihi.
        kama (hoja_n > 6) {
            n32 idadi_rafu = hoja_n - 7;
            kama (idadi_rafu > 0) {
                andika_baiti(72); andika_baiti(131); andika_baiti(196);
                andika_baiti(idadi_rafu * 8);
            }
        }
    } sivyo {
        n32 idadi_rafu = 0;
        kama (n_gp_jumla > 6) { idadi_rafu = idadi_rafu + (n_gp_jumla - 6); }
        kama (n_xmm_jumla > 8) { idadi_rafu = idadi_rafu + (n_xmm_jumla - 8); }
        kama (idadi_rafu > 0) {
            // add rsp, imm8 (48 83 C4 xx)
            andika_baiti(72); andika_baiti(131); andika_baiti(196);
            andika_baiti(idadi_rafu * 8);
        }
    }

    // Kwa sret: rudisha kielekezi cha bafa kwenye rax
    kama (callee_ni_mm) {
        andika_mov_rax_rbp();  // mov rax, rbp
        andika_sub_rax_imm32(mm_bafa_ofseti);  // sub rax, sret_buf_off
    }

    hoja_undani = hoja_undani - 1;
}

// Msaada: kusanya kifungio cha hatua ya kitanzi cha kwa kinachofichwa
// nyuma ya taarifa zinazomaliza (rudisha/vunja/endelea). Mnyororo wa
// mwili huisha kwenye taarifa ya kumaliza — lakini msambazaji huweka
// kifungio cha hatua (AST_BLOCK yenye ast_kulia == -777777) MWISHONI
// mwa mnyororo, na endelea inaruka kwenye lebo yake. Kifungio
// kisipokusanywa, lebo ya hatua haitolewi kamwe na endelea inaruka
// mahali pasipo lebo (kitanzi kisichoisha — jibu la kimya la mwendo
// wa muda usio na mwisho). Taarifa zisizofikiwa katikati hazijalishi.
w0 kusanya_hatua_ya_kwa(n32 nodi, n32 kazi_nodi) {
    n32 nd = mti_nne[nodi];
    wakati (nd != -1) {
        kama (mti_aina[nd] == 50) {
            kama (mti_kulia[nd] == -777777) {
                uzalishaji_taarifa(nd, kazi_nodi);
                rudisha;
            }
        }
        nd = mti_nne[nd];
    }
}

// -------------------------------------------------------
// Kitoa programu (sehemu ya .text)
// -------------------------------------------------------
w0 uzalishaji_taarifa(n32 nodi, n32 kazi_nodi) {
    kama (nodi == -1) { rudisha; }

    n32 aina = mti_aina[nodi];

    // Taarifa zinazomaliza: rudisha, vunja, endelea
    // Hizi hazina ndugu mwishoni (msururu wa taarifa huisha hapa)
    kama (aina == 3) {  // AST_RUDISHA
        n32 usemi = mti_kushoto[nodi];
        kama (mm_inafanya) {
            // Sret: rudisha muundo kupitia kielekezi kilichofichwa
            kama (usemi != -1) {
                // 1. Pata anwani ya chanzo cha muundo
                n32 usemi_aina = mti_aina[usemi];
                kama (usemi_aina == 5) {
                    // Kitambulisho — tumia LEA kupata anwani ya kigeu
                    n8* jina = mti_dimbwi + mti_jina_ofseti[usemi];
                    n32 i = 0; n32 kupatikana = 0;
                    wakati (i < kigeu_idadi) {
                        kama (jina_linganisha(kigeu_dimbwi + kigeu_jina_ofseti[i], jina)) {
                            kama (kigeu_kwa_rejea[i] == 1) {
                                // Paramu ya muundo mkubwa: sloti ina
                                // kielekezi — pakia, si LEA (lengwa la
                                // nakala ni muundo wenyewe, si sloti)
                                andika_mov_rax_rbp_ofseti(kigeu_rbp_ofseti[i]);
                            } sivyo {
                                andika_lea_rax_rbp_ofseti(kigeu_rbp_ofseti[i]);
                            }
                            kupatikana = 1; vunja;
                        }
                        i = i + 1;
                    }
                    // Muundo wa ulimwengu: anwani ya kimataifa (LEA rip-rel)
                    kama (kupatikana == 0) {
                        n32 gi = 0;
                        wakati (gi < data_ulimwengu_idadi) {
                            n8* gjina = mti_dimbwi + data_ulimwengu_jina_ofseti[gi];
                            kama (jina_linganisha(gjina, jina)) {
                                andika_lea_rax_rip_rel(gi);
                                kupatikana = 1; vunja;
                            }
                            gi = gi + 1;
                        }
                    }
                    kama (kupatikana == 0) { andika_xor_eax_eax(); }
                } sivyo {
                    // Vishikizi vingine hurejesha anwani tayari (wito, nyoosha, n.k.)
                    uzalishaji_usemi(usemi, kazi_nodi);
                }

                // 2. Nakili muundo hadi kwenye bafa ya sret
                //    rsi = chanzo (anwani ya muundo)
                //    rdi = lengwa (kielekezi cha sret)
                //    rcx = ukubwa wa muundo
                andika_mov_rsi_rax();  // mov rsi, rax  (chanzo)
                andika_mov_rax_rbp_ofseti(mm_ofseti);  // mov rax, [rbp-sret]
                andika_mov_rdi_rax();  // mov rdi, rax  (lengwa)

                // 3. Hesabu ukubwa wa muundo kutoka kwenye encoding
                n32 matokeo_usimbaji = mti_thamani[kazi_nodi];
                n32 ukubwa = 8;  // chaguo-msingi
                kama (matokeo_usimbaji < 0) {
                    // Jina la muundo liko kwenye dimbwi
                    n32 name_ofseti = ((-matokeo_usimbaji) / 2) - 1;
                    ukubwa = ukubwa_wa_muundo_kwa_jina(mti_dimbwi + name_ofseti);
                }
                andika_mov_ecx_imm32(ukubwa);

                // 4. Nakili baiti za muundo
                andika_rep_movsb();

                // 5. Rudisha kielekezi cha sret kwenye rax (thamani ya kurudi)
                andika_mov_rax_rbp_ofseti(mm_ofseti);
            }
        } sivyo {
            kama (usemi != -1) {
                uzalishaji_usemi(usemi, kazi_nodi);
                // Mpaka wa kamili/desimali kwenye kurudi: d64 inakatwa
                // hadi sifuri kwa kazi ya n32; kamili inapandishwa hadi
                // d64 kwa kazi ya d64 (C-semantiki).
                badili_mpaka_wa_desimali(usemi, mti_thamani[kazi_nodi]);
            }
        }
        // Rudisha (pop) rejesta za kudumu KABLA ya leave -- kinyume
        // cha mpangilio wa push (angalia utangulizi wa uzalishaji_kazi).
        // rax (thamani ya kurudi, iliyokokotolewa hapo juu) haiguswi na
        // pop za rbx/r12-r15.
        kama (frame_imeshinda) {
            // Kikomo kinajumuisha su_rejestwa_idadi (rejesta za SU
            // zilizotengwa rasmi) -- angalia maelezo karibu na tangazo
            // la su_rejestwa_idadi juu ya faili hili.
            n32 rp_pop = rega_tumika_idadi + su_rejestwa_idadi;
            wakati (rp_pop > 0) {
                rp_pop = rp_pop - 1;
                andika_pop_reg64(regista_halisi_kwa_id(rp_pop));
            }
        }
        kama (frame_imeshinda) { andika_leave(); }
        andika_matokeo();
        // Hatua ya kwa inayofuata taarifa ya kumaliza ni msimbo wa
        // kufa — lakini lebo yake inahitajika na endelea iliyotangulia.
        kusanya_hatua_ya_kwa(nodi, kazi_nodi);
        rudisha;
    }

    kama (aina == 16) {  // AST_VUNJA
        kama (mzunguko_undani > 0) {
            toa_jmp_lebo(mzunguko_lebo_toka[mzunguko_undani - 1]);
        }
        kusanya_hatua_ya_kwa(nodi, kazi_nodi);
        rudisha;
    }

    kama (aina == 17) {  // AST_ENDELEA
        kama (mzunguko_undani > 0) {
            toa_jmp_lebo(mzunguko_lebo_endelea[mzunguko_undani - 1]);
        }
        kusanya_hatua_ya_kwa(nodi, kazi_nodi);
        rudisha;
    }

    // Taarifa zisizomaliza: zinaendelea na ndugu baada ya kushughulikiwa
    kama (aina == 11) {  // AST_TANGAZO
        n32 kigeu_nodi = mti_kushoto[nodi];
        n32 kianzio_nodi = mti_kulia[nodi];
        n8* kigeu_jina = mti_dimbwi + mti_jina_ofseti[kigeu_nodi];
        n32 kigeu_usimbaji_thamani = mti_thamani[kigeu_nodi];
        n32 safu_idadi = mti_tiga[nodi];  // > 0 = tangazo la safu ya ndani
        n32 saizi = ukubwa_kutoka_usimbaji(kigeu_usimbaji_thamani);
        kama (safu_idadi > 0) { saizi = saizi * safu_idadi; }
        n32 vidx = pata_au_unda_kigeu_ukubwa(kigeu_jina, saizi, kigeu_usimbaji_thamani);
        kama (vidx >= 0) {
            n32 ofseti = kigeu_rbp_ofseti[vidx];
            kama (safu_idadi > 0) {
                // Safu ya ndani: nafasi yote iko kwenye rafu; jina ni LEA ya msingi.
                // Rejeleo la jina lazima litumie anwani, si thamani iliyopakiwa.
                kigeu_ni_safu[vidx] = 1;
                kama (kianzio_nodi == -1) {
                    // Weka sifuri safu nzima
                    andika_lea_rax_rbp_ofseti(ofseti);  // lea rax, [rbp-off]
                    andika_mov_rdi_rax();  // rdi = lengwa
                    andika_mov_ecx_imm32(saizi);
                    andika_xor_eax_eax();  // al = 0
                    // rep stosb: F3 AA (hutumia rdi=dest, rcx=count, al=value)
                    andika_baiti(243); andika_baiti(170);
                }
            } sivyo { kama (kianzio_nodi != -1) {
                    kama (ni_muundo_usimbaji(kigeu_usimbaji_thamani)) {
                        // Kianzio cha muundo: RHS lazima itoe ANWANI ya chanzo
                        uzalishaji_anwani_ya_usemi(kianzio_nodi, kazi_nodi);
                        // Nakili muundo kutoka [rax] hadi kwenye kigeu
                        andika_mov_rsi_rax();  // rsi = chanzo
                        andika_lea_rax_rbp_ofseti(ofseti);  // lea rax, [rbp-off]
                        andika_mov_rdi_rax();  // rdi = lengwa
                        n32 ukubwa = saizi;
                        kama (ukubwa == 0) { ukubwa = 8; }
                        andika_mov_ecx_imm32(ukubwa);
                        andika_rep_movsb();
                    } sivyo {
                        uzalishaji_usemi(kianzio_nodi, kazi_nodi);
                        // Mpaka wa kamili/desimali kwenye kianzio
                        badili_mpaka_wa_desimali(kianzio_nodi, kigeu_usimbaji_thamani);
                        kama (kigeu_reg[vidx] >= 0) {
                            sawazisha_eax_kwa_usimbaji(kigeu_usimbaji_thamani);
                            andika_mov_reg64_rax(regista_halisi_kwa_id(kigeu_reg[vidx]));
                        } sivyo {
                            andika_mov_rbp_ofseti_ax(kigeu_usimbaji_thamani, ofseti);
                        }
                    }
                } sivyo {
                    kama (ni_muundo_usimbaji(kigeu_usimbaji_thamani)) {
                        // Weka sifuri muundo
                        andika_lea_rax_rbp_ofseti(ofseti);  // lea rax, [rbp-off]
                        andika_mov_rdi_rax();  // rdi = lengwa
                        n32 ukubwa = saizi;
                        kama (ukubwa == 0) { ukubwa = 8; }
                        andika_mov_ecx_imm32(ukubwa);
                        andika_xor_eax_eax();  // al = 0
                        // rep stosb: F3 AA (hutumia rdi=dest, rcx=count, al=value)
                        andika_baiti(243); andika_baiti(170);
                    } sivyo {
                        andika_xor_eax_eax();
                        kama (kigeu_reg[vidx] >= 0) {
                            // sifuri haihitaji sawazisha (0 ni sahihi
                            // kwa upana wowote tayari).
                            andika_mov_reg64_rax(regista_halisi_kwa_id(kigeu_reg[vidx]));
                        } sivyo {
                            andika_mov_rbp_ofseti_ax(kigeu_usimbaji_thamani, ofseti);
                        }
                    }
                } }
        }
    }

    sivyo { kama (aina == 37) {  // AST_ASIMILIA
            // Njia moja tu: uzalishaji_asimilia inashughulikia kigeu cha
            // ndani, cha ulimwengu, sehemu, mshale, na safu kwa usawa.
            // (Hapo zamani kulikuwa na nakala ya zamani hapa ambayo
            // iliipakia THAMANI ya RHS kama anwani ya chanzo ya nakili
            // ya muundo — kosa la ugawi wa muundo b = a.)
            uzalishaji_asimilia(nodi, kazi_nodi);
        }

        sivyo { kama (aina == 8) {  // AST_WITO
                uzalishaji_wito(nodi, kazi_nodi);
            }

            sivyo { kama (aina == 9) {  // AST_KAMA
                    uzalishaji_kama(nodi, kazi_nodi);
                }

                sivyo { kama (aina == 10) {  // AST_WAKATI
                        uzalishaji_wakati(nodi, kazi_nodi);
                    }

                    sivyo { kama (aina == 14) {  // AST_CHAGUA
                            uzalishaji_chagua(nodi, kazi_nodi);
                        }

                        sivyo { kama (aina == 50) {  // AST_BLOCK — kifungio cha hatua ya kwa
                                // Kama kifungio hiki ni hatua ya kitanzi cha kwa (alama -777777
                                // kwenye ast_kulia), weka lebo ya hatua HAPA — endelea inaruka
                                // kwenye lebo hii (semantiki ya C).
                                kama (mti_kulia[nodi] == -777777) {
                                    kama (mzunguko_undani > 0) {
                                        weka_lebo(mzunguko_lebo_hatua[mzunguko_undani - 1]);
                                    }
                                }
                                uzalishaji_taarifa(mti_kushoto[nodi], kazi_nodi);
                            } } } } } } }

    // Endelea na ndugu (kwa taarifa zisizomaliza)
    uzalishaji_taarifa(mti_nne[nodi], kazi_nodi);
}

// -------------------------------------------------------
// Visaidizi vya uzalishaji_usemi -- kila kishikizi cha aina ya AST
// kimegawanywa kuwa kazi yake mwenyewe ili kupunguza vizuizi
// (FastISel haishughulikii vizuri kazi zenye vizuizi zaidi ya 50).
// -------------------------------------------------------

// AST_NAMBARI (4) -- namba halisi
w0 uzalishaji_nambari(n32 nodi, n32 kazi_nodi) {
    // Alama ya n64 iko ast_kulia (ast_tiga ni kiungo cha mnyororo
    // wa hoja kwenye wito — haijulikani wakati wa uzalishaji).
    kama (mti_kulia[nodi] == 1) {
        // n64 halisi: baiti 8 zimehifadhiwa kwenye dimbwi la AST
        // (ast_thamani = ofseti). Toa mov rax, imm64 (48 B8 + baiti 8).
        n32 ofseti = mti_thamani[nodi];
        andika_baiti(72);   // 0x48 — REX.W
        andika_baiti(184);  // 0xB8 — mov rax, imm64
        n32 bi = 0;
        wakati (bi < 8) {
            andika_baiti(mti_dimbwi[ofseti + bi]);
            bi = bi + 1;
        }
        rudisha;
    }
    n32 thamani = mti_thamani[nodi];
    andika_mov_eax(thamani);
}

// movsxd rax, dword [rbp-off] (48 63 45 xx / 48 63 85 xxxx)
w0 andika_movsxd_rax_rbp_ofseti(n32 ofseti) {
    andika_baiti(72); andika_baiti(99);
    kama (ofseti < 128) { andika_baiti(69); andika_baiti((256 - ofseti) & 255); }
    sivyo { andika_baiti(133); andika_disp32_ya_ofseti(ofseti); }
}

// Kusoma kigezo cha n32 chenye ishara: uzalishaji_usemi ilikuwa inapakia
// (mov eax,[kigezo] au mov rax,rejesta) KISHA panua_ishara_ndogo inaongeza
// cdqe -- maagizo mawili. Rejesta za kudumu HAZIhakikishiwi kupanuliwa
// kwa ishara (sawazisha_eax_kwa_enc haifanyi kitu kwa upana wa 4; "mov
// eax" husafisha biti za juu), kwa hiyo cdqe HAIWEZI kuondolewa -- lakini
// movsxd (48 63 /r) hufanya upakiaji na upanuzi kwa agizo MOJA, na matokeo
// ni yale yale. Inarudisha 1 kama imetoa movsxd (na kuweka jr_panua_ruka
// ili uzalishaji_usemi isirudie cdqe), 0 kama sivyo.
n32 jr_panua_ruka = 0;
n32 jr_pakia_movsxd(n32 nodi, n32 usimbaji_kigeu, n32 reg_id, n32 ofseti) {
    n32 en = mti_thamani[nodi];
    kama (en <= 0 || ni_desimali_usimbaji(en) || ni_bila_ishara_usimbaji(en)) { rudisha 0; }
    kama (ukubwa_kutoka_usimbaji(en) != 4) { rudisha 0; }
    kama (usimbaji_kigeu <= 0 || ni_desimali_usimbaji(usimbaji_kigeu) || ni_bila_ishara_usimbaji(usimbaji_kigeu)) { rudisha 0; }
    kama ((usimbaji_kigeu / 2) * 2 != usimbaji_kigeu) { rudisha 0; }
    kama (ukubwa_kutoka_usimbaji(usimbaji_kigeu) != 4) { rudisha 0; }
    kama (reg_id >= 0) {
        n32 reg = regista_halisi_kwa_id(reg_id);
        n32 reg7 = reg - ((reg / 8) * 8);
        kama (reg >= 8) { andika_baiti(73); } sivyo { andika_baiti(72); }
        andika_baiti(99);
        andika_baiti(192 + reg7);
    } sivyo {
        andika_movsxd_rax_rbp_ofseti(ofseti);
    }
    jr_panua_ruka = 1;
    rudisha 1;
}

// AST_KITAMBULISHO (5) -- kitambulisho (kigeu au herufi halisi)
w0 uzalishaji_kitambulisho(n32 nodi, n32 kazi_nodi) {
    n8* jina = mti_dimbwi + mti_jina_ofseti[nodi];

    // Angalia kama hii ni herufi halisi (inaanza na ")
    kama (jina[0] == 34) {
        n32 si = kusanya_herufi(jina);
        kama (si == -1) {
            // Haipaswi kufikiwa (#295): kusanya_herufi sasa inasimamisha
            // ukusanyaji moja kwa moja ikiwa jedwali limejaa -- ukaguzi
            // huu unabaki kama ulinzi wa ziada tu. ZAMANI: hii ilikuwa
            // 'rudisha;' kimya (bila exit), ikiacha agizo la LEA
            // likirukwa kabisa na rejesta ikibaki na thamani ya zamani
            // isiyohusiana -- chanzo halisi cha #295.
            andika_stderr("KOSA: bafa ya herufi halisi imejaa\n");
            wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        }
        kama (mfuatano_lebo_id[si] < 0 && lebo_bafa_idadi < 65536) {
            mfuatano_lebo_id[si] = lebo_bafa_mpya();
        }
        n32 lebo_id = mfuatano_lebo_id[si];
        toa_lea_rax_kwa_lebo(lebo_id);
        rudisha;
    }


    // Rejeleo la kigeu: tafuta kwenye orodha ya vigeu
    n32 i = 0;
    wakati (i < kigeu_idadi) {
        n8* vjina = kigeu_dimbwi + kigeu_jina_ofseti[i];
        kama (jina_linganisha(vjina, jina)) {
            kama (kigeu_ni_safu[i] == 1) {
                // Safu ya ndani: usemi wa jina unahitaji anwani ya msingi (LEA)
                andika_lea_rax_rbp_ofseti(kigeu_rbp_ofseti[i]);
            } sivyo { kama (jr_pakia_movsxd(nodi, kigeu_usimbaji[i], kigeu_reg[i], kigeu_rbp_ofseti[i])) {
                    // n32 yenye ishara: movsxd moja (angalia jr_pakia_movsxd)
                } sivyo { kama (kigeu_reg[i] >= 0) {
                        // Kigezo cha kudumu kwenye rejesta -- nakili moja
                        // kwa moja hadi rax (tayari kimepanuliwa kwa usahihi).
                        andika_mov_rax_reg64(regista_halisi_kwa_id(kigeu_reg[i]));
                    } sivyo {
                        andika_pakia_kigeu_kwa_usimbaji(kigeu_usimbaji[i], kigeu_rbp_ofseti[i]);
                    } } }
            rudisha;
        }
        i = i + 1;
    }

    kama (pakia_kigezo_ikiwa_ni_paramu(nodi, jina, kazi_nodi)) { rudisha; }

    // Tafuta kigezo cha ulimwengu
    n32 gi = 0;
    wakati (gi < data_ulimwengu_idadi) {
        n8* gjina = mti_dimbwi + data_ulimwengu_jina_ofseti[gi];
        kama (jina_linganisha(gjina, jina)) {
            n32 usimbaji = data_ulimwengu_usimbaji[gi];
            kama (data_ulimwengu_ni_safu[gi] == 1) {
                // Safu: usemi unahitaji anwani ya msingi (LEA)
                andika_lea_rax_rip_rel(gi);
            } sivyo { kama (ni_desimali_usimbaji(usimbaji)) {
                    // Desimali: movsd/movss xmm0, [rip+disp32] — si mov rax
                    andika_mov_ax_rip_rel(usimbaji, gi);
                } sivyo {
                    // Kamili: movsx/movzx kwa n8/n16 (upana + ishara),
                    // mov eax/rax kwa upana zaidi — si mov eax tu,
                    // uliosoma baiti 4 kwa kigeu cha baiti 1/2.
                    andika_mov_ax_rip_rel(usimbaji, gi);
                } }
            rudisha;
        }
        gi = gi + 1;
    }

    // Kitambulisho kisichojulikana — zamani kilikuwa onyo na 0 kimya,
    // likitoa msimbo unaoanguka (SEGV). Sasa ni kosa la kufa, kama
    // wito wa kazi isiyofafanuliwa (utatuzi wa RELA).
    kama (kazi_nafasi_kwa_jina(jina) >= 0) {
        andika_stderr("Hitilafu: jina la kazi halitumiki kama usemi: %s\n", jina);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    andika_stderr("Hitilafu: kitambulisho kisichojulikani: %s\n", jina);
    wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
}

// -------------------------------------------------------
// Hesabu ya anwani — kielekezi ± namba (C-semantiki, rekodi 8.9)
// -------------------------------------------------------
// Ukubwa wa kipengele cha kielekezi chenye enc isiyo sawa (biti za
// mshale ziko kwenye biti 0-1: 1 = mshale mmoja, 3 = mshale mbili).
// Mshale MMOJA huondolewa kwanza — sawa na mkaguzi anavyofanya kwa
// faharisi a[i] — kisha ukubwa wa aina iliyobaki hupimwa. n8* → 1,
// n32* → 4, n64* → 8, n32** → 8, muundo* → ukubwa wa muundo.
n32 ukubwa_wa_kipengele_cha_kielekezi(n32 usimbaji) {
    n32 usimbaji_k = usimbaji;
    kama (usimbaji > 0) {
        n32 familia = (usimbaji / 256) % 256;
        n32 ua = usimbaji - (familia * 256);
        n32 mb = ua - ((ua / 4) * 4);
        kama (mb == 3) { usimbaji_k = usimbaji - 2; }
        sivyo { usimbaji_k = usimbaji - 1; }
    } sivyo {
        // Hasi: muundo* ni -2k+1 (mshale wa kwanza huondolewa kwa
        // kutoa 1: -2k+1 → -2k, yaani muundo lenyewe).
        usimbaji_k = usimbaji - 1;
    }
    n32 saizi = ukubwa_kutoka_usimbaji(usimbaji_k);
    kama (saizi == 0) { saizi = 4; }
    rudisha saizi;
}

// Zidisha rax kwa ukubwa wa kipengele cha kielekezi (p + n).
// n8/n16/n32 zinazoingia zimepanuliwa kwa sifuri hadi rax na mov —
// panua ishara kwanza (cdqe). n64 na desimali (zilizobadilishwa
// hadi rax na mpaka wa desimali) tayari ziko upana kamili.
w0 andika_ongea_kielekezi_kipengele(n32 usimbaji_kielekezi, n32 usimbaji_namba) {
    n32 saizi = ukubwa_wa_kipengele_cha_kielekezi(usimbaji_kielekezi);
    kama (saizi == 1) { rudisha; }  // n8*: tayari ni baiti
    n32 ni_64 = 0;
    kama (ni_desimali_usimbaji(usimbaji_namba)) { ni_64 = 1; }
    kama (ukubwa_kutoka_usimbaji(usimbaji_namba) >= 8) { ni_64 = 1; }
    kama (ni_64 == 0) { andika_cdqe(); }
    kama (saizi == 2) {
        andika_baiti(72); andika_baiti(193); andika_baiti(224); andika_baiti(1);  // shl rax, 1
        rudisha;
    }
    kama (saizi == 4) {
        andika_baiti(72); andika_baiti(193); andika_baiti(224); andika_baiti(2);  // shl rax, 2
        rudisha;
    }
    kama (saizi == 8) {
        andika_baiti(72); andika_baiti(193); andika_baiti(224); andika_baiti(3);  // shl rax, 3
        rudisha;
    }
    andika_baiti(72); andika_baiti(105); andika_baiti(192);  // imul rax, rax, imm32
    andika_neno4(saizi);  // ukubwa mwingine (miundo ya 12, 20, 24, ...)
}

// Usemi ni kielekezi halisi? Matokeo ya ulinganishi (aina 20-25) na
// halisi (aina 4 na 45) SI kielekezi: enc yao inaweza kuwa isiyo
// sawa (ENC_ULINGANISHI) lakini thamani yake ni namba.
n32 usemi_ni_kielekezi(n32 nodi) {
    kama (nodi == -1) { rudisha 0; }
    n32 a = mti_aina[nodi];
    kama (a >= 20) { kama (a <= 25) { rudisha 0; } }
    kama (a == 4) { rudisha 0; }
    kama (a == 45) { rudisha 0; }
    n32 usimbaji = aina_ya_usemi(nodi);
    kama (usimbaji == 0) { rudisha 0; }
    kama (usimbaji == -1) { rudisha 0; }
    kama ((usimbaji / 2) * 2 != usimbaji) { rudisha 1; }
    rudisha 0;
}

// -------------------------------------------------------
// Ugawaji wa rejesta wa vigezo vya muda vya usemi (Sethi-Ullman)
//
// Ugawaji wa rejesta uliopo (angalia maelezo karibu na tangazo la
// var_reg[64] juu ya faili hili) unashughulikia vigezo vya NDANI na
// paramu PEKEE -- thamani za KATI za usemi (mfano matokeo ya (a+b)
// ndani ya (a+b)*(c+d)) bado zinasukumwa/kutolewa (push/pop) kwenye
// rafu halisi ya x86 kila wakati, hata kama hakuna wito wa kazi
// kati ya matumizi mawili -- angalia uzalishaji_jumlisha/tofauti/
// zidisha: kila mmoja hutathmini upande mmoja, KUSUKUMA matokeo,
// kutathmini upande mwingine, KISHA KUVUTA (pop) matokeo ya kwanza.
//
// Sehemu hii inaongeza njia MBADALA (SI kubadilisha ile ya asili --
// ile inabaki bila kuguswa kama njia ya kurudi nyuma) inayotumia
// rejesta za callee-saved ZISIZOTUMIKA na ugawaji wa vigezo vya
// ndani/paramu (rbx/r12/r13/r14/r15, ukiondoa zile tayari zinazotumiwa
// na kazi ya sasa -- angalia rega_tumika_idadi) kushikilia matokeo ya
// KATI badala ya kusukuma kwenye rafu -- ikitumia FOMULA ya
// Sethi-Ullman (Sethi & Ullman, 1970) YA KUKOKOTOA idadi ya chini
// kabisa ya rejesta zinazohitajika kutathmini mti wa usemi, LAKINI SI
// upangaji upya wake wa mpangilio wa utathmini (angalia maelezo
// kamili chini ya su_haja_rejista: mpangilio unabaki KULIA-KISHA-
// KUSHOTO ulio WA KUDUMU, sawa kabisa na mpangilio wa asili wa
// uzalishaji_jumlisha/tofauti/zidisha -- SI upande "mgumu zaidi"
// kwanza, kwa sababu kubadilisha mpangilio huo kungebadilisha
// mpangilio unaoonekana wa madhara ya kando ya wito za kazi).
//
// WIGO (kwa makusudi mdogo, angalia maelezo kamili ya mradi kuhusu
// hatari): NAMBA KAMILI TU (si desimali -- xmm ni suala tofauti),
// SI hesabu ya kielekezi (p+n/p-n, ina njia yake maalum ya kuzidisha
// kwa ukubwa wa kipengele -- imeachwa kabisa), SI zidisho la nguvu
// kamili ya 2 (tayari lina njia yake ya haraka ya shl, angalia
// nguvu_kamili_ya_pili -- haihitaji rejesta ya ziada KABISA), SI
// toa ya kipekee (-x, ast_kushoto==-1). +, -, * TU (/ na % zimeachwa
// KWA MAKUSUDI -- idiv ina masharti magumu zaidi ya rejesta halisi
// (mgao lazima uwe rdx:rax, mgawanyaji si rax wala rdx), hivyo
// kuchanganya na upangaji upya wa Sethi-Ullman (unaotathmini upande
// "mgumu" bila kujali ni upi kimuundo) kunahitaji uangalifu zaidi wa
// muda ambao haukuwepo kwenye kikao hiki -- kazi ya baadaye).
//
// Endapo mti wa usemi unahitaji rejesta ZAIDI ya zinazopatikana
// (su_rejestwa_idadi -- rejesta za SU ZILIZOTENGWA RASMI kwa kazi hii,
// angalia maelezo karibu na tangazo lake), NJIA YOTE inarudi kwenye
// tabia ya asili ya push/pop (SI mchanganyiko wa sehemu-rejesta/
// sehemu-rafu ndani ya mti mmoja -- rahisi zaidi kuthibitisha usahihi
// wake, gharama TU ni fursa iliyokosekana ya uboreshaji kwa miti
// mikubwa sana, SI hatari
// ya usahihi).

// Je, nodi hii ni AST_JUMLISHA/TOFAUTI(ya-jozi)/ZIDISHA(isiyo-nguvu-
// -ya-2) ya namba kamili isiyo ya kielekezi? Kigezo kimoja cha ukweli
// kinachotumika PIA na su_haja_rejista na su_zalisha_ndani -- LAZIMA
// kibaki thabiti kati ya zote mbili, la sivyo uhesabuji wa haja
// hautaendana na ni rejesta ngapi zinazokopwa kwa HALISI wakati wa
// uzalishaji (hatari ya kufurika rejesta -- angalia maelezo juu ya
// faili hili kuhusu tafiti za awali za mradi huu).
n32 su_ni_kushughulikiwa(n32 nodi) {
    kama (nodi < 0) { rudisha 0; }
    // HISTORIA FUPI (maelezo kamili ya awali yapo kwenye historia ya
    // git ya faili hili, kwa yeyote anayehitaji muktadha kamili wa
    // uchunguzi #232): mdudu wa awali (unaohusu andika_stderr) ULIKUWA
    // hitilafu tofauti kabisa (jedwali la sehemu za maandishi
    // lililofurika kimya -- limerekebishwa PR #234) -- HAUNA UHUSIANO
    // na kipengele hiki. Sababu ya KWELI ya Sethi-Ullman kubaki
    // imezimwa hadi sasa ilikuwa hatari ya kubadilisha MPANGILIO WA
    // UTATHMINI wa madhara ya kando -- imetatuliwa kwa kuachana KABISA
    // na upangaji upya wa Sethi-Ullman (angalia maelezo kwenye
    // su_haja_rejista/su_zalisha_ndani hapa chini: mpangilio sasa ni
    // KULIA-KISHA-KUSHOTO ulio WA KUDUMU, sawa kabisa na mpangilio wa
    // asili wa uzalishaji_jumlisha/tofauti/zidisha kila mahali).
    //
    // MDUDU WA PILI ULIOGUNDULIWA (ukaguzi huru, kabla ya kuwasha
    // kipengele hiki -- SI dhana, umethibitishwa kwa kusoma utangulizi/
    // mwisho wa uzalishaji_kazi moja kwa moja): usanifu wa awali wa
    // sehemu hii ulikopa rejesta za "ziada" (id = rega_tumika_idadi +
    // su_zilizokopwa, tazama su_zalisha_ndani) BILA kuzihifadhi
    // popote. Utangulizi/mwisho wa kazi (uzalishaji_kazi, karibu na
    // rp_push/rp_pop_mwisho) husukuma/kutoa (push/pop) TU rejesta
    // zinazotumika na VIGEZO VYA NDANI vya kazi hiyo (rega_tumika_idadi)
    // -- rejesta za "ziada" zilizokopwa kwa muda wa usemi mmoja
    // HAZIKUWA sehemu ya hesabu hiyo KABISA. Kwa kuwa rbx/r12-r15 ni
    // callee-saved kwa ABI, hii ni HITILAFU YA ABI HALISI: kazi
    // inayotumia rejesta ya "ziada" kama hii kwa usemi wake wa ndani
    // ingeharibu KIMYA thamani ya mpigaji (au ya babu yeyote wa mnyororo
    // wa wito) iliyoko kwenye rejesta hiyo hiyo, mara tu kazi inaporudi
    // -- hatari ya kina cha wito, si ya kina cha usemi mmoja, kwa hiyo
    // haiwezi kugunduliwa na majaribio yanayoita kazi moja tu bila
    // babu yeyote mwenye kigezo cha rejesta kwenye nafasi ile ile.
    //
    // SULUHISHO: ACHANA na "kukopa kwa muda" bila kuhifadhi. Badala
    // yake, kila kazi sasa ina PITIO LA AWALI (angalia hook ndani ya
    // kusanya_vigeu_vya_ndani, na su_max_haja_kazi/su_rejestwa_idadi
    // karibu na tangazo la su_zilizokopwa) linalokokotoa idadi kubwa
    // zaidi ya rejesta za SU zinazohitajika WAKATI MMOJA na usemi
    // WOWOTE ndani ya kazi hiyo -- idadi hii (iliyopunguzwa kama
    // inavyohitajika kwa nafasi iliyobaki baada ya vigezo vya ndani)
    // inakuwa sehemu ya RASMI ya "rejesta zinazotumika na kazi hii",
    // ikihifadhiwa (push) na kurudishwa (pop) na utangulizi/mwisho wa
    // kazi MARA MOJA TU (kama vigezo vya ndani), SI kwa kila usemi.
    // Hii inaondoa kabisa hitilafu ya ABI (rejesta zote zinazoguswa
    // sasa zinahifadhiwa rasmi), NA inaepuka gharama ya kuhifadhi/
    // kurudisha kwa kila usemi mmoja mmoja (ambayo ingekuwa sawa kabisa
    // na gharama ya push/pop ya asili -- bila faida yoyote ya kweli).
    n32 aina = mti_aina[nodi];
    kama (aina != MTI_JUMLISHA && aina != MTI_TOFAUTI && aina != MTI_ZIDISHA) { rudisha 0; }
    n32 usimbaji = mti_thamani[nodi];
    kama (ni_desimali_usimbaji(usimbaji)) { rudisha 0; }
    kama (aina == MTI_TOFAUTI) {
        kama (mti_kushoto[nodi] == -1) { rudisha 0; }  // toa ya kipekee (-x)
    }
    kama (aina == MTI_JUMLISHA || aina == MTI_TOFAUTI) {
        kama ((usimbaji / 2) * 2 != usimbaji) { rudisha 0; }  // hesabu ya kielekezi
    }
    kama (aina == MTI_ZIDISHA) {
        kama (nguvu_kamili_ya_pili(mti_kulia[nodi]) != -1) { rudisha 0; }
        kama (nguvu_kamili_ya_pili(mti_kushoto[nodi]) != -1) { rudisha 0; }
    }
    rudisha 1;
}

// Idadi ya chini kabisa ya rejesta za ZIADA (zaidi ya rax/eax
// inayotumika kila mahali kama "rejesta ya sasa ya kukokotoa" -- SI
// sehemu ya hesabu hii) zinazohitajika kutathmini mti huu wa usemi
// bila kusukuma/kuvuta kwenye rafu popote. Nodi isiyoshughulikiwa
// (jani -- namba, kitambulisho, wito wa kazi, kipengele cha safu,
// n.k.) daima ni 0.
//
// MUHIMU (mdudu HALISI uliogunduliwa kwa kujenga upya mkusanyaji na
// kikao chake mwenyewe -- SI dhana, na SI wa kina cha "haianguki" tu:
// mkusanyaji uliozalishwa ulianza kutoa hitilafu za UWONGO kabisa,
// mfano "jina la kazi halitumiki kama usemi: main" kwa faili sahihi
// kabisa, ikithibitisha uharibifu wa KWELI wa mantiki, si kuanguka
// tu): FOMULA ASILI ya Sethi-Ullman (Sethi & Ullman, 1970) inapendekeza
// kutathmini upande "mgumu zaidi" (unaohitaji rejesta nyingi zaidi)
// KWANZA bila kujali ni upi kimuundo (kushoto au kulia) -- lakini
// mkusanyaji huu (kama lugha nyingi zenye taarifa za kando/side-
// -effects) unatathmini KULIA KABLA YA KUSHOTO KILA MAHALI PENGINE
// (angalia uzalishaji_jumlisha/tofauti/zidisha ZOTE -- "Tathmini RHS
// -> rax; sukuma; Tathmini LHS -> rax; vuta"), na msimbo halisi wa
// mkusanyaji WENYEWE (na kwa uwezekano msimbo wowote wa mtumiaji
// wenye hoja za wito za kazi zenye madhara ya kando) unategemea
// MPANGILIO HUO HUO WA UTATHMINI kwa usahihi -- kubadilisha mpangilio
// (kutathmini kushoto kwanza wakati kushoto "ni mgumu zaidi", jambo
// linalotokea MARA NYINGI SANA kwa sababu ya jinsi uamuzi wa hali
// sawa (tie-break) ulivyofanywa) kunabadilisha MPANGILIO HALISI wa
// wito za kazi zenye madhara ya kando ndani ya usemi -- SI hatari ya
// nadharia tu, ilithibitika kuvunja MKUSANYAJI WENYEWE.
//
// Suluhisho: ACHANA KABISA na upangaji upya wa Sethi-Ullman. Fomula
// hii sasa inahesabu haja ya rejesta kwa MPANGILIO WA KUDUMU (KULIA
// KWANZA, kinachoshikiliwa, KISHA KUSHOTO, kinachounganisha) --
// sawa KABISA na mpangilio ambao uzalishaji_jumlisha/tofauti/zidisha
// tayari unatumia kila mahali. Hii SI Sethi-Ullman kamili tena (haitoi
// matokeo bora KABISA kila wakati -- endapo KUSHOTO ndiyo "mgumu
// zaidi", mbinu hii haipati faida ya kuubadilisha mpangilio), LAKINI
// ni SALAMA KABISA (haiwezi KAMWE kubadilisha mpangilio wa utathmini
// unaoonekana, hivyo haiwezi kuvunja usahihi wa msimbo wenye madhara
// ya kando popote): fomula = max(haja(kulia), 1 + haja(kushoto)) --
// wakati wa kutathmini KULIA (hatua ya kwanza), hakuna kinachoshikiliwa
// bado, hivyo haja yake YENYEWE ndiyo kikomo; wakati wa kutathmini
// KUSHOTO (hatua ya pili), rejesta MOJA tayari imeshikwa (matokeo ya
// kulia), hivyo kushoto anahitaji rejesta zake YENYEWE ZAIDI YA moja
// iliyoshikwa tayari.
n32 su_haja_rejista(n32 nodi) {
    kama (su_ni_kushughulikiwa(nodi) == 0) { rudisha 0; }
    n32 nr = su_haja_rejista(mti_kulia[nodi]);
    n32 nl = su_haja_rejista(mti_kushoto[nodi]);
    n32 nl_na_kushikwa = nl + 1;
    kama (nr >= nl_na_kushikwa) { rudisha nr; }
    rudisha nl_na_kushikwa;
}

// Idadi ya rejesta za ziada zilizokopwa KWA SASA (kina cha kitanzi
// cha su_zalisha_ndani kinachoendelea) -- huwekwa upya kuwa 0 MARA
// MOJA TU, kwenye kiingilio cha juu kabisa (su_jaribu_mzizi hapa
// chini), KABLA ya kuita su_zalisha_ndani kwa mara ya kwanza.
// Kitanzi cha ndani cha su_zalisha_ndani HAKIWEKI upya -- kingevuruga
// hesabu ya mzazi anayeendelea kushikilia rejesta yake mwenyewe.
n32 su_zilizokopwa = 0;

// Idadi kubwa zaidi ya rejesta za SU zinazohitajika WAKATI MMOJA na
// usemi WOWOTE ndani ya kazi INAYOSHUGHULIKIWA SASA -- huwekwa upya
// kuwa 0 mwanzoni mwa kila kazi (uzalishaji_kazi, karibu na
// rega_tumika_idadi = 0), na kukokotolewa na pitio la awali (hook
// ndani ya kusanya_vigeu_vya_ndani, ikiita su_haja_rejista kwa kila
// nodi ya AST_JUMLISHA/TOFAUTI/ZIDISHA inayofikiwa). Kupungukiwa
// (nodi fulani kukosekana kwenye pitio hilo, mfano kwa sababu ya
// kikomo cha kvn_idadi > 50000 kwa kazi kubwa mno) ni SALAMA KABISA --
// su_jaribu_mzizi bado utathibitisha upatikanaji WAKATI WA UZALISHAJI
// HALISI (haja <= su_rejestwa_idadi) na kurudi kwenye push/pop kwa
// usemi wowote usiotoshea, hakuna hatari ya usahihi, ni fursa
// iliyokosekana TU. Usemi WOWOTE nje ya kitanzi (su_kina_kitanzi==0
// wakati wa pitio) HAUCHANGII kiasi hiki KABISA -- angalia maelezo
// karibu na tangazo la su_kina_kitanzi hapa chini kwa sababu (kipimo
// halisi cha kupanga/nasibu_ijayo).
n32 su_upeo_haja_kazi = 0;

// Kina cha sasa cha kitanzi (wakati/kwa, kina zaidi ya 0 = ndani ya
// angalau kitanzi kimoja) WAKATI wa pitio la awali (hook ndani ya
// kusanya_vigeu_vya_ndani) -- huwekwa upya kuwa 0 mwanzoni mwa kila
// kazi, kisha kuongezwa/kupunguzwa na tawi la AST_WAKATI ndani ya
// kusanya_vigeu_vya_ndani kuzunguka sharti+mwili wa kitanzi (SI
// kianzio cha kwa wala taarifa inayofuata -- hizo hazirudiwi). Sababu:
// gharama ya kutenga rejesta za SU (push/pop MOJA kwenye utangulizi/
// mwisho wa kazi) inalipwa tena (amortized) TU pale usemi
// unaporudiwa mara nyingi ndani ya wito MMOJA wa kazi hiyo (mfano
// kitanzi cha djb2() kinachotekeleza usemi wa SU mara moja kwa kila
// herufi) -- usemi unaotokea MARA MOJA TU kwa kila wito (nje ya
// kitanzi chochote, mfano nasibu_ijayo() kwenye kupanga) haupati
// nafasi ya kulipa gharama hiyo tena, na kipimo halisi kilionyesha
// hilo kama upungufu wa kasi wa ~7-10% kabla ya ukaguzi huu kuongezwa.
n32 su_kina_kitanzi = 0;

// Idadi HALISI ya rejesta za SU zilizotengwa (RASMI, sehemu ya
// "rejesta zinazotumika na kazi hii") kwa kazi INAYOSHUGHULIKIWA SASA
// -- min(su_max_haja_kazi, 5 - rega_tumika_idadi), kukokotolewa MARA
// MOJA TU baada ya finalisha_ugawaji_rejista() (angalia
// uzalishaji_kazi). Rejesta zenye id [rega_tumika_idadi,
// rega_tumika_idadi + su_rejestwa_idadi) sasa ni sehemu RASMI ya
// utangulizi/mwisho wa kazi hii (rp_push/rp_pop_mwisho/rp_pop ya
// AST_RUDISHA hutumia rega_tumika_idadi + su_rejestwa_idadi kama
// kikomo, SI rega_tumika_idadi peke yake) -- hii ndiyo inayozuia
// hitilafu ya ABI iliyoelezwa juu ya su_ni_kushughulikiwa.
n32 su_rejestwa_idadi = 0;

// MDUDU HALISI ULIOGUNDULIWA (kwa jaribio halisi, si dhana) na
// kurekebishwa hapa: 1 = tathmini ya Sethi-Ullman TAYARI inaendelea
// (kina fulani cha su_zalisha_ndani kinaendelea, kikishikilia rejesta
// moja au zaidi). Hii inazuia URUDIAJI USIO SALAMA -- mfano
// "(a+b) * kazi(c+d)": wakati wa kutathmini upande "rahisi" (wito wa
// kazi kazi(c+d)) huku upande "mgumu" (a+b) ukiwa umeshikwa kwenye
// rejesta ya kudumu, uzalishaji wa hoja ya wito (c+d) ungeita
// uzalishaji_jumlisha TENA -- na bila ulinzi huu, ingeona nafasi
// inayoonekana kupatikana (rega_tumika_idadi haijabadilika) na
// KUWEKA UPYA su_zilizokopwa KUWA 0, kisha kukopa REJESTA ILE ILE
// ambayo mzazi wa nje bado anaishikilia -- ikiiharibu KIMYA (thamani
// mbili tofauti kabisa zikichanganyikana kwenye rejesta moja).
// Iligunduliwa kwa kujenga upya mkusanyaji na kikao chake mwenyewe
// (mnyororo wa kujitegemea ulianguka na SEGV papo hapo) -- SI dhana.
// Suluhisho: rudi kwenye tabia ya asili ya push/pop kwa nodi YOYOTE
// inayofikiwa wakati tathmini ya nje tayari inaendelea -- salama
// kabisa (push/pop halisi ya x86 haijali kina cha urudiaji), gharama
// TU ni fursa ndogo iliyokosekana ya uboreshaji kwa usemi ulioota
// ndani ya hoja ya wito uliomo ndani ya usemi mwingine
// unaotathminiwa kwa Sethi-Ullman.
n32 su_ndani_ya_tathmini = 0;

// Kiingilio kimoja cha PEKEE cha juu kabisa kwa ugawaji wa rejesta
// wa Sethi-Ullman -- huchunguza kufaa (su_ni_kushughulikiwa),
// upatikanaji wa rejesta (haja <= nafasi), NA ulinzi wa urudiaji
// (su_ndani_ya_tathmini). Inarudisha 1 kama imeshughulikia nodi hii
// KIKAMILIFU (mwitaji AFANYE rudisha mara moja, bila kuendelea na
// njia ya asili) au 0 kama mwitaji AENDELEE na njia yake ya asili ya
// push/pop bila kubadilika. Kuwa na kiingilio KIMOJA (badala ya
// kurudia ukaguzi huu mara tatu -- jumlisha/tofauti/zidisha) kunaepuka
// hatari ya ukaguzi kutofautiana kati ya nafasi tatu.
n32 su_jaribu_mzizi(n32 nodi, n32 kazi_nodi) {
    kama (su_ndani_ya_tathmini) { rudisha 0; }
    kama (su_ni_kushughulikiwa(nodi) == 0) { rudisha 0; }
    n32 haja = su_haja_rejista(nodi);
    // haja=1 haipati faida ya kweli (angalia maelezo karibu na hook
    // ndani ya kusanya_vigeu_vya_ndani, kipimo halisi cha fibonacci) --
    // kinga hii ni ya PILI (usalama wa ziada tu): pitio la awali
    // tayari halijumuishi nodi za haja=1 kwenye su_max_haja_kazi, lakini
    // ukaguzi huu hapa unahakikisha HATA kama su_rejestwa_idadi>0 kwa
    // sababu nyingine (usemi mwingine wa haja>=2 kwenye kazi hii hii),
    // usemi wa haja=1 bado haukubaliwi SU -- gharama TU ni fursa
    // iliyokosekana, si hatari ya usahihi.
    kama (haja < 2) { rudisha 0; }
    // Nafasi ni su_rejestwa_idadi (rejesta ZILIZOTENGWA RASMI na
    // utangulizi/mwisho wa kazi hii kwa ajili ya SU) -- SI "5 -
    // rega_tumika_idadi" moja kwa moja. Tofauti hii ndiyo suluhisho la
    // hitilafu ya ABI iliyoelezwa juu ya su_ni_kushughulikiwa: rejesta
    // yoyote ile hii inayogusa lazima iwe TAYARI imetengwa rasmi (na
    // hivyo kuhifadhiwa/kurudishwa na utangulizi/mwisho), la sivyo
    // haja hii inakataliwa na njia ya asili ya push/pop inatumika.
    n32 nafasi = su_rejestwa_idadi;
    kama (haja > nafasi) { rudisha 0; }
    su_zilizokopwa = 0;
    su_ndani_ya_tathmini = 1;
    su_zalisha_ndani(nodi, kazi_nodi);
    su_ndani_ya_tathmini = 0;
    rudisha 1;
}

// Tathmini mti wa usemi (uliothibitishwa TAYARI kutoshea kwenye
// rejesta zinazopatikana na mwitaji -- kazi hii YENYEWE haikagui
// upatikanaji tena) ukitumia ugawaji wa rejesta wa muda. Matokeo
// huishia kwenye rax/eax, aina na upana sahihi kwa ast_thamani[node]
// -- NAFASI YA MOJA KWA MOJA ya uzalishaji_usemi(node) kwa nodi
// zinazoshughulikiwa; nodi zisizoshughulikiwa zinapitishwa moja kwa
// moja kwa uzalishaji_usemi bila mabadiliko.
//
// MPANGILIO WA UTATHMINI: KULIA KWANZA (kinashikiliwa kwenye rejesta
// ya kudumu), KISHA KUSHOTO (kinaunganisha na kilichoshikiliwa) --
// SAWA KABISA na mpangilio wa asili wa uzalishaji_jumlisha/tofauti/
// zidisha KILA MAHALI (angalia maelezo marefu juu ya su_haja_rejista
// kwa nini upangaji upya wa Sethi-Ullman uliondolewa -- mdudu halisi
// uliogunduliwa ulithibitisha kubadilisha mpangilio huu kunavunja
// msimbo wenye wito wa kazi wenye madhara ya kando ndani ya usemi).
w0 su_zalisha_ndani(n32 nodi, n32 kazi_nodi) {
    kama (su_ni_kushughulikiwa(nodi) == 0) {
        uzalishaji_usemi(nodi, kazi_nodi);
        rudisha;
    }
    n32 aina = mti_aina[nodi];
    n32 usimbaji = mti_thamani[nodi];
    n32 saizi = ukubwa_kutoka_usimbaji(usimbaji);
    n32 l = mti_kushoto[nodi];
    n32 r = mti_kulia[nodi];

    // KULIA KWANZA -- rejesta zote zinapatikana bado (hakuna
    // kinachoshikiliwa na mzazi huyu bado).
    kama (su_ni_kushughulikiwa(r)) { su_zalisha_ndani(r, kazi_nodi); }
    sivyo { uzalishaji_usemi(r, kazi_nodi); }
    badili_mpaka_wa_desimali(r, usimbaji);
    sawazisha_eax_kwa_usimbaji(usimbaji);
    n32 rasimu_id = rega_tumika_idadi + su_zilizokopwa;
    n32 rasimu_halisi = regista_halisi_kwa_id(rasimu_id);
    su_zilizokopwa = su_zilizokopwa + 1;
    andika_mov_reg64_rax(rasimu_halisi);

    // KUSHOTO PILI -- rejesta moja (scratch_id) tayari imeshikwa
    // (thamani ya kulia), ila hesabu ya su_haja_rejista tayari
    // ilihakikisha upande huu unatoshea kwenye zilizobaki.
    kama (su_ni_kushughulikiwa(l)) { su_zalisha_ndani(l, kazi_nodi); }
    sivyo { uzalishaji_usemi(l, kazi_nodi); }
    badili_mpaka_wa_desimali(l, usimbaji);

    // Unganisha. Baada ya hatua mbili hapo juu: scratch_halisi ina
    // thamani ya KULIA, rax ina thamani ya KUSHOTO -- sawa KABISA na
    // njia ya asili (uzalishaji_jumlisha/tofauti/zidisha, ambayo
    // ilikuwa ikitumia vuta_thamani_rcx kuleta thamani ya kulia
    // kutoka rafuni hadi rcx hapa hapa -- sisi tunaileta kutoka
    // rejesta ya kudumu badala yake).
    kama (aina == MTI_JUMLISHA) {
        andika_mov_rcx_reg64(rasimu_halisi);
        kama (saizi >= 8) { andika_add_rax_rcx(); } sivyo { andika_add_eax_ecx(); }
    } sivyo { kama (aina == MTI_ZIDISHA) {
            andika_mov_rcx_reg64(rasimu_halisi);
            kama (saizi >= 8) { andika_imul_rax_rcx(); } sivyo { andika_imul_eax_ecx(); }
        } sivyo {
            // AST_TOFAUTI: rax(kushoto) - scratch(kulia) -- sawa
            // kabisa na njia ya asili (sub eax,ecx ambapo ecx=kulia).
            andika_mov_rcx_reg64(rasimu_halisi);
            kama (saizi >= 8) { andika_sub_rax_rcx(); } sivyo { andika_sub_eax_ecx(); }
        } }
    su_zilizokopwa = su_zilizokopwa - 1;
}

// -------------------------------------------------------
// Pande mbili za operesheni BILA push/pop kwenye rafu
// -------------------------------------------------------
// Njia ya asili (bado ipo, kama njia ya kurudi nyuma) kwa kila
// operesheni ya jozi ni: kulia -> sukuma -> kushoto -> vuta. Kwa
// vigezo vya kawaida (a + b, x * y, c[i] + aik * b[j]) hiyo ni
// safari mbili za kumbukumbu za rafu kwa kila operesheni bila sababu.
// toa_pande_mbili inaacha kushoto kwenye rax/xmm0 na kulia kwenye
// rcx/xmm1 -- sawa kabisa na njia ya asili -- lakini kwa njia tatu:
//
//  A. KUSHOTO ni jani (namba/kitambulisho): kulia (kwanza, mpangilio
//     wa asili) -> rcx/xmm1 kwa mov ya rejesta hadi rejesta; kisha jani
//     linapakiwa (rax/xmm0 PEKEE, halichafui rcx/xmm1). Mpangilio wa
//     utathmini HAUBADILIKI.
//  B. (NAMBA KAMILI) KULIA ni jani -- namba ya kudumu, au kigezo cha
//     ndani/paramu (rejesta au rafu) chenye upana ule ule wa
//     operesheni. Kushoto huenda kwanza kwenye rax, kisha jani
//     linapakiwa moja kwa moja rcx. Hii INABADILISHA mpangilio (kulia
//     kinasomwa BAADA ya kushoto), hivyo kwa kigezo (si namba)
//     inahitaji kushoto kuwa salama (jr_ni_salama: hakuna wito, hakuna
//     uandishi) ili kisiweze kubadilisha kigezo hicho kabla hakijasomwa.
//  C. (DESIMALI) kushoto hana wito wowote: kulia -> xmm0, huhifadhiwa
//     kwenye xmm2..xmm7 (kina jr_xmm_kina), kushoto -> xmm0, kisha
//     xmm1 = ile iliyohifadhiwa. Rejesta za xmm zote ni caller-saved,
//     kwa hiyo wito ndani ya kushoto ungeziharibu -- ndiyo sababu
//     jr_ni_salama inahitajika. Kina zaidi ya 6 -> njia ya asili.
//
// Kinachobaki njia ya asili (push/pop): namba kamili ambapo pande
// zote mbili si majani, na desimali ambapo kushoto ina wito.

// Idadi ya rejesta za xmm (kuanzia xmm2) zilizoshikiliwa sasa.
n32 jr_xmm_kina = 0;

// Kigezo cha ndani (si safu) au paramu kilichopatikana kwa jina --
// NAKALA ya utafutaji wa uzalishaji_kitambulisho (mpangilio ule ule).
// Huweka jr_kigeu_reg (id ya rejesta ya kudumu, au -1 = rafu),
// jr_kigeu_off na jr_kigeu_enc; inarudisha 1 kama kimepatikana.
n32 jr_kigeu_reg = -1;
n32 jr_kigeu_ofseti = 0;
n32 jr_kigeu_usimbaji = 0;
n32 jr_tafuta_kigeu(n32 nodi, n32 kazi_nodi) {
    kama (mti_aina[nodi] != MTI_KITAMBULISHO) { rudisha 0; }
    n8* jina = mti_dimbwi + mti_jina_ofseti[nodi];
    kama (jina[0] == 34) { rudisha 0; }   // herufi halisi ("...")
    n32 i = 0;
    wakati (i < kigeu_idadi) {
        kama (jina_linganisha(kigeu_dimbwi + kigeu_jina_ofseti[i], jina)) {
            kama (kigeu_ni_safu[i] == 1) { rudisha 0; }
            jr_kigeu_reg = kigeu_reg[i];
            jr_kigeu_ofseti = kigeu_rbp_ofseti[i];
            jr_kigeu_usimbaji = kigeu_usimbaji[i];
            rudisha 1;
        }
        i = i + 1;
    }
    kama (kazi_nodi < 0) { rudisha 0; }
    n32 kigezo = mti_kulia[kazi_nodi];
    n32 sasa_ofseti = 0;
    wakati (kigezo != -1) {
        n32 usimbaji = mti_thamani[kigezo];
        n32 ukubwa_huu = ukubwa_kutoka_usimbaji(usimbaji);
        kama (ukubwa_huu == 0) { ukubwa_huu = 4; }
        sasa_ofseti = sasa_ofseti + ukubwa_huu;
        kama (linganisha_mfuatano(mti_dimbwi + mti_jina_ofseti[kigezo], jina) == 0) {
            jr_kigeu_reg = -1;
            jr_kigeu_ofseti = sasa_ofseti;
            jr_kigeu_usimbaji = usimbaji;
            rudisha 1;
        }
        kigezo = mti_kulia[kigezo];
    }
    rudisha 0;
}

// Mti mdogo ambao hauna wito wala uandishi wowote (hauwezi kubadilisha
// kigezo chochote, wala kuharibu rejesta za xmm): namba, vitambulisho,
// hesabu/ulinganishi/biti, na usomaji wa kumbukumbu (arr[i], *p).
// Orodha ya nodi zinazokubaliwa ni FINYU kwa makusudi -- nodi yoyote
// isiyoorodheshwa inakataliwa (salama: tunapoteza uboreshaji tu).
n32 jr_ni_salama(n32 nodi) {
    kama (nodi == -1) { rudisha 1; }
    n32 a = mti_aina[nodi];
    kama (a == MTI_NAMBARI || a == MTI_HALISI_D || a == MTI_KITAMBULISHO) { rudisha 1; }
    kama (a == MTI_TAJA || a == MTI_JUMLISHA || a == MTI_TOFAUTI || a == MTI_ZIDISHA ||
          a == MTI_GAWANYA || a == MTI_MODULO || a == MTI_BITI_AU || a == MTI_BITI_NA ||
          a == MTI_XOR || a == MTI_HAMISHA_KUSHOTO || a == MTI_HAMISHA_KULIA) {
        kama (jr_ni_salama(mti_kushoto[nodi]) == 0) { rudisha 0; }
        rudisha jr_ni_salama(mti_kulia[nodi]);
    }
    rudisha 0;
}

// Je, `node` ni jani ambalo uzalishaji_usemi unalipakia kwa maagizo
// yanayogusa rax/xmm0 PEKEE (bila rcx, xmm1, wala rafu)?
n32 jr_ni_jani(n32 nodi) {
    kama (nodi == -1) { rudisha 0; }
    n32 a = mti_aina[nodi];
    rudisha (a == MTI_NAMBARI || a == MTI_HALISI_D || a == MTI_KITAMBULISHO);
}

// mov ecx/rcx, [rbp - off]  (8B /r; REX.W kwa baiti 8)
w0 andika_mov_rcx_rbp_ofseti_saizi(n32 ofseti, n32 saizi) {
    kama (saizi >= 8) { andika_baiti(72); }
    andika_baiti(139);
    kama (ofseti < 128) {
        andika_baiti(77); andika_baiti((256 - ofseti) & 255);
    } sivyo {
        andika_baiti(141); andika_disp32_ya_ofseti(ofseti);
    }
}

// Je, `node` inaweza kupakiwa moja kwa moja kwenye rcx (namba kamili,
// upana `saizi_op` = 4 au 8, hakuna ubadilishaji wa upana/ishara)?
// n64 halisi (ast_kulia == 1) haikubaliwi -- imm64 ina njia yake.
n32 jr_jani_rcx(n32 nodi, n32 kazi_nodi, n32 saizi_kitendo) {
    kama (nodi == -1) { rudisha 0; }
    kama (saizi_kitendo != 4 && saizi_kitendo != 8) { rudisha 0; }
    kama (mti_aina[nodi] == MTI_NAMBARI) {
        kama (mti_kulia[nodi] == 1) { rudisha 0; }
        // Upana 8: uzalishaji_usemi hupanua ishara ya namba hasi (mov eax +
        // cdqe, mfano "0 - 10000" iliyokunjwa), lakini mov ecx hupanua kwa
        // sifuri -- kwa hiyo namba hasi hazikubaliwi hapa.
        kama (saizi_kitendo == 8 && mti_thamani[nodi] < 0) { rudisha 0; }
        rudisha 1;
    }
    kama (jr_tafuta_kigeu(nodi, kazi_nodi) == 0) { rudisha 0; }
    n32 e = jr_kigeu_usimbaji;
    kama (ni_desimali_usimbaji(e)) { rudisha 0; }
    kama (e < 0 && (e / 2) * 2 == e) { rudisha 0; }   // muundo kwa thamani
    rudisha ukubwa_kutoka_usimbaji(e) == saizi_kitendo;
}

// Pakia jani lililokubaliwa na jr_jani_rcx kwenye rcx/ecx.
w0 jr_pakia_jani_rcx(n32 nodi, n32 kazi_nodi, n32 saizi_kitendo) {
    kama (mti_aina[nodi] == MTI_NAMBARI) { andika_mov_ecx_imm32(mti_thamani[nodi]); rudisha; }
    jr_tafuta_kigeu(nodi, kazi_nodi);
    kama (jr_kigeu_reg >= 0) { andika_mov_rcx_reg64(regista_halisi_kwa_id(jr_kigeu_reg)); rudisha; }
    andika_mov_rcx_rbp_ofseti_saizi(jr_kigeu_ofseti, saizi_kitendo);
}

// movapd xmmN, xmm0 (66 0F 28 /r, N = 2..7)
w0 andika_movapd_xmmn_xmm0(n32 n) {
    andika_baiti(102); andika_baiti(15); andika_baiti(40); andika_baiti(192 + (n * 8));
}
// movapd xmm1, xmmN (66 0F 28 /r, N = 2..7)
w0 andika_movapd_xmm1_xmmn(n32 n) {
    andika_baiti(102); andika_baiti(15); andika_baiti(40); andika_baiti(200 + n);
}
// movapd xmm0, xmmN (66 0F 28 /r, N = 2..7)
w0 andika_movapd_xmm0_xmmn(n32 n) {
    andika_baiti(102); andika_baiti(15); andika_baiti(40); andika_baiti(192 + n);
}
// movapd xmm1, xmm0 (66 0F 28 C8)
w0 andika_movapd_xmm1_xmm0() {
    andika_baiti(102); andika_baiti(15); andika_baiti(40); andika_baiti(200);
}

// Tathmini pande zote mbili za nodi ya jozi (jumlisha, ulinganishi,
// n.k.): kushoto -> rax/xmm0, kulia -> rcx/xmm1. `enc` ni enc ya
// operesheni (ast_thamani[node]).
w0 toa_pande_mbili(n32 nodi, n32 kazi_nodi, n32 usimbaji) {
    n32 kushoto = mti_kushoto[nodi];
    n32 kulia = mti_kulia[nodi];
    n32 saizi = ukubwa_kutoka_usimbaji(usimbaji);

    kama (ni_desimali_usimbaji(usimbaji) == 0) {
        // B: kulia ni jani
        kama (jr_jani_rcx(kulia, kazi_nodi, saizi)) {
            kama (mti_aina[kulia] == MTI_NAMBARI || jr_ni_salama(kushoto)) {
                uzalishaji_usemi(kushoto, kazi_nodi);
                badili_mpaka_wa_desimali(kushoto, usimbaji);
                jr_pakia_jani_rcx(kulia, kazi_nodi, saizi);
                rudisha;
            }
        }
        // A: kushoto ni jani
        kama (jr_ni_jani(kushoto)) {
            uzalishaji_usemi(kulia, kazi_nodi);
            badili_mpaka_wa_desimali(kulia, usimbaji);
            andika_mov_rcx_rax();
            uzalishaji_usemi(kushoto, kazi_nodi);
            badili_mpaka_wa_desimali(kushoto, usimbaji);
            rudisha;
        }
    } sivyo {
        // A: kushoto ni jani
        kama (jr_ni_jani(kushoto)) {
            uzalishaji_usemi(kulia, kazi_nodi);
            badili_mpaka_wa_desimali(kulia, usimbaji);
            andika_movapd_xmm1_xmm0();
            uzalishaji_usemi(kushoto, kazi_nodi);
            badili_mpaka_wa_desimali(kushoto, usimbaji);
            rudisha;
        }
        // C: kushoto haina wito, na kuna rejesta ya xmm iliyobaki
        kama (jr_xmm_kina < 6 && jr_ni_salama(kushoto)) {
            n32 n = 2 + jr_xmm_kina;
            uzalishaji_usemi(kulia, kazi_nodi);
            badili_mpaka_wa_desimali(kulia, usimbaji);
            andika_movapd_xmmn_xmm0(n);
            jr_xmm_kina = jr_xmm_kina + 1;
            uzalishaji_usemi(kushoto, kazi_nodi);
            badili_mpaka_wa_desimali(kushoto, usimbaji);
            jr_xmm_kina = jr_xmm_kina - 1;
            andika_movapd_xmm1_xmmn(n);
            rudisha;
        }
    }

    // Njia ya asili
    uzalishaji_usemi(kulia, kazi_nodi);
    badili_mpaka_wa_desimali(kulia, usimbaji);
    sukuma_thamani(usimbaji);
    uzalishaji_usemi(kushoto, kazi_nodi);
    badili_mpaka_wa_desimali(kushoto, usimbaji);
    vuta_thamani_rcx(usimbaji);
}

// -------------------------------------------------------
// Ulinganishi wa namba kamili (biti 32/64) bila kupakia operanda kwenye
// rax/rcx pale mmoja au wote ni kigezo cha rejesta/rafu au namba ya
// kudumu: "cmp r13d, ebx" badala ya "mov rax,r13; cdqe; mov rcx,rbx;
// cmp eax,ecx". Bendera zinazotolewa ni zile zile (kushoto - kulia), kwa
// hiyo jcc/setcc zinazofuata hazibadiliki.
//
// Mpangilio wa tathmini: kulia (usemi usio jani) hutathminiwa KWANZA kama
// zamani; kigezo cha kushoto kinasomwa na cmp yenyewe (baada ya kulia,
// sawa na asili). Kushoto usemi na kulia kigezo (kinasomwa BAADA ya
// kushoto) kinahitaji jr_ni_salama(kushoto), kama njia B ya toa_pande_mbili.
// -------------------------------------------------------

// Kigezo cha ndani/paramu cha namba kamili chenye upana `saizi` (4 au 8),
// si desimali, si muundo kwa thamani. Inajaza jr_kigeu_*.
n32 jr_kigeu_namba(n32 nodi, n32 kazi_nodi, n32 saizi) {
    kama (jr_tafuta_kigeu(nodi, kazi_nodi) == 0) { rudisha 0; }
    n32 e = jr_kigeu_usimbaji;
    kama (ni_desimali_usimbaji(e)) { rudisha 0; }
    kama (e < 0 && (e / 2) * 2 == e) { rudisha 0; }
    rudisha ukubwa_kutoka_usimbaji(e) == saizi;
}

// REX (kama inahitajika) + opcode + ModRM + disp kwa operesheni ya cmp
// "op regfield, r/m" ambapo r/m ni rejesta (kind 1, a = nambari halisi
// 0..15) au [rbp - a] (kind 2). regfield ni rejesta halisi au tarakimu /7.
w0 jr_toa_cmp(n32 opc, n32 regfield, n32 aina, n32 a, n32 saizi) {
    n32 rex = 0;
    kama (saizi >= 8) { rex = rex + 8; }
    kama (regfield >= 8) { rex = rex + 4; }
    kama (aina == 1 && a >= 8) { rex = rex + 1; }
    kama (rex != 0) { andika_baiti(64 + rex); }
    andika_baiti(opc);
    n32 r7 = regfield - ((regfield / 8) * 8);
    kama (aina == 1) {
        n32 b7 = a - ((a / 8) * 8);
        andika_baiti(192 + (r7 * 8) + b7);
        rudisha;
    }
    kama (a < 128) {
        andika_baiti(64 + (r7 * 8) + 5);
        andika_baiti((256 - a) & 255);
    } sivyo {
        andika_baiti(128 + (r7 * 8) + 5);
        andika_disp32_ya_ofseti(a);
    }
}

// Inarudisha 1 kama imetoa tathmini ya pande zote mbili NA cmp; 0 kama
// mwitaji aendelee na njia ya kawaida (hakuna kilichotolewa).
n32 jr_cmp_moja_kwa_moja(n32 nodi, n32 kazi_nodi, n32 usimbaji) {
    kama (ni_desimali_usimbaji(usimbaji)) { rudisha 0; }
    n32 saizi = ukubwa_kutoka_usimbaji(usimbaji);
    kama (saizi != 4 && saizi != 8) { rudisha 0; }
    n32 kushoto = mti_kushoto[nodi];
    n32 kulia = mti_kulia[nodi];
    n32 lk = 0; n32 la = 0;
    kama (jr_kigeu_namba(kushoto, kazi_nodi, saizi)) {
        kama (jr_kigeu_reg >= 0) { lk = 1; la = regista_halisi_kwa_id(jr_kigeu_reg); }
        sivyo { lk = 2; la = jr_kigeu_ofseti; }
    }
    n32 rk = 0; n32 ra = 0;
    kama (mti_aina[kulia] == MTI_NAMBARI) {
        kama (jr_jani_rcx(kulia, kazi_nodi, saizi)) { rk = 3; ra = mti_thamani[kulia]; }
    } sivyo { kama (jr_kigeu_namba(kulia, kazi_nodi, saizi)) {
            kama (jr_kigeu_reg >= 0) { rk = 1; ra = regista_halisi_kwa_id(jr_kigeu_reg); }
            sivyo { rk = 2; ra = jr_kigeu_ofseti; }
        } }

    kama (lk != 0 && rk != 0) {
        kama (rk == 3) {
            jr_toa_cmp(129, 7, lk, la, saizi);         // cmp L, imm32 (81 /7)
            andika_neno4(ra);
            rudisha 1;
        }
        kama (rk == 1) {
            jr_toa_cmp(57, ra, lk, la, saizi);         // cmp L, reg (39 /r)
            rudisha 1;
        }
        kama (lk == 1) {
            jr_toa_cmp(59, la, rk, ra, saizi);         // cmp reg, [mem] (3B /r)
            rudisha 1;
        }
        rudisha 0;   // kumbukumbu dhidi ya kumbukumbu
    }
    kama (lk != 0) {
        // kulia usemi: kwanza, kisha kigezo cha kushoto kinasomwa na cmp
        uzalishaji_usemi(kulia, kazi_nodi);
        badili_mpaka_wa_desimali(kulia, usimbaji);
        jr_toa_cmp(57, 0, lk, la, saizi);              // cmp L, rax (39 /r, reg = rax)
        rudisha 1;
    }
    kama (rk != 0) {
        kama (rk != 3 && jr_ni_salama(kushoto) == 0) { rudisha 0; }
        uzalishaji_usemi(kushoto, kazi_nodi);
        badili_mpaka_wa_desimali(kushoto, usimbaji);
        kama (rk == 3) {
            jr_toa_cmp(129, 7, 1, 0, saizi);           // cmp rax, imm32
            andika_neno4(ra);
        } sivyo { kama (rk == 1) {
                jr_toa_cmp(57, ra, 1, 0, saizi);       // cmp rax, reg
            } sivyo {
                jr_toa_cmp(59, 0, 2, ra, saizi);       // cmp rax, [mem]
            } }
        rudisha 1;
    }
    rudisha 0;
}

// Pande zote mbili za ulinganishi na cmp yenyewe: bendera zimewekwa kwa
// (kushoto - kulia) baada ya kurudi.
w0 toa_cmp_pande_mbili(n32 nodi, n32 kazi_nodi, n32 usimbaji) {
    kama (jr_cmp_moja_kwa_moja(nodi, kazi_nodi, usimbaji)) { rudisha; }
    toa_pande_mbili(nodi, kazi_nodi, usimbaji);
    uzalishaji_cmp_kwa_usimbaji(usimbaji);
}

// Msingi wa arr[i] unaoweza kupakiwa moja kwa moja rcx (bila kugusa rax):
//   1 = kigezo cha kielekezi (rejesta, rafu, paramu) -> mov rcx, kigezo
//   2 = safu ya ndani (si paramu) -> lea rcx, [rbp-off]
//       (utafutaji ule ule wa uzalishaji_kitambulisho: jina la kwanza ndilo)
//   0 = hapana
n32 jr_msingi_ofseti = 0;
n32 jr_msingi_aina(n32 nodi, n32 kazi_nodi) {
    kama (jr_jani_rcx(nodi, kazi_nodi, 8)) { rudisha 1; }
    kama (mti_aina[nodi] != MTI_KITAMBULISHO) { rudisha 0; }
    n8* jina_s = mti_dimbwi + mti_jina_ofseti[nodi];
    kama (jina_s[0] == 34) { rudisha 0; }
    n32 si = 0;
    wakati (si < kigeu_idadi) {
        kama (jina_linganisha(kigeu_dimbwi + kigeu_jina_ofseti[si], jina_s)) {
            kama (kigeu_ni_safu[si] == 1) {
                jr_msingi_ofseti = kigeu_rbp_ofseti[si];
                rudisha 2;
            }
            rudisha 0;
        }
        si = si + 1;
    }
    rudisha 0;
}

w0 jr_pakia_msingi_rcx(n32 aina, n32 nodi, n32 kazi_nodi) {
    kama (aina == 1) { jr_pakia_jani_rcx(nodi, kazi_nodi, 8); rudisha; }
    // jr_msingi_off huandikwa upya na kila jr_msingi_aina -- faharasa (iliyotathminiwa
    // kati ya uamuzi na upakiaji) inaweza kuwa imeandika juu yake; tafuta tena.
    jr_msingi_aina(nodi, kazi_nodi);
    n32 ofseti_s = jr_msingi_ofseti;
    andika_baiti(72); andika_baiti(141);   // lea rcx, [rbp-off]
    kama (ofseti_s < 128) {
        andika_baiti(77); andika_baiti((256 - ofseti_s) & 255);
    } sivyo {
        andika_baiti(141); andika_disp32_ya_ofseti(ofseti_s);
    }
}

// rax = ofseti (tayari imeongezwa kwa ukubwa wa kipengele) -> rax =
// msingi + ofseti. Msingi ukiwa jani (angalia jr_msingi_aina) hupakiwa moja
// kwa moja rcx BAADA ya faharasa (mpangilio ule ule wa asili: faharasa
// kwanza, msingi baadaye) -- hakuna push/pop.
w0 toa_ongeza_msingi(n32 msingi_nodi, n32 kazi_nodi) {
    n32 ma = jr_msingi_aina(msingi_nodi, kazi_nodi);
    kama (ma != 0) {
        jr_pakia_msingi_rcx(ma, msingi_nodi, kazi_nodi);
        andika_add_rax_rcx();
        rudisha;
    }
    andika_push_rax();  // hifadhi ofseti
    uzalishaji_usemi(msingi_nodi, kazi_nodi);  // rax = msingi
    andika_pop_rcx();  // rcx = ofseti
    andika_add_rax_rcx();  // rax = msingi + ofseti
}

// Pakia kipengele cha scalar kutoka [rcx + rax * saizi] (SIB) -- agizo moja
// badala ya shl + cdqe + add + pakia. rax = faharasa iliyopanuliwa kwa ishara,
// rcx = msingi. Upana wa upakiaji (kutoka enc) lazima ulingane na saizi.
w0 andika_pakia_sib_kwa_usimbaji(n32 usimbaji, n32 saizi) {
    n32 sib = 1;                     // base = rcx, index = rax
    kama (saizi == 2) { sib = 65; }
    kama (saizi == 4) { sib = 129; }
    kama (saizi == 8) { sib = 193; }
    kama (ni_desimali_usimbaji(usimbaji)) {
        kama (saizi >= 8) { andika_baiti(242); } sivyo { andika_baiti(243); }
        andika_baiti(15); andika_baiti(16); andika_baiti(4); andika_baiti(sib);
        rudisha;
    }
    kama (saizi == 1) {
        andika_baiti(15);
        kama (ni_bila_ishara_usimbaji(usimbaji)) { andika_baiti(182); } sivyo { andika_baiti(190); }
        andika_baiti(4); andika_baiti(sib);
        rudisha;
    }
    kama (saizi == 2) {
        andika_baiti(15);
        kama (ni_bila_ishara_usimbaji(usimbaji)) { andika_baiti(183); } sivyo { andika_baiti(191); }
        andika_baiti(4); andika_baiti(sib);
        rudisha;
    }
    kama (saizi == 8) { andika_baiti(72); }
    andika_baiti(139); andika_baiti(4); andika_baiti(sib);
}

// -------------------------------------------------------
// Uhifadhi wa arr[idx] = thamani kwa SIB moja kwa moja ([r9 + r8*saizi])
// pale msingi ni jani na RHS ni salama (angalia jr_ni_salama) -- badala
// ya kukokotoa anwani kamili (shl+add), kuihifadhi kwenye rafu (push),
// kutathmini RHS, kisha kuivuta (pop). r8/r9 ni salama kushikilia
// wakati RHS inatathminiwa KWA SABABU jr_ni_salama inakataa wito wowote
// (r8/r9 zinaguswa NA syscall/wito PEKEE -- angalia andika_pakia_gp_reg_
// kwa_enc/pop_r8/pop_r9 -- hazitumiki kamwe na msimbo wa hesabu safi).
// -------------------------------------------------------

// mov r8, rax (49 89 C0) -- hifadhi faharasa (tayari imepanuliwa)
w0 andika_mov_r8_rax() { andika_baiti(73); andika_baiti(137); andika_baiti(192); }
// mov r9, rcx (49 89 C9) -- hifadhi msingi
w0 andika_mov_r9_rcx() { andika_baiti(73); andika_baiti(137); andika_baiti(201); }

// [r9 + r8*saizi] = thamani (rax/eax/ax/al au xmm0). SIB byte ni SAWA
// na andika_pakia_sib_kwa_enc (index low3=000 kama rax, base low3=001
// kama rcx -- r8/r9 wana low3 zilezile, tofauti pekee ni REX.X (index
// r8) na REX.B (base r9) badala ya kutokuwepo kabisa).
w0 andika_hifadhi_sib_r9_r8(n32 usimbaji, n32 saizi) {
    n32 sib = 8;
    kama (saizi == 2) { sib = 65; }
    kama (saizi == 4) { sib = 129; }
    kama (saizi == 8) { sib = 193; }
    kama (ni_desimali_usimbaji(usimbaji)) {
        kama (saizi >= 8) { andika_baiti(242); } sivyo { andika_baiti(243); }
        andika_baiti(67);  // REX.XB (0x40|X|B, hakuna W -- SSE haihitaji)
        andika_baiti(15); andika_baiti(17); andika_baiti(4); andika_baiti(sib);
        rudisha;
    }
    kama (saizi == 1) {
        andika_baiti(67);  // REX.XB
        andika_baiti(136); andika_baiti(4); andika_baiti(sib);
        rudisha;
    }
    kama (saizi == 2) { andika_baiti(102); }  // 0x66 operand-size (KABLA ya REX)
    kama (saizi == 8) { andika_baiti(75); }   // REX.WXB
    sivyo { andika_baiti(67); }               // REX.XB
    andika_baiti(137); andika_baiti(4); andika_baiti(sib);
}

// Je, arr[idx] = rhs inaweza kutumia njia ya SIB r8/r9 badala ya
// kukokotoa anwani kamili + push/pop? Lazima: si muundo (enc>0), saizi
// ni mojawapo ya 1/2/4/8, msingi ni jani (jr_msingi_aina), na RHS ni
// salama (haiwezi kugusa r8/r9 kwa sababu haina wito -- angalia
// jr_ni_salama). Inaacha jr_msingi_off (kama msingi ni safu ya ndani)
// ikiwa tayari sahihi kwa matumizi ya papo hapo.
n32 uzalishaji_hifadhi_safu_sib(n32 faharasa_nodi, n32 kielekezi_nodi, n32 kulia, n32 usimbaji, n32 kazi_nodi) {
    kama (usimbaji <= 0) { rudisha 0; }
    n32 saizi = ukubwa_wa_kipengele(usimbaji);
    kama (saizi == 0) { saizi = 4; }
    kama (saizi != 1 && saizi != 2 && saizi != 4 && saizi != 8) { rudisha 0; }
    n32 ma = jr_msingi_aina(kielekezi_nodi, kazi_nodi);
    kama (ma == 0) { rudisha 0; }
    kama (jr_ni_salama(kulia) == 0) { rudisha 0; }

    uzalishaji_usemi(faharasa_nodi, kazi_nodi);
    // Panua faharasa kwa usahihi -- kioo cha uzalishaji_nyoosha (SIB
    // ya kusoma, #251): n32 yenye ishara tayari imepanuliwa na
    // panua_ishara_ndogo; nyingine (A32/n64) zinahitaji cdqe hapa.
    n32 ie = mti_thamani[faharasa_nodi];
    kama (mti_aina[faharasa_nodi] == 4) { ie = mti_nne[faharasa_nodi]; }
    n32 tayari = 0;
    kama (mti_aina[faharasa_nodi] != 45 && ie > 0 && ukubwa_kutoka_usimbaji(ie) < 8 && ni_bila_ishara_usimbaji(ie) == 0 && ni_desimali_usimbaji(ie) == 0) { tayari = 1; }
    kama (tayari == 0) { andika_cdqe(); }
    andika_mov_r8_rax();
    jr_pakia_msingi_rcx(ma, kielekezi_nodi, kazi_nodi);
    andika_mov_r9_rcx();

    uzalishaji_usemi(kulia, kazi_nodi);
    badili_mpaka_wa_desimali(kulia, usimbaji);
    andika_hifadhi_sib_r9_r8(usimbaji, saizi);
    rudisha 1;
}

// [r9] = thamani (rax/eax/ax/al au xmm0) -- kioo cha andika_hifadhi_sib_
// r9_r8 lakini BILA faharasa (kwa *ptr = thamani, si arr[idx] = thamani).
// r9 ina low3=001 (sawa na rcx), hivyo ModRM peke yake (bila SIB) inatosha
// -- rm=001 SI 100 (ambayo ingelazimisha SIB kwa force), hivyo
// "mod=00,rm=001" na REX.B ni "[r9]" moja kwa moja.
w0 andika_hifadhi_r9_kwa_usimbaji(n32 usimbaji, n32 saizi) {
    kama (ni_desimali_usimbaji(usimbaji)) {
        kama (saizi >= 8) { andika_baiti(242); } sivyo { andika_baiti(243); }
        andika_baiti(65);  // REX.B
        andika_baiti(15); andika_baiti(17); andika_baiti(1);  // ModRM: mod=00,reg=000,rm=001
        rudisha;
    }
    kama (saizi == 1) {
        andika_baiti(65); andika_baiti(136); andika_baiti(1);
        rudisha;
    }
    kama (saizi == 2) { andika_baiti(102); }
    kama (saizi == 8) { andika_baiti(73); } sivyo { andika_baiti(65); }
    andika_baiti(137); andika_baiti(1);
}

// *ptr = thamani (isiyo ya kiwanja, isiyo ya muundo) kwa njia ya haraka:
// kielekezi kinashikiliwa kwenye r9 (jr_jani_rcx) wakati RHS salama
// inatathminiwa, badala ya push/pop ya anwani. Kioo kidogo cha
// uzalishaji_hifadhi_safu_sib (hakuna faharasa/mizani hapa).
n32 uzalishaji_hifadhi_kielekezi_sib(n32 kielekezi_nodi, n32 kulia, n32 usimbaji, n32 kazi_nodi) {
    kama (usimbaji <= 0) { rudisha 0; }
    n32 saizi = ukubwa_kutoka_usimbaji(usimbaji);
    kama (saizi != 1 && saizi != 2 && saizi != 4 && saizi != 8) { rudisha 0; }
    kama (jr_jani_rcx(kielekezi_nodi, kazi_nodi, 8) == 0) { rudisha 0; }
    kama (jr_ni_salama(kulia) == 0) { rudisha 0; }

    jr_pakia_jani_rcx(kielekezi_nodi, kazi_nodi, 8);
    andika_mov_r9_rcx();
    uzalishaji_usemi(kulia, kazi_nodi);
    badili_mpaka_wa_desimali(kulia, usimbaji);
    andika_hifadhi_r9_kwa_usimbaji(usimbaji, saizi);
    rudisha 1;
}

// [r9+off] = thamani (rax/eax/ax/al au xmm0) -- kioo cha andika_hifadhi_r9_
// kwa_enc lakini na OFSETI YA MARA MOJA (disp8/disp32) iliyoandikwa
// ndani ya ModRM, badala ya kuhitaji "add rax, off" tofauti. off == -1
// ina maana "hakuna ofseti" (sehemu ya kwanza ya muundo) -- sawa na
// off == 0, zote mbili hutumia mod=00 (hakuna baiti ya disp kabisa).
w0 andika_hifadhi_r9_ofseti_kwa_usimbaji(n32 usimbaji, n32 saizi, n32 ofseti) {
    n32 haina_disp = 0;
    kama (ofseti == -1 || ofseti == 0) { haina_disp = 1; }
    n32 mod = 128;   // mod=10 (disp32), kwenye baiti ya ModRM: mod<<6 = 128
    kama (haina_disp) { mod = 0; } sivyo { kama (ofseti > 0 && ofseti < 128) { mod = 64; } }
    kama (ni_desimali_usimbaji(usimbaji)) {
        kama (saizi >= 8) { andika_baiti(242); } sivyo { andika_baiti(243); }
        andika_baiti(65);  // REX.B
        andika_baiti(15); andika_baiti(17); andika_baiti(mod + 1);  // reg=000,rm=001
        kama (haina_disp == 0) {
            kama (mod == 64) { andika_baiti(ofseti); } sivyo { andika_neno4(ofseti); }
        }
        rudisha;
    }
    kama (saizi == 1) {
        andika_baiti(65); andika_baiti(136); andika_baiti(mod + 1);
        kama (haina_disp == 0) {
            kama (mod == 64) { andika_baiti(ofseti); } sivyo { andika_neno4(ofseti); }
        }
        rudisha;
    }
    kama (saizi == 2) { andika_baiti(102); }
    kama (saizi == 8) { andika_baiti(73); } sivyo { andika_baiti(65); }
    andika_baiti(137); andika_baiti(mod + 1);
    kama (haina_disp == 0) {
        kama (mod == 64) { andika_baiti(ofseti); } sivyo { andika_neno4(ofseti); }
    }
}

// kielekezi->sehemu = thamani (isiyo ya kiwanja, isiyo ya muundo) kwa
// njia ya haraka: kioo cha uzalishaji_hifadhi_ptr_sib lakini ofseti ya
// sehemu (mara moja, ilivyowekwa na mkaguzi kwenye ast_nne) inaandikwa
// moja kwa moja ndani ya ModRM/disp -- hakuna "add rax, off" kabisa.
n32 uzalishaji_hifadhi_mshale_sib(n32 kielekezi_nodi, n32 ofseti, n32 kulia, n32 usimbaji, n32 kazi_nodi) {
    kama (usimbaji <= 0) { rudisha 0; }
    n32 saizi = ukubwa_kutoka_usimbaji(usimbaji);
    kama (saizi != 1 && saizi != 2 && saizi != 4 && saizi != 8) { rudisha 0; }
    kama (jr_jani_rcx(kielekezi_nodi, kazi_nodi, 8) == 0) { rudisha 0; }
    kama (jr_ni_salama(kulia) == 0) { rudisha 0; }

    jr_pakia_jani_rcx(kielekezi_nodi, kazi_nodi, 8);
    andika_mov_r9_rcx();
    uzalishaji_usemi(kulia, kazi_nodi);
    badili_mpaka_wa_desimali(kulia, usimbaji);
    andika_hifadhi_r9_ofseti_kwa_usimbaji(usimbaji, saizi, ofseti);
    rudisha 1;
}

// x = x + namba / x = x - namba kwa kigezo cha n32 chenye ishara (kaunta
// za vitanzi): badala ya "mov rax,x; cdqe; mov ecx,imm; add eax,ecx; cdqe;
// mov x,rax" (maagizo 6, kupitia rax), toa
//   rejesta:  add r32, imm32 ; movsxd r64, r32  (r64 huhifadhi thamani
//             iliyopanuliwa kwa ishara -- sheria ya rejesta za kudumu)
//   rafu:     add dword [rbp-off], imm32
// Hesabu ni ya biti 32 (huzunguka kama add eax,ecx), kwa hiyo matokeo ni
// yale yale. Inarudisha 1 kama imetoa msimbo, 0 kama sivyo (mwitaji
// aendelee na njia ya kawaida). `i` = faharisi ya kigezo kwenye var_*,
// `rhs` = upande wa kulia wa ugawaji.
n32 jr_kigezo_ongeza_namba(n32 i, n32 kulia) {
    n32 a = mti_aina[kulia];
    kama (a != MTI_JUMLISHA && a != MTI_TOFAUTI) { rudisha 0; }
    n32 l = mti_kushoto[kulia];
    n32 r = mti_kulia[kulia];
    kama (l == -1 || r == -1) { rudisha 0; }
    kama (mti_aina[l] != MTI_KITAMBULISHO || mti_aina[r] != MTI_NAMBARI) { rudisha 0; }
    kama (mti_kulia[r] == 1) { rudisha 0; }   // n64 halisi
    n32 usimbaji_kitendo = mti_thamani[kulia];
    kama (ni_desimali_usimbaji(usimbaji_kitendo)) { rudisha 0; }
    kama ((usimbaji_kitendo / 2) * 2 != usimbaji_kitendo) { rudisha 0; }   // hesabu ya kielekezi
    kama (ukubwa_kutoka_usimbaji(usimbaji_kitendo) != 4) { rudisha 0; }
    kama (usimbaji_kitendo < 0) { rudisha 0; }
    n32 e = kigeu_usimbaji[i];
    kama (e < 0 || ni_desimali_usimbaji(e) || ni_bila_ishara_usimbaji(e)) { rudisha 0; }
    kama ((e / 2) * 2 != e) { rudisha 0; }
    kama (ukubwa_kutoka_usimbaji(e) != 4) { rudisha 0; }
    kama (kigeu_ni_safu[i] == 1 || kigeu_kwa_rejea[i] == 1) { rudisha 0; }
    // Kitambulisho cha kushoto lazima kiwe KIGEZO HICHO HICHO
    n8* jl = mti_dimbwi + mti_jina_ofseti[l];
    kama (jl[0] == 34) { rudisha 0; }
    kama (jina_linganisha(kigeu_dimbwi + kigeu_jina_ofseti[i], jl) == 0) { rudisha 0; }
    n32 v = mti_thamani[r];
    kama (kigeu_reg[i] >= 0) {
        n32 reg = regista_halisi_kwa_id(kigeu_reg[i]);
        n32 reg7 = reg - ((reg / 8) * 8);
        kama (reg >= 8) { andika_baiti(65); }
        andika_baiti(129);   // 81 /0 (add) au /5 (sub)
        kama (a == MTI_JUMLISHA) { andika_baiti(192 + reg7); } sivyo { andika_baiti(232 + reg7); }
        andika_neno4(v);
        // movsxd r64, r32
        kama (reg >= 8) { andika_baiti(77); } sivyo { andika_baiti(72); }
        andika_baiti(99);
        andika_baiti(192 + (reg7 * 8) + reg7);
        andika_mov_rax_reg64(reg);   // thamani ya ugawaji inabaki rax, kama njia ya kawaida
        rudisha 1;
    }
    n32 ofseti = kigeu_rbp_ofseti[i];
    andika_baiti(129);   // add/sub dword [rbp-off], imm32
    kama (ofseti < 128) {
        kama (a == MTI_JUMLISHA) { andika_baiti(69); } sivyo { andika_baiti(109); }
        andika_baiti((256 - ofseti) & 255);
    } sivyo {
        kama (a == MTI_JUMLISHA) { andika_baiti(133); } sivyo { andika_baiti(173); }
        andika_disp32_ya_ofseti(ofseti);
    }
    andika_neno4(v);
    andika_movsxd_rax_rbp_ofseti(ofseti);   // thamani ya ugawaji inabaki rax
    rudisha 1;
}

// AST_JUMLISHA (6) -- ongeza
w0 uzalishaji_jumlisha(n32 nodi, n32 kazi_nodi) {
    n32 kushoto = mti_kushoto[nodi];
    n32 kulia = mti_kulia[nodi];
    n32 usimbaji = mti_thamani[nodi];
    // Ukubwa hukokotolewa kutoka enc — ast_tiga ya hoja ya wito
    // hubadilishwa na mkaguzi kuwa kiungo cha mnyororo.
    n32 saizi = ukubwa_kutoka_usimbaji(usimbaji);
    n32 ni_d = ni_desimali_usimbaji(usimbaji);

    // Hesabu ya anwani (C-semantiki): p + n inahamisha kwa vipengele
    // vya n, si baiti (t75: *(p + 1) ilisoma ofseti 1 ya baiti badala
    // ya kipengele cha 1). Matokeo ni kielekezi — enc isiyo sawa.
    kama (ni_d == 0) {
        kama ((usimbaji / 2) * 2 != usimbaji) {
            uzalishaji_jumlisha_kielekezi(nodi, kazi_nodi, usimbaji);
            rudisha;
        }
    }

    // Ugawaji wa rejesta wa vigezo vya muda (Sethi-Ullman) -- angalia
    // maelezo kamili juu ya su_jaribu_mzizi/su_zalisha_ndani.
    kama (su_jaribu_mzizi(nodi, kazi_nodi)) { rudisha; }

    toa_pande_mbili(nodi, kazi_nodi, usimbaji);

    kama (ni_d) {
        kama (saizi >= 8) { andika_addsd_xmm0_xmm1(); }
        sivyo { andika_addss_xmm0_xmm1(); }
    } sivyo {
        kama (saizi >= 8) { andika_add_rax_rcx(); }
        sivyo { andika_add_eax_ecx(); }
    }
}

// p + n au n + p: n inazidishwa kwa ukubwa wa kipengele kabla ya
// kujumlishwa. p + p haina maana — mkaguzi anakataa kwa sauti;
// kinga ya pili hapa inalinda njia zisizopitia ukaguzi.
w0 uzalishaji_jumlisha_kielekezi(n32 nodi, n32 kazi_nodi, n32 usimbaji) {
    n32 kushoto = mti_kushoto[nodi];
    n32 kulia = mti_kulia[nodi];
    n32 kushoto_k = usemi_ni_kielekezi(kushoto);
    n32 kulia_k = usemi_ni_kielekezi(kulia);
    kama (kushoto_k) {
        kama (kulia_k) {
            andika_stderr("Hitilafu: kielekezi kwa kielekezi kwenye jumlisha\n");
            wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        }
    }

    // Tathmini RHS → rax; zidisha kama ndiyo namba; kisha sukuma
    uzalishaji_usemi(kulia, kazi_nodi);
    badili_mpaka_wa_desimali(kulia, usimbaji);
    kama (kushoto_k) {
        kama (kulia_k == 0) { andika_ongea_kielekezi_kipengele(usimbaji, aina_ya_usemi(kulia)); }
    }
    sukuma_thamani(usimbaji);
    // Tathmini LHS → rax; zidisha kama ndiyo namba (n + p); jumlisha
    uzalishaji_usemi(kushoto, kazi_nodi);
    badili_mpaka_wa_desimali(kushoto, usimbaji);
    kama (kulia_k) {
        kama (kushoto_k == 0) { andika_ongea_kielekezi_kipengele(usimbaji, aina_ya_usemi(kushoto)); }
    }
    vuta_thamani_rcx(usimbaji);
    andika_add_rax_rcx();
}

// AST_TOFAUTI (7) -- toa
w0 uzalishaji_tofauti(n32 nodi, n32 kazi_nodi) {
    n32 kushoto = mti_kushoto[nodi];
    n32 usimbaji = mti_thamani[nodi];
    n32 saizi = ukubwa_kutoka_usimbaji(usimbaji);
    n32 ni_d = ni_desimali_usimbaji(usimbaji);

    kama (kushoto == -1) {
        uzalishaji_usemi(mti_kulia[nodi], kazi_nodi);
        kama (ni_d) {
            // Matokeo ya usemi wa desimali yuko xmm0: 0.0 - xmm0
            kama (saizi >= 8) {
                // xorpd xmm1,xmm1 (66 0F 57 C9); subsd xmm1,xmm0 (F2 0F 5C C8)
                andika_baiti(102); andika_baiti(15); andika_baiti(87); andika_baiti(201);
                andika_baiti(242); andika_baiti(15); andika_baiti(92); andika_baiti(200);
                // movapd xmm0,xmm1 (66 0F 28 C1)
                andika_baiti(102); andika_baiti(15); andika_baiti(40); andika_baiti(193);
            } sivyo {
                // xorps xmm1,xmm1 (0F 57 C9); subss xmm1,xmm0 (F3 0F 5C C8)
                andika_baiti(15); andika_baiti(87); andika_baiti(201);
                andika_baiti(243); andika_baiti(15); andika_baiti(92); andika_baiti(200);
                // movaps xmm0,xmm1 (0F 28 C1)
                andika_baiti(15); andika_baiti(40); andika_baiti(193);
            }
        } sivyo {
            kama (saizi >= 8) {
                andika_mov_rcx_rax();  // rcx = rax (thamani)
                andika_xor_eax_eax();
                andika_sub_rax_rcx();  // rax = 0 - rcx
            } sivyo {
                andika_neg_eax();
            }
        }
    } sivyo {
        n32 kulia = mti_kulia[nodi];
        // Hesabu ya anwani (C-semantiki): p - n inahamisha kwa vipengele
        // vya n, si baiti (rekodi 8.9). p - p na n - p hazina maana —
        // mkaguzi anakataa kwa sauti; kinga ya pili hapa inalinda njia
        // zisizopitia ukaguzi.
        kama (ni_d == 0) {
            kama ((usimbaji / 2) * 2 != usimbaji) {
                n32 kushoto_k = usemi_ni_kielekezi(kushoto);
                n32 kulia_k = usemi_ni_kielekezi(kulia);
                kama (kushoto_k) {
                    kama (kulia_k == 0) {
                        // p - n: tathmini RHS, zidisha kwa ukubwa wa
                        // kipengele, kisha toa kutoka kwa LHS
                        uzalishaji_usemi(kulia, kazi_nodi);
                        badili_mpaka_wa_desimali(kulia, usimbaji);
                        andika_ongea_kielekezi_kipengele(usimbaji, aina_ya_usemi(kulia));
                        sukuma_thamani(usimbaji);
                        uzalishaji_usemi(kushoto, kazi_nodi);
                        badili_mpaka_wa_desimali(kushoto, usimbaji);
                        vuta_thamani_rcx(usimbaji);
                        andika_sub_rax_rcx();
                        rudisha;
                    }
                    andika_stderr("Hitilafu: kielekezi kwa kielekezi kwenye toa\n");
                    wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
                }
                kama (kulia_k) {
                    andika_stderr("Hitilafu: namba toa kielekezi haina maana\n");
                    wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
                }
                // Ama matokeo ya ulinganishi (B1) — hesabu ya kawaida
                // hapa chini, sawa na zamani.
            }
        }

        // Ugawaji wa rejesta wa vigezo vya muda (Sethi-Ullman) --
        // angalia maelezo kamili juu ya su_jaribu_mzizi/su_zalisha_ndani,
        // karibu na uzalishaji_jumlisha.
        kama (su_jaribu_mzizi(nodi, kazi_nodi)) { rudisha; }

        toa_pande_mbili(nodi, kazi_nodi, usimbaji);

        kama (ni_d) {
            kama (saizi >= 8) { andika_subsd_xmm0_xmm1(); }
            sivyo { andika_subss_xmm0_xmm1(); }
        } sivyo {
            kama (saizi >= 8) { andika_sub_rax_rcx(); }
            sivyo { andika_sub_eax_ecx(); }
        }
    }
}

// AST_ACHILIA (19) -- achilia kumbukumbu (free)
w0 uzalishaji_achilia(n32 nodi, n32 kazi_nodi) {
    uzalishaji_usemi(mti_kushoto[nodi], kazi_nodi);
    n32 nje_id = pata_au_unda_nje("free");
    andika_push_rax();
    andika_baiti(232);
    kama (rela_idadi < 65536) {
        rela_text_ofseti[rela_idadi] = bafa_text_wapi;
        rela_nje_id[rela_idadi] = nje_id;
        rela_idadi = rela_idadi + 1;
    } sivyo {
        andika_stderr("KOSA: jedwali la urekebishaji (rela_*) limejaa (kikomo 65536) — wito wa 'free' hautarekebishwa sahihi\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    andika_neno4(0);
}

// AST_BADILI (48) -- badili kumbukumbu (realloc)
w0 uzalishaji_badili(n32 nodi, n32 kazi_nodi) {
    // Tathmini size (kulia), kisha ptr (kushoto) — kulia kwenda kushoto kwa rafu
    uzalishaji_usemi(mti_kulia[nodi], kazi_nodi);
    andika_push_rax();
    uzalishaji_usemi(mti_kushoto[nodi], kazi_nodi);
    andika_push_rax();
    // Pop kwenye rejista za x86-64 System V: rdi (ptr), rsi (size)
    andika_pop_rdi();
    andika_pop_rsi();
    andika_xor_eax_eax();
    n32 nje_id = pata_au_unda_nje("realloc");
    andika_baiti(232);
    kama (rela_idadi < 65536) {
        rela_text_ofseti[rela_idadi] = bafa_text_wapi;
        rela_nje_id[rela_idadi] = nje_id;
        rela_idadi = rela_idadi + 1;
    } sivyo {
        andika_stderr("KOSA: jedwali la urekebishaji (rela_*) limejaa (kikomo 65536) — wito wa 'realloc' hautarekebishwa sahihi\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    andika_neno4(0);
}

// Msaidizi wa kulinganisha — huchagua 32-bit au 64-bit
w0 uzalishaji_cmp_kwa_saizi(n32 saizi) {
    kama (saizi >= 8) { andika_cmp_rax_rcx(); }
    sivyo { andika_cmp_eax_ecx(); }
}

// Kisaidizi cha ulinganishi kinachozingatia aina (int vs float)
w0 uzalishaji_cmp_kwa_usimbaji(n32 usimbaji) {
    kama (ni_desimali_usimbaji(usimbaji)) {
        n32 saizi = ukubwa_kutoka_usimbaji(usimbaji);
        kama (saizi >= 8) { andika_comisd_xmm0_xmm1(); }
        sivyo { andika_comiss_xmm0_xmm1(); }
    } sivyo {
        n32 saizi = ukubwa_kutoka_usimbaji(usimbaji);
        kama (saizi >= 8) { andika_cmp_rax_rcx(); }
        sivyo { andika_cmp_eax_ecx(); }
    }
}

// Kisaidizi cha kusukuma thamani kwenye rafu (int, D32, au d64)
w0 sukuma_thamani(n32 usimbaji) {
    kama (ni_desimali_usimbaji(usimbaji)) {
        // D32 ni baiti 4 (movss); d64 ni baiti 8 (movsd)
        n32 saizi_s = ukubwa_kutoka_usimbaji(usimbaji);
        kama (saizi_s < 8) { andika_push_xmm0_d32(); }
        sivyo { andika_push_xmm0_d64(); }
    }
    sivyo { andika_push_rax(); }
}

// Kisaidizi cha kuvuta thamani kutoka rafu → rejesta ya pili (int, D32, au d64)
w0 vuta_thamani_rcx(n32 usimbaji) {
    kama (ni_desimali_usimbaji(usimbaji)) {
        n32 saizi_v = ukubwa_kutoka_usimbaji(usimbaji);
        kama (saizi_v < 8) { andika_pop_xmm1_d32(); }
        sivyo { andika_pop_xmm1_d64(); }
    }
    sivyo { andika_pop_rcx(); }
}

// AST_SAWA (20) -- linganisha (==)
w0 uzalishaji_sawa(n32 nodi, n32 kazi_nodi) {
    n32 usimbaji = mti_thamani[nodi];
    n32 ni_d = ni_desimali_usimbaji(usimbaji);

    toa_cmp_pande_mbili(nodi, kazi_nodi, usimbaji);
    andika_sete_al();
    andika_movzx_eax_al();
}

// AST_TOFAUTI_SI (21) -- si sawa (!=)
w0 uzalishaji_tofauti_si(n32 nodi, n32 kazi_nodi) {
    n32 usimbaji = mti_thamani[nodi];
    n32 ni_d = ni_desimali_usimbaji(usimbaji);

    toa_cmp_pande_mbili(nodi, kazi_nodi, usimbaji);
    andika_setne_al();
    andika_movzx_eax_al();
}

// AST_CHINI (22) -- chini (<)
w0 uzalishaji_chini(n32 nodi, n32 kazi_nodi) {
    n32 usimbaji = mti_thamani[nodi];
    n32 ni_d = ni_desimali_usimbaji(usimbaji);

    toa_cmp_pande_mbili(nodi, kazi_nodi, usimbaji);
    weka_setcc_kwa_usimbaji(usimbaji, 0);
    andika_movzx_eax_al();
}

// AST_JUU (23) -- juu (>)
w0 uzalishaji_juu(n32 nodi, n32 kazi_nodi) {
    n32 usimbaji = mti_thamani[nodi];
    n32 ni_d = ni_desimali_usimbaji(usimbaji);

    toa_cmp_pande_mbili(nodi, kazi_nodi, usimbaji);
    weka_setcc_kwa_usimbaji(usimbaji, 1);
    andika_movzx_eax_al();
}

// AST_CHINI_SAWA (24) -- chini au sawa (<=)
w0 uzalishaji_chini_sawa(n32 nodi, n32 kazi_nodi) {
    n32 usimbaji = mti_thamani[nodi];
    n32 ni_d = ni_desimali_usimbaji(usimbaji);

    toa_cmp_pande_mbili(nodi, kazi_nodi, usimbaji);
    weka_setcc_kwa_usimbaji(usimbaji, 2);
    andika_movzx_eax_al();
}

// AST_JUU_SAWA (25) -- juu au sawa (>=)
w0 uzalishaji_juu_sawa(n32 nodi, n32 kazi_nodi) {
    n32 usimbaji = mti_thamani[nodi];
    n32 ni_d = ni_desimali_usimbaji(usimbaji);

    toa_cmp_pande_mbili(nodi, kazi_nodi, usimbaji);
    weka_setcc_kwa_usimbaji(usimbaji, 3);
    andika_movzx_eax_al();
}

// AST_NA (26) -- na la mantiki (&&)
w0 uzalishaji_na(n32 nodi, n32 kazi_nodi) {
    n32 kushoto = mti_kushoto[nodi];
    n32 kulia = mti_kulia[nodi];
    n32 lebo_si_kweli = lebo_bafa_mpya();
    kataa_operesheni_ya_desimali(nodi);

    n32 lebo_mwisho = lebo_bafa_mpya();

    uzalishaji_usemi(kushoto, kazi_nodi);
    andika_test_eax_eax();
    toa_je_lebo(lebo_si_kweli);

    uzalishaji_usemi(kulia, kazi_nodi);
    andika_test_eax_eax();
    toa_je_lebo(lebo_si_kweli);

    andika_mov_eax(1);
    toa_jmp_lebo(lebo_mwisho);

    weka_lebo(lebo_si_kweli);
    andika_mov_eax(0);

    weka_lebo(lebo_mwisho);
}

// AST_AU (27) -- au la mantiki (||)
w0 uzalishaji_au(n32 nodi, n32 kazi_nodi) {
    n32 kushoto = mti_kushoto[nodi];
    n32 kulia = mti_kulia[nodi];
    n32 lebo_kweli = lebo_bafa_mpya();
    kataa_operesheni_ya_desimali(nodi);

    n32 lebo_mwisho = lebo_bafa_mpya();

    uzalishaji_usemi(kushoto, kazi_nodi);
    andika_test_eax_eax();
    toa_jne_lebo(lebo_kweli);

    uzalishaji_usemi(kulia, kazi_nodi);
    andika_test_eax_eax();
    toa_jne_lebo(lebo_kweli);

    andika_mov_eax(0);
    toa_jmp_lebo(lebo_mwisho);

    weka_lebo(lebo_kweli);
    andika_mov_eax(1);

    weka_lebo(lebo_mwisho);
}

// AST_SI (28) -- si (kukanusha)
// Thamani za n64 hujaribiwa kwa 64-bit: 2^32 ina nusu ya chini
// sifuri — test eax pekee ingerudisha 1 kwa jibu lisilo sahihi.
w0 uzalishaji_si(n32 nodi, n32 kazi_nodi) {
    n32 saizi = ukubwa_kutoka_usimbaji(mti_thamani[nodi]);
    uzalishaji_usemi(mti_kushoto[nodi], kazi_nodi);
    kama (saizi >= 8) { andika_test_rax_rax(); }
    sivyo { andika_test_eax_eax(); }
    andika_sete_al();
    andika_movzx_eax_al();
}

// Je, nodi hii ni nambari halisi (tokeni ya moja kwa moja) yenye
// thamani sawa NA nguvu KAMILI ya 2 (2,4,8,16,...)? Kama ndiyo,
// rudisha kipeo (log2) chake (mfano 8 -> 3); vinginevyo rudisha -1.
// Haitumiki kwa thamani za n64 kubwa (dimbwi, ast_kulia==1) -- SI
// muhimu kwa uboreshaji huu (upana wa vitendo vya kudumu vidogo
// pekee ndio vinafaidika kiutendaji hapa).
n32 nguvu_kamili_ya_pili(n32 nodi) {
    kama (mti_aina[nodi] != 4) { rudisha -1; }  // si AST_NAMBARI
    kama (mti_kulia[nodi] == 1) { rudisha -1; }  // n64 kubwa (dimbwi)
    n32 v = mti_thamani[nodi];
    kama (v <= 1) { rudisha -1; }  // 0/1/hasi -- si nguvu ya manufaa
    n32 kipeo = 0;
    n32 x = v;
    wakati (x > 1) {
        kama ((x - ((x / 2) * 2)) != 0) { rudisha -1; }  // isiyo sawa -- si nguvu kamili
        x = x / 2;
        kipeo = kipeo + 1;
    }
    rudisha kipeo;
}

// AST_ZIDISHA (31) -- zidisha
//
// Kupunguza nguvu (strength reduction): zidisho kwa nambari halisi
// iliyo NGUVU KAMILI ya 2 (upande wowote -- zidisho ni la ushirika)
// linatolewa kama SHL (shift-left) badala ya imul -- shl ni sawa
// kabisa na zidisho kwa upande wowote wa ishara (bila utata wa
// mzunguko wa kuzungusha kama vile ingekuwa kwa GAWANYO kwa nguvu ya
// 2 -- hiyo SI salama kwa nambari hasi na HAIJUMUISHWI hapa kwa
// makusudi, kupungua na kizio kunahitaji hatua ya urekebishaji wa
// mzunguko usiyofanana na shr rahisi). Zidisho kwa desimali (d64/D32)
// haliguswi -- shl haina maana kwa desimali kabisa.
w0 uzalishaji_zidisha(n32 nodi, n32 kazi_nodi) {
    n32 usimbaji = mti_thamani[nodi];
    n32 saizi = ukubwa_kutoka_usimbaji(usimbaji);
    n32 ni_d = ni_desimali_usimbaji(usimbaji);

    kama (ni_d == 0) {
        n32 kipeo_kulia = nguvu_kamili_ya_pili(mti_kulia[nodi]);
        kama (kipeo_kulia != -1) {
            uzalishaji_usemi(mti_kushoto[nodi], kazi_nodi);
            badili_mpaka_wa_desimali(mti_kushoto[nodi], usimbaji);
            andika_mov_ecx_imm32(kipeo_kulia);
            kama (saizi >= 8) { andika_shl_rax_cl(); }
            sivyo { andika_shl_eax_cl(); }
            rudisha;
        }
        n32 kipeo_kushoto = nguvu_kamili_ya_pili(mti_kushoto[nodi]);
        kama (kipeo_kushoto != -1) {
            uzalishaji_usemi(mti_kulia[nodi], kazi_nodi);
            badili_mpaka_wa_desimali(mti_kulia[nodi], usimbaji);
            andika_mov_ecx_imm32(kipeo_kushoto);
            kama (saizi >= 8) { andika_shl_rax_cl(); }
            sivyo { andika_shl_eax_cl(); }
            rudisha;
        }
    }

    // Ugawaji wa rejesta wa vigezo vya muda (Sethi-Ullman) -- angalia
    // maelezo kamili juu ya su_jaribu_mzizi/su_zalisha_ndani, karibu
    // na uzalishaji_jumlisha. su_ni_kushughulikiwa (ndani ya
    // su_jaribu_mzizi) tayari inazuia zidisho la nguvu kamili ya 2
    // (limeshughulikiwa hapo juu na njia yake ya shl).
    kama (su_jaribu_mzizi(nodi, kazi_nodi)) { rudisha; }

    toa_pande_mbili(nodi, kazi_nodi, usimbaji);

    kama (ni_d) {
        kama (saizi >= 8) { andika_mulsd_xmm0_xmm1(); }
        sivyo { andika_mulss_xmm0_xmm1(); }
    } sivyo {
        kama (saizi >= 8) { andika_imul_rax_rcx(); }
        sivyo { andika_imul_eax_ecx(); }
    }
}

// Kupunguza nguvu (strength reduction) kwa MGAWANYO na MODULO ya
// nambari kamili yenye ISHARA kwa nguvu kamili ya 2 (d=2^kipeo, upande
// wa KULIA pekee -- mgawanyo/modulo SI wa ushirika, hivyo tofauti na
// zidisho, upande wa KUSHOTO haukaguliwi kamwe).
//
// SABABU hii imekuwa ikiepukwa na kila uboreshaji mwingine kikao hiki
// (angalia maelezo ya LICM/kunja-namba/kashe-ya-anwani): x86 SAR (na
// mabadiliko ya biti kwa ujumla) huzunguka KUELEKEA -INFINITY (floor),
// wakati mgawanyo wa nambari kamili wenye ishara wa lugha hii (kama C)
// HUKATA KUELEKEA SIFURI (truncate) -- SI SAWA kwa nambari HASI.
// Mfano: -7/4 lazima iwe -1 (kukata), LAKINI -7>>2 (SAR rahisi) ni -2
// (floor) -- TOFAUTI. SIO hatari kwa BILA ISHARA (hakuna hasi kuwepo
// kabisa, kukata=floor daima, SHR rahisi ni sahihi moja kwa moja).
//
// SULUHISHO (mbinu ya KAWAIDA ya wakusanyaji halisi -- GCC/LLVM/MSVC
// hutumia HII HII kwa mgawanyo wa nguvu-ya-2 wenye ishara -- angalia
// "Hacker's Delight" au maandiko yoyote ya kawaida ya uboreshaji wa
// mkusanyaji kwa uthibitisho wa kinadharia): ongeza UPENDELEO (bias)
// kwa x KABLA ya kuhamisha, ukitumia BARABARA (branchless) njia ya
// "kinyago cha ishara":
//   kinyago  = x >> (upana-1)     ; SAR -- sifuri kama x>=0, biti
//                                    ZOTE 1 kama x<0
//   upendeleo = kinyago & (d-1)   ; d-1 kama x<0, sifuri kama x>=0
//   x_pendwa  = x + upendeleo
//   q         = x_pendwa >> kipeo  ; SAR (kuhifadhi ishara)
// Kisha MODULO (r = x - q*d, sawa na fomula ya asili ya mgawanyo):
//   r = x - (q << kipeo)
//
// UTHIBITISHO WA MKONO (d=4, kipeo=2, d-1=3 -- imethibitishwa pia kwa
// d=8, kipeo=3, d-1=7 kwenye majaribio ya kudumu):
//   x=-7: kinyago=-1,upendeleo=3,x_pendwa=-4,q=-4>>2=-1 (-7/4 kukata=-1: SAHIHI)
//         r=-7-(-1*4)=-3                                (-7%4=-3: SAHIHI)
//   x=-8: kinyago=-1,upendeleo=3,x_pendwa=-5,q=-5>>2=-2 (-8/4=-2 HASA: SAHIHI)
//         r=-8-(-2*4)=0                                 (-8%4=0: SAHIHI)
//   x=-1: kinyago=-1,upendeleo=3,x_pendwa=2, q=2>>2=0   (-1/4 kukata=0: SAHIHI)
//         r=-1-(0*4)=-1                                 (-1%4=-1: SAHIHI)
//   x=7:  kinyago=0, upendeleo=0,x_pendwa=7, q=7>>2=1   (7/4 kukata=1: SAHIHI)
//         r=7-(1*4)=3                                   (7%4=3: SAHIHI)
//   x=8:  kinyago=0, upendeleo=0,x_pendwa=8, q=8>>2=2   (8/4=2 HASA: SAHIHI)
//         r=8-(2*4)=0                                   (8%4=0: SAHIHI)
//   x=1:  kinyago=0, upendeleo=0,x_pendwa=1, q=1>>2=0   (1/4 kukata=0: SAHIHI)
//         r=1-(0*4)=1                                   (1%4=1: SAHIHI)
//
// WIGO (kwa makusudi mdogo): d LAZIMA iwe NAMBA HALISI YA KUDUMU (si
// kigezo, si dimbwi la n64) na NGUVU KAMILI ya 2 (nguvu_kamili_ya_pili,
// ile ile inayotumika na zidisho) -- d=3,5,6,7... (si nguvu ya 2)
// HUENDELEA kwenye njia ya asili ya idiv (SAHIHI TAYARI, TU si haraka).
// d ISIYO ya KUDUMU (kigezo cha wakati wa kukimbia) pia HUENDELEA
// kwenye idiv -- hakuna njia ya kujua d ni nguvu ya 2 wakati wa
// kukusanya. Desimali (d64/D32) HAIGUSWI KABISA -- uwanja huu ni
// NAMBA KAMILI TU (ni_d imeshughulikiwa kando, angalia chini).
n32 gwm_kipeo_kulia(n32 nodi) {
    rudisha nguvu_kamili_ya_pili(mti_kulia[nodi]);
}

// -------------------------------------------------------
// Kupunguza nguvu (strength reduction) kwa MGAWANYO/MODULO ya nambari
// kamili kwa KIGAWANYAJI CHOCHOTE cha KUDUMU (si nguvu ya 2 tu -- ile
// tayari imeshughulikiwa juu na gwm_kipeo_kulia/nguvu_kamili_ya_pili) --
// "zidisho na uchawi" (magic-number multiplication), mbinu ya KAWAIDA ya
// wakusanyaji halisi (GCC/LLVM/MSVC), inayotoka kwenye karatasi ya
// Granlund na Montgomery (1994) "Division by Invariant Integers using
// Multiplication", iliyoelezwa kwa undani zaidi kwenye "Hacker's
// Delight" (Warren), Sura ya 10.
//
// WIGO (KWA MAKUSUDI MDOGO -- angalia SABABU kwa kila kizuizi):
//   1. UPANA WA n32 TU -- n64 haiguswi kabisa, inabaki kwenye idiv.
//      SABABU: utafutaji wa namba ya uchawi unahitaji usahihi wa upana
//      MARA MBILI ya kigawiwa (64-bit kwa n32) -- n64/A64 ya lugha hii
//      ina UPANA WA KUTOSHA kufanya hilo salama (angalia gwm_tafuta_*
//      chini, zinazotumia n64 moja kwa moja bila hatari ya kufurika).
//      LAKINI kwa n64 YENYEWE, utafutaji ungehitaji usahihi wa 128-bit
//      ambao lugha hii haina aina ya asili ya kuutoa -- kuandika upya
//      mbinu ya "kuongeza mara mbili" ya algorithm ya asili (iliyoundwa
//      MAKUSUDI kwa upana mmoja ili kuepuka kufurika kwa modulo) kwa
//      mkono bila aina pana ya kutosha ni hatari kubwa zaidi ya
//      makosa -- IMEACHWA KIMAKUSUDI kama kazi ya baadaye.
//   2. KIGAWANYAJI d: 2 <= d <= 65536 TU (namba halisi ya moja kwa moja
//      KUDUMU -- si kigezo, si dimbwi la n64, sawa na gwm_kipeo_kulia).
//      SABABU: mipaka hii inahakikisha HESABU ZOTE za utafutaji
//      (n64 ndani ya gwm_tafuta_uchawi_*) zinabaki MBALI SANA na
//      kikomo cha n64 (2^63) bila haja ya uchambuzi wa kina wa
//      kufurika kwa kila hatua moja moja -- vigawanyaji vikubwa zaidi
//      (nadra sana kwenye msimbo halisi) huendelea kutumia idiv,
//      salama TAYARI.
//   3. BILA ISHARA (A32): namba ya uchawi M LAZIMA ITOSHEE kwenye biti
//      32 kikamilifu -- baadhi ya vigawanyaji (mfano maarufu kabisa
//      kwenye maandiko ya somo hili: 7) HUHITAJI hatua ya ziada ya
//      "ongeza" (add-correction) ISIYOTEKELEZWA hapa KWA MAKUSUDI
//      (angalia gwm_tafuta_uchawi_bila_ishara chini) -- hizo HUENDELEA
//      kutumia idiv, salama TAYARI, ni fursa iliyokosekana TU.
//   4. YENYE ISHARA (n32): fomula ya "magic" inashughulikia hatua ya
//      marekebisho (q=q+n endapo M ni hasi) MOJA KWA MOJA kama SEHEMU
//      ya kawaida ya fomula (SI hali ya "kushindwa" -- ni hatua
//      inayotarajiwa kwa baadhi ya vigawanyaji, HAIHITAJI kurudi
//      kwenye idiv). Kwa d>0 TU: kigawanyaji hasi kilichoandikwa moja
//      kwa moja HAKIWEZI kuwa AST_NAMBARI moja kwa moja (angalia jinsi
//      "0-7" inavyochanganuliwa kama TOFAUTI/AST_TOFAUTI, si namba
//      hasi ya moja kwa moja -- ast_thamani ya AST_NAMBARI ni HASI
//      KAMWE kwenye lugha hii) -- hivyo tawi la d<0 la fomula asilia
//      halihitajiki kabisa hapa, limeachwa kimakusudi.
//
// UTHIBITISHO: fomula ZOTE MBILI (bila ishara na yenye ishara)
// zimejaribiwa kwa MAJARIBIO YA MOJA KWA MOJA (empirical) dhidi ya
// mgawanyo halisi wa kukata, MAMILIONI ya jozi (kigawanyaji, kigawiwa)
// zikiwemo thamani za mpaka (karibu na N32_CHINI/N32_JUU/A32_JUU),
// KABLA ya kutekelezwa hapa -- angalia maelezo ya PR kwa mbinu kamili
// ya uthibitisho na matokeo. KUMBUKA KWA UWAZI: mtandao haukupatikana
// wakati wa kazi hii kuthibitisha dhidi ya chapisho asilia la Hacker's
// Delight/Granlund-Montgomery moja kwa moja (chanzo-mbili kilichokusudiwa
// awali) -- MAJARIBIO YA NAMBA HALISI (mamilioni ya jozi, si sampuli
// chache) ndiyo msingi mkuu wa uthibitisho hapa, si kumbukumbu ya
// karatasi peke yake. Hii ndiyo sababu n64 (inayohitaji fomula tofauti
// na uthibitisho mpya kamili) imeachwa nje ya wigo kwa sasa.
n32 gwm_uchawi_M = 0;
n32 gwm_uchawi_sh = 0;
n32 gwm_uchawi_hasi_m = 0;

// Je, nodi hii ni namba halisi ya moja kwa moja KUDUMU, isiyo n64
// kubwa (dimbwi), yenye thamani 2..65536? Rudisha thamani au -1.
n32 gwm_thamani_kudumu_ndogo(n32 nodi) {
    kama (mti_aina[nodi] != 4) { rudisha -1; }  // si AST_NAMBARI
    kama (mti_kulia[nodi] == 1) { rudisha -1; }  // n64 kubwa (dimbwi)
    n32 v = mti_thamani[nodi];
    kama (v < 2 || v > 65536) { rudisha -1; }
    rudisha v;
}

// Tafuta (M, sh) kwa mgawanyo/modulo BILA ISHARA ya d (2<=d<=65536,
// SI nguvu ya 2). Kwa kila sh (0..30): p=32+sh, M=kikomo_juu(2^p/d);
// (M,sh) INAFANYA KAZI (bila "ongeza") IKIWA TU: q_juu*e + (d-1)*M <
// 2^p (kigezo halisi cha kihesabu cha njia ya "round-up") NA M<2^32
// (lazima itoshee kwenye rejesta ya 32-bit ya hoja ya pili ya MUL).
// Rudisha 1 (mafanikio, thamani ziko gwm_uchawi_M/sh) au 0 (idiv).
n32 gwm_tafuta_uchawi_bila_ishara(n32 d) {
    n64 dd = d;
    n32 sh = 0;
    wakati (sh <= 30) {
        n32 jumla_p = 32 + sh;
        n64 p_thamani = 1;
        n32 i = 0;
        wakati (i < jumla_p) { p_thamani = p_thamani * 2; i = i + 1; }
        n64 m_thamani = (p_thamani + dd - 1) / dd;
        n64 e = (m_thamani * dd) - p_thamani;
        n64 kinyago32 = 4294967295;
        n64 q_juu = kinyago32 / dd;
        n64 kikomo_d = dd - 1;
        n64 upande = (q_juu * e) + (kikomo_d * m_thamani);
        n64 kikomo_32 = 4294967296;
        kama (upande < p_thamani && m_thamani < kikomo_32) {
            gwm_uchawi_M = m_thamani;
            gwm_uchawi_sh = sh;
            rudisha 1;
        }
        sh = sh + 1;
    }
    rudisha 0;
}

// Tafuta (M, s) kwa mgawanyo/modulo YENYE ISHARA ya d>0 (2<=d<=65536,
// SI nguvu ya 2) -- fomula "magic", mnyororo wa "kuongeza mara mbili"
// ukitumia n64 (upana mkubwa kuliko wa asili wa 32-bit wa algorithm)
// kuepuka KABISA hatari za kufurika za toleo la asili -- hakuna haja
// ya "modular wraparound" ya ziada kwa sababu n64 ina nafasi ya
// kutosha kwa upana wote unaohitajika hapa (maadili yote yanabaki
// SANA chini ya 2^33, mbali sana na kikomo cha n64 cha 2^63).
// Kikomo cha marudio (iterasi<40) ni ULINZI TU dhidi ya kosa la
// kupanga (haijawahi kufikiwa kwenye majaribio -- kinadharia hesabu
// hukamilika ndani ya marudio machache): endapo kitafikiwa, rudisha 0
// (idiv) badala ya kuzunguka milele KATIKA MKUSANYAJI MWENYEWE.
n32 gwm_tafuta_uchawi_ishara(n32 d) {
    n64 dd = d;
    n64 two31 = 2147483648;
    n64 anc = two31 - 1 - (two31 % dd);
    n64 p = 31;
    n64 q1 = two31 / anc;
    n64 r1 = two31 - (q1 * anc);
    n64 q2 = two31 / dd;
    n64 r2 = two31 - (q2 * dd);
    n64 delta = 0;
    n32 zunguka_tena = 1;
    n32 iterasi = 0;
    wakati (zunguka_tena == 1 && iterasi < 40) {
        p = p + 1;
        q1 = q1 * 2;
        r1 = r1 * 2;
        kama (r1 >= anc) { q1 = q1 + 1; r1 = r1 - anc; }
        q2 = q2 * 2;
        r2 = r2 * 2;
        kama (r2 >= dd) { q2 = q2 + 1; r2 = r2 - dd; }
        delta = dd - r2;
        kama (q1 < delta) { zunguka_tena = 1; }
        sivyo { kama (q1 == delta && r1 == 0) { zunguka_tena = 1; } sivyo { zunguka_tena = 0; } }
        iterasi = iterasi + 1;
    }
    kama (iterasi >= 40) { rudisha 0; }  // ulinzi -- angalia maelezo juu
    n64 m_thamani = q2 + 1;
    n64 kikomo_32 = 4294967296;
    n64 nusu_32 = 2147483648;
    kama (m_thamani >= nusu_32) {
        gwm_uchawi_hasi_m = 1;
        gwm_uchawi_M = m_thamani - kikomo_32;
    } sivyo {
        gwm_uchawi_hasi_m = 0;
        gwm_uchawi_M = m_thamani;
    }
    gwm_uchawi_sh = p - 32;
    rudisha 1;
}

// -------------------------------------------------------
// Zidisho na uchawi kwa n64 YENYE ISHARA (mgawanyo/modulo ya kigawanyaji
// cha kudumu). Kikwazo cha awali (WIGO #1 hapo juu) kilikuwa kwamba
// utafutaji wa namba ya uchawi wa biti 64 unahitaji hesabu ya biti 128 ambayo
// lugha hii haina. Hapa hatutafuti wakati wa kukusanya: namba (M, s) za
// vigawanyaji vya kawaida (3..64 visivyo nguvu ya 2, na 22 vinavyotumika sana:
// 100, 1000, 10^4..10^9, 10^9+7, 998244353, 3600, 86400, ...) zimehesabiwa
// nje ya mradi kwa algorithm ya Hacker's Delight (Sura ya 10, "magic" kwa
// W=64) na kila moja imethibitishwa dhidi ya mgawanyo halisi wa kukata:
// mamilioni ya x nasibu (mizani yote 2^0..2^63) na thamani za mpaka
// (INT64_MIN, INT64_MAX, karibu na vizidisho vya d), bila tofauti yoyote.
// Jaribio la kudumu (jaribio_gawanyo_n64_uchawi) linarudia ulinganisho huo
// ndani ya mradi kwa kila kigawanyaji kwenye jedwali. Kigawanyaji
// kisicho kwenye jedwali kinaendelea kutumia idiv (salama TAYARI).
//
// Mfuatano (x kwenye rax, d kwenye jedwali):
//   mov rcx, rax ; mov rax, M ; imul rcx      (rdx = juu ya x*M)
//   [add rdx, rcx   kama M hasi]  [sar rdx, s]
//   q = rdx + (rdx >> 63)                      (usahihishaji kwa x hasi)
// Modulo: r = x - q*d  (imul rax, rax, d ; sub rcx, rax ; mov rax, rcx).
n32 gwm64_lo = 0;
n32 gwm64_hi = 0;

// Kigawanyaji cha kudumu cha n64: namba halisi ya moja kwa moja (si dimbwi)
// yenye thamani 3..2147483647 (imm32 ya imul), au -1.
n32 gwm64_thamani_kudumu(n32 nodi) {
    kama (mti_aina[nodi] != 4) { rudisha -1; }
    kama (mti_kulia[nodi] == 1) { rudisha -1; }
    n32 v = mti_thamani[nodi];
    kama (v < 3) { rudisha -1; }
    rudisha v;
}

