// lea eax, [rbp+disp8] — anwani ya kigeu cha ndani (8D 45 xx) au (8D 85 xxxx)
W0 andika_lea_eax_rbp_off(N32 off) {
    kama (off < 128) {
        andika_baiti(141); andika_baiti(69); andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(141); andika_baiti(133);
        andika_disp32_ya_off(off);
    }
}

// mov eax, [rbp + disp8] (8B 45 xx) au [rbp+disp32] (8B 85 xxxx)
// off ni umbali chanya kutoka kwa rbp (k.m. 4, 8, 12)
W0 andika_mov_eax_rbp_off(N32 off) {
    kama (off < 128) {
        andika_baiti(139);
        andika_baiti(69);
        andika_baiti((256 - off) & 255);
