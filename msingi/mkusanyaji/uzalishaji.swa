// pop xmm0 — vuta D32 kutoka rafu hadi xmm0 (F3 0F 10 /r, add rsp, 8)
W0 andika_pop_xmm0_d32() {
    andika_baiti(243);  // F3
    andika_baiti(15);  // 0F
    andika_baiti(16);  // 10
    andika_baiti(4);  // 04
    andika_baiti(36);  // 24 — ModRM: [rsp]
    andika_baiti(72);  // 48
    andika_baiti(131);  // 83
    andika_baiti(196);  // C4
