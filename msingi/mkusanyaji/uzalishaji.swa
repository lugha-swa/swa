w0 andika_cqo() { andika_baiti(72); andika_baiti(153); }

w0 andika_mov_eax_edi() { andika_baiti(137); andika_baiti(248); }
w0 andika_mov_eax_esi() { andika_baiti(137); andika_baiti(240); }
w0 andika_mov_eax_edx() { andika_baiti(137); andika_baiti(208); }
w0 andika_mov_eax_ecx() { andika_baiti(137); andika_baiti(200); }
w0 andika_mov_eax_r8d() { andika_baiti(68); andika_baiti(137); andika_baiti(192); }
