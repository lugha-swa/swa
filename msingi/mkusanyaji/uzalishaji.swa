// === setCC kwa ulinganishi wa desimali (float) ===
// setb al — chini kwa float (CF=1)  (0F 92 C0)
w0 andika_setb_al() { andika_baiti(15); andika_baiti(146); andika_baiti(192); }
// seta al — juu kwa float (~CF & ~ZF)  (0F 97 C0)
w0 andika_seta_al() { andika_baiti(15); andika_baiti(151); andika_baiti(192); }
// setbe al — chini-au-sawa kwa float (CF|ZF)  (0F 96 C0)
w0 andika_setbe_al() { andika_baiti(15); andika_baiti(150); andika_baiti(192); }
// setae al — juu-au-sawa kwa float (~CF)  (0F 93 C0)
w0 andika_setae_al() { andika_baiti(15); andika_baiti(147); andika_baiti(192); }

// Kisaidizi: setCC inayofaa kwa aina na mwelekeo
// mwelekeo: 0=chini(<), 1=juu(>), 2=chini_sawa(<=), 3=juu_sawa(>=)
// Desimali na aina bila ishara hutumia setb/seta/setbe/setae
// Aina zenye ishara hutumia setl/setg/setle/setge
w0 weka_setcc_kwa_usimbaji(n32 usimbaji, n32 mwelekeo) {
    kama (ni_desimali_usimbaji(usimbaji) || ni_bila_ishara_usimbaji(usimbaji)) {
        kama (mwelekeo == 0) { andika_setb_al(); }
        sivyo { kama (mwelekeo == 1) { andika_seta_al(); }
            sivyo { kama (mwelekeo == 2) { andika_setbe_al(); }
                sivyo { andika_setae_al(); } } }
    } sivyo {
        kama (mwelekeo == 0) { andika_setl_al(); }
        sivyo { kama (mwelekeo == 1) { andika_setg_al(); }
            sivyo { kama (mwelekeo == 2) { andika_setle_al(); }
                sivyo { andika_setge_al(); } } }
    }
}

