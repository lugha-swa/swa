// mov eax, [eax] — nyoosha (8B 00)
W0 andika_mov_eax_anwani_eax() { andika_baiti(139); andika_baiti(0); }

// mov rax, [rax] (48 8B 00)
W0 andika_mov_rax_anwani_eax() { andika_baiti(72); andika_baiti(139); andika_baiti(0); }

// Pakia thamani kutoka [rax] kwa upana wa enc (64-bit kwa kielekezi/N64)
// N8/N16: movsx kwa aina zenye ishara, movzx kwa aina bila ishara —
// vinginevyo upakiaji wa baiti 4 ungesoma zaidi ya kipengele.
// Kwa sehemu ya muundo wa ndani (enc hasi), matokeo ni anwani ya sehemu —
// rax tayari ina anwani, hakuna upakiaji unaofanyika.
W0 andika_pakia_anwani_kwa_enc(N32 enc) {
    kama (enc < 0) {
        // MUHIMU (lugha-swa/swa#185): kwa TYPE* (mshale=1, mfano "P
        // s[3]") au muundo uliopachikwa moja kwa moja (mshale=0),
        // anwani tayari iko rax -- hakuna opcode (kipengele ni
        // thamani ya muundo, inashughulikiwa kwa rejeleo kila mahali).
        // LAKINI kwa TYPE** (mshale=3, mfano "P** vitu"), kipengele
        // ni KIELEKEZI HALISI (baiti 8) kilichohifadhiwa KATIKA
        // anwani hiyo -- lazima kipakiwe (mov rax, [rax]), si
        // kuachwa kama anwani ya safu yenyewe.
        kama ((enc / 2) * 2 != enc) {
            kama (enc_hasi_ni_mshale_wa_pili(enc)) {
                andika_mov_rax_anwani_eax();
            }
        }
    } sivyo {
        kama (ni_desimali_enc(enc)) {
            // Desimali: movsd/movss xmm0, [rax] — si mov rax
            N32 sz = ukubwa_kutoka_enc(enc);
            kama (sz >= 8) { andika_baiti(242); andika_baiti(15); andika_baiti(16); andika_baiti(0); }
            sivyo { andika_baiti(243); andika_baiti(15); andika_baiti(16); andika_baiti(0); }
        } sivyo {
            N32 sz = ukubwa_kutoka_enc(enc);
            kama (sz == 1) {
                kama (ni_bila_ishara_enc(enc)) { andika_movzx_eax_baiti_anwani(); }
                sivyo { andika_movsx_eax_baiti_anwani(); }
            } sivyo { kama (sz == 2) {
                    kama (ni_bila_ishara_enc(enc)) { andika_movzx_eax_neno_anwani(); }
                    sivyo { andika_movsx_eax_neno_anwani(); }
                } sivyo { kama (sz == 8) {
                        andika_mov_rax_anwani_eax();
                    } sivyo {
                        andika_mov_eax_anwani_eax();
                    } } }
        }
    }
}

// mov [ecx], eax — hifadhi eax kwenye anwani iliyo kwa ecx (89 01)
W0 andika_mov_anwani_ecx_eax() { andika_baiti(137); andika_baiti(1); }

