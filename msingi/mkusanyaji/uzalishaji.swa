husisha { mkusanyaji/msambazaji.swa }

// ==========================================================
// uzalishaji.swa :: Kizalishe cha machine code asilia
// Hutoa ELF binary (.o) moja kwa moja kutoka AST.
// Hakuna LLVM, hakuna GNU as, hakuna tegemezi.
// ==========================================================

// -------------------------------------------------------
// Bafa ndogo ya .text — inahitajika kwa marekebisho ya
// kuruka mbele (forward branch fixup). Sehemu nyingine
// hutoka moja kwa moja kwenye stdout.
// -------------------------------------------------------

// Ukubwa 16777216 (16MB) unafuata kiolezo kilichopo tayari cha
// chanzo_buf/ast_pool/bafa_kuu/bafa_chanzo/bafa_ukaguzi (16MB -- #301):
// bafa_text (msimbo wa mashine uliozalishwa) lazima ikue sanjari na
// chanzo kinachoruhusiwa, kwa sababu programu kubwa (Dominion,
// jaribio_mchezo_kamili.swa, mifumo 47) inaweza kuzalisha msimbo
// zaidi ya mara kadhaa wa ukubwa wa chanzo chake. Kikomo cha zamani
// cha 524288 (512KB) kilifurika kimya wakati wa kutatua mnyororo
// kamili wa Dominion -- ona andika_baiti() na ukaguzi wa
// text_imefurika mwishoni mwa stage1.swa::main().
n8 bafa_text[16777216];
n32 bafa_text_wapi = 0;
n32 text_imefurika = 0;

// Vigezo vya ulimwengu
//
// lugha-swa/swa#298 -- bafa_data ni PACHA HALISI wa bafa_text (bafa
// ya .data badala ya .text), na ilikuwa na muundo HATARI ZAIDI:
// maeneo YOTE sita yanayoandika ndani yake (angalia mahali
// panapotumia bafa_data_wapi chini ya faili hili) yalikuwa
// yakikagua mipaka KIMYA KABISA (hakuna hata ujumbe wa onyo) --
// baiti zinazovuka kikomo zilidondoshwa bila dalili yoyote,
// bafa_data_wapi ikibaki "imeganda" kwenye kikomo milele. Ukubwa
// umeongezwa (mara 8) na ukaguzi mpya wa kufurika wenye hard-fail
// umeongezwa kwenye kila eneo la uandishi.
n8 bafa_data[2097152];
n32 bafa_data_wapi = 0;
n32 data_ulimwengu_ofseti[1024];
n32 data_ulimwengu_size[1024];
n32 data_ulimwengu_jina_ofseti[1024];
n32 data_ulimwengu_usimbaji[1024];  // usimbaji wa aina kwa upakiaji sahihi
n32 data_ulimwengu_ni_safu[1024];  // 1 = safu (upakiaji unatumia LEA ya anwani)
n32 data_ulimwengu_bss[1024];  // 1 = hakuna kianzio, kigezo kinaenda .bss
// Idadi ya vipengele vilivyotangazwa vya safu (mfano n8 x[131072] -> 131072).
// Inatumika na urefu(x) (angalia uzalishaji_wito) -- lugha-swa/swa#197
// ilitokea kwa sababu ukubwa wa safu na namba ya ukaguzi wa kufurika
// zilikuwa namba mbili zilizowekwa kwa mkono zinazopaswa kuendana;
// urefu(x) inaruhusu namba ya pili kutokana moja kwa moja kutoka
// tangazo la safu badala ya kunakiliwa kwa mkono.
n32 data_ulimwengu_idadi_ya_kipengele[1024];
n32 data_ulimwengu_idadi = 0;
n32 bss_wapi = 0;

// -------------------------------------------------------
// PEEPHOLE: unganisha push/pop ya rax/rcx inayofuatana moja kwa
// moja. Tangazo la kigezo na png_safisha lazima viwe KABLA ya
// andika_baiti (ambayo huita png_safisha), ili kuepuka kutegemea
// urejeleaji wa mbele wa kigezo cha ulimwengu.
// -------------------------------------------------------

// -1 = hakuna push inayosubiri kutolewa. 0 = rax inasubiri, 1 = rcx
// inasubiri (push imeahirishwa, HAIJAANDIKWA bafa_text bado).
n32 png_akiba_reg = -1;

// Toa push HALISI ya rax/rcx (baiti za asili, bila kupitia png
// kabisa -- kwa matumizi ya ndani ya png_safisha/andika_push_* TU,
// kuepuka urudiaji usio na mwisho).
w0 andika_push_rax_halisi() { andika_baiti(80); }
w0 andika_push_rcx_halisi() { andika_baiti(81); }

// Toa push YOYOTE inayosubiri kama baiti halisi, kisha futa hali.
// LAZIMA iitwe kabla ya JAMBO LOLOTE linalosoma bafa_text_wapi kwa
// madhumuni ya kuhifadhi nafasi (lebo, fixup, rela, anwani ya kazi/
// data) au kabla ya kutoa bafa_text nje -- vinginevyo push
// iliyoahirishwa ingepotea kimya (haijaandikwa kamwe) au nafasi
// iliyohifadhiwa ingekuwa MBAYA kwa baiti moja. Ni salama kuita hata
// kama hakuna kinachosubiri (haifanyi kitu). andika_baiti YENYEWE
// (chini) pia huita hii kabla ya kuandika baiti YOYOTE mpya -- hii
// inashughulikia KILA agizo lingine linaloandikwa kati ya push na
// pop inayotarajiwa (jumlisha, wito, kuruka, lebo, chochote), bila
// kuhitaji kila kazi ya andika_* nyingine (kuna mamia) kujua kuhusu
// kipengele hiki -- andika_baiti ndiyo KIZUIA-NJIA cha PEKEE
// kinachopitiwa na kila agizo, hivyo ni mahali salama pa KUFUNGA
// ukaguzi huu kwa uhakika kamili.
w0 png_safisha() {
    // MUHIMU: futa hali KABLA ya kutoa push halisi, SI baadaye --
    // andika_push_rax_halisi/rcx_halisi huita andika_baiti, ambayo
    // NAYO huita png_safisha kama kitu kinasubiri. Kama tungefuta
    // BAADAYE, andika_baiti ingeona png_akiba_reg bado ikiwa na
    // thamani ile ile na kujaribu kusafisha TENA -- urudiaji usio na
    // mwisho.
    n32 r = png_akiba_reg;
    png_akiba_reg = -1;
    kama (r == 0) { andika_push_rax_halisi(); }
    sivyo { kama (r == 1) { andika_push_rcx_halisi(); } }
}

w0 andika_baiti(n32 b) {
    kama (png_akiba_reg != -1) { png_safisha(); }
    kama (bafa_text_wapi < 16777216) {
        bafa_text[bafa_text_wapi] = b & 255;
        bafa_text_wapi = bafa_text_wapi + 1;
    } sivyo { kama (text_imefurika == 0) {
            text_imefurika = 1;
            andika_stderr("KOSA: bafa_text imefurika\n");
        } }
}

w0 andika_neno2(n32 v) {
    andika_baiti(v & 255);
    andika_baiti((v >> 8) & 255);
}

w0 andika_neno4(n32 v) {
    andika_neno2(v & 65535);
    andika_neno2((v >> 16) & 65535);
}

w0 andika_neno8_kama_neno4(n32 lo, n32 hi) {
    andika_neno4(lo);
    andika_neno4(hi);
}

// -------------------------------------------------------
// Futa bafa ya .text hadi stdout
// -------------------------------------------------------
w0 futa_bafa_text() {
    // Safisha push inayosubiri (kama ipo) KWANZA -- vinginevyo
    // ingepotea kimya kabisa (haingeandikwa kamwe kwenye bafa
    // inayotolewa nje).
    png_safisha();
    // Andika bafa nzima ya .text kwa syscall moja (sio baiti kwa baiti)
    mfumo_andika(1, bafa_text, bafa_text_wapi);
}

// -------------------------------------------------------
// Andika moja kwa moja kwenye stdout (sio bafa)
// -------------------------------------------------------
w0 andika_baiti_moja_kwa_moja(n32 b) {
    andika("%c", b & 255);
}

w0 andika_neno2_moja_kwa_moja(n32 v) {
    andika_baiti_moja_kwa_moja(v & 255);
    andika_baiti_moja_kwa_moja((v >> 8) & 255);
}

w0 andika_neno4_moja_kwa_moja(n32 v) {
    andika_neno2_moja_kwa_moja(v & 65535);
    andika_neno2_moja_kwa_moja((v >> 16) & 65535);
}

w0 andika_neno8_moja_kwa_moja(n32 lo, n32 hi) {
    andika_neno4_moja_kwa_moja(lo);
    andika_neno4_moja_kwa_moja(hi);
}

// -------------------------------------------------------
// Mashine za x86-64 — opcodes tunazohitaji
// -------------------------------------------------------

// mov eax, imm32  (B8 + imm32)
w0 andika_mov_eax(n32 thamani) {
    andika_baiti(184);
    andika_neno4(thamani);
}

// ret (C3)
w0 andika_matokeo() {
    andika_baiti(195);
}

// push rdi (57) — kwa kuhifadhi anwani ya lengwa la nakala
w0 andika_push_rdi() {
    andika_baiti(87);
}

// push rax (50) -- HUAHIRISHWA (haiandiki baiti mara moja). Sababu
// (imefikiriwa kwa makini, hii ndiyo hatari kuu ya kazi hii yote):
// mkusanyaji huu hutoa ELF moja kwa moja BILA kusanisi/kiungo
// tofauti -- lebo/fixup/rela HUREKODI nafasi HALISI ya baiti
// (bafa_text_wapi) moja kwa moja. Kuahirisha push (badala ya
// kuiandika mara moja) kungebadilisha nafasi hizo ISIPOKUWA kila
// kazi inayosoma bafa_text_wapi kwa madhumuni ya "hii ndiyo nafasi
// ya sasa" IPIGE png_safisha() KWANZA. Kwa hiyo: KILA kazi ya
// uzalishaji.swa inayosoma bafa_text_wapi nje ya andika_baiti
// yenyewe (weka_lebo, weka_fixup, lebo_hifadhi,
// andika_rela_ulimwengu, na nafasi za mwisho za uzalishaji_kuu/
// uzalishaji_jit) sasa huanza kwa png_safisha() -- imethibitishwa
// kwa kusoma kila mstari unaosoma bafa_text_wapi kwenye faili hili
// (angalia PR inayoongeza kipengele hiki kwa orodha kamili). andika_baiti
// YENYEWE pia husafisha kabla ya kuandika baiti YOYOTE mpya (angalia
// hapo chini) -- hii inashughulikia KILA agizo lingine linaloandikwa
// kati ya push na pop inayotarajiwa (jumlisha, wito, kuruka, chochote).
w0 andika_push_rax() {
    png_safisha();  // kama push nyingine tayari inasubiri, itoe kwanza
    png_akiba_reg = 0;
}

// push rcx (51) -- HUAHIRISHWA, angalia maelezo juu ya andika_push_rax.
w0 andika_push_rcx() {
    png_safisha();
    png_akiba_reg = 1;
}

// pop rcx (59) -- kama push ya rcx inasubiri, hii ni push+pop ya
// rejesta MOJA -- hauna athari, hakuna baiti zinazotolewa. Kama push
// ya rax inasubiri, "push rax; pop rcx" == "mov rcx, rax" (rejesta
// MOJA, agizo MOJA badala ya mawili, HAKUNA rsp inayoguswa). Vinginevyo
// (hakuna push inayosubiri -- ilishatolewa na andika_baiti nyingine
// kati ya push na pop hii) toa pop halisi ya kawaida.
w0 andika_pop_rcx() {
    kama (png_akiba_reg == 1) { png_akiba_reg = -1; rudisha; }
    // MUHIMU: futa png_akiba_reg KABLA ya kuita andika_mov_rcx_rax
    // (mdudu halisi uliogunduliwa hapa awali) -- kazi hiyo huita
    // andika_baiti, ambayo NAYO huangalia png_akiba_reg na kusafisha
    // kama bado ina thamani ya zamani -- kama tungefuta BAADAYE,
    // andika_baiti ingeona png_akiba_reg==0 bado ikiwa hai na
    // kutoa PUSH YA PILI ISIYOHITAJIKA (na isiyo sahihi) kabla ya
    // kuandika mov, ikivuruga rafu kabisa.
    kama (png_akiba_reg == 0) { png_akiba_reg = -1; andika_mov_rcx_rax(); rudisha; }
    andika_baiti(89);
}

// pop rax (58) -- angalia maelezo juu ya andika_pop_rcx (kioo chake).
w0 andika_pop_rax() {
    kama (png_akiba_reg == 0) { png_akiba_reg = -1; rudisha; }
    // Futa png_akiba_reg KABLA ya andika_mov_rax_rcx -- angalia
    // maelezo kamili kwenye andika_pop_rcx (kioo chake, mdudu halisi
    // uliogunduliwa pale).
    kama (png_akiba_reg == 1) { png_akiba_reg = -1; andika_mov_rax_rcx(); rudisha; }
    andika_baiti(88);
}

// add eax, ecx (01 C8)
w0 andika_add_eax_ecx() {
    andika_baiti(1);
    andika_baiti(200);
}

// add eax, imm32 (05 xx xx xx xx)
w0 andika_add_eax_imm32(n32 v) {
    andika_baiti(5);
    andika_neno4(v);
}

// sub eax, ecx (29 C8)
w0 andika_sub_eax_ecx() {
    andika_baiti(41);
    andika_baiti(200);
}

// imul eax, ecx (0F AF C1)
w0 andika_imul_eax_ecx() {
    andika_baiti(15);
    andika_baiti(175);
    andika_baiti(193);
}

// cmp eax, ecx (39 C8)
w0 andika_cmp_eax_ecx() {
    andika_baiti(57);
    andika_baiti(200);
}

// sete al (0F 94 C0)
w0 andika_sete_al() {
    andika_baiti(15);
    andika_baiti(148);
    andika_baiti(192);
}

// setl al (0F 9C C0)
w0 andika_setl_al() {
    andika_baiti(15);
    andika_baiti(156);
    andika_baiti(192);
}

// movzx eax, al (0F B6 C0)
w0 andika_movzx_eax_al() {
    andika_baiti(15);
    andika_baiti(182);
    andika_baiti(192);
}

// neg eax (F7 D8)
w0 andika_neg_eax() { andika_baiti(247); andika_baiti(216); }
w0 andika_cdq() { andika_baiti(153); }
// xor edx, edx (31 D2) — panua kwa sifuri kabla ya div (bila ishara);
// edx lazima iwe 0, si ishara ya eax/rax kama cdq/cqo inavyofanya.
w0 andika_xor_edx_edx() { andika_baiti(49); andika_baiti(210); }
w0 andika_idiv_ecx() { andika_baiti(247); andika_baiti(249); }
// mul ecx — unsigned multiply edx:eax = eax*ecx (F7 E1) -- kundi
// moja na div/idiv ecx (F7 /reg), reg=4 kwa MUL (kinyume na reg=6
// DIV/reg=7 IDIV zilizopo tayari juu) -- angalia gwm_uchawi_* kwa
// matumizi (kupunguza nguvu kwa mgawanyo/modulo ya kigawanyaji
// chochote cha kudumu, si nguvu ya 2 tu).
w0 andika_mul_ecx() { andika_baiti(247); andika_baiti(225); }
// imul ecx — signed multiply edx:eax = eax*ecx (F7 E9, reg=5 IMUL wa
// hoja MOJA -- SI sawa na andika_imul_eax_ecx (0F AF C1) iliyopo
// tayari, ambayo ni IMUL ya hoja MBILI inayotoa NUSU YA CHINI TU ya
// tokeo -- hapa tunahitaji NUSU YA JUU (edx) kwa fomula ya uchawi).
w0 andika_imul_ecx() { andika_baiti(247); andika_baiti(233); }
w0 andika_and_eax_ecx() { andika_baiti(33); andika_baiti(200); }
w0 andika_or_eax_ecx() { andika_baiti(9); andika_baiti(200); }
w0 andika_shl_eax_cl() { andika_baiti(211); andika_baiti(224); }
w0 andika_sar_eax_cl() { andika_baiti(211); andika_baiti(248); }

// === Visaidizi vya 32-bit bila ishara (unsigned) ===
// div ecx — unsigned divide edx:eax / ecx  (F7 F1)
w0 andika_div_ecx() { andika_baiti(247); andika_baiti(241); }
// shr eax, cl — shift right logical  (D3 E8)
w0 andika_shr_eax_cl() { andika_baiti(211); andika_baiti(232); }


// === Visaidizi vya 64-bit (REX.W) kwa n64 ===

// add rax, rcx (48 01 C8)
w0 andika_add_rax_rcx() {
    andika_baiti(72); andika_baiti(1); andika_baiti(200);
}

// add rax, imm32 (48 05 xx xx xx xx) — toleo la 64-bit la andika_add_eax_imm32
w0 andika_add_rax_imm32(n32 v) {
    andika_baiti(72); andika_baiti(5);
    andika_neno4(v);
}

// sub rax, rcx (48 29 C8)
w0 andika_sub_rax_rcx() {
    andika_baiti(72); andika_baiti(41); andika_baiti(200);
}

// cmp rax, rcx (48 39 C8)
w0 andika_cmp_rax_rcx() {
    andika_baiti(72); andika_baiti(57); andika_baiti(200);
}

// imul rax, rcx (48 0F AF C1)
w0 andika_imul_rax_rcx() {
    andika_baiti(72); andika_baiti(15); andika_baiti(175); andika_baiti(193);
}

// idiv rcx (48 F7 F9)
w0 andika_idiv_rcx_rax() {
    andika_baiti(72); andika_baiti(247); andika_baiti(249);
}

// and rax, rcx (48 21 C8)
w0 andika_and_rax_rcx() {
    andika_baiti(72); andika_baiti(33); andika_baiti(200);
}

// or rax, rcx (48 09 C8)
w0 andika_or_rax_rcx() {
    andika_baiti(72); andika_baiti(9); andika_baiti(200);
}

// xor eax, ecx (31 C8)
w0 andika_xor_eax_ecx() {
    andika_baiti(49); andika_baiti(200);
}

// xor rax, rcx (48 31 C8)
w0 andika_xor_rax_rcx() {
    andika_baiti(72); andika_baiti(49); andika_baiti(200);
}

// not eax (F7 D0)
w0 andika_not_eax() {
    andika_baiti(247); andika_baiti(208);
}

// not rax (48 F7 D0)
w0 andika_not_rax() {
    andika_baiti(72); andika_baiti(247); andika_baiti(208);
}

// neg rax (48 F7 D8)
w0 andika_neg_rax() {
    andika_baiti(72); andika_baiti(247); andika_baiti(216);
}

// shl rax, cl (48 D3 E0)
w0 andika_shl_rax_cl() {
    andika_baiti(72); andika_baiti(211); andika_baiti(224);
}

// sar rax, cl (48 D3 F8)
w0 andika_sar_rax_cl() {
    andika_baiti(72); andika_baiti(211); andika_baiti(248);
}

// === Visaidizi vya 64-bit bila ishara (unsigned) ===
// div rcx — unsigned divide rdx:rax / rcx  (48 F7 F1)
w0 andika_div_rcx_rax() {
    andika_baiti(72); andika_baiti(247); andika_baiti(241);
}
// shr rax, cl — shift right logical  (48 D3 E8)
w0 andika_shr_rax_cl() {
    andika_baiti(72); andika_baiti(211); andika_baiti(232);
}

// mov rax, rdi (48 89 F8)
w0 andika_mov_rax_rdi() { andika_baiti(72); andika_baiti(137); andika_baiti(248); }

// mov rax, rbp (48 89 E8)
w0 andika_mov_rax_rbp() { andika_baiti(72); andika_baiti(137); andika_baiti(232); }

// sub rax, imm32 (48 2D xx xx xx xx)
w0 andika_sub_rax_imm32(n32 v) {
    andika_baiti(72);
    andika_baiti(45);
    andika_neno4(v);
}

// mov rax, rsi (48 89 F0)
w0 andika_mov_rax_rsi() { andika_baiti(72); andika_baiti(137); andika_baiti(240); }

// mov rax, rdx (48 89 D0)
w0 andika_mov_rax_rdx() { andika_baiti(72); andika_baiti(137); andika_baiti(208); }

// mov rax, rcx (48 89 C8)
w0 andika_mov_rax_rcx() { andika_baiti(72); andika_baiti(137); andika_baiti(200); }

// mov rcx, rax (48 89 C1) — kwa kukanusha kwa 64-bit (0 - rcx)
w0 andika_mov_rcx_rax() { andika_baiti(72); andika_baiti(137); andika_baiti(193); }

// mov r11, rax (49 89 C3) — hifadhi kielekezi cha kazi kwa wito wa ndani
w0 andika_mov_r11_rax() { andika_baiti(73); andika_baiti(137); andika_baiti(195); }

// movsd xmm0, [rbp-off] (F2 0F 10 45 xx / F2 0F 10 85 xxxx) — pakia d64
w0 andika_movsd_xmm0_na_rbp_ofseti(n32 ofseti) {
    kama (ofseti < 128) {
        andika_baiti(242); andika_baiti(15); andika_baiti(16); andika_baiti(69); andika_baiti((256 - ofseti) & 255);
    } sivyo {
        andika_baiti(242); andika_baiti(15); andika_baiti(16); andika_baiti(133); andika_disp32_ya_ofseti(ofseti);
    }
}

// movss xmm0, [rbp-off] (F3 0F 10 45 xx / F3 0F 10 85 xxxx) — pakia D32
w0 andika_movss_xmm0_na_rbp_ofseti(n32 ofseti) {
    kama (ofseti < 128) {
        andika_baiti(243); andika_baiti(15); andika_baiti(16); andika_baiti(69); andika_baiti((256 - ofseti) & 255);
    } sivyo {
        andika_baiti(243); andika_baiti(15); andika_baiti(16); andika_baiti(133); andika_disp32_ya_ofseti(ofseti);
    }
}

// movsd [rbp-off], xmm0 (F2 0F 11 45 xx / F2 0F 11 85 xxxx) — hifadhi d64
w0 andika_movsd_xmm0_rbp_ofseti(n32 ofseti) {
    kama (ofseti < 128) {
        andika_baiti(242); andika_baiti(15); andika_baiti(17); andika_baiti(69); andika_baiti((256 - ofseti) & 255);
    } sivyo {
        andika_baiti(242); andika_baiti(15); andika_baiti(17); andika_baiti(133); andika_disp32_ya_ofseti(ofseti);
    }
}

// movss [rbp-off], xmm0 (F3 0F 11 45 xx / F3 0F 11 85 xxxx) — hifadhi D32
w0 andika_movss_xmm0_rbp_ofseti(n32 ofseti) {
    kama (ofseti < 128) {
        andika_baiti(243); andika_baiti(15); andika_baiti(17); andika_baiti(69); andika_baiti((256 - ofseti) & 255);
    } sivyo {
        andika_baiti(243); andika_baiti(15); andika_baiti(17); andika_baiti(133); andika_disp32_ya_ofseti(ofseti);
    }
}

// call r11 (41 FF D3) — wito wa kielekezi cha kazi
w0 andika_call_r11() { andika_baiti(65); andika_baiti(255); andika_baiti(211); }

// cdqe (48 98) — panua ishara ya eax hadi rax (kwa %d za n32)
w0 andika_cdqe() { andika_baiti(72); andika_baiti(152); }

// Baada ya uzalishaji_usemi: panua ishara ikiwa thamani ni ya aina
// ndogo yenye ishara (n8/n16/n32) — cdqe (48 98). Hii inahakikisha
// kigezo/hoja/kurudi kwa baiti 8 kinapata thamani iliyopanuliwa kwa
// ishara, si biti za juu za takataka (mende: n64 x = -90 ilitoa
// 4294967206 — upanuzi wa sifuri). Aina zisizo na ishara (A/B/W)
// zina upanuzi wa sifuri tayari (mov eax husafisha biti za juu);
// d64 ina thamani kwenye xmm0; miundo na kielekezi ni baiti 8.
w0 panua_ishara_ndogo(n32 nodi) {
    // AST_WITO (8, wito wa kazi): rax tayari ni sahihi -- haihitaji cdqe
    // ya ziada. UTHIBITISHO (si dhana): kwa wito wa kazi ya Swa
    // iliyosajiliwa (jina linalojulikana), mkaguzi_kagua_wito hurudisha
    // kazi_ret_aina[j] -- CHANZO KILE KILE kinachotumika na taarifa ya
    // "rudisha" ya kazi hiyo (angalia AST_RUDISHA: uzalishaji_usemi(expr)
    // + badili_mpaka_wa_desimali(expr, ast_thamani[kazi_node])), hivyo
    // ast_thamani[node] ya wito huu ni SAWA KABISA na enc iliyotumika
    // kupanua rax kabla ya kazi hiyo kurudi -- rax tayari imepanuliwa
    // ipasavyo. Kwa wito usiojulikana (kupitia kigezo, wito_wa_mfumo,
    // tekeleza) mkaguzi_kagua_wito hurudisha 0 ("aina yoyote"), na
    // enc==0 haipitishi sharti la "enc > 0" chini -- njia hiyo TAYARI
    // haikuwa ikitoa cdqe kabla ya rekebisho hili, hivyo hakuna
    // mabadiliko ya tabia kwa kesi hizo.
    kama (mti_aina[nodi] == 8) { rudisha; }
    n32 usimbaji = mti_thamani[nodi];
    kama (mti_aina[nodi] == 4) { usimbaji = mti_nne[nodi]; }  // halisi kamili: enc iko ast_nne
    kama (mti_aina[nodi] == 45) { rudisha; }  // d64: thamani iko xmm0
    kama (usimbaji > 0) {
        kama (ukubwa_kutoka_usimbaji(usimbaji) < 8) {
            kama (ni_bila_ishara_usimbaji(usimbaji) == 0) {
                kama (ni_desimali_usimbaji(usimbaji) == 0) {
                    andika_cdqe();
                }
            }
        }
    }
}

// imul eax, eax, imm32 (69 C0 + imm32) — kuzidisha faharisi kwa ukubwa
// wa kipengele usio nguvu ya 2 (miundo ya baiti 12, 20, 24, ...)
w0 andika_imul_eax_imm32(n32 v) {
    andika_baiti(105); andika_baiti(192);
    andika_neno4(v);
}

// Kokotoa ofseti ya kipengele kutoka kwa faharisi: rax = rax * saizi.
//
// MDUDU HALISI ULIOGUNDULIWA (ukaguzi wa PR #251, si dhana): toleo la
// zamani lilifanya "shl eax, N" (biti 32) KISHA "cdqe". Kila mwitaji
// (angalia maeneo manne yanayoita kazi hii) huita mara moja tu baada
// ya uzalishaji_usemi(idx_node, ...), ambayo TAYARI imeacha rax
// ikiwa faharisi sahihi ya biti-64 (panua_ishara_ndogo, mwisho wa
// uzalishaji_usemi, tayari imefanya cdqe kwa aina zenye ishara; A32
// inabaki imepanuliwa kwa sifuri KIASILIA na x86-64 -- "mov eax,.."
// husafisha biti za juu za rax). "shl eax" ilikuwa ikitupa nusu ya
// juu SAHIHI ya rax na kuzidisha kwa biti 32 TU -- kwa safu kubwa
// (idx*saizi > 2^32, mfano safu > ~GB 2 za elementi za baiti 4)
// zidisho hilo lilizunguka (overflow) KABLA cdqe haijafanya kazi,
// likitoa anwani MBAYA bila kuanguka wazi (SEGV ya nasibu, au
// mbaya zaidi, uandishi kimya mahali pasipo sahihi). Fahirisi ya
// n64/n32/A32 yenyewe (kabla ya kuzidisha) haiwezi kuvunja hivyo --
// ni bidhaa idx*saizi ndiyo iliyokuwa ikipita 2^32.
//
// SULUHISHO: zidisha kwenye RAX (biti 64) moja kwa moja -- rax
// TAYARI ni sahihi (imepanuliwa ipasavyo, kwa ishara au sifuri
// kulingana na aina) kabla ya kuitwa, hivyo hakuna cdqe ya ziada
// inahitajika hapa (angalia andika_ongea_kielekezi_kipengele, juu ya
// faili hili, kwa muundo ule ule -- kazi hiyo YENYEWE haina mdudu
// huu kwa sababu ilikuwa tayari ikifanya kazi kwenye rax).
w0 andika_ongea_kipengele_kwa_saizi(n32 saizi) {
    kama (saizi == 8) { andika_baiti(72); andika_baiti(193); andika_baiti(224); andika_baiti(3); }  // shl rax, 3
    sivyo { kama (saizi == 4) { andika_baiti(72); andika_baiti(193); andika_baiti(224); andika_baiti(2); }  // shl rax, 2
        sivyo { kama (saizi == 2) { andika_baiti(72); andika_baiti(193); andika_baiti(224); andika_baiti(1); }  // shl rax, 1
            sivyo { kama (saizi != 1) {
                    andika_baiti(72); andika_baiti(105); andika_baiti(192);  // imul rax, rax, imm32
                    andika_neno4(saizi);
                } } } }
}

// mov rax, [rsp+disp32] (48 8B 84 24 + d32) — pakia sloti ya hoja ya rafu
w0 andika_mov_rax_rsp_disp32(n32 ofseti) {
    andika_baiti(72); andika_baiti(139); andika_baiti(132); andika_baiti(36);
    andika_neno4(ofseti);
}

// mov [rsp+disp32], rdi (48 89 BC 24 + d32) — andika sloti ya hoja ya rafu
w0 andika_mov_rsp_disp32_rdi(n32 ofseti) {
    andika_baiti(72); andika_baiti(137); andika_baiti(188); andika_baiti(36);
    andika_neno4(ofseti);
}

// mov [rsp+disp32], rcx (48 89 8C 24 + d32) — andika sloti ya hoja ya rafu
w0 andika_mov_rsp_disp32_rcx(n32 ofseti) {
    andika_baiti(72); andika_baiti(137); andika_baiti(140); andika_baiti(36);
    andika_neno4(ofseti);
}

// Pakia thamani ya muundo mdogo kutoka [rax] (kwa hoja kwa thamani):
// baiti 8 kwa 5-8, baiti 4 kwa 3-4, neno kwa 2, baiti 1 kwa 1.
w0 pakia_thamani_ya_muundo(n32 saizi) {
    kama (saizi > 4) { andika_mov_rax_anwani_eax(); }
    sivyo { kama (saizi == 4) { andika_mov_eax_anwani_eax(); }
        sivyo { kama (saizi == 2) { andika_movzx_eax_neno_anwani(); }
            sivyo { kama (saizi == 1) { andika_movzx_eax_baiti_anwani(); }
                sivyo { andika_mov_eax_anwani_eax(); } } } }
}

// mov rsi, rax (48 89 C6) — hoja ya pili ya wito wa ndani
w0 andika_mov_rsi_rax2() { andika_baiti(72); andika_baiti(137); andika_baiti(198); }

// Tafuta nafasi ya kazi ya ndani kwa jina (iliyokwishakusanywa)
n32 kazi_nafasi_kwa_jina(n8* jina) {
    n32 li = 0;
    wakati (li < lebo_idadi) {
        kama (jina_linganisha(lebo_jina[li], jina)) {
            rudisha lebo_nafasi[li];
        }
        li = li + 1;
    }
    rudisha -1;
}

// anwani_ya_kazi — jedwali la anwani za ndani kwa JIT (badala ya dlsym).
// Kwenye exe ya kujitegemea (.text wenye msingi 4194424 = 0x400078),
// kazi za ndani zinapatikana kupitia lebo_nafasi; kwenye .o
// iliyounganishwa na ld, anwani ni za ld — haziwezi kukokotolewa hapa
// (0 → JIT-RELA itaonya). Utambuzi wa modi: exe ina .bss mara baada
// ya .text (< 5242880 = 0x500000); .o ya -no-pie ina .bss kwenye
// 0x608000+.
// KUMBUKA: hati 2.3 inaahidi "mfuatano wa tarakimu" pekee — radiksi
// hazijaungwa mkono, kwa hiyo thamani hizi ni desimali za nia ya heksa.
n8* anwani_ya_kazi(n8* jina) {
    n32 ofseti = kazi_nafasi_kwa_jina(jina);
    kama (ofseti < 0) { rudisha 0; }
    n8* kikomo = 5242880;
    kama (&bafa_text < kikomo) { rudisha 4194424 + ofseti; }
    rudisha 0;
}

// Sehemu ya tungo: nakili kwenye bafa ya sehemu (kwa utorokaji wa \n na \\)
// na urudishe lebo ya ndani ya bafa ya .text.
n32 sehemu_tungo_hifadhi(n8* mwanzo, n32 urefu) {
    kama (sehemu_idadi >= 65536) {
        andika_stderr("KOSA: jedwali la sehemu za andika (sehemu_*) limejaa (kikomo cha idadi 65536)\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    kama (sehemu_bafa_wapi + urefu + 1 >= 1048576) {
        andika_stderr("KOSA: bafa ya sehemu za andika (sehemu_buf) imejaa (kikomo cha baiti 1048576)\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    n32 ofseti = sehemu_bafa_wapi;
    n32 i = 0;
    wakati (i < urefu) {
        n8 ch = mwanzo[i];
        kama (ch == 92 && i + 1 < urefu) {
            n8 e = mwanzo[i + 1];
            kama (e == 110) { ch = 10; i = i + 1; }
            sivyo { kama (e == 92) { ch = 92; i = i + 1; }
                sivyo { kama (e == 37) { ch = 37; i = i + 1; } } }
        }
        sehemu_bafa[sehemu_bafa_wapi] = ch;
        sehemu_bafa_wapi = sehemu_bafa_wapi + 1;
        i = i + 1;
    }
    sehemu_bafa[sehemu_bafa_wapi] = 0;
    sehemu_bafa_wapi = sehemu_bafa_wapi + 1;
    sehemu_ofseti[sehemu_idadi] = ofseti;
    sehemu_urefu[sehemu_idadi] = sehemu_bafa_wapi - ofseti - 1;
    sehemu_lebo_id[sehemu_idadi] = lebo_bafa_mpya();
    sehemu_idadi = sehemu_idadi + 1;
    rudisha sehemu_lebo_id[sehemu_idadi - 1];
}

// Toa wito wa andika_sehemu(fd, lebo, urefu) — wito wa ndani
w0 andika_wito_sehemu(n32 fd, n32 lebo, n32 urefu) {
    andika_baiti(191); andika_neno4(fd);  // mov edi, fd
    toa_lea_rax_kwa_lebo(lebo);  // lea rax, [rip+lebo]
    andika_mov_rsi_rax2();  // mov rsi, rax
    andika_baiti(186); andika_neno4(urefu);  // mov edx, urefu
    n32 nafasi = kazi_nafasi_kwa_jina("andika_sehemu");
    kama (nafasi < 0) { rudisha; }
    andika_baiti(232);  // call rel32
    n32 ofseti = nafasi - (bafa_text_wapi + 4);
    andika_neno4(ofseti);
}

// Toa wito wa andika_n64(fd, rax) — thamani iko kwenye rax
w0 andika_wito_n64(n32 fd) {
    andika_mov_rsi_rax2();  // mov rsi, rax
    andika_baiti(191); andika_neno4(fd);  // mov edi, fd
    n32 nafasi = kazi_nafasi_kwa_jina("andika_n64");
    kama (nafasi < 0) { rudisha; }
    andika_baiti(232);
    n32 ofseti = nafasi - (bafa_text_wapi + 4);
    andika_neno4(ofseti);
}

// Toa wito wa andika_mfuatano(fd, rax) — kielekezi kiko kwenye rax
w0 andika_wito_mfuatano(n32 fd) {
    andika_mov_rsi_rax2();  // mov rsi, rax
    andika_baiti(191); andika_neno4(fd);  // mov edi, fd
    n32 nafasi = kazi_nafasi_kwa_jina("andika_mfuatano");
    kama (nafasi < 0) { rudisha; }
    andika_baiti(232);
    n32 ofseti = nafasi - (bafa_text_wapi + 4);
    andika_neno4(ofseti);
}

// Toa wito wa andika_baiti(fd, rax) — baiti moja
w0 andika_wito_baiti(n32 fd) {
    andika_mov_rsi_rax2();  // mov rsi, rax
    andika_baiti(191); andika_neno4(fd);  // mov edi, fd
    n32 nafasi = kazi_nafasi_kwa_jina("andika_herufi");
    kama (nafasi < 0) { rudisha; }
    andika_baiti(232);
    n32 ofseti = nafasi - (bafa_text_wapi + 4);
    andika_neno4(ofseti);
}

// Toa sehemu zote za tungo mwishoni mwa .text na uweke lebo zao
w0 andika_sehemu_halisi() {
    n32 i = 0;
    wakati (i < sehemu_idadi) {
        weka_lebo(sehemu_lebo_id[i]);
        n32 ofseti = sehemu_ofseti[i];
        n32 urefu = sehemu_urefu[i];
        n32 j = 0;
        wakati (j < urefu) {
            andika_baiti(sehemu_bafa[ofseti + j]);
            j = j + 1;
        }
        i = i + 1;
    }
}

// Andika disp32 (baiti 4, mdogo-kwanza) kwenye bafa maalum kwa ofseti.
// disp inaweza kuwa hasi — mgawanyo wa sakafu kama andika_disp32_ya_off.
w0 andika_disp32_kwenye(n8* bafa, n32 nafasi_hii, n32 disp) {
    n32 q0 = disp / 256;
    kama (disp < 0 && (q0 * 256) != disp) { q0 = q0 - 1; }
    n32 b0 = disp - (q0 * 256);
    n32 q1 = q0 / 256;
    kama (q0 < 0 && (q1 * 256) != q0) { q1 = q1 - 1; }
    n32 b1 = q0 - (q1 * 256);
    n32 q2 = q1 / 256;
    kama (q1 < 0 && (q2 * 256) != q1) { q2 = q2 - 1; }
    n32 b2 = q1 - (q2 * 256);
    bafa[nafasi_hii] = b0;
    bafa[nafasi_hii + 1] = b1;
    bafa[nafasi_hii + 2] = b2;
    bafa[nafasi_hii + 3] = q2;
}

// Andika disp32 (baiti 4, mdogo-kwanza) ya thamani hasi: [rbp - off]
// Hesabu ya / na * (mbegu ina hitilafu katika & na >>); mgawanyo wa sakafu.
w0 andika_disp32_ya_ofseti(n32 ofseti) {
    n32 n = 0 - ofseti;
    n32 q0 = n / 256;
    kama (n < 0 && (q0 * 256) != n) { q0 = q0 - 1; }
    n32 b0 = n - (q0 * 256);
    n32 q1 = q0 / 256;
    kama (q0 < 0 && (q1 * 256) != q0) { q1 = q1 - 1; }
    n32 b1 = q0 - (q1 * 256);
    n32 q2 = q1 / 256;
    kama (q1 < 0 && (q2 * 256) != q1) { q2 = q2 - 1; }
    n32 b2 = q1 - (q2 * 256);
    andika_baiti(b0); andika_baiti(b1); andika_baiti(b2); andika_baiti(q2);
}

// mov rax, [rbp+disp8] (48 8B 45 xx) au [rbp+disp32] (48 8B 85 xxxx)
w0 andika_mov_rax_rbp_ofseti(n32 ofseti) {
    kama (ofseti < 128) {
        andika_baiti(72); andika_baiti(139); andika_baiti(69);
        andika_baiti((256 - ofseti) & 255);
    } sivyo {
        andika_baiti(72); andika_baiti(139); andika_baiti(133);
        andika_disp32_ya_ofseti(ofseti);
    }
}

// mov [rbp+disp8], rax (48 89 45 xx) au [rbp+disp32] (48 89 85 xxxx)
w0 andika_mov_rbp_ofseti_rax(n32 ofseti) {
