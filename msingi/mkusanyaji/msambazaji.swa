husisha { mkusanyaji/msomaji.swa }
husisha { maktaba/kumbukumbu.swa }
husisha { maktaba/mfuatano.swa }

// ==========================================================
// msambazaji.swa :: Mchanganuzi wa Swa wa kuteremka kwa kujirudia
// Kujitegemea -- huchanganua chanzo cha Swa kuwa AST ya safu-bapa.
// ==========================================================

// -------------------------------------------------------
// Viunga vya aina za nodi za AST
// -------------------------------------------------------
n32 NODI_PROGRAMU = 1;
n32 NODI_KAZI = 2;
n32 NODI_RUDISHA = 3;
n32 NODI_NAMBARI = 4;
n32 NODI_KITAMBULISHO = 5;
n32 NODI_JUMLISHA = 6;
n32 NODI_TOFAUTI = 7;
n32 NODI_WITO = 8;
n32 NODI_KAMA = 9;
n32 NODI_WAKATI = 10;
n32 NODI_TANGAZO = 11;
n32 NODI_MUUNDO = 12;
n32 NODI_SEHEMU = 13;
n32 NODI_CHAGUA = 14;
n32 NODI_HALI = 15;
n32 NODI_ACHA = 16;
n32 NODI_ENDELEA = 17;
n32 NODI_ACHILIA = 19;
n32 NODI_SAWA = 20;
n32 NODI_TOFAUTI_SI = 21;
n32 NODI_CHINI = 22;
n32 NODI_JUU = 23;
n32 NODI_CHINI_SAWA = 24;
n32 NODI_JUU_SAWA = 25;
n32 NODI_NA = 26;
n32 NODI_AU = 27;
n32 NODI_SI = 28;
n32 NODI_TAJA = 29;
n32 NODI_KUMBUKA = 30;
n32 NODI_ZIDISHA = 31;
n32 NODI_GAWANYA = 32;
n32 NODI_SEHEMU_NUKTA = 33;
n32 NODI_SEHEMU_MSHALE = 34;
n32 NODI_TANGAZO_ULIMWENGU = 35;
n32 NODI_SIVYO = 36;
n32 NODI_ASIMILIA = 37;
n32 NODI_SAFU = 38;
n32 NODI_MFUATANO = 40;
n32 NODI_SOGEZA_KUSHOTO = 39;  // <<
n32 NODI_SOGEZA_KULIA = 41;  // >>
n32 NODI_BITI_AU = 42;  // |
n32 NODI_BITI_NA = 43;  // &
n32 NODI_CHAGUZI_TATU = 44;  // ? :
n32 NODI_HALISI_D = 45;  // desimali halisi (d64)
n32 NODI_BADILI = 48;  // badili(kielekezi, ukubwa) -> realloc
n32 NODI_BAKI = 49;  // asilimia (%)
n32 NODI_UBETI = 50;  // kifungio cha ndani (hatua ya kwa)
n32 NODI_AU_PEKEE = 46;  // ^ (AU ya biti za kipekee)
n32 NODI_KINYUME = 47;  // ~ (kanusha biti)

// -------------------------------------------------------
// Safu bapa za AST
// MUHIMU: 65536 (na kabla yake 16384) ziliwekwa kulingana na
// mahitaji ya KUJIKUSANYA MWENYEWE (~31k nodi) TU -- si mradi wowote
// halisi wa mtumiaji. Mradi mkubwa wa kweli (mfano Dominion,
// mchezo.swa inayohusisha nguzo nzima ya moduli za mchezo katika
// faili moja) inaweza kuzidi 65536 kwa urahisi, ikisababisha
// node_mpya kurudisha -1 kimya (kabla ya rekebisho hili, jina la
// aina lilikatishwa kwa uwongo na hitilafu za mfululizo zisizoelezeka
// zilitokea). 1,048,576 inatoa nafasi kubwa zaidi ya mara 16 kuliko
// mahitaji ya kujikusanya, ikitarajiwa kutosha kwa miradi mikubwa
// zaidi ya Dominion pia. kvn_visited[] (uzalishaji.swa) na ir_*[]
// (mteremko.swa) zinahitaji ukubwa HUU HUU kwa sababu zinafahirishwa
// na nodi ID zilezile (angalia maoni humo).
// -------------------------------------------------------
n32 aina_ya_nodi[1048576];
n32 thamani_ya_nodi[1048576];
n32 nodi_ya_kushoto[1048576];
n32 nodi_ya_kulia[1048576];
n32 tatu_ya_nodi[1048576];
n32 nne_ya_nodi[1048576];
n32 idadi_ya_nodi = 0;
n32 vigezo_kwanza_ulimwengu = -1;
n32 vigezo_awali_ulimwengu = -1;

// MUHIMU: dimbwi hili (4MB awali) huhifadhi BAITI ZA MAANDISHI ya
// kila jina la kigezo/kazi/muundo/aina linaloonekana kwenye chanzo
// kilichotatuliwa -- mradi halisi mkubwa (mfano Dominion, mchezo.swa
// inayohusisha moduli 40+) linaweza kufikia kiwango hiki kwa
// urahisi. HAKUNA ukaguzi wa mipaka kwenye maandishi ya ast_pool[]
// (angalia changanua_aina_tokeni na kadhalika) -- kufurika hapo
// awali hakukuandika hitilafu safi, badala yake kuliandika KIMYA
// nje ya mpaka wa safu, kikiharibu kumbukumbu iliyofuata na
// kusababisha "aina isiyojulikana" ya UWONGO kwa aina zilizokuwa
// tayari zimefafanuliwa sahihi. 16,777,216 (16MB) inatoa nafasi ya
// mara 4 zaidi.
n8 ghala_la_majina[16777216];
// Nafasi 0 inahifadhiwa kama sentinel ya jina tupu: dimbwi huanza
// kwenye 1 (mfano wa kazi_jina_pool_wapi na var_pool_wapi). Zamani
// jina la kwanza liliishi kwenye 0 na aina ya kielekezi cha muundo
// wake ikawa -2(0+1)+1 = -1 -- alama ileile ya "haijulikani" --
// hivyo hesabu ya kielekezi cha muundo wa kwanza ilibaki baiti
// (hitilafu ya 2026-09-04: (p + 1)->y ilirudisha 0).
n32 ghala_la_majina_wapi = 1;
n32 umbali_wa_jina_la_nodi[1048576];

// -------------------------------------------------------
// Muundo wa hali ya mchanganuzi
// -------------------------------------------------------
muundo Msambazaji {
    Msomaji msomaji;
    Tokeni sasa;
    Tokeni inayofuata;
    n32 kosa;
};

// -------------------------------------------------------
// Kitenzi-njia cha nodi ya AST -- hakuna ukaguzi wa mipaka (tabia iliyopo)
// -------------------------------------------------------
n32 nodi_mpya(n32 aina, n32 thamani, n32 kushoto, n32 kulia) {
    kama (idadi_ya_nodi >= 1048576) {
        // lugha-swa/swa#298 -- kama muundo_nodes[1024] (#189) na
        // kazi_jina_pool[131072] (#197), dimbwi hili ni jedwali
        // linaloendana na UKUBWA WA MRADI -- faili kubwa la kweli
        // (mfano Dominion) huweza kulifikia. ZAMANI (#199) wito huu
        // ulirudisha -1 KWA MAKUSUDI (badala ya kuandika nje ya
        // mipaka), LAKINI waitaji wengi wa node_mpya() hawakuangalia
        // matokeo haya kabla ya kuyatumia kama faharisi ya AST --
        // hatari iliyobaki wazi kwenye maoni ya #199 bila kufungwa
        // kweli. Badala ya kutegemea KILA mwitaji (kuna mamia)
        // kukagua -1, chanzo CHENYEWE sasa kinasimamisha ukusanyaji
        // mara moja -- sawa na andika_baiti() kwa chombo_cha_msimbo (#298).
        andika_kosa("KOSA: akiba ya nodi za AST (ast_aina/ast_thamani/...) imejaa (idadi=%d, aina ya nodi iliyoshindwa=%d) -- chanzo (baada ya kutatua husisha zote) ni kikubwa mno kwa kikomo cha 1048576\n", idadi_ya_nodi, aina);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    n32 faharasa = idadi_ya_nodi;
    aina_ya_nodi[faharasa] = aina;
    thamani_ya_nodi[faharasa] = thamani;
    nodi_ya_kushoto[faharasa] = kushoto;
    nodi_ya_kulia[faharasa] = kulia;
    tatu_ya_nodi[faharasa] = -1;
    nne_ya_nodi[faharasa] = -1;
    umbali_wa_jina_la_nodi[faharasa] = 0;
    idadi_ya_nodi = idadi_ya_nodi + 1;
    rudisha faharasa;
}

// Kukunja hakutumiki wakati kianzilishi cha kigezo cha ULIMWENGU
// kinachanganuliwa (weka 1 kabla, 0 baada -- angalia mahali
// inapowekwa kwenye tangazo la ulimwengu). Sababu: mwandishi wa data
// ya .data (uzalishaji.swa) HUKATAA KWA MAKUSUDI kianzilishi
// chochote ambacho SI tokeni ya nambari ya moja kwa moja (usemi wa
// hesabu kama "1 + 2" haujategemewa KABISA na utaratibu huo -- ni
// uamuzi wa usanifu, umeandikwa wazi kwenye maoni ya ukaguzi huo, SI
// kizuizi cha muda kilichosahaulika). Kukunja kwa uwazi kungeficha
// usemi kama huo ndani ya tokeni ya nambari KABLA ukaguzi huo
// haujaufikia, kikivunja jaribio la kudumu
// jaribio_hitilafu_kianzio_usemi.swa (lililoandikwa MAKUSUDI kuzuia
// urudiaji wa hitilafu ya kihistoria: "1 + 2" kama kianzilishi cha
// ulimwengu ilikuwa ikikubaliwa KIMYA na kuhifadhi 0 -- rekebisho la
// zamani lilifanya ikatae kwa sauti KWA MAKUSUDI, si kwa bahati).
n32 kunja_imezuiwa = 0;

// -------------------------------------------------------
// Kukunja mara kwa mara (constant folding): +, -, *, /, %
//
// Inatumika TU wakati PANDE ZOTE MBILI za operesheni ni tokeni za
// nambari HALISI za moja kwa moja (AST_NAMBARI, ast_kulia != 1 --
// SI usimbaji wa dimbwi la n64 kubwa, angalia changanua_nambari
// mahali linaloitangaza) -- hii inaepuka KABISA hitaji la
// kusimbua/kusimba upya baiti za dimbwi hilo, ambalo lingeongeza
// hatari isiyo ya lazima.
//
// Hesabu ya kukunja inafanyika kwa n64 (upana mpana wa kutosha
// kuepuka kufurika kwa KATI ya hesabu), lakini matokeo YANAHIFADHIWA
// TU kama yamo ndani ya WIGO KAMILI wa n32 (-2147483648 hadi
// 2147483647). Nje ya wigo huo (kufurika kwa kweli, kunakohitaji
// tabia ya "wraparound" ya x86 32-bit), HAIKUNJWI KABISA -- usemi
// unabaki bila kubadilika, ukikokotolewa wakati wa kukimbia (ambapo
// r0d ya x86 hufanya wraparound sahihi kiotomatiki kwa vyovyote) --
// hii inaepuka hatari ya kuiga tabia ya wraparound VIBAYA ndani ya
// mkusanyaji mwenyewe. Ni upotezaji mdogo wa fursa ya uboreshaji
// (thamani kubwa sana hazikunjwi), si hatari ya usahihi.
//
// Mgawanyo/modulo kwa SIFURI HAIKUNJWI KAMWE -- inabaki hitilafu ya
// WAKATI WA KUKIMBIA (kama ilivyokuwa kabla), si kuanguka kimya au
// kusababisha hitilafu ya mkusanyaji wenyewe.
n32 jaribu_kunja_namba(n32 kitendo, n32 kushoto, n32 kulia) {
    kama (kunja_imezuiwa == 1) { rudisha -1; }
    kama (kushoto == -1 || kulia == -1) { rudisha -1; }
    kama (aina_ya_nodi[kushoto] != NODI_NAMBARI) { rudisha -1; }
    kama (aina_ya_nodi[kulia] != NODI_NAMBARI) { rudisha -1; }
    kama (nodi_ya_kulia[kushoto] == 1) { rudisha -1; }
    kama (nodi_ya_kulia[kulia] == 1) { rudisha -1; }
    n64 a = thamani_ya_nodi[kushoto];
    n64 b = thamani_ya_nodi[kulia];
    n64 matokeo = 0;
    kama (kitendo == NODI_JUMLISHA) { matokeo = a + b; }
    sivyo { kama (kitendo == NODI_TOFAUTI) { matokeo = a - b; }
        sivyo { kama (kitendo == NODI_ZIDISHA) { matokeo = a * b; }
            sivyo { kama (kitendo == NODI_GAWANYA) {
                    kama (b == 0) { rudisha -1; }
                    matokeo = a / b;
                } sivyo { kama (kitendo == NODI_BAKI) {
                        kama (b == 0) { rudisha -1; }
                        matokeo = a % b;
                    } sivyo { rudisha -1; } } } } }
    kama (matokeo > 2147483647) { rudisha -1; }
    n64 kikomo_chini = 0 - 2147483648;
    kama (matokeo < kikomo_chini) { rudisha -1; }
    n32 m32 = matokeo;
    rudisha nodi_mpya(NODI_NAMBARI, m32, -1, -1);
}

// -------------------------------------------------------
// Nakili jina/kamba ndani ya ast_pool na rekodi kukabilia kwake
// -------------------------------------------------------
w0 hifadhi_jina(n32 nodi_hii, n8* maandishi, n64 urefu) {
    // lugha-swa/swa#298 -- ukaguzi huu ULIKUWA ukitumia kikomo cha
    // ZAMANI (4194304, 4MB) BAADA ya ast_pool[] kuongezwa hadi 16MB
    // (16777216) kwa ajili ya #200 -- namba mbili zinazopaswa
    // kuendana (ukubwa wa tangazo la safu + ukaguzi wa kufurika)
    // zilitofautiana, sawa na somo la #197. Matokeo: majina ya
    // vitambulisho yalikataliwa KIMYA (hakuna hata ujumbe wa hitilafu
    // wa kawaida, ni "; DEB" tu) mara tu dimbwi lilipopita 4MB, licha
    // ya 12MB ya nafasi halisi iliyobaki -- nodi husika iliachwa na
    // ast_jina_off==0 (jina tupu), ikisababisha ulinganisho WA UONGO
    // wa majina baadaye. Sasa inatumia kikomo sahihi (16777216) na
    // inasimamisha ukusanyaji badala ya kuendelea kimya.
    kama (ghala_la_majina_wapi + urefu + 1 > 16777216) {
        n64 u = urefu;
        andika_kosa("KOSA: dimbwi la majina ya AST (ast_pool) limejaa (kikomo cha baiti 16777216, wapi=%d, urefu=%d)\n", ghala_la_majina_wapi, u);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    n32 umbali = ghala_la_majina_wapi;
    umbali_wa_jina_la_nodi[nodi_hii] = umbali;
    ghala_la_majina_wapi = umbali + urefu + 1;
    n32 i = 0;
    wakati (i < urefu) {
        ghala_la_majina[umbali + i] = maandishi[i];
        i = i + 1;
    }
    ghala_la_majina[umbali + urefu] = 0;
}

// -------------------------------------------------------
// Tafuta jina katika dimbwi la ast_pool -- rudisha kianzio chake
// au 0 ikiwa hakipo. Hutumiwa kuhakikisha miundo inapata
// usimbaji thabiti kwa matumizi ya kurudia.
// -------------------------------------------------------
n32 tafuta_jina_dimbeni(n8* maandishi, n64 urefu) {
    // Pitia yaliyomo ya dimbwi kutoka mwanzo hadi ast_pool_wapi
    // kwa kuangalia mipaka ya \0 - hii ni rahisi na inafanya kazi
    n32 nafasi = 0;
    wakati (nafasi < ghala_la_majina_wapi) {
        n32 i = 0;
        wakati (i < urefu) {
            kama (ghala_la_majina[nafasi + i] != maandishi[i]) { acha; }
            i = i + 1;
        }
        kama (i == urefu) {
            kama (ghala_la_majina[nafasi + urefu] == 0) {
                rudisha nafasi;
            }
        }
        // Ruka hadi '\0' inayofuata
        wakati (nafasi < ghala_la_majina_wapi && ghala_la_majina[nafasi] != 0) {
            nafasi = nafasi + 1;
        }
        kama (nafasi < ghala_la_majina_wapi) { nafasi = nafasi + 1; }
    }
    rudisha -1;
}

// -------------------------------------------------------
// Kitenzi-njia -- anzisha utazamaji wa tokeni
// -------------------------------------------------------
// jina_linganisha: 1 ikiwa maandishi mawili (0 mwishoni) ni sawa. Iko hapa
// (si uzalishaji.swa) kwa sababu msambazaji huitumia, na moduli za juu
// (mkaguzi, uzalishaji, uzalishaji_wasm) huipata kupitia msambazaji.
n32 jina_linganisha(n8* a, n8* b) {
    wakati (a[0] != 0 && b[0] != 0) {
        kama (a[0] != b[0]) { rudisha 0; }
        a = a + 1;
        b = b + 1;
    }
    rudisha (a[0] == b[0]);
}

Msambazaji msambazaji_mpya(n8* chanzo, n64 urefu) {
    Msambazaji p;
    p.msomaji = msomaji_mpya(chanzo, urefu);
    p.kosa = 0;
    tokeni_inayofuata(&p.sasa, &p.msomaji);
    tokeni_inayofuata(&p.inayofuata, &p.msomaji);
    rudisha p;
}

// -------------------------------------------------------
// Songeza tokeni moja
// -------------------------------------------------------
w0 sogeza(Msambazaji* p) {
    p->sasa.aina = p->inayofuata.aina;
    p->sasa.mwanzo = p->inayofuata.mwanzo;
    p->sasa.urefu = p->inayofuata.urefu;
    p->sasa.mstari = p->inayofuata.mstari;
    p->sasa.safu = p->inayofuata.safu;
    tokeni_inayofuata(&p->inayofuata, &p->msomaji);
}

// -------------------------------------------------------
// Ruka tokeni hadi kwenye kifikisha (';', '}', au EOF).
// Hairuki kifikisha chenyewe -- mpigaji anaamua la kufanya.
// Rudisha: 1 = ';', 2 = '}', 0 = EOF
// -------------------------------------------------------
n32 ruka_hadi_kifikisha(Msambazaji* p) {
    wakati (p->sasa.urefu != 0) {
        // Angalia kama tokeni ya sasa ni kifikisha
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, ";")) { rudisha 1; }
            kama (neno_ni(&p->sasa, "}")) { rudisha 2; }
        }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ";")) { rudisha 1; }
        sogeza(p);
    }
    rudisha 0;  // EOF
}

// -------------------------------------------------------
// Tarajia tokeni ya aina fulani; tumia ikifaulu
// -------------------------------------------------------
n32 tarajia(Msambazaji* p, n32 aina_ya_tokeni) {
    kama (p->sasa.aina == aina_ya_tokeni) { sogeza(p); rudisha 1; }
    p->kosa = 1;
    rudisha 0;
}

// -------------------------------------------------------
// Angalia kama tokeni inalingana kimaandishi na kamba fulani.
// KUMBUKA: inalinganisha hadi t->urefu baiti pekee, hivyo waitaji
// wanaolinganisha dhidi ya waendeshaji wa herufi-nyingi LAZIMA
// pia waangalie kwamba urefu wa tokeni unalingana.
// -------------------------------------------------------
// Maneno yaliyoondolewa kabla ya v0.0.2 (vunja, main, andika_kosa,
// anza, msimbo_wa_kitufe, majina 33 ya maktaba ya v0.0.1) hayana
// maana maalum tena -- ni majina ya kawaida, na programu inaweza
// kuyafafanua yenyewe. Yakitumika bila kufafanuliwa, kosa linataja
// jina jipya ili kuhamia kuwe kazi ya dakika moja.
// -------------------------------------------------------
w0 kataa_neno_la_zamani(n8* zamani, n8* jipya) {
    andika_kosa("kosa: '%s' imeondolewa -- tumia '%s'\n", zamani, jipya);
}

n32 neno_ni(Tokeni * t, n8* neno) {
    kama (t->urefu == 0) { rudisha 0; }
    n64 i = 0;
    wakati (i < t->urefu) {
        kama (t->mwanzo[i] != neno[i]) { rudisha 0; }
        i = i + 1;
    }
    // Hakikisha neno pia lina urefu sawa
    kama (neno[i] != 0) { rudisha 0; }
    rudisha 1;
}

// "vunja;" au "vunja }" -- taarifa ya zamani ya kutoka kwenye mzunguko
// (si kigeu kiitwacho vunja, kama "vunja = 3;")
n32 ni_vunja_iliyoondolewa(Tokeni * t) {
    kama (neno_ni(t, "vunja") == 0) { rudisha 0; }
    n8* q = t->mwanzo + t->urefu;
    wakati (q[0] == 32 || q[0] == 9) { q = q + 1; }
    kama (q[0] == 59 || q[0] == 125) { rudisha 1; }
    rudisha 0;
}

// -------------------------------------------------------
// Neno muhimu? Hati 2.2: maneno muhimu hayawezi kutumika kama
// majina ya vitambulisho. Orodha kamili ya maneno 13: muundo,
// rudisha, kama, sivyo, wakati, kwa, fanya, vunja, endelea,
// chagua, hali, husisha, achilia. Rudisha 1 ikiwa tokeni ni
// neno muhimu.
// -------------------------------------------------------
n32 tokeni_ni_muhimu(Tokeni* t) {
    kama (t->urefu < 3) { rudisha 0; }  // maneno muhimu yote yana angalau herufi 3
    kama (neno_ni(t, "muundo")) { rudisha 1; }
    kama (neno_ni(t, "rudisha")) { rudisha 1; }
    kama (neno_ni(t, "kama")) { rudisha 1; }
    kama (neno_ni(t, "sivyo")) { rudisha 1; }
    kama (neno_ni(t, "wakati")) { rudisha 1; }
    kama (neno_ni(t, "kwa")) { rudisha 1; }
    kama (neno_ni(t, "fanya")) { rudisha 1; }
    kama (neno_ni(t, "acha")) { rudisha 1; }
    kama (neno_ni(t, "endelea")) { rudisha 1; }
    kama (neno_ni(t, "chagua")) { rudisha 1; }
    kama (neno_ni(t, "hali")) { rudisha 1; }
    kama (neno_ni(t, "husisha")) { rudisha 1; }
    kama (neno_ni(t, "achilia")) { rudisha 1; }
    rudisha 0;
}

// Kataa tokeni iliyopo ikiwa ni neno muhimu linalotumiwa kama
// jina (hati 2.2) -- kosa la sauti lenye ujumbe wa Kiswahili.
// Rudisha 1 ikiwa ilikataliwa (p->kosa imewekwa), 0 ikiwa halali.
n32 kataa_neno_muhimu(Msambazaji* p) {
    kama (tokeni_ni_muhimu(&p->sasa) == 0) { rudisha 0; }
    n8 chombo_muhimu[64];
    n32 bi = 0;
    wakati (bi < p->sasa.urefu && bi < 63) {
        chombo_muhimu[bi] = p->sasa.mwanzo[bi];
        bi = bi + 1;
    }
    chombo_muhimu[bi] = 0;
    andika_kosa("kosa: '%s' ni neno muhimu -- haliwezi kutumika kama jina\n", chombo_muhimu);
    p->kosa = 1;
    rudisha 1;
}

// -------------------------------------------------------
// Badilisha tokeni ya nambari kuwa thamani n32
// -------------------------------------------------------
n32 tokeni_kwa_nambari(n8* mwanzo, n64 urefu) {
    n32 n = 0;
    n32 i = 0;
    wakati (i < urefu) {
        n8 c = mwanzo[i];
        kama (c >= 48) {
            kama (c <= 57) { n = n * 10 + c - 48; }
        }
        i = i + 1;
    }
    rudisha n;
}

// Kama tokeni_kwa_nambari, lakini inarudisha n64 kamili -- inaweza
// kubeba thamani zaidi ya 2147483647 (vipimo vya baiti 8).
n64 tokeni_kwa_nambari_n64(n8* mwanzo, n64 urefu) {
    n64 n = 0;
    n32 i = 0;
    wakati (i < urefu) {
        n8 c = mwanzo[i];
        kama (c >= 48) {
            kama (c <= 57) { n = n * 10 + c - 48; }
        }
        i = i + 1;
    }
    rudisha n;
}

// -------------------------------------------------------
// Uainishaji wa majina ya aina
// -------------------------------------------------------

n32 ni_aina_tokeni(Tokeni * t) {
    kama (t->urefu < 1) { rudisha 0; }
    n8 c0 = t->mwanzo[0];
    kama (c0 >= 65) {
        kama (c0 <= 90) { rudisha 1; }
    }
    // MUHIMU: kiambishi cha herufi ndogo cha aina ya msingi (n32, d64,
    // n.k.) LAZIMA kikubaliwe hapa PIA -- lakini kwa UANGALIFU: si kila
    // kitambulisho cha herufi ndogo, ni MFUATANO KAMILI unaolingana na
    // muundo wa aina ya msingi (herufi moja ya [n|a|d|b|w] ikifuatiwa
    // na tarakimu TU). ni_aina_msingi_pia_ndogo (chini) inafanya
    // ukaguzi huu HASA -- tumia moja kwa moja badala ya kurudia mantiki
    // hapa. Kitambulisho cha kawaida cha herufi ndogo (mfano "mfano",
    // "jumla", "piga_kelele") halilingani muundo huu na HALIINGII
    // njia hii. TUMIA HAPA TU (nafasi ya kutangaza aina) -- SI kwenye
    // ukaguzi wa "jina la aina halitumiki kama usemi" (ni_jina_la_aina,
    // chini), kwa sababu hazina hii YENYEWE ina vitambulisho vingi vya
    // ndani vya herufi ndogo vinavyolingana muundo huu bila kukusudia
    // kuwa aina (a1..a6 -- hoja za kazi za printf-kama; b1/b2/b3 --
    // baiti zilizogawanywa kwenye hesabu) -- kuvikataza kama "usemi"
    // kunavunja kujikusanya kwa hazina hii YENYEWE. Angalia maelezo
    // kamili kwenye ni_aina_msingi_pia_ndogo.
    kama (ni_aina_msingi_pia_ndogo(t->mwanzo, t->urefu)) { rudisha 1; }
    // Jina la muundo la herufi ndogo (#285) -- tangazo lake lolote
    // kwenye chanzo, hata kama liko BAADA ya hapa.
    kama (ni_jina_la_muundo_awali(t)) { rudisha 1; }
    rudisha 0;
}

n32 ni_aina_msingi(n8* maandishi, n64 n) {
    kama (n < 2) { rudisha 0; }
    n8 c0 = maandishi[0];
    kama (c0 < 65 || c0 > 90) { rudisha 0; }
    n64 j = 1;
    wakati (j < n) {
        n8 c = maandishi[j];
        kama (c < 48 || c > 57) { rudisha 0; }
        j = j + 1;
    }
    rudisha 1;
}

// Jina la aina ya msingi, herufi NDOGO PEKEE (herufi kubwa
// imeondolewa -- uamuzi wa msimamizi baada ya Awamu C kukamilika,
// angalia hati/mipaka.md). n32 na N32 hazikuwa aina mbili tofauti
// kabla ya uondoaji huu (zilitoa familia/upana SAWA), na sasa N32
// haitambuliwi KABISA kama jina la aina (angalia changanua_aina_tokeni
// chini).
//
// MUHIMU: umezuiliwa KIMAKUSUDI kwa herufi TANO za familia halisi
// (n, a, d, b, w) TU -- SI herufi yoyote ya alfabeti. Kuruhusu HERUFI
// YOYOTE (si tano hizi tu) kungegonga vitambulisho vingi HALISI vya
// ndani ya hazina hii yenyewe (iligunduliwa kwa majaribio HALISI, si
// dhana: "h2" -- kigezo cha kawaida cha ndani cha uzalishaji.swa --
// kililingana kimakosa na muundo huu kabla ya kuzuiliwa kwa herufi
// tano, likivunja kujikusanya kwa hazina hii yenyewe kwa hitilafu ya
// uwongo "jina la aina halifuatwi na jina la kigeu").
n32 ni_aina_msingi_pia_ndogo(n8* maandishi, n64 n) {
    kama (n < 2) { rudisha 0; }
    n8 c0 = maandishi[0];
    n32 ni_ndogo = (c0 == 110 || c0 == 97 || c0 == 100 || c0 == 98 || c0 == 119);  // n a d b w
    kama (ni_ndogo == 0) { rudisha 0; }
    n64 j = 1;
    wakati (j < n) {
        n8 c = maandishi[j];
        kama (c < 48 || c > 57) { rudisha 0; }
        j = j + 1;
    }
    rudisha 1;
}

n32 simba_aina(n32 familia, n32 upana, n32 mshale) {
    // Hesabu ya / na % (awali ina hitilafu katika & na |)
    rudisha ((familia % 256) * 256) + (upana % 256) + (mshale % 4);
}

// Alama ya muktadha: tuko ndani ya hoja za ukubwa(...) -- mahali
// pekee jina la aina linapokubalika kama usemi (kipimo cha aina).
n32 ukubwa_wa_hoja = 0;

// Jina la aina? Aina za nambari hufuata muundo [N|A|D|B|W]+tarakimu
// (mf. n32, d64, w0, n32, d64, w0), na miundo ya mtumiaji
// inajulikana kupitia akiba ya miundo iliyokamilika.
//
// MUHIMU: kazi hii ina MATUMIZI MOJA TU -- kuamua kama taarifa
// inayoanza na tokeni hii YAWEZEKANA ni TANGAZO LA KIGEU (mfano
// "n32 x = 5;"), SI ukaguzi wa "jina la aina halitumiki kama usemi"
// (ukaguzi huo upo KANDA, moja kwa moja ndani ya mchanganuzi wa
// usemi wa msingi, ukiwa umekusudia kubaki herufi KUBWA TU -- angalia
// maelezo kwenye ni_aina_msingi_pia_ndogo hapo juu kwa sababu kamili).
// Hapa, kwa upande mwingine, tunahitaji herufi ndogo ZITAMBULIWE
// kikamilifu, la sivyo "n32 x = 5;" haiwahi kutambuliwa kama tangazo
// kabisa -- kazi hii inaitwa TU kwenye nafasi ya mwanzo wa taarifa
// (statement dispatch), si kila mahali kitambulisho kinapoonekana.
n32 ni_jina_la_aina(Tokeni* t) {
    kama (ni_aina_msingi_pia_ndogo(t->mwanzo, t->urefu)) { rudisha 1; }
    kama (ni_jina_la_muundo_awali(t)) { rudisha 1; }
    n32 mi = 0;
    wakati (mi < idadi_ya_ukubwa_wa_muundo) {
        n8* mj = jina_la_ukubwa_wa_muundo[mi];
        n32 j = 0;
        n32 lingana = 1;
        wakati (j < t->urefu) {
            kama (mj[j] != t->mwanzo[j]) { lingana = 0; acha; }
            j = j + 1;
        }
        kama (lingana) {
            kama (mj[j] == 0) { rudisha 1; }
        }
        mi = mi + 1;
    }
    rudisha 0;
}

n32 changanua_aina_tokeni(Msambazaji* p) {
    kama (ni_aina_tokeni(&p->sasa) == 0) { rudisha 0; }
    n8* maandishi = p->sasa.mwanzo;
    n64 n = p->sasa.urefu;
    n32 familia = 0;
    n32 upana = 0;
    n32 mshale = 0;
    kama (ni_aina_msingi_pia_ndogo(maandishi, n)) {
        n8 c0 = maandishi[0];
        // Herufi ndogo PEKEE (herufi kubwa imeondolewa).
        kama (c0 == 110) { familia = 1; }  // n
        kama (c0 == 97) { familia = 2; }  // a
        kama (c0 == 100) { familia = 3; }  // d
        kama (c0 == 98) { familia = 4; }  // b
        kama (c0 == 119) { familia = 5; }  // w
    }
    kama (familia == 0) { familia = 6; }  // muundo wa mtumiaji
    kama (familia != 6) {
        n32 w = 0;
        n32 j = 1;
        wakati (j < n) {
            n8 herufi = maandishi[j];
            kama (herufi >= 48) {
                kama (herufi <= 57) { w = w * 10 + herufi - 48; }
            }
            j = j + 1;
        }
        upana = w;
        // Hati 3 inaahidi upana 8/16/32/64 pekee; w0 (upana 0) ni tupu
        // ya familia W. N128, D80, A128 n.k. zilikubalika kimya na
        // kutoa msimbo usio na maana -- kataa kwa sauti kama awali
        // ("aina isiyojulikana").
        kama (upana != 8) {
            kama (upana != 16) {
                kama (upana != 32) {
                    kama (upana != 64) {
                        kama ((upana != 0 || familia != 5) && (upana != 1 || familia != 4)) {
                            n8 chombo_cha_jina[64];
                            n32 bi = 0;
                            wakati (bi < n && bi < 63) {
                                chombo_cha_jina[bi] = maandishi[bi];
                                bi = bi + 1;
                            }
                            chombo_cha_jina[bi] = 0;
                            andika_kosa("kosa: aina isiyojulikana: %s\n", chombo_cha_jina);
                            p->kosa = 1;
                            rudisha -1;
                        }
                    }
                }
            }
        }
    }
    // b1 (biti moja) husimbwa kwa alama ya upana 12 -- angalia B1_ENC kwenye
    // mkaguzi.swa: upana 1 ungegongana na biti ya mshale.
    kama (familia == 4 && upana == 1) { upana = 12; }
    sogeza(p);
    // '*' kama kiendeshi cha herufi-moja kinaweza kukosa aina ISHARA kutoka kwa mchanganuaji.
    // Tumia utambuzi wa njia-mbili kushughulikia kesi zote kwa uhakika.
    n32 ni_mshale = 0;
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, "*")) { ni_mshale = 1; sogeza(p); }
    }
    kama (ni_mshale == 0) {
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "*")) { ni_mshale = 1; sogeza(p); }
    }
    // Shughulikia viashiria vingi: n8** n.k.
    // Mshale wa pili unahifadhiwa kama biti 1 (mshale = 3 inamaanisha **).
    n32 ni_mshale_pili = 0;
    kama (ni_mshale) {
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "*")) { ni_mshale_pili = 1; sogeza(p); }
        }
        kama (ni_mshale_pili == 0) {
            kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "*")) { ni_mshale_pili = 1; sogeza(p); }
        }
    }
    mshale = ni_mshale + (ni_mshale_pili * 2);
    // Kwa miundo ya mtumiaji, tumia usimbaji hasi unaobeba pia kianzio
    // cha jina kwenye dimbwi. Hii inaruhusu ukubwa_kutoka_enc kupata
    // ukubwa halisi wa muundo husika wakati wa uzalishaji.
    kama (familia == 6) {
        n32 umbali = tafuta_jina_dimbeni(maandishi, n);
        kama (umbali == -1) {
            umbali = ghala_la_majina_wapi;
            kama (umbali + n + 1 >= 16777216) {
                // lugha-swa/swa#298 -- kurudisha 0 kimya hapa
                // kungeharibu usimbaji wa aina ya muundo huu KIMYA
                // (0 ni usimbaji batili/tofauti kabisa na jina sahihi
                // la dimbwi), ikisababisha ukubwa/umbali wa sehemu
                // kuhesabiwa vibaya baadaye bila hitilafu ya kukusanya.
                andika_kosa("KOSA: dimbwi la majina ya AST (ast_pool) limejaa (jina la muundo, kikomo cha baiti 16777216, wapi=%d)\n", umbali);
                wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
            }
            n32 i = 0;
            wakati (i < n) {
                ghala_la_majina[umbali + i] = maandishi[i];
                i = i + 1;
            }
            ghala_la_majina[umbali + i] = 0;
            ghala_la_majina_wapi = umbali + n + 1;
        }
        rudisha (-((umbali + 1) * 2)) + mshale;
    }
    rudisha simba_aina(familia, upana, mshale);
}

// -------------------------------------------------------
// Matangazo ya mbele kwa vitenzi-njia vinavyojirudia kwa pande-mbili
// -------------------------------------------------------
n32 changanua_usemi(Msambazaji* p);
n32 changanua_taarifa(Msambazaji* p);
n32 changanua_taarifa_kama(Msambazaji* p);
n32 changanua_taarifa_wakati(Msambazaji* p);
n32 changanua_taarifa_fanya(Msambazaji* p);
n32 changanua_taarifa_chagua(Msambazaji* p);
n32 changanua_taarifa_kwa(Msambazaji* p);
n32 changanua_taarifa_tangazo(Msambazaji* p);
n32 changanua_taarifa_ndani(Msambazaji* p);
n32 changanua_kazi(Msambazaji* p);
n32 changanua_kazi_vigezo(Msambazaji* p);
n32 changanua_maudhui_ya_kazi(Msambazaji* p);
n32 changanua_muundo(Msambazaji* p);
n32 changanua_usemi_hamisha(Msambazaji* p);
n32 changanua_usemi_biti_na(Msambazaji* p);
n32 changanua_usemi_biti_au(Msambazaji* p);
n32 changanua_usemi_chaguzi_tatu(Msambazaji* p);

// ==========================================================
// MCHANUZI WA USEMI -- kupanda kwa utangulizi
// ==========================================================

// -------------------------------------------------------
// MSINGI :: halisi, vitambulisho, ( usemi ), { orodha-anzisha },
//            kiambishi si (kukanusha kimantiki), sizeof iliyojengewa
// -------------------------------------------------------
n32 changanua_taarifa_kama(Msambazaji* p) {
    // ---- kama ( hali ) bloku [ sivyo bloku ] ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "kama")) {
            sogeza(p);
            // Hali
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "(")) { sogeza(p); }
            }
            n32 sharti = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
            }

            // Maudhui-wa-ndiyo -- bloku au taarifa moja
            n32 maudhui_ya_basi = -1;
            kama (p->sasa.mwanzo[0] == 123) {
                maudhui_ya_basi = changanua_ubeti(p);
            } sivyo {
                maudhui_ya_basi = changanua_taarifa(p);
            }

            // Kifungu cha sivyo cha hiari (sivyo) -- bloku { } au taarifa
            // moja (semantiki ya C, sawa na maudhui ya kama). Zamani
            // maudhui bila mabano ulirudi -1 kimya na taarifa ilielea
            // nje kama taarifa isiyo na masharti (hitilafu ya 2026-09-01).
            // Tawi-jingine huandikwa kwa kuingiza kama ndani ya sivyo
            // (hakuna "sivyo kama").
            n32 maudhui_ya_sivyo = -1;
            kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
                kama (neno_ni(&p->sasa, "sivyo")) {
                    sogeza(p);
                    kama (p->sasa.mwanzo[0] == 123) {
                        maudhui_ya_sivyo = changanua_ubeti(p);
                    } sivyo {
                        maudhui_ya_sivyo = changanua_taarifa(p);
                        // Maudhui yasiyo halali (si bloku wala taarifa) --
                        // kosa la sauti badala ya kumeza kimya.
                        kama (maudhui_ya_sivyo == -1) { p->kosa = 1; }
                    }
                }
            }

            n32 kama_nodi = nodi_mpya(NODI_KAMA, 0, sharti, maudhui_ya_basi);
            kama (maudhui_ya_sivyo != -1) {
                n32 sivyo_nodi = nodi_mpya(NODI_SIVYO, 0, maudhui_ya_sivyo, -1);
                tatu_ya_nodi[kama_nodi] = sivyo_nodi;
            }
            rudisha kama_nodi;
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_wakati(Msambazaji* p) {
    // ---- wakati ( hali ) bloku ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "wakati")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "(")) { sogeza(p); }
            }
            n32 sharti = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
            }

            n32 maudhui = -1;
            kama (p->sasa.mwanzo[0] == 123) {
                maudhui = changanua_ubeti(p);
            } sivyo {
                maudhui = changanua_taarifa(p);
            }

            rudisha nodi_mpya(NODI_WAKATI, 0, sharti, maudhui);
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_fanya(Msambazaji* p) {
    // ---- fanya { maudhui } wakati ( sharti ) ; ----
    // Mzunguko wa fanya (fanya-wakati): maudhui hukimbia mara moja kabla
    // ya sharti kujaribiwa. Nodi yake ni AST_WAKATI yenye alama
    // -777778 kwenye ast_thamani (0 = wakati, -777777 = kwa yenye
    // hatua) -- uzalishaji ndiye anayesoma alama hiyo, na mkaguzi
    // anachunguza fanya sawa na wakati (mzunguko: vunja na endelea
    // ni halali ndani yake; endelea inaruka hadi sharti).
    // Muundo ni MKALI -- mabano ya maudhui, ya sharti, na nukta-mkato
    // ni ya lazima (sawa na awali).
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "fanya")) {
            sogeza(p);
            // Maudhui: mabano ya wima { } ni ya lazima
            kama (p->sasa.mwanzo[0] == 123) {
                n32 maudhui = changanua_ubeti(p);
                // Kifungio tupu { } kinarudisha -1 kama maudhui halali
                // yasiyo na taarifa -- p->kosa ndiyo ishara ya kosa.
                kama (p->kosa) { rudisha -1; }
                // Kifungu cha sharti: wakati ( sharti )
                kama (neno_ni(&p->sasa, "wakati")) {
                    sogeza(p);
                } sivyo {
                    andika_kosa("kosa: 'fanya' inahitaji 'wakati ( sharti ) ;' baada ya maudhui\n");
                    p->kosa = 1;
                    rudisha -1;
                }
                kama (neno_ni(&p->sasa, "(")) {
                    sogeza(p);
                } sivyo {
                    andika_kosa("kosa: mabano ya sharti ya 'fanya' hayapo: wakati ( sharti )\n");
                    p->kosa = 1;
                    rudisha -1;
                }
                n32 sharti = changanua_usemi(p);
                kama (sharti == -1) {
                    p->kosa = 1;
                    rudisha -1;
                }
                kama (neno_ni(&p->sasa, ")")) {
                    sogeza(p);
                } sivyo {
                    andika_kosa("kosa: mabano ya sharti ya 'fanya' hayajafungwa: wakati ( sharti )\n");
                    p->kosa = 1;
                    rudisha -1;
                }
                // Nukta-mkato ya mwisho ni ya lazima (semantiki ya C)
                kama (neno_ni(&p->sasa, ";")) {
                    sogeza(p);
                } sivyo {
                    andika_kosa("kosa: 'fanya' inahitaji nukta-mkato ';' baada ya 'wakati ( sharti )'\n");
                    p->kosa = 1;
                    rudisha -1;
                }
                rudisha nodi_mpya(NODI_WAKATI, -777778, sharti, maudhui);
            }
            andika_kosa("kosa: maudhui ya 'fanya' lazima uwe kwenye mabano ya wima { }\n");
            p->kosa = 1;
            rudisha -1;
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_chagua(Msambazaji* p) {
    // ---- chagua ( usemi ) { hali X : ... [hali Y : ...] [sivyo : ...] } ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "chagua")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "(")) { sogeza(p); }
            }
            n32 imepimwa = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
            }

            tarajia(p, TOKENI_ISHARA);  // {

            n32 hali_ya_kwanza_kabisa = -1;
            n32 hali_iliyotangulia = -1;
            n32 maudhui_ya_chaguo_msingi = -1;  // maudhui ya sivyo (chaguo-msingi)

            wakati (1 == 1) {
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, "}")) { sogeza(p); acha; }
                }
                kama (p->sasa.urefu == 0) { p->kosa = 1; acha; }

                kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
                    kama (neno_ni(&p->sasa, "hali")) {
                        sogeza(p);
                        n32 usemi_wa_mahali = changanua_usemi(p);
                        // Tarajia :
                        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                            kama (neno_ni(&p->sasa, ":")) { sogeza(p); }
                        }

                        // Kusanya taarifa mpaka hali/sivyo inayofuata au }
                        n32 hali_ya_kwanza = -1;
                        n32 hali_ya_awali = -1;
                        wakati (1 == 1) {
                            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                                kama (neno_ni(&p->sasa, "}")) { acha; }
                            }
                            kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
                                kama (neno_ni(&p->sasa, "hali") || neno_ni(&p->sasa, "sivyo")) { acha; }
                            }
                            kama (p->sasa.urefu == 0) { p->kosa = 1; acha; }
                            n32 taarifa = changanua_taarifa(p);
                            kama (taarifa == -1) { p->kosa = 1; acha; }
                            kama (hali_ya_awali == -1) { hali_ya_kwanza = taarifa; }
                            sivyo { nne_ya_nodi[hali_ya_awali] = taarifa; }
                            hali_ya_awali = taarifa;
                        }

                        n32 hali_ya_nodi = nodi_mpya(NODI_HALI, 0, usemi_wa_mahali, hali_ya_kwanza);
                        kama (hali_iliyotangulia == -1) { hali_ya_kwanza_kabisa = hali_ya_nodi; }
                        sivyo { nne_ya_nodi[hali_iliyotangulia] = hali_ya_nodi; }
                        hali_iliyotangulia = hali_ya_nodi;
                        endelea;
                    }
                    kama (neno_ni(&p->sasa, "sivyo")) {
                        sogeza(p);
                        // Tarajia :
                        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                            kama (neno_ni(&p->sasa, ":")) { sogeza(p); }
                        }

                        // Kusanya taarifa mpaka hali/sivyo inayofuata au }
                        n32 chaguo_msingi_cha_kwanza = -1;
                        n32 chaguo_msingi_cha_awali = -1;
                        wakati (1 == 1) {
                            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                                kama (neno_ni(&p->sasa, "}")) { acha; }
                            }
                            kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
                                kama (neno_ni(&p->sasa, "hali") || neno_ni(&p->sasa, "sivyo")) { acha; }
                            }
                            kama (p->sasa.urefu == 0) { p->kosa = 1; acha; }
                            n32 taarifa = changanua_taarifa(p);
                            kama (taarifa == -1) { p->kosa = 1; acha; }
                            kama (chaguo_msingi_cha_awali == -1) { chaguo_msingi_cha_kwanza = taarifa; }
                            sivyo { nne_ya_nodi[chaguo_msingi_cha_awali] = taarifa; }
                            chaguo_msingi_cha_awali = taarifa;
                        }

                        maudhui_ya_chaguo_msingi = chaguo_msingi_cha_kwanza;
                        endelea;
                    }
                }
                acha;
            }

            n32 chagua_nodi = nodi_mpya(NODI_CHAGUA, 0, imepimwa, hali_ya_kwanza_kabisa);
            tatu_ya_nodi[chagua_nodi] = maudhui_ya_chaguo_msingi;  // maudhui ya sivyo (chaguo-msingi)
            rudisha chagua_nodi;
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_kwa(Msambazaji* p) {
    // ---- kwa ( anzisha ; hali ; hatua ) bloku   (mzunguko wa kwa) ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "kwa")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "(")) { sogeza(p); }
            }

            // anzisha (tangazo, usemi, au tupu)
            n32 kianzio = -1;
            kama (p->sasa.mwanzo[0] == 59) {
                sogeza(p);  // anzisha tupu: kwa (; hali; hatua)
            } sivyo {
                // Jaribu tangazo la ndani kwanza (mf. n32 i = 0)
                kianzio = changanua_taarifa_tangazo(p);
                kama (kianzio == -1) {
                    // Jaribu usemi (mf. i = 0)
                    kianzio = changanua_usemi(p);
                    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                        kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
                    }
                }
            }

            // hali (usemi au tupu)
            n32 sharti = -1;
            kama (p->sasa.mwanzo[0] == 59) {
                sogeza(p);
            } sivyo {
                sharti = changanua_usemi(p);
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
                }
            }

            // hatua (usemi au tupu)
            n32 hatua_ya_mzunguko = -1;
            kama (p->sasa.mwanzo[0] == 41) {
                sogeza(p);
            } sivyo {
                hatua_ya_mzunguko = changanua_usemi(p);
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
                }
            }

            // maudhui
            n32 maudhui = -1;
            kama (p->sasa.mwanzo[0] == 123) {
                maudhui = changanua_ubeti(p);
            } sivyo {
                maudhui = changanua_taarifa(p);
            }

            // Ondoa sukari ya mzunguko-wa-kwa kuwa taarifa ya anzisha ikifuatiwa na mzunguko wa wakati.
            // Mzunguko wa wakati hufunga hali + (maudhui + hatua iliyoambatishwa mwishoni mwa maudhui).
            // Hatua imefungwa kwenye block-mini yenye alama -777777 kwenye
            // ast_kulia (kulia ya ubeti huwa -1 kamwe -- hakuna mgongano).
            // Uzalishaji_block hurekodi nafasi yake kwa ajili ya endelea
            // (semantiki ya C: endelea inaruka kwenye hatua, si kwenye hali).
            n32 ina_hatua = 0;
            kama (hatua_ya_mzunguko != -1) {
                ina_hatua = 1;
                n32 ubeti_wa_hatua = nodi_mpya(NODI_UBETI, 0, hatua_ya_mzunguko, -1);
                nodi_ya_kulia[ubeti_wa_hatua] = -777777;
                kama (maudhui != -1) {
                    // Tafuta taarifa ya mwisho kwenye mfululizo wa maudhui.
                    n32 mwisho = maudhui;
                    wakati (nne_ya_nodi[mwisho] != -1) { mwisho = nne_ya_nodi[mwisho]; }
                    nne_ya_nodi[mwisho] = ubeti_wa_hatua;
                } sivyo {
                    maudhui = ubeti_wa_hatua;
                }
            }

            n32 wakati_nodi = nodi_mpya(NODI_WAKATI, ina_hatua ? -777777 : 0, sharti, maudhui);

            // Hifadhi anzisha kwenye ast_tiga (huepuka kufutwa na msururu wa taarifa za ngazi-ya-juu)
            kama (kianzio != -1) {
                tatu_ya_nodi[wakati_nodi] = kianzio;
            }

            rudisha wakati_nodi;
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_tangazo(Msambazaji* p) {
    // ---- Tangazo la ndani lenye kiambishi cha aina: n32 x ;  /  n32 x = usemi ; ----
    // Pia hushughulikia matamko mengi: n32 a, b, c;
    //
    // C-semantiki ya kutofautisha tangazo na usemi: jina la aina
    // likifuatiwa na jina la kigeu (baada ya viashiria) -> tangazo.
    // Likifuatiwa na '=', kiendeshi, au ';' -> taarifa ya usemi.
    // Hii inaruhusu kigezo chenye jina linaloanza na herufi kubwa
    // kupewa thamani: n32 G = 1; G = 5;
    kama (ni_jina_la_aina(&p->sasa)) {
        // Tazama mbele kwa tokeni inayofuata jina la aina na nyota
        // zake -- hakuna urejeshaji wa vitenzi; rejesha hali kamili.
        // Hifadhi sehemu moja-moja: kianzio cha kigeu cha muundo
        // kutoka kwa sehemu haijulikani zamani kwa dereva wa Rust
        // (memcpy inachukua thamani ya kwanza kama anwani na kuanguka).
        // Dereva umehamishiwa lugha-swa/swa-dereva (kumbukumbu).
        n32 ni_tangazo = 0;
        n64 nafasi_iliyohifadhiwa = p->msomaji.nafasi;
        n32 mstari_uliohifadhiwa = p->msomaji.mstari;
        n32 safu_iliyohifadhiwa = p->msomaji.safu;
        Tokeni sasa_iliyohifadhiwa;
        sasa_iliyohifadhiwa.aina = p->sasa.aina;
        sasa_iliyohifadhiwa.mwanzo = p->sasa.mwanzo;
        sasa_iliyohifadhiwa.urefu = p->sasa.urefu;
        sasa_iliyohifadhiwa.mstari = p->sasa.mstari;
        sasa_iliyohifadhiwa.safu = p->sasa.safu;
        Tokeni ifuatayo_iliyohifadhiwa;
        ifuatayo_iliyohifadhiwa.aina = p->inayofuata.aina;
        ifuatayo_iliyohifadhiwa.mwanzo = p->inayofuata.mwanzo;
        ifuatayo_iliyohifadhiwa.urefu = p->inayofuata.urefu;
        ifuatayo_iliyohifadhiwa.mstari = p->inayofuata.mstari;
        ifuatayo_iliyohifadhiwa.safu = p->inayofuata.safu;
        sogeza(p);  // tumia jina la aina kwa jaribio
        // Ruka viashiria vya herufi moja: Jina* j;  /  Jina** j;
        wakati (p->sasa.urefu == 1 && p->sasa.mwanzo[0] == 42) { sogeza(p); }
        // MUHIMU: >=65 peke yake HAITOSHI -- baadhi ya alama za ishara
        // (mfano '[' = 91, ']' = 93, '{' = 123, '}' = 125) ziko juu ya
        // 65 kimahesabu lakini SI mwanzo wa jina la kigeu kamwe.
        // Bila kuzitenga, taarifa kama "a1[0] = 65;" (kigezo cha safu
        // KILICHOSHATANGAZWA kikifahirishwa, si tangazo jipya) ilikuwa
        // ikikisiwa VIBAYA kama tangazo (kwa sababu upanuzi wa herufi
        // ndogo za aina za msingi sasa unatambua "a1" kama jina la
        // aina linalowezekana) -- iligunduliwa kwa majaribio HALISI
        // (jaribio_k14_maktaba_zaidi.swa, a1[0]/b1[0]).
        n8 herufi_inayofuata = p->sasa.mwanzo[0];
        n32 ni_ishara_maalum = (herufi_inayofuata == 91 || herufi_inayofuata == 93 || herufi_inayofuata == 123 || herufi_inayofuata == 125);
        kama (p->sasa.urefu >= 1 && herufi_inayofuata >= 65 && ni_ishara_maalum == 0) { ni_tangazo = 1; }
        p->msomaji.nafasi = nafasi_iliyohifadhiwa;
        p->msomaji.mstari = mstari_uliohifadhiwa;
        p->msomaji.safu = safu_iliyohifadhiwa;
        p->sasa = sasa_iliyohifadhiwa;
        p->inayofuata = ifuatayo_iliyohifadhiwa;
        kama (ni_tangazo) {
            n32 aina_ya_tangazo = changanua_aina_tokeni(p);
            n32 kwanza = -1;
            n32 awali = -1;
            n32 ukubwa_wa_safu = 0;

            wakati (1 == 1) {
                ukubwa_wa_safu = 0;
                n32 safu_ilipo = 0;
                kama ((p->sasa.mwanzo[0] >= 65 && p->sasa.mwanzo[0] != 91 && p->sasa.mwanzo[0] != 93 && p->sasa.mwanzo[0] != 123 && p->sasa.mwanzo[0] != 125)) {
                    // Neno muhimu kama jina la kigeu -- kosa la sauti (hati 2.2)
                    kama (kataa_neno_muhimu(p)) { rudisha -1; }
                    n32 nodi_ya_jina_la_kigeu = nodi_mpya(NODI_KITAMBULISHO, 0, -1, -1);
                    hifadhi_jina(nodi_ya_jina_la_kigeu, p->sasa.mwanzo, p->sasa.urefu);
                    thamani_ya_nodi[nodi_ya_jina_la_kigeu] = aina_ya_tangazo;
                    sogeza(p);

                    // Ruka [ukubwa] kama ipo (kwa matamko ya safu ya ndani)
                    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                        kama (neno_ni(&p->sasa, "[")) {
                            safu_ilipo = 1;
                            sogeza(p);
                            kama (p->sasa.urefu > 0) {
                                // Halisi ya herufi kama ukubwa: kataa kwa sauti.
                                kama (p->sasa.mwanzo[0] == 39) {
                                    andika_kosa("kosa: halisi ya herufi haijaungwa mkono\n");
                                    p->kosa = 1;
                                    rudisha -1;
                                }
                                ukubwa_wa_safu = neno_kwa_nambari(p->sasa.mwanzo, p->sasa.urefu);
                                sogeza(p);
                            }
                            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                                kama (neno_ni(&p->sasa, "]")) { sogeza(p); }
                            }
                        }
                    }

                    n32 kianzio = -1;
                    // Angalia kwa kianzisha '='
                    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "=")) {
                        // Safu + kianzilishi si katika hati 6.1; kukubali kimya
                        // kunatupa kianzilishi. Kataa kwa sauti, sawa na awali.
                        kama (safu_ilipo != 0) {
                            andika_kosa("kosa: kianzilishi cha safu hakijaungwa mkono\n");
                            p->kosa = 1;
                            rudisha -1;
                        }
                        sogeza(p);
                        kianzio = changanua_usemi(p);
                    }

                    n32 tangazo_nodi = nodi_mpya(NODI_TANGAZO, aina_ya_tangazo, nodi_ya_jina_la_kigeu, kianzio);
                    kama (ukubwa_wa_safu > 0) { tatu_ya_nodi[tangazo_nodi] = ukubwa_wa_safu; }
                    kama (kwanza == -1) { kwanza = tangazo_nodi; }
                    sivyo { nne_ya_nodi[awali] = tangazo_nodi; }
                    awali = tangazo_nodi;

                    // Angalia kama kuna koma kwa tangazo linalofuata
                    n32 ina_koma = 0;
                    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                        kama (neno_ni(&p->sasa, ",")) { ina_koma = 1; }
                    }
                    kama (ina_koma == 0 && p->sasa.urefu == 1 && neno_ni(&p->sasa, ",")) { ina_koma = 1; }
                    kama (ina_koma) {
                        sogeza(p);
                        endelea;
                    }
                    acha;
                } sivyo {
                    acha;
                }
            }

            // Aina ilisomwa lakini hakuna jina la kigeu lililofuata -- fomu
            // isiyo halali (mf. `n32;` au `n32* p = tenga n32;`). Zamani
            // ilimezwa kimya na kuacha tokeni ya aina ikiwa imepotea.
            kama (kwanza == -1) {
                p->kosa = 1;
                andika_kosa("kosa: jina la aina halifuatwi na jina la kigeu\n");
                rudisha -1;
            }

            // Tumia semicolon ya hiari (baada ya matamko yote)
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            // Pia shughulikia tokeni za waendeshaji zinazokosa aina ISHARA
            kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ";")) { sogeza(p); }

            rudisha kwanza;
        }
    }
    // Aina haikujulikana. Neno linalofuatiwa na neno lingine ni
    // jaribio la tangazo la aina isiyojulikana (mf. Foo bar;) --
    // kosa la sauti, si taarifa ya usemi (usemi halali hauanzi
    // kwa maneno mawili mfululizo -- sawa na awali).
    kama (p->sasa.aina == TOKENI_KITAMBULISHO || p->sasa.aina == TOKENI_MANENO) {
        kama (p->inayofuata.aina == TOKENI_KITAMBULISHO || p->inayofuata.aina == TOKENI_MANENO) {
            n8 chombo_cha_jina[64];
            n32 bi = 0;
            wakati (bi < p->sasa.urefu && bi < 63) {
                chombo_cha_jina[bi] = p->sasa.mwanzo[bi];
                bi = bi + 1;
            }
            chombo_cha_jina[bi] = 0;
            andika_kosa("kosa: aina isiyojulikana: %s\n", chombo_cha_jina);
            p->kosa = 1;
            rudisha -1;
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_ndani(Msambazaji* p) {
    // ---- vunja ; ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (ni_vunja_iliyoondolewa(&p->sasa)) {
            kataa_neno_la_zamani("vunja", "acha");
            p->kosa = 1;
            rudisha -1;
        }
        kama (neno_ni(&p->sasa, "acha")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            rudisha nodi_mpya(NODI_ACHA, 0, -1, -1);
        }
    }

    // ---- endelea ; ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "endelea")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            rudisha nodi_mpya(NODI_ENDELEA, 0, -1, -1);
        }
    }

    // ---- achilia usemi ; ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "achilia")) {
            sogeza(p);
            n32 usemi = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            kama (usemi == -1) { rudisha nodi_mpya(NODI_ACHILIA, 0, -1, -1); }
            rudisha nodi_mpya(NODI_ACHILIA, 0, usemi, -1);
        }
    }

    // ---- badili kielekezi, ukubwa ; ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "badili")) {
            sogeza(p);
            n32 kielekezi = changanua_usemi(p);
            kama (kielekezi == -1) { rudisha -1; }
            n32 ukubwa_huu = -1;
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ",")) { sogeza(p); }
                ukubwa_huu = changanua_usemi(p);
            }
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            kama (ukubwa_huu == -1) { rudisha -1; }
            rudisha nodi_mpya(NODI_BADILI, 0, kielekezi, ukubwa_huu);
        }
    }

    // ---- rudisha usemi ;  /  rudisha ; ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "rudisha")) {
            sogeza(p);
            // Rudisha tupu
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) {
                    sogeza(p);
                    rudisha nodi_mpya(NODI_RUDISHA, 0, -1, -1);
                }
            }
            n32 usemi = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            rudisha nodi_mpya(NODI_RUDISHA, 0, usemi, -1);
        }
    }
    rudisha -1;
}

// 1 ikiwa orodha ya vigezo iliyochanganuliwa mwisho iliishia kwa `...`
// (hoja za ziada -- kazi za nje pekee, hati/kiolesura-cha-mashine.md).
n32 vigezo_vya_ziada = 0;
// 1 wakati changanua_nje inachanganua kizuizi chake
n32 ndani_ya_nje = 0;

n32 changanua_kazi_vigezo(Msambazaji* p) {
    vigezo_kwanza_ulimwengu = -1;
    vigezo_awali_ulimwengu = -1;
    vigezo_vya_ziada = 0;

    wakati (1 == 1) {
        n8 c0 = p->sasa.mwanzo[0];
        kama (c0 == 41) { sogeza(p); acha; }
        kama (c0 == 44) { sogeza(p); endelea; }
        // `...` -- lazima iwe mwisho, na ndani ya nje pekee
        kama (c0 == 46) {
            n32 nukta = 0;
            wakati (p->sasa.urefu != 0 && p->sasa.mwanzo[0] == 46 && nukta < 3) {
                nukta = nukta + p->sasa.urefu;
                sogeza(p);
            }
            kama (nukta != 3 || p->sasa.mwanzo[0] != 41) {
                andika_kosa("kosa: mstari %d: '...' lazima iwe kigezo cha mwisho\n", p->sasa.mstari);
                p->kosa = 1;
                rudisha -1;
            }
            kama (ndani_ya_nje == 0) {
                andika_kosa("kosa: mstari %d: '...' (hoja za ziada) ni kwa kazi za nje pekee\n", p->sasa.mstari);
                p->kosa = 1;
                rudisha -1;
            }
            vigezo_vya_ziada = 1;
            endelea;
        }
        kama (p->sasa.urefu == 0) { p->kosa = 1; rudisha -1; }
        // Tokeni isiyo aina kwenye orodha ya vigezo ('{' n.k.) ni kosa --
        // bila ulinzi huu mzunguko hauna mwendo wala toka (hang).
        kama (ni_aina_tokeni(&p->sasa) == 0) { p->kosa = 1; rudisha -1; }

        n32 aina_ya_kigezo = changanua_aina_tokeni(p);
        n32 nodi_ya_kigezo = -1;
        n8 nc0 = p->sasa.mwanzo[0];
        kama ((nc0 >= 65 && nc0 != 123 && nc0 != 125)) {
            // Neno muhimu kama jina la kigezo -- kosa la sauti (hati 2.2)
            kama (kataa_neno_muhimu(p)) { rudisha -1; }
            nodi_ya_kigezo = nodi_mpya(NODI_KITAMBULISHO, 0, -1, -1);
            hifadhi_jina(nodi_ya_kigezo, p->sasa.mwanzo, p->sasa.urefu);
            thamani_ya_nodi[nodi_ya_kigezo] = aina_ya_kigezo;
            sogeza(p);
        }
        kama (vigezo_kwanza_ulimwengu == -1) { vigezo_kwanza_ulimwengu = nodi_ya_kigezo; }
        sivyo { nodi_ya_kulia[vigezo_awali_ulimwengu] = nodi_ya_kigezo; }
        vigezo_awali_ulimwengu = nodi_ya_kigezo;

        n8 cc0 = p->sasa.mwanzo[0];
        kama (cc0 == 44) { sogeza(p); endelea; }
    }

    // Usitume '{' hapa: tangazo la mbele halina maudhui,
    // na changanua_kazi ndiye anayepaswa kuamua.
    rudisha vigezo_kwanza_ulimwengu;
}

n32 changanua_maudhui_ya_kazi(Msambazaji* p) {
    // Kifungio TUPU { } ni ufafanuzi, si tangazo la mbele (tangazo ni
    // ';' pekee baada ya vigezo) -- rudisha kifungio tupu ili ast_tiga
    // ya kazi isiwe -1, vinginevyo uzalishaji ungeiruka kimya na wito
    // wake kuleta "kazi haijafafanuliwa".

    // Changanua taarifa za maudhui
    n32 maudhui = -1;
    n32 awali = -1;
    wakati (1 == 1) {
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "}")) { sogeza(p); acha; }
        }
        // EOF kabla ya '}' -- maudhui yasiyofungwa ni kosa, si kukubalika
        kama (p->sasa.urefu == 0) { p->kosa = 1; acha; }

        n32 taarifa = changanua_taarifa(p);
        kama (taarifa == -1) {
            p->kosa = 1;
            n32 fika = ruka_hadi_kifikisha(p);
            kama (fika == 1) { sogeza(p); endelea; }  // tumia ';', endelea
            kama (fika == 2) { acha; }  // '}' -- mzunguko utaiona
            acha;  // EOF
        }
        kama (awali == -1) { maudhui = taarifa; }
        sivyo { nne_ya_nodi[awali] = taarifa; }
        awali = taarifa;
        // Fuata mfululizo hadi mwisho (kwa matamko mengi kama n32 a, b;)
        wakati (nne_ya_nodi[awali] != -1) { awali = nne_ya_nodi[awali]; }
    }


    kama (maudhui == -1) {
        maudhui = nodi_mpya(NODI_UBETI, 0, -1, -1);  // maudhui matupu { }
    }
    rudisha maudhui;
}

n32 changanua_msingi_orodha(Msambazaji* p) {
    // Orodha ya vianzisha  { kipengele , ... }
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, "{")) {
            // Vianzishi vya safu {a, b, c} si katika hati 6.1; kukubali
            // kimya kunatupa vianzishi (msimbo unatoa 0). Kataa kwa sauti,
            // sawa na awali.
            andika_kosa("kosa: kianzilishi cha safu hakijaungwa mkono\n");
            p->kosa = 1;
            rudisha -1;
            sogeza(p);
            n32 kwanza = -1;
            n32 awali = -1;
            wakati (1 == 1) {
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, "}")) { sogeza(p); acha; }
                }
                kama (p->sasa.urefu == 0) { p->kosa = 1; acha; }
                n32 kipengele = changanua_usemi(p);
                kama (kipengele == -1) { p->kosa = 1; acha; }
                kama (awali == -1) { kwanza = kipengele; }
                sivyo { nodi_ya_kulia[awali] = kipengele; }
                awali = kipengele;
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, ",")) {
                        sogeza(p);
                        endelea;
                    }
                }
            }
            rudisha nodi_mpya(NODI_SAFU, 0, kwanza, -1);
        }
    }
    rudisha -1;
}


n32 changanua_msingi(Msambazaji* p) {
    // Halisi ya nambari (au desimali kama kuna '.')
    kama (p->sasa.aina == TOKENI_NAMBARI) {
        // Halisi ya herufi ('h') si katika hati 2.3; kukubali kimya
        // kunatoa 0 (tokeni haina tarakimu). Kataa kwa sauti, sawa na awali.
        kama (p->sasa.mwanzo[0] == 39) {
            andika_kosa("kosa: halisi ya herufi haijaungwa mkono\n");
            p->kosa = 1;
            rudisha -1;
        }
        // Halisi za radiksi (0x, 0o, 0b) si katika hati 2.3 -- hati
        // inaahidi "mfuatano wa tarakimu" pekee. Kukubali kimya
        // kunatoa jibu la desimali (0x10 = 10). Kataa kwa sauti.
        kama (p->sasa.urefu >= 2) {
            n8 c1 = p->sasa.mwanzo[1];
            kama (c1 == 120 || c1 == 88 || c1 == 111 || c1 == 79 || c1 == 98 || c1 == 66) {
                andika_kosa("kosa: halisi za radiksi hazijaungwa mkono\n");
                p->kosa = 1;
                rudisha -1;
            }
        }
        // Nukuu ya kisayansi (1.5e2, 1E-3) si katika hati 2.3 -- hati
        // inaahidi "21.5" pekee. Kukubali kimya kunatupa kipeo:
        // msomaji hukusanya tokeni nzima (1.5e2) na kuitupa kipeo.
        // Kataa kwa sauti, sawa na halisi za radiksi.
        n32 ki2 = 0;
        n32 ni_kisayansi = 0;
        wakati (ki2 < p->sasa.urefu) {
            n8 ck2 = p->sasa.mwanzo[ki2];
            kama (ck2 == 101 || ck2 == 69) { ni_kisayansi = 1; acha; }
            ki2 = ki2 + 1;
        }
        kama (ni_kisayansi) {
            andika_kosa("kosa: nukuu ya kisayansi haijaungwa mkono\n");
            p->kosa = 1;
            rudisha -1;
        }
        n32 ni_d = 0;
        n32 k2 = 0;
        wakati (k2 < p->sasa.urefu) {
            kama (p->sasa.mwanzo[k2] == 46) { ni_d = 1; acha; }
            k2 = k2 + 1;
        }
        kama (ni_d == 0) {
            n64 v = tokeni_kwa_nambari_n64(p->sasa.mwanzo, p->sasa.urefu);
            sogeza(p);
            // Ulinganisho wa > 2147483647 ni WENYE ISHARA -- thamani za
            // [2^63, 2^64) zinaonekana hasi na kuanguka kwenye njia ya
            // n32 (ukataji wa kimya, weka r0d, 0xFFFFFFFF). "v < 0"
            // (ishara) kinakamata [2^63, 2^64) -- pamoja viko sawa na
            // ulinganisho BILA ishara dhidi ya 2^31.
            kama (v > 2147483647) {
                // n64 halisi: ast_thamani (n32) haiwezi kubeba thamani
                // kubwa -- hifadhi baiti 8 kwenye dimbwi la AST na uweke
                // ast_kulia=1 kama alama ya n64 (ast_tiga ni kiungo cha
                // mfululizo wa hoja kwenye wito -- usiguse).
                n32 umbali_n = ghala_la_majina_wapi;
                n8* bv = &v;
                n32 bvi = 0;
                wakati (bvi < 8) {
                    ghala_la_majina[umbali_n + bvi] = bv[bvi];
                    bvi = bvi + 1;
                }
                ghala_la_majina_wapi = umbali_n + 8;
                n32 nn = nodi_mpya(NODI_NAMBARI, umbali_n, -1, -1);
                nodi_ya_kulia[nn] = 1;
                rudisha nn;
            }
            sivyo {
                kama (v < 0) {
                    // [2^63, 2^64): ishara hasi -- bado halisi ya n64.
                    n32 umbali_n = ghala_la_majina_wapi;
                    n8* bv = &v;
                    n32 bvi = 0;
                    wakati (bvi < 8) {
                        ghala_la_majina[umbali_n + bvi] = bv[bvi];
                        bvi = bvi + 1;
                    }
                    ghala_la_majina_wapi = umbali_n + 8;
                    n32 nn = nodi_mpya(NODI_NAMBARI, umbali_n, -1, -1);
                    nodi_ya_kulia[nn] = 1;
                    rudisha nn;
                }
                rudisha nodi_mpya(NODI_NAMBARI, v, -1, -1);
            }
        }
        // Desimali halisi (d64): baiti kutoka kiolesura cha C (strtod),
        // zimehifadhiwa kwenye dimbwi la AST (baiti 8) -- ast_thamani
        // ina umbali wa dimbwi; ast_tiga inabaki -1 kama kiungo cha hoja.
        n64 biti = biti_ya_d64_swa(p->sasa.mwanzo, p->sasa.urefu);
        sogeza(p);
        n32 umbali_d = ghala_la_majina_wapi;
        n8* bd = &biti;
        n32 bdi = 0;
        wakati (bdi < 8) {
            ghala_la_majina[umbali_d + bdi] = bd[bdi];
            bdi = bdi + 1;
        }
        ghala_la_majina_wapi = umbali_d + 8;
        rudisha nodi_mpya(NODI_HALISI_D, umbali_d, -1, -1);
    }

    // Halisi ya kamba (imetengwa kama TOKENI_MFUATANO -- inajumuisha alama za kunukuu)
    kama (p->sasa.aina == TOKENI_MFUATANO) {
        n32 s = nodi_mpya(NODI_KITAMBULISHO, 0, -1, -1);
        hifadhi_jina(s, p->sasa.mwanzo, p->sasa.urefu);
        sogeza(p);
        rudisha s;
    }

    // Kiambishi KANUSHA kimantiki  !usemi  (matokeo ni 1 au 0)
    // Neno la Kiswahili 'si' HALISI si kiambishi -- ni kitambulisho cha
    // kawaida (limezimwa).
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "!")) {
        sogeza(p);
        n32 hoja = changanua_usemi_upande(p);
        kama (hoja == -1) { rudisha -1; }
        rudisha nodi_mpya(NODI_SI, 0, hoja, -1);
    }

    // Kiambishi KINYUME cha biti  ~usemi  (lazima kiwe kabla ya
    // kitambulisho: '~' ina nambari 126, '^' 94 -- zote juu ya 65)
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "~")) {
        sogeza(p);
        n32 hoja = changanua_usemi_upande(p);
        kama (hoja == -1) { rudisha -1; }
        rudisha nodi_mpya(NODI_KINYUME, 0, hoja, -1);
    }

    // Kitambulisho
    kama ((p->sasa.mwanzo[0] >= 65 && p->sasa.mwanzo[0] != 91 && p->sasa.mwanzo[0] != 93 && p->sasa.mwanzo[0] != 123 && p->sasa.mwanzo[0] != 125)) {
        // Jina la aina ya nambari HALITUMIKI kama usemi -- kukubali
        // kunaleta msimbo unaoanguka kimya (mf. `n32* p = tenga n32;`).
        // Jina la muundo lililotangazwa linaruhusiwa: kigezo kinaweza
        // kubeba jina linalofanana na muundo (sawa na awali).
        // Hoja ya ukubwa(...) ndiyo pekee inayoruhusu aina ya nambari.
        kama (ukubwa_wa_hoja == 0) {
            kama (ni_aina_msingi(p->sasa.mwanzo, p->sasa.urefu)) {
                n8 chombo_cha_jina[64];
                n32 bi = 0;
                wakati (bi < p->sasa.urefu && bi < 63) {
                    chombo_cha_jina[bi] = p->sasa.mwanzo[bi];
                    bi = bi + 1;
                }
                chombo_cha_jina[bi] = 0;
                andika_kosa("kosa: jina la aina halitumiki kama usemi: %s\n", chombo_cha_jina);
                p->kosa = 1;
                rudisha -1;
            }
        }
        n32 nodi_ya_kitambulisho = nodi_mpya(NODI_KITAMBULISHO, 0, -1, -1);
        hifadhi_jina(nodi_ya_kitambulisho, p->sasa.mwanzo, p->sasa.urefu);
        sogeza(p);
        rudisha nodi_ya_kitambulisho;
    }

    // Usemi wenye mabano  ( usemi )
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, "(")) {
            sogeza(p);
            n32 usemi = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
            }
            rudisha usemi;
        }
    }

    n32 r_orodha = changanua_msingi_orodha(p);
    kama (r_orodha != -1) { rudisha r_orodha; }

    // Kiambishi TOA unari  -usemi
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "-")) {
        sogeza(p);
        n32 hoja = changanua_usemi_upande(p);
        kama (hoja == -1) { rudisha -1; }
        rudisha nodi_mpya(NODI_TOFAUTI, 0, -1, hoja);
    }

    // Kiambishi NYOOSHA unari  *usemi (kielekezi nyoosha)
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "*")) {
        sogeza(p);
        n32 hoja = changanua_usemi_upande(p);
        kama (hoja == -1) { rudisha -1; }
        rudisha nodi_mpya(NODI_TAJA, 0, hoja, -1);
    }

    // Kiambishi ANWANI-YA unari  &usemi
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "&")) {
        sogeza(p);
        n32 hoja = changanua_usemi_upande(p);
        kama (hoja == -1) { rudisha -1; }
        rudisha nodi_mpya(NODI_KUMBUKA, 0, hoja, -1);
    }

    // sizeof(usemi) -- swala la ukubwa lililojengewa (ukubwa ndio neno kuu)
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "ukubwa")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "(")) { sogeza(p); }
            }
            n32 hoja = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
            }
            kama (hoja == -1) { rudisha -1; }
            rudisha nodi_mpya(NODI_TAJA, 0, hoja, -1);
        }
    }

    rudisha -1;
}

// -------------------------------------------------------
// POSTFIX :: msingi  ( hoja )   .shamba   ->shamba   [ faharisi ]
// -------------------------------------------------------
n32 changanua_usemi_upande(Msambazaji* p) {
    n32 kushoto = changanua_msingi(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        // Wito wa kazi  usemi ( hoja )
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "(")) {
                // ukubwa(aina) huchukua jina la aina kama hoja (kipimo
                // cha aina) -- weka alama ili changanua_primary iruhusu
                // aina hapo.
                n32 ni_ukubwa = 0;
                kama (aina_ya_nodi[kushoto] == NODI_KITAMBULISHO) {
                    kama (jina_linganisha(ghala_la_majina + umbali_wa_jina_la_nodi[kushoto], "ukubwa")) { ni_ukubwa = 1; }
                }
                n32 ukubwa_wa_hoja_zamani = ukubwa_wa_hoja;
                kama (ni_ukubwa) { ukubwa_wa_hoja = 1; }
                sogeza(p);
                n32 hoja_zote = -1;
                n32 awali = -1;
                wakati (1 == 1) {
                    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                        kama (neno_ni(&p->sasa, ")")) { sogeza(p); acha; }
                    }
                    kama (p->sasa.urefu == 0) { p->kosa = 1; acha; }
                    n32 hoja = changanua_usemi(p);
                    kama (hoja == -1) { p->kosa = 1; acha; }
                    kama (awali == -1) { hoja_zote = hoja; }
                    sivyo { tatu_ya_nodi[awali] = hoja; }
                    awali = hoja;
                    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                        kama (neno_ni(&p->sasa, ",")) {
                            sogeza(p);
                            endelea;
                        }
                    }
                }
                ukubwa_wa_hoja = ukubwa_wa_hoja_zamani;
                n32 wito = nodi_mpya(NODI_WITO, 0, kushoto, hoja_zote);
                kushoto = wito;
                endelea;
            }
        }

        // Ufikiaji wa shamba  usemi . jina
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ".")) {
                sogeza(p);
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) { p->kosa = 1; rudisha -1; }
                n32 sehemu = nodi_mpya(NODI_KITAMBULISHO, 0, -1, -1);
                hifadhi_jina(sehemu, p->sasa.mwanzo, p->sasa.urefu);
                sogeza(p);
                kushoto = nodi_mpya(NODI_SEHEMU_NUKTA, 0, kushoto, sehemu);
                endelea;
            }
        }

        // Mbadilisho wa mshale  usemi -> jina
        // Mchanganuaji kujitegemea hutengua -> kama tokeni mbili tofauti ('- ' + '>').
        // Tumia utazamaji ili kuzichanganya kuwa kiendeshi kimoja cha mshale.
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "-")) {
            kama (p->inayofuata.urefu == 1 && neno_ni(&p->inayofuata, ">")) {
                sogeza(p);  // tumia '-'
                sogeza(p);  // tumia '>'
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) { p->kosa = 1; rudisha -1; }
                n32 sehemu = nodi_mpya(NODI_KITAMBULISHO, 0, -1, -1);
                hifadhi_jina(sehemu, p->sasa.mwanzo, p->sasa.urefu);
                sogeza(p);
                kushoto = nodi_mpya(NODI_SEHEMU_MSHALE, 0, kushoto, sehemu);
                endelea;
            }
            acha;  // '-' pekee -- si kiendeshi cha postfix; acha mchanganuzi wa jumlisha autumie
        }

        // Uandikishaji wa safu  usemi [ faharasa ]
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "[")) {
                sogeza(p);
                n32 faharasa_ya_usemi = changanua_usemi(p);
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, "]")) { sogeza(p); }
                }
                kushoto = nodi_mpya(NODI_TAJA, 0, kushoto, faharasa_ya_usemi);
                endelea;
            }
        }

        acha;
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// KUZIDISHA :: *  /
// -------------------------------------------------------
n32 changanua_usemi_zidisha(Msambazaji* p) {
    n32 kushoto = changanua_usemi_upande(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "*")) { kitendo = NODI_ZIDISHA; }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "/")) { kitendo = NODI_GAWANYA; }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "%")) { kitendo = NODI_BAKI; }
        kama (kitendo == -1) { acha; }
        sogeza(p);
        n32 kulia = changanua_usemi_upande(p);
        kama (kulia == -1) {
            andika_kosa("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        n32 kilichokunjwa = jaribu_kunja_namba(kitendo, kushoto, kulia);
        kama (kilichokunjwa != -1) { kushoto = kilichokunjwa; }
        sivyo { kushoto = nodi_mpya(kitendo, 0, kushoto, kulia); }
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// KUNYONGA :: +  -
// -------------------------------------------------------
n32 changanua_usemi_jumlisha(Msambazaji* p) {
    n32 kushoto = changanua_usemi_zidisha(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "+")) { kitendo = NODI_JUMLISHA; }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "-")) { kitendo = NODI_TOFAUTI; }
        kama (kitendo == -1) { acha; }
        sogeza(p);
        // Rekodi ikiwa tokeni inayofuata ni kiendeshi kingine cha +/-
        // (kwa utambuzi wa '++' na '--' baada ya kujaribu operanda).
        // KUMBUKA: kianzilishi chenye '&&' kilivunja LLVM ya dereva wa
        // Rust (phi ya kujizungusha) -- tumia kama/ugawaji badala yake.
        // Dereva umehamishiwa lugha-swa/swa-dereva (kumbukumbu).
        n32 inayofuata_jumlisha = 0;
        n32 inayofuata_toa = 0;
        kama (p->sasa.urefu == 1) {
            kama (neno_ni(&p->sasa, "+")) { inayofuata_jumlisha = 1; }
            kama (neno_ni(&p->sasa, "-")) { inayofuata_toa = 1; }
        }
        n32 kulia = changanua_usemi_zidisha(p);
        kama (kulia == -1) {
            // '++' na '--' zinaingia hapa: operanda inayofuata haipo, na
            // tokeni iliyotangulia ni kiendeshi kingine cha +/-, si usemi.
            // Viendeshaji hivyo HAVIPO kwenye vipimo (2.5) -- lazima
            // vikataliwe kwa sauti, si no-op kimya (zamani 'x++;' ilitengeneza
            // 'x + (bila operanda)' -- jibu baya la kimya).
            kama (kitendo == NODI_JUMLISHA && inayofuata_jumlisha) {
                andika_kosa("kosa: '++' haitekelezwi; andika 'x = x + 1' badala yake\n");
            } sivyo { kama (kitendo == NODI_TOFAUTI && inayofuata_toa) {
                    andika_kosa("kosa: '--' haitekelezwi; andika 'x = x - 1' badala yake\n");
                } sivyo {
                    andika_kosa("kosa: operanda ya kulia haipo\n");
                } }
            p->kosa = 1;
            rudisha -1;
        }
        n32 kilichokunjwa = jaribu_kunja_namba(kitendo, kushoto, kulia);
        kama (kilichokunjwa != -1) { kushoto = kilichokunjwa; }
        sivyo { kushoto = nodi_mpya(kitendo, 0, kushoto, kulia); }
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// HAMISHA :: <<  >>
// -------------------------------------------------------
n32 changanua_usemi_hamisha(Msambazaji* p) {
    n32 kushoto = changanua_usemi_jumlisha(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, "<<")) { kitendo = NODI_SOGEZA_KUSHOTO; }
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, ">>")) { kitendo = NODI_SOGEZA_KULIA; }
        kama (kitendo == -1) { acha; }
        sogeza(p);
        n32 kulia = changanua_usemi_jumlisha(p);
        kama (kulia == -1) {
            andika_kosa("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(kitendo, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// LINGANISHA :: <  >  <=  >=
// -------------------------------------------------------
n32 changanua_usemi_linganisha(Msambazaji* p) {
    n32 kushoto = changanua_usemi_hamisha(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, "<=")) { kitendo = NODI_CHINI_SAWA; }
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, ">=")) { kitendo = NODI_JUU_SAWA; }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "<")) { kitendo = NODI_CHINI; }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ">")) { kitendo = NODI_JUU; }
        kama (kitendo == -1) { acha; }
        sogeza(p);
        n32 kulia = changanua_usemi_jumlisha(p);
        kama (kulia == -1) {
            andika_kosa("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(kitendo, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// USAWA :: ==  !=
// -------------------------------------------------------
n32 changanua_usemi_sawa(Msambazaji* p) {
    n32 kushoto = changanua_usemi_linganisha(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, "==")) { kitendo = NODI_SAWA; }
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, "!=")) { kitendo = NODI_TOFAUTI_SI; }
        kama (kitendo == -1) { acha; }
        sogeza(p);
        n32 kulia = changanua_usemi_linganisha(p);
        kama (kulia == -1) {
            andika_kosa("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(kitendo, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// BITWISE NA :: &
// -------------------------------------------------------
n32 changanua_usemi_biti_na(Msambazaji* p) {
    n32 kushoto = changanua_usemi_sawa(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        kama (p->sasa.urefu != 1) { acha; }
        kama (neno_ni(&p->sasa, "&") == 0) { acha; }
        sogeza(p);
        n32 kulia = changanua_usemi_sawa(p);
        kama (kulia == -1) {
            andika_kosa("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(NODI_BITI_NA, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// BITWISE XOR :: ^  (kati ya & na |, utangulizi wa C)
// -------------------------------------------------------
n32 changanua_usemi_biti_au_pekee(Msambazaji* p) {
    n32 kushoto = changanua_usemi_biti_na(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        kama (p->sasa.urefu != 1) { acha; }
        kama (neno_ni(&p->sasa, "^") == 0) { acha; }
        sogeza(p);
        n32 kulia = changanua_usemi_biti_na(p);
        kama (kulia == -1) {
            andika_kosa("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(NODI_AU_PEKEE, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// BITWISE AU :: |
// -------------------------------------------------------
n32 changanua_usemi_biti_au(Msambazaji* p) {
    n32 kushoto = changanua_usemi_biti_au_pekee(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        kama (p->sasa.urefu != 1) { acha; }
        kama (neno_ni(&p->sasa, "|") == 0) { acha; }
        sogeza(p);
        n32 kulia = changanua_usemi_biti_au_pekee(p);
        kama (kulia == -1) {
            andika_kosa("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(NODI_BITI_AU, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// KIMANTIKI NA :: &&
// -------------------------------------------------------
n32 changanua_usemi_na(Msambazaji* p) {
    n32 kushoto = changanua_usemi_biti_au(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        kama (p->sasa.urefu != 2) { acha; }
        kama (neno_ni(&p->sasa, "&&") == 0) { acha; }
        sogeza(p);
        n32 kulia = changanua_usemi_biti_au(p);
        kama (kulia == -1) {
            andika_kosa("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(NODI_NA, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// KIMANTIKI AU :: ||
// -------------------------------------------------------
n32 changanua_usemi_au(Msambazaji* p) {
    n32 kushoto = changanua_usemi_na(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        kama (p->sasa.urefu != 2) { acha; }
        kama (neno_ni(&p->sasa, "||") == 0) { acha; }
        sogeza(p);
        n32 kulia = changanua_usemi_na(p);
        kama (kulia == -1) {
            andika_kosa("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(NODI_AU, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// TERNARI :: ? :
// -------------------------------------------------------
n32 changanua_usemi_chaguzi_tatu(Msambazaji* p) {
    n32 sharti = changanua_usemi_au(p);
    kama (sharti == -1) { rudisha -1; }

    // Angalia kwa '?' (kiendeshi cha herufi-moja, mchanganuaji anaweza asitoe ISHARA aina)
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "?")) {
        sogeza(p);
        n32 thamani_kweli = changanua_usemi_chaguzi_tatu(p);

        // Tarajia ':'
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ":")) { sogeza(p); }

        n32 sikweli = changanua_usemi_chaguzi_tatu(p);

        n32 nodi_hii = nodi_mpya(NODI_CHAGUZI_TATU, 0, sharti, thamani_kweli);
        // Tawi la uwongo liko ast_nne -- ast_tiga hubeba kiungo cha hoja.
        nne_ya_nodi[nodi_hii] = sikweli;
        rudisha nodi_hii;
    }

    rudisha sharti;
}

// -------------------------------------------------------
// UGAWA :: =  +=  -=  *=  /=
// -------------------------------------------------------
n32 changanua_usemi_asimilia(Msambazaji* p) {
    n32 kushoto = changanua_usemi_chaguzi_tatu(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        n32 ni_kiunganishi = 0;
        // = wazi
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "=")) {
            kitendo = NODI_ASIMILIA;
            ni_kiunganishi = 0;
        }
        // Ugawa wa kiwanja: +=  -=  *=  /=  %=  &=  |=  ^=  <<=  >>=
        kama (kitendo == -1 && p->sasa.urefu == 2) {
            kama (neno_ni(&p->sasa, "+=")) { kitendo = NODI_JUMLISHA; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "-=")) { kitendo = NODI_TOFAUTI; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "*=")) { kitendo = NODI_ZIDISHA; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "/=")) { kitendo = NODI_GAWANYA; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "%=")) { kitendo = NODI_BAKI; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "&=")) { kitendo = NODI_BITI_NA; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "|=")) { kitendo = NODI_BITI_AU; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "^=")) { kitendo = NODI_AU_PEKEE; ni_kiunganishi = 1; }
        }
        // Ugawa wa kiwanja wa hamisha: <<=  >>=  (tokeni ya herufi 3)
        kama (kitendo == -1 && p->sasa.urefu == 3) {
            kama (neno_ni(&p->sasa, "<<=")) { kitendo = NODI_SOGEZA_KUSHOTO; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, ">>=")) { kitendo = NODI_SOGEZA_KULIA; ni_kiunganishi = 1; }
        }
        kama (kitendo == -1) { acha; }

        sogeza(p);
        // Kujirudia-kulia kwa ushirika wa kulia: a = b = c
        n32 kulia = changanua_usemi_asimilia(p);
        kama (kulia == -1) {
            andika_kosa("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }

        kama (ni_kiunganishi) {
            // Ondoa sukari: x += y  =>  x = x + y
            n32 kitendo_pande_mbili = nodi_mpya(kitendo, 0, kushoto, kulia);
            kushoto = nodi_mpya(NODI_ASIMILIA, 0, kushoto, kitendo_pande_mbili);
        } sivyo {
            kushoto = nodi_mpya(NODI_ASIMILIA, 0, kushoto, kulia);
        }
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// Kuingilia kwa USEMI
// -------------------------------------------------------
n32 changanua_usemi(Msambazaji* p) {
    rudisha changanua_usemi_asimilia(p);
}

// ==========================================================
// MCHANUZI WA TAARIFA
// ==========================================================

// Changanua bloku ya taarifa zilizofungwa na { }
// Rudisha nodi ya kwanza ya taarifa; taarifa zimeunganishwa kupitia ast_nne.
// Kwenye kuingilia p->sasa lazima iwe '{'.
n32 changanua_ubeti(Msambazaji* p) {
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, "{")) {
            sogeza(p);
        } sivyo {
            rudisha -1;
        }
    } sivyo {
        rudisha -1;
    }

    n32 kwanza = -1;
    n32 awali = -1;
    wakati (1 == 1) {
        kama (p->sasa.urefu == 0) { p->kosa = 1; acha; }  // EOF katika bloku -- kosa
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "}")) { sogeza(p); acha; }
        }
        n32 taarifa = changanua_taarifa(p);
        kama (taarifa == -1) {
            p->kosa = 1;
            n32 fika = ruka_hadi_kifikisha(p);
            kama (fika == 1) { sogeza(p); endelea; }  // tumia ';', endelea
            kama (fika == 2) { acha; }  // '}' -- bloku mzunguko utaiona
            acha;  // EOF
        }
        kama (awali == -1) { kwanza = taarifa; }
        sivyo { nne_ya_nodi[awali] = taarifa; }
        awali = taarifa;
        // Fuata mfululizo hadi mwisho (kwa matamko mengi kama n32 a, b;)
        wakati (nne_ya_nodi[awali] != -1) { awali = nne_ya_nodi[awali]; }
    }
    rudisha kwanza;
}

n32 changanua_taarifa(Msambazaji* p) {
    // Taarifa tupu: ';' pekee -- isongeze na urudi kifungio tupu.
    // C-semantiki, sawa na awali (n32 f() { ; } ni maudhui halali).
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, ";")) {
            sogeza(p);
            rudisha nodi_mpya(NODI_UBETI, 0, -1, -1);
        }
    }
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ";")) {
        sogeza(p);
        rudisha nodi_mpya(NODI_UBETI, 0, -1, -1);
    }
    // 'sivyo' bila 'kama' iliyotangulia ni kosa la mchanganuzi.
    // Hapo awali ilipita kama kitambulisho (msimbo wenye maana ya
    // takataka) au kutoa kosa lisilo sahihi la kianzilishi cha safu.
    // Kataa kwa sauti -- 'sivyo' inakubalika tu ndani ya changanua_kama.
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "sivyo")) {
            andika_kosa("kosa: 'sivyo' inahitaji 'kama' kabla yake\n");
            p->kosa = 1;
            rudisha -1;
        }
    }
    // ndani kupitia kisaidizi
    n32 r_ndani = changanua_taarifa_ndani(p);
    kama (r_ndani != -1) { rudisha r_ndani; }

    // kama kupitia kisaidizi
    n32 r_kama = changanua_taarifa_kama(p);
    kama (r_kama != -1) { rudisha r_kama; }
    // wakati kupitia kisaidizi
    n32 r_wakati = changanua_taarifa_wakati(p);
    kama (r_wakati != -1) { rudisha r_wakati; }
    // fanya (fanya-wakati) kupitia kisaidizi
    n32 r_fanya = changanua_taarifa_fanya(p);
    kama (r_fanya != -1) { rudisha r_fanya; }
    // chagua kupitia kisaidizi
    n32 r_chagua = changanua_taarifa_chagua(p);
    kama (r_chagua != -1) { rudisha r_chagua; }
    // kwa kupitia kisaidizi
    n32 r_kwa = changanua_taarifa_kwa(p);
    kama (r_kwa != -1) { rudisha r_kwa; }
    // tangazo kupitia kisaidizi
    n32 r_tangazo = changanua_taarifa_tangazo(p);
    kama (r_tangazo != -1) { rudisha r_tangazo; }
    // ---- Taarifa ya usemi  usemi ; ----
    n32 usemi = changanua_usemi(p);
    kama (usemi != -1) {
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
        }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ";")) { sogeza(p); }
        rudisha usemi;
    }

    rudisha -1;
}

// ==========================================================
// MCHANUZI WA KAZI (pia hushughulikia vigezo vya kimataifa vya kiwango cha juu)
//
// FIX: Baada ya kutumia jina, angalia mara moja kama
// tokeni inayofuata ni '(' (kazi) au '=' / ';' (kigezo cha kimataifa).
// Kwa kigezo cha kimataifa, changanua kianzisha cha hiari na semicolon,
// kisha RUDISHA -- usianguke ndani ya uchanganuzi wa vigezo,
// ambao ungekwama kwenye tokeni isiyo ya '('.
// ==========================================================
// 1 ikiwa tangazo la mbele la mwisho lilifungwa kwa ';' (changanua_nje
// huitumia kujua kama ';' ilikosekana au ilishatumiwa hapa).
n32 kazi_mbele_ilifungwa = 0;

n32 changanua_kazi(Msambazaji* p) {
    kama (ni_aina_tokeni(&p->sasa) == 0) { rudisha -1; }

    n32 aina_ya_matokeo = changanua_aina_tokeni(p);

    // Neno muhimu kama jina la kazi au kigezo cha kimataifa -- kosa la sauti (hati 2.2)
    kama (kataa_neno_muhimu(p)) { rudisha -1; }

    n32 nodi_ya_jina = nodi_mpya(NODI_KITAMBULISHO, 0, -1, -1);
    hifadhi_jina(nodi_ya_jina, p->sasa.mwanzo, p->sasa.urefu);
    sogeza(p);  // tumia jina
    // Hifadhi usimbaji wa aina kwenye nodi ya jina (sawa na matamko ya ndani)
    thamani_ya_nodi[nodi_ya_jina] = aina_ya_matokeo;

    // --------------------------------------------------
    // FIX: Tofautisha kazi kutoka kwa kigezo cha kimataifa.
    // Kazi ina '(' baada ya jina; kigezo cha kimataifa
    // kina '=', ';', au mwisho-wa-tangazo.
    // --------------------------------------------------
    n32 ni_ulimwengu = 0;
    n32 nodi_ya_ulimwengu = -1;
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        n32 ni_mabano = neno_ni(&p->sasa, "(");
        kama (ni_mabano) {
            sogeza(p);  // tumia '(' -- anguka katika uchanganuzi wa vigezo
        }
        kama (ni_mabano == 0) {
            // Kigezo cha kimataifa:  n32 jina [= usemi];
            ni_ulimwengu = 1;
            // Hifadhi ukubwa wa safu yakipo: jina[ukubwa]
            n32 ukubwa_wa_safu = 0;
            n32 safu_ilipo = 0;
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "[")) {
                    safu_ilipo = 1;
                    sogeza(p);  // ruka '['
                    kama (p->sasa.urefu > 0) {
                        // Halisi ya herufi kama ukubwa: kataa kwa sauti.
                        kama (p->sasa.mwanzo[0] == 39) {
                            andika_kosa("kosa: halisi ya herufi haijaungwa mkono\n");
                            p->kosa = 1;
                            rudisha -1;
                        }
                        ukubwa_wa_safu = neno_kwa_nambari(p->sasa.mwanzo, p->sasa.urefu);
                        sogeza(p);  // ruka ukubwa
                    }
                    kama (neno_ni(&p->sasa, "]")) { sogeza(p); }  // ruka ']'
                }
            }
            kama (p->sasa.urefu == 1) {
                kama (neno_ni(&p->sasa, "[")) {
                    safu_ilipo = 1;
                    sogeza(p);
                    kama (p->sasa.urefu > 0) {
                        // Halisi ya herufi kama ukubwa: kataa kwa sauti.
                        kama (p->sasa.mwanzo[0] == 39) {
                            andika_kosa("kosa: halisi ya herufi haijaungwa mkono\n");
                            p->kosa = 1;
                            rudisha -1;
                        }
                        ukubwa_wa_safu = neno_kwa_nambari(p->sasa.mwanzo, p->sasa.urefu);
                        sogeza(p);
                    }
                    kama (neno_ni(&p->sasa, "]")) { sogeza(p); }
                }
            }
            n32 kianzio = -1;
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "=")) {
                    // Safu + kianzilishi si katika hati 6.1; kukubali kimya
                    // kunatupa kianzilishi. Kataa kwa sauti, sawa na awali.
                    kama (safu_ilipo != 0) {
                        andika_kosa("kosa: kianzilishi cha safu hakijaungwa mkono\n");
                        p->kosa = 1;
                        rudisha -1;
                    }
                    sogeza(p); kunja_imezuiwa = 1; kianzio = changanua_usemi(p); kunja_imezuiwa = 0;
                }
            }
            kama (p->sasa.urefu == 1) {
                kama (neno_ni(&p->sasa, "=")) {
                    // Safu + kianzilishi si katika hati 6.1; kukubali kimya
                    // kunatupa kianzilishi. Kataa kwa sauti, sawa na awali.
                    kama (safu_ilipo != 0) {
                        andika_kosa("kosa: kianzilishi cha safu hakijaungwa mkono\n");
                        p->kosa = 1;
                        rudisha -1;
                    }
                    sogeza(p); kunja_imezuiwa = 1; kianzio = changanua_usemi(p); kunja_imezuiwa = 0;
                }
            }
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            kama (p->sasa.urefu == 1) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            nodi_ya_ulimwengu = nodi_mpya(NODI_TANGAZO_ULIMWENGU, aina_ya_matokeo, nodi_ya_jina, kianzio);
            // Hifadhi ukubwa wa safu (kama ipo) kwenye ast_tiga
            kama (ukubwa_wa_safu > 0) {
                n32 nodi_ya_ukubwa = nodi_mpya(NODI_NAMBARI, ukubwa_wa_safu, -1, -1);
                tatu_ya_nodi[nodi_ya_ulimwengu] = nodi_ya_ukubwa;
            }
        }
    }
    kama (ni_ulimwengu) { rudisha nodi_ya_ulimwengu; }
    // --------------------------------------------------
    // MWISHO WA FIX -- utekelezaji unafika hapa kwa kazi pekee
    // --------------------------------------------------

    n32 vigezo = changanua_kazi_vigezo(p);

    // Tangazo la mbele linaishia kwa ';' baada ya vigezo;
    // maudhui yanapo tu kama '{' inafuata mara moja.
    n32 maudhui = -1;
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, "{")) {
            sogeza(p);
            maudhui = changanua_maudhui_ya_kazi(p);
        }
    }

    // Tangazo la mbele: body == -1 inamaanisha hakuna '{' iliyopatikana.
    // Tumia ';' inayofuata ili isivuje kwenye kiwango cha juu.
    kazi_mbele_ilifungwa = 0;
    kama (maudhui == -1) {
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, ";")) { sogeza(p); kazi_mbele_ilifungwa = 1; }
        }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ";")) { sogeza(p); kazi_mbele_ilifungwa = 1; }
    }

    n32 kazi_hii = nodi_mpya(NODI_KAZI, aina_ya_matokeo, nodi_ya_jina, vigezo);
    tatu_ya_nodi[kazi_hii] = maudhui;
    kama (vigezo != -1) { nodi_ya_kulia[nodi_ya_jina] = vigezo; }
    rudisha kazi_hii;
}

// ==========================================================
// MCHANUZI WA MUUNDO
// ==========================================================
// Akiba ya ukubwa wa miundo iliyokamilika (inajazwa na changanua_muundo).
// Ukubwa huu LAZIMA uendane na muundo_nodes[] kwenye mkaguzi.swa --
// zote mbili ni akiba za "miundo yote iliyofafanuliwa kwenye graph"
// na zote mbili zilizuiliwa mradi kwenye lugha-swa/swa#189 (hii
// ilikuwa na kikomo cha 64, mkaguzi.swa ilikuwa na kikomo cha 32,
// vyote viwili vidogo sana kwa mradi halisi). Muundo usiopatikana
// kwenye akiba hii hutambuliwa VIBAYA kama SI jina la aina (angalia
// ni_jina_la_aina chini) na ukubwa wake hurudi 4 (chaguo-msingi
// kimya) badala ya ukubwa wake halisi.
n8* jina_la_ukubwa_wa_muundo[1024];
n32 thamani_ya_ukubwa_wa_muundo[1024];
n32 idadi_ya_ukubwa_wa_muundo = 0;

// Majina YOTE ya miundo kwenye chanzo, yaliyokusanywa KABLA ya
// uchanganuzi (kusanya_majina_ya_miundo). Akiba ya ukubwa hapo juu
// hujazwa tu muundo unapokamilika -- haitoshi kwa jina la herufi
// ndogo linalotumika kabla ya ufafanuzi wake (wito wa mbele, au
// "nodi* ijayo;" ndani ya muundo nodi wenyewe). Jina la herufi
// kubwa halihitaji hii: ni_aina_tokeni hulikubali kwa herufi yake
// ya kwanza tu (#285). Vielekezi ni ndani ya chanzo chenyewe.
n8* muundo_jina_awali_mwanzo[1024];
n32 muundo_jina_awali_urefu[1024];
n32 muundo_jina_awali_idadi = 0;

n32 ni_jina_la_muundo_awali(Tokeni* t) {
    n32 mi = 0;
    wakati (mi < muundo_jina_awali_idadi) {
        kama (muundo_jina_awali_urefu[mi] == t->urefu) {
            n8* mj = muundo_jina_awali_mwanzo[mi];
            n32 j = 0;
            wakati (j < t->urefu && mj[j] == t->mwanzo[j]) { j = j + 1; }
            kama (j == t->urefu) { rudisha 1; }
        }
        mi = mi + 1;
    }
    rudisha 0;
}

// Pita chanzo chote mara moja kwa msomaji (hauna athari za pembeni)
// ukisajili kila "muundo <jina>", kisha rejesha hali ya msambazaji.
// Neno muhimu baada ya "muundo" (mf. "muundo sivyo") HALISAJILIWI --
// changanua_muundo hulikataa kwa sauti baadaye; likisajiliwa lingekuwa
// "aina" kila mahali na kuvuruga uchanganuzi wa taarifa.
w0 kusanya_majina_ya_miundo(Msambazaji* p) {
    n64 nafasi_iliyohifadhiwa = p->msomaji.nafasi;
    n32 mstari_uliohifadhiwa = p->msomaji.mstari;
    n32 safu_iliyohifadhiwa = p->msomaji.safu;
    Tokeni sasa_iliyohifadhiwa;
    sasa_iliyohifadhiwa.aina = p->sasa.aina;
    sasa_iliyohifadhiwa.mwanzo = p->sasa.mwanzo;
    sasa_iliyohifadhiwa.urefu = p->sasa.urefu;
    sasa_iliyohifadhiwa.mstari = p->sasa.mstari;
    sasa_iliyohifadhiwa.safu = p->sasa.safu;
    Tokeni ifuatayo_iliyohifadhiwa;
    ifuatayo_iliyohifadhiwa.aina = p->inayofuata.aina;
    ifuatayo_iliyohifadhiwa.mwanzo = p->inayofuata.mwanzo;
    ifuatayo_iliyohifadhiwa.urefu = p->inayofuata.urefu;
    ifuatayo_iliyohifadhiwa.mstari = p->inayofuata.mstari;
    ifuatayo_iliyohifadhiwa.safu = p->inayofuata.safu;
    wakati (p->sasa.urefu != 0) {
        kama (neno_ni(&p->sasa, "muundo") && p->inayofuata.aina == TOKENI_KITAMBULISHO) {
            kama (tokeni_ni_muhimu(&p->inayofuata) == 0 && muundo_jina_awali_idadi < 1024) {
                muundo_jina_awali_mwanzo[muundo_jina_awali_idadi] = p->inayofuata.mwanzo;
                muundo_jina_awali_urefu[muundo_jina_awali_idadi] = p->inayofuata.urefu;
                muundo_jina_awali_idadi = muundo_jina_awali_idadi + 1;
            }
        }
        sogeza(p);
    }
    p->msomaji.nafasi = nafasi_iliyohifadhiwa;
    p->msomaji.mstari = mstari_uliohifadhiwa;
    p->msomaji.safu = safu_iliyohifadhiwa;
    p->sasa = sasa_iliyohifadhiwa;
    p->inayofuata = ifuatayo_iliyohifadhiwa;
}

// Tafuta ukubwa wa muundo uliotangazwa tayari (kutoka akiba)
n32 ukubwa_wa_muundo_msambazaji(n8* jina) {
    n32 mi = 0;
    wakati (mi < idadi_ya_ukubwa_wa_muundo) {
        kama (jina_linganisha(jina_la_ukubwa_wa_muundo[mi], jina)) { rudisha thamani_ya_ukubwa_wa_muundo[mi]; }
        mi = mi + 1;
    }
    rudisha 4;  // chaguo-msingi kama haijulikani
}

n32 changanua_muundo(Msambazaji* p) {
    sogeza(p);  // tumia neno kuu 'muundo'

    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        p->kosa = 1;
        n32 fika = ruka_hadi_kifikisha(p);
        kama (fika == 1) { sogeza(p); }  // tumia ';', rudi kwa mchanganuzi wa kiwango cha juu
        rudisha -1;
    }

    // Neno muhimu kama jina la muundo -- kosa la sauti (hati 2.2)
    kama (kataa_neno_muhimu(p)) { rudisha -1; }

    // Jina la aina ya msingi kama jina la muundo (#215). Zamani
    // "muundo n32 { ... }" ilipita kimya, lakini muundo huo haukuweza
    // kufikiwa kamwe: kila mahali jina la aina linasomwa (ni_aina_tokeni,
    // changanua_aina_tokeni, ukubwa()) aina ya msingi hushinda kwanza,
    // hivyo ukubwa(n32) ilirudisha 4 badala ya ukubwa wa muundo. Kipimo
    // ni kile kile ambacho mchanganuzi hutumia kutambua aina ya msingi
    // (herufi ya familia + tarakimu), hivyo jina lolote ambalo
    // mchanganuzi angelisoma kama aina linakataliwa hapa.
    kama (ni_aina_msingi_pia_ndogo(p->sasa.mwanzo, p->sasa.urefu)) {
        n8 aina_ya_chombo[64];
        n32 bi = 0;
        wakati (bi < p->sasa.urefu && bi < 63) {
            aina_ya_chombo[bi] = p->sasa.mwanzo[bi];
            bi = bi + 1;
        }
        aina_ya_chombo[bi] = 0;
        andika_kosa("kosa: '%s' ni jina la aina ya msingi -- haliwezi kutumika kama jina la muundo\n", aina_ya_chombo);
        p->kosa = 1;
        rudisha -1;
    }

    n32 nodi_ya_jina = nodi_mpya(NODI_KITAMBULISHO, 0, -1, -1);
    hifadhi_jina(nodi_ya_jina, p->sasa.mwanzo, p->sasa.urefu);
    sogeza(p);  // tumia jina la muundo

    tarajia(p, TOKENI_ISHARA);  // tarajia '{'

    n32 kwanza_sehemu = -1;
    n32 awali = -1;
    n32 umbali_unaoendelea = 0;

    wakati (1 == 1) {
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "}")) { acha; }
        }
        kama (p->sasa.urefu == 0) { p->kosa = 1; acha; }

        // Ufafanuzi wa aina wa hiari kwenye shamba
        n32 aina_ya_sehemu = 0;
        kama (ni_aina_tokeni(&p->sasa)) {
            aina_ya_sehemu = changanua_aina_tokeni(p);
        }

        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            p->kosa = 1;
            n32 fika = ruka_hadi_kifikisha(p);
            kama (fika == 1) { sogeza(p); endelea; }  // tumia ';', jaribu shamba linalofuata
            kama (fika == 2) { acha; }  // '}' -- mzunguko utaiona juu
            acha;  // EOF
        }

        // Neno muhimu kama jina la shamba -- kosa la sauti (hati 2.2)
        kama (kataa_neno_muhimu(p)) { rudisha -1; }

        n32 nodi_ya_jina_la_kazi = nodi_mpya(NODI_KITAMBULISHO, 0, -1, -1);
        hifadhi_jina(nodi_ya_jina_la_kazi, p->sasa.mwanzo, p->sasa.urefu);
        thamani_ya_nodi[nodi_ya_jina_la_kazi] = aina_ya_sehemu;
        tatu_ya_nodi[nodi_ya_jina_la_kazi] = umbali_unaoendelea;  // hifadhi umbali wa baiti
        // Kokotoa ukubwa wa baiti kutoka kwa usimbaji wa aina.
        // Tumia hesabu ya / na % (awali ina hitilafu katika & na >>).
        kama (aina_ya_sehemu < 0) {
            // Sehemu yenye aina ya muundo (usimbaji hasi). Encoding
            // halisi (angalia changanua_aina_tokeni juu, karibu na
            // "rudisha (-((off + 1) * 2)) + mshale;") ni
            // field_aina = -((umbali+1)*2) + mshale, ambapo mshale ni
            // 0 (imepachikwa/embedded), 1 (kielekezi kimoja *),
            // au 3 (kielekezi mara mbili **). HITILAFU ILIYOKUWEPO: hesabu
            // ya awali ilijaribu kupata `off` kwa `((-field_aina)/2)-1`
            // BILA kuondoa `mshale` kwanza -- kwa mashamba ya
            // KIELEKEZI (mshale != 0) hii ilitoa `off` isiyo sahihi
            // (jina halipatikani kwenye dimbwi, ukubwa_wa_muundo_
            // msambazaji hurudi 4 ya chaguo-msingi badala ya baiti 8
            // za kielekezi halisi) -- ikisababisha kila shamba
            // linalofuata kwenye muundo kupata umbali usio sahihi.
            // lugha-swa/swa#182 (udhihirisho wa pili/tatu).
            //
            // Suluhisho: `(-field_aina) % 2 != 0` inatambua kwa
            // uhakika kuwa shamba ni KIELEKEZI (mshale ni 1 au 3,
            // vyote viwili visivyo sawa) -- kielekezi DAIMA ni baiti
            // 8 kwenye x86-64, HAIHITAJI kutafuta ukubwa wa muundo
            // unaoelekezwa kabisa. Ni shamba lililopachikwa KWELI KWELI
            // (mshale == 0, `(-field_aina) % 2 == 0`) ndilo linalohitaji
            // kutafuta ukubwa halisi wa muundo huo.
            n32 hasi = 0 - aina_ya_sehemu;
            n32 ni_kielekezi_cha_muundo = hasi % 2;
            kama (ni_kielekezi_cha_muundo != 0) {
                umbali_unaoendelea = umbali_unaoendelea + 8;
            } sivyo {
                n32 umbali_wa_jina_2 = (hasi / 2) - 1;
                umbali_unaoendelea = umbali_unaoendelea + ukubwa_wa_muundo_msambazaji(ghala_la_majina + umbali_wa_jina_2);
            }
        } sivyo { kama (aina_ya_sehemu != 0) {
                n32 mshale_f = aina_ya_sehemu % 2;
                kama (mshale_f == 1) { umbali_unaoendelea = umbali_unaoendelea + 8; }
                sivyo {
                    n32 familia_f = (aina_ya_sehemu / 256) % 256;
                    // Upana halisi: toa familia*256 kwanza
                    n32 upana_f = aina_ya_sehemu - (aina_ya_sehemu % 2) - (familia_f * 256);
                    kama (familia_f >= 1) { umbali_unaoendelea = umbali_unaoendelea + (upana_f / 8); }
                    sivyo { umbali_unaoendelea = umbali_unaoendelea + 4; }
                }
            } sivyo { umbali_unaoendelea = umbali_unaoendelea + 4; } }
        sogeza(p);  // tumia jina la shamba

        // Semicolon ya hiari inayofuata
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
        }

        n32 f = nodi_mpya(NODI_SEHEMU, 0, nodi_ya_jina_la_kazi, -1);
        kama (awali == -1) { kwanza_sehemu = f; }
        sivyo { nodi_ya_kulia[awali] = f; }
        awali = f;
    }

    sogeza(p);  // tumia '}'

    // Semicolon ya hiari inayofuata baada ya ufafanuzi wa muundo
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
    }

    n32 nodi_ya_muundo_huu = nodi_mpya(NODI_MUUNDO, 0, nodi_ya_jina, kwanza_sehemu);
    // Hifadhi ukubwa wa muundo huu (running_offset ya mwisho)
    thamani_ya_nodi[nodi_ya_muundo_huu] = umbali_unaoendelea;
    kama (idadi_ya_ukubwa_wa_muundo < 1024) {
        jina_la_ukubwa_wa_muundo[idadi_ya_ukubwa_wa_muundo] = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_jina];
        thamani_ya_ukubwa_wa_muundo[idadi_ya_ukubwa_wa_muundo] = umbali_unaoendelea;
        idadi_ya_ukubwa_wa_muundo = idadi_ya_ukubwa_wa_muundo + 1;
    } sivyo {
        // lugha-swa/swa#298 -- muundo huu (na kila mmoja unaofuata)
        // ungekosa ukubwa wake kimya -- ukubwa_kutoka_enc ingerudi
        // 0 kwa struct hii, ikivuruga umbali wa sehemu na ukubwa wa
        // tenga() bila hitilafu yoyote ya kukusanya.
        andika_kosa("KOSA: akiba ya ukubwa wa miundo (muundo_ukubwa_jina/val) imejaa (kikomo 1024) -- muundo '%s' na zinazofuata hazitapata ukubwa sahihi\n", ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_jina]);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    rudisha nodi_ya_muundo_huu;
}

// ==========================================================
// UGAWA WA KIWANGO CHA JUU
// ==========================================================
n32 changanua(Msambazaji* p) {
    n32 kwanza = -1;
    n32 awali = -1;
    n32 alishalia = 0;  // kosa la tamko limeshatajwa kwa mfululizo huu
    kusanya_majina_ya_miundo(p);

    wakati (p->sasa.urefu != 0) {
        n32 nodi_hii = -1;

        // Ruka maelekezo ya husisha (mistari ya kichakata-awali -- ruka mstari mzima)
        kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
            kama (neno_ni(&p->sasa, "husisha")) {
                n32 mstari_husisha = p->sasa.mstari;
                sogeza(p);  // tumia neno kuu "husisha"
                // Ruka tokeni zote kwenye mstari huo huo
                wakati (p->sasa.urefu != 0 && p->sasa.mstari == mstari_husisha) {
                    sogeza(p);
                }
                endelea;
            }
        }

        // Kiolesura cha mashine: nje "<maktaba>" { <matangazo ya kazi> }
        // (hati/kiolesura-cha-mashine.md). `nje` si neno muhimu -- linatambuliwa
        // hapa tu, likifuatiwa na mfuatano, hivyo `n8* nje` kama kigeu
        // linaendelea kufanya kazi.
        n32 ni_nje = 0;
        kama (p->sasa.urefu == 3 && p->inayofuata.aina == TOKENI_MFUATANO) {
            kama (neno_ni(&p->sasa, "nje")) {
                ni_nje = 1;
                nodi_hii = changanua_nje(p);
                kama (nodi_hii == -1) { p->kosa = 1; alishalia = 1; }
            }
        }

        // Jaribu tangazo la muundo
        kama (ni_nje == 0 && p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
            kama (neno_ni(&p->sasa, "muundo")) {
                nodi_hii = changanua_muundo(p);
            }
        }

        // Jaribu kazi (pia hushughulikia vigezo vya kimataifa, shukrani kwa fix)
        kama (nodi_hii == -1 && ni_nje == 0) {
            nodi_hii = changanua_kazi(p);
        }

        // Kama hakuna kilicholingana, weka kosa lakini endelea
        // (kurejesha-hitilafu: badala ya kukoma, ruka na uchukue mengine)
        kama (nodi_hii == -1) {
            kama (p->sasa.urefu != 0) {
                // Taja tokeni ya KWANZA ya mfululizo usiotambulika (si kila
                // tokeni inayorukwa) -- bila hili kosa lilikuwa "; KOSA: 1"
                // tu, bila mahali wala sababu. Kama kosa mahususi limeshatajwa
                // (p->kosa tayari), tokeni zinazofuata ni mwangwi wake tu.
                kama (alishalia == 0 && p->kosa == 0) {
                    n8 chombo_cha_tamko[64];
                    n32 bi = 0;
                    wakati (bi < p->sasa.urefu && bi < 63) {
                        chombo_cha_tamko[bi] = p->sasa.mwanzo[bi];
                        bi = bi + 1;
                    }
                    chombo_cha_tamko[bi] = 0;
                    n32 mstari_tamko = p->sasa.mstari;
                    andika_kosa("kosa: mstari %d: tamko la ngazi ya juu halitambuliki, kuanzia '%s'\n", mstari_tamko, chombo_cha_tamko);
                    alishalia = 1;
                }
                p->kosa = 1;  // alama kwamba mchanganuo ulishindwa
                sogeza(p);  // ruka tokeni lisilotambulika
                endelea;  // endelea kutafuta makosa zaidi
            }
            acha;  // EOF
        }
        alishalia = 0;

        kama (awali == -1) { kwanza = nodi_hii; }
        sivyo { nne_ya_nodi[awali] = nodi_hii; }
        awali = nodi_hii;
        // Kizuizi cha nje hurudisha mfululizo wa kazi; endelea kutoka ya mwisho
        kama (ni_nje) { awali = kigeni_nodi_ya_mwisho; }
    }

    rudisha nodi_mpya(NODI_PROGRAMU, 0, kwanza, -1);
}

// ==========================================================
// DARAJA LA MASHINE: kazi za nje (hati/kiolesura-cha-mashine.md)
// ==========================================================
// Kila kazi ya nje ni AST_KAZI isiyo na maudhui (kama tangazo la mbele),
// iliyosajiliwa hapa pamoja na maktaba yake na alama yake (jina lao).
// Uzalishaji huiandikia kipande cha wito na ELF ya kiungo-hai.
n8 kigeni_ghala[65536];
n32 kigeni_ghala_wapi = 1;
n32 kigeni_maktaba_umbali[64];
n32 kigeni_maktaba_idadi = 0;
n32 kigeni_nodi_ya_kazi[1024];
n32 kigeni_umbali_wa_alama_ya_kazi[1024];
n32 kigeni_kazi_maktaba[1024];
n32 kigeni_kazi_ya_ziada[1024];   // 1 = ina `...`
n32 kigeni_idadi_ya_kazi = 0;
n32 kigeni_nodi_ya_mwisho = -1;

// Faharisi ya kazi ya nje yenye jina la Swa `jina`, au -1.
n32 kigeni_kazi_kwa_jina(n8* jina) {
    n32 i = 0;
    wakati (i < kigeni_idadi_ya_kazi) {
        kama (jina_linganisha(ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kushoto[kigeni_nodi_ya_kazi[i]]], jina)) { rudisha i; }
        i = i + 1;
    }
    rudisha -1;
}

// Nakili baiti `urefu` kuanzia `mwanzo` kwenye kigeni_pool (na 0 mwishoni).
// Rudisha umbali, au -1 dimbwi likijaa.
n32 kigeni_hifadhi(n8* mwanzo, n64 urefu) {
    kama (kigeni_ghala_wapi + urefu + 1 >= 65536) {
        andika_kosa("kosa: majina ya nje yamejaa (kikomo baiti 65536)\n");
        rudisha -1;
    }
    n32 umbali = kigeni_ghala_wapi;
    n64 i = 0;
    wakati (i < urefu) {
        kigeni_ghala[kigeni_ghala_wapi] = mwanzo[i];
        kigeni_ghala_wapi = kigeni_ghala_wapi + 1;
        i = i + 1;
    }
    kigeni_ghala[kigeni_ghala_wapi] = 0;
    kigeni_ghala_wapi = kigeni_ghala_wapi + 1;
    rudisha umbali;
}

// Mfuatano wa tokeni bila alama za kunukuu. Majina ya maktaba na alama
// ni maandishi halisi: '\' inakataliwa kwa sauti, kama mfuatano mtupu.
n32 kigeni_hifadhi_mfuatano(Msambazaji* p) {
    Tokeni* t = &p->sasa;
    kama (t->urefu < 3) {
        andika_kosa("kosa: mstari %d: jina la nje haliwezi kuwa mfuatano mtupu\n", t->mstari);
        rudisha -1;
    }
    n64 i = 1;
    wakati (i < t->urefu - 1) {
        kama (t->mwanzo[i] == 92) {
            andika_kosa("kosa: mstari %d: jina la nje haliwezi kuwa na mkwaju wa nyuma\n", t->mstari);
            rudisha -1;
        }
        i = i + 1;
    }
    rudisha kigeni_hifadhi(t->mwanzo + 1, t->urefu - 2);
}

// Data ya maktaba (mf. stdout, optind): kigezo cha ulimwengu cha Swa
// ambacho kipakiaji hukijaza kwa nakala ya thamani yake (R_X86_64_COPY),
// na maktaba zenyewe hutumia nakala hiyo. Kianzio cha mfuatano ni jina
// la alama, si thamani -- kinabadilishwa kuwa 0 ili kigezo kikae .data.
n32 kigeni_nodi_ya_data[256];
n32 kigeni_umbali_wa_alama_ya_data[256];
n32 kigeni_idadi_ya_data = 0;

n32 kigeni_ongeza_data(n32 g, n32 maktaba, n32 mstari) {
    n32 jina_la_nodi = nodi_ya_kushoto[g];
    n8* jina_swa = ghala_la_majina + umbali_wa_jina_la_nodi[jina_la_nodi];
    kama (kigeni_idadi_ya_data >= 256) {
        andika_kosa("kosa: mstari %d: data ya nje imezidi kikomo (256)\n", mstari);
        rudisha -1;
    }
    kama (tatu_ya_nodi[g] != -1) {
        andika_kosa("kosa: mstari %d: data ya nje '%s': safu haijaungwa mkono -- tumia kielekezi\n", mstari, jina_swa);
        rudisha -1;
    }
    // Namba, kielekezi au muundo (awamu 3): kianzio chake kinakuwa 0 --
    // baiti sifuri za ukubwa wake kwenye .data, ambazo kipakiaji huziandika
    // upya. Desimali ingehitaji umbo jingine la kianzio.
    n32 usimbaji = thamani_ya_nodi[g];
    kama (usimbaji > 0 && (usimbaji / 256) % 256 == 3 && (usimbaji / 2) * 2 == usimbaji) {
        andika_kosa("kosa: mstari %d: data ya nje '%s': desimali haijaungwa mkono -- tumia kielekezi\n", mstari, jina_swa);
        rudisha -1;
    }
    n32 alama = -1;
    n32 kianzio = nodi_ya_kulia[g];
    kama (kianzio == -1) {
        n64 urefu_swa = 0;
        wakati (jina_swa[urefu_swa] != 0) { urefu_swa = urefu_swa + 1; }
        alama = kigeni_hifadhi(jina_swa, urefu_swa);
    } sivyo {
        n8* maandishi = ghala_la_majina + umbali_wa_jina_la_nodi[kianzio];
        kama (aina_ya_nodi[kianzio] != NODI_KITAMBULISHO || maandishi[0] != 34) {
            andika_kosa("kosa: mstari %d: data ya nje '%s': baada ya '=' kunatarajiwa jina la alama kama mfuatano\n", mstari, jina_swa);
            rudisha -1;
        }
        n64 urefu_m = 0;
        wakati (maandishi[urefu_m] != 0) { urefu_m = urefu_m + 1; }
        kama (urefu_m < 3) {
            andika_kosa("kosa: mstari %d: jina la nje haliwezi kuwa mfuatano mtupu\n", mstari);
            rudisha -1;
        }
        alama = kigeni_hifadhi(maandishi + 1, urefu_m - 2);
    }
    kama (alama < 0) { rudisha -1; }
    nodi_ya_kulia[g] = nodi_mpya(NODI_NAMBARI, 0, -1, -1);
    kigeni_nodi_ya_data[kigeni_idadi_ya_data] = g;
    kigeni_umbali_wa_alama_ya_data[kigeni_idadi_ya_data] = alama;
    kigeni_idadi_ya_data = kigeni_idadi_ya_data + 1;
    rudisha 0;
}

// nje "<maktaba>" { <aina> <jina>(<vigezo>) [= "<alama>"]; ... }
// Rudisha kazi ya kwanza ya mfululizo (kigeni_mwisho_node = ya mwisho), au -1.
n32 changanua_nje(Msambazaji* p) {
    n32 mstari_nje = p->sasa.mstari;
    sogeza(p);  // 'nje'
    kama (kigeni_maktaba_idadi >= 64) {
        andika_kosa("kosa: mstari %d: maktaba za nje zimezidi kikomo (64)\n", mstari_nje);
        rudisha -1;
    }
    n32 maktaba = kigeni_maktaba_idadi;
    n32 jina_maktaba = kigeni_hifadhi_mfuatano(p);
    kama (jina_maktaba < 0) { rudisha -1; }
    kigeni_maktaba_umbali[maktaba] = jina_maktaba;
    kigeni_maktaba_idadi = kigeni_maktaba_idadi + 1;
    sogeza(p);  // jina la maktaba
    kama (neno_ni(&p->sasa, "{") == 0) {
        andika_kosa("kosa: mstari %d: '{' inatarajiwa baada ya jina la maktaba ya nje\n", p->sasa.mstari);
        rudisha -1;
    }
    sogeza(p);

    n32 kwanza = -1;
    n32 iliyopita = -1;
    wakati (p->sasa.urefu != 0 && neno_ni(&p->sasa, "}") == 0) {
        n32 mstari_kazi = p->sasa.mstari;
        ndani_ya_nje = 1;
        n32 f = changanua_kazi(p);
        ndani_ya_nje = 0;
        kama (f == -1) {
            andika_kosa("kosa: mstari %d: ndani ya nje kunatarajiwa tangazo la kazi\n", mstari_kazi);
            rudisha -1;
        }
        // Kigezo cha data cha maktaba: <aina> <jina> [= "<alama>"];
        kama (aina_ya_nodi[f] == NODI_TANGAZO_ULIMWENGU) {
            kama (kigeni_ongeza_data(f, maktaba, mstari_kazi) < 0) { rudisha -1; }
            kama (iliyopita == -1) { kwanza = f; }
            sivyo { nne_ya_nodi[iliyopita] = f; }
            iliyopita = f;
            endelea;
        }
        kama (aina_ya_nodi[f] != NODI_KAZI || tatu_ya_nodi[f] != -1) {
            andika_kosa("kosa: mstari %d: ndani ya nje ni matangazo ya kazi na vigezo vya data pekee, bila maudhui\n", mstari_kazi);
            rudisha -1;
        }
        kama (kigeni_idadi_ya_kazi >= 1024) {
            andika_kosa("kosa: mstari %d: kazi za nje zimezidi kikomo (1024)\n", mstari_kazi);
            rudisha -1;
        }
        n32 alama = -1;
        kama (kazi_mbele_ilifungwa == 0 && neno_ni(&p->sasa, "=")) {
            sogeza(p);
            kama (p->sasa.aina != TOKENI_MFUATANO) {
                andika_kosa("kosa: mstari %d: baada ya '=' kunatarajiwa jina la alama kama mfuatano\n", p->sasa.mstari);
                rudisha -1;
            }
            alama = kigeni_hifadhi_mfuatano(p);
            sogeza(p);
        } sivyo {
            n8* jina_swa = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kushoto[f]];
            n64 urefu_swa = 0;
            wakati (jina_swa[urefu_swa] != 0) { urefu_swa = urefu_swa + 1; }
            alama = kigeni_hifadhi(jina_swa, urefu_swa);
        }
        kama (alama < 0) { rudisha -1; }
        // Bila '=', changanua_kazi tayari imetumia ';' ya tangazo la mbele.
        kama (kazi_mbele_ilifungwa == 0) {
            kama (neno_ni(&p->sasa, ";") == 0) {
                andika_kosa("kosa: mstari %d: ';' inatarajiwa mwishoni mwa tangazo la kazi ya nje\n", mstari_kazi);
                rudisha -1;
            }
            sogeza(p);
        }

        kigeni_kazi_ya_ziada[kigeni_idadi_ya_kazi] = vigezo_vya_ziada;
        kigeni_nodi_ya_kazi[kigeni_idadi_ya_kazi] = f;
        kigeni_umbali_wa_alama_ya_kazi[kigeni_idadi_ya_kazi] = alama;
        kigeni_kazi_maktaba[kigeni_idadi_ya_kazi] = maktaba;
        kigeni_idadi_ya_kazi = kigeni_idadi_ya_kazi + 1;

        kama (iliyopita == -1) { kwanza = f; }
        sivyo { nne_ya_nodi[iliyopita] = f; }
        iliyopita = f;
    }
    kama (neno_ni(&p->sasa, "}") == 0) {
        andika_kosa("kosa: mstari %d: kizuizi cha nje hakijafungwa kwa '}'\n", mstari_nje);
        rudisha -1;
    }
    sogeza(p);
    kama (kwanza == -1) {
        andika_kosa("kosa: mstari %d: kizuizi cha nje hakina kazi wala data yoyote\n", mstari_nje);
        rudisha -1;
    }
    kigeni_nodi_ya_mwisho = iliyopita;
    rudisha kwanza;
}

// ============================================================
// KUUNGANISHA KAZI NDOGO (kazi inlining), awamu ya 1
// ============================================================
//
// Badala ya wito wa kweli (call/ret), nakala ya maudhui ya kazi
// inasukwa moja kwa moja kwenye tovuti ya wito -- inaondoa gharama
// ya wito/kurudi KABISA kwa kazi ndogo, na inaruhusu pitio za
// ugawaji wa rejesta/kukunja mara kwa mara zilizopo tayari kuona
// zaidi ya mpaka wa zamani wa wito.
//
// WIGO (kwa makusudi mdogo sana -- soma kila sharti kwa makini,
// kila moja linaepuka hatari halisi ya usahihi, si urahisi tu):
//
//   Kazi F inaweza kuunganishwa TU ikiwa YOTE ni kweli:
//   1. F HAINA tangazo la kigezo cha ndani KABISA (hakuna AST_TANGAZO
//      popote ndani ya maudhui) -- kuepuka hitaji la kubadilisha
//      majina ya vigezo vya ndani (jina la PEKEE linalohitaji
//      kubadilishwa ni jina la paramu).
//   2. F HAINA mzunguko (AST_WAKATI), tawi la masharti (AST_KAMA), wala
//      chagua (AST_CHAGUA) popote ndani ya maudhui -- F ni MSTARI ULIONYOOKA
//      TU (sequence ya taarifa moja baada ya nyingine, bila tawi
//      lolote). Hii inaepuka utata mkubwa wa kuiga miundo ya mahali/
//      udhibiti wa mtiririko wakati wa kusuka.
//   3. F HAIJIITI YENYEWE (moja kwa moja) popote ndani ya maudhui --
//      kuepuka urudiaji usio na kikomo wa kuunganisha.
//   4. F ina taarifa zisizozidi INL_KIKOMO_TAARIFA katika ngazi ya juu.
//   5. F ina aina ya kurudi w0 (haina thamani), na "rudisha" (kama
//      ipo) ni "rudisha;" TUPU pekee, ikiwa taarifa ya MWISHO -- hii
//      inaepuka KABISA hitaji la kushughulikia thamani ya kurudi ya
//      kiwanja (kazi inayorudisha thamani si mgombea wa awamu hii,
//      imeachwa kwa awamu ijayo kwa makusudi).
//   6. Paramu zote za F zina aina isiyokuwa muundo (usimbaji > 0) na si
//      zaidi ya 6 kwa jumla.
//
//   Tovuti ya wito nayo lazima iwe TAARIFA YA NGAZI YA JUU ya kazi
//   inayoita (si iliyopachikwa ndani ya kama/wakati ya mzazi) --
//   ulinganifu na sharti la 2 hapo juu upande wa F: pande zote mbili
//   (mwito na anayeitwa) ni mstari ulionyooka tu kwa awamu hii.
//
// HOJA ZA WITO: kila hoja inatathminiwa MARA MOJA TU, kwenye tangazo
// jipya la kigezo cha muda, KABLA ya maudhui ya F kuanza -- HAIWAHI
// kubadilishwa moja kwa moja (textual substitution) ndani ya maudhui,
// kwa sababu hilo lingesababisha hoja yenye athari ya kando
// (mfano wito wa kazi nyingine) kutathminiwa MARA NYINGI kama
// ikitumika zaidi ya mara moja ndani ya F. Tangazo za vigezo vya
// muda zinaundwa KWA MPANGILIO WA KINYUME cha paramu (paramu ya
// MWISHO kwanza) ili mpangilio HALISI wa utathmini ubaki
// kulia-kabla-ya-kushoto -- sawa na jinsi mkusanyaji huu MZIMA
// tayari unavyotathmini usemi wa binari (angalia uzalishaji_jumlisha
// na wenzake, na jinsi #232 ilivyokuwa ikitegemea mpangilio huu).

n32 PACHIKA_KIKOMO_TAARIFA = 6;
n32 PACHIKA_W0_USIMBAJI = 1280;  // encode_aina(familia=5 [W], upana=0, mshale=0)

n32 pachika_urefu_wa_jina(n8* s) {
    n32 i = 0;
    wakati (s[i] != 0) { i = i + 1; }
    rudisha i;
}

n32 pachika_jina_sawa(n8* a, n8* b) {
    n32 i = 0;
    wakati (1 == 1) {
        kama (a[i] != b[i]) { rudisha 0; }
        kama (a[i] == 0) { rudisha 1; }
        i = i + 1;
    }
}

// -------- Usajili wa kazi (jina -> nodi ya AST_KAZI) --------
n32 pachika_idadi_ya_sajili = 0;
n8* pachika_jina_la_sajili[512];
n32 pachika_nodi_ya_sajili[512];

w0 pachika_jaza_sajili(n32 nodi_ya_programu) {
    pachika_idadi_ya_sajili = 0;
    n32 nodi_hii = nodi_ya_kushoto[nodi_ya_programu];
    wakati (nodi_hii != -1) {
        kama (aina_ya_nodi[nodi_hii] == NODI_KAZI) {
            kama (tatu_ya_nodi[nodi_hii] != -1) {
                kama (pachika_idadi_ya_sajili < 512) {
                    n32 nodi_ya_jina = nodi_ya_kushoto[nodi_hii];
                    pachika_jina_la_sajili[pachika_idadi_ya_sajili] = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_jina];
                    pachika_nodi_ya_sajili[pachika_idadi_ya_sajili] = nodi_hii;
                    pachika_idadi_ya_sajili = pachika_idadi_ya_sajili + 1;
                }
            }
        }
        nodi_hii = nne_ya_nodi[nodi_hii];
    }
}

n32 pachika_tafuta_kazi(n8* jina) {
    n32 i = 0;
    wakati (i < pachika_idadi_ya_sajili) {
        kama (pachika_jina_sawa(pachika_jina_la_sajili[i], jina)) { rudisha pachika_nodi_ya_sajili[i]; }
        i = i + 1;
    }
    rudisha -1;
}

// -------- Uchunguzi wa ustahiki (eligibility scan) --------
// Hutembea maudhui yote (ikifuata ast_nne kama sehemu ya utembeaji
// wake wenyewe -- mwitaji anahitaji kuita mara MOJA TU kwenye
// taarifa ya kwanza). Huweka bendera za kimataifa badala ya
// kurudisha thamani, kwa sababu tunahitaji majibu matatu tofauti
// (ovyo, kujiita) kutoka pitio moja.
n32 pachika_chunguza_ovyo = 0;
n8* pachika_chunguza_jina_msingi = 0;
n32 pachika_chunguza_kujiita = 0;
n8* pachika_chunguza_kigezo_jina[6];
n32 pachika_chunguza_kigezo_idadi = 0;

n32 pachika_chunguza_ni_kigezo(n8* jina) {
    n32 i = 0;
    wakati (i < pachika_chunguza_kigezo_idadi) {
        kama (pachika_jina_sawa(jina, pachika_chunguza_kigezo_jina[i])) { rudisha 1; }
        i = i + 1;
    }
    rudisha 0;
}

w0 pachika_chunguza(n32 nodi_hii) {
    kama (nodi_hii < 0) { rudisha; }
    n32 aina = aina_ya_nodi[nodi_hii];
    kama (aina == NODI_TANGAZO) { pachika_chunguza_ovyo = 1; rudisha; }
    kama (aina == NODI_WAKATI) { pachika_chunguza_ovyo = 1; rudisha; }
    kama (aina == NODI_KAMA) { pachika_chunguza_ovyo = 1; rudisha; }
    kama (aina == NODI_CHAGUA) { pachika_chunguza_ovyo = 1; rudisha; }
    kama (aina == NODI_RUDISHA) {
        kama (nodi_ya_kushoto[nodi_hii] != -1) { pachika_chunguza_ovyo = 1; }
        kama (nne_ya_nodi[nodi_hii] != -1) { pachika_chunguza_ovyo = 1; }
        pachika_chunguza(nodi_ya_kushoto[nodi_hii]);
        pachika_chunguza(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == NODI_WITO) {
        n32 mwitwa = nodi_ya_kushoto[nodi_hii];
        kama (mwitwa != -1) {
            kama (aina_ya_nodi[mwitwa] == NODI_KITAMBULISHO) {
                n8* cjina = ghala_la_majina + umbali_wa_jina_la_nodi[mwitwa];
                kama (pachika_jina_sawa(cjina, pachika_chunguza_jina_msingi)) { pachika_chunguza_kujiita = 1; }
            }
        }
        n32 a = nodi_ya_kulia[nodi_hii];
        wakati (a != -1) {
            pachika_chunguza(a);
            a = tatu_ya_nodi[a];
        }
        pachika_chunguza(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == NODI_UBETI) {
        pachika_chunguza(nodi_ya_kushoto[nodi_hii]);
        pachika_chunguza(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == NODI_NAMBARI || aina == NODI_HALISI_D || aina == NODI_MFUATANO) {
        pachika_chunguza(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == NODI_KITAMBULISHO) {
        // Marejeleo ya thamani (SI nafasi ya mwito -- hiyo inashughulikiwa
        // na tawi la AST_WITO juu bila kupitia hapa). F yenye ustahiki
        // lazima igusi PARAMU ZAKE PEKEE -- kigezo cha ulimwengu (ya ulimwengu)
        // chochote kinachoguswa moja kwa moja kinafanya F kutostahili,
        // kuepuka hatari ya "kunasa" jina hilo hilo la kigezo cha ndani
        // cha mwitaji baada ya kusukwa (tatizo la classic la "hygiene"
        // katika upanuzi wa inline: bila kizuizi hiki, kigezo cha
        // ulimwengu kilichotajwa na F kingeweza kufasiriwa vibaya kama
        // kigezo cha ndani cha mwitaji ikiwa majina yanafanana kwa bahati).
        n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_hii];
        kama (pachika_chunguza_ni_kigezo(jina) == 0) { pachika_chunguza_ovyo = 1; }
        pachika_chunguza(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    // Kesi ya jumla (usemi wa binari, ugawaji, n.k.)
    pachika_chunguza(nodi_ya_kushoto[nodi_hii]);
    pachika_chunguza(nodi_ya_kulia[nodi_hii]);
    pachika_chunguza(nne_ya_nodi[nodi_hii]);
}

n32 pachika_hesabu_taarifa(n32 maudhui) {
    n32 n = 0;
    n32 nodi_hii = maudhui;
    wakati (nodi_hii != -1) {
        n = n + 1;
        nodi_hii = nne_ya_nodi[nodi_hii];
    }
    rudisha n;
}

n32 pachika_mgombea(n32 nodi_ya_kazi) {
    n32 aina_ya_matokeo = thamani_ya_nodi[nodi_ya_kazi];
    kama (aina_ya_matokeo != PACHIKA_W0_USIMBAJI) { rudisha 0; }

    n32 maudhui = tatu_ya_nodi[nodi_ya_kazi];
    kama (maudhui == -1) { rudisha 0; }

    n32 pn = nodi_ya_kulia[nodi_ya_kazi];
    n32 idadi_ya_vigezo = 0;
    wakati (pn != -1) {
        kama (thamani_ya_nodi[pn] <= 0) { rudisha 0; }
        kama (idadi_ya_vigezo >= 6) { rudisha 0; }
        pachika_chunguza_kigezo_jina[idadi_ya_vigezo] = ghala_la_majina + umbali_wa_jina_la_nodi[pn];
        idadi_ya_vigezo = idadi_ya_vigezo + 1;
        pn = nodi_ya_kulia[pn];
    }

    kama (pachika_hesabu_taarifa(maudhui) > PACHIKA_KIKOMO_TAARIFA) { rudisha 0; }

    pachika_chunguza_ovyo = 0;
    pachika_chunguza_jina_msingi = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kushoto[nodi_ya_kazi]];
    pachika_chunguza_kujiita = 0;
    pachika_chunguza_kigezo_idadi = idadi_ya_vigezo;
    pachika_chunguza(maudhui);
    kama (pachika_chunguza_ovyo) { rudisha 0; }
    kama (pachika_chunguza_kujiita) { rudisha 0; }

    rudisha 1;
}

// -------- Ramani ya majina (paramu ya asili -> jina jipya la kipekee) --------
// Chombo BAPA (SI safu ya 2D -- lugha haina hilo): nafasi ya i
// inakalia baiti [i*64, i*64+63].
n8 pachika_ramani_zamani[384];  // 6 * 64
n8 pachika_ramani_mpya[384];
n32 pachika_idadi_ya_ramani = 0;

n32 pachika_jina_ni_ramani(n8* jina) {
    n32 i = 0;
    wakati (i < pachika_idadi_ya_ramani) {
        kama (pachika_jina_sawa(jina, pachika_ramani_zamani + (i * 64))) { rudisha i; }
        i = i + 1;
    }
    rudisha -1;
}

// -------- Nakala ya usemi/taarifa yenye ubadilishaji wa majina --------
n32 pachika_nakili(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha -1; }
    n32 aina = aina_ya_nodi[nodi_hii];

    kama (aina == NODI_KITAMBULISHO) {
        n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_hii];
        n32 mi = pachika_jina_ni_ramani(jina);
        n32 nn = nodi_mpya(NODI_KITAMBULISHO, thamani_ya_nodi[nodi_hii], -1, -1);
        kama (nn == -1) { rudisha -1; }
        kama (mi != -1) {
            n8* jj = pachika_ramani_mpya + (mi * 64);
            hifadhi_jina(nn, jj, pachika_urefu_wa_jina(jj));
        } sivyo {
            hifadhi_jina(nn, jina, pachika_urefu_wa_jina(jina));
        }
        rudisha nn;
    }

    kama (aina == NODI_NAMBARI || aina == NODI_HALISI_D) {
        // ast_kulia hapa ni bendera ya dimbwi la n64 kubwa (faharisi
        // ya dimbwi, SI nodi ya AST) -- kuinakili bila kuigusa ni
        // sahihi, dimbwi lenyewe (nje ya safu za ast_*) haligusiki.
        rudisha nodi_mpya(aina, thamani_ya_nodi[nodi_hii], nodi_ya_kushoto[nodi_hii], nodi_ya_kulia[nodi_hii]);
    }

    kama (aina == NODI_WITO) {
        n32 nakala_ya_mwitwa = pachika_nakili(nodi_ya_kushoto[nodi_hii]);
        n32 nn = nodi_mpya(NODI_WITO, thamani_ya_nodi[nodi_hii], nakala_ya_mwitwa, -1);
        kama (nn == -1) { rudisha -1; }
        n32 a = nodi_ya_kulia[nodi_hii];
        n32 kwanza_hoja = -1;
        n32 mwisho_wa_hoja = -1;
        wakati (a != -1) {
            n32 ac = pachika_nakili(a);
            kama (kwanza_hoja == -1) { kwanza_hoja = ac; }
            sivyo { tatu_ya_nodi[mwisho_wa_hoja] = ac; }
            mwisho_wa_hoja = ac;
            a = tatu_ya_nodi[a];
        }
        nodi_ya_kulia[nn] = kwanza_hoja;
        rudisha nn;
    }

    // Kesi ya jumla: usemi wa binary/ugawaji (kushoto/kulia pekee,
    // si tiga/nne -- hizo ni maalum kwa muktadha wa mfululizo wa
    // taarifa, zinashughulikiwa na inl_nakili_taarifa).
    n32 kn = pachika_nakili(nodi_ya_kushoto[nodi_hii]);
    n32 kl = pachika_nakili(nodi_ya_kulia[nodi_hii]);
    rudisha nodi_mpya(aina, thamani_ya_nodi[nodi_hii], kn, kl);
}

n32 pachika_nakili_taarifa(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha -1; }
    n32 aina = aina_ya_nodi[nodi_hii];
    kama (aina == NODI_RUDISHA) { rudisha -1; }  // rudisha; tupu -- imeachwa (F inaendelea kuanguka)
    kama (aina == NODI_UBETI) { rudisha -1; }  // maudhui matupu -- hakuna cha kunakili
    kama (aina == NODI_WITO) { rudisha pachika_nakili(nodi_hii); }
    n32 kn = pachika_nakili(nodi_ya_kushoto[nodi_hii]);
    n32 kl = pachika_nakili(nodi_ya_kulia[nodi_hii]);
    rudisha nodi_mpya(aina, thamani_ya_nodi[nodi_hii], kn, kl);
}

// Andika "il<id>_<jina la asili>" (kikomo cha baiti 60 kwa jina la
// asili, cha kutosha kwa majina yoyote halisi ya paramu).
n32 pachika_jenga_jina(n8* chombo, n32 kitambulisho, n8* asili) {
    n32 nafasi = 0;
    chombo[nafasi] = 105; nafasi = nafasi + 1;  // 'i'
    chombo[nafasi] = 108; nafasi = nafasi + 1;  // 'l'
    kama (kitambulisho == 0) {
        chombo[nafasi] = 48; nafasi = nafasi + 1;
    } sivyo {
        n8 muda[16];
        n32 tn = 0;
        n32 v = kitambulisho;
        wakati (v > 0) {
            muda[tn] = 48 + (v % 10);
            tn = tn + 1;
            v = v / 10;
        }
        wakati (tn > 0) {
            tn = tn - 1;
            chombo[nafasi] = muda[tn];
            nafasi = nafasi + 1;
        }
    }
    chombo[nafasi] = 95; nafasi = nafasi + 1;  // '_'
    n32 i = 0;
    wakati (asili[i] != 0 && nafasi < 60) {
        chombo[nafasi] = asili[i];
        nafasi = nafasi + 1;
        i = i + 1;
    }
    chombo[nafasi] = 0;
    rudisha nafasi;
}

n32 pachika_kitambulisho_cha_hali = 0;
n32 pachika_mwanzo_wa_matokeo = -1;
n32 pachika_mwisho_wa_matokeo = -1;
n8* pachika_p_jina[6];
n32 pachika_p_usimbaji[6];
n32 pachika_p_hoja[6];

n32 pachika_jaribu_wito(n32 wito_nodi) {
    pachika_mwanzo_wa_matokeo = -1;
    pachika_mwisho_wa_matokeo = -1;
    kama (aina_ya_nodi[wito_nodi] != NODI_WITO) { rudisha 0; }
    n32 kitambulisho_cha_mwitwa = nodi_ya_kushoto[wito_nodi];
    kama (kitambulisho_cha_mwitwa == -1) { rudisha 0; }
    kama (aina_ya_nodi[kitambulisho_cha_mwitwa] != NODI_KITAMBULISHO) { rudisha 0; }
    n8* cjina = ghala_la_majina + umbali_wa_jina_la_nodi[kitambulisho_cha_mwitwa];
    n32 nodi_ya_kazi = pachika_tafuta_kazi(cjina);
    kama (nodi_ya_kazi == -1) { rudisha 0; }
    kama (pachika_mgombea(nodi_ya_kazi) == 0) { rudisha 0; }

    n32 agizo_la_sasa = 0;
    n32 pn = nodi_ya_kulia[nodi_ya_kazi];
    n32 an = nodi_ya_kulia[wito_nodi];
    wakati (pn != -1) {
        kama (an == -1) { rudisha 0; }  // hoja pungufu -- usiunganishe
        kama (agizo_la_sasa >= 6) { rudisha 0; }
        pachika_p_jina[agizo_la_sasa] = ghala_la_majina + umbali_wa_jina_la_nodi[pn];
        pachika_p_usimbaji[agizo_la_sasa] = thamani_ya_nodi[pn];
        pachika_p_hoja[agizo_la_sasa] = an;
        agizo_la_sasa = agizo_la_sasa + 1;
        pn = nodi_ya_kulia[pn];
        an = tatu_ya_nodi[an];
    }
    kama (an != -1) { rudisha 0; }  // hoja nyingi mno -- usiunganishe

    pachika_kitambulisho_cha_hali = pachika_kitambulisho_cha_hali + 1;
    n32 kitambulisho_cha_hali = pachika_kitambulisho_cha_hali;

    pachika_idadi_ya_ramani = agizo_la_sasa;
    n32 i = 0;
    wakati (i < agizo_la_sasa) {
        n32 j = 0;
        wakati (pachika_p_jina[i][j] != 0 && j < 63) {
            pachika_ramani_zamani[(i * 64) + j] = pachika_p_jina[i][j];
            j = j + 1;
        }
        pachika_ramani_zamani[(i * 64) + j] = 0;
        n8 chombo[64];
        pachika_jenga_jina(chombo, kitambulisho_cha_hali, pachika_p_jina[i]);
        n32 k = 0;
        wakati (chombo[k] != 0) {
            pachika_ramani_mpya[(i * 64) + k] = chombo[k];
            k = k + 1;
        }
        pachika_ramani_mpya[(i * 64) + k] = 0;
        i = i + 1;
    }

    n32 mwanzo = -1;
    n32 mwisho = -1;
    i = agizo_la_sasa;
    wakati (i > 0) {
        i = i - 1;
        n32 nodi_ya_jina_la_kigeu = nodi_mpya(NODI_KITAMBULISHO, 0, -1, -1);
        n8* jj = pachika_ramani_mpya + (i * 64);
        hifadhi_jina(nodi_ya_jina_la_kigeu, jj, pachika_urefu_wa_jina(jj));
        thamani_ya_nodi[nodi_ya_jina_la_kigeu] = pachika_p_usimbaji[i];
        n32 tangazo = nodi_mpya(NODI_TANGAZO, pachika_p_usimbaji[i], nodi_ya_jina_la_kigeu, pachika_p_hoja[i]);
        kama (mwanzo == -1) { mwanzo = tangazo; } sivyo { nne_ya_nodi[mwisho] = tangazo; }
        mwisho = tangazo;
    }

    n32 chanzo_hiki = tatu_ya_nodi[nodi_ya_kazi];
    wakati (chanzo_hiki != -1) {
        n32 kopi = pachika_nakili_taarifa(chanzo_hiki);
        kama (kopi != -1) {
            kama (mwanzo == -1) { mwanzo = kopi; } sivyo { nne_ya_nodi[mwisho] = kopi; }
            mwisho = kopi;
        }
        chanzo_hiki = nne_ya_nodi[chanzo_hiki];
    }

    kama (mwanzo == -1) {
        mwanzo = nodi_mpya(NODI_UBETI, 0, -1, -1);
        mwisho = mwanzo;
    }

    pachika_mwanzo_wa_matokeo = mwanzo;
    pachika_mwisho_wa_matokeo = mwisho;
    rudisha 1;
}

n32 pachika_pitisha_maudhui(n32 mwanzo) {
    n32 mwanzo_mpya = -1;
    n32 mpya_mwisho = -1;
    n32 nodi_hii = mwanzo;
    wakati (nodi_hii != -1) {
        n32 ijayo = nne_ya_nodi[nodi_hii];
        n32 kuunganishwa = 0;
        kama (aina_ya_nodi[nodi_hii] == NODI_WITO) {
            kama (pachika_jaribu_wito(nodi_hii)) { kuunganishwa = 1; }
        }
        kama (kuunganishwa) {
            kama (mwanzo_mpya == -1) { mwanzo_mpya = pachika_mwanzo_wa_matokeo; }
            sivyo { nne_ya_nodi[mpya_mwisho] = pachika_mwanzo_wa_matokeo; }
            mpya_mwisho = pachika_mwisho_wa_matokeo;
        } sivyo {
            kama (mwanzo_mpya == -1) { mwanzo_mpya = nodi_hii; }
            sivyo { nne_ya_nodi[mpya_mwisho] = nodi_hii; }
            mpya_mwisho = nodi_hii;
        }
        nodi_hii = ijayo;
    }
    kama (mpya_mwisho != -1) { nne_ya_nodi[mpya_mwisho] = -1; }
    rudisha mwanzo_mpya;
}

n32 kujumuisha_kazi_ndogo(n32 nodi_ya_programu) {
    pachika_jaza_sajili(nodi_ya_programu);
    n32 nodi_hii = nodi_ya_kushoto[nodi_ya_programu];
    wakati (nodi_hii != -1) {
        kama (aina_ya_nodi[nodi_hii] == NODI_KAZI) {
            kama (tatu_ya_nodi[nodi_hii] != -1) {
                n32 mpya = pachika_pitisha_maudhui(tatu_ya_nodi[nodi_hii]);
                tatu_ya_nodi[nodi_hii] = mpya;
            }
        }
        nodi_hii = nne_ya_nodi[nodi_hii];
    }
    rudisha nodi_ya_programu;
}

// =========================================================
// LICM -- kuhamisha hesabu isiyobadilika nje ya mzunguko
// (loop-invariant msimbo motion)
// =========================================================
//
// Lengo: kama usemi fulani ndani ya maudhui ya "wakati" hutoa MATOKEO
// SAWA kila mzunguko (hakuna kigezo kinachokitegemea kinachobadilika
// popote ndani ya maudhui), kihesabu MARA MOJA kabla ya mzunguko badala
// ya kukihesabu kila mzunguko.
//
// MUHIMU KUHUSU MAHALI PA AWAMU HII KWENYE MRADI (TOFAUTI NA
// kujumuisha_kazi_ndogo juu): awamu hii inaendeshwa BAADA ya
// mkaguzi_angalia (ukaguzi wa kisemantiki), SI kabla -- tofauti na
// kuunganisha kazi ndogo. Sababu: kila nodi ya usemi baada ya
// mkaguzi_angalia tayari ina ast_thamani[nodi] = usimbaji wa aina
// (usimbaji) uliothibitishwa (angalia mkaguzi_kagua_usemi, mkaguzi.swa) --
// hivyo tunapotengeneza tamko jipya la kigezo cha muda kwa usemi
// uliogunduliwa kuwa hauwadiliki, tunaweza KUNAKILI usimbaji huo moja kwa
// moja kutoka kwenye nodi kuu ya usemi uliopatikana, bila
// kuhitaji kujenga jedwali letu wenyewe la aina za vigezo (ambalo
// lingekuwa chanzo kingine cha hitilafu). Bei ya uamuzi huu: hatupati
// tena ukaguzi wa mkaguzi_angalia kama "wavu wa usalama wa bure" kwa
// mti tuliousuka (kama kuunganisha kazi ndogo kunavyofanya) -- lakini
// teremsha (ukaguzi wa muundo) bado unatembea baada yetu, na zaidi ya
// yote, mfululizo mzima wa majaribio (gharama/jaribu-mfululizo.mapishi) ndio
// wavu wa usalama halisi kwa mabadiliko haya yote.
//
// HATARI SITA ZILIZOZINGATIWA KWA MAKUSUDI (kila moja ina jaribio la
// kudumu linaloambatana, angalia majaribio/programu/jaribio_hamisha_nje_*):
//
// 1. HAKUNA OPERESHENI INAYOWEZA KUSHINDWA. Mgombea wa kuhamishwa
//    huruhusiwa TU kama nodi zake zote ni miongoni mwa: +,
//    -, *, ulinganisho (<,>,<=,>=,==,!=), na biti (&,|,^,<<,>>).
//    Mgawanyo (/) na modulo (%) HAZIRUHUSIWI KAMWE -- kuhamisha
//    mgawanyo unaoweza kushindwa (kigawanyaji sifuri) juu ya mzunguko
//    ambacho huenda kisitekelezwe kamwe kungegeuza programu
//    isiyoanguka kuwa moja inayoanguka kabla mzunguko haujaanza.
//    (angalia jaribio_hamisha_nje_mgawanyiko_hauhamishwi.swa)
//
// 2. HAKUNA OPERAND INAYOGUSA KUMBUKUMBU. Mgombea lazima ujengwe TU
//    kutoka kwa vigezo vya moja kwa moja (vya ndani, vya ulimwengu,
//    au paramu -- kwa JINA, si kupitia kielekezi/safu/muundo) na
//    namba za moja kwa moja. Nodi yoyote ya AST_TAJA (ambayo hutumika
//    KWA MOJA KWA MOJA kwa DEREFERENSI *p NA fahirisi ya safu
//    arr[faharisi] -- angalia changanua_usemi_upande), AST_KUMBUKA
//    (anwani-ya &x), au AST_SEHEMU_DOT/MSHALE (s.f / s->f) popote
//    ndani ya mti mdogo hufanya mti huo mdogo usistahili KABISA --
//    hakuna uchambuzi wa uwiano (alias analysis) unaohitajika kwa
//    sababu hatuwezi kamwe kufikia hatua ambapo swali hilo lingekuwa
//    muhimu. (angalia jaribio_hamisha_nje_kumbukumbu_haihamishwi.swa)
//
// 3. MZUNGUKO wenye WITO WOWOTE (AST_WITO) POPOTE NDANI YA MAUDHUI yake
//    (au sharti lake) HAKIGOMBEI LICM KABISA -- kizuizi kikali lakini
//    salama dhidi ya uwiano kupitia wito (kazi iliyoitwa inaweza
//    kubadilisha kigezo cha ulimwengu ambacho usemi "usiobadilika"
//    unakitegemea). (angalia jaribio_hamisha_nje_wito_huzuia_mzunguko.swa)
//
// 4. TABIA YA "MZUNGUKO UNAOENDESHWA MARA SIFURI" HAIBADILIKI KAMWE.
//    Njia salama iliyotumika: HATUONDOI, KUFUTA, WALA KUPANGA UPYA
//    taarifa yoyote iliyopo ya mtumiaji. Badala yake, tunatengeneza
//    KIGEZO KIPYA CHA MUDA, tunakihesabu MARA MOJA kabla ya mzunguko,
//    kisha tunaandika UPYA MAHALI HASA pa tukio la usemi huo ndani ya
//    maudhui (uwanja mmoja wa mzazi -- kushoto AU kulia) kuelekeza kwa
//    hicho kigezo kipya. Hii ni "usukaji wa ngazi-ya-mti-mdogo"
//    (subexpression-level splicing), SI uhamishaji wa taarifa nzima.
//    (angalia jaribio_hamisha_nje_mzunguko_sifuri.swa)
//
// 5. UCHUNGUZI KAMILI WA MAUDHUI yote WA UBADILISHAJI, SI TAARIFA ZA
//    NGAZI YA JUU TU -- usemi ni "usiobadilika" TU kama kila kigezo
//    unachokitaja hakiandikwi POPOTE ndani ya maudhui, ikiwa ni pamoja
//    na ndani ya matawi ya "kama" yaliyowekwa ndani (nested). Njia hii
//    inaiga kwa makusudi mfano wa inl_scan (kuunganisha kazi ndogo)
//    na kusanya_vigeu_vya_ndani (uzalishaji.swa) -- utembeaji kamili
//    wa AST bila kudhania thamani zilizosimbwa (mf. -777777) kuwa
//    nodi. (angalia jaribio_hamisha_nje_ubadilishaji_ndani_ya_kama.swa)
//
// 6. WIGO WA MZUNGUKO: "wakati" TU kwa awamu hii. Tumethibitisha
//    kuwa "kwa" hufunguliwa (desugared) kuwa NODI ILE ILE ya
//    AST_WAKATI (angalia changanua_taarifa_kwa) -- kwa hiyo mfululizo
//    huu wa LICM UNAFANYA KAZI kwa mzunguko wa "kwa" pia MRADI TU
//    hakina kifungu cha "anzisha" (init, kilichohifadhiwa kwenye
//    ast_tiga[wakati_node] kwa "kwa"). Kifungu cha "anzisha"
//    hutekelezwa NDANI YA nodi hiyo hiyo ya AST_WAKATI, KABLA ya
//    sharti kuangaliwa mara ya kwanza -- kama tungehamisha kigezo cha
//    muda KABLA ya nodi nzima ya mzunguko (ambako lazima kiende kwa
//    sababu ndipo tunapoandika upya mfululizo wa taarifa unaozunguka),
//    kigezo hicho kingesoma thamani ya KABLA ya "anzisha" kutekelezwa
//    -- hitilafu hasa inayofanana na ule "kwa (n=10; i<n; ...)" ambapo n
//    ingesomwa KABLA haijawekwa. Badala ya kuongeza usanifu wa ziada
//    kushughulikia mpangilio huu maalum, tunapunguza wigo kwa
//    makusudi: mzunguko unastahili LICM TU kama ast_tiga[nodi] == -1
//    (hakuna "anzisha" cha kwa). "fanya" (fanya-wakati, ast_thamani ==
//    -777778 kwenye nodi hiyo hiyo) hakizuiliwi wazi na sharti hili,
//    lakini pia hakijalengwa kwa makusudi na hakijajaribiwa -- kama
//    mzunguko wa aina hiyo ukitokea na ast_tiga[nodi]==-1, utachukuliwa
//    kwa asili (bila kuzingatiwa maalum), kwa sababu usukaji wetu
//    hautegemei kabisa ni lini sharti linaangaliwa -- lakini hii SI
//    dai la kuthibitishwa kwa jaribio maalum, ni matokeo ya asili tu
//    ya jinsi AST inavyofanana.
//
// KIZUIZI CHA WIGO CHA ZIADA (kilichochaguliwa kwa makusudi wakati wa
// utekelezaji, si kwa uzembe): tunatafuta mgombea WA KUHAMISHWA TU
// ndani ya taarifa za NGAZI YA JUU za maudhui ya mzunguko (mfululizo wa
// moja kwa moja wa ast_nne) ambazo ni AST_ASIMILIA (x = ...) au
// AST_TANGAZO na kianzio (n32 t = ...) -- SI ndani ya matawi ya
// "kama" yaliyowekwa ndani ya maudhui hayo huo (hata kama kinadharia
// itakuwa salama, kwa sababu shughuli zote zinazoruhusiwa
// hazishindwi kamwe -- lakini tumeamua kutoipanua zaidi ili kuepuka
// utata usiohitajika wa usanifu kwa awamu hii). Mizunguko iliyowekwa
// ndani (nested wakati) hushughulikiwa KWANZA (maudhui ya ndani
// kabisa kwanza), kisha matokeo yao (ikiwa ni pamoja na matamko
// mapya ya muda yaliyoongezwa) huwa sehemu ya mfululizo wa ngazi ya
// juu wa mzunguko wa nje kwa madhumuni ya uchunguzi unaofuata --
// hivyo hesabu inayobadilika mara mbili (isiyobadilika kwa mizunguko yote
// miwili) INAWEZA kuhamishwa ngazi MOJA zaidi kwa asili, lakini SI
// mbili kwa pito moja (kikomo kinachojulikana, kimeandikwa wazi).

n32 hamisha_nje_imetembelewa[1048576];
n32 hamisha_nje_zamu = 1;
n32 hamisha_nje_idadi = 0;

n32 hamisha_nje_acha = 0;
n8* hamisha_nje_badiliko_jina[64];
n32 hamisha_nje_badiliko_idadi = 0;

n32 hamisha_nje_ni_jina_badilishwa(n8* jina) {
    n32 i = 0;
    wakati (i < hamisha_nje_badiliko_idadi) {
        kama (pachika_jina_sawa(jina, hamisha_nje_badiliko_jina[i])) { rudisha 1; }
        i = i + 1;
    }
    rudisha 0;
}

w0 hamisha_nje_ongeza_badiliko(n8* jina) {
    kama (hamisha_nje_ni_jina_badilishwa(jina)) { rudisha; }
    kama (hamisha_nje_badiliko_idadi >= 64) {
        // Kikomo kimefikiwa -- USIONDOE jina kimya kimya (hilo
        // lingekuwa hatari, si ulinzi): kata tamaa kwa mzunguko huu
        // CHOTE badala yake, ni salama zaidi kutokuhamisha kuliko
        // kuhamisha kimakosa.
        hamisha_nje_acha = 1;
        rudisha;
    }
    hamisha_nje_badiliko_jina[hamisha_nje_badiliko_idadi] = jina;
    hamisha_nje_badiliko_idadi = hamisha_nje_badiliko_idadi + 1;
}

// Utembeaji kamili wa maudhui ya mzunguko (na sharti lake): hukusanya
// majina yote ya vigezo vinavyoandikwa POPOTE (ikiwa ni pamoja na
// ndani ya matawi ya kama na mizunguko iliyowekwa ndani), na huweka
// licm_bail=1 kama wito wowote (AST_WITO) au muundo usiotambuliwa
// kikamilifu (AST_CHAGUA/AST_MUUNDO/AST_SEHEMU/AST_HALI) unapatikana
// popote. Inaiga makusudi ruka_tiga/ruka_nne ya kusanya_vigeu_vya_ndani
// (uzalishaji.swa) kwa nodi za jumla, ikiwa na visa maalum vya ziada
// kwa AST_KAMA/AST_SIVYO/AST_WAKATI (kuingia ndani ya matawi yote,
// tofauti na inl_scan ambayo huvikataa moja kwa moja).
w0 hamisha_nje_changanua_maudhui(n32 nodi_hii) {
    hamisha_nje_idadi = hamisha_nje_idadi + 1;
    kama (hamisha_nje_idadi > 50000) { hamisha_nje_acha = 1; rudisha; }
    kama (nodi_hii < 0) { rudisha; }
    kama (nodi_hii >= 1048576) { rudisha; }
    kama (hamisha_nje_imetembelewa[nodi_hii] == hamisha_nje_zamu) { rudisha; }
    hamisha_nje_imetembelewa[nodi_hii] = hamisha_nje_zamu;
    n32 aina = aina_ya_nodi[nodi_hii];

    kama (aina == NODI_NAMBARI || aina == NODI_HALISI_D) { rudisha; }

    kama (aina == NODI_WITO) { hamisha_nje_acha = 1; rudisha; }
    kama (aina == NODI_CHAGUA || aina == NODI_MUUNDO || aina == NODI_SEHEMU || aina == NODI_HALI) {
        // Miundo isiyotambuliwa kikamilifu na uchunguzi huu -- kata
        // tamaa kwa uangalifu badala ya kudhania mpangilio wa nyanja.
        hamisha_nje_acha = 1;
        rudisha;
    }

    kama (aina == NODI_UBETI) {
        hamisha_nje_changanua_maudhui(nodi_ya_kushoto[nodi_hii]);
        hamisha_nje_changanua_maudhui(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == NODI_TANGAZO) {
        // Jina lililotangazwa NDANI ya maudhui ya mzunguko lazima litibiwe
        // kama "limebadilishwa" -- hata kama lina kianzio kimoja tu kwa
        // kila mzunguko, kianzio hicho MARA NYINGI hutegemea kigezo
        // kinachobadilika (mf. "D64 n_d = n;" ndani ya "wakati (n<=20)")
        // hivyo thamani ya jina hili SIYO sawa kila mzunguko. Bila hii,
        // usemi unaotumia jina hili ungeonekana (kimakosa) usiobadilika.
        n32 nodi_ya_kigeu = nodi_ya_kushoto[nodi_hii];
        kama (nodi_ya_kigeu != -1 && aina_ya_nodi[nodi_ya_kigeu] == NODI_KITAMBULISHO) {
            hamisha_nje_ongeza_badiliko(ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kigeu]);
        }
        hamisha_nje_changanua_maudhui(nodi_ya_kulia[nodi_hii]);  // kianzio
        hamisha_nje_changanua_maudhui(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == NODI_KAMA) {
        hamisha_nje_changanua_maudhui(nodi_ya_kushoto[nodi_hii]);  // sharti
        hamisha_nje_changanua_maudhui(nodi_ya_kulia[nodi_hii]);    // maudhui-ndio
        kama (tatu_ya_nodi[nodi_hii] != -1) { hamisha_nje_changanua_maudhui(tatu_ya_nodi[nodi_hii]); }  // AST_SIVYO
        hamisha_nje_changanua_maudhui(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == NODI_SIVYO) {
        hamisha_nje_changanua_maudhui(nodi_ya_kushoto[nodi_hii]);  // maudhui-sivyo
        hamisha_nje_changanua_maudhui(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == NODI_WAKATI) {
        hamisha_nje_changanua_maudhui(nodi_ya_kushoto[nodi_hii]);  // sharti
        hamisha_nje_changanua_maudhui(nodi_ya_kulia[nodi_hii]);    // maudhui
        kama (tatu_ya_nodi[nodi_hii] != -1) { hamisha_nje_changanua_maudhui(tatu_ya_nodi[nodi_hii]); }  // anzisha (kwa)
        hamisha_nje_changanua_maudhui(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == NODI_ASIMILIA) {
        n32 lengo = nodi_ya_kushoto[nodi_hii];
        kama (lengo != -1 && aina_ya_nodi[lengo] == NODI_KITAMBULISHO) {
            hamisha_nje_ongeza_badiliko(ghala_la_majina + umbali_wa_jina_la_nodi[lengo]);
        } sivyo {
            // Lengo si jina safi (mf. *p = .., arr[i] = .., s.f = ..) --
            // bado tembelea ndani yake (fahirisi n.k. inaweza kutaja
            // vigezo, ingawa haibadilishi jina lenyewe).
            hamisha_nje_changanua_maudhui(lengo);
        }
        hamisha_nje_changanua_maudhui(nodi_ya_kulia[nodi_hii]);  // upande wa kulia
        hamisha_nje_changanua_maudhui(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == NODI_KUMBUKA) {
        // &jina -- anwani ya kigezo imechukuliwa. Hakuna wito wowote
        // unaowezekana ndani ya mzunguko huu (tayari umezuiliwa juu),
        // hivyo hakuna njia ya kuandika kupitia anwani hii -- lakini
        // tibu kigezo kama kimebadilishwa kwa tahadhari ya ziada,
        // isiyogharimu chochote.
        n32 hoja = nodi_ya_kushoto[nodi_hii];
        kama (hoja != -1 && aina_ya_nodi[hoja] == NODI_KITAMBULISHO) {
            hamisha_nje_ongeza_badiliko(ghala_la_majina + umbali_wa_jina_la_nodi[hoja]);
        }
        hamisha_nje_changanua_maudhui(nne_ya_nodi[nodi_hii]);
        rudisha;
    }

    // Njia ya jumla (usemi wa hesabu/linganisho/biti, AST_TAJA,
    // AST_SEHEMU_DOT/MSHALE, n.k.) -- ast_tiga KAMWE si nodi halisi
    // hapa (kiungo cha mfululizo wa hoja za wito, au usimbaji), hivyo
    // haitembelewi kamwe kwenye njia hii.
    hamisha_nje_changanua_maudhui(nodi_ya_kushoto[nodi_hii]);
    hamisha_nje_changanua_maudhui(nodi_ya_kulia[nodi_hii]);
    n32 ruka_nne = 0;
    kama (aina == 33 || aina == 34) { ruka_nne = 1; }  // SEHEMU_DOT/MSHALE: umbali wa baiti
    kama (ruka_nne == 0) { hamisha_nje_changanua_maudhui(nne_ya_nodi[nodi_hii]); }
}

// Uchunguzi wa ustahiki (bila madhara ya kando) -- hurudisha 1 KAMA
// NA KAMA TU nodi na mti wake mdogo mzima umejengwa peke yake kutoka
// kwa: (a) namba za moja kwa moja (AST_NAMBARI/AST_HALISI_D), (b)
// vigezo vya moja kwa moja visivyobadilishwa mahali popote ndani ya
// mzunguko huu (angalia licm_ni_jina_badilishwa), (c) +, -, *,
// ulinganisho, na biti -- KAMWE si /, %, TAJA (deref/safu), KUMBUKA
// (anwani), SEHEMU_DOT/MSHALE, WITO, ASIMILIA, TERNARY, n.k.
n32 hamisha_nje_ni_operesheni(n32 nodi_hii) {
    n32 aina = aina_ya_nodi[nodi_hii];
    kama (aina == NODI_JUMLISHA || aina == NODI_TOFAUTI || aina == NODI_ZIDISHA) { rudisha 1; }
    kama (aina == NODI_SAWA || aina == NODI_TOFAUTI_SI || aina == NODI_CHINI || aina == NODI_JUU || aina == NODI_CHINI_SAWA || aina == NODI_JUU_SAWA) { rudisha 1; }
    kama (aina == NODI_SOGEZA_KUSHOTO || aina == NODI_SOGEZA_KULIA || aina == NODI_BITI_AU || aina == NODI_BITI_NA || aina == NODI_AU_PEKEE) { rudisha 1; }
    rudisha 0;
}

n32 hamisha_nje_naingiliana(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha 0; }
    n32 aina = aina_ya_nodi[nodi_hii];
    kama (aina == NODI_NAMBARI || aina == NODI_HALISI_D) { rudisha 1; }
    kama (aina == NODI_KITAMBULISHO) {
        n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_hii];
        kama (hamisha_nje_ni_jina_badilishwa(jina)) { rudisha 0; }
        rudisha 1;
    }
    kama (hamisha_nje_ni_operesheni(nodi_hii) == 0) { rudisha 0; }
    kama (hamisha_nje_naingiliana(nodi_ya_kushoto[nodi_hii]) == 0) { rudisha 0; }
    kama (hamisha_nje_naingiliana(nodi_ya_kulia[nodi_hii]) == 0) { rudisha 0; }
    rudisha 1;
}

// -------- CSE ya vielelezo vilivyohamishwa (cross-occurrence) --------
// Kabla ya hii, kila TOKEO la usemi usiobadilika lilipata kigezo chake
// CHA PEKEE cha muda -- hata kama tokeo mbili (au zaidi) zilikuwa
// zikikokotoa THAMANI ILE ILE kwa MUUNDO SAWA KABISA (mfano halisi wa
// matriki: "c[i*n+j] = c[i*n+j] + x" -- "i*n" hutokea MARA MBILI, moja
// kwenye fahirisi ya LHS na moja kwenye fahirisi ya kwanza ya RHS,
// zikijitegemea kikamilifu kupitia licm_badilisha_kama_inavyowezekana).
// Hii ilizuia kashe ya anwani ya ugawaji wa kawaida (keq_taja_sawa,
// uzalishaji.swa, PR #239) kutambua fahirisi mbili za c[...] kuwa SAWA
// KIMUUNDO, kwa sababu baada ya LICM zilikuwa zikirejelea VIGEZO VYA
// MUDA VYENYE MAJINA TOFAUTI (thibitishwa kwa tafsiri ya baiti -- maagizo
// yale yale ya kuzidisha yalionekana MARA MBILI mfululizo kabla ya
// mzunguko). licm_keq (chini) ni ulinganisho wa muundo wa AST -- SI wa
// jina la kigezo cha muda -- unaotumika KUGUNDUA hali hiyo KABLA ya
// kutengeneza kigezo kipya, ili tokeo la PILI (na lolote linalofuata)
// litumie TENA kigezo kilichotengenezwa na tokeo la KWANZA badala ya
// kutengeneza lake lenyewe.
//
// USALAMA: kila mgombea anayefikia ulinganisho huu tayari amepitisha
// licm_ni_operesheni(nodi) && licm_naingiliana(nodi) KIVYAKE (yaani
// tayari amethibitishwa kuwa hauguswi na chochote kilichoandikwa ndani
// ya mzunguko huu -- angalia licm_badilisha_kama_inavyowezekana) --
// licm_keq HAIONGEZI uthibitisho wowote mpya wa "hauguswi", inaongeza
// TU uthibitisho wa ziada kuwa MBILI ya vitu tayari-vilivyothibitishwa
// ni SAWA KIMUUNDO. Kwa hiyo, kuzishiriki kigezo kimoja badala ya
// viwili ni salama KWA UJENZI: kigezo kimoja kinachokokotolewa MARA
// MOJA kabla ya mzunguko bado kina thamani SAHIHI kwa matumizi YOTE
// mawili (au zaidi), kwa sababu thamani hiyo tayari imethibitishwa
// kutobadilika popote ndani ya mzunguko.
//
// WIGO: SAWA KABISA na uwanja wa licm_naingiliana/licm_ni_operesheni
// (kitambulisho, namba halisi -- n32 NA d64, +, -, *, ulinganisho, na
// biti) -- HAKUNA upanuzi wowote wa wigo wa awali wa LICM, ni
// ulinganisho TU juu ya vitu ambavyo tayari vingekuwa vimehamishwa
// hata bila CSE hii.
//
// MPANGILIO/WIGO WA MATAWI: licm_badilisha_kama_inavyowezekana
// HAIINGII KABISA ndani ya matawi ya "kama" (angalia "KIZUIZI CHA WIGO
// CHA ZIADA" juu ya faili hili) -- tokeo lolote lililo ndani ya "kama"
// halifiki hata kwenye ulinganisho huu, hivyo swali la "je, tokeo la
// tawi linaweza kushiriki kigezo na tokeo la nje ya tawi" HALIWEZI
// KUTOKEA KABISA: haihitaji ulinzi wa ziada, ni matokeo ya moja kwa
// moja ya wigo uliopo tayari.
n32 hamisha_nje_urudufu_nodi[64];
n8* hamisha_nje_urudufu_jina[64];
n32 hamisha_nje_urudufu_idadi = 0;

n32 hamisha_nje_ni_sawa_kimuundo(n32 a, n32 b) {
    kama (a == -1 || b == -1) { rudisha (a == b); }
    kama (aina_ya_nodi[a] != aina_ya_nodi[b]) { rudisha 0; }
    n32 t = aina_ya_nodi[a];
    kama (t == NODI_KITAMBULISHO) {
        rudisha pachika_jina_sawa(ghala_la_majina + umbali_wa_jina_la_nodi[a], ghala_la_majina + umbali_wa_jina_la_nodi[b]);
    }
    kama (t == NODI_NAMBARI) {
        // ast_kulia ni alama ya "dimbwi la N64" (angalia mahali
        // AST_NAMBARI inavyotengenezwa hapo juu ya faili hili) --
        // namba kubwa mno kwa n32 huhifadhiwa kwenye dimbwi kwa
        // UMBALI tofauti kila mara hata kama thamani halisi ni sawa,
        // hivyo ulinganisho huu hauwezi kutambua ULINGANO wa namba
        // hizo -- salama (fursa iliyokosekana TU, si hatari), kwa
        // sababu ast_thamani (umbali) haitafanana isipokuwa ni NODI
        // ILE ILE ilivyorejelewa mara mbili (jambo lisilowezekana
        // hapa, kwa kuwa kila tokeo ni uchanganuzi tofauti).
        kama (thamani_ya_nodi[a] != thamani_ya_nodi[b]) { rudisha 0; }
        rudisha (nodi_ya_kulia[a] == nodi_ya_kulia[b]);
    }
    kama (t == NODI_HALISI_D) {
        // ast_thamani ni umbali kwenye dimbwi la desimali -- sababu
        // ile ile kama AST_NAMBARI hapo juu.
        rudisha (thamani_ya_nodi[a] == thamani_ya_nodi[b]);
    }
    kama (hamisha_nje_ni_operesheni(a) == 0) { rudisha 0; }
    kama (hamisha_nje_ni_sawa_kimuundo(nodi_ya_kushoto[a], nodi_ya_kushoto[b]) == 0) { rudisha 0; }
    rudisha hamisha_nje_ni_sawa_kimuundo(nodi_ya_kulia[a], nodi_ya_kulia[b]);
}

// Tafuta jina la kigezo cha muda kilichotengenezwa TAYARI kwa usemi
// unaofanana kimuundo na `node` (ndani ya mzunguko huu huu) -- 0 kama
// hakuna.
n8* hamisha_nje_urudufu_tafuta(n32 nodi_hii) {
    n32 i = 0;
    wakati (i < hamisha_nje_urudufu_idadi) {
        kama (hamisha_nje_ni_sawa_kimuundo(nodi_hii, hamisha_nje_urudufu_nodi[i])) { rudisha hamisha_nje_urudufu_jina[i]; }
        i = i + 1;
    }
    rudisha 0;
}

// -------- Usanisi wa jina jipya la kigezo cha muda --------
n8 hamisha_nje_chombo_cha_jina[1536];  // 64 * 24
n32 hamisha_nje_idadi_ya_majina = 0;

n8* hamisha_nje_jina_mpya() {
    kama (hamisha_nje_idadi_ya_majina >= 64) { rudisha 0; }
    n32 faharasa_ya_jina = hamisha_nje_idadi_ya_majina;
    hamisha_nje_idadi_ya_majina = hamisha_nje_idadi_ya_majina + 1;
    n8* chombo = hamisha_nje_chombo_cha_jina + (faharasa_ya_jina * 24);
    chombo[0] = 95;   // _
    chombo[1] = 95;   // _
    chombo[2] = 108;  // l
    chombo[3] = 105;  // i
    chombo[4] = 99;   // c
    chombo[5] = 109;  // m
    chombo[6] = 95;   // _
    chombo[7] = 116;  // t
    n32 n = faharasa_ya_jina;
    n32 nafasi = 8;
    kama (n == 0) {
        chombo[nafasi] = 48;
        nafasi = nafasi + 1;
    } sivyo {
        n8 muda[8];
        n32 tn = 0;
        wakati (n > 0) {
            muda[tn] = 48 + (n % 10);
            n = n / 10;
            tn = tn + 1;
        }
        wakati (tn > 0) {
            tn = tn - 1;
            chombo[nafasi] = muda[tn];
            nafasi = nafasi + 1;
        }
    }
    chombo[nafasi] = 0;
    rudisha chombo;
}

// -------- Mfululizo wa matamko mapya ya muda kwa mzunguko wa SASA --------
n32 hamisha_nje_kabla_ya_mwanzo = -1;
n32 hamisha_nje_kabla_ya_mwisho = -1;

// Tafuta na uandike upya mti mdogo wa kiwango cha juu zaidi (maximal)
// usiobadilika ndani ya uwanja mmoja (kushoto au kulia, kulingana na
// ni_kushoto) wa nodi ya mzazi iliyotolewa. Kama uwanja mzima wenyewe
// hauhitilafiani (isiyobadilika) na si jani tupu (jina/namba moja bila
// operesheni -- kuhamisha hilo halingefaidisha chochote), unasukwa:
// kigezo kipya cha muda kinatengenezwa, kinahesabiwa mara moja kabla
// ya mzunguko, na uwanja huo unaelekezwa upya kwenye kigezo hicho.
// Vinginevyo, tunatafuta ndani ya watoto wa mti huo mdogo kwa fursa
// ndogo zaidi -- lakini TU kupitia aina za nodi ambazo tumezielewa
// kikamilifu (angalia maoni ya wigo hapo juu ya kila tawi).
w0 hamisha_nje_badilisha_kama_inavyowezekana(n32 nodi_inayoibeba, n32 ni_kushoto) {
    n32 nodi_iliyomo = -1;
    kama (ni_kushoto) { nodi_iliyomo = nodi_ya_kushoto[nodi_inayoibeba]; } sivyo { nodi_iliyomo = nodi_ya_kulia[nodi_inayoibeba]; }
    kama (nodi_iliyomo == -1) { rudisha; }

    kama (hamisha_nje_ni_operesheni(nodi_iliyomo) && hamisha_nje_naingiliana(nodi_iliyomo)) {
        n32 usimbaji = thamani_ya_nodi[nodi_iliyomo];

        // CSE (angalia maelezo kamili juu ya licm_keq/licm_cse_tafuta):
        // kama usemi unaofanana KIMUUNDO KABISA na huu tayari
        // umehamishwa kwa kigezo cha muda kwenye mzunguko huu huu,
        // tumia TENA jina hilo hilo badala ya kutengeneza kigezo kipya
        // -- hakuna tangazo jipya linalohitajika, tokeo hili linapata
        // TU marejeo mapya kwenye kigezo kilichopo tayari.
        n8* jina_uliopo = hamisha_nje_urudufu_tafuta(nodi_iliyomo);
        kama (jina_uliopo != 0) {
            n32 marejeo_urudufu = nodi_mpya(NODI_KITAMBULISHO, usimbaji, -1, -1);
            kama (marejeo_urudufu == -1) { rudisha; }
            hifadhi_jina(marejeo_urudufu, jina_uliopo, pachika_urefu_wa_jina(jina_uliopo));
            kama (ni_kushoto) { nodi_ya_kushoto[nodi_inayoibeba] = marejeo_urudufu; } sivyo { nodi_ya_kulia[nodi_inayoibeba] = marejeo_urudufu; }
            rudisha;
        }

        n8* jina_mpya = hamisha_nje_jina_mpya();
        kama (jina_mpya == 0) { rudisha; }  // kikomo cha majina kimefikiwa -- acha bila kuhamisha

        n32 nodi_ya_kigeu = nodi_mpya(NODI_KITAMBULISHO, usimbaji, -1, -1);
        kama (nodi_ya_kigeu == -1) { rudisha; }
        hifadhi_jina(nodi_ya_kigeu, jina_mpya, pachika_urefu_wa_jina(jina_mpya));

        n32 tangazo = nodi_mpya(NODI_TANGAZO, usimbaji, nodi_ya_kigeu, nodi_iliyomo);
        kama (tangazo == -1) { rudisha; }
        nne_ya_nodi[tangazo] = -1;

        kama (hamisha_nje_kabla_ya_mwanzo == -1) { hamisha_nje_kabla_ya_mwanzo = tangazo; } sivyo { nne_ya_nodi[hamisha_nje_kabla_ya_mwisho] = tangazo; }
        hamisha_nje_kabla_ya_mwisho = tangazo;

        n32 marejeo = nodi_mpya(NODI_KITAMBULISHO, usimbaji, -1, -1);
        kama (marejeo == -1) { rudisha; }
        hifadhi_jina(marejeo, jina_mpya, pachika_urefu_wa_jina(jina_mpya));

        kama (ni_kushoto) { nodi_ya_kushoto[nodi_inayoibeba] = marejeo; } sivyo { nodi_ya_kulia[nodi_inayoibeba] = marejeo; }

        // Sajili mgombea huyu kwa CSE ya baadaye -- mtoto (mti wa AST
        // kabla ya kuandikwa upya) bado ni halali kwa ulinganisho wa
        // muundo (umehifadhiwa kama kulia[tangazo], haujafutwa), na
        // ndio unaowakilisha THAMANI HALISI iliyohamishwa.
        kama (hamisha_nje_urudufu_idadi < 64) {
            hamisha_nje_urudufu_nodi[hamisha_nje_urudufu_idadi] = nodi_iliyomo;
            hamisha_nje_urudufu_jina[hamisha_nje_urudufu_idadi] = jina_mpya;
            hamisha_nje_urudufu_idadi = hamisha_nje_urudufu_idadi + 1;
        }
        rudisha;
    }

    n32 aina = aina_ya_nodi[nodi_iliyomo];
    kama (hamisha_nje_ni_operesheni(nodi_iliyomo)) {
        hamisha_nje_badilisha_kama_inavyowezekana(nodi_iliyomo, 1);
        hamisha_nje_badilisha_kama_inavyowezekana(nodi_iliyomo, 0);
        rudisha;
    }
    kama (aina == NODI_TAJA) {  // *kielekezi AU arr[faharisi] -- angalia kushoto (msingi), kulia (fahirisi, kama ipo)
        hamisha_nje_badilisha_kama_inavyowezekana(nodi_iliyomo, 1);
        kama (nodi_ya_kulia[nodi_iliyomo] != -1) { hamisha_nje_badilisha_kama_inavyowezekana(nodi_iliyomo, 0); }
        rudisha;
    }
    kama (aina == NODI_GAWANYA || aina == NODI_BAKI) {
        // Operesheni yenyewe KAMWE haiwezi kuhamishwa (hatari #1), lakini
        // watoto wake (mf. namba ya juu ya mgawanyo) bado wanaweza kuwa
        // na fursa ndogo ya LICM salama.
        hamisha_nje_badilisha_kama_inavyowezekana(nodi_iliyomo, 1);
        hamisha_nje_badilisha_kama_inavyowezekana(nodi_iliyomo, 0);
        rudisha;
    }
    kama (aina == NODI_SEHEMU_NUKTA || aina == NODI_SEHEMU_MSHALE) {
        hamisha_nje_badilisha_kama_inavyowezekana(nodi_iliyomo, 1);
        rudisha;
    }
    // Aina nyingine (AST_KUMBUKA, AST_TERNARY, AST_WITO, AST_ASIMILIA,
    // AST_NA/AU/SI, AST_KINYUME, n.k.) -- simama kwa makusudi, si
    // kudhania mpangilio wa nyanja usiothibitishwa (angalia wigo).
}

// Jaribu LICM kwa nodi MOJA ya AST_WAKATI -- hurudisha mwanzo wa
// mfululizo mpya wa matamko ya muda ya kuweka KABLA ya mzunguko huu
// (au -1 kama hakuna kilichohamishwa/kinachostahili).
n32 hamisha_nje_jaribu_mzunguko(n32 nodi_hii) {
    hamisha_nje_zamu = hamisha_nje_zamu + 1;
    hamisha_nje_idadi = 0;
    hamisha_nje_acha = 0;
    hamisha_nje_badiliko_idadi = 0;
    hamisha_nje_kabla_ya_mwanzo = -1;
    hamisha_nje_kabla_ya_mwisho = -1;
    hamisha_nje_urudufu_idadi = 0;

    hamisha_nje_changanua_maudhui(nodi_ya_kushoto[nodi_hii]);  // sharti
    hamisha_nje_changanua_maudhui(nodi_ya_kulia[nodi_hii]);    // maudhui

    kama (hamisha_nje_acha) { rudisha -1; }

    n32 taarifa = nodi_ya_kulia[nodi_hii];
    wakati (taarifa != -1) {
        kama (aina_ya_nodi[taarifa] == NODI_ASIMILIA) {
            hamisha_nje_badilisha_kama_inavyowezekana(taarifa, 1);
            hamisha_nje_badilisha_kama_inavyowezekana(taarifa, 0);
        } sivyo { kama (aina_ya_nodi[taarifa] == NODI_TANGAZO) {
            hamisha_nje_badilisha_kama_inavyowezekana(taarifa, 0);  // kianzio pekee, si jina la kigezo
        } }
        taarifa = nne_ya_nodi[taarifa];
    }

    rudisha hamisha_nje_kabla_ya_mwanzo;
}

// Tembea mfululizo wa taarifa (mwanzo wa ubeti), ukichakata mizunguko
// iliyowekwa ndani KWANZA (maudhui ya ndani kabisa kwanza), kisha
// ukijaribu LICM kwenye kila AST_WAKATI (isipokuwa "kwa" yenye
// anzisho, angalia maoni ya wigo juu), ukisuka matamko mapya ya muda
// KABLA ya nodi ya mzunguko kwenye mfululizo huu huu. Inaiga muundo wa
// inl_pitisha_maudhui (kuunganisha kazi ndogo) kwa makusudi.
n32 hamisha_nje_pitisha_maudhui(n32 mwanzo) {
    n32 mwanzo_mpya = -1;
    n32 mpya_mwisho = -1;
    n32 nodi_hii = mwanzo;
    wakati (nodi_hii != -1) {
        n32 ijayo = nne_ya_nodi[nodi_hii];
        n32 aina = aina_ya_nodi[nodi_hii];

        kama (aina == NODI_WAKATI) {
            nodi_ya_kulia[nodi_hii] = hamisha_nje_pitisha_maudhui(nodi_ya_kulia[nodi_hii]);

            n32 ni_mgombea = 1;
            kama (tatu_ya_nodi[nodi_hii] != -1) { ni_mgombea = 0; }  // "kwa" yenye anzisho -- nje ya wigo (angalia hatari #6)
            kama (ni_mgombea) {
                n32 kabla = hamisha_nje_jaribu_mzunguko(nodi_hii);
                kama (kabla != -1) {
                    kama (mwanzo_mpya == -1) { mwanzo_mpya = kabla; } sivyo { nne_ya_nodi[mpya_mwisho] = kabla; }
                    n32 mwisho_kabla = kabla;
                    wakati (nne_ya_nodi[mwisho_kabla] != -1) { mwisho_kabla = nne_ya_nodi[mwisho_kabla]; }
                    nne_ya_nodi[mwisho_kabla] = nodi_hii;
                    mpya_mwisho = nodi_hii;
                    nodi_hii = ijayo;
                    endelea;
                }
            }
        } sivyo { kama (aina == NODI_KAMA) {
            nodi_ya_kulia[nodi_hii] = hamisha_nje_pitisha_maudhui(nodi_ya_kulia[nodi_hii]);
            kama (tatu_ya_nodi[nodi_hii] != -1) {
                n32 sivyo_nodi = tatu_ya_nodi[nodi_hii];
                nodi_ya_kushoto[sivyo_nodi] = hamisha_nje_pitisha_maudhui(nodi_ya_kushoto[sivyo_nodi]);
            }
        } }

        kama (mwanzo_mpya == -1) { mwanzo_mpya = nodi_hii; } sivyo { nne_ya_nodi[mpya_mwisho] = nodi_hii; }
        mpya_mwisho = nodi_hii;
        nodi_hii = ijayo;
    }
    kama (mpya_mwisho != -1) { nne_ya_nodi[mpya_mwisho] = -1; }
    rudisha mwanzo_mpya;
}

n32 hamisha_nje_boresha(n32 nodi_ya_programu) {
    n32 nodi_hii = nodi_ya_kushoto[nodi_ya_programu];
    wakati (nodi_hii != -1) {
        kama (aina_ya_nodi[nodi_hii] == NODI_KAZI) {
            kama (tatu_ya_nodi[nodi_hii] != -1) {
                n32 mpya = hamisha_nje_pitisha_maudhui(tatu_ya_nodi[nodi_hii]);
                tatu_ya_nodi[nodi_hii] = mpya;
            }
        }
        nodi_hii = nne_ya_nodi[nodi_hii];
    }
    rudisha nodi_ya_programu;
}

// =========================================================
// SSCSE -- CSE ya msimbo wa mstari-moja-kwa-moja (straight-line
// common subexpression elimination)
// =========================================================
// LICM (juu ya faili hili) inashughulikia usemi usiobadilika ndani
// ya MZUNGUKO tu -- usemi unaorudiwa nje ya mzunguko (mfano "n32 x =
// a*b+c; n32 y = a*b-d;", bila mzunguko popote) haugusiki kabisa na
// LICM, hata ukiwa "a*b" umeandikwa mara mbili mfululizo bila
// chochote kati yake kinachoweza kubadilisha a wala b. Sehemu hii
// inashughulikia hali hiyo: kigawanyaji cha "available expressions"
// cha KAWAIDA (classical CSE) kwa mfululizo wa taarifa za NGAZI MOJA
// (straight-line) -- SI uchambuzi wa dataflow wa jumla (hilo
// lingehitaji kuunganisha upatikanaji kwenye makutano ya matawi,
// tatizo gumu zaidi kabisa ambalo halijaribiwi hapa kwa makusudi).
//
// WIGO (kwa makusudi mdogo, uwanja ule ule TAYARI uliothibitishwa na
// LICM -- licm_ni_operesheni: kitambulisho, namba halisi, +, -, *,
// ulinganisho, na biti. HAKUNA upanuzi wa wigo):
//   1. NGAZI YA JUU TU: usemi UNAOLINGANISHWA ni ast_kulia[taarifa]
//      MZIMA (upande wa kulia wa AST_ASIMILIA au kianzio cha
//      AST_TANGAZO) -- SI utafutaji wa kina wa mti mdogo (kama vile
//      LICM inavyofanya kwa licm_badilisha_kama_inavyowezekana).
//      "a*b" ndani ya "y = (a*b)+c" haiwezi kutambuliwa peke yake --
//      TU usemi mzima "a*b+c" unalinganishwa. Hii ni kizuizi cha
//      makusudi cha awamu ya kwanza -- utafutaji wa kina unaweza
//      kuongezwa baadaye bila kubadilisha usanifu wa msingi hapa.
//   2. HAKUNA UHAMISHAJI WA MAPEMA (eager): tofauti na LICM
//      (inayohamisha KILA usemi unaostahili mara moja unapoonekana,
//      hata kama haurudiwi kamwe -- salama kwa LICM kwa sababu
//      "invariant" tayari ni kigezo cha kuchagua), CSE ya mstari-
//      moja-kwa-moja ingekuwa na madhara MABAYA ikifanya hivyo: KILA
//      taarifa ya "x = a+b;" ingegeuka kuwa "n32 t=a+b; n32 x=t;"
//      HATA kama "a+b" haitokei tena kamwe popote -- uvimbe wa
//      msimbo usiofaidisha chochote. Badala yake: tokeo la KWANZA la
//      usemi linabaki MAHALI PALE PALE, LIKIWA HALIJAGUSWA, hadi
//      TOKEO LA PILI linapopatikana likifanana KIMUUNDO KABISA (na
//      bila upendeleo wowote kati yao -- angalia #3) -- WAKATI HUO
//      TU ndipo tokeo la KWANZA linaandikwa upya (retroactively) kuwa
//      tangazo la kigezo cha muda, na tokeo la PILI (na lolote
//      linalofuata) linarejelea kigezo hicho hicho.
//   3. UPENDELEO (invalidation) UNAOFUATA NAFASI, SI ULE WA LICM:
//      LICM huuliza swali MOJA tu kwa mzunguko mzima ("je, jina hili
//      linabadilishwa MAHALI POPOTE ndani ya mzunguko?" -- ndiyo au
//      hapana, mara moja). Hapa swali ni tofauti KABISA: "je, jina
//      hili limebadilishwa KATI ya tokeo la kwanza na hapa?" --
//      swali linalotegemea NAFASI, linalohitaji hali inayoendelea
//      (running state) tunapotembea taarifa kwa taarifa. Mgombea
//      anafutwa (kill) kutoka kwenye jedwali la "available" MARA
//      MOJA jina lake linapoandikwa (AST_ASIMILIA yenye upande wa
//      kushoto ukiwa kitambulisho sahili) -- SI mwishoni mwa ubeti,
//      bali PALE PALE inapotokea, ili taarifa zinazofuata (SI
//      zilizotangulia) ziathirike.
//   4. MPAKA WA TAWI/MZUNGUKO: upatikanaji (availability) HAUVUKI
//      KAMWE mpaka wa AST_KAMA wala AST_WAKATI/KWA -- jedwali
//      linawekwa upya KABISA (tupu) kila mara tunapoingia ndani ya
//      maudhui ya tawi/mzunguko (jedwali JIPYA, tupu, kwa maudhui hayo
//      pekee -- angalia cse_pitisha_maudhui) NA TENA mara tu
//      tunapotoka humo kabla ya kuendelea na taarifa zinazofuata za
//      ubeti la nje. Hii inaepuka KABISA tatizo gumu la "kuunganisha
//      upatikanaji kwenye makutano ya matawi" (mfano: usemi
//      uliopatikana upande MMOJA tu wa "kama" haupaswi kudhaniwa
//      kupatikana baada ya "kama" kuisha) -- ni salama zaidi kuliko
//      lazima, lakini ni sahihi KILA WAKATI.
//   5. WITO WA KAZI: usemi UNAOLINGANISHWA (uliopita
//      licm_ni_operesheni/cse_ni_safi, angalia chini) HAUWEZI KAMWE
//      kuwa na AST_WITO ndani yake -- ni sehemu ya uwanja ule ule wa
//      LICM. LAKINI: taarifa nyingine (au sehemu nyingine ya taarifa
//      HIYO HIYO, mfano faharisi ya "arr[f()] = x;") bado inaweza
//      kuwa na wito hata kama upande unaolinganishwa (kulia) haugusiki
//      nao moja kwa moja -- wito kama huo unaweza kubadilisha KIGEZO
//      CHA ULIMWENGU (ya ulimwengu) ambacho tayari kimo ndani ya usemi
//      uliohifadhiwa TAYARI kwenye jedwali (hatuna njia ya kutofautisha
//      kigezo cha ndani na cha ulimwengu katika awamu hii -- LICM
//      YENYEWE haitofautishi pia). Kwa hiyo: taarifa YOYOTE (ASIMILIA/
//      TANGAZO) ambayo sehemu yake YOYOTE (kushoto AU kulia) ina wito
//      popote ndani yake, INAFUTA JEDWALI ZIMA baada ya kushughulikiwa
//      -- kigezo salama zaidi kuliko lazima (kingeweza kutofautisha
//      "wito huu unaathiri kigezo hiki maalum tu"), lakini KWA MAKUSUDI
//      rahisi zaidi na salama zaidi. Utambuzi wa wito unatumia TENA
//      licm_changanua_maudhui (angalia cse_ina_kigeni chini) badala ya
//      kuandika upya usafiri mpya wa AST -- hatari ya kukosa aina
//      fulani ya nodi (mfano mtego wa AST_WITO/ast_tiga uliojulikana
//      kikao hiki) ni kubwa zaidi kwa usafiri MPYA usiojaribiwa kuliko
//      kutumia TENA ule uliopo tayari, uliojaribiwa na LICM.
//
// MPANGILIO WA UENDESHAJI: BAADA ya licm_boresha (angalia kiendeshaji.swa)
// -- kwa sababu ile ile LICM inayoendesha BAADA ya mkaguzi_angalia
// (usimbaji tayari umethibitishwa, tunaweza kuinakili moja kwa moja bila
// jedwali letu wenyewe la aina). Kuendesha BAADA ya LICM pia kunamaanisha
// usemi vilivyokwisha hamishwa NA LICM (vikiwa vimebadilishwa kuwa
// marejeo ya vigezo vya muda vya LICM) havitaonekana tena kama
// "a*b" ghafi ndani ya mizunguko -- CSE hii inashughulikia KILA KITU
// KINGINE (nje ya mizunguko, au ndani ya mizunguko lakini kisichokuwa
// isiyobadilika), si kurudia kazi ya LICM.

n32 urudufu_inapatikana_nodi[64];  // nodi ya AST ya usemi wa TOKEO LA KWANZA (bado halali kwa kulinganisha muundo)
n32 urudufu_inapatikana_taarifa[64];  // taarifa ya NGAZI YA JUU (AST_ASIMILIA/AST_TANGAZO) iliyokuwa na tokeo la kwanza -- kwa USUKAJI wa tangazo jipya
n32 urudufu_inapatikana_nodi_inayoibeba[64];     // (pamoja na cse_avail_ni_kushoto) uwanja HASA wa tokeo la kwanza -- kwa UANDISHI wa marejeo mahali pale pale, hata kama ni kipande cha ndani ya usemi mkubwa zaidi
n32 urudufu_inapatikana_ni_kushoto[64];
n8* urudufu_inapatikana_jina[64];  // 0 = bado halijahamishwa kuwa kigezo cha muda; vinginevyo jina la kigezo
n32 urudufu_inapatikana_idadi = 0;

n32 urudufu_mwanzo_sasa = -1;  // mwanzo wa mfululizo wa SASA (unaweza kubadilika kwa uwekaji wa tangazo mpya kwenye nafasi ya kwanza)

// -------- Usanisi wa jina jipya la kigezo cha muda (kioo cha licm_jina_mpya, kiambishi TOFAUTI ili kisichanganyike) --------
n8 urudufu_chombo_cha_jina[1536];  // 64 * 24
n32 urudufu_idadi_ya_majina = 0;

n8* urudufu_jina_mpya() {
    kama (urudufu_idadi_ya_majina >= 64) { rudisha 0; }
    n32 faharasa_ya_jina = urudufu_idadi_ya_majina;
    urudufu_idadi_ya_majina = urudufu_idadi_ya_majina + 1;
    n8* chombo = urudufu_chombo_cha_jina + (faharasa_ya_jina * 24);
    chombo[0] = 95;   // _
    chombo[1] = 95;   // _
    chombo[2] = 115;  // s
    chombo[3] = 99;   // c
    chombo[4] = 115;  // s
    chombo[5] = 101;  // e
    chombo[6] = 95;   // _
    chombo[7] = 116;  // t
    n32 n = faharasa_ya_jina;
    n32 nafasi = 8;
    kama (n == 0) {
        chombo[nafasi] = 48;
        nafasi = nafasi + 1;
    } sivyo {
        n8 muda[8];
        n32 tn = 0;
        wakati (n > 0) {
            muda[tn] = 48 + (n % 10);
            n = n / 10;
            tn = tn + 1;
        }
        wakati (tn > 0) {
            tn = tn - 1;
            chombo[nafasi] = muda[tn];
            nafasi = nafasi + 1;
        }
    }
    chombo[nafasi] = 0;
    rudisha chombo;
}

// Ulinganisho wa kina (deep): rudisha 1 IKIWA NA IKIWA TU mti mdogo
// mzima unajengwa peke yake kutoka kwa vitambulisho/namba halisi/
// operesheni za uwanja wa licm_ni_operesheni -- HAKUNA "je,
// limebadilishwa" (hilo linashughulikiwa kando, kwa nafasi, na
// cse_kill_zenye_jina) -- ni sawa na licm_naingiliana LAKINI bila
// sehemu ya "haijabadilishwa", kwa sababu maana ya "haijabadilishwa"
// hapa ni ya NAFASI (position-dependent), si ya mzunguko mzima.
n32 urudufu_ni_safi(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha 0; }
    n32 aina = aina_ya_nodi[nodi_hii];
    kama (aina == NODI_NAMBARI || aina == NODI_HALISI_D) { rudisha 1; }
    kama (aina == NODI_KITAMBULISHO) { rudisha 1; }
    kama (hamisha_nje_ni_operesheni(nodi_hii) == 0) { rudisha 0; }
    kama (urudufu_ni_safi(nodi_ya_kushoto[nodi_hii]) == 0) { rudisha 0; }
    rudisha urudufu_ni_safi(nodi_ya_kulia[nodi_hii]);
}

// Je, `jina` linatokea popote ndani ya usemi `node` (ambao TAYARI
// umepita cse_ni_safi, hivyo hauna WITO/TAJA/n.k. -- usafiri huu
// unaweza kutumia uwanja mwembamba wa licm_ni_operesheni kwa
// usalama kamili).
n32 urudufu_usemi_ina_jina(n32 nodi_hii, n8* jina) {
    kama (nodi_hii == -1) { rudisha 0; }
    n32 aina = aina_ya_nodi[nodi_hii];
    kama (aina == NODI_KITAMBULISHO) {
        rudisha pachika_jina_sawa(ghala_la_majina + umbali_wa_jina_la_nodi[nodi_hii], jina);
    }
    kama (hamisha_nje_ni_operesheni(nodi_hii) == 0) { rudisha 0; }
    kama (urudufu_usemi_ina_jina(nodi_ya_kushoto[nodi_hii], jina)) { rudisha 1; }
    rudisha urudufu_usemi_ina_jina(nodi_ya_kulia[nodi_hii], jina);
}

// Je, `node` (usemi WOWOTE, si tu ule wa uwanja mwembamba -- unaweza
// kuwa na wito, faharisi za safu, n.k.) una AST_WITO mahali popote
// ndani yake? Tunatumia TENA licm_changanua_maudhui (LICM, juu ya
// faili hili) kama "kihisi" -- kazi hiyo tayari inaweka licm_bail=1
// pindi ikikutana na AST_WITO (au aina nyingine ya nodi isiyoeleweka
// kikamilifu, mf. AST_CHAGUA/AST_MUUNDO/AST_SEHEMU/AST_HALI) mahali
// popote kwenye mti mdogo -- kuitumia tena hapa ni salama zaidi
// kuliko kuandika usafiri mpya wa AST (hatari ya kukosa aina fulani
// ya nodi, angalia maelezo makuu juu). Hatuhitaji matokeo mengine ya
// kazi hiyo (licm_badiliko_jina n.k.) -- yanapuuzwa kwa makusudi.
n32 urudufu_ina_kigeni(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha 0; }
    hamisha_nje_zamu = hamisha_nje_zamu + 1;
    hamisha_nje_idadi = 0;
    hamisha_nje_acha = 0;
    hamisha_nje_badiliko_idadi = 0;
    hamisha_nje_changanua_maudhui(nodi_hii);
    rudisha hamisha_nje_acha;
}

// Ondoa (kill) kutoka kwenye jedwali la "available" mgombea YOYOTE
// (aliyehamishwa TAYARI au bado hajahamishwa) ambaye usemi wake
// unarejelea `jina` mahali popote -- kuitwa MARA MOJA baada ya
// taarifa ya AST_ASIMILIA kuandika upya `jina` (angalia
// cse_pitisha_maudhui). Kompakishaji (compaction) badala ya kuacha
// mapengo.
w0 urudufu_batilisha_zenye_jina(n8* jina) {
    n32 w = 0;
    n32 i = 0;
    wakati (i < urudufu_inapatikana_idadi) {
        kama (urudufu_usemi_ina_jina(urudufu_inapatikana_nodi[i], jina) == 0) {
            urudufu_inapatikana_nodi[w] = urudufu_inapatikana_nodi[i];
            urudufu_inapatikana_taarifa[w] = urudufu_inapatikana_taarifa[i];
            urudufu_inapatikana_nodi_inayoibeba[w] = urudufu_inapatikana_nodi_inayoibeba[i];
            urudufu_inapatikana_ni_kushoto[w] = urudufu_inapatikana_ni_kushoto[i];
            urudufu_inapatikana_jina[w] = urudufu_inapatikana_jina[i];
            w = w + 1;
        }
        i = i + 1;
    }
    urudufu_inapatikana_idadi = w;
}

n32 urudufu_tafuta_faharasa(n32 usemi) {
    n32 i = 0;
    wakati (i < urudufu_inapatikana_idadi) {
        kama (hamisha_nje_ni_sawa_kimuundo(usemi, urudufu_inapatikana_nodi[i])) { rudisha i; }
        i = i + 1;
    }
    rudisha -1;
}

// Tafuta nodi X ambayo ast_nne[X] == lengo, ukitembea kutoka
// urudufu_mwanzo_sasa -- -2 ikiwa lengo NDIYO mwanzo wenyewe (hakuna
// mtangulizi ndani ya ubeti hili), -1 kama haijapatikana (hitilafu
// ya uwekaji kumbukumbu -- haipaswi kutokea kama mantiki ni sahihi,
// lakini tunakagua kwa usalama badala ya kudhania). Utafutaji upya
// (badala ya kuhifadhi "mtangulizi" tuliouona mara ya kwanza) ni WA
// MAKUSUDI: mgombea WA PILI anayehamishwa kwenye taarifa ILE ILE ya
// kwanza (mfano "y = a*b + c*d;" ikiwa zote mbili zinarudiwa) angeweza
// kufanya "mtangulizi" uliohifadhiwa awali kuwa batili (stale) --
// utafutaji upya kila mara ni salama kwa gharama ndogo (beti za
// mstari-moja-kwa-moja si kubwa sana kwa kawaida).
n32 urudufu_tafuta_mtangulizi(n32 lengo_hili) {
    kama (urudufu_mwanzo_sasa == lengo_hili) { rudisha -2; }
    n32 x = urudufu_mwanzo_sasa;
    wakati (x != -1) {
        kama (nne_ya_nodi[x] == lengo_hili) { rudisha x; }
        x = nne_ya_nodi[x];
    }
    rudisha -1;
}

// Andika thamani `v` kwenye uwanja (mzazi, ni_kushoto) uliopewa.
w0 urudufu_weka_uwanja(n32 nodi_inayoibeba, n32 ni_kushoto, n32 v) {
    kama (ni_kushoto) { nodi_ya_kushoto[nodi_inayoibeba] = v; } sivyo { nodi_ya_kulia[nodi_inayoibeba] = v; }
}

// Shughulikia uwanja mmoja (mzazi, ni_kushoto) -- KIPANDE CHOCHOTE
// cha usemi, si tu ast_kulia[taarifa] ya ngazi ya juu -- na `juu`
// ikiwa ni taarifa ya NGAZI YA JUU (AST_ASIMILIA/AST_TANGAZO)
// inayozunguka (kwa madhumuni ya USUKAJI wa tangazo jipya, ambalo
// LAZIMA liwekwe KABLA ya taarifa ya NGAZI YA JUU siku zote, hata
// kama tokeo lililopatikana liko ndani KABISA ya usemi mkubwa
// zaidi -- SI kabla ya nodi ndogo yenyewe, ambayo si sehemu ya
// mfululizo wa ast_nne kamwe).
//
// MUHIMU (tofauti KUU na licm_badilisha_kama_inavyowezekana): baada
// ya kujaribu kulinganisha/kusajili NODI NZIMA katika uwanja huu,
// TUNAENDELEA kuchunguza WATOTO WAKE PIA (isipokuwa nodi ilibadilishwa
// kuwa marejeo, ambapo haina watoto tena) -- si "au moja au nyingine"
// kama LICM (ambayo huchagua mti mdogo MKUBWA ZAIDI unaostahili na
// kuacha kabisa kuchunguza ndani yake). Sababu: uvumbuzi upya
// (invariance kwa LICM) ni sifa ya KIWANGO KIMOJA (mti mzima ni
// isiyobadilika au sivyo) -- lakini KUFANANA (kwa CSE) kunaweza kutokea
// KWENYE KINA CHOCHOTE kwa wakati mmoja: "a*b" ndani ya "a*b+c" NA
// "a*b" ndani ya "a*b-d" LAZIMA zilinganishwe, HATA KAMA "a*b+c" na
// "a*b-d" wenyewe (kama vitengo vizima) havifanani KAMWE kimuundo
// (AST_JUMLISHA dhidi ya AST_TOFAUTI).
w0 urudufu_chakata(n32 nodi_inayoibeba, n32 ni_kushoto, n32 juu) {
    n32 nodi_hii = -1;
    kama (ni_kushoto) { nodi_hii = nodi_ya_kushoto[nodi_inayoibeba]; } sivyo { nodi_hii = nodi_ya_kulia[nodi_inayoibeba]; }
    kama (nodi_hii == -1) { rudisha; }
    kama (hamisha_nje_ni_operesheni(nodi_hii) == 0) { rudisha; }

    kama (urudufu_ni_safi(nodi_hii)) {
        n32 faharasa = urudufu_tafuta_faharasa(nodi_hii);
        kama (faharasa == -1) {
            // Tokeo la KWANZA -- SAJILI TU, USIGUSE AST (angalia
            // SABABU #2 kwenye maelezo makuu -- uhamishaji wa mapema
            // ungeharibu usemi usiorudiwa).
            kama (urudufu_inapatikana_idadi < 64) {
                urudufu_inapatikana_nodi[urudufu_inapatikana_idadi] = nodi_hii;
                urudufu_inapatikana_taarifa[urudufu_inapatikana_idadi] = juu;
                urudufu_inapatikana_nodi_inayoibeba[urudufu_inapatikana_idadi] = nodi_inayoibeba;
                urudufu_inapatikana_ni_kushoto[urudufu_inapatikana_idadi] = ni_kushoto;
                urudufu_inapatikana_jina[urudufu_inapatikana_idadi] = 0;
                urudufu_inapatikana_idadi = urudufu_inapatikana_idadi + 1;
            }
        } sivyo {
            n32 usimbaji = thamani_ya_nodi[urudufu_inapatikana_nodi[faharasa]];

            kama (urudufu_inapatikana_jina[faharasa] != 0) {
                // Tayari imehamishwa (tokeo la TATU au zaidi) -- rejelea tu.
                n32 marejeo = nodi_mpya(NODI_KITAMBULISHO, usimbaji, -1, -1);
                kama (marejeo == -1) { rudisha; }
                hifadhi_jina(marejeo, urudufu_inapatikana_jina[faharasa], pachika_urefu_wa_jina(urudufu_inapatikana_jina[faharasa]));
                urudufu_weka_uwanja(nodi_inayoibeba, ni_kushoto, marejeo);
                rudisha;  // nodi imebadilishwa -- hakuna watoto wa kuchunguza tena
            }

            // Tokeo la PILI: andika upya (retroactively) tokeo la
            // KWANZA kuwa tangazo la kigezo cha muda (lililowekwa
            // KABLA ya taarifa yake ya NGAZI YA JUU), kisha rejelea
            // kigezo hicho pande zote mbili.
            n32 kwanza_taarifa = urudufu_inapatikana_taarifa[faharasa];
            n8* jina_mpya = urudufu_jina_mpya();
            kama (jina_mpya == 0) { rudisha; }  // majina yamekwisha -- si hatari, achana nayo tu

            n32 nodi_ya_kigeu = nodi_mpya(NODI_KITAMBULISHO, usimbaji, -1, -1);
            kama (nodi_ya_kigeu == -1) { rudisha; }
            hifadhi_jina(nodi_ya_kigeu, jina_mpya, pachika_urefu_wa_jina(jina_mpya));

            n32 tangazo = nodi_mpya(NODI_TANGAZO, usimbaji, nodi_ya_kigeu, urudufu_inapatikana_nodi[faharasa]);
            kama (tangazo == -1) { rudisha; }
            nne_ya_nodi[tangazo] = -1;

            n32 kitangulizi = urudufu_tafuta_mtangulizi(kwanza_taarifa);
            kama (kitangulizi == -1) { rudisha; }  // hitilafu ya kumbukumbu -- acha AST bila kuguswa, salama
            kama (kitangulizi == -2) {
                nne_ya_nodi[tangazo] = kwanza_taarifa;
                urudufu_mwanzo_sasa = tangazo;
            } sivyo {
                nne_ya_nodi[tangazo] = kwanza_taarifa;
                nne_ya_nodi[kitangulizi] = tangazo;
            }

            n32 marejeo1 = nodi_mpya(NODI_KITAMBULISHO, usimbaji, -1, -1);
            kama (marejeo1 == -1) { rudisha; }
            hifadhi_jina(marejeo1, jina_mpya, pachika_urefu_wa_jina(jina_mpya));
            urudufu_weka_uwanja(urudufu_inapatikana_nodi_inayoibeba[faharasa], urudufu_inapatikana_ni_kushoto[faharasa], marejeo1);

            urudufu_inapatikana_jina[faharasa] = jina_mpya;

            n32 marejeo2 = nodi_mpya(NODI_KITAMBULISHO, usimbaji, -1, -1);
            kama (marejeo2 == -1) { rudisha; }
            hifadhi_jina(marejeo2, jina_mpya, pachika_urefu_wa_jina(jina_mpya));
            urudufu_weka_uwanja(nodi_inayoibeba, ni_kushoto, marejeo2);
            rudisha;  // nodi imebadilishwa -- hakuna watoto wa kuchunguza tena
        }
    }

    // Tafuta vipande vidogo zaidi ndani ya watoto wa nodi (angalia
    // MUHIMU juu) -- hii inafanyika HATA kama nodi yenyewe haikuwa
    // "safi" (cse_ni_safi==0, mfano ina wito ndani ya upande mmoja),
    // kwa sababu upande MWINGINE bado unaweza kuwa na fursa yake
    // pekee. nodi hapa bado ni ile ile ya AWALI (haijabadilishwa --
    // matawi yote mawili hapo juu yanayobadilisha nodi huishia na
    // "rudisha" kabla ya kufika hapa).
    urudufu_chakata(nodi_hii, 1, juu);
    urudufu_chakata(nodi_hii, 0, juu);
}

// Tembea mfululizo wa taarifa (mstari-moja-kwa-moja), tukishughulikia
// AST_ASIMILIA/AST_TANGAZO kwa CSE, na AST_KAMA/AST_WAKATI kwa
// kuingia ndani (jedwali JIPYA kwa kila maudhui) na kuweka upya
// jedwali letu WENYEWE mara tu tunapotoka (angalia SABABU #4 juu).
// Inarudisha mwanzo (unaoweza kuwa umebadilika kama tangazo
// jipya limewekwa mwanzoni kabisa mwa mfululizo huu).
n32 urudufu_pitisha_maudhui(n32 mwanzo) {
    urudufu_inapatikana_idadi = 0;
    urudufu_mwanzo_sasa = mwanzo;

    n32 nodi_hii = mwanzo;
    wakati (nodi_hii != -1) {
        n32 ijayo = nne_ya_nodi[nodi_hii];
        n32 aina = aina_ya_nodi[nodi_hii];

        kama (aina == NODI_ASIMILIA) {
            urudufu_chakata(nodi_hii, 0, nodi_hii);
            n32 kushoto = nodi_ya_kushoto[nodi_hii];
            kama (kushoto != -1 && aina_ya_nodi[kushoto] == NODI_KITAMBULISHO) {
                urudufu_batilisha_zenye_jina(ghala_la_majina + umbali_wa_jina_la_nodi[kushoto]);
            }
            kama (urudufu_ina_kigeni(nodi_ya_kushoto[nodi_hii]) || urudufu_ina_kigeni(nodi_ya_kulia[nodi_hii])) {
                urudufu_inapatikana_idadi = 0;
            }
        } sivyo { kama (aina == NODI_TANGAZO) {
            urudufu_chakata(nodi_hii, 0, nodi_hii);
            kama (urudufu_ina_kigeni(nodi_ya_kulia[nodi_hii])) {
                urudufu_inapatikana_idadi = 0;
            }
        } sivyo { kama (aina == NODI_KAMA) {
            nodi_ya_kulia[nodi_hii] = urudufu_pitisha_maudhui(nodi_ya_kulia[nodi_hii]);
            kama (tatu_ya_nodi[nodi_hii] != -1) {
                n32 sivyo_nodi = tatu_ya_nodi[nodi_hii];
                nodi_ya_kushoto[sivyo_nodi] = urudufu_pitisha_maudhui(nodi_ya_kushoto[sivyo_nodi]);
            }
            // Turudi kwenye muktadha wa ubeti hili (mabadiliko ya
            // ndani ya cse_pitisha_maudhui ya ndani hayakuwa
            // yakiathiri jedwali hili -- lakini bado tunaweka upya
            // KWA MAKUSUDI, angalia SABABU #4).
            urudufu_mwanzo_sasa = mwanzo;
            urudufu_inapatikana_idadi = 0;
        } sivyo { kama (aina == NODI_WAKATI) {
            nodi_ya_kulia[nodi_hii] = urudufu_pitisha_maudhui(nodi_ya_kulia[nodi_hii]);
            urudufu_mwanzo_sasa = mwanzo;
            urudufu_inapatikana_idadi = 0;
        } sivyo {
            // Aina nyingine yoyote (AST_WITO ya wazi, AST_RUDISHA,
            // AST_VUNJA/ENDELEA, n.k.) -- hatuchakati kwa CSE, lakini
            // TUNAWEKA UPYA kwa tahadhari (kigezo salama chaguo-msingi
            // -- angalia maelezo makuu, hatuorodheshi kwa undani kila
            // aina inayowezekana ya taarifa).
            urudufu_inapatikana_idadi = 0;
        } } } }

        nodi_hii = ijayo;
    }
    rudisha urudufu_mwanzo_sasa;
}

n32 urudufu_wa_mstari_boresha(n32 nodi_ya_programu) {
    n32 nodi_hii = nodi_ya_kushoto[nodi_ya_programu];
    wakati (nodi_hii != -1) {
        kama (aina_ya_nodi[nodi_hii] == NODI_KAZI) {
            kama (tatu_ya_nodi[nodi_hii] != -1) {
                n32 mpya = urudufu_pitisha_maudhui(tatu_ya_nodi[nodi_hii]);
                tatu_ya_nodi[nodi_hii] = mpya;
            }
        }
        nodi_hii = nne_ya_nodi[nodi_hii];
    }
    rudisha nodi_ya_programu;
}

// Jina lililoondolewa -> jina jipya (0 kama si jina lililoondolewa).
n8* jina_jipya_la_zamani(n8* jina) {
    kama (jina_linganisha(jina, "kbd_scancode")) { rudisha "msimbo_wa_kitufe"; }
    kama (jina_linganisha(jina, "achilia_arena")) { rudisha "achilia_eneo_la_utengaji"; }
    kama (jina_linganisha(jina, "andika_stderr")) { rudisha "andika_kosa"; }
    kama (jina_linganisha(jina, "atan2_hesabu")) { rudisha "arctan2_hesabu"; }
    kama (jina_linganisha(jina, "atan_hesabu")) { rudisha "arctan_hesabu"; }
    kama (jina_linganisha(jina, "atan_ndogo_hesabu")) { rudisha "arctan_ndogo_hesabu"; }
    kama (jina_linganisha(jina, "bafa_heksa")) { rudisha "andika_heksa_kwenye_chombo"; }
    kama (jina_linganisha(jina, "bafa_herufi")) { rudisha "andika_herufi_kwenye_chombo"; }
    kama (jina_linganisha(jina, "bafa_mfuatano")) { rudisha "andika_mfuatano_kwenye_chombo"; }
    kama (jina_linganisha(jina, "bafa_n64")) { rudisha "andika_n64_kwenye_chombo"; }
    kama (jina_linganisha(jina, "bafa_u64")) { rudisha "andika_u64_kwenye_chombo"; }
    kama (jina_linganisha(jina, "bits_ya_d64_swa")) { rudisha "biti_ya_d64_swa"; }
    kama (jina_linganisha(jina, "faili_bendera")) { rudisha "machaguo_ya_kufungua"; }
    kama (jina_linganisha(jina, "gcd_hesabu")) { rudisha "kigawo_kikuu_cha_shirika"; }
    kama (jina_linganisha(jina, "heshi_mfuatano")) { rudisha "heshi_ya_mfuatano"; }
    kama (jina_linganisha(jina, "isqrt_hesabu")) { rudisha "kipeuo_kamili"; }
    kama (jina_linganisha(jina, "lcm_hesabu")) { rudisha "kigawe_kidogo_cha_shirika"; }
    kama (jina_linganisha(jina, "orodha_urefu")) { rudisha "urefu_wa_orodha"; }
    kama (jina_linganisha(jina, "pow_kamili")) { rudisha "kipeo_kamili"; }
    kama (jina_linganisha(jina, "pow_mod_hesabu")) { rudisha "kipeo_kwa_baki"; }
    kama (jina_linganisha(jina, "sys_andika")) { rudisha "mfumo_andika"; }
    kama (jina_linganisha(jina, "sys_execve")) { rudisha "mfumo_tekeleza_programu"; }
    kama (jina_linganisha(jina, "sys_fork")) { rudisha "mfumo_gawanyika"; }
    kama (jina_linganisha(jina, "sys_funga")) { rudisha "mfumo_funga"; }
    kama (jina_linganisha(jina, "sys_fungua")) { rudisha "mfumo_fungua"; }
    kama (jina_linganisha(jina, "sys_kill")) { rudisha "mfumo_tuma_ishara"; }
    kama (jina_linganisha(jina, "sys_lseek")) { rudisha "mfumo_tafuta_nafasi"; }
    kama (jina_linganisha(jina, "sys_mkdir")) { rudisha "mfumo_unda_saraka"; }
    kama (jina_linganisha(jina, "sys_mmap")) { rudisha "mfumo_ramani_kumbukumbu"; }
    kama (jina_linganisha(jina, "sys_munmap")) { rudisha "mfumo_ondoa_ramani_kumbukumbu"; }
    kama (jina_linganisha(jina, "sys_nanosleep_sekunde")) { rudisha "mfumo_subiri_nano_sekunde"; }
    kama (jina_linganisha(jina, "sys_soma")) { rudisha "mfumo_soma"; }
    kama (jina_linganisha(jina, "sys_wait4")) { rudisha "mfumo_subiri4"; }
    kama (jina_linganisha(jina, "sys_wait4_msimbo_wa_kutoka")) { rudisha "mfumo_subiri4_msimbo_wa_kutoka"; }
    kama (jina_linganisha(jina, "sys_wait4_ulitoka_kwa_kawaida")) { rudisha "mfumo_subiri4_ulitoka_kwa_kawaida"; }
    rudisha 0;
}

n32 kazi_imefafanuliwa_kwenye_programu(n32 nodi_ya_programu, n8* jina) {
    n32 n = nodi_ya_kushoto[nodi_ya_programu];
    wakati (n != -1) {
        kama (aina_ya_nodi[n] == NODI_KAZI) {
            kama (jina_linganisha(ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kushoto[n]], jina)) { rudisha 1; }
        }
        n = nne_ya_nodi[n];
    }
    rudisha 0;
}

// Baada ya uchanganuzi: wito wa jina lililoondolewa ambalo programu
// haijalifafanua, au kiingilio main/anza bila anza, ni kosa.
// Inarudisha idadi ya makosa.
n32 kagua_majina_yaliyoondolewa(n32 nodi_ya_programu) {
    n32 makosa = 0;
    kama (kazi_imefafanuliwa_kwenye_programu(nodi_ya_programu, "anza") == 0) {
        kama (kazi_imefafanuliwa_kwenye_programu(nodi_ya_programu, "main")) {
            kataa_neno_la_zamani("main", "anza");
            makosa = makosa + 1;
        }
        kama (kazi_imefafanuliwa_kwenye_programu(nodi_ya_programu, "kernel_main")) {
            kataa_neno_la_zamani("kernel_main", "anza");
            makosa = makosa + 1;
        }
    }
    n32 i = 0;
    wakati (i < idadi_ya_nodi) {
        kama (aina_ya_nodi[i] == NODI_WITO) {
            n32 k = nodi_ya_kushoto[i];
            kama (k >= 0) { kama (aina_ya_nodi[k] == NODI_KITAMBULISHO) {
                n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[k];
                n8* jipya = jina_jipya_la_zamani(jina);
                kama (jipya != 0) { kama (kazi_imefafanuliwa_kwenye_programu(nodi_ya_programu, jina) == 0) {
                    kataa_neno_la_zamani(jina, jipya);
                    makosa = makosa + 1;
                } }
            } }
        }
        i = i + 1;
    }
    rudisha makosa;
}
