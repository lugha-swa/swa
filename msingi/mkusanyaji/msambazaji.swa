husisha { mkusanyaji/msomaji.swa }
husisha { maktaba/kumbukumbu.swa }
husisha { maktaba/mfuatano.swa }

// ==========================================================
// msambazaji.swa :: Mchanganuzi wa Swa wa kuteremka kwa kujirudia
// Kujitegemea -- huchanganua chanzo cha Swa kuwa AST ya safu-bapa.
// ==========================================================

// -------------------------------------------------------
// Viunga vya aina za nodi za AST
// -------------------------------------------------------
n32 MTI_PROGRAMU = 1;
n32 MTI_KAZI = 2;
n32 MTI_RUDISHA = 3;
n32 MTI_NAMBARI = 4;
n32 MTI_KITAMBULISHO = 5;
n32 MTI_JUMLISHA = 6;
n32 MTI_TOFAUTI = 7;
n32 MTI_WITO = 8;
n32 MTI_KAMA = 9;
n32 MTI_WAKATI = 10;
n32 MTI_TANGAZO = 11;
n32 MTI_MUUNDO = 12;
n32 MTI_SEHEMU = 13;
n32 MTI_CHAGUA = 14;
n32 MTI_HALI = 15;
n32 MTI_VUNJA = 16;
n32 MTI_ENDELEA = 17;
n32 MTI_ACHILIA = 19;
n32 MTI_SAWA = 20;
n32 MTI_TOFAUTI_SI = 21;
n32 MTI_CHINI = 22;
n32 MTI_JUU = 23;
n32 MTI_CHINI_SAWA = 24;
n32 MTI_JUU_SAWA = 25;
n32 MTI_NA = 26;
n32 MTI_AU = 27;
n32 MTI_SI = 28;
n32 MTI_TAJA = 29;
n32 MTI_KUMBUKA = 30;
n32 MTI_ZIDISHA = 31;
n32 MTI_GAWANYA = 32;
n32 MTI_SEHEMU_DOT = 33;
n32 MTI_SEHEMU_MSHALE = 34;
n32 MTI_TANGAZO_ULIMWENGU = 35;
n32 MTI_SIVYO = 36;
n32 MTI_ASIMILIA = 37;
n32 MTI_SAFU = 38;
n32 MTI_MFUATANO = 40;
n32 MTI_HAMISHA_KUSHOTO = 39;  // <<
n32 MTI_HAMISHA_KULIA = 41;  // >>
n32 MTI_BITI_AU = 42;  // |
n32 MTI_BITI_NA = 43;  // &
n32 MTI_CHAGUZI_TATU = 44;  // ? :
n32 MTI_HALISI_D = 45;  // desimali halisi (d64)
n32 MTI_BADILI = 48;  // badili(ptr, size) -> realloc
n32 MTI_MODULO = 49;  // asilimia (%)
n32 MTI_KIZUIZI = 50;  // kifungio cha ndani (hatua ya kwa)
n32 MTI_XOR = 46;  // ^ (AU ya biti za kipekee)
n32 MTI_KINYUME = 47;  // ~ (kanusha biti)

// -------------------------------------------------------
// Safu bapa za AST
// MUHIMU: 65536 (na kabla yake 16384) ziliwekwa kulingana na
// mahitaji ya KUJIKUSANYA MWENYEWE (~31k nodi) TU — si mradi wowote
// halisi wa mtumiaji. Mradi mkubwa wa kweli (mfano Dominion,
// mchezo.swa inayohusisha nguzo nzima ya moduli za mchezo katika
// faili moja) inaweza kuzidi 65536 kwa urahisi, ikisababisha
// node_mpya kurudisha -1 kimya (kabla ya rekebisho hili, jina la
// aina lilikatishwa kwa uwongo na hitilafu za mnyororo zisizoelezeka
// zilitokea). 1,048,576 inatoa nafasi kubwa zaidi ya mara 16 kuliko
// mahitaji ya kujikusanya, ikitarajiwa kutosha kwa miradi mikubwa
// zaidi ya Dominion pia. kvn_visited[] (uzalishaji.swa) na ir_*[]
// (mteremko.swa) zinahitaji ukubwa HUU HUU kwa sababu zinafahirishwa
// na node ID zilezile (angalia maoni humo).
// -------------------------------------------------------
n32 mti_aina[1048576];
n32 mti_thamani[1048576];
n32 mti_kushoto[1048576];
n32 mti_kulia[1048576];
n32 mti_tiga[1048576];
n32 mti_nne[1048576];
n32 mti_idadi = 0;
n32 vigezo_kwanza_ulimwengu = -1;
n32 vigezo_awali_ulimwengu = -1;

// MUHIMU: dimbwi hili (4MB awali) huhifadhi BAITI ZA MAANDISHI ya
// kila jina la kigezo/kazi/muundo/aina linaloonekana kwenye chanzo
// kilichotatuliwa -- mradi halisi mkubwa (mfano Dominion, mchezo.swa
// inayohusisha moduli 40+) linaweza kufikia kiwango hiki kwa
// urahisi. HAKUNA ukaguzi wa mipaka kwenye maandishi ya ast_pool[]
// (angalia changanua_aina_tokeni na kadhalika) -- kufurika hapo
// awali hakukuandika hitilafu safi, badala yake kuliandika KIMYA
// nje ya mpaka wa safu, kikiharibu kumbukumbu iliyofuata na
// kusababisha "aina isiyojulikana" ya UWONGO kwa aina zilizokuwa
// tayari zimefafanuliwa sahihi. 16,777,216 (16MB) inatoa nafasi ya
// mara 4 zaidi.
n8 mti_dimbwi[16777216];
// Nafasi 0 inahifadhiwa kama sentinel ya jina tupu: dimbwi huanza
// kwenye 1 (mfano wa kazi_jina_pool_wapi na var_pool_wapi). Zamani
// jina la kwanza liliishi kwenye 0 na aina ya kielekezi cha muundo
// wake ikawa -2(0+1)+1 = -1 — alama ileile ya "haijulikani" —
// hivyo hesabu ya kielekezi cha muundo wa kwanza ilibaki baiti
// (mdudu wa 2026-09-04: (p + 1)->y ilirudisha 0).
n32 mti_dimbwi_wapi = 1;
n32 mti_jina_ofseti[1048576];

// -------------------------------------------------------
// Muundo wa hali ya mchanganuzi
// -------------------------------------------------------
muundo Msambazaji {
    Msomaji msomaji;
    Tokeni sasa;
    Tokeni inayofuata;
    n32 kosa;
};

// -------------------------------------------------------
// Kitenzi-njia cha nodi ya AST -- hakuna ukaguzi wa mipaka (tabia iliyopo)
// -------------------------------------------------------
n32 nodi_mpya(n32 aina, n32 thamani, n32 kushoto, n32 kulia) {
    kama (mti_idadi >= 1048576) {
        // lugha-swa/swa#298 -- kama muundo_nodes[1024] (#189) na
        // kazi_jina_pool[131072] (#197), dimbwi hili ni jedwali
        // linaloendana na UKUBWA WA MRADI -- faili kubwa la kweli
        // (mfano Dominion) huweza kulifikia. ZAMANI (#199) wito huu
        // ulirudisha -1 KWA MAKUSUDI (badala ya kuandika nje ya
        // mipaka), LAKINI waitaji wengi wa node_mpya() hawakuangalia
        // matokeo haya kabla ya kuyatumia kama faharisi ya AST --
        // hatari iliyobaki wazi kwenye maoni ya #199 bila kufungwa
        // kweli. Badala ya kutegemea KILA mwitaji (kuna mamia)
        // kukagua -1, chanzo CHENYEWE sasa kinasimamisha ukusanyaji
        // mara moja -- sawa na andika_baiti() kwa bafa_text (#298).
        andika_stderr("KOSA: akiba ya nodi za AST (ast_aina/ast_thamani/...) imejaa (idadi=%d, aina ya nodi iliyoshindwa=%d) — chanzo (baada ya kutatua husisha zote) ni kikubwa mno kwa kikomo cha 1048576\n", mti_idadi, aina);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    n32 faharasa = mti_idadi;
    mti_aina[faharasa] = aina;
    mti_thamani[faharasa] = thamani;
    mti_kushoto[faharasa] = kushoto;
    mti_kulia[faharasa] = kulia;
    mti_tiga[faharasa] = -1;
    mti_nne[faharasa] = -1;
    mti_jina_ofseti[faharasa] = 0;
    mti_idadi = mti_idadi + 1;
    rudisha faharasa;
}

// Kukunja hakutumiki wakati kianzilishi cha kigezo cha ULIMWENGU
// kinachanganuliwa (weka 1 kabla, 0 baada -- angalia mahali
// inapowekwa kwenye tangazo la ulimwengu). Sababu: mwandishi wa data
// ya .data (uzalishaji.swa) HUKATAA KWA MAKUSUDI kianzilishi
// chochote ambacho SI tokeni ya nambari ya moja kwa moja (usemi wa
// hesabu kama "1 + 2" haujategemewa KABISA na utaratibu huo -- ni
// uamuzi wa usanifu, umeandikwa wazi kwenye maoni ya ukaguzi huo, SI
// kizuizi cha muda kilichosahaulika). Kukunja kwa uwazi kungeficha
// usemi kama huo ndani ya tokeni ya nambari KABLA ukaguzi huo
// haujaufikia, kikivunja jaribio la kudumu
// jaribio_mende_kianzio_usemi.swa (lililoandikwa MAKUSUDI kuzuia
// urudiaji wa mdudu wa kihistoria: "1 + 2" kama kianzilishi cha
// ulimwengu ilikuwa ikikubaliwa KIMYA na kuhifadhi 0 -- rekebisho la
// zamani lilifanya ikatae kwa sauti KWA MAKUSUDI, si kwa bahati).
n32 kunja_imezuiwa = 0;

// -------------------------------------------------------
// Kukunja mara kwa mara (constant folding): +, -, *, /, %
//
// Inatumika TU wakati PANDE ZOTE MBILI za operesheni ni tokeni za
// nambari HALISI za moja kwa moja (AST_NAMBARI, ast_kulia != 1 --
// SI usimbaji wa dimbwi la n64 kubwa, angalia changanua_nambari
// mahali linaloitangaza) -- hii inaepuka KABISA hitaji la
// kusimbua/kusimba upya baiti za dimbwi hilo, ambalo lingeongeza
// hatari isiyo ya lazima.
//
// Hesabu ya kukunja inafanyika kwa n64 (upana mpana wa kutosha
// kuepuka kufurika kwa KATI ya hesabu), lakini matokeo YANAHIFADHIWA
// TU kama yamo ndani ya WIGO KAMILI wa n32 (-2147483648 hadi
// 2147483647). Nje ya wigo huo (kufurika kwa kweli, kunakohitaji
// tabia ya "wraparound" ya x86 32-bit), HAIKUNJWI KABISA -- usemi
// unabaki bila kubadilika, ukikokotolewa wakati wa kukimbia (ambapo
// eax ya x86 hufanya wraparound sahihi kiotomatiki kwa vyovyote) --
// hii inaepuka hatari ya kuiga tabia ya wraparound VIBAYA ndani ya
// mkusanyaji mwenyewe. Ni upotezaji mdogo wa fursa ya uboreshaji
// (thamani kubwa sana hazikunjwi), si hatari ya usahihi.
//
// Mgawanyo/modulo kwa SIFURI HAIKUNJWI KAMWE -- inabaki hitilafu ya
// WAKATI WA KUKIMBIA (kama ilivyokuwa kabla), si kuanguka kimya au
// kusababisha hitilafu ya mkusanyaji wenyewe.
n32 jaribu_kunja_namba(n32 kitendo, n32 kushoto, n32 kulia) {
    kama (kunja_imezuiwa == 1) { rudisha -1; }
    kama (kushoto == -1 || kulia == -1) { rudisha -1; }
    kama (mti_aina[kushoto] != MTI_NAMBARI) { rudisha -1; }
    kama (mti_aina[kulia] != MTI_NAMBARI) { rudisha -1; }
    kama (mti_kulia[kushoto] == 1) { rudisha -1; }
    kama (mti_kulia[kulia] == 1) { rudisha -1; }
    n64 a = mti_thamani[kushoto];
    n64 b = mti_thamani[kulia];
    n64 matokeo = 0;
    kama (kitendo == MTI_JUMLISHA) { matokeo = a + b; }
    sivyo { kama (kitendo == MTI_TOFAUTI) { matokeo = a - b; }
        sivyo { kama (kitendo == MTI_ZIDISHA) { matokeo = a * b; }
            sivyo { kama (kitendo == MTI_GAWANYA) {
                    kama (b == 0) { rudisha -1; }
                    matokeo = a / b;
                } sivyo { kama (kitendo == MTI_MODULO) {
                        kama (b == 0) { rudisha -1; }
                        matokeo = a % b;
                    } sivyo { rudisha -1; } } } } }
    kama (matokeo > 2147483647) { rudisha -1; }
    n64 kikomo_chini = 0 - 2147483648;
    kama (matokeo < kikomo_chini) { rudisha -1; }
    n32 m32 = matokeo;
    rudisha nodi_mpya(MTI_NAMBARI, m32, -1, -1);
}

// -------------------------------------------------------
// Nakili jina/kamba ndani ya ast_pool na rekodi kukabilia kwake
// -------------------------------------------------------
w0 hifadhi_jina(n32 nodi_hii, n8* maandishi, n64 urefu) {
    // lugha-swa/swa#298 -- ukaguzi huu ULIKUWA ukitumia kikomo cha
    // ZAMANI (4194304, 4MB) BAADA ya ast_pool[] kuongezwa hadi 16MB
    // (16777216) kwa ajili ya #200 -- namba mbili zinazopaswa
    // kuendana (ukubwa wa tangazo la safu + ukaguzi wa kufurika)
    // zilitofautiana, sawa na somo la #197. Matokeo: majina ya
    // vitambulisho yalikataliwa KIMYA (hakuna hata ujumbe wa hitilafu
    // wa kawaida, ni "; DEB" tu) mara tu dimbwi lilipopita 4MB, licha
    // ya 12MB ya nafasi halisi iliyobaki -- node husika iliachwa na
    // ast_jina_off==0 (jina tupu), ikisababisha ulinganisho WA UONGO
    // wa majina baadaye. Sasa inatumia kikomo sahihi (16777216) na
    // inasimamisha ukusanyaji badala ya kuendelea kimya.
    kama (mti_dimbwi_wapi + urefu + 1 > 16777216) {
        n64 u = urefu;
        andika_stderr("KOSA: dimbwi la majina ya AST (ast_pool) limejaa (kikomo cha baiti 16777216, wapi=%d, urefu=%d)\n", mti_dimbwi_wapi, u);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    n32 ofseti = mti_dimbwi_wapi;
    mti_jina_ofseti[nodi_hii] = ofseti;
    mti_dimbwi_wapi = ofseti + urefu + 1;
    n32 i = 0;
    wakati (i < urefu) {
        mti_dimbwi[ofseti + i] = maandishi[i];
        i = i + 1;
    }
    mti_dimbwi[ofseti + urefu] = 0;
}

// -------------------------------------------------------
// Tafuta jina katika dimbwi la ast_pool — rudisha kianzio chake
// au 0 ikiwa hakipo. Hutumiwa kuhakikisha miundo inapata
// encoding thabiti kwa matumizi ya kurudia.
// -------------------------------------------------------
n32 tafuta_jina_dimbeni(n8* maandishi, n64 urefu) {
    // Pitia yaliyomo ya dimbwi kutoka mwanzo hadi ast_pool_wapi
    // kwa kuangalia mipaka ya \0 - hii ni rahisi na inafanya kazi
    n32 nafasi = 0;
    wakati (nafasi < mti_dimbwi_wapi) {
        n32 i = 0;
        wakati (i < urefu) {
            kama (mti_dimbwi[nafasi + i] != maandishi[i]) { vunja; }
            i = i + 1;
        }
        kama (i == urefu) {
            kama (mti_dimbwi[nafasi + urefu] == 0) {
                rudisha nafasi;
            }
        }
        // Ruka hadi '\0' inayofuata
        wakati (nafasi < mti_dimbwi_wapi && mti_dimbwi[nafasi] != 0) {
            nafasi = nafasi + 1;
        }
        kama (nafasi < mti_dimbwi_wapi) { nafasi = nafasi + 1; }
    }
    rudisha -1;
}

// -------------------------------------------------------
// Kitenzi-njia -- anzisha utazamaji wa tokeni
// -------------------------------------------------------
// jina_linganisha: 1 ikiwa maandishi mawili (0 mwishoni) ni sawa. Iko hapa
// (si uzalishaji.swa) kwa sababu msambazaji huitumia, na moduli za juu
// (mkaguzi, uzalishaji, uzalishaji_wasm) huipata kupitia msambazaji.
n32 jina_linganisha(n8* a, n8* b) {
    wakati (a[0] != 0 && b[0] != 0) {
        kama (a[0] != b[0]) { rudisha 0; }
        a = a + 1;
        b = b + 1;
    }
    rudisha (a[0] == b[0]);
}

Msambazaji msambazaji_mpya(n8* chanzo, n64 urefu) {
    Msambazaji p;
    p.msomaji = msomaji_mpya(chanzo, urefu);
    p.kosa = 0;
    tokeni_inayofuata(&p.sasa, &p.msomaji);
    tokeni_inayofuata(&p.inayofuata, &p.msomaji);
    rudisha p;
}

// -------------------------------------------------------
// Songeza tokeni moja
// -------------------------------------------------------
w0 sogeza(Msambazaji* p) {
    p->sasa.aina = p->inayofuata.aina;
    p->sasa.mwanzo = p->inayofuata.mwanzo;
    p->sasa.urefu = p->inayofuata.urefu;
    p->sasa.mstari = p->inayofuata.mstari;
    p->sasa.safu = p->inayofuata.safu;
    tokeni_inayofuata(&p->inayofuata, &p->msomaji);
}

// -------------------------------------------------------
// Ruka tokeni hadi kwenye kifikisha (';', '}', au EOF).
// Hairuki kifikisha chenyewe — mpigaji anaamua la kufanya.
// Rudisha: 1 = ';', 2 = '}', 0 = EOF
// -------------------------------------------------------
n32 ruka_hadi_kifikisha(Msambazaji* p) {
    wakati (p->sasa.urefu != 0) {
        // Angalia kama tokeni ya sasa ni kifikisha
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, ";")) { rudisha 1; }
            kama (neno_ni(&p->sasa, "}")) { rudisha 2; }
        }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ";")) { rudisha 1; }
        sogeza(p);
    }
    rudisha 0;  // EOF
}

// -------------------------------------------------------
// Tarajia tokeni ya aina fulani; tumia ikifaulu
// -------------------------------------------------------
n32 tarajia(Msambazaji* p, n32 aina_tokeni) {
    kama (p->sasa.aina == aina_tokeni) { sogeza(p); rudisha 1; }
    p->kosa = 1;
    rudisha 0;
}

// -------------------------------------------------------
// Angalia kama tokeni inalingana kimaandishi na kamba fulani.
// KUMBUKA: inalinganisha hadi t->urefu baiti pekee, hivyo waitaji
// wanaolinganisha dhidi ya waendeshaji wa herufi-nyingi LAZIMA
// pia waangalie kwamba urefu wa tokeni unalingana.
// -------------------------------------------------------
n32 neno_ni(Tokeni * t, n8* neno) {
    kama (t->urefu == 0) { rudisha 0; }
    n64 i = 0;
    wakati (i < t->urefu) {
        kama (t->mwanzo[i] != neno[i]) { rudisha 0; }
        i = i + 1;
    }
    // Hakikisha neno pia lina urefu sawa
    kama (neno[i] != 0) { rudisha 0; }
    rudisha 1;
}

// -------------------------------------------------------
// Neno muhimu? Hati 2.2: maneno muhimu hayawezi kutumika kama
// majina ya vitambulisho. Orodha kamili ya maneno 13: muundo,
// rudisha, kama, sivyo, wakati, kwa, fanya, vunja, endelea,
// chagua, hali, husisha, achilia. Rudisha 1 ikiwa tokeni ni
// neno muhimu.
// -------------------------------------------------------
n32 tokeni_ni_muhimu(Tokeni* t) {
    kama (t->urefu < 3) { rudisha 0; }  // maneno muhimu yote yana angalau herufi 3
    kama (neno_ni(t, "muundo")) { rudisha 1; }
    kama (neno_ni(t, "rudisha")) { rudisha 1; }
    kama (neno_ni(t, "kama")) { rudisha 1; }
    kama (neno_ni(t, "sivyo")) { rudisha 1; }
    kama (neno_ni(t, "wakati")) { rudisha 1; }
    kama (neno_ni(t, "kwa")) { rudisha 1; }
    kama (neno_ni(t, "fanya")) { rudisha 1; }
    kama (neno_ni(t, "vunja")) { rudisha 1; }
    kama (neno_ni(t, "endelea")) { rudisha 1; }
    kama (neno_ni(t, "chagua")) { rudisha 1; }
    kama (neno_ni(t, "hali")) { rudisha 1; }
    kama (neno_ni(t, "husisha")) { rudisha 1; }
    kama (neno_ni(t, "achilia")) { rudisha 1; }
    rudisha 0;
}

// Kataa tokeni iliyopo ikiwa ni neno muhimu linalotumiwa kama
// jina (hati 2.2) — kosa la sauti lenye ujumbe wa Kiswahili.
// Rudisha 1 ikiwa ilikataliwa (p->kosa imewekwa), 0 ikiwa halali.
n32 kataa_neno_muhimu(Msambazaji* p) {
    kama (tokeni_ni_muhimu(&p->sasa) == 0) { rudisha 0; }
    n8 bafa_muhimu[64];
    n32 bi = 0;
    wakati (bi < p->sasa.urefu && bi < 63) {
        bafa_muhimu[bi] = p->sasa.mwanzo[bi];
        bi = bi + 1;
    }
    bafa_muhimu[bi] = 0;
    andika_stderr("kosa: '%s' ni neno muhimu — haliwezi kutumika kama jina\n", bafa_muhimu);
    p->kosa = 1;
    rudisha 1;
}

// -------------------------------------------------------
// Badilisha tokeni ya nambari kuwa thamani n32
// -------------------------------------------------------
n32 tokeni_kwa_nambari(n8* mwanzo, n64 urefu) {
    n32 n = 0;
    n32 i = 0;
    wakati (i < urefu) {
        n8 c = mwanzo[i];
        kama (c >= 48) {
            kama (c <= 57) { n = n * 10 + c - 48; }
        }
        i = i + 1;
    }
    rudisha n;
}

// Kama tokeni_kwa_nambari, lakini inarudisha n64 kamili — inaweza
// kubeba thamani zaidi ya 2147483647 (vipimo vya baiti 8).
n64 tokeni_kwa_nambari_n64(n8* mwanzo, n64 urefu) {
    n64 n = 0;
    n32 i = 0;
    wakati (i < urefu) {
        n8 c = mwanzo[i];
        kama (c >= 48) {
            kama (c <= 57) { n = n * 10 + c - 48; }
        }
        i = i + 1;
    }
    rudisha n;
}

// -------------------------------------------------------
// Uainishaji wa majina ya aina
// -------------------------------------------------------

n32 ni_aina_tokeni(Tokeni * t) {
    kama (t->urefu < 1) { rudisha 0; }
    n8 c0 = t->mwanzo[0];
    kama (c0 >= 65) {
        kama (c0 <= 90) { rudisha 1; }
    }
    // MUHIMU: kiambishi cha herufi ndogo cha aina ya msingi (n32, d64,
    // n.k.) LAZIMA kikubaliwe hapa PIA -- lakini kwa UANGALIFU: si kila
    // kitambulisho cha herufi ndogo, ni MFUATANO KAMILI unaolingana na
    // muundo wa aina ya msingi (herufi moja ya [n|a|d|b|w] ikifuatiwa
    // na tarakimu TU). ni_aina_msingi_pia_ndogo (chini) inafanya
    // ukaguzi huu HASA -- tumia moja kwa moja badala ya kurudia mantiki
    // hapa. Kitambulisho cha kawaida cha herufi ndogo (mfano "mfano",
    // "jumla", "piga_kelele") halilingani muundo huu na HALIINGII
    // njia hii. TUMIA HAPA TU (nafasi ya kutangaza aina) -- SI kwenye
    // ukaguzi wa "jina la aina halitumiki kama usemi" (ni_jina_la_aina,
    // chini), kwa sababu hazina hii YENYEWE ina vitambulisho vingi vya
    // ndani vya herufi ndogo vinavyolingana muundo huu bila kukusudia
    // kuwa aina (a1..a6 -- hoja za kazi za printf-kama; b1/b2/b3 --
    // baiti zilizogawanywa kwenye hesabu) -- kuvikataza kama "usemi"
    // kunavunja kujikusanya kwa hazina hii YENYEWE. Angalia maelezo
    // kamili kwenye ni_aina_msingi_pia_ndogo.
    kama (ni_aina_msingi_pia_ndogo(t->mwanzo, t->urefu)) { rudisha 1; }
    // Jina la muundo la herufi ndogo (#285) -- tangazo lake lolote
    // kwenye chanzo, hata kama liko BAADA ya hapa.
    kama (ni_jina_la_muundo_awali(t)) { rudisha 1; }
    rudisha 0;
}

n32 ni_aina_msingi(n8* txt, n64 n) {
    kama (n < 2) { rudisha 0; }
    n8 c0 = txt[0];
    kama (c0 < 65 || c0 > 90) { rudisha 0; }
    n64 j = 1;
    wakati (j < n) {
        n8 c = txt[j];
        kama (c < 48 || c > 57) { rudisha 0; }
        j = j + 1;
    }
    rudisha 1;
}

// Jina la aina ya msingi, herufi NDOGO PEKEE (herufi kubwa
// imeondolewa -- uamuzi wa msimamizi baada ya Awamu C kukamilika,
// angalia hati/mipaka.md). n32 na N32 hazikuwa aina mbili tofauti
// kabla ya uondoaji huu (zilitoa familia/upana SAWA), na sasa N32
// haitambuliwi KABISA kama jina la aina (angalia changanua_aina_tokeni
// chini).
//
// MUHIMU: umezuiliwa KIMAKUSUDI kwa herufi TANO za familia halisi
// (n, a, d, b, w) TU -- SI herufi yoyote ya alfabeti. Kuruhusu HERUFI
// YOYOTE (si tano hizi tu) kungegonga vitambulisho vingi HALISI vya
// ndani ya hazina hii yenyewe (iligunduliwa kwa majaribio HALISI, si
// dhana: "h2" -- kigezo cha kawaida cha ndani cha uzalishaji.swa --
// kililingana kimakosa na muundo huu kabla ya kuzuiliwa kwa herufi
// tano, likivunja kujikusanya kwa hazina hii yenyewe kwa hitilafu ya
// uwongo "jina la aina halifuatwi na jina la kigeu").
n32 ni_aina_msingi_pia_ndogo(n8* txt, n64 n) {
    kama (n < 2) { rudisha 0; }
    n8 c0 = txt[0];
    n32 ni_ndogo = (c0 == 110 || c0 == 97 || c0 == 100 || c0 == 98 || c0 == 119);  // n a d b w
    kama (ni_ndogo == 0) { rudisha 0; }
    n64 j = 1;
    wakati (j < n) {
        n8 c = txt[j];
        kama (c < 48 || c > 57) { rudisha 0; }
        j = j + 1;
    }
    rudisha 1;
}

n32 encode_aina(n32 familia, n32 upana, n32 mshale) {
    // Hesabu ya / na % (mbegu ina hitilafu katika & na |)
    rudisha ((familia % 256) * 256) + (upana % 256) + (mshale % 4);
}

// Alama ya muktadha: tuko ndani ya hoja za ukubwa(...) — mahali
// pekee jina la aina linapokubalika kama usemi (kipimo cha aina).
n32 ukubwa_hoja = 0;

// Jina la aina? Aina za nambari hufuata muundo [N|A|D|B|W]+tarakimu
// (mf. n32, d64, w0, n32, d64, w0), na miundo ya mtumiaji
// inajulikana kupitia akiba ya miundo iliyokamilika.
//
// MUHIMU: kazi hii ina MATUMIZI MOJA TU -- kuamua kama taarifa
// inayoanza na tokeni hii YAWEZEKANA ni TANGAZO LA KIGEU (mfano
// "n32 x = 5;"), SI ukaguzi wa "jina la aina halitumiki kama usemi"
// (ukaguzi huo upo KANDA, moja kwa moja ndani ya mchanganuzi wa
// usemi wa msingi, ukiwa umekusudia kubaki herufi KUBWA TU -- angalia
// maelezo kwenye ni_aina_msingi_pia_ndogo hapo juu kwa sababu kamili).
// Hapa, kwa upande mwingine, tunahitaji herufi ndogo ZITAMBULIWE
// kikamilifu, la sivyo "n32 x = 5;" haiwahi kutambuliwa kama tangazo
// kabisa -- kazi hii inaitwa TU kwenye nafasi ya mwanzo wa taarifa
// (statement dispatch), si kila mahali kitambulisho kinapoonekana.
n32 ni_jina_la_aina(Tokeni* t) {
    kama (ni_aina_msingi_pia_ndogo(t->mwanzo, t->urefu)) { rudisha 1; }
    kama (ni_jina_la_muundo_awali(t)) { rudisha 1; }
    n32 mi = 0;
    wakati (mi < muundo_ukubwa_idadi) {
        n8* mj = muundo_ukubwa_jina[mi];
        n32 j = 0;
        n32 lingana = 1;
        wakati (j < t->urefu) {
            kama (mj[j] != t->mwanzo[j]) { lingana = 0; vunja; }
            j = j + 1;
        }
        kama (lingana) {
            kama (mj[j] == 0) { rudisha 1; }
        }
        mi = mi + 1;
    }
    rudisha 0;
}

n32 changanua_aina_tokeni(Msambazaji* p) {
    kama (ni_aina_tokeni(&p->sasa) == 0) { rudisha 0; }
    n8* txt = p->sasa.mwanzo;
    n64 n = p->sasa.urefu;
    n32 familia = 0;
    n32 upana = 0;
    n32 mshale = 0;
    kama (ni_aina_msingi_pia_ndogo(txt, n)) {
        n8 c0 = txt[0];
        // Herufi ndogo PEKEE (herufi kubwa imeondolewa).
        kama (c0 == 110) { familia = 1; }  // n
        kama (c0 == 97) { familia = 2; }  // a
        kama (c0 == 100) { familia = 3; }  // d
        kama (c0 == 98) { familia = 4; }  // b
        kama (c0 == 119) { familia = 5; }  // w
    }
    kama (familia == 0) { familia = 6; }  // muundo wa mtumiaji
    kama (familia != 6) {
        n32 w = 0;
        n32 j = 1;
        wakati (j < n) {
            n8 ch = txt[j];
            kama (ch >= 48) {
                kama (ch <= 57) { w = w * 10 + ch - 48; }
            }
            j = j + 1;
        }
        upana = w;
        // Hati 3 inaahidi upana 8/16/32/64 pekee; w0 (upana 0) ni tupu
        // ya familia W. N128, D80, A128 n.k. zilikubalika kimya na
        // kutoa msimbo usio na maana — kataa kwa sauti kama mbegu
        // ("aina isiyojulikana").
        kama (upana != 8) {
            kama (upana != 16) {
                kama (upana != 32) {
                    kama (upana != 64) {
                        kama ((upana != 0 || familia != 5) && (upana != 1 || familia != 4)) {
                            n8 bafa_jina[64];
                            n32 bi = 0;
                            wakati (bi < n && bi < 63) {
                                bafa_jina[bi] = txt[bi];
                                bi = bi + 1;
                            }
                            bafa_jina[bi] = 0;
                            andika_stderr("kosa: aina isiyojulikana: %s\n", bafa_jina);
                            p->kosa = 1;
                            rudisha -1;
                        }
                    }
                }
            }
        }
    }
    // b1 (biti moja) husimbwa kwa alama ya upana 12 -- angalia B1_ENC kwenye
    // mkaguzi.swa: upana 1 ungegongana na biti ya mshale.
    kama (familia == 4 && upana == 1) { upana = 12; }
    sogeza(p);
    // '*' kama kiendeshi cha herufi-moja kinaweza kukosa aina ISHARA kutoka kwa mchanganuaji.
    // Tumia utambuzi wa njia-mbili kushughulikia kesi zote kwa uhakika.
    n32 ni_mshale = 0;
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, "*")) { ni_mshale = 1; sogeza(p); }
    }
    kama (ni_mshale == 0) {
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "*")) { ni_mshale = 1; sogeza(p); }
    }
    // Shughulikia viashiria vingi: n8** n.k.
    // Mshale wa pili unahifadhiwa kama biti 1 (mshale = 3 inamaanisha **).
    n32 ni_mshale_pili = 0;
    kama (ni_mshale) {
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "*")) { ni_mshale_pili = 1; sogeza(p); }
        }
        kama (ni_mshale_pili == 0) {
            kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "*")) { ni_mshale_pili = 1; sogeza(p); }
        }
    }
    mshale = ni_mshale + (ni_mshale_pili * 2);
    // Kwa miundo ya mtumiaji, tumia encoding hasi inayobeba pia kianzio
    // cha jina kwenye dimbwi. Hii inaruhusu ukubwa_kutoka_enc kupata
    // ukubwa halisi wa muundo husika wakati wa uzalishaji.
    kama (familia == 6) {
        n32 ofseti = tafuta_jina_dimbeni(txt, n);
        kama (ofseti == -1) {
            ofseti = mti_dimbwi_wapi;
            kama (ofseti + n + 1 >= 16777216) {
                // lugha-swa/swa#298 -- kurudisha 0 kimya hapa
                // kungeharibu usimbaji wa aina ya muundo huu KIMYA
                // (0 ni usimbaji batili/tofauti kabisa na jina sahihi
                // la dimbwi), ikisababisha ukubwa/ofseti za field
                // kuhesabiwa vibaya baadaye bila hitilafu ya kukusanya.
                andika_stderr("KOSA: dimbwi la majina ya AST (ast_pool) limejaa (jina la muundo, kikomo cha baiti 16777216, wapi=%d)\n", ofseti);
                wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
            }
            n32 i = 0;
            wakati (i < n) {
                mti_dimbwi[ofseti + i] = txt[i];
                i = i + 1;
            }
            mti_dimbwi[ofseti + i] = 0;
            mti_dimbwi_wapi = ofseti + n + 1;
        }
        rudisha (-((ofseti + 1) * 2)) + mshale;
    }
    rudisha encode_aina(familia, upana, mshale);
}

// -------------------------------------------------------
// Matangazo ya mbele kwa vitenzi-njia vinavyojirudia kwa pande-mbili
// -------------------------------------------------------
n32 changanua_usemi(Msambazaji* p);
n32 changanua_taarifa(Msambazaji* p);
n32 changanua_taarifa_kama(Msambazaji* p);
n32 changanua_taarifa_wakati(Msambazaji* p);
n32 changanua_taarifa_fanya(Msambazaji* p);
n32 changanua_taarifa_chagua(Msambazaji* p);
n32 changanua_taarifa_kwa(Msambazaji* p);
n32 changanua_taarifa_tangazo(Msambazaji* p);
n32 changanua_taarifa_ndani(Msambazaji* p);
n32 changanua_kazi(Msambazaji* p);
n32 changanua_kazi_vigezo(Msambazaji* p);
n32 changanua_kazi_mwili(Msambazaji* p);
n32 changanua_muundo(Msambazaji* p);
n32 changanua_usemi_hamisha(Msambazaji* p);
n32 changanua_usemi_biti_na(Msambazaji* p);
n32 changanua_usemi_biti_au(Msambazaji* p);
n32 changanua_usemi_chaguzi_tatu(Msambazaji* p);

// ==========================================================
// MCHANUZI WA USEMI -- kupanda kwa utangulizi
// ==========================================================

// -------------------------------------------------------
// MSINGI :: halisi, vitambulisho, ( usemi ), { orodha-anzisha },
//            kiambishi si (kukanusha kimantiki), sizeof iliyojengewa
// -------------------------------------------------------
n32 changanua_taarifa_kama(Msambazaji* p) {
    // ---- kama ( hali ) bloku [ sivyo bloku ] ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "kama")) {
            sogeza(p);
            // Hali
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "(")) { sogeza(p); }
            }
            n32 sharti = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
            }

            // Mwili-wa-ndiyo -- bloku au taarifa moja
            n32 basi_mwili = -1;
            kama (p->sasa.mwanzo[0] == 123) {
                basi_mwili = changanua_bloku(p);
            } sivyo {
                basi_mwili = changanua_taarifa(p);
            }

            // Kifungu cha sivyo cha hiari (else) — bloku { } au taarifa
            // moja (semantiki ya C, sawa na mwili wa kama). Zamani
            // mwili bila mabano ulirudi -1 kimya na taarifa ilielea
            // nje kama taarifa isiyo na masharti (mdudu wa 2026-09-01).
            // Tawi-jingine huandikwa kwa kuingiza kama ndani ya sivyo
            // (hakuna "sivyo kama").
            n32 else_mwili = -1;
            kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
                kama (neno_ni(&p->sasa, "sivyo")) {
                    sogeza(p);
                    kama (p->sasa.mwanzo[0] == 123) {
                        else_mwili = changanua_bloku(p);
                    } sivyo {
                        else_mwili = changanua_taarifa(p);
                        // Mwili usio halali (si bloku wala taarifa) —
                        // kosa la sauti badala ya kumeza kimya.
                        kama (else_mwili == -1) { p->kosa = 1; }
                    }
                }
            }

            n32 kama_nodi = nodi_mpya(MTI_KAMA, 0, sharti, basi_mwili);
            kama (else_mwili != -1) {
                n32 sivyo_nodi = nodi_mpya(MTI_SIVYO, 0, else_mwili, -1);
                mti_tiga[kama_nodi] = sivyo_nodi;
            }
            rudisha kama_nodi;
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_wakati(Msambazaji* p) {
    // ---- wakati ( hali ) bloku ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "wakati")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "(")) { sogeza(p); }
            }
            n32 sharti = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
            }

            n32 mwili = -1;
            kama (p->sasa.mwanzo[0] == 123) {
                mwili = changanua_bloku(p);
            } sivyo {
                mwili = changanua_taarifa(p);
            }

            rudisha nodi_mpya(MTI_WAKATI, 0, sharti, mwili);
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_fanya(Msambazaji* p) {
    // ---- fanya { mwili } wakati ( sharti ) ; ----
    // Kitanzi cha fanya (do-while): mwili hukimbia mara moja kabla
    // ya sharti kujaribiwa. Nodi yake ni AST_WAKATI yenye alama
    // -777778 kwenye ast_thamani (0 = wakati, -777777 = kwa yenye
    // hatua) — uzalishaji ndiye anayesoma alama hiyo, na mkaguzi
    // anachunguza fanya sawa na wakati (kitanzi: vunja na endelea
    // ni halali ndani yake; endelea inaruka hadi sharti).
    // Muundo ni MKALI — mabano ya mwili, ya sharti, na nukta-mkato
    // ni ya lazima (sawa na mbegu).
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "fanya")) {
            sogeza(p);
            // Mwili: mabano ya wima { } ni ya lazima
            kama (p->sasa.mwanzo[0] == 123) {
                n32 mwili = changanua_bloku(p);
                // Kifungio tupu { } kinarudisha -1 kama mwili halali
                // usio na taarifa — p->kosa ndiyo ishara ya kosa.
                kama (p->kosa) { rudisha -1; }
                // Kifungu cha sharti: wakati ( sharti )
                kama (neno_ni(&p->sasa, "wakati")) {
                    sogeza(p);
                } sivyo {
                    andika_stderr("kosa: 'fanya' inahitaji 'wakati ( sharti ) ;' baada ya mwili\n");
                    p->kosa = 1;
                    rudisha -1;
                }
                kama (neno_ni(&p->sasa, "(")) {
                    sogeza(p);
                } sivyo {
                    andika_stderr("kosa: mabano ya sharti ya 'fanya' hayapo: wakati ( sharti )\n");
                    p->kosa = 1;
                    rudisha -1;
                }
                n32 sharti = changanua_usemi(p);
                kama (sharti == -1) {
                    p->kosa = 1;
                    rudisha -1;
                }
                kama (neno_ni(&p->sasa, ")")) {
                    sogeza(p);
                } sivyo {
                    andika_stderr("kosa: mabano ya sharti ya 'fanya' hayajafungwa: wakati ( sharti )\n");
                    p->kosa = 1;
                    rudisha -1;
                }
                // Nukta-mkato ya mwisho ni ya lazima (semantiki ya C)
                kama (neno_ni(&p->sasa, ";")) {
                    sogeza(p);
                } sivyo {
                    andika_stderr("kosa: 'fanya' inahitaji nukta-mkato ';' baada ya 'wakati ( sharti )'\n");
                    p->kosa = 1;
                    rudisha -1;
                }
                rudisha nodi_mpya(MTI_WAKATI, -777778, sharti, mwili);
            }
            andika_stderr("kosa: mwili wa 'fanya' lazima uwe kwenye mabano ya wima { }\n");
            p->kosa = 1;
            rudisha -1;
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_chagua(Msambazaji* p) {
    // ---- chagua ( usemi ) { hali X : ... [hali Y : ...] [sivyo : ...] } ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "chagua")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "(")) { sogeza(p); }
            }
            n32 imepimwa = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
            }

            tarajia(p, TOKENI_ISHARA);  // {

            n32 kwanza_case = -1;
            n32 awali_case = -1;
            n32 chaguo_msingi_mwili = -1;  // mwili wa sivyo (chaguo-msingi)

            wakati (1 == 1) {
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, "}")) { sogeza(p); vunja; }
                }
                kama (p->sasa.urefu == 0) { p->kosa = 1; vunja; }

                kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
                    kama (neno_ni(&p->sasa, "hali")) {
                        sogeza(p);
                        n32 lebo_usemi = changanua_usemi(p);
                        // Tarajia :
                        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                            kama (neno_ni(&p->sasa, ":")) { sogeza(p); }
                        }

                        // Kusanya taarifa mpaka hali/sivyo inayofuata au }
                        n32 case_kwanza = -1;
                        n32 case_awali = -1;
                        wakati (1 == 1) {
                            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                                kama (neno_ni(&p->sasa, "}")) { vunja; }
                            }
                            kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
                                kama (neno_ni(&p->sasa, "hali") || neno_ni(&p->sasa, "sivyo")) { vunja; }
                            }
                            kama (p->sasa.urefu == 0) { p->kosa = 1; vunja; }
                            n32 taarifa = changanua_taarifa(p);
                            kama (taarifa == -1) { p->kosa = 1; vunja; }
                            kama (case_awali == -1) { case_kwanza = taarifa; }
                            sivyo { mti_nne[case_awali] = taarifa; }
                            case_awali = taarifa;
                        }

                        n32 hali_nodi = nodi_mpya(MTI_HALI, 0, lebo_usemi, case_kwanza);
                        kama (awali_case == -1) { kwanza_case = hali_nodi; }
                        sivyo { mti_nne[awali_case] = hali_nodi; }
                        awali_case = hali_nodi;
                        endelea;
                    }
                    kama (neno_ni(&p->sasa, "sivyo")) {
                        sogeza(p);
                        // Tarajia :
                        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                            kama (neno_ni(&p->sasa, ":")) { sogeza(p); }
                        }

                        // Kusanya taarifa mpaka hali/sivyo inayofuata au }
                        n32 def_kwanza = -1;
                        n32 def_awali = -1;
                        wakati (1 == 1) {
                            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                                kama (neno_ni(&p->sasa, "}")) { vunja; }
                            }
                            kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
                                kama (neno_ni(&p->sasa, "hali") || neno_ni(&p->sasa, "sivyo")) { vunja; }
                            }
                            kama (p->sasa.urefu == 0) { p->kosa = 1; vunja; }
                            n32 taarifa = changanua_taarifa(p);
                            kama (taarifa == -1) { p->kosa = 1; vunja; }
                            kama (def_awali == -1) { def_kwanza = taarifa; }
                            sivyo { mti_nne[def_awali] = taarifa; }
                            def_awali = taarifa;
                        }

                        chaguo_msingi_mwili = def_kwanza;
                        endelea;
                    }
                }
                vunja;
            }

            n32 chagua_nodi = nodi_mpya(MTI_CHAGUA, 0, imepimwa, kwanza_case);
            mti_tiga[chagua_nodi] = chaguo_msingi_mwili;  // mwili wa sivyo (chaguo-msingi)
            rudisha chagua_nodi;
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_kwa(Msambazaji* p) {
    // ---- kwa ( anzisha ; hali ; hatua ) bloku   (kitanzi cha kwa) ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "kwa")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "(")) { sogeza(p); }
            }

            // anzisha (tangazo, usemi, au tupu)
            n32 kianzio = -1;
            kama (p->sasa.mwanzo[0] == 59) {
                sogeza(p);  // anzisha tupu: kwa (; hali; hatua)
            } sivyo {
                // Jaribu tangazo la ndani kwanza (mf. n32 i = 0)
                kianzio = changanua_taarifa_tangazo(p);
                kama (kianzio == -1) {
                    // Jaribu usemi (mf. i = 0)
                    kianzio = changanua_usemi(p);
                    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                        kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
                    }
                }
            }

            // hali (usemi au tupu)
            n32 sharti = -1;
            kama (p->sasa.mwanzo[0] == 59) {
                sogeza(p);
            } sivyo {
                sharti = changanua_usemi(p);
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
                }
            }

            // hatua (usemi au tupu)
            n32 hatua_ya_kitanzi = -1;
            kama (p->sasa.mwanzo[0] == 41) {
                sogeza(p);
            } sivyo {
                hatua_ya_kitanzi = changanua_usemi(p);
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
                }
            }

            // mwili
            n32 mwili = -1;
            kama (p->sasa.mwanzo[0] == 123) {
                mwili = changanua_bloku(p);
            } sivyo {
                mwili = changanua_taarifa(p);
            }

            // Ondoa sukari ya kitanzi-cha-kwa kuwa taarifa ya anzisha ikifuatiwa na kitanzi cha wakati.
            // Kitanzi cha wakati hufunga hali + (mwili + hatua iliyoambatishwa mwishoni mwa mwili).
            // Hatua imefungwa kwenye block-mini yenye alama -777777 kwenye
            // ast_kulia (kulia ya block huwa -1 kamwe — hakuna mgongano).
            // Uzalishaji_block hurekodi nafasi yake kwa ajili ya endelea
            // (semantiki ya C: endelea inaruka kwenye hatua, si kwenye hali).
            n32 ina_hatua = 0;
            kama (hatua_ya_kitanzi != -1) {
                ina_hatua = 1;
                n32 hatua_kizuizi = nodi_mpya(MTI_KIZUIZI, 0, hatua_ya_kitanzi, -1);
                mti_kulia[hatua_kizuizi] = -777777;
                kama (mwili != -1) {
                    // Tafuta taarifa ya mwisho kwenye mnyororo wa mwili.
                    n32 mwisho = mwili;
                    wakati (mti_nne[mwisho] != -1) { mwisho = mti_nne[mwisho]; }
                    mti_nne[mwisho] = hatua_kizuizi;
                } sivyo {
                    mwili = hatua_kizuizi;
                }
            }

            n32 wakati_nodi = nodi_mpya(MTI_WAKATI, ina_hatua ? -777777 : 0, sharti, mwili);

            // Hifadhi anzisha kwenye ast_tiga (huepuka kufutwa na msururu wa taarifa za ngazi-ya-juu)
            kama (kianzio != -1) {
                mti_tiga[wakati_nodi] = kianzio;
            }

            rudisha wakati_nodi;
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_tangazo(Msambazaji* p) {
    // ---- Tangazo la ndani lenye kiambishi cha aina: n32 x ;  /  n32 x = usemi ; ----
    // Pia hushughulikia matamko mengi: n32 a, b, c;
    //
    // C-semantiki ya kutofautisha tangazo na usemi: jina la aina
    // likifuatiwa na jina la kigeu (baada ya viashiria) → tangazo.
    // Likifuatiwa na '=', kiendeshi, au ';' → taarifa ya usemi.
    // Hii inaruhusu kigezo chenye jina linaloanza na herufi kubwa
    // kupewa thamani: n32 G = 1; G = 5;
    kama (ni_jina_la_aina(&p->sasa)) {
        // Tazama mbele kwa tokeni inayofuata jina la aina na nyota
        // zake — hakuna urejeshaji wa vitenzi; rejesha hali kamili.
        // Hifadhi sehemu moja-moja: kianzio cha kigeu cha muundo
        // kutoka kwa sehemu haijulikani zamani kwa dereva wa Rust
        // (memcpy inachukua thamani ya kwanza kama anwani na kuanguka).
        // Dereva umehamishiwa lugha-swa/swa-dereva (kumbukumbu).
        n32 ni_tangazo = 0;
        n64 nafasi_iliyohifadhiwa = p->msomaji.nafasi;
        n32 mstari_uliohifadhiwa = p->msomaji.mstari;
        n32 safu_iliyohifadhiwa = p->msomaji.safu;
        Tokeni sasa_iliyohifadhiwa;
        sasa_iliyohifadhiwa.aina = p->sasa.aina;
        sasa_iliyohifadhiwa.mwanzo = p->sasa.mwanzo;
        sasa_iliyohifadhiwa.urefu = p->sasa.urefu;
        sasa_iliyohifadhiwa.mstari = p->sasa.mstari;
        sasa_iliyohifadhiwa.safu = p->sasa.safu;
        Tokeni ifuatayo_iliyohifadhiwa;
        ifuatayo_iliyohifadhiwa.aina = p->inayofuata.aina;
        ifuatayo_iliyohifadhiwa.mwanzo = p->inayofuata.mwanzo;
        ifuatayo_iliyohifadhiwa.urefu = p->inayofuata.urefu;
        ifuatayo_iliyohifadhiwa.mstari = p->inayofuata.mstari;
        ifuatayo_iliyohifadhiwa.safu = p->inayofuata.safu;
        sogeza(p);  // tumia jina la aina kwa jaribio
        // Ruka viashiria vya herufi moja: Jina* j;  /  Jina** j;
        wakati (p->sasa.urefu == 1 && p->sasa.mwanzo[0] == 42) { sogeza(p); }
        // MUHIMU: >=65 peke yake HAITOSHI -- baadhi ya alama za ishara
        // (mfano '[' = 91, ']' = 93, '{' = 123, '}' = 125) ziko juu ya
        // 65 kimahesabu lakini SI mwanzo wa jina la kigeu kamwe.
        // Bila kuzitenga, taarifa kama "a1[0] = 65;" (kigezo cha safu
        // KILICHOSHATANGAZWA kikifahirishwa, si tangazo jipya) ilikuwa
        // ikikisiwa VIBAYA kama tangazo (kwa sababu upanuzi wa herufi
        // ndogo za aina za msingi sasa unatambua "a1" kama jina la
        // aina linalowezekana) -- iligunduliwa kwa majaribio HALISI
        // (jaribio_k14_maktaba_zaidi.swa, a1[0]/b1[0]).
        n8 ch_baada = p->sasa.mwanzo[0];
        n32 ni_ishara_maalum = (ch_baada == 91 || ch_baada == 93 || ch_baada == 123 || ch_baada == 125);
        kama (p->sasa.urefu >= 1 && ch_baada >= 65 && ni_ishara_maalum == 0) { ni_tangazo = 1; }
        p->msomaji.nafasi = nafasi_iliyohifadhiwa;
        p->msomaji.mstari = mstari_uliohifadhiwa;
        p->msomaji.safu = safu_iliyohifadhiwa;
        p->sasa = sasa_iliyohifadhiwa;
        p->inayofuata = ifuatayo_iliyohifadhiwa;
        kama (ni_tangazo) {
            n32 tangazo_type = changanua_aina_tokeni(p);
            n32 kwanza = -1;
            n32 awali = -1;
            n32 safu_ukubwa = 0;

            wakati (1 == 1) {
                safu_ukubwa = 0;
                n32 safu_ilipo = 0;
                kama ((p->sasa.mwanzo[0] >= 65 && p->sasa.mwanzo[0] != 91 && p->sasa.mwanzo[0] != 93 && p->sasa.mwanzo[0] != 123 && p->sasa.mwanzo[0] != 125)) {
                    // Neno muhimu kama jina la kigeu — kosa la sauti (hati 2.2)
                    kama (kataa_neno_muhimu(p)) { rudisha -1; }
                    n32 kigeu_name = nodi_mpya(MTI_KITAMBULISHO, 0, -1, -1);
                    hifadhi_jina(kigeu_name, p->sasa.mwanzo, p->sasa.urefu);
                    mti_thamani[kigeu_name] = tangazo_type;
                    sogeza(p);

                    // Ruka [ukubwa] kama ipo (kwa matamko ya safu ya ndani)
                    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                        kama (neno_ni(&p->sasa, "[")) {
                            safu_ilipo = 1;
                            sogeza(p);
                            kama (p->sasa.urefu > 0) {
                                // Halisi ya herufi kama ukubwa: kataa kwa sauti.
                                kama (p->sasa.mwanzo[0] == 39) {
                                    andika_stderr("kosa: halisi ya herufi haijaungwa mkono\n");
                                    p->kosa = 1;
                                    rudisha -1;
                                }
                                safu_ukubwa = neno_kwa_nambari(p->sasa.mwanzo, p->sasa.urefu);
                                sogeza(p);
                            }
                            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                                kama (neno_ni(&p->sasa, "]")) { sogeza(p); }
                            }
                        }
                    }

                    n32 kianzio = -1;
                    // Angalia kwa kianzisha '='
                    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "=")) {
                        // Safu + kianzilishi si katika hati 6.1; kukubali kimya
                        // kunatupa kianzilishi. Kataa kwa sauti, sawa na mbegu.
                        kama (safu_ilipo != 0) {
                            andika_stderr("kosa: kianzilishi cha safu hakijaungwa mkono\n");
                            p->kosa = 1;
                            rudisha -1;
                        }
                        sogeza(p);
                        kianzio = changanua_usemi(p);
                    }

                    n32 tangazo_nodi = nodi_mpya(MTI_TANGAZO, tangazo_type, kigeu_name, kianzio);
                    kama (safu_ukubwa > 0) { mti_tiga[tangazo_nodi] = safu_ukubwa; }
                    kama (kwanza == -1) { kwanza = tangazo_nodi; }
                    sivyo { mti_nne[awali] = tangazo_nodi; }
                    awali = tangazo_nodi;

                    // Angalia kama kuna koma kwa tangazo linalofuata
                    n32 ina_koma = 0;
                    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                        kama (neno_ni(&p->sasa, ",")) { ina_koma = 1; }
                    }
                    kama (ina_koma == 0 && p->sasa.urefu == 1 && neno_ni(&p->sasa, ",")) { ina_koma = 1; }
                    kama (ina_koma) {
                        sogeza(p);
                        endelea;
                    }
                    vunja;
                } sivyo {
                    vunja;
                }
            }

            // Aina ilisomwa lakini hakuna jina la kigeu lililofuata — fomu
            // isiyo halali (mf. `n32;` au `n32* p = tenga n32;`). Zamani
            // ilimezwa kimya na kuacha tokeni ya aina ikiwa imepotea.
            kama (kwanza == -1) {
                p->kosa = 1;
                andika_stderr("kosa: jina la aina halifuatwi na jina la kigeu\n");
                rudisha -1;
            }

            // Tumia semicolon ya hiari (baada ya matamko yote)
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            // Pia shughulikia tokeni za waendeshaji zinazokosa aina ISHARA
            kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ";")) { sogeza(p); }

            rudisha kwanza;
        }
    }
    // Aina haikujulikana. Neno linalofuatiwa na neno lingine ni
    // jaribio la tangazo la aina isiyojulikana (mf. Foo bar;) —
    // kosa la sauti, si taarifa ya usemi (usemi halali hauanzi
    // kwa maneno mawili mfululizo — sawa na mbegu).
    kama (p->sasa.aina == TOKENI_KITAMBULISHO || p->sasa.aina == TOKENI_MANENO) {
        kama (p->inayofuata.aina == TOKENI_KITAMBULISHO || p->inayofuata.aina == TOKENI_MANENO) {
            n8 bafa_jina[64];
            n32 bi = 0;
            wakati (bi < p->sasa.urefu && bi < 63) {
                bafa_jina[bi] = p->sasa.mwanzo[bi];
                bi = bi + 1;
            }
            bafa_jina[bi] = 0;
            andika_stderr("kosa: aina isiyojulikana: %s\n", bafa_jina);
            p->kosa = 1;
            rudisha -1;
        }
    }
    rudisha -1;
}

n32 changanua_taarifa_ndani(Msambazaji* p) {
    // ---- vunja ; ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "vunja")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            rudisha nodi_mpya(MTI_VUNJA, 0, -1, -1);
        }
    }

    // ---- endelea ; ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "endelea")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            rudisha nodi_mpya(MTI_ENDELEA, 0, -1, -1);
        }
    }

    // ---- achilia usemi ; ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "achilia")) {
            sogeza(p);
            n32 usemi = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            kama (usemi == -1) { rudisha nodi_mpya(MTI_ACHILIA, 0, -1, -1); }
            rudisha nodi_mpya(MTI_ACHILIA, 0, usemi, -1);
        }
    }

    // ---- badili ptr, size ; ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "badili")) {
            sogeza(p);
            n32 kielekezi = changanua_usemi(p);
            kama (kielekezi == -1) { rudisha -1; }
            n32 size = -1;
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ",")) { sogeza(p); }
                size = changanua_usemi(p);
            }
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            kama (size == -1) { rudisha -1; }
            rudisha nodi_mpya(MTI_BADILI, 0, kielekezi, size);
        }
    }

    // ---- rudisha usemi ;  /  rudisha ; ----
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "rudisha")) {
            sogeza(p);
            // Rudisha tupu
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) {
                    sogeza(p);
                    rudisha nodi_mpya(MTI_RUDISHA, 0, -1, -1);
                }
            }
            n32 usemi = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            rudisha nodi_mpya(MTI_RUDISHA, 0, usemi, -1);
        }
    }
    rudisha -1;
}

// 1 ikiwa orodha ya vigezo iliyochanganuliwa mwisho iliishia kwa `...`
// (hoja za ziada -- kazi za nje pekee, hati/daraja-la-mashine.md).
n32 vigezo_vya_ziada = 0;
// 1 wakati changanua_nje inachanganua kizuizi chake
n32 ndani_ya_nje = 0;

n32 changanua_kazi_vigezo(Msambazaji* p) {
    vigezo_kwanza_ulimwengu = -1;
    vigezo_awali_ulimwengu = -1;
    vigezo_vya_ziada = 0;

    wakati (1 == 1) {
        n8 c0 = p->sasa.mwanzo[0];
        kama (c0 == 41) { sogeza(p); vunja; }
        kama (c0 == 44) { sogeza(p); endelea; }
        // `...` -- lazima iwe mwisho, na ndani ya nje pekee
        kama (c0 == 46) {
            n32 nukta = 0;
            wakati (p->sasa.urefu != 0 && p->sasa.mwanzo[0] == 46 && nukta < 3) {
                nukta = nukta + p->sasa.urefu;
                sogeza(p);
            }
            kama (nukta != 3 || p->sasa.mwanzo[0] != 41) {
                andika_stderr("kosa: mstari %d: '...' lazima iwe kigezo cha mwisho\n", p->sasa.mstari);
                p->kosa = 1;
                rudisha -1;
            }
            kama (ndani_ya_nje == 0) {
                andika_stderr("kosa: mstari %d: '...' (hoja za ziada) ni kwa kazi za nje pekee\n", p->sasa.mstari);
                p->kosa = 1;
                rudisha -1;
            }
            vigezo_vya_ziada = 1;
            endelea;
        }
        kama (p->sasa.urefu == 0) { p->kosa = 1; rudisha -1; }
        // Tokeni isiyo aina kwenye orodha ya vigezo ('{' n.k.) ni kosa —
        // bila ulinzi huu kitanzi hakina mwendo wala toka (hang).
        kama (ni_aina_tokeni(&p->sasa) == 0) { p->kosa = 1; rudisha -1; }

        n32 kigezo_aina = changanua_aina_tokeni(p);
        n32 pnode = -1;
        n8 nc0 = p->sasa.mwanzo[0];
        kama ((nc0 >= 65 && nc0 != 123 && nc0 != 125)) {
            // Neno muhimu kama jina la kigezo — kosa la sauti (hati 2.2)
            kama (kataa_neno_muhimu(p)) { rudisha -1; }
            pnode = nodi_mpya(MTI_KITAMBULISHO, 0, -1, -1);
            hifadhi_jina(pnode, p->sasa.mwanzo, p->sasa.urefu);
            mti_thamani[pnode] = kigezo_aina;
            sogeza(p);
        }
        kama (vigezo_kwanza_ulimwengu == -1) { vigezo_kwanza_ulimwengu = pnode; }
        sivyo { mti_kulia[vigezo_awali_ulimwengu] = pnode; }
        vigezo_awali_ulimwengu = pnode;

        n8 cc0 = p->sasa.mwanzo[0];
        kama (cc0 == 44) { sogeza(p); endelea; }
    }

    // Usitume '{' hapa: tangazo la mbele halina mwili,
    // na changanua_kazi ndiye anayepaswa kuamua.
    rudisha vigezo_kwanza_ulimwengu;
}

n32 changanua_kazi_mwili(Msambazaji* p) {
    // Kifungio TUPU { } ni ufafanuzi, si tangazo la mbele (tangazo ni
    // ';' pekee baada ya vigezo) — rudisha kifungio tupu ili ast_tiga
    // ya kazi isiwe -1, vinginevyo uzalishaji ungeiruka kimya na wito
    // wake kuleta "kazi haijafafanuliwa".

    // Changanua taarifa za mwili
    n32 mwili = -1;
    n32 awali = -1;
    wakati (1 == 1) {
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "}")) { sogeza(p); vunja; }
        }
        // EOF kabla ya '}' — mwili usiofungwa ni kosa, si kukubalika
        kama (p->sasa.urefu == 0) { p->kosa = 1; vunja; }

        n32 taarifa = changanua_taarifa(p);
        kama (taarifa == -1) {
            p->kosa = 1;
            n32 fika = ruka_hadi_kifikisha(p);
            kama (fika == 1) { sogeza(p); endelea; }  // tumia ';', endelea
            kama (fika == 2) { vunja; }  // '}' — loop itaiona
            vunja;  // EOF
        }
        kama (awali == -1) { mwili = taarifa; }
        sivyo { mti_nne[awali] = taarifa; }
        awali = taarifa;
        // Fuata mnyororo hadi mwisho (kwa matamko mengi kama n32 a, b;)
        wakati (mti_nne[awali] != -1) { awali = mti_nne[awali]; }
    }


    kama (mwili == -1) {
        mwili = nodi_mpya(MTI_KIZUIZI, 0, -1, -1);  // mwili tupu { }
    }
    rudisha mwili;
}

n32 changanua_msingi_orodha(Msambazaji* p) {
    // Orodha ya vianzisha  { kipengele , ... }
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, "{")) {
            // Vianzishi vya safu {a, b, c} si katika hati 6.1; kukubali
            // kimya kunatupa vianzishi (msimbo unatoa 0). Kataa kwa sauti,
            // sawa na mbegu.
            andika_stderr("kosa: kianzilishi cha safu hakijaungwa mkono\n");
            p->kosa = 1;
            rudisha -1;
            sogeza(p);
            n32 kwanza = -1;
            n32 awali = -1;
            wakati (1 == 1) {
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, "}")) { sogeza(p); vunja; }
                }
                kama (p->sasa.urefu == 0) { p->kosa = 1; vunja; }
                n32 kipengele = changanua_usemi(p);
                kama (kipengele == -1) { p->kosa = 1; vunja; }
                kama (awali == -1) { kwanza = kipengele; }
                sivyo { mti_kulia[awali] = kipengele; }
                awali = kipengele;
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, ",")) {
                        sogeza(p);
                        endelea;
                    }
                }
            }
            rudisha nodi_mpya(MTI_SAFU, 0, kwanza, -1);
        }
    }
    rudisha -1;
}


n32 changanua_msingi(Msambazaji* p) {
    // Halisi ya nambari (au desimali kama kuna '.')
    kama (p->sasa.aina == TOKENI_NAMBARI) {
        // Halisi ya herufi ('h') si katika hati 2.3; kukubali kimya
        // kunatoa 0 (tokeni haina tarakimu). Kataa kwa sauti, sawa na mbegu.
        kama (p->sasa.mwanzo[0] == 39) {
            andika_stderr("kosa: halisi ya herufi haijaungwa mkono\n");
            p->kosa = 1;
            rudisha -1;
        }
        // Halisi za radiksi (0x, 0o, 0b) si katika hati 2.3 — hati
        // inaahidi "mfuatano wa tarakimu" pekee. Kukubali kimya
        // kunatoa jibu la desimali (0x10 = 10). Kataa kwa sauti.
        kama (p->sasa.urefu >= 2) {
            n8 c1 = p->sasa.mwanzo[1];
            kama (c1 == 120 || c1 == 88 || c1 == 111 || c1 == 79 || c1 == 98 || c1 == 66) {
                andika_stderr("kosa: halisi za radiksi hazijaungwa mkono\n");
                p->kosa = 1;
                rudisha -1;
            }
        }
        // Nukuu ya kisayansi (1.5e2, 1E-3) si katika hati 2.3 — hati
        // inaahidi "21.5" pekee. Kukubali kimya kunatupa kipeo:
        // msomaji hukusanya tokeni nzima (1.5e2) na kuitupa kipeo.
        // Kataa kwa sauti, sawa na halisi za radiksi.
        n32 ki2 = 0;
        n32 ni_kisayansi = 0;
        wakati (ki2 < p->sasa.urefu) {
            n8 ck2 = p->sasa.mwanzo[ki2];
            kama (ck2 == 101 || ck2 == 69) { ni_kisayansi = 1; vunja; }
            ki2 = ki2 + 1;
        }
        kama (ni_kisayansi) {
            andika_stderr("kosa: nukuu ya kisayansi haijaungwa mkono\n");
            p->kosa = 1;
            rudisha -1;
        }
        n32 ni_d = 0;
        n32 k2 = 0;
        wakati (k2 < p->sasa.urefu) {
            kama (p->sasa.mwanzo[k2] == 46) { ni_d = 1; vunja; }
            k2 = k2 + 1;
        }
        kama (ni_d == 0) {
            n64 v = tokeni_kwa_nambari_n64(p->sasa.mwanzo, p->sasa.urefu);
            sogeza(p);
            // Ulinganisho wa > 2147483647 ni WENYE ISHARA — thamani za
            // [2^63, 2^64) zinaonekana hasi na kuanguka kwenye njia ya
            // n32 (ukataji wa kimya, mov eax, 0xFFFFFFFF). "v < 0"
            // (ishara) kinakamata [2^63, 2^64) — pamoja viko sawa na
            // ulinganisho BILA ishara dhidi ya 2^31.
            kama (v > 2147483647) {
                // n64 halisi: ast_thamani (n32) haiwezi kubeba thamani
                // kubwa — hifadhi baiti 8 kwenye dimbwi la AST na uweke
                // ast_kulia=1 kama alama ya n64 (ast_tiga ni kiungo cha
                // mnyororo wa hoja kwenye wito — usiguse).
                n32 ofseti_n = mti_dimbwi_wapi;
                n8* bv = &v;
                n32 bvi = 0;
                wakati (bvi < 8) {
                    mti_dimbwi[ofseti_n + bvi] = bv[bvi];
                    bvi = bvi + 1;
                }
                mti_dimbwi_wapi = ofseti_n + 8;
                n32 nn = nodi_mpya(MTI_NAMBARI, ofseti_n, -1, -1);
                mti_kulia[nn] = 1;
                rudisha nn;
            }
            sivyo {
                kama (v < 0) {
                    // [2^63, 2^64): ishara hasi — bado halisi ya n64.
                    n32 ofseti_n = mti_dimbwi_wapi;
                    n8* bv = &v;
                    n32 bvi = 0;
                    wakati (bvi < 8) {
                        mti_dimbwi[ofseti_n + bvi] = bv[bvi];
                        bvi = bvi + 1;
                    }
                    mti_dimbwi_wapi = ofseti_n + 8;
                    n32 nn = nodi_mpya(MTI_NAMBARI, ofseti_n, -1, -1);
                    mti_kulia[nn] = 1;
                    rudisha nn;
                }
                rudisha nodi_mpya(MTI_NAMBARI, v, -1, -1);
            }
        }
        // Desimali halisi (d64): baiti kutoka daraja la C (strtod),
        // zimehifadhiwa kwenye dimbwi la AST (baiti 8) — ast_thamani
        // ina ofseti ya dimbwi; ast_tiga inabaki -1 kama kiungo cha hoja.
        n64 biti = biti_ya_d64_swa(p->sasa.mwanzo, p->sasa.urefu);
        sogeza(p);
        n32 ofseti_d = mti_dimbwi_wapi;
        n8* bd = &biti;
        n32 bdi = 0;
        wakati (bdi < 8) {
            mti_dimbwi[ofseti_d + bdi] = bd[bdi];
            bdi = bdi + 1;
        }
        mti_dimbwi_wapi = ofseti_d + 8;
        rudisha nodi_mpya(MTI_HALISI_D, ofseti_d, -1, -1);
    }

    // Halisi ya kamba (imetengwa kama TOKENI_MFUATANO -- inajumuisha alama za kunukuu)
    kama (p->sasa.aina == TOKENI_MFUATANO) {
        n32 s = nodi_mpya(MTI_KITAMBULISHO, 0, -1, -1);
        hifadhi_jina(s, p->sasa.mwanzo, p->sasa.urefu);
        sogeza(p);
        rudisha s;
    }

    // Kiambishi KANUSHA kimantiki  !usemi  (matokeo ni 1 au 0)
    // Neno la Kiswahili 'si' HALISI si kiambishi — ni kitambulisho cha
    // kawaida (limezimwa).
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "!")) {
        sogeza(p);
        n32 hoja = changanua_usemi_upande(p);
        kama (hoja == -1) { rudisha -1; }
        rudisha nodi_mpya(MTI_SI, 0, hoja, -1);
    }

    // Kiambishi KINYUME cha biti  ~usemi  (lazima kiwe kabla ya
    // kitambulisho: '~' ina nambari 126, '^' 94 — zote juu ya 65)
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "~")) {
        sogeza(p);
        n32 hoja = changanua_usemi_upande(p);
        kama (hoja == -1) { rudisha -1; }
        rudisha nodi_mpya(MTI_KINYUME, 0, hoja, -1);
    }

    // Kitambulisho
    kama ((p->sasa.mwanzo[0] >= 65 && p->sasa.mwanzo[0] != 91 && p->sasa.mwanzo[0] != 93 && p->sasa.mwanzo[0] != 123 && p->sasa.mwanzo[0] != 125)) {
        // Jina la aina ya nambari HALITUMIKI kama usemi — kukubali
        // kunaleta msimbo unaoanguka kimya (mf. `n32* p = tenga n32;`).
        // Jina la muundo lililotangazwa linaruhusiwa: kigezo kinaweza
        // kubeba jina linalofanana na muundo (sawa na mbegu).
        // Hoja ya ukubwa(...) ndiyo pekee inayoruhusu aina ya nambari.
        kama (ukubwa_hoja == 0) {
            kama (ni_aina_msingi(p->sasa.mwanzo, p->sasa.urefu)) {
                n8 bafa_jina[64];
                n32 bi = 0;
                wakati (bi < p->sasa.urefu && bi < 63) {
                    bafa_jina[bi] = p->sasa.mwanzo[bi];
                    bi = bi + 1;
                }
                bafa_jina[bi] = 0;
                andika_stderr("kosa: jina la aina halitumiki kama usemi: %s\n", bafa_jina);
                p->kosa = 1;
                rudisha -1;
            }
        }
        n32 id_nodi = nodi_mpya(MTI_KITAMBULISHO, 0, -1, -1);
        hifadhi_jina(id_nodi, p->sasa.mwanzo, p->sasa.urefu);
        sogeza(p);
        rudisha id_nodi;
    }

    // Usemi wenye mabano  ( usemi )
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, "(")) {
            sogeza(p);
            n32 usemi = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
            }
            rudisha usemi;
        }
    }

    n32 r_orodha = changanua_msingi_orodha(p);
    kama (r_orodha != -1) { rudisha r_orodha; }

    // Kiambishi TOA unari  -usemi
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "-")) {
        sogeza(p);
        n32 hoja = changanua_usemi_upande(p);
        kama (hoja == -1) { rudisha -1; }
        rudisha nodi_mpya(MTI_TOFAUTI, 0, -1, hoja);
    }

    // Kiambishi NYOOSHA unari  *usemi (kielekezi nyoosha)
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "*")) {
        sogeza(p);
        n32 hoja = changanua_usemi_upande(p);
        kama (hoja == -1) { rudisha -1; }
        rudisha nodi_mpya(MTI_TAJA, 0, hoja, -1);
    }

    // Kiambishi ANWANI-YA unari  &usemi
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "&")) {
        sogeza(p);
        n32 hoja = changanua_usemi_upande(p);
        kama (hoja == -1) { rudisha -1; }
        rudisha nodi_mpya(MTI_KUMBUKA, 0, hoja, -1);
    }

    // sizeof(usemi) -- swala la ukubwa lililojengewa (ukubwa ndio neno kuu)
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "ukubwa")) {
            sogeza(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "(")) { sogeza(p); }
            }
            n32 hoja = changanua_usemi(p);
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ")")) { sogeza(p); }
            }
            kama (hoja == -1) { rudisha -1; }
            rudisha nodi_mpya(MTI_TAJA, 0, hoja, -1);
        }
    }

    rudisha -1;
}

// -------------------------------------------------------
// POSTFIX :: msingi  ( hoja )   .shamba   ->shamba   [ idx ]
// -------------------------------------------------------
n32 changanua_usemi_upande(Msambazaji* p) {
    n32 kushoto = changanua_msingi(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        // Wito wa kazi  usemi ( hoja )
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "(")) {
                // ukubwa(aina) huchukua jina la aina kama hoja (kipimo
                // cha aina) — weka alama ili changanua_primary iruhusu
                // aina hapo.
                n32 ni_ukubwa = 0;
                kama (mti_aina[kushoto] == MTI_KITAMBULISHO) {
                    kama (jina_linganisha(mti_dimbwi + mti_jina_ofseti[kushoto], "ukubwa")) { ni_ukubwa = 1; }
                }
                n32 ukubwa_hoja_zamani = ukubwa_hoja;
                kama (ni_ukubwa) { ukubwa_hoja = 1; }
                sogeza(p);
                n32 hoja_zote = -1;
                n32 awali = -1;
                wakati (1 == 1) {
                    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                        kama (neno_ni(&p->sasa, ")")) { sogeza(p); vunja; }
                    }
                    kama (p->sasa.urefu == 0) { p->kosa = 1; vunja; }
                    n32 hoja = changanua_usemi(p);
                    kama (hoja == -1) { p->kosa = 1; vunja; }
                    kama (awali == -1) { hoja_zote = hoja; }
                    sivyo { mti_tiga[awali] = hoja; }
                    awali = hoja;
                    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                        kama (neno_ni(&p->sasa, ",")) {
                            sogeza(p);
                            endelea;
                        }
                    }
                }
                ukubwa_hoja = ukubwa_hoja_zamani;
                n32 wito = nodi_mpya(MTI_WITO, 0, kushoto, hoja_zote);
                kushoto = wito;
                endelea;
            }
        }

        // Ufikiaji wa shamba  usemi . jina
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ".")) {
                sogeza(p);
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) { p->kosa = 1; rudisha -1; }
                n32 sehemu = nodi_mpya(MTI_KITAMBULISHO, 0, -1, -1);
                hifadhi_jina(sehemu, p->sasa.mwanzo, p->sasa.urefu);
                sogeza(p);
                kushoto = nodi_mpya(MTI_SEHEMU_DOT, 0, kushoto, sehemu);
                endelea;
            }
        }

        // Mbadilisho wa mshale  usemi -> jina
        // Mchanganuaji kujitegemea hutengua -> kama tokeni mbili tofauti ('- ' + '>').
        // Tumia utazamaji ili kuzichanganya kuwa kiendeshi kimoja cha mshale.
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "-")) {
            kama (p->inayofuata.urefu == 1 && neno_ni(&p->inayofuata, ">")) {
                sogeza(p);  // tumia '-'
                sogeza(p);  // tumia '>'
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) { p->kosa = 1; rudisha -1; }
                n32 sehemu = nodi_mpya(MTI_KITAMBULISHO, 0, -1, -1);
                hifadhi_jina(sehemu, p->sasa.mwanzo, p->sasa.urefu);
                sogeza(p);
                kushoto = nodi_mpya(MTI_SEHEMU_MSHALE, 0, kushoto, sehemu);
                endelea;
            }
            vunja;  // '-' pekee -- si kiendeshi cha postfix; acha mchanganuzi wa jumlisha autumie
        }

        // Uandikishaji wa safu  usemi [ faharasa ]
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "[")) {
                sogeza(p);
                n32 faharasa_usemi = changanua_usemi(p);
                kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                    kama (neno_ni(&p->sasa, "]")) { sogeza(p); }
                }
                kushoto = nodi_mpya(MTI_TAJA, 0, kushoto, faharasa_usemi);
                endelea;
            }
        }

        vunja;
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// KUZIDISHA :: *  /
// -------------------------------------------------------
n32 changanua_usemi_zidisha(Msambazaji* p) {
    n32 kushoto = changanua_usemi_upande(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "*")) { kitendo = MTI_ZIDISHA; }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "/")) { kitendo = MTI_GAWANYA; }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "%")) { kitendo = MTI_MODULO; }
        kama (kitendo == -1) { vunja; }
        sogeza(p);
        n32 kulia = changanua_usemi_upande(p);
        kama (kulia == -1) {
            andika_stderr("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        n32 kilichokunjwa = jaribu_kunja_namba(kitendo, kushoto, kulia);
        kama (kilichokunjwa != -1) { kushoto = kilichokunjwa; }
        sivyo { kushoto = nodi_mpya(kitendo, 0, kushoto, kulia); }
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// KUNYONGA :: +  -
// -------------------------------------------------------
n32 changanua_usemi_jumlisha(Msambazaji* p) {
    n32 kushoto = changanua_usemi_zidisha(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "+")) { kitendo = MTI_JUMLISHA; }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "-")) { kitendo = MTI_TOFAUTI; }
        kama (kitendo == -1) { vunja; }
        sogeza(p);
        // Rekodi ikiwa tokeni inayofuata ni kiendeshi kingine cha +/-
        // (kwa utambuzi wa '++' na '--' baada ya kujaribu operanda).
        // KUMBUKA: kianzilishi chenye '&&' kilivunja LLVM ya dereva wa
        // Rust (phi ya kujizungusha) — tumia kama/ugawaji badala yake.
        // Dereva umehamishiwa lugha-swa/swa-dereva (kumbukumbu).
        n32 inayofuata_jumlisha = 0;
        n32 inayofuata_toa = 0;
        kama (p->sasa.urefu == 1) {
            kama (neno_ni(&p->sasa, "+")) { inayofuata_jumlisha = 1; }
            kama (neno_ni(&p->sasa, "-")) { inayofuata_toa = 1; }
        }
        n32 kulia = changanua_usemi_zidisha(p);
        kama (kulia == -1) {
            // '++' na '--' zinaingia hapa: operanda inayofuata haipo, na
            // tokeni iliyotangulia ni kiendeshi kingine cha +/-, si usemi.
            // Viendeshaji hivyo HAVIPO kwenye vipimo (2.5) — lazima
            // vikataliwe kwa sauti, si no-op kimya (zamani 'x++;' ilitengeneza
            // 'x + (bila operanda)' — jibu baya la kimya).
            kama (kitendo == MTI_JUMLISHA && inayofuata_jumlisha) {
                andika_stderr("kosa: '++' haitekelezwi; andika 'x = x + 1' badala yake\n");
            } sivyo { kama (kitendo == MTI_TOFAUTI && inayofuata_toa) {
                    andika_stderr("kosa: '--' haitekelezwi; andika 'x = x - 1' badala yake\n");
                } sivyo {
                    andika_stderr("kosa: operanda ya kulia haipo\n");
                } }
            p->kosa = 1;
            rudisha -1;
        }
        n32 kilichokunjwa = jaribu_kunja_namba(kitendo, kushoto, kulia);
        kama (kilichokunjwa != -1) { kushoto = kilichokunjwa; }
        sivyo { kushoto = nodi_mpya(kitendo, 0, kushoto, kulia); }
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// HAMISHA :: <<  >>
// -------------------------------------------------------
n32 changanua_usemi_hamisha(Msambazaji* p) {
    n32 kushoto = changanua_usemi_jumlisha(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, "<<")) { kitendo = MTI_HAMISHA_KUSHOTO; }
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, ">>")) { kitendo = MTI_HAMISHA_KULIA; }
        kama (kitendo == -1) { vunja; }
        sogeza(p);
        n32 kulia = changanua_usemi_jumlisha(p);
        kama (kulia == -1) {
            andika_stderr("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(kitendo, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// LINGANISHA :: <  >  <=  >=
// -------------------------------------------------------
n32 changanua_usemi_linganisha(Msambazaji* p) {
    n32 kushoto = changanua_usemi_hamisha(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, "<=")) { kitendo = MTI_CHINI_SAWA; }
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, ">=")) { kitendo = MTI_JUU_SAWA; }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "<")) { kitendo = MTI_CHINI; }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ">")) { kitendo = MTI_JUU; }
        kama (kitendo == -1) { vunja; }
        sogeza(p);
        n32 kulia = changanua_usemi_jumlisha(p);
        kama (kulia == -1) {
            andika_stderr("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(kitendo, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// USAWA :: ==  !=
// -------------------------------------------------------
n32 changanua_usemi_sawa(Msambazaji* p) {
    n32 kushoto = changanua_usemi_linganisha(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, "==")) { kitendo = MTI_SAWA; }
        kama (p->sasa.urefu == 2 && neno_ni(&p->sasa, "!=")) { kitendo = MTI_TOFAUTI_SI; }
        kama (kitendo == -1) { vunja; }
        sogeza(p);
        n32 kulia = changanua_usemi_linganisha(p);
        kama (kulia == -1) {
            andika_stderr("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(kitendo, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// BITWISE NA :: &
// -------------------------------------------------------
n32 changanua_usemi_biti_na(Msambazaji* p) {
    n32 kushoto = changanua_usemi_sawa(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        kama (p->sasa.urefu != 1) { vunja; }
        kama (neno_ni(&p->sasa, "&") == 0) { vunja; }
        sogeza(p);
        n32 kulia = changanua_usemi_sawa(p);
        kama (kulia == -1) {
            andika_stderr("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(MTI_BITI_NA, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// BITWISE XOR :: ^  (kati ya & na |, utangulizi wa C)
// -------------------------------------------------------
n32 changanua_usemi_biti_xor(Msambazaji* p) {
    n32 kushoto = changanua_usemi_biti_na(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        kama (p->sasa.urefu != 1) { vunja; }
        kama (neno_ni(&p->sasa, "^") == 0) { vunja; }
        sogeza(p);
        n32 kulia = changanua_usemi_biti_na(p);
        kama (kulia == -1) {
            andika_stderr("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(MTI_XOR, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// BITWISE AU :: |
// -------------------------------------------------------
n32 changanua_usemi_biti_au(Msambazaji* p) {
    n32 kushoto = changanua_usemi_biti_xor(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        kama (p->sasa.urefu != 1) { vunja; }
        kama (neno_ni(&p->sasa, "|") == 0) { vunja; }
        sogeza(p);
        n32 kulia = changanua_usemi_biti_xor(p);
        kama (kulia == -1) {
            andika_stderr("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(MTI_BITI_AU, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// KIMANTIKI NA :: &&
// -------------------------------------------------------
n32 changanua_usemi_na(Msambazaji* p) {
    n32 kushoto = changanua_usemi_biti_au(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        kama (p->sasa.urefu != 2) { vunja; }
        kama (neno_ni(&p->sasa, "&&") == 0) { vunja; }
        sogeza(p);
        n32 kulia = changanua_usemi_biti_au(p);
        kama (kulia == -1) {
            andika_stderr("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(MTI_NA, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// KIMANTIKI AU :: ||
// -------------------------------------------------------
n32 changanua_usemi_au(Msambazaji* p) {
    n32 kushoto = changanua_usemi_na(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        kama (p->sasa.urefu != 2) { vunja; }
        kama (neno_ni(&p->sasa, "||") == 0) { vunja; }
        sogeza(p);
        n32 kulia = changanua_usemi_na(p);
        kama (kulia == -1) {
            andika_stderr("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }
        kushoto = nodi_mpya(MTI_AU, 0, kushoto, kulia);
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// TERNARI :: ? :
// -------------------------------------------------------
n32 changanua_usemi_chaguzi_tatu(Msambazaji* p) {
    n32 sharti = changanua_usemi_au(p);
    kama (sharti == -1) { rudisha -1; }

    // Angalia kwa '?' (kiendeshi cha herufi-moja, mchanganuaji anaweza asitoe ISHARA aina)
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "?")) {
        sogeza(p);
        n32 thamani_kweli = changanua_usemi_chaguzi_tatu(p);

        // Tarajia ':'
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ":")) { sogeza(p); }

        n32 sikweli = changanua_usemi_chaguzi_tatu(p);

        n32 nodi_hii = nodi_mpya(MTI_CHAGUZI_TATU, 0, sharti, thamani_kweli);
        // Tawi la uwongo liko ast_nne — ast_tiga hubeba kiungo cha hoja.
        mti_nne[nodi_hii] = sikweli;
        rudisha nodi_hii;
    }

    rudisha sharti;
}

// -------------------------------------------------------
// UGAWA :: =  +=  -=  *=  /=
// -------------------------------------------------------
n32 changanua_usemi_asimilia(Msambazaji* p) {
    n32 kushoto = changanua_usemi_chaguzi_tatu(p);
    kama (kushoto == -1) { rudisha -1; }

    wakati (1 == 1) {
        n32 kitendo = -1;
        n32 ni_kiunganishi = 0;
        // = wazi
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, "=")) {
            kitendo = MTI_ASIMILIA;
            ni_kiunganishi = 0;
        }
        // Ugawa wa kiwanja: +=  -=  *=  /=  %=  &=  |=  ^=  <<=  >>=
        kama (kitendo == -1 && p->sasa.urefu == 2) {
            kama (neno_ni(&p->sasa, "+=")) { kitendo = MTI_JUMLISHA; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "-=")) { kitendo = MTI_TOFAUTI; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "*=")) { kitendo = MTI_ZIDISHA; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "/=")) { kitendo = MTI_GAWANYA; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "%=")) { kitendo = MTI_MODULO; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "&=")) { kitendo = MTI_BITI_NA; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "|=")) { kitendo = MTI_BITI_AU; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, "^=")) { kitendo = MTI_XOR; ni_kiunganishi = 1; }
        }
        // Ugawa wa kiwanja wa hamisha: <<=  >>=  (tokeni ya herufi 3)
        kama (kitendo == -1 && p->sasa.urefu == 3) {
            kama (neno_ni(&p->sasa, "<<=")) { kitendo = MTI_HAMISHA_KUSHOTO; ni_kiunganishi = 1; }
            kama (neno_ni(&p->sasa, ">>=")) { kitendo = MTI_HAMISHA_KULIA; ni_kiunganishi = 1; }
        }
        kama (kitendo == -1) { vunja; }

        sogeza(p);
        // Kujirudia-kulia kwa ushirika wa kulia: a = b = c
        n32 kulia = changanua_usemi_asimilia(p);
        kama (kulia == -1) {
            andika_stderr("kosa: operanda ya kulia haipo\n");
            p->kosa = 1;
            rudisha -1;
        }

        kama (ni_kiunganishi) {
            // Ondoa sukari: x += y  =>  x = x + y
            n32 kitendo_pande_mbili = nodi_mpya(kitendo, 0, kushoto, kulia);
            kushoto = nodi_mpya(MTI_ASIMILIA, 0, kushoto, kitendo_pande_mbili);
        } sivyo {
            kushoto = nodi_mpya(MTI_ASIMILIA, 0, kushoto, kulia);
        }
    }

    rudisha kushoto;
}

// -------------------------------------------------------
// Kuingilia kwa USEMI
// -------------------------------------------------------
n32 changanua_usemi(Msambazaji* p) {
    rudisha changanua_usemi_asimilia(p);
}

// ==========================================================
// MCHANUZI WA TAARIFA
// ==========================================================

// Changanua bloku ya taarifa zilizofungwa na { }
// Rudisha nodi ya kwanza ya taarifa; taarifa zimeunganishwa kupitia ast_nne.
// Kwenye kuingilia p->sasa lazima iwe '{'.
n32 changanua_bloku(Msambazaji* p) {
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, "{")) {
            sogeza(p);
        } sivyo {
            rudisha -1;
        }
    } sivyo {
        rudisha -1;
    }

    n32 kwanza = -1;
    n32 awali = -1;
    wakati (1 == 1) {
        kama (p->sasa.urefu == 0) { p->kosa = 1; vunja; }  // EOF katika bloku — kosa
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "}")) { sogeza(p); vunja; }
        }
        n32 taarifa = changanua_taarifa(p);
        kama (taarifa == -1) {
            p->kosa = 1;
            n32 fika = ruka_hadi_kifikisha(p);
            kama (fika == 1) { sogeza(p); endelea; }  // tumia ';', endelea
            kama (fika == 2) { vunja; }  // '}' — bloku loop itaiona
            vunja;  // EOF
        }
        kama (awali == -1) { kwanza = taarifa; }
        sivyo { mti_nne[awali] = taarifa; }
        awali = taarifa;
        // Fuata mnyororo hadi mwisho (kwa matamko mengi kama n32 a, b;)
        wakati (mti_nne[awali] != -1) { awali = mti_nne[awali]; }
    }
    rudisha kwanza;
}

n32 changanua_taarifa(Msambazaji* p) {
    // Taarifa tupu: ';' pekee — isongeze na urudi kifungio tupu.
    // C-semantiki, sawa na mbegu (n32 f() { ; } ni mwili halali).
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, ";")) {
            sogeza(p);
            rudisha nodi_mpya(MTI_KIZUIZI, 0, -1, -1);
        }
    }
    kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ";")) {
        sogeza(p);
        rudisha nodi_mpya(MTI_KIZUIZI, 0, -1, -1);
    }
    // 'sivyo' bila 'kama' iliyotangulia ni kosa la mchanganuzi.
    // Hapo awali ilipita kama kitambulisho (msimbo wenye maana ya
    // takataka) au kutoa kosa lisilo sahihi la kianzilishi cha safu.
    // Kataa kwa sauti — 'sivyo' inakubalika tu ndani ya changanua_kama.
    kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
        kama (neno_ni(&p->sasa, "sivyo")) {
            andika_stderr("kosa: 'sivyo' inahitaji 'kama' kabla yake\n");
            p->kosa = 1;
            rudisha -1;
        }
    }
    // ndani kupitia kisaidizi
    n32 r_ndani = changanua_taarifa_ndani(p);
    kama (r_ndani != -1) { rudisha r_ndani; }

    // kama kupitia kisaidizi
    n32 r_kama = changanua_taarifa_kama(p);
    kama (r_kama != -1) { rudisha r_kama; }
    // wakati kupitia kisaidizi
    n32 r_wakati = changanua_taarifa_wakati(p);
    kama (r_wakati != -1) { rudisha r_wakati; }
    // fanya (do-while) kupitia kisaidizi
    n32 r_fanya = changanua_taarifa_fanya(p);
    kama (r_fanya != -1) { rudisha r_fanya; }
    // chagua kupitia kisaidizi
    n32 r_chagua = changanua_taarifa_chagua(p);
    kama (r_chagua != -1) { rudisha r_chagua; }
    // kwa kupitia kisaidizi
    n32 r_kwa = changanua_taarifa_kwa(p);
    kama (r_kwa != -1) { rudisha r_kwa; }
    // tangazo kupitia kisaidizi
    n32 r_tangazo = changanua_taarifa_tangazo(p);
    kama (r_tangazo != -1) { rudisha r_tangazo; }
    // ---- Taarifa ya usemi  usemi ; ----
    n32 usemi = changanua_usemi(p);
    kama (usemi != -1) {
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
        }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ";")) { sogeza(p); }
        rudisha usemi;
    }

    rudisha -1;
}

// ==========================================================
// MCHANUZI WA KAZI (pia hushughulikia vigezo vya kimataifa vya kiwango cha juu)
//
// FIX: Baada ya kutumia jina, angalia mara moja kama
// tokeni inayofuata ni '(' (kazi) au '=' / ';' (kigezo cha kimataifa).
// Kwa kigezo cha kimataifa, changanua kianzisha cha hiari na semicolon,
// kisha RUDISHA -- usianguke ndani ya uchanganuzi wa vigezo,
// ambao ungekwama kwenye tokeni isiyo ya '('.
// ==========================================================
// 1 ikiwa tangazo la mbele la mwisho lilifungwa kwa ';' (changanua_nje
// huitumia kujua kama ';' ilikosekana au ilishatumiwa hapa).
n32 kazi_mbele_ilifungwa = 0;

n32 changanua_kazi(Msambazaji* p) {
    kama (ni_aina_tokeni(&p->sasa) == 0) { rudisha -1; }

    n32 matokeo_aina = changanua_aina_tokeni(p);

    // Neno muhimu kama jina la kazi au kigezo cha kimataifa — kosa la sauti (hati 2.2)
    kama (kataa_neno_muhimu(p)) { rudisha -1; }

    n32 name_nodi = nodi_mpya(MTI_KITAMBULISHO, 0, -1, -1);
    hifadhi_jina(name_nodi, p->sasa.mwanzo, p->sasa.urefu);
    sogeza(p);  // tumia jina
    // Hifadhi usimbaji wa aina kwenye nodi ya jina (sawa na matamko ya ndani)
    mti_thamani[name_nodi] = matokeo_aina;

    // --------------------------------------------------
    // FIX: Tofautisha kazi kutoka kwa kigezo cha kimataifa.
    // Kazi ina '(' baada ya jina; kigezo cha kimataifa
    // kina '=', ';', au mwisho-wa-tangazo.
    // --------------------------------------------------
    n32 ni_ulimwengu = 0;
    n32 ulimwengu_nodi = -1;
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        n32 ni_mabano = neno_ni(&p->sasa, "(");
        kama (ni_mabano) {
            sogeza(p);  // tumia '(' -- anguka katika uchanganuzi wa vigezo
        }
        kama (ni_mabano == 0) {
            // Kigezo cha kimataifa:  n32 jina [= usemi];
            ni_ulimwengu = 1;
            // Hifadhi ukubwa wa safu yakipo: jina[ukubwa]
            n32 safu_ukubwa = 0;
            n32 safu_ilipo = 0;
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "[")) {
                    safu_ilipo = 1;
                    sogeza(p);  // ruka '['
                    kama (p->sasa.urefu > 0) {
                        // Halisi ya herufi kama ukubwa: kataa kwa sauti.
                        kama (p->sasa.mwanzo[0] == 39) {
                            andika_stderr("kosa: halisi ya herufi haijaungwa mkono\n");
                            p->kosa = 1;
                            rudisha -1;
                        }
                        safu_ukubwa = neno_kwa_nambari(p->sasa.mwanzo, p->sasa.urefu);
                        sogeza(p);  // ruka ukubwa
                    }
                    kama (neno_ni(&p->sasa, "]")) { sogeza(p); }  // ruka ']'
                }
            }
            kama (p->sasa.urefu == 1) {
                kama (neno_ni(&p->sasa, "[")) {
                    safu_ilipo = 1;
                    sogeza(p);
                    kama (p->sasa.urefu > 0) {
                        // Halisi ya herufi kama ukubwa: kataa kwa sauti.
                        kama (p->sasa.mwanzo[0] == 39) {
                            andika_stderr("kosa: halisi ya herufi haijaungwa mkono\n");
                            p->kosa = 1;
                            rudisha -1;
                        }
                        safu_ukubwa = neno_kwa_nambari(p->sasa.mwanzo, p->sasa.urefu);
                        sogeza(p);
                    }
                    kama (neno_ni(&p->sasa, "]")) { sogeza(p); }
                }
            }
            n32 kianzio = -1;
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, "=")) {
                    // Safu + kianzilishi si katika hati 6.1; kukubali kimya
                    // kunatupa kianzilishi. Kataa kwa sauti, sawa na mbegu.
                    kama (safu_ilipo != 0) {
                        andika_stderr("kosa: kianzilishi cha safu hakijaungwa mkono\n");
                        p->kosa = 1;
                        rudisha -1;
                    }
                    sogeza(p); kunja_imezuiwa = 1; kianzio = changanua_usemi(p); kunja_imezuiwa = 0;
                }
            }
            kama (p->sasa.urefu == 1) {
                kama (neno_ni(&p->sasa, "=")) {
                    // Safu + kianzilishi si katika hati 6.1; kukubali kimya
                    // kunatupa kianzilishi. Kataa kwa sauti, sawa na mbegu.
                    kama (safu_ilipo != 0) {
                        andika_stderr("kosa: kianzilishi cha safu hakijaungwa mkono\n");
                        p->kosa = 1;
                        rudisha -1;
                    }
                    sogeza(p); kunja_imezuiwa = 1; kianzio = changanua_usemi(p); kunja_imezuiwa = 0;
                }
            }
            kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            kama (p->sasa.urefu == 1) {
                kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
            }
            ulimwengu_nodi = nodi_mpya(MTI_TANGAZO_ULIMWENGU, matokeo_aina, name_nodi, kianzio);
            // Hifadhi ukubwa wa safu (kama ipo) kwenye ast_tiga
            kama (safu_ukubwa > 0) {
                n32 size_nodi = nodi_mpya(MTI_NAMBARI, safu_ukubwa, -1, -1);
                mti_tiga[ulimwengu_nodi] = size_nodi;
            }
        }
    }
    kama (ni_ulimwengu) { rudisha ulimwengu_nodi; }
    // --------------------------------------------------
    // MWISHO WA FIX -- utekelezaji unafika hapa kwa kazi pekee
    // --------------------------------------------------

    n32 vigezo = changanua_kazi_vigezo(p);

    // Tangazo la mbele linaishia kwa ';' baada ya vigezo;
    // mwili unapo tu kama '{' inafuata mara moja.
    n32 mwili = -1;
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, "{")) {
            sogeza(p);
            mwili = changanua_kazi_mwili(p);
        }
    }

    // Tangazo la mbele: body == -1 inamaanisha hakuna '{' iliyopatikana.
    // Tumia ';' inayofuata ili isivuje kwenye kiwango cha juu.
    kazi_mbele_ilifungwa = 0;
    kama (mwili == -1) {
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, ";")) { sogeza(p); kazi_mbele_ilifungwa = 1; }
        }
        kama (p->sasa.urefu == 1 && neno_ni(&p->sasa, ";")) { sogeza(p); kazi_mbele_ilifungwa = 1; }
    }

    n32 kazi_hii = nodi_mpya(MTI_KAZI, matokeo_aina, name_nodi, vigezo);
    mti_tiga[kazi_hii] = mwili;
    kama (vigezo != -1) { mti_kulia[name_nodi] = vigezo; }
    rudisha kazi_hii;
}

// ==========================================================
// MCHANUZI WA MUUNDO
// ==========================================================
// Akiba ya ukubwa wa miundo iliyokamilika (inajazwa na changanua_muundo).
// Ukubwa huu LAZIMA uendane na muundo_nodes[] kwenye mkaguzi.swa —
// zote mbili ni akiba za "miundo yote iliyofafanuliwa kwenye graph"
// na zote mbili zilizuiliwa mradi kwenye lugha-swa/swa#189 (hii
// ilikuwa na kikomo cha 64, mkaguzi.swa ilikuwa na kikomo cha 32,
// vyote viwili vidogo sana kwa mradi halisi). Muundo usiopatikana
// kwenye akiba hii hutambuliwa VIBAYA kama SI jina la aina (angalia
// ni_jina_la_aina chini) na ukubwa wake hurudi 4 (chaguo-msingi
// kimya) badala ya ukubwa wake halisi.
n8* muundo_ukubwa_jina[1024];
n32 muundo_ukubwa_thamani[1024];
n32 muundo_ukubwa_idadi = 0;

// Majina YOTE ya miundo kwenye chanzo, yaliyokusanywa KABLA ya
// uchanganuzi (kusanya_majina_ya_miundo). Akiba ya ukubwa hapo juu
// hujazwa tu muundo unapokamilika -- haitoshi kwa jina la herufi
// ndogo linalotumika kabla ya ufafanuzi wake (wito wa mbele, au
// "nodi* ijayo;" ndani ya muundo nodi wenyewe). Jina la herufi
// kubwa halihitaji hii: ni_aina_tokeni hulikubali kwa herufi yake
// ya kwanza tu (#285). Vielekezi ni ndani ya chanzo chenyewe.
n8* muundo_jina_awali_mwanzo[1024];
n32 muundo_jina_awali_urefu[1024];
n32 muundo_jina_awali_idadi = 0;

n32 ni_jina_la_muundo_awali(Tokeni* t) {
    n32 mi = 0;
    wakati (mi < muundo_jina_awali_idadi) {
        kama (muundo_jina_awali_urefu[mi] == t->urefu) {
            n8* mj = muundo_jina_awali_mwanzo[mi];
            n32 j = 0;
            wakati (j < t->urefu && mj[j] == t->mwanzo[j]) { j = j + 1; }
            kama (j == t->urefu) { rudisha 1; }
        }
        mi = mi + 1;
    }
    rudisha 0;
}

// Pita chanzo chote mara moja kwa msomaji (hauna athari za pembeni)
// ukisajili kila "muundo <jina>", kisha rejesha hali ya msambazaji.
// Neno muhimu baada ya "muundo" (mf. "muundo sivyo") HALISAJILIWI --
// changanua_muundo hulikataa kwa sauti baadaye; likisajiliwa lingekuwa
// "aina" kila mahali na kuvuruga uchanganuzi wa taarifa.
w0 kusanya_majina_ya_miundo(Msambazaji* p) {
    n64 nafasi_iliyohifadhiwa = p->msomaji.nafasi;
    n32 mstari_uliohifadhiwa = p->msomaji.mstari;
    n32 safu_iliyohifadhiwa = p->msomaji.safu;
    Tokeni sasa_iliyohifadhiwa;
    sasa_iliyohifadhiwa.aina = p->sasa.aina;
    sasa_iliyohifadhiwa.mwanzo = p->sasa.mwanzo;
    sasa_iliyohifadhiwa.urefu = p->sasa.urefu;
    sasa_iliyohifadhiwa.mstari = p->sasa.mstari;
    sasa_iliyohifadhiwa.safu = p->sasa.safu;
    Tokeni ifuatayo_iliyohifadhiwa;
    ifuatayo_iliyohifadhiwa.aina = p->inayofuata.aina;
    ifuatayo_iliyohifadhiwa.mwanzo = p->inayofuata.mwanzo;
    ifuatayo_iliyohifadhiwa.urefu = p->inayofuata.urefu;
    ifuatayo_iliyohifadhiwa.mstari = p->inayofuata.mstari;
    ifuatayo_iliyohifadhiwa.safu = p->inayofuata.safu;
    wakati (p->sasa.urefu != 0) {
        kama (neno_ni(&p->sasa, "muundo") && p->inayofuata.aina == TOKENI_KITAMBULISHO) {
            kama (tokeni_ni_muhimu(&p->inayofuata) == 0 && muundo_jina_awali_idadi < 1024) {
                muundo_jina_awali_mwanzo[muundo_jina_awali_idadi] = p->inayofuata.mwanzo;
                muundo_jina_awali_urefu[muundo_jina_awali_idadi] = p->inayofuata.urefu;
                muundo_jina_awali_idadi = muundo_jina_awali_idadi + 1;
            }
        }
        sogeza(p);
    }
    p->msomaji.nafasi = nafasi_iliyohifadhiwa;
    p->msomaji.mstari = mstari_uliohifadhiwa;
    p->msomaji.safu = safu_iliyohifadhiwa;
    p->sasa = sasa_iliyohifadhiwa;
    p->inayofuata = ifuatayo_iliyohifadhiwa;
}

// Tafuta ukubwa wa muundo uliotangazwa tayari (kutoka akiba)
n32 ukubwa_wa_muundo_msambazaji(n8* jina) {
    n32 mi = 0;
    wakati (mi < muundo_ukubwa_idadi) {
        kama (jina_linganisha(muundo_ukubwa_jina[mi], jina)) { rudisha muundo_ukubwa_thamani[mi]; }
        mi = mi + 1;
    }
    rudisha 4;  // chaguo-msingi kama haijulikani
}

n32 changanua_muundo(Msambazaji* p) {
    sogeza(p);  // tumia neno kuu 'muundo'

    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        p->kosa = 1;
        n32 fika = ruka_hadi_kifikisha(p);
        kama (fika == 1) { sogeza(p); }  // tumia ';', rudi kwa mchanganuzi wa kiwango cha juu
        rudisha -1;
    }

    // Neno muhimu kama jina la muundo — kosa la sauti (hati 2.2)
    kama (kataa_neno_muhimu(p)) { rudisha -1; }

    // Jina la aina ya msingi kama jina la muundo (#215). Zamani
    // "muundo n32 { ... }" ilipita kimya, lakini muundo huo haukuweza
    // kufikiwa kamwe: kila mahali jina la aina linasomwa (ni_aina_tokeni,
    // changanua_aina_tokeni, ukubwa()) aina ya msingi hushinda kwanza,
    // hivyo ukubwa(n32) ilirudisha 4 badala ya ukubwa wa muundo. Kipimo
    // ni kile kile ambacho mchanganuzi hutumia kutambua aina ya msingi
    // (herufi ya familia + tarakimu), hivyo jina lolote ambalo
    // mchanganuzi angelisoma kama aina linakataliwa hapa.
    kama (ni_aina_msingi_pia_ndogo(p->sasa.mwanzo, p->sasa.urefu)) {
        n8 bafa_aina[64];
        n32 bi = 0;
        wakati (bi < p->sasa.urefu && bi < 63) {
            bafa_aina[bi] = p->sasa.mwanzo[bi];
            bi = bi + 1;
        }
        bafa_aina[bi] = 0;
        andika_stderr("kosa: '%s' ni jina la aina ya msingi — haliwezi kutumika kama jina la muundo\n", bafa_aina);
        p->kosa = 1;
        rudisha -1;
    }

    n32 name = nodi_mpya(MTI_KITAMBULISHO, 0, -1, -1);
    hifadhi_jina(name, p->sasa.mwanzo, p->sasa.urefu);
    sogeza(p);  // tumia jina la muundo

    tarajia(p, TOKENI_ISHARA);  // tarajia '{'

    n32 kwanza_sehemu = -1;
    n32 awali = -1;
    n32 inayoendelea_ofseti = 0;

    wakati (1 == 1) {
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, "}")) { vunja; }
        }
        kama (p->sasa.urefu == 0) { p->kosa = 1; vunja; }

        // Ufafanuzi wa aina wa hiari kwenye shamba
        n32 sehemu_aina = 0;
        kama (ni_aina_tokeni(&p->sasa)) {
            sehemu_aina = changanua_aina_tokeni(p);
        }

        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            p->kosa = 1;
            n32 fika = ruka_hadi_kifikisha(p);
            kama (fika == 1) { sogeza(p); endelea; }  // tumia ';', jaribu shamba linalofuata
            kama (fika == 2) { vunja; }  // '}' — kitanzi kitaiona juu
            vunja;  // EOF
        }

        // Neno muhimu kama jina la shamba — kosa la sauti (hati 2.2)
        kama (kataa_neno_muhimu(p)) { rudisha -1; }

        n32 fname = nodi_mpya(MTI_KITAMBULISHO, 0, -1, -1);
        hifadhi_jina(fname, p->sasa.mwanzo, p->sasa.urefu);
        mti_thamani[fname] = sehemu_aina;
        mti_tiga[fname] = inayoendelea_ofseti;  // hifadhi ofseti ya baiti
        // Kokotoa ukubwa wa baiti kutoka kwa encoding ya aina.
        // Tumia hesabu ya / na % (mbegu ina hitilafu katika & na >>).
        kama (sehemu_aina < 0) {
            // Sehemu yenye aina ya muundo (encoding hasi). Encoding
            // halisi (angalia changanua_aina_tokeni juu, karibu na
            // "rudisha (-((off + 1) * 2)) + mshale;") ni
            // field_aina = -((off+1)*2) + mshale, ambapo mshale ni
            // 0 (imepachikwa/embedded), 1 (kielekezi kimoja *),
            // au 3 (kielekezi mara mbili **). MDUDU ULIOKUWEPO: hesabu
            // ya awali ilijaribu kupata `off` kwa `((-field_aina)/2)-1`
            // BILA kuondoa `mshale` kwanza -- kwa mashamba ya
            // KIELEKEZI (mshale != 0) hii ilitoa `off` isiyo sahihi
            // (jina halipatikani kwenye dimbwi, ukubwa_wa_muundo_
            // msambazaji hurudi 4 ya chaguo-msingi badala ya baiti 8
            // za kielekezi halisi) -- ikisababisha kila shamba
            // linalofuata kwenye muundo kupata ofseti isiyo sahihi.
            // lugha-swa/swa#182 (udhihirisho wa pili/tatu).
            //
            // Suluhisho: `(-field_aina) % 2 != 0` inatambua kwa
            // uhakika kuwa shamba ni KIELEKEZI (mshale ni 1 au 3,
            // vyote viwili visivyo sawa) -- kielekezi DAIMA ni baiti
            // 8 kwenye x86-64, HAIHITAJI kutafuta ukubwa wa muundo
            // unaoelekezwa kabisa. Ni shamba lililopachikwa KWELI KWELI
            // (mshale == 0, `(-field_aina) % 2 == 0`) ndilo linalohitaji
            // kutafuta ukubwa halisi wa muundo huo.
            n32 neg = 0 - sehemu_aina;
            n32 ni_kielekezi_cha_muundo = neg % 2;
            kama (ni_kielekezi_cha_muundo != 0) {
                inayoendelea_ofseti = inayoendelea_ofseti + 8;
            } sivyo {
                n32 name_ofseti2 = (neg / 2) - 1;
                inayoendelea_ofseti = inayoendelea_ofseti + ukubwa_wa_muundo_msambazaji(mti_dimbwi + name_ofseti2);
            }
        } sivyo { kama (sehemu_aina != 0) {
                n32 mshale_f = sehemu_aina % 2;
                kama (mshale_f == 1) { inayoendelea_ofseti = inayoendelea_ofseti + 8; }
                sivyo {
                    n32 familia_f = (sehemu_aina / 256) % 256;
                    // Upana halisi: toa familia*256 kwanza
                    n32 upana_f = sehemu_aina - (sehemu_aina % 2) - (familia_f * 256);
                    kama (familia_f >= 1) { inayoendelea_ofseti = inayoendelea_ofseti + (upana_f / 8); }
                    sivyo { inayoendelea_ofseti = inayoendelea_ofseti + 4; }
                }
            } sivyo { inayoendelea_ofseti = inayoendelea_ofseti + 4; } }
        sogeza(p);  // tumia jina la shamba

        // Semicolon ya hiari inayofuata
        kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
            kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
        }

        n32 f = nodi_mpya(MTI_SEHEMU, 0, fname, -1);
        kama (awali == -1) { kwanza_sehemu = f; }
        sivyo { mti_kulia[awali] = f; }
        awali = f;
    }

    sogeza(p);  // tumia '}'

    // Semicolon ya hiari inayofuata baada ya ufafanuzi wa muundo
    kama ((p->sasa.mwanzo[0] < 65 || p->sasa.mwanzo[0] == 91 || p->sasa.mwanzo[0] == 93 || p->sasa.mwanzo[0] == 123 || p->sasa.mwanzo[0] == 125)) {
        kama (neno_ni(&p->sasa, ";")) { sogeza(p); }
    }

    n32 mnode = nodi_mpya(MTI_MUUNDO, 0, name, kwanza_sehemu);
    // Hifadhi ukubwa wa muundo huu (running_offset ya mwisho)
    mti_thamani[mnode] = inayoendelea_ofseti;
    kama (muundo_ukubwa_idadi < 1024) {
        muundo_ukubwa_jina[muundo_ukubwa_idadi] = mti_dimbwi + mti_jina_ofseti[name];
        muundo_ukubwa_thamani[muundo_ukubwa_idadi] = inayoendelea_ofseti;
        muundo_ukubwa_idadi = muundo_ukubwa_idadi + 1;
    } sivyo {
        // lugha-swa/swa#298 -- muundo huu (na kila mmoja unaofuata)
        // ungekosa ukubwa wake kimya -- ukubwa_kutoka_enc ingerudi
        // 0 kwa struct hii, ikivuruga ofseti za field na ukubwa wa
        // tenga() bila hitilafu yoyote ya kukusanya.
        andika_stderr("KOSA: akiba ya ukubwa wa miundo (muundo_ukubwa_jina/val) imejaa (kikomo 1024) — muundo '%s' na zinazofuata hazitapata ukubwa sahihi\n", mti_dimbwi + mti_jina_ofseti[name]);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    rudisha mnode;
}

// ==========================================================
// UGAWA WA KIWANGO CHA JUU
// ==========================================================
n32 changanua(Msambazaji* p) {
    n32 kwanza = -1;
    n32 awali = -1;
    n32 alishalia = 0;  // kosa la tamko limeshatajwa kwa mfululizo huu
    kusanya_majina_ya_miundo(p);

    wakati (p->sasa.urefu != 0) {
        n32 nodi_hii = -1;

        // Ruka maelekezo ya husisha (mistari ya kichakata-awali — ruka mstari mzima)
        kama (p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
            kama (neno_ni(&p->sasa, "husisha")) {
                n32 mstari_husisha = p->sasa.mstari;
                sogeza(p);  // tumia neno kuu "husisha"
                // Ruka tokeni zote kwenye mstari huo huo
                wakati (p->sasa.urefu != 0 && p->sasa.mstari == mstari_husisha) {
                    sogeza(p);
                }
                endelea;
            }
        }

        // Daraja la mashine: nje "<maktaba>" { <vichwa vya kazi> }
        // (hati/daraja-la-mashine.md). `nje` si neno muhimu -- linatambuliwa
        // hapa tu, likifuatiwa na mfuatano, hivyo `n8* nje` kama kigeu
        // linaendelea kufanya kazi.
        n32 ni_nje = 0;
        kama (p->sasa.urefu == 3 && p->inayofuata.aina == TOKENI_MFUATANO) {
            kama (neno_ni(&p->sasa, "nje")) {
                ni_nje = 1;
                nodi_hii = changanua_nje(p);
                kama (nodi_hii == -1) { p->kosa = 1; alishalia = 1; }
            }
        }

        // Jaribu tangazo la muundo
        kama (ni_nje == 0 && p->sasa.urefu >= 2 && p->sasa.mwanzo[0] >= 97) {
            kama (neno_ni(&p->sasa, "muundo")) {
                nodi_hii = changanua_muundo(p);
            }
        }

        // Jaribu kazi (pia hushughulikia vigezo vya kimataifa, shukrani kwa fix)
        kama (nodi_hii == -1 && ni_nje == 0) {
            nodi_hii = changanua_kazi(p);
        }

        // Kama hakuna kilicholingana, weka kosa lakini endelea
        // (kurejesha-hitilafu: badala ya kukoma, ruka na uchukue mengine)
        kama (nodi_hii == -1) {
            kama (p->sasa.urefu != 0) {
                // Taja tokeni ya KWANZA ya mfululizo usiotambulika (si kila
                // tokeni inayorukwa) -- bila hili kosa lilikuwa "; KOSA: 1"
                // tu, bila mahali wala sababu. Kama kosa mahususi limeshatajwa
                // (p->kosa tayari), tokeni zinazofuata ni mwangwi wake tu.
                kama (alishalia == 0 && p->kosa == 0) {
                    n8 bafa_tamko[64];
                    n32 bi = 0;
                    wakati (bi < p->sasa.urefu && bi < 63) {
                        bafa_tamko[bi] = p->sasa.mwanzo[bi];
                        bi = bi + 1;
                    }
                    bafa_tamko[bi] = 0;
                    n32 mstari_tamko = p->sasa.mstari;
                    andika_stderr("kosa: mstari %d: tamko la ngazi ya juu halitambuliki, kuanzia '%s'\n", mstari_tamko, bafa_tamko);
                    alishalia = 1;
                }
                p->kosa = 1;  // alama kwamba mchanganuo ulishindwa
                sogeza(p);  // ruka tokeni lisilotambulika
                endelea;  // endelea kutafuta makosa zaidi
            }
            vunja;  // EOF
        }
        alishalia = 0;

        kama (awali == -1) { kwanza = nodi_hii; }
        sivyo { mti_nne[awali] = nodi_hii; }
        awali = nodi_hii;
        // Kizuizi cha nje hurudisha mnyororo wa kazi; endelea kutoka ya mwisho
        kama (ni_nje) { awali = kigeni_mwisho_nodi; }
    }

    rudisha nodi_mpya(MTI_PROGRAMU, 0, kwanza, -1);
}

// ==========================================================
// DARAJA LA MASHINE: kazi za nje (hati/daraja-la-mashine.md)
// ==========================================================
// Kila kazi ya nje ni AST_KAZI isiyo na mwili (kama tangazo la mbele),
// iliyosajiliwa hapa pamoja na maktaba yake na alama yake (jina lao).
// Uzalishaji huiandikia kipande cha wito na ELF ya kiungo-hai.
n8 kigeni_dimbwi[65536];
n32 kigeni_dimbwi_wapi = 1;
n32 kigeni_maktaba_ofseti[64];
n32 kigeni_maktaba_idadi = 0;
n32 kigeni_kazi_nodi[1024];
n32 kigeni_kazi_alama_ofseti[1024];
n32 kigeni_kazi_maktaba[1024];
n32 kigeni_kazi_ya_ziada[1024];   // 1 = ina `...`
n32 kigeni_kazi_idadi = 0;
n32 kigeni_mwisho_nodi = -1;

// Faharisi ya kazi ya nje yenye jina la Swa `jina`, au -1.
n32 kigeni_kazi_kwa_jina(n8* jina) {
    n32 i = 0;
    wakati (i < kigeni_kazi_idadi) {
        kama (jina_linganisha(mti_dimbwi + mti_jina_ofseti[mti_kushoto[kigeni_kazi_nodi[i]]], jina)) { rudisha i; }
        i = i + 1;
    }
    rudisha -1;
}

// Nakili baiti `urefu` kuanzia `mwanzo` kwenye kigeni_pool (na 0 mwishoni).
// Rudisha ofseti, au -1 dimbwi likijaa.
n32 kigeni_hifadhi(n8* mwanzo, n64 urefu) {
    kama (kigeni_dimbwi_wapi + urefu + 1 >= 65536) {
        andika_stderr("kosa: majina ya nje yamejaa (kikomo baiti 65536)\n");
        rudisha -1;
    }
    n32 ofseti = kigeni_dimbwi_wapi;
    n64 i = 0;
    wakati (i < urefu) {
        kigeni_dimbwi[kigeni_dimbwi_wapi] = mwanzo[i];
        kigeni_dimbwi_wapi = kigeni_dimbwi_wapi + 1;
        i = i + 1;
    }
    kigeni_dimbwi[kigeni_dimbwi_wapi] = 0;
    kigeni_dimbwi_wapi = kigeni_dimbwi_wapi + 1;
    rudisha ofseti;
}

// Mfuatano wa tokeni bila alama za kunukuu. Majina ya maktaba na alama
// ni maandishi halisi: '\' inakataliwa kwa sauti, kama mfuatano mtupu.
n32 kigeni_hifadhi_mfuatano(Msambazaji* p) {
    Tokeni* t = &p->sasa;
    kama (t->urefu < 3) {
        andika_stderr("kosa: mstari %d: jina la nje haliwezi kuwa mfuatano mtupu\n", t->mstari);
        rudisha -1;
    }
    n64 i = 1;
    wakati (i < t->urefu - 1) {
        kama (t->mwanzo[i] == 92) {
            andika_stderr("kosa: mstari %d: jina la nje haliwezi kuwa na mkwaju wa nyuma\n", t->mstari);
            rudisha -1;
        }
        i = i + 1;
    }
    rudisha kigeni_hifadhi(t->mwanzo + 1, t->urefu - 2);
}

// Data ya maktaba (mf. stdout, optind): kigezo cha ulimwengu cha Swa
// ambacho kipakiaji hukijaza kwa nakala ya thamani yake (R_X86_64_COPY),
// na maktaba zenyewe hutumia nakala hiyo. Kianzio cha mfuatano ni jina
// la alama, si thamani -- kinabadilishwa kuwa 0 ili kigezo kikae .data.
n32 kigeni_data_nodi[256];
n32 kigeni_data_alama_ofseti[256];
n32 kigeni_data_idadi = 0;

n32 kigeni_ongeza_data(n32 g, n32 maktaba, n32 mstari) {
    n32 jina_nodi = mti_kushoto[g];
    n8* jina_swa = mti_dimbwi + mti_jina_ofseti[jina_nodi];
    kama (kigeni_data_idadi >= 256) {
        andika_stderr("kosa: mstari %d: data ya nje imezidi kikomo (256)\n", mstari);
        rudisha -1;
    }
    kama (mti_tiga[g] != -1) {
        andika_stderr("kosa: mstari %d: data ya nje '%s': safu haijaungwa mkono -- tumia kielekezi\n", mstari, jina_swa);
        rudisha -1;
    }
    // Namba, kielekezi au muundo (awamu 3): kianzio chake kinakuwa 0 --
    // baiti sifuri za ukubwa wake kwenye .data, ambazo kipakiaji huziandika
    // upya. Desimali ingehitaji umbo jingine la kianzio.
    n32 usimbaji = mti_thamani[g];
    kama (usimbaji > 0 && (usimbaji / 256) % 256 == 3 && (usimbaji / 2) * 2 == usimbaji) {
        andika_stderr("kosa: mstari %d: data ya nje '%s': desimali haijaungwa mkono -- tumia kielekezi\n", mstari, jina_swa);
        rudisha -1;
    }
    n32 alama = -1;
    n32 kianzio = mti_kulia[g];
    kama (kianzio == -1) {
        n64 urefu_swa = 0;
        wakati (jina_swa[urefu_swa] != 0) { urefu_swa = urefu_swa + 1; }
        alama = kigeni_hifadhi(jina_swa, urefu_swa);
    } sivyo {
        n8* maandishi = mti_dimbwi + mti_jina_ofseti[kianzio];
        kama (mti_aina[kianzio] != MTI_KITAMBULISHO || maandishi[0] != 34) {
            andika_stderr("kosa: mstari %d: data ya nje '%s': baada ya '=' kunatarajiwa jina la alama kama mfuatano\n", mstari, jina_swa);
            rudisha -1;
        }
        n64 urefu_m = 0;
        wakati (maandishi[urefu_m] != 0) { urefu_m = urefu_m + 1; }
        kama (urefu_m < 3) {
            andika_stderr("kosa: mstari %d: jina la nje haliwezi kuwa mfuatano mtupu\n", mstari);
            rudisha -1;
        }
        alama = kigeni_hifadhi(maandishi + 1, urefu_m - 2);
    }
    kama (alama < 0) { rudisha -1; }
    mti_kulia[g] = nodi_mpya(MTI_NAMBARI, 0, -1, -1);
    kigeni_data_nodi[kigeni_data_idadi] = g;
    kigeni_data_alama_ofseti[kigeni_data_idadi] = alama;
    kigeni_data_idadi = kigeni_data_idadi + 1;
    rudisha 0;
}

// nje "<maktaba>" { <aina> <jina>(<vigezo>) [= "<alama>"]; ... }
// Rudisha kazi ya kwanza ya mnyororo (kigeni_mwisho_node = ya mwisho), au -1.
n32 changanua_nje(Msambazaji* p) {
    n32 mstari_nje = p->sasa.mstari;
    sogeza(p);  // 'nje'
    kama (kigeni_maktaba_idadi >= 64) {
        andika_stderr("kosa: mstari %d: maktaba za nje zimezidi kikomo (64)\n", mstari_nje);
        rudisha -1;
    }
    n32 maktaba = kigeni_maktaba_idadi;
    n32 jina_maktaba = kigeni_hifadhi_mfuatano(p);
    kama (jina_maktaba < 0) { rudisha -1; }
    kigeni_maktaba_ofseti[maktaba] = jina_maktaba;
    kigeni_maktaba_idadi = kigeni_maktaba_idadi + 1;
    sogeza(p);  // jina la maktaba
    kama (neno_ni(&p->sasa, "{") == 0) {
        andika_stderr("kosa: mstari %d: '{' inatarajiwa baada ya jina la maktaba ya nje\n", p->sasa.mstari);
        rudisha -1;
    }
    sogeza(p);

    n32 kwanza = -1;
    n32 iliyopita = -1;
    wakati (p->sasa.urefu != 0 && neno_ni(&p->sasa, "}") == 0) {
        n32 mstari_kazi = p->sasa.mstari;
        ndani_ya_nje = 1;
        n32 f = changanua_kazi(p);
        ndani_ya_nje = 0;
        kama (f == -1) {
            andika_stderr("kosa: mstari %d: ndani ya nje kunatarajiwa kichwa cha kazi\n", mstari_kazi);
            rudisha -1;
        }
        // Kigezo cha data cha maktaba: <aina> <jina> [= "<alama>"];
        kama (mti_aina[f] == MTI_TANGAZO_ULIMWENGU) {
            kama (kigeni_ongeza_data(f, maktaba, mstari_kazi) < 0) { rudisha -1; }
            kama (iliyopita == -1) { kwanza = f; }
            sivyo { mti_nne[iliyopita] = f; }
            iliyopita = f;
            endelea;
        }
        kama (mti_aina[f] != MTI_KAZI || mti_tiga[f] != -1) {
            andika_stderr("kosa: mstari %d: ndani ya nje ni vichwa vya kazi na vigezo vya data pekee, bila mwili\n", mstari_kazi);
            rudisha -1;
        }
        kama (kigeni_kazi_idadi >= 1024) {
            andika_stderr("kosa: mstari %d: kazi za nje zimezidi kikomo (1024)\n", mstari_kazi);
            rudisha -1;
        }
        n32 alama = -1;
        kama (kazi_mbele_ilifungwa == 0 && neno_ni(&p->sasa, "=")) {
            sogeza(p);
            kama (p->sasa.aina != TOKENI_MFUATANO) {
                andika_stderr("kosa: mstari %d: baada ya '=' kunatarajiwa jina la alama kama mfuatano\n", p->sasa.mstari);
                rudisha -1;
            }
            alama = kigeni_hifadhi_mfuatano(p);
            sogeza(p);
        } sivyo {
            n8* jina_swa = mti_dimbwi + mti_jina_ofseti[mti_kushoto[f]];
            n64 urefu_swa = 0;
            wakati (jina_swa[urefu_swa] != 0) { urefu_swa = urefu_swa + 1; }
            alama = kigeni_hifadhi(jina_swa, urefu_swa);
        }
        kama (alama < 0) { rudisha -1; }
        // Bila '=', changanua_kazi tayari imetumia ';' ya tangazo la mbele.
        kama (kazi_mbele_ilifungwa == 0) {
            kama (neno_ni(&p->sasa, ";") == 0) {
                andika_stderr("kosa: mstari %d: ';' inatarajiwa mwishoni mwa kichwa cha kazi ya nje\n", mstari_kazi);
                rudisha -1;
            }
            sogeza(p);
        }

        kigeni_kazi_ya_ziada[kigeni_kazi_idadi] = vigezo_vya_ziada;
        kigeni_kazi_nodi[kigeni_kazi_idadi] = f;
        kigeni_kazi_alama_ofseti[kigeni_kazi_idadi] = alama;
        kigeni_kazi_maktaba[kigeni_kazi_idadi] = maktaba;
        kigeni_kazi_idadi = kigeni_kazi_idadi + 1;

        kama (iliyopita == -1) { kwanza = f; }
        sivyo { mti_nne[iliyopita] = f; }
        iliyopita = f;
    }
    kama (neno_ni(&p->sasa, "}") == 0) {
        andika_stderr("kosa: mstari %d: kizuizi cha nje hakijafungwa kwa '}'\n", mstari_nje);
        rudisha -1;
    }
    sogeza(p);
    kama (kwanza == -1) {
        andika_stderr("kosa: mstari %d: kizuizi cha nje hakina kazi wala data yoyote\n", mstari_nje);
        rudisha -1;
    }
    kigeni_mwisho_nodi = iliyopita;
    rudisha kwanza;
}

// ============================================================
// KUUNGANISHA KAZI NDOGO (function inlining), awamu ya 1
// ============================================================
//
// Badala ya wito wa kweli (call/ret), nakala ya mwili wa kazi
// inasukwa moja kwa moja kwenye tovuti ya wito -- inaondoa gharama
// ya wito/kurudi KABISA kwa kazi ndogo, na inaruhusu pitio za
// ugawaji wa rejesta/kukunja mara kwa mara zilizopo tayari kuona
// zaidi ya mpaka wa zamani wa wito.
//
// WIGO (kwa makusudi mdogo sana -- soma kila sharti kwa makini,
// kila moja linaepuka hatari halisi ya usahihi, si urahisi tu):
//
//   Kazi F inaweza kuunganishwa TU ikiwa YOTE ni kweli:
//   1. F HAINA tangazo la kigezo cha ndani KABISA (hakuna AST_TANGAZO
//      popote ndani ya mwili) -- kuepuka hitaji la kubadilisha
//      majina ya vigezo vya ndani (jina la PEKEE linalohitaji
//      kubadilishwa ni jina la paramu).
//   2. F HAINA kitanzi (AST_WAKATI), tawi la masharti (AST_KAMA), wala
//      chagua (AST_CHAGUA) popote ndani ya mwili -- F ni MSTARI ULIONYOOKA
//      TU (sequence ya taarifa moja baada ya nyingine, bila tawi
//      lolote). Hii inaepuka utata mkubwa wa kuiga miundo ya lebo/
//      udhibiti wa mtiririko wakati wa kusuka.
//   3. F HAIJIITI YENYEWE (moja kwa moja) popote ndani ya mwili --
//      kuepuka urudiaji usio na kikomo wa kuunganisha.
//   4. F ina taarifa zisizozidi INL_KIKOMO_TAARIFA katika ngazi ya juu.
//   5. F ina aina ya kurudi w0 (haina thamani), na "rudisha" (kama
//      ipo) ni "rudisha;" TUPU pekee, ikiwa taarifa ya MWISHO -- hii
//      inaepuka KABISA hitaji la kushughulikia thamani ya kurudi ya
//      kiwanja (kazi inayorudisha thamani si mgombea wa awamu hii,
//      imeachwa kwa awamu ijayo kwa makusudi).
//   6. Paramu zote za F zina aina isiyokuwa muundo (enc > 0) na si
//      zaidi ya 6 kwa jumla.
//
//   Tovuti ya wito nayo lazima iwe TAARIFA YA NGAZI YA JUU ya kazi
//   inayoita (si iliyopachikwa ndani ya kama/wakati ya mzazi) --
//   ulinganifu na sharti la 2 hapo juu upande wa F: pande zote mbili
//   (mwito na anayeitwa) ni mstari ulionyooka tu kwa awamu hii.
//
// HOJA ZA WITO: kila hoja inatathminiwa MARA MOJA TU, kwenye tangazo
// jipya la kigezo cha muda, KABLA ya mwili wa F kuanza -- HAIWAHI
// kubadilishwa moja kwa moja (textual substitution) ndani ya mwili,
// kwa sababu hilo lingesababisha hoja yenye athari ya kando
// (mfano wito wa kazi nyingine) kutathminiwa MARA NYINGI kama
// ikitumika zaidi ya mara moja ndani ya F. Tangazo za vigezo vya
// muda zinaundwa KWA MPANGILIO WA KINYUME cha paramu (paramu ya
// MWISHO kwanza) ili mpangilio HALISI wa utathmini ubaki
// kulia-kabla-ya-kushoto -- sawa na jinsi mkusanyaji huu MZIMA
// tayari unavyotathmini usemi wa binary (angalia uzalishaji_jumlisha
// na wenzake, na jinsi #232 ilivyokuwa ikitegemea mpangilio huu).

n32 PACHIKA_KIKOMO_TAARIFA = 6;
n32 PACHIKA_W0_USIMBAJI = 1280;  // encode_aina(familia=5 [W], upana=0, mshale=0)

n32 pachika_urefu_jina(n8* s) {
    n32 i = 0;
    wakati (s[i] != 0) { i = i + 1; }
    rudisha i;
}

n32 pachika_jina_sawa(n8* a, n8* b) {
    n32 i = 0;
    wakati (1 == 1) {
        kama (a[i] != b[i]) { rudisha 0; }
        kama (a[i] == 0) { rudisha 1; }
        i = i + 1;
    }
}

// -------- Usajili wa kazi (jina -> nodi ya AST_KAZI) --------
n32 pachika_reg_idadi = 0;
n8* pachika_reg_jina[512];
n32 pachika_reg_nodi[512];

w0 pachika_jaza_sajili(n32 mzizi) {
    pachika_reg_idadi = 0;
    n32 nodi_hii = mti_kushoto[mzizi];
    wakati (nodi_hii != -1) {
        kama (mti_aina[nodi_hii] == MTI_KAZI) {
            kama (mti_tiga[nodi_hii] != -1) {
                kama (pachika_reg_idadi < 512) {
                    n32 name_nodi = mti_kushoto[nodi_hii];
                    pachika_reg_jina[pachika_reg_idadi] = mti_dimbwi + mti_jina_ofseti[name_nodi];
                    pachika_reg_nodi[pachika_reg_idadi] = nodi_hii;
                    pachika_reg_idadi = pachika_reg_idadi + 1;
                }
            }
        }
        nodi_hii = mti_nne[nodi_hii];
    }
}

n32 pachika_tafuta_kazi(n8* jina) {
    n32 i = 0;
    wakati (i < pachika_reg_idadi) {
        kama (pachika_jina_sawa(pachika_reg_jina[i], jina)) { rudisha pachika_reg_nodi[i]; }
        i = i + 1;
    }
    rudisha -1;
}

// -------- Uchunguzi wa ustahiki (eligibility scan) --------
// Hutembea mwili MZIMA (ikifuata ast_nne kama sehemu ya utembeaji
// wake wenyewe -- mwitaji anahitaji kuita mara MOJA TU kwenye
// taarifa ya kwanza). Huweka bendera za kimataifa badala ya
// kurudisha thamani, kwa sababu tunahitaji majibu matatu tofauti
// (ovyo, kujiita) kutoka pitio moja.
n32 pachika_chunguza_ovyo = 0;
n8* pachika_chunguza_jina_msingi = 0;
n32 pachika_chunguza_kujiita = 0;
n8* pachika_chunguza_kigezo_jina[6];
n32 pachika_chunguza_kigezo_idadi = 0;

n32 pachika_chunguza_ni_paramu(n8* jina) {
    n32 i = 0;
    wakati (i < pachika_chunguza_kigezo_idadi) {
        kama (pachika_jina_sawa(jina, pachika_chunguza_kigezo_jina[i])) { rudisha 1; }
        i = i + 1;
    }
    rudisha 0;
}

w0 pachika_chunguza(n32 nodi_hii) {
    kama (nodi_hii < 0) { rudisha; }
    n32 aina = mti_aina[nodi_hii];
    kama (aina == MTI_TANGAZO) { pachika_chunguza_ovyo = 1; rudisha; }
    kama (aina == MTI_WAKATI) { pachika_chunguza_ovyo = 1; rudisha; }
    kama (aina == MTI_KAMA) { pachika_chunguza_ovyo = 1; rudisha; }
    kama (aina == MTI_CHAGUA) { pachika_chunguza_ovyo = 1; rudisha; }
    kama (aina == MTI_RUDISHA) {
        kama (mti_kushoto[nodi_hii] != -1) { pachika_chunguza_ovyo = 1; }
        kama (mti_nne[nodi_hii] != -1) { pachika_chunguza_ovyo = 1; }
        pachika_chunguza(mti_kushoto[nodi_hii]);
        pachika_chunguza(mti_nne[nodi_hii]);
        rudisha;
    }
    kama (aina == MTI_WITO) {
        n32 callee = mti_kushoto[nodi_hii];
        kama (callee != -1) {
            kama (mti_aina[callee] == MTI_KITAMBULISHO) {
                n8* cjina = mti_dimbwi + mti_jina_ofseti[callee];
                kama (pachika_jina_sawa(cjina, pachika_chunguza_jina_msingi)) { pachika_chunguza_kujiita = 1; }
            }
        }
        n32 a = mti_kulia[nodi_hii];
        wakati (a != -1) {
            pachika_chunguza(a);
            a = mti_tiga[a];
        }
        pachika_chunguza(mti_nne[nodi_hii]);
        rudisha;
    }
    kama (aina == MTI_KIZUIZI) {
        pachika_chunguza(mti_kushoto[nodi_hii]);
        pachika_chunguza(mti_nne[nodi_hii]);
        rudisha;
    }
    kama (aina == MTI_NAMBARI || aina == MTI_HALISI_D || aina == MTI_MFUATANO) {
        pachika_chunguza(mti_nne[nodi_hii]);
        rudisha;
    }
    kama (aina == MTI_KITAMBULISHO) {
        // Marejeleo ya thamani (SI nafasi ya mwito -- hiyo inashughulikiwa
        // na tawi la AST_WITO juu bila kupitia hapa). F yenye ustahiki
        // lazima igusi PARAMU ZAKE PEKEE -- kigezo cha ulimwengu (global)
        // chochote kinachoguswa moja kwa moja kinafanya F kutostahili,
        // kuepuka hatari ya "kunasa" jina hilo hilo la kigezo cha ndani
        // cha mwitaji baada ya kusukwa (tatizo la classic la "hygiene"
        // katika upanuzi wa inline: bila kizuizi hiki, kigezo cha
        // ulimwengu kilichotajwa na F kingeweza kufasiriwa vibaya kama
        // kigezo cha ndani cha mwitaji ikiwa majina yanafanana kwa bahati).
        n8* jina = mti_dimbwi + mti_jina_ofseti[nodi_hii];
        kama (pachika_chunguza_ni_paramu(jina) == 0) { pachika_chunguza_ovyo = 1; }
        pachika_chunguza(mti_nne[nodi_hii]);
        rudisha;
    }
    // Kesi ya jumla (usemi wa binary, ugawaji, n.k.)
    pachika_chunguza(mti_kushoto[nodi_hii]);
    pachika_chunguza(mti_kulia[nodi_hii]);
    pachika_chunguza(mti_nne[nodi_hii]);
}

n32 pachika_hesabu_taarifa(n32 mwili) {
    n32 n = 0;
    n32 nodi_hii = mwili;
    wakati (nodi_hii != -1) {
        n = n + 1;
        nodi_hii = mti_nne[nodi_hii];
    }
    rudisha n;
}

n32 pachika_mgombea(n32 kazi_nodi) {
    n32 matokeo_aina = mti_thamani[kazi_nodi];
    kama (matokeo_aina != PACHIKA_W0_USIMBAJI) { rudisha 0; }

    n32 mwili = mti_tiga[kazi_nodi];
    kama (mwili == -1) { rudisha 0; }

    n32 pn = mti_kulia[kazi_nodi];
    n32 pcount = 0;
    wakati (pn != -1) {
        kama (mti_thamani[pn] <= 0) { rudisha 0; }
        kama (pcount >= 6) { rudisha 0; }
        pachika_chunguza_kigezo_jina[pcount] = mti_dimbwi + mti_jina_ofseti[pn];
        pcount = pcount + 1;
        pn = mti_kulia[pn];
    }

    kama (pachika_hesabu_taarifa(mwili) > PACHIKA_KIKOMO_TAARIFA) { rudisha 0; }

    pachika_chunguza_ovyo = 0;
    pachika_chunguza_jina_msingi = mti_dimbwi + mti_jina_ofseti[mti_kushoto[kazi_nodi]];
    pachika_chunguza_kujiita = 0;
    pachika_chunguza_kigezo_idadi = pcount;
    pachika_chunguza(mwili);
    kama (pachika_chunguza_ovyo) { rudisha 0; }
    kama (pachika_chunguza_kujiita) { rudisha 0; }

    rudisha 1;
}

// -------- Ramani ya majina (paramu ya asili -> jina jipya la kipekee) --------
// Bafa BAPA (SI safu ya 2D -- lugha haina hilo): nafasi ya i
// inakalia baiti [i*64, i*64+63].
n8 pachika_ramani_zamani[384];  // 6 * 64
n8 pachika_ramani_mpya[384];
n32 pachika_ramani_idadi = 0;

n32 pachika_jina_ni_ramani(n8* jina) {
    n32 i = 0;
    wakati (i < pachika_ramani_idadi) {
        kama (pachika_jina_sawa(jina, pachika_ramani_zamani + (i * 64))) { rudisha i; }
        i = i + 1;
    }
    rudisha -1;
}

// -------- Nakala ya usemi/taarifa yenye ubadilishaji wa majina --------
n32 pachika_nakili(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha -1; }
    n32 aina = mti_aina[nodi_hii];

    kama (aina == MTI_KITAMBULISHO) {
        n8* jina = mti_dimbwi + mti_jina_ofseti[nodi_hii];
        n32 mi = pachika_jina_ni_ramani(jina);
        n32 nn = nodi_mpya(MTI_KITAMBULISHO, mti_thamani[nodi_hii], -1, -1);
        kama (nn == -1) { rudisha -1; }
        kama (mi != -1) {
            n8* jj = pachika_ramani_mpya + (mi * 64);
            hifadhi_jina(nn, jj, pachika_urefu_jina(jj));
        } sivyo {
            hifadhi_jina(nn, jina, pachika_urefu_jina(jina));
        }
        rudisha nn;
    }

    kama (aina == MTI_NAMBARI || aina == MTI_HALISI_D) {
        // ast_kulia hapa ni bendera ya dimbwi la n64 kubwa (faharisi
        // ya dimbwi, SI nodi ya AST) -- kuinakili bila kuigusa ni
        // sahihi, dimbwi lenyewe (nje ya safu za ast_*) haligusiki.
        rudisha nodi_mpya(aina, mti_thamani[nodi_hii], mti_kushoto[nodi_hii], mti_kulia[nodi_hii]);
    }

    kama (aina == MTI_WITO) {
        n32 callee_nakala = pachika_nakili(mti_kushoto[nodi_hii]);
        n32 nn = nodi_mpya(MTI_WITO, mti_thamani[nodi_hii], callee_nakala, -1);
        kama (nn == -1) { rudisha -1; }
        n32 a = mti_kulia[nodi_hii];
        n32 kwanza_hoja = -1;
        n32 mwisho_hoja = -1;
        wakati (a != -1) {
            n32 ac = pachika_nakili(a);
            kama (kwanza_hoja == -1) { kwanza_hoja = ac; }
            sivyo { mti_tiga[mwisho_hoja] = ac; }
            mwisho_hoja = ac;
            a = mti_tiga[a];
        }
        mti_kulia[nn] = kwanza_hoja;
        rudisha nn;
    }

    // Kesi ya jumla: usemi wa binary/ugawaji (kushoto/kulia pekee,
    // si tiga/nne -- hizo ni maalum kwa muktadha wa mnyororo wa
    // taarifa, zinashughulikiwa na inl_nakili_taarifa).
    n32 kn = pachika_nakili(mti_kushoto[nodi_hii]);
    n32 kl = pachika_nakili(mti_kulia[nodi_hii]);
    rudisha nodi_mpya(aina, mti_thamani[nodi_hii], kn, kl);
}

n32 pachika_nakili_taarifa(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha -1; }
    n32 aina = mti_aina[nodi_hii];
    kama (aina == MTI_RUDISHA) { rudisha -1; }  // rudisha; tupu -- imeachwa (F inaendelea kuanguka)
    kama (aina == MTI_KIZUIZI) { rudisha -1; }  // mwili tupu -- hakuna cha kunakili
    kama (aina == MTI_WITO) { rudisha pachika_nakili(nodi_hii); }
    n32 kn = pachika_nakili(mti_kushoto[nodi_hii]);
    n32 kl = pachika_nakili(mti_kulia[nodi_hii]);
    rudisha nodi_mpya(aina, mti_thamani[nodi_hii], kn, kl);
}

// Andika "il<id>_<jina la asili>" (kikomo cha baiti 60 kwa jina la
// asili, cha kutosha kwa majina yoyote halisi ya paramu).
n32 pachika_jenga_jina(n8* bafa, n32 id, n8* asili) {
    n32 nafasi = 0;
    bafa[nafasi] = 105; nafasi = nafasi + 1;  // 'i'
    bafa[nafasi] = 108; nafasi = nafasi + 1;  // 'l'
    kama (id == 0) {
        bafa[nafasi] = 48; nafasi = nafasi + 1;
    } sivyo {
        n8 muda[16];
        n32 tn = 0;
        n32 v = id;
        wakati (v > 0) {
            muda[tn] = 48 + (v % 10);
            tn = tn + 1;
            v = v / 10;
        }
        wakati (tn > 0) {
            tn = tn - 1;
            bafa[nafasi] = muda[tn];
            nafasi = nafasi + 1;
        }
    }
    bafa[nafasi] = 95; nafasi = nafasi + 1;  // '_'
    n32 i = 0;
    wakati (asili[i] != 0 && nafasi < 60) {
        bafa[nafasi] = asili[i];
        nafasi = nafasi + 1;
        i = i + 1;
    }
    bafa[nafasi] = 0;
    rudisha nafasi;
}

n32 pachika_kesi_id = 0;
n32 pachika_matokeo_mwanzo = -1;
n32 pachika_matokeo_mwisho = -1;
n8* pachika_p_jina[6];
n32 pachika_p_usimbaji[6];
n32 pachika_p_hoja[6];

n32 pachika_jaribu_wito(n32 wito_nodi) {
    pachika_matokeo_mwanzo = -1;
    pachika_matokeo_mwisho = -1;
    kama (mti_aina[wito_nodi] != MTI_WITO) { rudisha 0; }
    n32 callee_id = mti_kushoto[wito_nodi];
    kama (callee_id == -1) { rudisha 0; }
    kama (mti_aina[callee_id] != MTI_KITAMBULISHO) { rudisha 0; }
    n8* cjina = mti_dimbwi + mti_jina_ofseti[callee_id];
    n32 kazi_nodi = pachika_tafuta_kazi(cjina);
    kama (kazi_nodi == -1) { rudisha 0; }
    kama (pachika_mgombea(kazi_nodi) == 0) { rudisha 0; }

    n32 pc = 0;
    n32 pn = mti_kulia[kazi_nodi];
    n32 an = mti_kulia[wito_nodi];
    wakati (pn != -1) {
        kama (an == -1) { rudisha 0; }  // hoja pungufu -- usiunganishe
        kama (pc >= 6) { rudisha 0; }
        pachika_p_jina[pc] = mti_dimbwi + mti_jina_ofseti[pn];
        pachika_p_usimbaji[pc] = mti_thamani[pn];
        pachika_p_hoja[pc] = an;
        pc = pc + 1;
        pn = mti_kulia[pn];
        an = mti_tiga[an];
    }
    kama (an != -1) { rudisha 0; }  // hoja nyingi mno -- usiunganishe

    pachika_kesi_id = pachika_kesi_id + 1;
    n32 kid = pachika_kesi_id;

    pachika_ramani_idadi = pc;
    n32 i = 0;
    wakati (i < pc) {
        n32 j = 0;
        wakati (pachika_p_jina[i][j] != 0 && j < 63) {
            pachika_ramani_zamani[(i * 64) + j] = pachika_p_jina[i][j];
            j = j + 1;
        }
        pachika_ramani_zamani[(i * 64) + j] = 0;
        n8 bafa[64];
        pachika_jenga_jina(bafa, kid, pachika_p_jina[i]);
        n32 k = 0;
        wakati (bafa[k] != 0) {
            pachika_ramani_mpya[(i * 64) + k] = bafa[k];
            k = k + 1;
        }
        pachika_ramani_mpya[(i * 64) + k] = 0;
        i = i + 1;
    }

    n32 mwanzo = -1;
    n32 mwisho = -1;
    i = pc;
    wakati (i > 0) {
        i = i - 1;
        n32 kigeu_name = nodi_mpya(MTI_KITAMBULISHO, 0, -1, -1);
        n8* jj = pachika_ramani_mpya + (i * 64);
        hifadhi_jina(kigeu_name, jj, pachika_urefu_jina(jj));
        mti_thamani[kigeu_name] = pachika_p_usimbaji[i];
        n32 tangazo = nodi_mpya(MTI_TANGAZO, pachika_p_usimbaji[i], kigeu_name, pachika_p_hoja[i]);
        kama (mwanzo == -1) { mwanzo = tangazo; } sivyo { mti_nne[mwisho] = tangazo; }
        mwisho = tangazo;
    }

    n32 chanzo_hiki = mti_tiga[kazi_nodi];
    wakati (chanzo_hiki != -1) {
        n32 kopi = pachika_nakili_taarifa(chanzo_hiki);
        kama (kopi != -1) {
            kama (mwanzo == -1) { mwanzo = kopi; } sivyo { mti_nne[mwisho] = kopi; }
            mwisho = kopi;
        }
        chanzo_hiki = mti_nne[chanzo_hiki];
    }

    kama (mwanzo == -1) {
        mwanzo = nodi_mpya(MTI_KIZUIZI, 0, -1, -1);
        mwisho = mwanzo;
    }

    pachika_matokeo_mwanzo = mwanzo;
    pachika_matokeo_mwisho = mwisho;
    rudisha 1;
}

n32 pachika_pitisha_mwili(n32 kichwa) {
    n32 mpya_kichwa = -1;
    n32 mpya_mwisho = -1;
    n32 nodi_hii = kichwa;
    wakati (nodi_hii != -1) {
        n32 ijayo = mti_nne[nodi_hii];
        n32 kuunganishwa = 0;
        kama (mti_aina[nodi_hii] == MTI_WITO) {
            kama (pachika_jaribu_wito(nodi_hii)) { kuunganishwa = 1; }
        }
        kama (kuunganishwa) {
            kama (mpya_kichwa == -1) { mpya_kichwa = pachika_matokeo_mwanzo; }
            sivyo { mti_nne[mpya_mwisho] = pachika_matokeo_mwanzo; }
            mpya_mwisho = pachika_matokeo_mwisho;
        } sivyo {
            kama (mpya_kichwa == -1) { mpya_kichwa = nodi_hii; }
            sivyo { mti_nne[mpya_mwisho] = nodi_hii; }
            mpya_mwisho = nodi_hii;
        }
        nodi_hii = ijayo;
    }
    kama (mpya_mwisho != -1) { mti_nne[mpya_mwisho] = -1; }
    rudisha mpya_kichwa;
}

n32 kujumuisha_kazi_ndogo(n32 mzizi) {
    pachika_jaza_sajili(mzizi);
    n32 nodi_hii = mti_kushoto[mzizi];
    wakati (nodi_hii != -1) {
        kama (mti_aina[nodi_hii] == MTI_KAZI) {
            kama (mti_tiga[nodi_hii] != -1) {
                n32 mpya = pachika_pitisha_mwili(mti_tiga[nodi_hii]);
                mti_tiga[nodi_hii] = mpya;
            }
        }
        nodi_hii = mti_nne[nodi_hii];
    }
    rudisha mzizi;
}

// =========================================================
// LICM -- kuhamisha hesabu isiyobadilika nje ya kitanzi
// (loop-invariant code motion)
// =========================================================
//
// Lengo: kama usemi fulani ndani ya mwili wa "wakati" hutoa MATOKEO
// SAWA kila mzunguko (hakuna kigezo kinachokitegemea kinachobadilika
// popote ndani ya mwili), kihesabu MARA MOJA kabla ya kitanzi badala
// ya kukihesabu kila mzunguko.
//
// MUHIMU KUHUSU MAHALI PA AWAMU HII KWENYE MRADI (TOFAUTI NA
// kujumuisha_kazi_ndogo juu): awamu hii inaendeshwa BAADA ya
// mkaguzi_angalia (ukaguzi wa kisemantiki), SI kabla -- tofauti na
// kuunganisha kazi ndogo. Sababu: kila nodi ya usemi baada ya
// mkaguzi_angalia tayari ina ast_thamani[node] = usimbaji wa aina
// (enc) uliothibitishwa (angalia mkaguzi_kagua_usemi, mkaguzi.swa) --
// hivyo tunapotengeneza tamko jipya la kigezo cha muda kwa usemi
// uliogunduliwa kuwa hauwadiliki, tunaweza KUNAKILI enc hiyo moja kwa
// moja kutoka kwenye nodi ya mzizi ya usemi uliopatikana, bila
// kuhitaji kujenga jedwali letu wenyewe la aina za vigezo (ambalo
// lingekuwa chanzo kingine cha mdudu). Bei ya uamuzi huu: hatupati
// tena ukaguzi wa mkaguzi_angalia kama "wavu wa usalama wa bure" kwa
// mti tuliousuka (kama kuunganisha kazi ndogo kunavyofanya) -- lakini
// teremsha (ukaguzi wa muundo) bado unatembea baada yetu, na zaidi ya
// yote, mnyororo mzima wa majaribio (gharama/jaribu-mnyororo.mapishi) ndio
// wavu wa usalama halisi kwa mabadiliko haya yote.
//
// HATARI SITA ZILIZOZINGATIWA KWA MAKUSUDI (kila moja ina jaribio la
// kudumu linaloambatana, angalia majaribio/programu/jaribio_licm_*):
//
// 1. HAKUNA OPERESHENI INAYOWEZA KUSHINDWA. Mgombea wa kuhamishwa
//    huruhusiwa TU kama mizizi/matawi yake yote ni miongoni mwa: +,
//    -, *, ulinganisho (<,>,<=,>=,==,!=), na biti (&,|,^,<<,>>).
//    Mgawanyo (/) na modulo (%) HAZIRUHUSIWI KAMWE -- kuhamisha
//    mgawanyo unaoweza kushindwa (kigawanyaji sifuri) juu ya kitanzi
//    ambacho huenda kisitekelezwe kamwe kungegeuza programu
//    isiyoanguka kuwa moja inayoanguka kabla kitanzi hakijaanza.
//    (angalia jaribio_licm_mgawanyiko_hauhamishwi.swa)
//
// 2. HAKUNA OPERAND INAYOGUSA KUMBUKUMBU. Mgombea lazima ujengwe TU
//    kutoka kwa vigezo vya moja kwa moja (vya ndani, vya ulimwengu,
//    au paramu -- kwa JINA, si kupitia kielekezi/safu/muundo) na
//    namba za moja kwa moja. Nodi yoyote ya AST_TAJA (ambayo hutumika
//    KWA MOJA KWA MOJA kwa DEREFERENSI *p NA fahirisi ya safu
//    arr[idx] -- angalia changanua_usemi_upande), AST_KUMBUKA
//    (anwani-ya &x), au AST_SEHEMU_DOT/MSHALE (s.f / s->f) popote
//    ndani ya mti mdogo hufanya mti huo mdogo usistahili KABISA --
//    hakuna uchambuzi wa uwiano (alias analysis) unaohitajika kwa
//    sababu hatuwezi kamwe kufikia hatua ambapo swali hilo lingekuwa
//    muhimu. (angalia jaribio_licm_kumbukumbu_haihamishwi.swa)
//
// 3. KITANZI CHENYE WITO WOWOTE (AST_WITO) POPOTE NDANI YA MWILI WAKE
//    (au sharti lake) HAKIGOMBEI LICM KABISA -- kizuizi kikali lakini
//    salama dhidi ya uwiano kupitia wito (kazi iliyoitwa inaweza
//    kubadilisha kigezo cha ulimwengu ambacho usemi "usiobadilika"
//    unakitegemea). (angalia jaribio_licm_wito_huzuia_kitanzi.swa)
//
// 4. TABIA YA "KITANZI KINACHOENDESHWA MARA SIFURI" HAIBADILIKI KAMWE.
//    Njia salama iliyotumika: HATUONDOI, KUFUTA, WALA KUPANGA UPYA
//    taarifa yoyote iliyopo ya mtumiaji. Badala yake, tunatengeneza
//    KIGEZO KIPYA CHA MUDA, tunakihesabu MARA MOJA kabla ya kitanzi,
//    kisha tunaandika UPYA MAHALI HASA pa tukio la usemi huo ndani ya
//    mwili (uwanja mmoja wa mzazi -- kushoto AU kulia) kuelekeza kwa
//    hicho kigezo kipya. Hii ni "usukaji wa ngazi-ya-mti-mdogo"
//    (subexpression-level splicing), SI uhamishaji wa taarifa nzima.
//    (angalia jaribio_licm_mzunguko_sifuri.swa)
//
// 5. UCHUNGUZI KAMILI WA MWILI MZIMA WA UBADILISHAJI, SI TAARIFA ZA
//    NGAZI YA JUU TU -- usemi ni "usiobadilika" TU kama kila kigezo
//    unachokitaja hakiandikwi POPOTE ndani ya mwili, ikiwa ni pamoja
//    na ndani ya matawi ya "kama" yaliyowekwa ndani (nested). Njia hii
//    inaiga kwa makusudi mfano wa inl_scan (kuunganisha kazi ndogo)
//    na kusanya_vigeu_vya_ndani (uzalishaji.swa) -- utembeaji kamili
//    wa AST bila kudhania thamani zilizosimbwa (mf. -777777) kuwa
//    nodi. (angalia jaribio_licm_ubadilishaji_ndani_ya_kama.swa)
//
// 6. WIGO WA KITANZI: "wakati" TU kwa awamu hii. Tumethibitisha
//    kuwa "kwa" hufunguliwa (desugared) kuwa NODI ILE ILE ya
//    AST_WAKATI (angalia changanua_taarifa_kwa) -- kwa hiyo mnyororo
//    huu wa LICM UNAFANYA KAZI kwa kitanzi cha "kwa" pia MRADI TU
//    hakina kifungu cha "anzisha" (init, kilichohifadhiwa kwenye
//    ast_tiga[wakati_node] kwa "kwa"). Kifungu cha "anzisha"
//    hutekelezwa NDANI YA nodi hiyo hiyo ya AST_WAKATI, KABLA ya
//    sharti kuangaliwa mara ya kwanza -- kama tungehamisha kigezo cha
//    muda KABLA ya nodi nzima ya kitanzi (ambako lazima kiende kwa
//    sababu ndipo tunapoandika upya mnyororo wa taarifa unaozunguka),
//    kigezo hicho kingesoma thamani ya KABLA ya "anzisha" kutekelezwa
//    -- mdudu hasa unaofanana na ule "kwa (n=10; i<n; ...)" ambapo n
//    ingesomwa KABLA haijawekwa. Badala ya kuongeza usanifu wa ziada
//    kushughulikia mpangilio huu maalum, tunapunguza wigo kwa
//    makusudi: kitanzi kinastahili LICM TU kama ast_tiga[node] == -1
//    (hakuna "anzisha" cha kwa). "fanya" (do-while, ast_thamani ==
//    -777778 kwenye nodi hiyo hiyo) hakizuiliwi wazi na sharti hili,
//    lakini pia hakijalengwa kwa makusudi na hakijajaribiwa -- kama
//    kitanzi cha aina hiyo kikitokea na ast_tiga[node]==-1, kitachukuliwa
//    kwa asili (bila kuzingatiwa maalum), kwa sababu usukaji wetu
//    hautegemei kabisa ni lini sharti linaangaliwa -- lakini hii SI
//    dai la kuthibitishwa kwa jaribio maalum, ni matokeo ya asili tu
//    ya jinsi AST inavyofanana.
//
// KIZUIZI CHA WIGO CHA ZIADA (kilichochaguliwa kwa makusudi wakati wa
// utekelezaji, si kwa uzembe): tunatafuta mgombea WA KUHAMISHWA TU
// ndani ya taarifa za NGAZI YA JUU za mwili wa kitanzi (mnyororo wa
// moja kwa moja wa ast_nne) ambazo ni AST_ASIMILIA (x = ...) au
// AST_TANGAZO na kianzio (n32 t = ...) -- SI ndani ya matawi ya
// "kama" yaliyowekwa ndani ya mwili huo huo (hata kama kinadharia
// itakuwa salama, kwa sababu shughuli zote zinazoruhusiwa
// hazishindwi kamwe -- lakini tumeamua kutoipanua zaidi ili kuepuka
// utata usiohitajika wa usanifu kwa awamu hii). Vitanzi vilivyowekwa
// ndani (nested wakati) hushughulikiwa KWANZA (mwili wa ndani
// kabisa kwanza), kisha matokeo yao (ikiwa ni pamoja na matamko
// mapya ya muda yaliyoongezwa) huwa sehemu ya mnyororo wa ngazi ya
// juu wa kitanzi cha nje kwa madhumuni ya uchunguzi unaofuata --
// hivyo hesabu inayobadilika mara mbili (invariant kwa vitanzi vyote
// viwili) INAWEZA kuhamishwa ngazi MOJA zaidi kwa asili, lakini SI
// mbili kwa pito moja (kikomo kinachojulikana, kimeandikwa wazi).

n32 pandisha_imetembelewa[1048576];
n32 pandisha_kizazi = 1;
n32 pandisha_idadi = 0;

n32 pandisha_acha = 0;
n8* pandisha_badiliko_jina[64];
n32 pandisha_badiliko_idadi = 0;

n32 pandisha_ni_jina_badilishwa(n8* jina) {
    n32 i = 0;
    wakati (i < pandisha_badiliko_idadi) {
        kama (pachika_jina_sawa(jina, pandisha_badiliko_jina[i])) { rudisha 1; }
        i = i + 1;
    }
    rudisha 0;
}

w0 pandisha_ongeza_badiliko(n8* jina) {
    kama (pandisha_ni_jina_badilishwa(jina)) { rudisha; }
    kama (pandisha_badiliko_idadi >= 64) {
        // Kikomo kimefikiwa -- USIONDOE jina kimya kimya (hilo
        // lingekuwa hatari, si ulinzi): kata tamaa kwa kitanzi hiki
        // CHOTE badala yake, ni salama zaidi kutokuhamisha kuliko
        // kuhamisha kimakosa.
        pandisha_acha = 1;
        rudisha;
    }
    pandisha_badiliko_jina[pandisha_badiliko_idadi] = jina;
    pandisha_badiliko_idadi = pandisha_badiliko_idadi + 1;
}

// Utembeaji kamili wa mwili wa kitanzi (na sharti lake): hukusanya
// majina yote ya vigezo vinavyoandikwa POPOTE (ikiwa ni pamoja na
// ndani ya matawi ya kama na vitanzi vilivyowekwa ndani), na huweka
// licm_bail=1 kama wito wowote (AST_WITO) au muundo usiotambuliwa
// kikamilifu (AST_CHAGUA/AST_MUUNDO/AST_SEHEMU/AST_HALI) unapatikana
// popote. Inaiga makusudi ruka_tiga/ruka_nne ya kusanya_vigeu_vya_ndani
// (uzalishaji.swa) kwa nodi za jumla, ikiwa na visa maalum vya ziada
// kwa AST_KAMA/AST_SIVYO/AST_WAKATI (kuingia ndani ya matawi yote,
// tofauti na inl_scan ambayo huvikataa moja kwa moja).
w0 pandisha_changanua_mwili(n32 nodi_hii) {
    pandisha_idadi = pandisha_idadi + 1;
    kama (pandisha_idadi > 50000) { pandisha_acha = 1; rudisha; }
    kama (nodi_hii < 0) { rudisha; }
    kama (nodi_hii >= 1048576) { rudisha; }
    kama (pandisha_imetembelewa[nodi_hii] == pandisha_kizazi) { rudisha; }
    pandisha_imetembelewa[nodi_hii] = pandisha_kizazi;
    n32 aina = mti_aina[nodi_hii];

    kama (aina == MTI_NAMBARI || aina == MTI_HALISI_D) { rudisha; }

    kama (aina == MTI_WITO) { pandisha_acha = 1; rudisha; }
    kama (aina == MTI_CHAGUA || aina == MTI_MUUNDO || aina == MTI_SEHEMU || aina == MTI_HALI) {
        // Miundo isiyotambuliwa kikamilifu na uchunguzi huu -- kata
        // tamaa kwa uangalifu badala ya kudhania mpangilio wa nyanja.
        pandisha_acha = 1;
        rudisha;
    }

    kama (aina == MTI_KIZUIZI) {
        pandisha_changanua_mwili(mti_kushoto[nodi_hii]);
        pandisha_changanua_mwili(mti_nne[nodi_hii]);
        rudisha;
    }
    kama (aina == MTI_TANGAZO) {
        // Jina lililotangazwa NDANI ya mwili wa kitanzi lazima litibiwe
        // kama "limebadilishwa" -- hata kama lina kianzio kimoja tu kwa
        // kila mzunguko, kianzio hicho MARA NYINGI hutegemea kigezo
        // kinachobadilika (mf. "D64 n_d = n;" ndani ya "wakati (n<=20)")
        // hivyo thamani ya jina hili SIYO sawa kila mzunguko. Bila hii,
        // usemi unaotumia jina hili ungeonekana (kimakosa) usiobadilika.
        n32 kigeu_nodi = mti_kushoto[nodi_hii];
        kama (kigeu_nodi != -1 && mti_aina[kigeu_nodi] == MTI_KITAMBULISHO) {
            pandisha_ongeza_badiliko(mti_dimbwi + mti_jina_ofseti[kigeu_nodi]);
        }
        pandisha_changanua_mwili(mti_kulia[nodi_hii]);  // kianzio
        pandisha_changanua_mwili(mti_nne[nodi_hii]);
        rudisha;
    }
    kama (aina == MTI_KAMA) {
        pandisha_changanua_mwili(mti_kushoto[nodi_hii]);  // sharti
        pandisha_changanua_mwili(mti_kulia[nodi_hii]);    // mwili-ndio
        kama (mti_tiga[nodi_hii] != -1) { pandisha_changanua_mwili(mti_tiga[nodi_hii]); }  // AST_SIVYO
        pandisha_changanua_mwili(mti_nne[nodi_hii]);
        rudisha;
    }
    kama (aina == MTI_SIVYO) {
        pandisha_changanua_mwili(mti_kushoto[nodi_hii]);  // mwili-sivyo
        pandisha_changanua_mwili(mti_nne[nodi_hii]);
        rudisha;
    }
    kama (aina == MTI_WAKATI) {
        pandisha_changanua_mwili(mti_kushoto[nodi_hii]);  // sharti
        pandisha_changanua_mwili(mti_kulia[nodi_hii]);    // mwili
        kama (mti_tiga[nodi_hii] != -1) { pandisha_changanua_mwili(mti_tiga[nodi_hii]); }  // anzisha (kwa)
        pandisha_changanua_mwili(mti_nne[nodi_hii]);
        rudisha;
    }
    kama (aina == MTI_ASIMILIA) {
        n32 lengo = mti_kushoto[nodi_hii];
        kama (lengo != -1 && mti_aina[lengo] == MTI_KITAMBULISHO) {
            pandisha_ongeza_badiliko(mti_dimbwi + mti_jina_ofseti[lengo]);
        } sivyo {
            // Lengo si jina safi (mf. *p = .., arr[i] = .., s.f = ..) --
            // bado tembelea ndani yake (fahirisi n.k. inaweza kutaja
            // vigezo, ingawa haibadilishi jina lenyewe).
            pandisha_changanua_mwili(lengo);
        }
        pandisha_changanua_mwili(mti_kulia[nodi_hii]);  // upande wa kulia
        pandisha_changanua_mwili(mti_nne[nodi_hii]);
        rudisha;
    }
    kama (aina == MTI_KUMBUKA) {
        // &jina -- anwani ya kigezo imechukuliwa. Hakuna wito wowote
        // unaowezekana ndani ya kitanzi hiki (tayari umezuiliwa juu),
        // hivyo hakuna njia ya kuandika kupitia anwani hii -- lakini
        // tibu kigezo kama kimebadilishwa kwa tahadhari ya ziada,
        // isiyogharimu chochote.
        n32 hoja = mti_kushoto[nodi_hii];
        kama (hoja != -1 && mti_aina[hoja] == MTI_KITAMBULISHO) {
            pandisha_ongeza_badiliko(mti_dimbwi + mti_jina_ofseti[hoja]);
        }
        pandisha_changanua_mwili(mti_nne[nodi_hii]);
        rudisha;
    }

    // Njia ya jumla (usemi wa hesabu/linganisho/biti, AST_TAJA,
    // AST_SEHEMU_DOT/MSHALE, n.k.) -- ast_tiga KAMWE si nodi halisi
    // hapa (kiungo cha mnyororo wa hoja za wito, au usimbaji), hivyo
    // haitembelewi kamwe kwenye njia hii.
    pandisha_changanua_mwili(mti_kushoto[nodi_hii]);
    pandisha_changanua_mwili(mti_kulia[nodi_hii]);
    n32 ruka_nne = 0;
    kama (aina == 33 || aina == 34) { ruka_nne = 1; }  // SEHEMU_DOT/MSHALE: ofseti ya baiti
    kama (ruka_nne == 0) { pandisha_changanua_mwili(mti_nne[nodi_hii]); }
}

// Uchunguzi wa ustahiki (bila madhara ya kando) -- hurudisha 1 KAMA
// NA KAMA TU nodi na mti wake mdogo mzima umejengwa peke yake kutoka
// kwa: (a) namba za moja kwa moja (AST_NAMBARI/AST_HALISI_D), (b)
// vigezo vya moja kwa moja visivyobadilishwa mahali popote ndani ya
// kitanzi hiki (angalia licm_ni_jina_badilishwa), (c) +, -, *,
// ulinganisho, na biti -- KAMWE si /, %, TAJA (deref/safu), KUMBUKA
// (anwani), SEHEMU_DOT/MSHALE, WITO, ASIMILIA, TERNARY, n.k.
n32 pandisha_ni_operesheni(n32 nodi_hii) {
    n32 aina = mti_aina[nodi_hii];
    kama (aina == MTI_JUMLISHA || aina == MTI_TOFAUTI || aina == MTI_ZIDISHA) { rudisha 1; }
    kama (aina == MTI_SAWA || aina == MTI_TOFAUTI_SI || aina == MTI_CHINI || aina == MTI_JUU || aina == MTI_CHINI_SAWA || aina == MTI_JUU_SAWA) { rudisha 1; }
    kama (aina == MTI_HAMISHA_KUSHOTO || aina == MTI_HAMISHA_KULIA || aina == MTI_BITI_AU || aina == MTI_BITI_NA || aina == MTI_XOR) { rudisha 1; }
    rudisha 0;
}

n32 pandisha_naingiliana(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha 0; }
    n32 aina = mti_aina[nodi_hii];
    kama (aina == MTI_NAMBARI || aina == MTI_HALISI_D) { rudisha 1; }
    kama (aina == MTI_KITAMBULISHO) {
        n8* jina = mti_dimbwi + mti_jina_ofseti[nodi_hii];
        kama (pandisha_ni_jina_badilishwa(jina)) { rudisha 0; }
        rudisha 1;
    }
    kama (pandisha_ni_operesheni(nodi_hii) == 0) { rudisha 0; }
    kama (pandisha_naingiliana(mti_kushoto[nodi_hii]) == 0) { rudisha 0; }
    kama (pandisha_naingiliana(mti_kulia[nodi_hii]) == 0) { rudisha 0; }
    rudisha 1;
}

// -------- CSE ya vielelezo vilivyohamishwa (cross-occurrence) --------
// Kabla ya hii, kila TOKEO la usemi usiobadilika lilipata kigezo chake
// CHA PEKEE cha muda -- hata kama tokeo mbili (au zaidi) zilikuwa
// zikikokotoa THAMANI ILE ILE kwa MUUNDO SAWA KABISA (mfano halisi wa
// matriki: "c[i*n+j] = c[i*n+j] + x" -- "i*n" hutokea MARA MBILI, moja
// kwenye fahirisi ya LHS na moja kwenye fahirisi ya kwanza ya RHS,
// zikijitegemea kikamilifu kupitia licm_badilisha_kama_inavyowezekana).
// Hii ilizuia kashe ya anwani ya ugawaji wa kawaida (keq_taja_sawa,
// uzalishaji.swa, PR #239) kutambua fahirisi mbili za c[...] kuwa SAWA
// KIMUUNDO, kwa sababu baada ya LICM zilikuwa zikirejelea VIGEZO VYA
// MUDA VYENYE MAJINA TOFAUTI (thibitishwa kwa disassembly -- maagizo
// yale yale ya kuzidisha yalionekana MARA MBILI mfululizo kabla ya
// kitanzi). licm_keq (chini) ni ulinganisho wa muundo wa AST -- SI wa
// jina la kigezo cha muda -- unaotumika KUGUNDUA hali hiyo KABLA ya
// kutengeneza kigezo kipya, ili tokeo la PILI (na lolote linalofuata)
// litumie TENA kigezo kilichotengenezwa na tokeo la KWANZA badala ya
// kutengeneza lake lenyewe.
//
// USALAMA: kila mgombea anayefikia ulinganisho huu tayari amepitisha
// licm_ni_operesheni(node) && licm_naingiliana(node) KIVYAKE (yaani
// tayari amethibitishwa kuwa hauguswi na chochote kilichoandikwa ndani
// ya kitanzi hiki -- angalia licm_badilisha_kama_inavyowezekana) --
// licm_keq HAIONGEZI uthibitisho wowote mpya wa "hauguswi", inaongeza
// TU uthibitisho wa ziada kuwa MBILI ya vitu tayari-vilivyothibitishwa
// ni SAWA KIMUUNDO. Kwa hiyo, kuzishiriki kigezo kimoja badala ya
// viwili ni salama KWA UJENZI: kigezo kimoja kinachokokotolewa MARA
// MOJA kabla ya kitanzi bado kina thamani SAHIHI kwa matumizi YOTE
// mawili (au zaidi), kwa sababu thamani hiyo tayari imethibitishwa
// kutobadilika popote ndani ya kitanzi.
//
// WIGO: SAWA KABISA na uwanja wa licm_naingiliana/licm_ni_operesheni
// (kitambulisho, namba halisi -- n32 NA d64, +, -, *, ulinganisho, na
// biti) -- HAKUNA upanuzi wowote wa wigo wa awali wa LICM, ni
// ulinganisho TU juu ya vitu ambavyo tayari vingekuwa vimehamishwa
// hata bila CSE hii.
//
// MPANGILIO/WIGO WA MATAWI: licm_badilisha_kama_inavyowezekana
// HAIINGII KABISA ndani ya matawi ya "kama" (angalia "KIZUIZI CHA WIGO
// CHA ZIADA" juu ya faili hili) -- tokeo lolote lililo ndani ya "kama"
// halifiki hata kwenye ulinganisho huu, hivyo swali la "je, tokeo la
// tawi linaweza kushiriki kigezo na tokeo la nje ya tawi" HALIWEZI
// KUTOKEA KABISA: haihitaji ulinzi wa ziada, ni matokeo ya moja kwa
// moja ya wigo uliopo tayari.
n32 pandisha_urudufu_nodi[64];
n8* pandisha_urudufu_jina[64];
n32 pandisha_urudufu_idadi = 0;

n32 pandisha_keq(n32 a, n32 b) {
    kama (a == -1 || b == -1) { rudisha (a == b); }
    kama (mti_aina[a] != mti_aina[b]) { rudisha 0; }
    n32 t = mti_aina[a];
    kama (t == MTI_KITAMBULISHO) {
        rudisha pachika_jina_sawa(mti_dimbwi + mti_jina_ofseti[a], mti_dimbwi + mti_jina_ofseti[b]);
    }
    kama (t == MTI_NAMBARI) {
        // ast_kulia ni alama ya "dimbwi la N64" (angalia mahali
        // AST_NAMBARI inavyotengenezwa hapo juu ya faili hili) --
        // namba kubwa mno kwa n32 huhifadhiwa kwenye dimbwi kwa
        // OFSETI tofauti kila mara hata kama thamani halisi ni sawa,
        // hivyo ulinganisho huu hauwezi kutambua ULINGANO wa namba
        // hizo -- salama (fursa iliyokosekana TU, si hatari), kwa
        // sababu ast_thamani (ofseti) haitafanana isipokuwa ni NODI
        // ILE ILE ilivyorejelewa mara mbili (jambo lisilowezekana
        // hapa, kwa kuwa kila tokeo ni uchanganuzi tofauti).
        kama (mti_thamani[a] != mti_thamani[b]) { rudisha 0; }
        rudisha (mti_kulia[a] == mti_kulia[b]);
    }
    kama (t == MTI_HALISI_D) {
        // ast_thamani ni ofseti kwenye dimbwi la desimali -- sababu
        // ile ile kama AST_NAMBARI hapo juu.
        rudisha (mti_thamani[a] == mti_thamani[b]);
    }
    kama (pandisha_ni_operesheni(a) == 0) { rudisha 0; }
    kama (pandisha_keq(mti_kushoto[a], mti_kushoto[b]) == 0) { rudisha 0; }
    rudisha pandisha_keq(mti_kulia[a], mti_kulia[b]);
}

// Tafuta jina la kigezo cha muda kilichotengenezwa TAYARI kwa usemi
// unaofanana kimuundo na `node` (ndani ya kitanzi hiki hiki) -- 0 kama
// hakuna.
n8* pandisha_urudufu_tafuta(n32 nodi_hii) {
    n32 i = 0;
    wakati (i < pandisha_urudufu_idadi) {
        kama (pandisha_keq(nodi_hii, pandisha_urudufu_nodi[i])) { rudisha pandisha_urudufu_jina[i]; }
        i = i + 1;
    }
    rudisha 0;
}

// -------- Usanisi wa jina jipya la kigezo cha muda --------
n8 pandisha_jina_bafa[1536];  // 64 * 24
n32 pandisha_jina_idadi = 0;

n8* pandisha_jina_mpya() {
    kama (pandisha_jina_idadi >= 64) { rudisha 0; }
    n32 sloti = pandisha_jina_idadi;
    pandisha_jina_idadi = pandisha_jina_idadi + 1;
    n8* bafa = pandisha_jina_bafa + (sloti * 24);
    bafa[0] = 95;   // _
    bafa[1] = 95;   // _
    bafa[2] = 108;  // l
    bafa[3] = 105;  // i
    bafa[4] = 99;   // c
    bafa[5] = 109;  // m
    bafa[6] = 95;   // _
    bafa[7] = 116;  // t
    n32 n = sloti;
    n32 nafasi = 8;
    kama (n == 0) {
        bafa[nafasi] = 48;
        nafasi = nafasi + 1;
    } sivyo {
        n8 muda[8];
        n32 tn = 0;
        wakati (n > 0) {
            muda[tn] = 48 + (n % 10);
            n = n / 10;
            tn = tn + 1;
        }
        wakati (tn > 0) {
            tn = tn - 1;
            bafa[nafasi] = muda[tn];
            nafasi = nafasi + 1;
        }
    }
    bafa[nafasi] = 0;
    rudisha bafa;
}

// -------- Mnyororo wa matamko mapya ya muda kwa kitanzi cha SASA --------
n32 pandisha_kabla_kichwa = -1;
n32 pandisha_kabla_mwisho = -1;

// Tafuta na uandike upya mti mdogo wa kiwango cha juu zaidi (maximal)
// usiobadilika ndani ya uwanja mmoja (kushoto au kulia, kulingana na
// ni_kushoto) wa nodi ya mzazi iliyotolewa. Kama uwanja mzima wenyewe
// hauhitilafiani (invariant) na si jani tupu (jina/namba moja bila
// operesheni -- kuhamisha hilo halingefaidisha chochote), unasukwa:
// kigezo kipya cha muda kinatengenezwa, kinahesabiwa mara moja kabla
// ya kitanzi, na uwanja huo unaelekezwa upya kwenye kigezo hicho.
// Vinginevyo, tunatafuta ndani ya watoto wa mti huo mdogo kwa fursa
// ndogo zaidi -- lakini TU kupitia aina za nodi ambazo tumezielewa
// kikamilifu (angalia maoni ya wigo hapo juu ya kila tawi).
w0 pandisha_badilisha_kama_inavyowezekana(n32 mzazi, n32 ni_kushoto) {
    n32 mtoto = -1;
    kama (ni_kushoto) { mtoto = mti_kushoto[mzazi]; } sivyo { mtoto = mti_kulia[mzazi]; }
    kama (mtoto == -1) { rudisha; }

    kama (pandisha_ni_operesheni(mtoto) && pandisha_naingiliana(mtoto)) {
        n32 usimbaji = mti_thamani[mtoto];

        // CSE (angalia maelezo kamili juu ya licm_keq/licm_cse_tafuta):
        // kama usemi unaofanana KIMUUNDO KABISA na huu tayari
        // umehamishwa kwa kigezo cha muda kwenye kitanzi hiki hiki,
        // tumia TENA jina hilo hilo badala ya kutengeneza kigezo kipya
        // -- hakuna tangazo jipya linalohitajika, tokeo hili linapata
        // TU marejeo mapya kwenye kigezo kilichopo tayari.
        n8* jina_uliopo = pandisha_urudufu_tafuta(mtoto);
        kama (jina_uliopo != 0) {
            n32 marejeo_urudufu = nodi_mpya(MTI_KITAMBULISHO, usimbaji, -1, -1);
            kama (marejeo_urudufu == -1) { rudisha; }
            hifadhi_jina(marejeo_urudufu, jina_uliopo, pachika_urefu_jina(jina_uliopo));
            kama (ni_kushoto) { mti_kushoto[mzazi] = marejeo_urudufu; } sivyo { mti_kulia[mzazi] = marejeo_urudufu; }
            rudisha;
        }

        n8* jina_mpya = pandisha_jina_mpya();
        kama (jina_mpya == 0) { rudisha; }  // kikomo cha majina kimefikiwa -- acha bila kuhamisha

        n32 kigeu_nodi = nodi_mpya(MTI_KITAMBULISHO, usimbaji, -1, -1);
        kama (kigeu_nodi == -1) { rudisha; }
        hifadhi_jina(kigeu_nodi, jina_mpya, pachika_urefu_jina(jina_mpya));

        n32 tangazo = nodi_mpya(MTI_TANGAZO, usimbaji, kigeu_nodi, mtoto);
        kama (tangazo == -1) { rudisha; }
        mti_nne[tangazo] = -1;

        kama (pandisha_kabla_kichwa == -1) { pandisha_kabla_kichwa = tangazo; } sivyo { mti_nne[pandisha_kabla_mwisho] = tangazo; }
        pandisha_kabla_mwisho = tangazo;

        n32 marejeo = nodi_mpya(MTI_KITAMBULISHO, usimbaji, -1, -1);
        kama (marejeo == -1) { rudisha; }
        hifadhi_jina(marejeo, jina_mpya, pachika_urefu_jina(jina_mpya));

        kama (ni_kushoto) { mti_kushoto[mzazi] = marejeo; } sivyo { mti_kulia[mzazi] = marejeo; }

        // Sajili mgombea huyu kwa CSE ya baadaye -- mtoto (mti wa AST
        // kabla ya kuandikwa upya) bado ni halali kwa ulinganisho wa
        // muundo (umehifadhiwa kama kulia[tangazo], haujafutwa), na
        // ndio unaowakilisha THAMANI HALISI iliyohamishwa.
        kama (pandisha_urudufu_idadi < 64) {
            pandisha_urudufu_nodi[pandisha_urudufu_idadi] = mtoto;
            pandisha_urudufu_jina[pandisha_urudufu_idadi] = jina_mpya;
            pandisha_urudufu_idadi = pandisha_urudufu_idadi + 1;
        }
        rudisha;
    }

    n32 aina = mti_aina[mtoto];
    kama (pandisha_ni_operesheni(mtoto)) {
        pandisha_badilisha_kama_inavyowezekana(mtoto, 1);
        pandisha_badilisha_kama_inavyowezekana(mtoto, 0);
        rudisha;
    }
    kama (aina == MTI_TAJA) {  // *ptr AU arr[idx] -- angalia kushoto (msingi), kulia (fahirisi, kama ipo)
        pandisha_badilisha_kama_inavyowezekana(mtoto, 1);
        kama (mti_kulia[mtoto] != -1) { pandisha_badilisha_kama_inavyowezekana(mtoto, 0); }
        rudisha;
    }
    kama (aina == MTI_GAWANYA || aina == MTI_MODULO) {
        // Operesheni yenyewe KAMWE haiwezi kuhamishwa (hatari #1), lakini
        // watoto wake (mf. namba ya juu ya mgawanyo) bado wanaweza kuwa
        // na fursa ndogo ya LICM salama.
        pandisha_badilisha_kama_inavyowezekana(mtoto, 1);
        pandisha_badilisha_kama_inavyowezekana(mtoto, 0);
        rudisha;
    }
    kama (aina == MTI_SEHEMU_DOT || aina == MTI_SEHEMU_MSHALE) {
        pandisha_badilisha_kama_inavyowezekana(mtoto, 1);
        rudisha;
    }
    // Aina nyingine (AST_KUMBUKA, AST_TERNARY, AST_WITO, AST_ASIMILIA,
    // AST_NA/AU/SI, AST_KINYUME, n.k.) -- simama kwa makusudi, si
    // kudhania mpangilio wa nyanja usiothibitishwa (angalia wigo).
}

// Jaribu LICM kwa nodi MOJA ya AST_WAKATI -- hurudisha kichwa cha
// mnyororo mpya wa matamko ya muda ya kuweka KABLA ya kitanzi hiki
// (au -1 kama hakuna kilichohamishwa/kinachostahili).
n32 pandisha_jaribu_kitanzi(n32 nodi_hii) {
    pandisha_kizazi = pandisha_kizazi + 1;
    pandisha_idadi = 0;
    pandisha_acha = 0;
    pandisha_badiliko_idadi = 0;
    pandisha_kabla_kichwa = -1;
    pandisha_kabla_mwisho = -1;
    pandisha_urudufu_idadi = 0;

    pandisha_changanua_mwili(mti_kushoto[nodi_hii]);  // sharti
    pandisha_changanua_mwili(mti_kulia[nodi_hii]);    // mwili

    kama (pandisha_acha) { rudisha -1; }

    n32 taarifa = mti_kulia[nodi_hii];
    wakati (taarifa != -1) {
        kama (mti_aina[taarifa] == MTI_ASIMILIA) {
            pandisha_badilisha_kama_inavyowezekana(taarifa, 1);
            pandisha_badilisha_kama_inavyowezekana(taarifa, 0);
        } sivyo { kama (mti_aina[taarifa] == MTI_TANGAZO) {
            pandisha_badilisha_kama_inavyowezekana(taarifa, 0);  // kianzio pekee, si jina la kigezo
        } }
        taarifa = mti_nne[taarifa];
    }

    rudisha pandisha_kabla_kichwa;
}

// Tembea mnyororo wa taarifa (kichwa cha block), ukichakata vitanzi
// vilivyowekwa ndani KWANZA (mwili wa ndani kabisa kwanza), kisha
// ukijaribu LICM kwenye kila AST_WAKATI (isipokuwa "kwa" yenye
// anzisho, angalia maoni ya wigo juu), ukisuka matamko mapya ya muda
// KABLA ya nodi ya kitanzi kwenye mnyororo huu huu. Inaiga muundo wa
// inl_pitisha_mwili (kuunganisha kazi ndogo) kwa makusudi.
n32 pandisha_pitisha_mwili(n32 kichwa) {
    n32 mpya_kichwa = -1;
    n32 mpya_mwisho = -1;
    n32 nodi_hii = kichwa;
    wakati (nodi_hii != -1) {
        n32 ijayo = mti_nne[nodi_hii];
        n32 aina = mti_aina[nodi_hii];

        kama (aina == MTI_WAKATI) {
            mti_kulia[nodi_hii] = pandisha_pitisha_mwili(mti_kulia[nodi_hii]);

            n32 ni_mgombea = 1;
            kama (mti_tiga[nodi_hii] != -1) { ni_mgombea = 0; }  // "kwa" yenye anzisho -- nje ya wigo (angalia hatari #6)
            kama (ni_mgombea) {
                n32 kabla = pandisha_jaribu_kitanzi(nodi_hii);
                kama (kabla != -1) {
                    kama (mpya_kichwa == -1) { mpya_kichwa = kabla; } sivyo { mti_nne[mpya_mwisho] = kabla; }
                    n32 mwisho_kabla = kabla;
                    wakati (mti_nne[mwisho_kabla] != -1) { mwisho_kabla = mti_nne[mwisho_kabla]; }
                    mti_nne[mwisho_kabla] = nodi_hii;
                    mpya_mwisho = nodi_hii;
                    nodi_hii = ijayo;
                    endelea;
                }
            }
        } sivyo { kama (aina == MTI_KAMA) {
            mti_kulia[nodi_hii] = pandisha_pitisha_mwili(mti_kulia[nodi_hii]);
            kama (mti_tiga[nodi_hii] != -1) {
                n32 sivyo_nodi = mti_tiga[nodi_hii];
                mti_kushoto[sivyo_nodi] = pandisha_pitisha_mwili(mti_kushoto[sivyo_nodi]);
            }
        } }

        kama (mpya_kichwa == -1) { mpya_kichwa = nodi_hii; } sivyo { mti_nne[mpya_mwisho] = nodi_hii; }
        mpya_mwisho = nodi_hii;
        nodi_hii = ijayo;
    }
    kama (mpya_mwisho != -1) { mti_nne[mpya_mwisho] = -1; }
    rudisha mpya_kichwa;
}

n32 pandisha_boresha(n32 mzizi) {
    n32 nodi_hii = mti_kushoto[mzizi];
    wakati (nodi_hii != -1) {
        kama (mti_aina[nodi_hii] == MTI_KAZI) {
            kama (mti_tiga[nodi_hii] != -1) {
                n32 mpya = pandisha_pitisha_mwili(mti_tiga[nodi_hii]);
                mti_tiga[nodi_hii] = mpya;
            }
        }
        nodi_hii = mti_nne[nodi_hii];
    }
    rudisha mzizi;
}

// =========================================================
// SSCSE -- CSE ya msimbo wa mstari-moja-kwa-moja (straight-line
// common subexpression elimination)
// =========================================================
// LICM (juu ya faili hili) inashughulikia usemi usiobadilika ndani
// ya KITANZI tu -- usemi unaorudiwa nje ya kitanzi (mfano "n32 x =
// a*b+c; n32 y = a*b-d;", bila kitanzi popote) haugusiki kabisa na
// LICM, hata ukiwa "a*b" umeandikwa mara mbili mfululizo bila
// chochote kati yake kinachoweza kubadilisha a wala b. Sehemu hii
// inashughulikia hali hiyo: kigawanyaji cha "available expressions"
// cha KAWAIDA (classical CSE) kwa mnyororo wa taarifa za NGAZI MOJA
// (straight-line) -- SI uchambuzi wa dataflow wa jumla (hilo
// lingehitaji kuunganisha upatikanaji kwenye makutano ya matawi,
// tatizo gumu zaidi kabisa ambalo halijaribiwi hapa kwa makusudi).
//
// WIGO (kwa makusudi mdogo, uwanja ule ule TAYARI uliothibitishwa na
// LICM -- licm_ni_operesheni: kitambulisho, namba halisi, +, -, *,
// ulinganisho, na biti. HAKUNA upanuzi wa wigo):
//   1. NGAZI YA JUU TU: usemi UNAOLINGANISHWA ni ast_kulia[taarifa]
//      MZIMA (upande wa kulia wa AST_ASIMILIA au kianzio cha
//      AST_TANGAZO) -- SI utafutaji wa kina wa mti mdogo (kama vile
//      LICM inavyofanya kwa licm_badilisha_kama_inavyowezekana).
//      "a*b" ndani ya "y = (a*b)+c" haiwezi kutambuliwa peke yake --
//      TU usemi mzima "a*b+c" unalinganishwa. Hii ni kizuizi cha
//      makusudi cha awamu ya kwanza -- utafutaji wa kina unaweza
//      kuongezwa baadaye bila kubadilisha usanifu wa msingi hapa.
//   2. HAKUNA UHAMISHAJI WA MAPEMA (eager): tofauti na LICM
//      (inayohamisha KILA usemi unaostahili mara moja unapoonekana,
//      hata kama haurudiwi kamwe -- salama kwa LICM kwa sababu
//      "invariant" tayari ni kigezo cha kuchagua), CSE ya mstari-
//      moja-kwa-moja ingekuwa na madhara MABAYA ikifanya hivyo: KILA
//      taarifa ya "x = a+b;" ingegeuka kuwa "n32 t=a+b; n32 x=t;"
//      HATA kama "a+b" haitokei tena kamwe popote -- uvimbe wa
//      msimbo usiofaidisha chochote. Badala yake: tokeo la KWANZA la
//      usemi linabaki MAHALI PALE PALE, LIKIWA HALIJAGUSWA, hadi
//      TOKEO LA PILI linapopatikana likifanana KIMUUNDO KABISA (na
//      bila upendeleo wowote kati yao -- angalia #3) -- WAKATI HUO
//      TU ndipo tokeo la KWANZA linaandikwa upya (retroactively) kuwa
//      tangazo la kigezo cha muda, na tokeo la PILI (na lolote
//      linalofuata) linarejelea kigezo hicho hicho.
//   3. UPENDELEO (invalidation) UNAOFUATA NAFASI, SI ULE WA LICM:
//      LICM huuliza swali MOJA tu kwa kitanzi kizima ("je, jina hili
//      linabadilishwa MAHALI POPOTE ndani ya kitanzi?" -- ndiyo au
//      hapana, mara moja). Hapa swali ni tofauti KABISA: "je, jina
//      hili limebadilishwa KATI ya tokeo la kwanza na hapa?" --
//      swali linalotegemea NAFASI, linalohitaji hali inayoendelea
//      (running state) tunapotembea taarifa kwa taarifa. Mgombea
//      anafutwa (kill) kutoka kwenye jedwali la "available" MARA
//      MOJA jina lake linapoandikwa (AST_ASIMILIA yenye upande wa
//      kushoto ukiwa kitambulisho sahili) -- SI mwishoni mwa block,
//      bali PALE PALE inapotokea, ili taarifa zinazofuata (SI
//      zilizotangulia) ziathirike.
//   4. MPAKA WA TAWI/KITANZI: upatikanaji (availability) HAUVUKI
//      KAMWE mpaka wa AST_KAMA wala AST_WAKATI/KWA -- jedwali
//      linawekwa upya KABISA (tupu) kila mara tunapoingia ndani ya
//      mwili wa tawi/kitanzi (jedwali JIPYA, tupu, kwa mwili huo
//      pekee -- angalia cse_pitisha_mwili) NA TENA mara tu
//      tunapotoka humo kabla ya kuendelea na taarifa zinazofuata za
//      block la nje. Hii inaepuka KABISA tatizo gumu la "kuunganisha
//      upatikanaji kwenye makutano ya matawi" (mfano: usemi
//      uliopatikana upande MMOJA tu wa "kama" haupaswi kudhaniwa
//      kupatikana baada ya "kama" kuisha) -- ni salama zaidi kuliko
//      lazima, lakini ni sahihi KILA WAKATI.
//   5. WITO WA KAZI: usemi UNAOLINGANISHWA (uliopita
//      licm_ni_operesheni/cse_ni_safi, angalia chini) HAUWEZI KAMWE
//      kuwa na AST_WITO ndani yake -- ni sehemu ya uwanja ule ule wa
//      LICM. LAKINI: taarifa nyingine (au sehemu nyingine ya taarifa
//      HIYO HIYO, mfano faharisi ya "arr[f()] = x;") bado inaweza
//      kuwa na wito hata kama upande unaolinganishwa (kulia) haugusiki
//      nao moja kwa moja -- wito kama huo unaweza kubadilisha KIGEZO
//      CHA ULIMWENGU (global) ambacho tayari kimo ndani ya usemi
//      uliohifadhiwa TAYARI kwenye jedwali (hatuna njia ya kutofautisha
//      kigezo cha ndani na cha ulimwengu katika awamu hii -- LICM
//      YENYEWE haitofautishi pia). Kwa hiyo: taarifa YOYOTE (ASIMILIA/
//      TANGAZO) ambayo sehemu yake YOYOTE (kushoto AU kulia) ina wito
//      popote ndani yake, INAFUTA JEDWALI ZIMA baada ya kushughulikiwa
//      -- kigezo salama zaidi kuliko lazima (kingeweza kutofautisha
//      "wito huu unaathiri kigezo hiki maalum tu"), lakini KWA MAKUSUDI
//      rahisi zaidi na salama zaidi. Utambuzi wa wito unatumia TENA
//      licm_changanua_mwili (angalia cse_ina_kigeni chini) badala ya
//      kuandika upya usafiri mpya wa AST -- hatari ya kukosa aina
//      fulani ya nodi (mfano mtego wa AST_WITO/ast_tiga uliojulikana
//      kikao hiki) ni kubwa zaidi kwa usafiri MPYA usiojaribiwa kuliko
//      kutumia TENA ule uliopo tayari, uliojaribiwa na LICM.
//
// MPANGILIO WA UENDESHAJI: BAADA ya licm_boresha (angalia stage1.swa)
// -- kwa sababu ile ile LICM inayoendesha BAADA ya mkaguzi_angalia
// (enc tayari imethibitishwa, tunaweza kuinakili moja kwa moja bila
// jedwali letu wenyewe la aina). Kuendesha BAADA ya LICM pia kunamaanisha
// usemi vilivyokwisha hamishwa NA LICM (vikiwa vimebadilishwa kuwa
// marejeo ya vigezo vya muda vya LICM) havitaonekana tena kama
// "a*b" ghafi ndani ya vitanzi -- CSE hii inashughulikia KILA KITU
// KINGINE (nje ya vitanzi, au ndani ya vitanzi lakini kisichokuwa
// invariant), si kurudia kazi ya LICM.

n32 urudufu_inapatikana_nodi[64];  // nodi ya AST ya usemi wa TOKEO LA KWANZA (bado halali kwa kulinganisha muundo)
n32 urudufu_inapatikana_taarifa[64];  // taarifa ya NGAZI YA JUU (AST_ASIMILIA/AST_TANGAZO) iliyokuwa na tokeo la kwanza -- kwa USUKAJI wa tangazo jipya
n32 urudufu_inapatikana_mzazi[64];     // (pamoja na cse_avail_ni_kushoto) uwanja HASA wa tokeo la kwanza -- kwa UANDISHI wa marejeo mahali pale pale, hata kama ni kipande cha ndani ya usemi mkubwa zaidi
n32 urudufu_inapatikana_ni_kushoto[64];
n8* urudufu_inapatikana_jina[64];  // 0 = bado halijahamishwa kuwa kigezo cha muda; vinginevyo jina la kigezo
n32 urudufu_inapatikana_idadi = 0;

n32 urudufu_kichwa_sasa = -1;  // kichwa cha mnyororo wa SASA (kinaweza kubadilika kwa uwekaji wa tangazo mpya kwenye nafasi ya kwanza)

// -------- Usanisi wa jina jipya la kigezo cha muda (kioo cha licm_jina_mpya, kiambishi TOFAUTI ili kisichanganyike) --------
n8 urudufu_jina_bafa[1536];  // 64 * 24
n32 urudufu_jina_idadi = 0;

n8* urudufu_jina_mpya() {
    kama (urudufu_jina_idadi >= 64) { rudisha 0; }
    n32 sloti = urudufu_jina_idadi;
    urudufu_jina_idadi = urudufu_jina_idadi + 1;
    n8* bafa = urudufu_jina_bafa + (sloti * 24);
    bafa[0] = 95;   // _
    bafa[1] = 95;   // _
    bafa[2] = 115;  // s
    bafa[3] = 99;   // c
    bafa[4] = 115;  // s
    bafa[5] = 101;  // e
    bafa[6] = 95;   // _
    bafa[7] = 116;  // t
    n32 n = sloti;
    n32 nafasi = 8;
    kama (n == 0) {
        bafa[nafasi] = 48;
        nafasi = nafasi + 1;
    } sivyo {
        n8 muda[8];
        n32 tn = 0;
        wakati (n > 0) {
            muda[tn] = 48 + (n % 10);
            n = n / 10;
            tn = tn + 1;
        }
        wakati (tn > 0) {
            tn = tn - 1;
            bafa[nafasi] = muda[tn];
            nafasi = nafasi + 1;
        }
    }
    bafa[nafasi] = 0;
    rudisha bafa;
}

// Ulinganisho wa kina (deep): rudisha 1 IKIWA NA IKIWA TU mti mdogo
// mzima unajengwa peke yake kutoka kwa vitambulisho/namba halisi/
// operesheni za uwanja wa licm_ni_operesheni -- HAKUNA "je,
// limebadilishwa" (hilo linashughulikiwa kando, kwa nafasi, na
// cse_kill_zenye_jina) -- ni sawa na licm_naingiliana LAKINI bila
// sehemu ya "haijabadilishwa", kwa sababu maana ya "haijabadilishwa"
// hapa ni ya NAFASI (position-dependent), si ya kitanzi kizima.
n32 urudufu_ni_safi(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha 0; }
    n32 aina = mti_aina[nodi_hii];
    kama (aina == MTI_NAMBARI || aina == MTI_HALISI_D) { rudisha 1; }
    kama (aina == MTI_KITAMBULISHO) { rudisha 1; }
    kama (pandisha_ni_operesheni(nodi_hii) == 0) { rudisha 0; }
    kama (urudufu_ni_safi(mti_kushoto[nodi_hii]) == 0) { rudisha 0; }
    rudisha urudufu_ni_safi(mti_kulia[nodi_hii]);
}

// Je, `jina` linatokea popote ndani ya usemi `node` (ambao TAYARI
// umepita cse_ni_safi, hivyo hauna WITO/TAJA/n.k. -- usafiri huu
// unaweza kutumia uwanja mwembamba wa licm_ni_operesheni kwa
// usalama kamili).
n32 urudufu_usemi_ina_jina(n32 nodi_hii, n8* jina) {
    kama (nodi_hii == -1) { rudisha 0; }
    n32 aina = mti_aina[nodi_hii];
    kama (aina == MTI_KITAMBULISHO) {
        rudisha pachika_jina_sawa(mti_dimbwi + mti_jina_ofseti[nodi_hii], jina);
    }
    kama (pandisha_ni_operesheni(nodi_hii) == 0) { rudisha 0; }
    kama (urudufu_usemi_ina_jina(mti_kushoto[nodi_hii], jina)) { rudisha 1; }
    rudisha urudufu_usemi_ina_jina(mti_kulia[nodi_hii], jina);
}

// Je, `node` (usemi WOWOTE, si tu ule wa uwanja mwembamba -- unaweza
// kuwa na wito, faharisi za safu, n.k.) una AST_WITO mahali popote
// ndani yake? Tunatumia TENA licm_changanua_mwili (LICM, juu ya
// faili hili) kama "kihisi" -- kazi hiyo tayari inaweka licm_bail=1
// pindi ikikutana na AST_WITO (au aina nyingine ya nodi isiyoeleweka
// kikamilifu, mf. AST_CHAGUA/AST_MUUNDO/AST_SEHEMU/AST_HALI) mahali
// popote kwenye mti mdogo -- kuitumia tena hapa ni salama zaidi
// kuliko kuandika usafiri mpya wa AST (hatari ya kukosa aina fulani
// ya nodi, angalia maelezo makuu juu). Hatuhitaji matokeo mengine ya
// kazi hiyo (licm_badiliko_jina n.k.) -- yanapuuzwa kwa makusudi.
n32 urudufu_ina_kigeni(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha 0; }
    pandisha_kizazi = pandisha_kizazi + 1;
    pandisha_idadi = 0;
    pandisha_acha = 0;
    pandisha_badiliko_idadi = 0;
    pandisha_changanua_mwili(nodi_hii);
    rudisha pandisha_acha;
}

// Ondoa (kill) kutoka kwenye jedwali la "available" mgombea YOYOTE
// (aliyehamishwa TAYARI au bado hajahamishwa) ambaye usemi wake
// unarejelea `jina` mahali popote -- kuitwa MARA MOJA baada ya
// taarifa ya AST_ASIMILIA kuandika upya `jina` (angalia
// cse_pitisha_mwili). Kompakishaji (compaction) badala ya kuacha
// mapengo.
w0 urudufu_ua_zenye_jina(n8* jina) {
    n32 w = 0;
    n32 i = 0;
    wakati (i < urudufu_inapatikana_idadi) {
        kama (urudufu_usemi_ina_jina(urudufu_inapatikana_nodi[i], jina) == 0) {
            urudufu_inapatikana_nodi[w] = urudufu_inapatikana_nodi[i];
            urudufu_inapatikana_taarifa[w] = urudufu_inapatikana_taarifa[i];
            urudufu_inapatikana_mzazi[w] = urudufu_inapatikana_mzazi[i];
            urudufu_inapatikana_ni_kushoto[w] = urudufu_inapatikana_ni_kushoto[i];
            urudufu_inapatikana_jina[w] = urudufu_inapatikana_jina[i];
            w = w + 1;
        }
        i = i + 1;
    }
    urudufu_inapatikana_idadi = w;
}

n32 urudufu_tafuta_faharasa(n32 usemi) {
    n32 i = 0;
    wakati (i < urudufu_inapatikana_idadi) {
        kama (pandisha_keq(usemi, urudufu_inapatikana_nodi[i])) { rudisha i; }
        i = i + 1;
    }
    rudisha -1;
}

// Tafuta nodi X ambayo ast_nne[X] == target, ukitembea kutoka
// cse_kichwa_sasa -- -2 ikiwa target NDIYO kichwa chenyewe (hakuna
// mtangulizi ndani ya block hili), -1 kama haijapatikana (hitilafu
// ya uwekaji kumbukumbu -- haipaswi kutokea kama mantiki ni sahihi,
// lakini tunakagua kwa usalama badala ya kudhania). Utafutaji upya
// (badala ya kuhifadhi "mtangulizi" tuliouona mara ya kwanza) ni WA
// MAKUSUDI: mgombea WA PILI anayehamishwa kwenye taarifa ILE ILE ya
// kwanza (mfano "y = a*b + c*d;" ikiwa zote mbili zinarudiwa) angeweza
// kufanya "mtangulizi" uliohifadhiwa awali kuwa batili (stale) --
// utafutaji upya kila mara ni salama kwa gharama ndogo (block za
// mstari-moja-kwa-moja si kubwa sana kwa kawaida).
n32 urudufu_tafuta_mtangulizi(n32 lengo_hili) {
    kama (urudufu_kichwa_sasa == lengo_hili) { rudisha -2; }
    n32 x = urudufu_kichwa_sasa;
    wakati (x != -1) {
        kama (mti_nne[x] == lengo_hili) { rudisha x; }
        x = mti_nne[x];
    }
    rudisha -1;
}

// Andika thamani `v` kwenye uwanja (mzazi, ni_kushoto) uliopewa.
w0 urudufu_weka_uwanja(n32 mzazi, n32 ni_kushoto, n32 v) {
    kama (ni_kushoto) { mti_kushoto[mzazi] = v; } sivyo { mti_kulia[mzazi] = v; }
}

// Shughulikia uwanja mmoja (mzazi, ni_kushoto) -- KIPANDE CHOCHOTE
// cha usemi, si tu ast_kulia[taarifa] ya ngazi ya juu -- na `juu`
// ikiwa ni taarifa ya NGAZI YA JUU (AST_ASIMILIA/AST_TANGAZO)
// inayozunguka (kwa madhumuni ya USUKAJI wa tangazo jipya, ambalo
// LAZIMA liwekwe KABLA ya taarifa ya NGAZI YA JUU siku zote, hata
// kama tokeo lililopatikana liko ndani KABISA ya usemi mkubwa
// zaidi -- SI kabla ya nodi ndogo yenyewe, ambayo si sehemu ya
// mnyororo wa ast_nne kamwe).
//
// MUHIMU (tofauti KUU na licm_badilisha_kama_inavyowezekana): baada
// ya kujaribu kulinganisha/kusajili NODI NZIMA katika uwanja huu,
// TUNAENDELEA kuchunguza WATOTO WAKE PIA (isipokuwa nodi ilibadilishwa
// kuwa marejeo, ambapo haina watoto tena) -- si "au moja au nyingine"
// kama LICM (ambayo huchagua mti mdogo MKUBWA ZAIDI unaostahili na
// kuacha kabisa kuchunguza ndani yake). Sababu: uvumbuzi upya
// (invariance kwa LICM) ni sifa ya KIWANGO KIMOJA (mti mzima ni
// invariant au sivyo) -- lakini KUFANANA (kwa CSE) kunaweza kutokea
// KWENYE KINA CHOCHOTE kwa wakati mmoja: "a*b" ndani ya "a*b+c" NA
// "a*b" ndani ya "a*b-d" LAZIMA zilinganishwe, HATA KAMA "a*b+c" na
// "a*b-d" wenyewe (kama vitengo vizima) havifanani KAMWE kimuundo
// (AST_JUMLISHA dhidi ya AST_TOFAUTI).
w0 urudufu_chakata(n32 mzazi, n32 ni_kushoto, n32 juu) {
    n32 nodi_hii = -1;
    kama (ni_kushoto) { nodi_hii = mti_kushoto[mzazi]; } sivyo { nodi_hii = mti_kulia[mzazi]; }
    kama (nodi_hii == -1) { rudisha; }
    kama (pandisha_ni_operesheni(nodi_hii) == 0) { rudisha; }

    kama (urudufu_ni_safi(nodi_hii)) {
        n32 faharasa = urudufu_tafuta_faharasa(nodi_hii);
        kama (faharasa == -1) {
            // Tokeo la KWANZA -- SAJILI TU, USIGUSE AST (angalia
            // SABABU #2 kwenye maelezo makuu -- uhamishaji wa mapema
            // ungeharibu usemi usiorudiwa).
            kama (urudufu_inapatikana_idadi < 64) {
                urudufu_inapatikana_nodi[urudufu_inapatikana_idadi] = nodi_hii;
                urudufu_inapatikana_taarifa[urudufu_inapatikana_idadi] = juu;
                urudufu_inapatikana_mzazi[urudufu_inapatikana_idadi] = mzazi;
                urudufu_inapatikana_ni_kushoto[urudufu_inapatikana_idadi] = ni_kushoto;
                urudufu_inapatikana_jina[urudufu_inapatikana_idadi] = 0;
                urudufu_inapatikana_idadi = urudufu_inapatikana_idadi + 1;
            }
        } sivyo {
            n32 usimbaji = mti_thamani[urudufu_inapatikana_nodi[faharasa]];

            kama (urudufu_inapatikana_jina[faharasa] != 0) {
                // Tayari imehamishwa (tokeo la TATU au zaidi) -- rejelea tu.
                n32 marejeo = nodi_mpya(MTI_KITAMBULISHO, usimbaji, -1, -1);
                kama (marejeo == -1) { rudisha; }
                hifadhi_jina(marejeo, urudufu_inapatikana_jina[faharasa], pachika_urefu_jina(urudufu_inapatikana_jina[faharasa]));
                urudufu_weka_uwanja(mzazi, ni_kushoto, marejeo);
                rudisha;  // node imebadilishwa -- hakuna watoto wa kuchunguza tena
            }

            // Tokeo la PILI: andika upya (retroactively) tokeo la
            // KWANZA kuwa tangazo la kigezo cha muda (lililowekwa
            // KABLA ya taarifa yake ya NGAZI YA JUU), kisha rejelea
            // kigezo hicho pande zote mbili.
            n32 kwanza_taarifa = urudufu_inapatikana_taarifa[faharasa];
            n8* jina_mpya = urudufu_jina_mpya();
            kama (jina_mpya == 0) { rudisha; }  // majina yamekwisha -- si hatari, achana nayo tu

            n32 kigeu_nodi = nodi_mpya(MTI_KITAMBULISHO, usimbaji, -1, -1);
            kama (kigeu_nodi == -1) { rudisha; }
            hifadhi_jina(kigeu_nodi, jina_mpya, pachika_urefu_jina(jina_mpya));

            n32 tangazo = nodi_mpya(MTI_TANGAZO, usimbaji, kigeu_nodi, urudufu_inapatikana_nodi[faharasa]);
            kama (tangazo == -1) { rudisha; }
            mti_nne[tangazo] = -1;

            n32 kitangulizi = urudufu_tafuta_mtangulizi(kwanza_taarifa);
            kama (kitangulizi == -1) { rudisha; }  // hitilafu ya kumbukumbu -- acha AST bila kuguswa, salama
            kama (kitangulizi == -2) {
                mti_nne[tangazo] = kwanza_taarifa;
                urudufu_kichwa_sasa = tangazo;
            } sivyo {
                mti_nne[tangazo] = kwanza_taarifa;
                mti_nne[kitangulizi] = tangazo;
            }

            n32 marejeo1 = nodi_mpya(MTI_KITAMBULISHO, usimbaji, -1, -1);
            kama (marejeo1 == -1) { rudisha; }
            hifadhi_jina(marejeo1, jina_mpya, pachika_urefu_jina(jina_mpya));
            urudufu_weka_uwanja(urudufu_inapatikana_mzazi[faharasa], urudufu_inapatikana_ni_kushoto[faharasa], marejeo1);

            urudufu_inapatikana_jina[faharasa] = jina_mpya;

            n32 marejeo2 = nodi_mpya(MTI_KITAMBULISHO, usimbaji, -1, -1);
            kama (marejeo2 == -1) { rudisha; }
            hifadhi_jina(marejeo2, jina_mpya, pachika_urefu_jina(jina_mpya));
            urudufu_weka_uwanja(mzazi, ni_kushoto, marejeo2);
            rudisha;  // node imebadilishwa -- hakuna watoto wa kuchunguza tena
        }
    }

    // Tafuta vipande vidogo zaidi ndani ya watoto wa node (angalia
    // MUHIMU juu) -- hii inafanyika HATA kama node yenyewe haikuwa
    // "safi" (cse_ni_safi==0, mfano ina wito ndani ya upande mmoja),
    // kwa sababu upande MWINGINE bado unaweza kuwa na fursa yake
    // pekee. node hapa bado ni ile ile ya AWALI (haijabadilishwa --
    // matawi yote mawili hapo juu yanayobadilisha node huishia na
    // "rudisha" kabla ya kufika hapa).
    urudufu_chakata(nodi_hii, 1, juu);
    urudufu_chakata(nodi_hii, 0, juu);
}

// Tembea mnyororo wa taarifa (mstari-moja-kwa-moja), tukishughulikia
// AST_ASIMILIA/AST_TANGAZO kwa CSE, na AST_KAMA/AST_WAKATI kwa
// kuingia ndani (jedwali JIPYA kwa kila mwili) na kuweka upya
// jedwali letu WENYEWE mara tu tunapotoka (angalia SABABU #4 juu).
// Inarudisha kichwa (kinachoweza kuwa kimebadilika kama tangazo
// jipya limewekwa mwanzoni kabisa mwa mnyororo huu).
n32 urudufu_pitisha_mwili(n32 kichwa) {
    urudufu_inapatikana_idadi = 0;
    urudufu_kichwa_sasa = kichwa;

    n32 nodi_hii = kichwa;
    wakati (nodi_hii != -1) {
        n32 ijayo = mti_nne[nodi_hii];
        n32 aina = mti_aina[nodi_hii];

        kama (aina == MTI_ASIMILIA) {
            urudufu_chakata(nodi_hii, 0, nodi_hii);
            n32 kushoto = mti_kushoto[nodi_hii];
            kama (kushoto != -1 && mti_aina[kushoto] == MTI_KITAMBULISHO) {
                urudufu_ua_zenye_jina(mti_dimbwi + mti_jina_ofseti[kushoto]);
            }
            kama (urudufu_ina_kigeni(mti_kushoto[nodi_hii]) || urudufu_ina_kigeni(mti_kulia[nodi_hii])) {
                urudufu_inapatikana_idadi = 0;
            }
        } sivyo { kama (aina == MTI_TANGAZO) {
            urudufu_chakata(nodi_hii, 0, nodi_hii);
            kama (urudufu_ina_kigeni(mti_kulia[nodi_hii])) {
                urudufu_inapatikana_idadi = 0;
            }
        } sivyo { kama (aina == MTI_KAMA) {
            mti_kulia[nodi_hii] = urudufu_pitisha_mwili(mti_kulia[nodi_hii]);
            kama (mti_tiga[nodi_hii] != -1) {
                n32 sivyo_nodi = mti_tiga[nodi_hii];
                mti_kushoto[sivyo_nodi] = urudufu_pitisha_mwili(mti_kushoto[sivyo_nodi]);
            }
            // Turudi kwenye muktadha wa block hili (mabadiliko ya
            // ndani ya cse_pitisha_mwili ya ndani hayakuwa
            // yakiathiri jedwali hili -- lakini bado tunaweka upya
            // KWA MAKUSUDI, angalia SABABU #4).
            urudufu_kichwa_sasa = kichwa;
            urudufu_inapatikana_idadi = 0;
        } sivyo { kama (aina == MTI_WAKATI) {
            mti_kulia[nodi_hii] = urudufu_pitisha_mwili(mti_kulia[nodi_hii]);
            urudufu_kichwa_sasa = kichwa;
            urudufu_inapatikana_idadi = 0;
        } sivyo {
            // Aina nyingine yoyote (AST_WITO ya wazi, AST_RUDISHA,
            // AST_VUNJA/ENDELEA, n.k.) -- hatuchakati kwa CSE, lakini
            // TUNAWEKA UPYA kwa tahadhari (kigezo salama chaguo-msingi
            // -- angalia maelezo makuu, hatuorodheshi kwa undani kila
            // aina inayowezekana ya taarifa).
            urudufu_inapatikana_idadi = 0;
        } } } }

        nodi_hii = ijayo;
    }
    rudisha urudufu_kichwa_sasa;
}

n32 sscse_boresha(n32 mzizi) {
    n32 nodi_hii = mti_kushoto[mzizi];
    wakati (nodi_hii != -1) {
        kama (mti_aina[nodi_hii] == MTI_KAZI) {
            kama (mti_tiga[nodi_hii] != -1) {
                n32 mpya = urudufu_pitisha_mwili(mti_tiga[nodi_hii]);
                mti_tiga[nodi_hii] = mpya;
            }
        }
        nodi_hii = mti_nne[nodi_hii];
    }
    rudisha mzizi;
}
