husisha { mkusanyaji/msambazaji.swa }
husisha { mkusanyaji/mkaguzi.swa }
husisha { mkusanyaji/mtafsiri.swa }
husisha { mkusanyaji/uzalishaji.swa }
husisha { mkusanyaji/uzalishaji_wasm.swa }
husisha { mkusanyaji/uzalishaji_riscv64.swa }

// ==========================================================
// Kusoma na kutatua chanzo -- mkusanyaji anatatua mistari ya
// "husisha { faili.swa }" mwenyewe, sawa na msuluhishi wa
// gharama/msuluhishi.swa. Kila faili linalotajwa linatafutwa
// kwa mpangilio: 1) msingi/  2) msingi/maktaba/ (kama ipo)
// 3) saraka ya sasa. Towe: faili zote kwa mpangilio wa
// utegemezi (tegemezi kabla ya tegemeziwa, kila faili mara
// moja tu), kisha maudhui ya chanzo asili bila mistari ya
// husisha. Mzunguko unakataliwa kwa sauti na msimbo wa
// kutoka usio 0; faili lisilopatikana linalia kwa sauti.
// Mstari mwingine wowote wa "husisha" (si "husisha { faili }") ni
// kosa la sauti: Swa haina kiungo cha C wala libc.
//
// Mkusanyaji wa kujikusanya haufanyi kitu hapa: mfululizo
// unaofika hapa umeshatatuliwa na zana ya ujenzi (hakuna
// mistari ya { iliyobaki). Ikiwa mstari wa "husisha { }"
// unataja faili ambalo maudhui yake yamo tayari kwenye
// towe (k.m. chanzo kilichounganishwa kwa mkono), mstari
// huo hupuuzwa -- marudio yanaondolewa kwa kulinganisha
// maudhui, si kwa njia pekee.
// ==========================================================

// Hifadhi chanzo cha mkusanyaji mzima wakati wa kujikusanya.
// chanzo_buf ndio pato la mwisho linalosomwa na mstakaji.
// chombo_cha_faili_kuu lina chanzo kikuu (faili la mtumiaji) -- ni salama:
// utegemezi hauingii humo kamwe. chombo_cha_faili_la_sasa lina faili
// linalotatuliwa sasa -- kujirudia kunaweza kuliharibu, kwa
// hiyo faili linasomwa upya baada ya kila kujirudia.
// chombo_cha_ukaguzi ni chombo cha ziada kwa ukaguzi wa "maudhui
// yapo tayari kwenye towe".
// Ukubwa 16777216 (16MB) unafuata kiolezo kilichopo tayari cha
// ghala_la_majina (msambazaji.swa) -- miradi mikubwa (k.m. Dominion's
// mchezo.swa, iliyotatuliwa kikamilifu) ilikuwa inagonga kikomo
// cha zamani cha 1048576 (1MB).
n8 chombo_cha_chanzo_kamili[16777216];
n32 chanzo_urefu = 0;
n8 chombo_cha_faili_kuu[16777216];
n8 chombo_cha_faili_la_sasa[16777216];
n8 chombo_cha_ukaguzi[16777216];

// Hifadhi ya majina -- safu bapa ya vipande (njia kamili + NUL).
// mrundikano ni kwa kutambua mizunguko; zilizotatuliwa ni kwa
// kutofanya marudio (kila faili linatolewa mara moja tu).
n8 majina_husisha[262144];
n32 idadi_ya_majina = 0;
n32 KIPANDE = 512;
n32 mrundikano_wa_husisha[512];
n32 urefu_wa_mrundikano = 0;
n32 zilizotatuliwa[512];
n32 idadi_zilizotatuliwa = 0;

n8 chombo_cha_njia[512];  // njia kamili ya faili linalotafutwa
n8 chombo_cha_jina[512];  // jina la faili kati ya mabano { }
n32 kosa = 0;      // kosa limeonekana -- hakuna msimbo utakaotolewa

// faili_ipo_swa -- kama faili linapatikana (bila maktaba ya faili)
n32 faili_ipo_swa(n8* njia) {
    n64 f = mfumo_fungua(njia, 0, 0);
    kama (f < 0) {
        rudisha 0;
    }
    mfumo_funga(f);
    rudisha 1;
}

// soma_faili -- soma faili lote hadi chombo (chenye NUL mwishoni).
// Rudisha urefu, au -1 kama halifunguki. Kikomo: upeo - 1.
//
// Kabla ya kusoma, ukubwa HALISI wa faili unatambuliwa kwa
// lseek(fd, 0, SEEK_END) -- kama ukubwa huo hauingii kwenye chombo
// (ukubwa + 1 > upeo), kazi inarudisha -1 MARA MOJA bila kusoma
// chochote; mwito (tatua_husisha n.k.) tayari unalia kwa sauti na
// kusimamisha ukusanyaji (kosa=1) pale soma_faili inaporudisha -1.
// Baada ya kusoma, idadi ya baiti zilizopatikana ililinganishwa na
// ukubwa uliotarajiwa -- usomaji wa sehemu tu (kwa sababu yoyote)
// pia unarudisha -1 badala ya kuendelea na maudhui yaliyokatwa
// kimya (aina ile ile ya hitilafu iliyorekebishwa #189/#197/#199/#200/
// #292/#295/#298 -- chombo chenye ukubwa dhahiri lazima kisimamishe
// kazi kwa uwazi inapojaa/kukatika, si kuendelea kimya).
n64 soma_faili(n8* njia, n8* chombo, n64 upeo) {
    n64 f = mfumo_fungua(njia, 0, 0);
    kama (f < 0) {
        rudisha -1;
    }
    n64 ukubwa = mfumo_tafuta_nafasi(f, 0, 2);  // SEEK_END -- ukubwa halisi wa faili
    kama (ukubwa < 0 || ukubwa + 1 > upeo) {
        mfumo_funga(f);
        rudisha -1;  // kikubwa mno (au lseek imeshindwa) -- usiendelee kimya
    }
    mfumo_tafuta_nafasi(f, 0, 0);  // SEEK_SET -- rudi mwanzo kabla ya kusoma
    n64 n = mfumo_soma(f, chombo, ukubwa);
    mfumo_funga(f);
    kama (n != ukubwa) {
        rudisha -1;  // usomaji wa sehemu tu -- usiendelee kimya
    }
    chombo[n] = 0;
    rudisha n;
}

// ongeza_chanzo -- ongeza baiti kwenye pato la mwisho (chanzo_buf)
n32 ongeza_chanzo(n8* data, n64 urefu) {
    kama (chanzo_urefu + urefu > 16777216) {
        andika_kosa("; KOSA: chanzo cha mkusanyaji ni kikubwa mno\n");
        kosa = 1;
        rudisha -1;
    }
    nakili(chombo_cha_chanzo_kamili + chanzo_urefu, data, urefu);
    chanzo_urefu = chanzo_urefu + urefu;
    rudisha 0;
}

// tambua_mstari -- aina ya mstari mwanzoni mwa mstari:
//   0 = si maelekezo ya husisha (kila kitu kingine)
//   1 = husisha { faili.swa }   (linatatuliwa)
//   2 = husisha nyingine (si faili) -- kosa la sauti
// Neno KAMILI "husisha" tu ndilo linalohesabika -- si kiambishi
// "hu": "husishakitu" mwanzoni mwa mstari si maelekezo.
n32 tambua_mstari(n8* b, n64 p, n64 urefu) {
    kama (urefu >= 7 &&
    b[p] == 104 && b[p + 1] == 117 && b[p + 2] == 115 &&
    b[p + 3] == 105 && b[p + 4] == 115 && b[p + 5] == 104 &&
    b[p + 6] == 97) {
        kama (urefu == 7) { rudisha 2; }  // "husisha" pekee -- tupishe
        n8 baada = b[p + 7];
        kama (baada == 32) {
            kama (urefu >= 9) {
                n8 ya = b[p + 8];
                kama (ya == 123) { rudisha 1; }  // '{' -- faili la Swa
                rudisha 2;
            }
            rudisha 2;  // "husisha " mwishoni mwa mstari
        }
        kama (baada == 9) {
            kama (urefu >= 9) {
                n8 ya = b[p + 8];
                kama (ya == 123) { rudisha 1; }
                rudisha 2;
            }
            rudisha 2;
        }
        kama (baada == 10) { rudisha 2; }  // mwisho wa mstari
        kama (baada == 13) { rudisha 2; }  // mwisho wa mstari (CRLF)
        rudisha 0;  // "husisha" + herufi nyingine -- si neno kamili
    }
    rudisha 0;
}

// toa_jina -- toa jina la faili kati ya { } na ulinakili hadi
// jina_buf (lenye NUL). Rudisha 0 kwa sawa, -1 kwa kosa.
n32 toa_jina(n8* b, n64 p, n64 urefu) {
    n64 j = p + 9;  // mara tu baada ya '{'
    wakati (j < p + urefu && (b[j] == 32 || b[j] == 9)) {
        j = j + 1;
    }
    n64 mwanzo = j;
    wakati (j < p + urefu && b[j] != 125) {  // '}'
        j = j + 1;
    }
    kama (j >= p + urefu) {
        andika_kosa("; KOSA: husisha { ... } bila '}' ya kufunga\n");
        kosa = 1;
        rudisha -1;
    }
    n64 mwisho = j;
    wakati (mwisho > mwanzo && (b[mwisho - 1] == 32 || b[mwisho - 1] == 9)) {
        mwisho = mwisho - 1;
    }
    kama (mwanzo == mwisho) {
        andika_kosa("; KOSA: husisha { } bila jina la faili\n");
        kosa = 1;
        rudisha -1;
    }
    n64 n = mwisho - mwanzo;
    kama (n >= 500) {
        andika_kosa("; KOSA: jina la faili ni refu mno\n");
        kosa = 1;
        rudisha -1;
    }
    n64 i = 0;
    wakati (i < n) {
        chombo_cha_jina[i] = b[mwanzo + i];
        i = i + 1;
    }
    chombo_cha_jina[n] = 0;
    rudisha 0;
}

// ongeza_jina -- pata faharisi ya njia kwenye hifadhi ya majina;
// likikosekana, linaandikwa. Rudisha faharisi.
n32 ongeza_jina(n8* jina) {
    n32 k = 0;
    wakati (k < idadi_ya_majina) {
        kama (linganisha_mfuatano(jina, majina_husisha + k * KIPANDE) == 0) {
            rudisha k;
        }
        k = k + 1;
    }
    kama (idadi_ya_majina >= 511) {
        andika_kosa("; KOSA: hifadhi ya majina imejaa\n");
        kosa = 1;
        rudisha 0;
    }
    kama (urefu_wa_mfuatano(jina) >= KIPANDE) {
        andika_kosa("; KOSA: njia ni ndefu mno: %s\n", jina);
        kosa = 1;
        rudisha 0;
    }
    nakili_mfuatano(majina_husisha + idadi_ya_majina * KIPANDE, jina);
    idadi_ya_majina = idadi_ya_majina + 1;
    rudisha idadi_ya_majina - 1;
}

// Saraka ya usakinishaji: saraka mbili juu ya binari yenyewe.
// <saraka_ya_swa>/bin/swa -> <saraka_ya_swa>, na maktaba iko <saraka_ya_swa>/msingi/maktaba
// -- mpangilio ule ule wa hazina hii. Bila hili, swa ilipata maktaba
// tu ikiendeshwa kutoka saraka kuu ya hazina (njia zote zilikuwa kulingana
// na saraka ya sasa), kwa hiyo binari iliyopakuliwa haikuweza
// kukusanya programu yoyote yenye husisha ya maktaba.
n8 saraka_ya_swa[512];
n32 saraka_ya_swa_hali = 0;  // 0 = haijatafutwa, 1 = ipo, -1 = haipo
n8* swa_hoja_mstari0 = 0;          // argv[0], hujazwa na anza

n32 saraka_ya_swa_tafuta() {
    kama (saraka_ya_swa_hali != 0) {
        rudisha saraka_ya_swa_hali;
    }
    saraka_ya_swa_hali = -1;
    // readlink(2) = 89; haiandiki NUL, urefu unarudishwa. Hufuata
    // viungo (symlink), kwa hiyo /usr/local/bin/swa -> /opt/swa/bin/swa
    // hupata /opt/swa.
    n64 n = wito_wa_mfumo(89, "/proc/self/exe", saraka_ya_swa, 511, 0, 0, 0);
    kama (n <= 0) {
        // Hakuna /proc (chroot, initramfs): tumia argv[0] likiwa na '/'.
        // Njia ya jamaa hupewa "./" ili kuvua ngazi mbili kubaki halali.
        kama (swa_hoja_mstari0 == 0) {
            rudisha -1;
        }
        n64 upana = urefu_wa_mfuatano(swa_hoja_mstari0);
        n64 k = 0;
        n32 ina_mkwaju = 0;
        wakati (k < upana) {
            kama (swa_hoja_mstari0[k] == 47) {
                ina_mkwaju = 1;
            }
            k = k + 1;
        }
        kama (ina_mkwaju == 0 || upana >= 500) {
            rudisha -1;
        }
        kama (swa_hoja_mstari0[0] == 47) {
            nakili_mfuatano(saraka_ya_swa, swa_hoja_mstari0);
        } sivyo {
            unganisha_mfuatano(saraka_ya_swa, "./", swa_hoja_mstari0);
        }
        n = urefu_wa_mfuatano(saraka_ya_swa);
    }
    saraka_ya_swa[n] = 0;
    n32 ngazi = 0;
    wakati (ngazi < 2) {
        n64 i = n - 1;
        wakati (i > 0 && saraka_ya_swa[i] != 47) {
            i = i - 1;
        }
        // binari moja kwa moja chini ya / (mf. /bin/swa): hakuna saraka ya usakinishaji
        kama (i <= 0) {
            rudisha -1;
        }
        saraka_ya_swa[i] = 0;
        n = i;
        ngazi = ngazi + 1;
    }
    saraka_ya_swa_hali = 1;
    rudisha 1;
}

// jaribu_chini_ya_saraka_ya_swa -- <saraka_ya_swa><kati><jina> kwenye njia_buf.
n32 jaribu_chini_ya_saraka(n8* kati, n8* jina) {
    kama (urefu_wa_mfuatano(saraka_ya_swa) + urefu_wa_mfuatano(kati) + urefu_wa_mfuatano(jina) >= 511) {
        rudisha 0;
    }
    n8 kiambishi[512];
    unganisha_mfuatano(kiambishi, saraka_ya_swa, kati);
    unganisha_mfuatano(chombo_cha_njia, kiambishi, jina);
    rudisha faili_ipo_swa(chombo_cha_njia);
}

// pata_njia -- njia ya kwanza iliyopo kwa mpangilio wa utafutaji;
// njia yenyewe inaishia kwenye njia_buf. Rudisha 1 ikiwa ipo.
// Saraka ya sasa kwanza (tabia ya zamani haibadiliki), kisha saraka ya usakinishaji
// wa usakinishaji wa swa yenyewe.
n32 pata_njia(n8* jina) {
    unganisha_mfuatano(chombo_cha_njia, "msingi/", jina);
    kama (faili_ipo_swa(chombo_cha_njia) != 0) {
        rudisha 1;
    }
    unganisha_mfuatano(chombo_cha_njia, "msingi/maktaba/", jina);
    kama (faili_ipo_swa(chombo_cha_njia) != 0) {
        rudisha 1;
    }
    nakili_mfuatano(chombo_cha_njia, jina);
    kama (faili_ipo_swa(chombo_cha_njia) != 0) {
        rudisha 1;
    }
    kama (jina[0] != 47 && saraka_ya_swa_tafuta() == 1) {
        kama (jaribu_chini_ya_saraka("/msingi/", jina) != 0) {
            rudisha 1;
        }
        kama (jaribu_chini_ya_saraka("/msingi/maktaba/", jina) != 0) {
            rudisha 1;
        }
        kama (jaribu_chini_ya_saraka("/", jina) != 0) {
            rudisha 1;
        }
    }
    rudisha 0;
}

// tafuta_katika -- kama mfuatano [data, data + urefu) unatokea
// ndani ya eneo [mwanzo, mwisho) la chombo b. Rudisha 1 kama lipo.
n32 tafuta_katika(n8* b, n64 mwanzo, n64 mwisho, n8* data, n64 urefu) {
    kama (urefu == 0) {
        rudisha 1;
    }
    n64 i = mwanzo;
    wakati (i + urefu <= mwisho) {
        n64 k = 0;
        wakati (k < urefu) {
            kama (b[i + k] != data[k]) {
                acha;
            }
            k = k + 1;
        }
        kama (k == urefu) {
            rudisha 1;
        }
        i = i + 1;
    }
    rudisha 0;
}

// maudhui_yapo -- kama maudhui ya faili yamo tayari kwenye towe au
// kwenye sehemu iliyosalia ya mkondo wa sasa. Chanzo kilichounga-
// nishwa kwa mkono (mfululizo wa kujikusanya) kinafaili lote, au
// nakala yake ya zamani: mstari wa husisha unaolitaja hupuuzwa,
// hakuna kujirudia -- faili hilo linaletwa na mkondo wenyewe, si
// mara mbili.
n32 maudhui_yapo(n8* jina, n8* b, n64 p, n64 urefu) {
    kama (pata_njia(jina) == 0) {
        rudisha 0;
    }
    n64 L = soma_faili(chombo_cha_njia, chombo_cha_ukaguzi, 16777216);
    kama (L < 0) {
        rudisha 0;
    }
    kama (L >= 16777215) {
        rudisha 0;  // kikubwa mno -- tatua_husisha litalia kwa sauti
    }
    // Kilichosalia cha mkondo wa sasa kinafaili hili (bila
    // mabadiliko) -- mkondo huo utakileta wakati wake.
    kama (tafuta_katika(b, p, urefu, chombo_cha_ukaguzi, L) == 1) {
        rudisha 1;
    }
    // Toa mistari ya husisha kwenye chombo_cha_ukaguzi (kubana mahali)
    n64 r = 0;  // mwandishi
    n64 s = 0;  // msomaji
    wakati (s < L) {
        n64 mwisho = s;
        wakati (mwisho < L && chombo_cha_ukaguzi[mwisho] != 10) {
            mwisho = mwisho + 1;
        }
        n64 baada = mwisho;
        kama (mwisho < L) { baada = mwisho + 1; }
        kama (tambua_mstari(chombo_cha_ukaguzi, s, mwisho - s) == 0) {
            nakili(chombo_cha_ukaguzi + r, chombo_cha_ukaguzi + s, baada - s);
            r = r + baada - s;
        }
        s = baada;
    }
    kama (r == 0) {
        rudisha 1;  // faili tupu -- "lipo" kimantiki
    }
    // Towe (chanzo_buf) linafaili hili tayari -- liliingizwa na
    // mkusanyaji hapo awali.
    kama (tafuta_katika(chombo_cha_chanzo_kamili, 0, chanzo_urefu, chombo_cha_ukaguzi, r) == 1) {
        rudisha 1;
    }
    // Nakala ya zamani au ya sehemu iko kwenye mkondo? Mistari ya
    // kwanza ya msimbo (isiyo tupu na isiyo maelezo ya "//") ndiyo
    // ishara -- zamani mstari wa husisha ulifutwa bila kujali, kwa
    // hiyo hupuuza ni kama zamani. Maelezo hayatoshi: maelezo ya
    // chanzo kikuu yako kwenye towe kila wakati, lakini si msimbo.
    n64 mwanzo_wa_mstari = 0;
    n64 mwisho_wa_ishara = 0;
    n64 idadi_ya_ishara = 0;
    n64 t = 0;
    wakati (t < r && idadi_ya_ishara < 2) {
        n64 mwisho = t;
        wakati (mwisho < r && chombo_cha_ukaguzi[mwisho] != 10) {
            mwisho = mwisho + 1;
        }
        n32 ni_maelezo = 0;
        kama (mwisho > t + 1) {
            kama (chombo_cha_ukaguzi[t] == 47) {
                kama (chombo_cha_ukaguzi[t + 1] == 47) { ni_maelezo = 1; }
            }
        }
        kama (mwisho > t && ni_maelezo == 0) {
            kama (idadi_ya_ishara == 0) { mwanzo_wa_mstari = t; }
            mwisho_wa_ishara = mwisho;
            kama (mwisho < r) { mwisho_wa_ishara = mwisho + 1; }
            idadi_ya_ishara = idadi_ya_ishara + 1;
        }
        t = mwisho;
        kama (t < r) { t = t + 1; }
    }
    kama (idadi_ya_ishara > 0) {
        n64 urefu_wa_ishara = mwisho_wa_ishara - mwanzo_wa_mstari;
        kama (tafuta_katika(chombo_cha_chanzo_kamili, 0, chanzo_urefu, chombo_cha_ukaguzi + mwanzo_wa_mstari, urefu_wa_ishara) == 1) {
            rudisha 1;
        }
        kama (tafuta_katika(b, p, urefu, chombo_cha_ukaguzi + mwanzo_wa_mstari, urefu_wa_ishara) == 1) {
            rudisha 1;
        }
    }
    rudisha 0;
}

// chapisha_mzunguko -- chapisha mzunguko kuanzia mrundikano[mwanzo]
// hadi mwisho wa mrundikano, kisha kurudi kwenye mrundikano[mwanzo] tena
w0 chapisha_mzunguko(n32 mwanzo) {
    andika_kosa("; KOSA: mzunguko wa husisha umegunduliwa:\n");
    andika_kosa(";   ");
    n32 k = mwanzo;
    wakati (k < urefu_wa_mrundikano) {
        andika_kosa("%s", majina_husisha + mrundikano_wa_husisha[k] * KIPANDE);
        k = k + 1;
        kama (k < urefu_wa_mrundikano) {
            andika_kosa(" -> ");
        }
    }
    andika_kosa(" -> %s\n", majina_husisha + mrundikano_wa_husisha[mwanzo] * KIPANDE);
}

// Tangazo la mbele -- tatua_husisha na changanua_husisha
// zinajirudia kwa kila nyingine
w0 changanua_husisha(n8* b, n64 urefu, n32 ni_kuu);

// tatua_husisha -- tafuta faili kwa mpangilio wa utafutaji, usome,
// na uchanganue mistari yake kwa kujirudia. Maudhui yake yanaisha
// kwenye pato kwa mpangilio wa utegemezi (tegemezi kabla ya
// tegemeziwa). Kila faili linatolewa mara moja tu; mzunguko
// unakataliwa kwa sauti.
w0 tatua_husisha(n8* jina) {
    kama (kosa) {
        rudisha;
    }
    // Pata njia ya kwanza iliyopo kwa mpangilio wa utafutaji
    kama (pata_njia(jina) == 0) {
        andika_kosa("; KOSA: faili la husisha halipatikani: %s\n", jina);
        kama (urefu_wa_mrundikano > 0) {
            andika_kosa(";   Ilitajwa kutoka: %s\n", majina_husisha + mrundikano_wa_husisha[urefu_wa_mrundikano - 1] * KIPANDE);
        }
        andika_kosa(";   Utafutaji: msingi/%s, msingi/maktaba/%s, %s\n", jina, jina, jina);
        kama (saraka_ya_swa_tafuta() == 1) {
            andika_kosa(";   kisha chini ya usakinishaji: %s/msingi/, %s/msingi/maktaba/, %s/\n", saraka_ya_swa, saraka_ya_swa, saraka_ya_swa);
        }
        kosa = 1;
        rudisha;
    }
    // Mzunguko? -- faili liko tayari kwenye mrundikano wa sasa
    n32 k = 0;
    wakati (k < urefu_wa_mrundikano) {
        kama (linganisha_mfuatano(chombo_cha_njia, majina_husisha + mrundikano_wa_husisha[k] * KIPANDE) == 0) {
            chapisha_mzunguko(k);
            kosa = 1;
            rudisha;
        }
        k = k + 1;
    }
    // Limekamilika tayari? -- toa mara moja tu (hakuna marudio)
    k = 0;
    wakati (k < idadi_zilizotatuliwa) {
        kama (linganisha_mfuatano(chombo_cha_njia, majina_husisha + zilizotatuliwa[k] * KIPANDE) == 0) {
            rudisha;
        }
        k = k + 1;
    }
    kama (urefu_wa_mrundikano >= 511) {
        andika_kosa("; KOSA: utegemezi ni mrefu mno\n");
        kosa = 1;
        rudisha;
    }
    // Soma faili lote
    n64 urefu = soma_faili(chombo_cha_njia, chombo_cha_faili_la_sasa, 16777216);
    kama (urefu < 0) {
        andika_kosa("; KOSA: faili halisomeki: %s\n", chombo_cha_njia);
        kosa = 1;
        rudisha;
    }
    kama (urefu >= 16777215) {
        andika_kosa("; KOSA: faili ni kubwa mno kwa mkusanyaji: %s\n", chombo_cha_njia);
        kosa = 1;
        rudisha;
    }
    // Andika njia kwenye hifadhi; sukuma kwenye mrundikano
    n32 faharisi = ongeza_jina(chombo_cha_njia);
    kama (kosa) {
        rudisha;
    }
    mrundikano_wa_husisha[urefu_wa_mrundikano] = faharisi;
    urefu_wa_mrundikano = urefu_wa_mrundikano + 1;
    // Changanua mistari yake kwa kujirudia
    changanua_husisha(chombo_cha_faili_la_sasa, urefu, 0);
    // Toa kwenye mrundikano; kamilisha faili hili
    urefu_wa_mrundikano = urefu_wa_mrundikano - 1;
    kama (kosa == 0) {
        zilizotatuliwa[idadi_zilizotatuliwa] = faharisi;
        idadi_zilizotatuliwa = idadi_zilizotatuliwa + 1;
    }
}

// changanua_husisha -- tembea mistari ya chombo; mistari ya
// "husisha { }" inatatuliwa kwa kujirudia, mistari mingine
// inaongezwa kwenye pato kama ilivyo. Kujirudia kusoma faili
// jingine kwenye chombo_cha_faili_la_sasa kunaweza kuiharibu -- kwa hiyo
// chanzo cha sasa kinasomwa upya baada ya kila kujirudia
// (chombo cha chanzo kikuu hakiwezi kuharibiwa: tegemezi hazisomi
// humo kamwe).
w0 changanua_husisha(n8* b, n64 urefu, n32 ni_kuu) {
    n64 p = 0;
    wakati (p < urefu && kosa == 0) {
        n64 mwisho = p;
        wakati (mwisho < urefu && b[mwisho] != 10) {
            mwisho = mwisho + 1;
        }
        n64 baada = mwisho;
        kama (mwisho < urefu) { baada = mwisho + 1; }
        n32 aina = tambua_mstari(b, p, mwisho - p);
        kama (aina == 2) {
            andika_kosa("; KOSA: husisha isiyo sahihi -- muundo pekee ni 'husisha { faili.swa }' (Swa haina kiungo cha C wala libc)\n");
            kosa = 1;
        } sivyo { kama (aina == 1) {
            kama (toa_jina(b, p, mwisho - p) == 0) {
                kama (maudhui_yapo(chombo_cha_jina, b, p, urefu) == 0) {
                    tatua_husisha(chombo_cha_jina);
                    kama (ni_kuu == 0 && kosa == 0) {
                        // chombo_cha_faili_la_sasa imeharibiwa -- isome upya njia
                        // ya sasa (juu ya mrundikano)
                        n8* njia_sasa = majina_husisha + mrundikano_wa_husisha[urefu_wa_mrundikano - 1] * KIPANDE;
                        n64 m2 = soma_faili(njia_sasa, chombo_cha_faili_la_sasa, 16777216);
                        kama (m2 != urefu) {
                            andika_kosa("; KOSA: faili lilibadilika wakati wa kutatua: %s\n", njia_sasa);
                            kosa = 1;
                        }
                    }
                }
            }
        } sivyo {
            ongeza_chanzo(b + p, baada - p);
        } }
        p = baada;
    }
}

// Bendera iliyoondolewa kabla ya v0.0.2 -> bendera mpya (0 kama si hivyo)
n8* chaguo_lililoondolewa(n8* a) {
    kama (linganisha_mfuatano(a, "--jit") == 0) { rudisha "--papo"; }
    kama (linganisha_mfuatano(a, "--exe") == 0) { rudisha "--programu"; }
    kama (linganisha_mfuatano(a, "--kernel") == 0) { rudisha "--kiini"; }
    kama (linganisha_mfuatano(a, "--ir") == 0) { rudisha "--kati"; }
    rudisha 0;
}

n32 anza(n32 idadi_ya_hoja_za_mstari, n8** hoja_za_mstari) {
    swa_hoja_mstari0 = hoja_za_mstari[0];
    n32 ni_papo = 0;
    n32 ni_programu = 0;
    n32 ni_wasm = 0;
    n32 ni_kiini = 0;
    n32 ni_tafsiri = 0;
    n32 ni_ir = 0;
    n32 ni_riscv64 = 0;
    n32 faharasa_ya_faili = 1;
    kama (idadi_ya_hoja_za_mstari > 1) {
        n8* a = hoja_za_mstari[1];
        // Bendera za Kiswahili (hati/kamusi.md): --programu (ELF
        // inayotekelezeka), --kiini (picha ya kiini, Kawira), --kati
        // (uwakilishi wa kati), --papo (tekeleza papo hapo). Bendera
        // zilizoondolewa hukataliwa kwa jina jipya.
        kama (chaguo_lililoondolewa(a) != 0) { kataa_neno_la_zamani(a, chaguo_lililoondolewa(a)); rudisha 1; }
        kama (linganisha_mfuatano(a, "--papo") == 0) { ni_papo = 1; faharasa_ya_faili = 2; }
        kama (linganisha_mfuatano(a, "--programu") == 0) { ni_programu = 1; faharasa_ya_faili = 2; }
        // --wasm: kwenda WebAssembly (kwa kivinjari) badala ya x86-64 ELF.
        // Awali haihitaji kuielewa -- ni ya kamili pekee (uzalishaji_wasm.swa).
        kama (linganisha_mfuatano(a, "--wasm") == 0) { ni_wasm = 1; faharasa_ya_faili = 2; }
        // --kiini: pato ghafi la .text la x86-64 lisilo na mfumo (Kawira,
        // ring 0) -- hakuna ELF, hakuna _start/argv, hakuna syscalls.
        kama (linganisha_mfuatano(a, "--kiini") == 0) { ni_kiini = 1; faharasa_ya_faili = 2; }
        // --tafsiri: teremsha hadi IR (mteremko.swa) na uitekeleze moja kwa
        // moja (mtafsiri.swa) -- hakuna msimbo wa mashine. --kati: chapisha IR.
        kama (linganisha_mfuatano(a, "--tafsiri") == 0) { ni_tafsiri = 1; faharasa_ya_faili = 2; }
        kama (linganisha_mfuatano(a, "--kati") == 0) { ni_ir = 1; faharasa_ya_faili = 2; }
        // --riscv64: IR hadi RV64IM, ELF tuli ya Linux (uzalishaji_riscv64.swa)
        kama (linganisha_mfuatano(a, "--riscv64") == 0) { ni_riscv64 = 1; faharasa_ya_faili = 2; }
        // --wasm-js: kiolesura cha JS cha moduli za --wasm (hati/kiolesura-cha-mashine.md)
        kama (linganisha_mfuatano(a, "--wasm-js") == 0) {
            wasm_andika_kiolesura_js();
            rudisha 0;
        }
    }

    // Hali ya kujikusanya (hakuna faili la mtumiaji): tatua maktaba
    // zote kwa mpangilio -- utegemezi wa ndani unatatuliwa kwa njia
    // ya mrundikano, kwa hiyo mpangilio wa mwisho ni wa kijiolojia.
    kama (idadi_ya_hoja_za_mstari <= faharasa_ya_faili) {
        tatua_husisha("maktaba/kumbukumbu.swa");
        tatua_husisha("maktaba/mfuatano.swa");
        tatua_husisha("mkusanyaji/msomaji.swa");
        tatua_husisha("mkusanyaji/msambazaji.swa");
        tatua_husisha("mkusanyaji/mteremko.swa");
        tatua_husisha("mkusanyaji/mtafsiri.swa");
        tatua_husisha("mkusanyaji/mkaguzi.swa");
        tatua_husisha("mkusanyaji/uzalishaji.swa");
        tatua_husisha("mkusanyaji/uzalishaji_wasm.swa");
        tatua_husisha("mkusanyaji/uzalishaji_riscv64.swa");
        tatua_husisha("maktaba/orodha.swa");
        tatua_husisha("maktaba/ramani.swa");
        tatua_husisha("mkusanyaji/kiendeshaji.swa");
    }

    kama (faharasa_ya_faili < idadi_ya_hoja_za_mstari) {
        n64 n = soma_faili(hoja_za_mstari[faharasa_ya_faili], chombo_cha_faili_kuu, 16777216);
        kama (n < 0) {
            andika_kosa("; KOSA: faili la chanzo halifunguki: %s\n", hoja_za_mstari[faharasa_ya_faili]);
            rudisha 1;
        }
        kama (n >= 16777215) {
            andika_kosa("; KOSA: faili la chanzo ni kubwa mno: %s\n", hoja_za_mstari[faharasa_ya_faili]);
            rudisha 1;
        }
        // Njia kuu iko kwenye mrundikano kuanzia mwanzo -- mzunguko
        // unaorudi kwenye chanzo kikuu hugunduliwa
        n32 faharisi = ongeza_jina(hoja_za_mstari[faharasa_ya_faili]);
        kama (kosa) {
            rudisha 1;
        }
        mrundikano_wa_husisha[0] = faharisi;
        urefu_wa_mrundikano = 1;
        changanua_husisha(chombo_cha_faili_kuu, n, 1);
    }

    kama (kosa) {
        rudisha 1;
    }

    chombo_cha_chanzo_kamili[chanzo_urefu] = 0;

    // 1. Changanua chanzo hadi AST
    Msambazaji p = msambazaji_mpya(chombo_cha_chanzo_kamili, chanzo_urefu);
    n32 nodi_ya_programu = changanua(&p);
    kama (p.kosa != 0) {
        andika_kosa("; KOSA: %d\n", p.kosa);
        rudisha 1;
    }

    // 1.4. Majina yaliyoondolewa (anza, andika_stderr, sys_*...) hukataliwa kwa jina jipya
    kama (kagua_majina_yaliyoondolewa(nodi_ya_programu) != 0) { rudisha 1; }

    // 1.5. Kuunganisha kazi ndogo (kupachika kazi, awamu ya 1).
    // Inafanyika KABLA ya ukaguzi wa kisemantiki kwa makusudi: mti
    // uliosukwa unapita ukaguzi wa mkaguzi_angalia kama mti mwingine
    // wowote, hivyo ukaguzi huo unatumika kama ulinzi wa bure wa
    // usahihi dhidi ya kosa lolote la usukaji.
    nodi_ya_programu = kujumuisha_kazi_ndogo(nodi_ya_programu);

    // 2. Ukaguzi wa kisemantiki
    // Makosa ya aina ni ya kufa: programu iliyokataliwa haipaswi
    // kutoa msimbo wowote. Kosa lolote la mkaguzi linazuia mkusanyaji
    // (ona hati/uthibitisho-wa-lugha.md, kipengele J10).
    n32 makosa = mkaguzi_angalia(nodi_ya_programu);
    kama (makosa != 0) {
        andika_kosa("Hitilafu: makosa %d ya aina yalipatikana; hakuna msimbo uliotolewa\n", makosa);
        rudisha 1;
    }

    // 2.5. LICM (loop-invariant msimbo motion). Inafanyika BAADA ya
    // ukaguzi wa kisemantiki KWA MAKUSUDI (tofauti na kuunganisha
    // kazi ndogo hapo juu): kila nodi ya usemi tayari ina usimbaji
    // iliyothibitishwa na mkaguzi_angalia, hivyo matamko mapya ya
    // muda tunayotengeneza yanaweza kunakili usimbaji huo moja kwa moja
    // badala ya kuhitaji jedwali letu wenyewe la aina za vigezo
    // (angalia maelezo kamili juu ya hamisha_nje_boresha, msambazaji.swa).
    nodi_ya_programu = hamisha_nje_boresha(nodi_ya_programu);

    // 2.6. SSCSE (CSE ya msimbo wa mstari-moja-kwa-moja). Baada ya
    // LICM kwa makusudi -- inashughulikia usemi unaorudiwa NJE ya
    // mizunguko (au ndani ya mizunguko lakini usiokuwa isiyobadilika), sehemu
    // ambayo LICM haigusi kabisa (angalia maelezo kamili juu ya
    // urudufu_wa_mstari_boresha, msambazaji.swa).
    nodi_ya_programu = urudufu_wa_mstari_boresha(nodi_ya_programu);

    // 3. --tafsiri / --kati: teremsha AST hadi IR ya mstari (mteremko.swa);
    // kisha itekeleze (mtafsiri.swa) au ichapishe. Kisichoungwa mkono na IR
    // hutajwa kwa sauti na kutoka kwa 2.
    // Kazi za nje (kiolesura cha mashine) zinahitaji kipakiaji cha mfumo
    // (--programu) au mwenyeji wa WASM (--wasm: uingizaji); mtafsiri hana.
    kama (kigeni_idadi_ya_kazi + kigeni_idadi_ya_data > 0 && (ni_tafsiri || ni_ir || ni_riscv64)) {
        andika_kosa("Hitilafu: kazi za nje (kizuizi cha nje) zinahitaji --programu au --wasm -- hazipatikani kwenye --tafsiri wala --kati\n");
        rudisha 1;
    }

    kama (ni_tafsiri || ni_ir || ni_riscv64) {
        kama (teremsha(nodi_ya_programu) != 0) { rudisha 2; }
        kama (ni_ir) { ir_chapisha(); rudisha 0; }
        kama (ni_riscv64) { rudisha riscv64_zalisha(); }
        rudisha mtafsiri_endesha(idadi_ya_hoja_za_mstari - faharasa_ya_faili, hoja_za_mstari + faharasa_ya_faili);
    }

    kama (ni_papo) { uzalishaji_papo(nodi_ya_programu, idadi_ya_hoja_za_mstari - faharasa_ya_faili, hoja_za_mstari, faharasa_ya_faili); }
    sivyo { kama (ni_wasm) {
            // uzalishaji_wasm_kuu inarudisha 1 kwa ujenzi ulio nje ya
            // wigo wa Awamu 1 (angalia uzalishaji_wasm.swa) -- lazima
            // ijulishwe kwa msimbo wa kutoka wa mchakato, sawa na
            // ukaguzi wa "kosa" hapo juu, la sivyo stdout ingekuwa
            // tupu lakini mchakato ungeonekana kufaulu.
            n32 matokeo_wasm = uzalishaji_wasm_kuu(nodi_ya_programu);
            kama (matokeo_wasm != 0) { rudisha 1; }
        } sivyo { kama (ni_kiini) {
                // hali_ya_towe==2: --kiini (Kawira). Ukaguzi wa wigo
                // (kernel_kagua_wigo) na makosa mengine ndani ya
                // uzalishaji_kuu/uzalishaji_wito hutoka moja kwa moja
                // (wito_wa_mfumo(60,1,...)) -- kioo cha jinsi makosa
                // mengine ya kufa ya uzalishaji.swa yanavyofanya kazi
                // tayari (mfano "kazi 'anza' haipo"), hivyo hakuna
                // ukaguzi wa ziada wa msimbo wa kutoka unaohitajika
                // hapa (tofauti na --wasm, ambayo inarudi 1 badala ya
                // kutoka moja kwa moja).
                uzalishaji_kuu(nodi_ya_programu, 2);
            } sivyo { uzalishaji_kuu(nodi_ya_programu, ni_programu); } } }

    // Wavu wa usalama wa PILI (ule wa kwanza na wa KWELI uko ndani ya
    // uzalishaji_kuu yenyewe, mara moja kabla ya "4. Toa ELF kwa
    // stdout" -- hutoka kabisa kupitia wito_wa_mfumo(60,1,...) KABLA
    // ya baiti yoyote kuandikwa, kwa hali_ya_towe zote (programu, --kiini, .o),
    // hivyo kwa kawaida haifikiki hapa). Hii hapa inashughulikia --papo
    // (uzalishaji_jit ina ukaguzi wake wa ndani kabla ya tekeleza(),
    // lakini hiyo inarudi kimya -- rudisha; -- badala ya kuashiria
    // mchakato, hivyo ukaguzi huu unahakikisha msimbo wa kutoka wa
    // MCHAKATO MZIMA pia ni sahihi) na kama ulinzi wa ziada endapo
    // njia nyingine ya uzalishaji itaongezwa baadaye bila kupitia
    // ukaguzi wa ndani wa uzalishaji_kuu. text_imefurika (uzalishaji.swa)
    // inawekwa 1 na andika_baiti() kama chombo_cha_msimbo imefurika, na pia na
    // ukaguzi mwingine wa ndani unaotumia bendera ile ile kama ishara
    // ya jumla ya "uzalishaji wa msimbo umeshindwa kimya" (mfano
    // vigezo vya ndani vimezidi 64, undani wa mzunguko umezidi 16).
    // Zamani bendera hii iliandikwa lakini HAIJAWAHI kusomwa mahali
    // popote -- mkusanyaji ulitoka kwa msimbo 0 (mafanikio ya uwongo)
    // ukiwa ametoa ELF iliyokatika/kuharibika kimya kimya (ona
    // uchunguzi wa Dominion jaribio_mchezo_kamili.swa uliogundua
    // hitilafu hii baada ya #301).
    kama (msimbo_umefurika != 0) {
        andika_kosa("KOSA: uzalishaji wa msimbo umefurika chombo cha ndani (chombo_cha_msimbo au jedwali linalohusiana) -- msimbo uliotolewa ni HARIBIKA, usiutumie\n");
        rudisha 1;
    }

    rudisha 0;
}
