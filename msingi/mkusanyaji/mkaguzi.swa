husisha { mkusanyaji/msambazaji.swa }
husisha { mkusanyaji/uzalishaji.swa }

// ==========================================================
// mkaguzi.swa -- mkaguzi wa semantiki (hatua muhimu ya 5 ya kujitegemea)
// Huangalia ukiukaji wa umiliki, kutolingana kwa idadi ya hoja,
// na makosa mengine ya semantiki kwenye AST iliyochambuliwa.
// ==========================================================

n32 mkaguzi_makosa = 0;

// Jina la kazi inayokaguliwa sasa (kwa ujumbe wa makosa)
n8* mkaguzi_kazi_sasa;

// Ufuatiliaji wa wigo kwa matamko ya vigeu
n32 wigo_umbali_wa_jina[256];
n32 wigo_usimbaji_wa_aina[256];
n32 wigo_idadi = 0;
// Fahirisi za mwanzo za wigo kwa sukuma/toa. Kikomo cha zamani (16)
// kilifurika kwenye upachikaji wa kina (kila sivyo husukuma mara
// mbili: KAMA kisha SIVYO) -- wigo_toa ilirejesha wigo_idadi kwa
// nafasi isiyo sahihi na vigeu vikaonekana kutokuwepo (mkaguzi
// wa zamani haukujali -- vitambulisho visivyojulikana havikuwa
// makosa; ukaguzi wa kihifadhi unategemea wigo kamili).
n32 wigo_vidokezo[256];
n32 wigo_vidokezo_idadi = 0;

// Kina cha kitanzi kwa ukaguzi wa muktadha wa vunja/endelea
n32 kina_cha_mzunguko = 0;

// Aina ya sasa ya kurudi ya kazi (kwa ukaguzi wa rudisha)
n32 usimbaji_wa_matokeo_ya_kazi = 0;

w0 wigo_sukuma() {
    kama (wigo_vidokezo_idadi < 256) {
        wigo_vidokezo[wigo_vidokezo_idadi] = wigo_idadi;
        wigo_vidokezo_idadi = wigo_vidokezo_idadi + 1;
    } sivyo {
        andika_stderr("KOSA: kina cha kitanzi/tawi (wigo_vidokezo) kimejaa (kikomo 256) -- kazi ina viwango vingi mno vya kutagusana vya {}\n");
        mkaguzi_makosa = mkaguzi_makosa + 1;
    }
}

w0 wigo_toa() {
    kama (wigo_vidokezo_idadi > 0) {
        wigo_vidokezo_idadi = wigo_vidokezo_idadi - 1;
        wigo_idadi = wigo_vidokezo[wigo_vidokezo_idadi];
    }
}

w0 wigo_ongeza(n8* jina, n32 usimbaji) {
    kama (wigo_idadi < 256) {
        wigo_umbali_wa_jina[wigo_idadi] = ghala_la_majina_wapi;
        wigo_usimbaji_wa_aina[wigo_idadi] = usimbaji;
        n32 i = 0;
        wakati (jina[i] != 0) {
            ghala_la_majina[ghala_la_majina_wapi + i] = jina[i];
            i = i + 1;
        }
        ghala_la_majina[ghala_la_majina_wapi + i] = 0;
        ghala_la_majina_wapi = ghala_la_majina_wapi + i + 1;
        wigo_idadi = wigo_idadi + 1;
    } sivyo {
        andika_stderr("KOSA: jedwali la vigezo vya wigo (wigo_idadi) limejaa (kikomo 256) kwenye kigezo '%s' -- kazi ina vigezo/vitambulisho vingi mno vinavyoonekana kwa wakati mmoja\n", jina);
        mkaguzi_makosa = mkaguzi_makosa + 1;
    }
}

n32 wigo_tafuta(n8* jina) {
    n32 i = wigo_idadi - 1;
    wakati (i >= 0) {
        n8* wj = ghala_la_majina + wigo_umbali_wa_jina[i];
        kama (jina_linganisha(wj, jina)) { rudisha wigo_usimbaji_wa_aina[i]; }
        i = i - 1;
    }
    rudisha -1;
}

// Sawa na wigo_tafuta, lakini inarudisha UWEPO TU (1/0), si usimbaji
// wa aina. MUHIMU: wigo_tafuta HAIWEZI kutumika peke yake kuamua kama
// kitambulisho "kimepatikana" -- kigezo halisi kilichopo kwenye wigo
// kinaweza kuwa na usimbaji -1 lenyewe (aina isiyojulikana/wildcard,
// mfano kigezo kutoka usemi wa halisi kamili), sawa kabisa na thamani
// inayorudishwa kwa "hakijapatikana". Kazi hii inaondoa utata huo --
// angalia mkaguzi_kagua_usemi, kesi ya AST_KITAMBULISHO.
n32 wigo_ipo(n8* jina) {
    n32 i = wigo_idadi - 1;
    wakati (i >= 0) {
        n8* wj = ghala_la_majina + wigo_umbali_wa_jina[i];
        kama (jina_linganisha(wj, jina)) { rudisha 1; }
        i = i - 1;
    }
    rudisha 0;
}

// Kielekezi? Rudisha 1 kwa kielekezi, 0 kwa thamani, -1 kwa
// aina isiyojulikana (0/-1). Kielekezi: enc chanya yenye biti ya
// mshale (isiyo sawa), au enc hasi isiyo sawa (kielekezi cha
// muundo). Thamani: enc chanya iliyo sawa, au enc hasi iliyo
// sawa (muundo kwa thamani).
// Familia b ni MIFUMO YA BITI (bendera, maski) -- si nambari wala
// boolean. Inaruhusu & | ^ ~ << >> == != pekee. b1 ni biti moja.
//
// Usimbaji wa b1 hutumia alama ya upana 12, si 1: encode_aina huweka
// mshale kwenye biti 0-1, kwa hiyo upana 1 ungekuwa sawa kabisa na
// "kielekezi kwenda b0" (1025). 12 haitumiwi na aina nyingine yoyote,
// na ukubwa_kutoka_enc hupata 12/8 = baiti 1.
n32 B1_USIMBAJI = 1036;

n32 mkaguzi_ni_biti(n32 usimbaji) {
    kama (usimbaji <= 0) { rudisha 0; }
    kama (usimbaji % 4 != 0) { rudisha 0; }  // kielekezi
    kama ((usimbaji / 256) % 256 == 4) { rudisha 1; }
    rudisha 0;
}

// Funga usemi kwa "& 1" mahali pake (nodi ileile inakuwa AST_BIT_NA
// yenye nakala ya usemi kushoto), ili thamani yoyote inayoingia kwenye
// b1 ibaki biti moja -- kwa KILA njia ya kuhifadhi (rafu, ulimwengu,
// sehemu, safu, rejesta) bila kugusa mzalishaji. Usemi lazima uwe
// umeshakaguliwa. ni_kiungo: 1 ikiwa ast_tiga ya nodi ni kiungo cha
// mnyororo wa hoja (kinabaki kwenye nodi); 0 ikiwa ni data ya nodi.
// Hesabu ya % badala ya &: mbegu ina hitilafu katika & na |.
w0 mkaguzi_funga_b1(n32 nodi_hii, n32 ni_kiungo) {
    kama (nodi_hii < 0) { rudisha; }
    kama (aina_ya_nodi[nodi_hii] == 4) {  // halisi: kunja wakati wa kukusanya
        thamani_ya_nodi[nodi_hii] = ((thamani_ya_nodi[nodi_hii] % 2) + 2) % 2;
        rudisha;
    }
    n32 nakala = nodi_mpya(aina_ya_nodi[nodi_hii], thamani_ya_nodi[nodi_hii], nodi_ya_kushoto[nodi_hii], nodi_ya_kulia[nodi_hii]);
    nne_ya_nodi[nakala] = nne_ya_nodi[nodi_hii];
    umbali_wa_jina_la_nodi[nakala] = umbali_wa_jina_la_nodi[nodi_hii];
    kama (ni_kiungo) {
        tatu_ya_nodi[nakala] = -1;
    } sivyo {
        tatu_ya_nodi[nakala] = tatu_ya_nodi[nodi_hii];
        tatu_ya_nodi[nodi_hii] = -1;
    }
    n32 moja = nodi_mpya(4, 1, -1, -1);
    nne_ya_nodi[moja] = 288;
    aina_ya_nodi[nodi_hii] = 43;  // AST_BIT_NA
    nodi_ya_kushoto[nodi_hii] = nakala;
    nodi_ya_kulia[nodi_hii] = moja;
    nne_ya_nodi[nodi_hii] = -1;
    umbali_wa_jina_la_nodi[nodi_hii] = 0;
    thamani_ya_nodi[nodi_hii] = B1_USIMBAJI;
}

n32 mkaguzi_ni_kielekezi(n32 usimbaji) {
    kama (usimbaji == 0 || usimbaji == -1) { rudisha -1; }
    kama ((usimbaji / 2) * 2 != usimbaji) { rudisha 1; }
    rudisha 0;
}

// Linganisha aina kwa ukaguzi: familia lazima zilingane.
// Upana na biti za mshale zinaweza kutofautiana -- maktaba huchanganya
// n8/n16/n32/n64 na kielekezi+n32 (hesabu ya anwani: ast_pool + off)
// kwa hiari, na mzalishaji hutoa upana sahihi kila mahali.
// enc hasi = muundo au kielekezi cha muundo (zote zina familia maalum).
n32 mkaguzi_aina_zifanane(n32 a, n32 b) {
    kama (a == 0 || b == 0 || a == -1 || b == -1) { rudisha 1; }
    kama (a < 0 || b < 0) {
        kama (a < 0 && b < 0) { rudisha 1; }
        // Kielekezi cha muundo (hasi odd) dhidi ya kielekezi wa kawaida:
        // teng a() inarudisha n8* na hupewa muundo* -- mchanganyiko halali
        // wa kielekezi. Muundo wenyewe (hasi hata) dhidi ya kielekezi si sawa.
        kama (a < 0) {
            kama ((a / 2) * 2 != a) { rudisha 1; }  // a ni kielekezi cha muundo
            rudisha 0;
        }
        kama ((b / 2) * 2 != b) { rudisha 1; }  // b ni kielekezi cha muundo
        rudisha 0;
    }
    n32 fa = (a / 256) % 256;
    n32 fb = (b / 256) % 256;
    kama (fa == 0 || fb == 0) { rudisha 1; }  // aina isiyojulikana
    rudisha fa == fb;
}

// Mpaka wa kamili/desimali (C-semantiki ya pandisha): desimali
// (familia 3) na nambari kamili yenye ishara/bila ishara (familia
// 1/2) zinachanganyika kwa hiari -- operesheni inapandishwa hadi
// d64/D32 na mzalishaji. Rudisha 1 ikiwa zinaweza kuchanganyika.
n32 mkaguzi_mpaka_wa_desimali(n32 a, n32 b) {
    kama (a == 0) { rudisha 0; }
    kama (b == 0) { rudisha 0; }
    kama (a == -1) { rudisha 0; }
    kama (b == -1) { rudisha 0; }
    kama (a < 0) { rudisha 0; }  // miundo -- mpaka hautumiki
    kama (b < 0) { rudisha 0; }
    n32 fa = (a / 256) % 256;
    n32 fb = (b / 256) % 256;
    kama (fa == 3) {
        kama (fb == 1) { rudisha 1; }
        kama (fb == 2) { rudisha 1; }
        rudisha 0;
    }
    kama (fb == 3) {
        kama (fa == 1) { rudisha 1; }
        kama (fa == 2) { rudisha 1; }
        rudisha 0;
    }
    rudisha 0;
}

// Akiba ya nodi za miundo kwa utendaji (kutafuta aina ya sehemu ya
// muundo, angalia mkaguzi_kagua_usemi kesi SEHEMU_DOT/SEHEMU_MSHALE
// chini). MUHIMU: ukubwa huu LAZIMA uwe mkubwa kuliko idadi ya
// `muundo` yoyote itakayofafanuliwa kwenye graph nzima ya husisha
// iliyotatuliwa ya programu YOYOTE inayotumia mkusanyaji huu --
// ukubwa wa awali (32) ulikuwa mdogo sana: mradi wowote halisi
// ulioukwepa (structs 33+) ulipata (a) hitilafu za AINA za uwongo
// (muundo usiopatikana kwenye akiba hurudi (1<<8)|32, "i32
// chaguo-msingi", badala ya aina yake halisi) NA (b) uharibifu wa
// wakati wa kukimbia (ast_nne[node], ofseti ya sehemu, kamwe
// haiandikwi kwa muundo usiopatikana kwenye akiba, kwa hiyo codegen
// hutumia thamani ya zamani/isiyoanzishwa) -- angalia
// lugha-swa/swa#189. 1024 inaendana na jedwali dada kwenye faili
// hili (kazi_jina_off[1024], global_jina_off[1024], na kadhalika).
n32 nodi_ya_muundo[1024];
n32 idadi_ya_miundo = 0;

// Jedwali la vigezo vya ulimwengu (jina + aina) kwa utatuzi wa majina
n8* ghala_la_majina_ya_ulimwengu;
n32 umbali_wa_jina_la_ulimwengu[1024];
n32 aina_ya_ulimwengu[1024];
n32 idadi_ya_vigeu_vya_ulimwengu = 0;

// Alama ya muktadha: hoja ya ukubwa(...) inayokaguliwa SASA hivi
// (angalia mkaguzi_kagua_wito) -- mahali pekee ambapo kitambulisho
// kinaruhusiwa kuwa jina la aina (n32, d64, n.k.) au jina la muundo
// badala ya kigezo/kigezo cha ulimwengu/jina la kazi halisi -- sawa
// na ukubwa_hoja kwenye msambazaji.swa (parser), lakini kwa ajili ya
// mkaguzi_kagua_usemi (AST_KITAMBULISHO, angalia chini).
n32 mkaguzi_ukubwa_wa_hoja = 0;

// Thibitisha kwamba encoding ya aina, IKIWA ni ya muundo (enc < 0),
// inarejelea muundo ULIOTANGAZWA KWELI kwenye graph nzima ya husisha
// (muundo_nodes[0..muundo_count), iliyokusanywa na "pitia ya kwanza"
// KABLA ya kuitwa hapa -- angalia mkaguzi_angalia). Bila ukaguzi huu,
// jina lisilotambuliwa KABISA (mfano typo au neno lisilo na maana)
// likitumika kama aina ya kurudi/hoja/kigezo cha ulimwengu/sehemu ya
// muundo lilikubaliwa KIMYA na changanua_aina_tokeni (msambazaji.swa)
// kama muundo asiyejulikana wa mtumiaji -- lengo la tabia hiyo ni
// kuruhusu miundo ya kujirejelea/kutangazwa mbele (mfano
// "muundo Nodi { Nodi* ijayo; }", ambapo "Nodi" bado haijasajiliwa
// wakati mwili wake unachanganuliwa) -- LAKINI haikutofautisha
// "bado haijasajiliwa (itasajiliwa)" na "kamwe haitasajiliwa (typo)",
// ikitoa msimbo mbaya kimya badala ya kosa la sauti. Ugunduzi
// ulifanyika wakati wa Awamu D (uondoaji wa herufi kubwa, PR #279),
// umeandikwa kwenye hati/hali-ya-lugha.md, umerekebishwa hapa.
//
// muktadha: maandishi ya kuelezea mahali (jina la kazi/muundo) kwa
// ujumbe wa kosa.
w0 mkaguzi_thibitisha_aina_ya_muundo(n32 usimbaji, n8* muktadha) {
    kama (usimbaji >= 0) { rudisha; }  // aina ya msingi -- hakuna cha kuthibitisha
    // Fungua jina kutoka kwa encoding (sawa na SEHEMU_DOT/SEHEMU_MSHALE
    // chini): enc = -((off+1)*2) + mshale, mshale ni 0/1/3.
    n32 name_umbali = ((-usimbaji) / 2) - 1;
    kama ((usimbaji / 2) * 2 != usimbaji) { name_umbali = name_umbali + 1; }  // mshale huhamisha -1
    n8* jina = ghala_la_majina + name_umbali;
    n32 mi = 0;
    wakati (mi < idadi_ya_miundo) {
        n32 mn = nodi_ya_kushoto[nodi_ya_muundo[mi]];
        kama (jina_linganisha(ghala_la_majina + umbali_wa_jina_la_nodi[mn], jina)) { rudisha; }
        mi = mi + 1;
    }
    // lugha-swa/swa#284: usimbaji huu HAUTOFAUTISHI mshale=1 (kielekezi
    // kimoja, *) na mshale=3 (kielekezi-mara-mbili, **) kwa usawa/isivyo
    // usawa PEKEE -- zote mbili ni HASI ISIYO SAWA (odd), kwa hiyo
    // "+1 kama isiyo sawa" hapo juu ni SAHIHI kwa mshale=1 pekee. Kwa
    // mshale=3 halisi, hesabu hiyo hiyo hutoa name_off NDOGO KWA BAITI
    // MOJA (imethibitishwa kwa mkono, kesi kadhaa) -- jaribu jina
    // lililohamishwa +1 kabla ya kukata tamaa. (changanua_muundo/
    // uzalishaji.swa HAZIHITAJI kutofautisha mshale=1/3 kabisa --
    // vielekezi vyote viwili ni baiti 8, HAKUNA lookup ya jina
    // inayohitajika -- ni kazi hii MOJA TU (mpya, #280) inayohitaji
    // jina hasa kwa kesi ya kielekezi, kwa hiyo mgongano huu haujawahi
    // kuonekana kwenye njia nyingine za msimbo.)
    kama ((usimbaji / 2) * 2 != usimbaji) {
        n8* jina2 = jina + 1;
        n32 mi2 = 0;
        wakati (mi2 < idadi_ya_miundo) {
            n32 mn2 = nodi_ya_kushoto[nodi_ya_muundo[mi2]];
            kama (jina_linganisha(ghala_la_majina + umbali_wa_jina_la_nodi[mn2], jina2)) { rudisha; }
            mi2 = mi2 + 1;
        }
    }
    andika_stderr("kosa [%s]: aina ya muundo haijatangazwa: %s\n", muktadha, jina);
    mkaguzi_makosa = mkaguzi_makosa + 1;
}

n32 mkaguzi_angalia(n32 nodi_ya_programu) {
    mkaguzi_makosa = 0;
    wigo_idadi = 0;
    wigo_vidokezo_idadi = 0;
    kina_cha_mzunguko = 0;
    // Jaza jedwali la vigezo vya ulimwengu
    ghala_la_majina_ya_ulimwengu = ghala_la_majina;
    idadi_ya_vigeu_vya_ulimwengu = 0;
    n32 gn = nodi_ya_kushoto[nodi_ya_programu];
    wakati (gn != -1) {
        kama (aina_ya_nodi[gn] == 35) {
            kama (idadi_ya_vigeu_vya_ulimwengu < 1024) {
                umbali_wa_jina_la_ulimwengu[idadi_ya_vigeu_vya_ulimwengu] = umbali_wa_jina_la_nodi[nodi_ya_kushoto[gn]];
                n32 genc = thamani_ya_nodi[gn];
                // Safu: usemi unapaswa kuiona kama kielekezi (anwani ya msingi)
                kama (tatu_ya_nodi[gn] != -1) { genc = genc + 1; }
                aina_ya_ulimwengu[idadi_ya_vigeu_vya_ulimwengu] = genc;
                idadi_ya_vigeu_vya_ulimwengu = idadi_ya_vigeu_vya_ulimwengu + 1;
            } sivyo {
                andika_stderr("KOSA: jedwali la vigezo vya ulimwengu (global_idadi) limejaa (kikomo 1024) -- mradi una vigezo vya ulimwengu vingi mno\n");
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
        }
        gn = nne_ya_nodi[gn];
    }
    // Pitia ya kwanza: kusanya nodi za miundo (kwa utendaji)
    idadi_ya_miundo = 0;
    n32 nodi_hii = nodi_ya_kushoto[nodi_ya_programu];
    wakati (nodi_hii != -1) {
        kama (aina_ya_nodi[nodi_hii] == 12) {  // AST_MUUNDO
            kama (idadi_ya_miundo < 1024) {
                nodi_ya_muundo[idadi_ya_miundo] = nodi_hii;
                idadi_ya_miundo = idadi_ya_miundo + 1;
            } sivyo {
                andika_stderr("KOSA: akiba ya nodi za miundo (muundo_nodes) imejaa (kikomo 1024) -- graph ya husisha ina aina za muundo nyingi mno\n");
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
        }
        nodi_hii = nne_ya_nodi[nodi_hii];
    }
    // Thibitisha vigezo vya ulimwengu vya aina ya muundo (lazima
    // ifanyike BAADA ya muundo_nodes[] kujazwa hapo juu, ili miundo
    // iliyotangazwa BAADAYE kwenye faili bado ithibitike sahihi).
    n32 gi = 0;
    wakati (gi < idadi_ya_vigeu_vya_ulimwengu) {
        mkaguzi_thibitisha_aina_ya_muundo(aina_ya_ulimwengu[gi], "kigezo cha ulimwengu");
        gi = gi + 1;
    }
    // Thibitisha sehemu za miundo yenyewe za aina ya muundo (mfano
    // muundo A { B f; } -- B lazima iwe imetangazwa mahali fulani
    // kwenye graph, hata kama ni BAADA ya A -- angalia maelezo ya
    // mkaguzi_thibitisha_aina_ya_muundo hapo juu).
    n32 si = 0;
    wakati (si < idadi_ya_miundo) {
        n8* sjina = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kushoto[nodi_ya_muundo[si]]];
        n32 kazi_hii = nodi_ya_kulia[nodi_ya_muundo[si]];
        wakati (kazi_hii != -1) {
            n32 fname_nodi = nodi_ya_kushoto[kazi_hii];
            mkaguzi_thibitisha_aina_ya_muundo(thamani_ya_nodi[fname_nodi], sjina);
            kazi_hii = nodi_ya_kulia[kazi_hii];
        }
        si = si + 1;
    }
    // Pitia ya pili: sajili SAINI za kazi zote KABLA ya kukagua mwili
    // wowote (lugha-swa/swa#180) -- kazi A inayoita kazi B iliyofafanuliwa
    // BAADAYE kwenye faili lile lile lazima ipate B tayari imesajiliwa
    // wakati mwito wake unakaguliwa, si baada ya kukagua mwili wa A.
    // Zamani usajili ulifanyika ndani ya mkaguzi_kagua_kazi yenyewe
    // (pitio moja lililochanganya usajili na ukaguzi), hivyo kazi
    // yoyote iliyoitwa kabla ya kufafanuliwa bado haikuwa imesajiliwa.
    nodi_hii = nodi_ya_kushoto[nodi_ya_programu];
    wakati (nodi_hii != -1) {
        kama (aina_ya_nodi[nodi_hii] == 2) {
            mkaguzi_sajili_kazi(nodi_hii);
        }
        nodi_hii = nne_ya_nodi[nodi_hii];
    }
    // Pitia ya tatu: kagua miili ya kazi zote (saini zote tayari
    // zimesajiliwa kutoka pitio ya pili hapo juu).
    nodi_hii = nodi_ya_kushoto[nodi_ya_programu];
    wakati (nodi_hii != -1) {
        kama (aina_ya_nodi[nodi_hii] == 2) {
            mkaguzi_kagua_kazi(nodi_hii);
        }
        nodi_hii = nne_ya_nodi[nodi_hii];
    }
    rudisha mkaguzi_makosa;
}

// Fuatilia ni majina gani ya kazi yaliyopo kwa ukaguzi wa idadi ya hoja.
//
// MUHIMU: kazi_jina_pool ni DIMBWI LA BAITI za majina HALISI ya kazi
// (si jedwali la idadi kama muundo_nodes/desimali_off) -- ukubwa wake
// LAZIMA uzidi jumla ya urefu wa majina YOTE ya kazi zilizofafanuliwa
// kwenye graph nzima ya husisha iliyotatuliwa. Ukubwa wa awali
// (16384 baiti) ulikuwa mdogo sana: mradi halisi wenye moduli nyingi
// (mfano Dominion's mchezo.swa, ambayo huhusisha moduli 28+ zenye
// majina marefu ya Kiswahili kama "utawala_serikali_pata_rushwa_jumla")
// hufikia kikomo hiki kwa urahisi mara graph inapokuwa kubwa vya
// kutosha. Kuna ulinzi wa kufurika uliopo tayari (haiandiki nje ya
// mipaka, hutoa ujumbe wa hitilafu), lakini ujumbe huo wenyewe
// ulikuwa ukitokea mara kwa mara badala ya kufanya kazi ipasavyo.
// lugha-swa/swa#295 -- ukubwa wa ZAMANI (kazi_jina_off/kazi_param_count/
// kazi_ret_jina_off/kazi_ret_aina/kazi_param_start[1024]) ulikuwa mdogo
// mno kwa miradi makubwa: mradi halisi (Dominion's mchezo.swa, ~1136
// kazi) huvuka kikomo hiki kwa urahisi. Ukaguzi wa kufurika kwenye
// mkaguzi_sajili_kazi (chini) ULIKUWA UKIENDELEA KIMYA (hakuna hata
// ujumbe wa kosa) ukifikia 1024 -- kila kazi BAADA ya ya 1024
// HAIKUWAHI kusajiliwa, ikimaanisha mkaguzi_tafuta_param_enc() kwa
// kazi hizo HURUDISHA -1 (haijapatikana) DAIMA -- hii iliondoa
// UREKEBISHO (override ya aina ya hoja kutoka saini ya kazi
// iliyosajiliwa) ambao ungerekebisha vinginevyo hitilafu TOFAUTI
// (angalia uzalishaji.swa, uzalishaji_wito -- ukusanyaji wa hoja
// ulikuwa ukisoma ast_thamani ghafi badala ya aina_ya_usemi(),
// ukichukua aina ya OPERANDI kwa hoja ya ulinganishi (== != < > <=
// >=) badala ya matokeo yake 0/1 -- rekebisho kamili la #295). Suluhisho
// hapa: (1) ongeza ukubwa (mara 64), (2) ukaguzi wa kufurika sasa
// unasimamisha ukusanyaji (exit 1) badala ya kuendelea kimya.
n32 idadi_ya_kazi = 0;
n8 ghala_la_majina_ya_kazi[131072];
n32 ghala_la_majina_ya_kazi_wapi = 1;
n32 umbali_wa_jina_la_kazi[65536];
n32 idadi_ya_vigezo_vya_kazi[65536];

// Jedwali la aina za kurudi kwa kazi -- linajazwa wakati wa usajili
n32 idadi_ya_matokeo_ya_kazi = 0;
n8 ghala_la_matokeo_ya_kazi[8192];
n32 ghala_la_matokeo_ya_kazi_wapi = 1;
n32 umbali_wa_jina_la_matokeo_ya_kazi[65536];
n32 aina_ya_matokeo_ya_kazi[65536];

// Hifadhi za aina za vigezo kwa ukaguzi wa hoja za mwito
//
// lugha-swa/swa#295 -- hii ni jedwali BAPA la aina za PARAMU ZOTE
// za KAZI ZOTE ZIMEUNGANISHWA (si idadi ya kazi, ni jumla ya
// paramu -- kazi 1136 zenye wastani wa paramu 2-4 kila moja
// zinakaribia au kuzidi 4096 kwa urahisi; ukubwa huu HAUKUBADILISHWA
// pale kazi_idadi/kazi_ret_idadi zilipoongezwa (1024->65536) hapo
// juu, ukibaki kama "landmine" inayofuata ya aina ile ile (#295
// ilifichwa na #292 kwa muda; hii ingeweza kufichwa na #295).
// Ukaguzi wa kufurika uliopo tayari (chini) ULIKUWA ukiongeza
// mkaguzi_makosa TU (bila kusimamisha) -- sasa unasimamisha
// ukusanyaji (exit 1), sawa na muundo wa kazi_idadi/kazi_ret_idadi
// ulio juu kwenye kazi hii hii.
n32 usimbaji_wa_kigezo_cha_kazi[262144];  // aina za vigezo bapa
n32 usimbaji_wa_kigezo_cha_kazi_wapi = 0;  // nafasi ya sasa katika kazi_param_enc
n32 mwanzo_wa_kigezo_cha_kazi[65536];  // fahirisi ya mwanzo wa vigezo kwa kila kazi

w0 mkaguzi_sajili_kazi(n32 nodi_ya_kazi) {
    kama (idadi_ya_kazi >= 65536) {
        andika_stderr("kosa: jedwali la usajili wa kazi (kazi_idadi) limejaa (kikomo 65536) -- mradi una kazi nyingi mno\n");
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
    n32 name_nodi = nodi_ya_kushoto[nodi_ya_kazi];
    n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[name_nodi];
    // Thibitisha aina ya kurudi (kama ni muundo, lazima iwe imetangazwa
    // mahali fulani kwenye graph -- angalia mkaguzi_thibitisha_aina_ya_muundo).
    mkaguzi_thibitisha_aina_ya_muundo(thamani_ya_nodi[nodi_ya_kazi], jina);
    // Hesabu vigezo na hifadhi aina zao (viko kwenye nodi ya kazi, si nodi ya jina)
    n32 pc = 0;
    n32 mwanzo_wa_kigezo = usimbaji_wa_kigezo_cha_kazi_wapi;
    mwanzo_wa_kigezo_cha_kazi[idadi_ya_kazi] = mwanzo_wa_kigezo;
    n32 p = nodi_ya_kulia[nodi_ya_kazi];
    wakati (p != -1) {
        mkaguzi_thibitisha_aina_ya_muundo(thamani_ya_nodi[p], jina);
        kama (usimbaji_wa_kigezo_cha_kazi_wapi < 262144) {
            usimbaji_wa_kigezo_cha_kazi[usimbaji_wa_kigezo_cha_kazi_wapi] = thamani_ya_nodi[p];
            usimbaji_wa_kigezo_cha_kazi_wapi = usimbaji_wa_kigezo_cha_kazi_wapi + 1;
        } sivyo {
            andika_stderr("kosa [%s]: jedwali la aina za hoja bapa (kazi_param_enc) limejaa (kikomo 262144) -- mradi una hoja nyingi mno kwa jumla, kwenye kazi zote\n", jina);
            wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
        }
        pc = pc + 1;
        p = nodi_ya_kulia[p];
    }
    // Ulinzi wa dimbwi: kufurika kulikuwa kimeandika juu ya
    // kazi_jina_off (jedwali la ofseti) na kusababisha segfault
    // kwenye jina_linganisha wakati wa kujikusanya.
    //
    // MUHIMU: namba hii (131072) LAZIMA ilingane na ukubwa wa
    // tangazo la kazi_jina_pool[] juu ya faili hili -- Swa haina
    // njia ya kupata ukubwa wa safu kutoka kwa jina lake (hakuna
    // sizeof/lengthof), kwa hiyo namba hii ni HARDCODED kwa
    // makusudi, ikilingana na muundo uliopo tayari wa faili hili
    // (mfano muundo_count/muundo_nodes hapo juu). Kosa halisi
    // lililopatikana wakati wa kikao hiki: ukubwa wa tangazo la safu
    // ULIBADILISHWA (16384->131072) BILA kubadilisha namba hii
    // hapa, ikiacha ulinzi wa kufurika ukiendelea kukataa kwa
    // ukubwa wa ZAMANI -- angalia lugha-swa/swa#197 kwa maelezo
    // kamili. SASA kipengele kipya cha lugha, urefu(x) (angalia
    // uzalishaji.swa), kingeweza kutatua hili moja kwa moja -- LAKINI
    // kimejaribiwa hapa na KUONDOLEWA KWA MAKUSUDI: mkaguzi.swa ni
    // sehemu ya CHANZO CHA MKUSANYAJI MWENYEWE, na mbegu.bin (mbegu
    // ya awali iliyogandishwa, isiyobadilika) haitambui urefu() kama
    // hoja iliyosajiliwa -- ikijaribu kukusanya stage1.swa (ambayo
    // sasa ingehitaji urefu()) mbegu.bin ingekataa kwa "kazi
    // haijafafanuliwa: urefu", ikivunja mnyororo wa kujitegemea
    // (bootstrap) kabisa. urefu() inafaa kutumika kwenye MIRADI
    // INAYOTUMIA mkusanyaji (kama Dominion), SI ndani ya chanzo cha
    // mkusanyaji wenyewe, hadi mbegu.bin yenyewe ijengwe upya
    // ikiwa na msaada wa urefu() (swali tofauti kabisa la
    // kujitegemea, nje ya wigo wa kazi hii).
    n32 umbali = ghala_la_majina_ya_kazi_wapi;
    n32 i = 0;
    wakati (jina[i] != 0) {
        kama (umbali + i + 1 >= 131072) {
            andika_stderr("; KOSA: dimbwi la majina ya mkaguzi limejaa\n");
            mkaguzi_makosa = mkaguzi_makosa + 1;
            rudisha;
        }
        ghala_la_majina_ya_kazi[umbali + i] = jina[i];
        i = i + 1;
    }
    ghala_la_majina_ya_kazi[umbali + i] = 0;
    ghala_la_majina_ya_kazi_wapi = umbali + i + 1;
    umbali_wa_jina_la_kazi[idadi_ya_kazi] = umbali;
    idadi_ya_vigezo_vya_kazi[idadi_ya_kazi] = pc;
    idadi_ya_kazi = idadi_ya_kazi + 1;

    // Pia sajili aina ya kurudi kwa ukaguzi wa matumizi ya wito
    kama (idadi_ya_matokeo_ya_kazi < 65536) {
        umbali_wa_jina_la_matokeo_ya_kazi[idadi_ya_matokeo_ya_kazi] = umbali;
        aina_ya_matokeo_ya_kazi[idadi_ya_matokeo_ya_kazi] = thamani_ya_nodi[nodi_ya_kazi];
        idadi_ya_matokeo_ya_kazi = idadi_ya_matokeo_ya_kazi + 1;
    } sivyo {
        // lugha-swa/swa#295 -- hii ilikuwa ikiongeza mkaguzi_makosa tu
        // (bila kusimamisha mara moja), tofauti na jedwali dada
        // kazi_idadi hapo juu -- sasa inasimamisha sawa sawa (exit 1).
        andika_stderr("kosa [%s]: jedwali la aina za kurudi za kazi (kazi_ret_idadi) limejaa (kikomo 65536) -- mradi una kazi nyingi mno\n", jina);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
}

n32 mkaguzi_tafuta_kazi(n8* jina) {
    n32 i = 0;
    wakati (i < idadi_ya_kazi) {
        n8* kj = ghala_la_majina_ya_kazi + umbali_wa_jina_la_kazi[i];
        kama (jina_linganisha(kj, jina)) { rudisha idadi_ya_vigezo_vya_kazi[i]; }
        i = i + 1;
    }
    rudisha -1;
}

// Tafuta encoding ya aina ya parameta kwa jina la kazi na faharisi ya parameta
n32 mkaguzi_tafuta_kigezo_usimbaji(n8* jina, n32 faharasa) {
    n32 i = 0;
    wakati (i < idadi_ya_kazi) {
        n8* kj = ghala_la_majina_ya_kazi + umbali_wa_jina_la_kazi[i];
        kama (jina_linganisha(kj, jina)) {
            kama (faharasa < idadi_ya_vigezo_vya_kazi[i]) {
                rudisha usimbaji_wa_kigezo_cha_kazi[mwanzo_wa_kigezo_cha_kazi[i] + faharasa];
            }
            rudisha -1;
        }
        i = i + 1;
    }
    rudisha -1;
}

// Wito kupitia kigezo (kielekezi cha kazi)? Rudisha 1 ikiwa wito
// (AST_WITO) unamuita kigeu cha ndani/paramu (wigo) au cha ulimwengu
// kwa jina -- si kazi iliyosajiliwa. Wito kama huo hauna saini: aina za
// hoja na za kurudi hazijulikani wakati wa kukusanya (aina yake ya
// kurudi ni 0 -- "inakubaliana na yoyote", sawa na kazi za nje).
n32 mkaguzi_ni_wito_kupitia_kigezo(n32 nodi_hii) {
    kama (nodi_hii < 0) { rudisha 0; }
    kama (aina_ya_nodi[nodi_hii] != 8) { rudisha 0; }  // AST_WITO
    n32 cn = nodi_ya_kushoto[nodi_hii];
    kama (cn < 0) { rudisha 0; }
    kama (aina_ya_nodi[cn] != 5) { rudisha 0; }  // AST_KITAMBULISHO
    n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[cn];
    kama (mkaguzi_tafuta_kazi(jina) >= 0) { rudisha 0; }  // kazi halisi
    kama (wigo_tafuta(jina) >= 0) { rudisha 1; }
    n32 g = 0;
    wakati (g < idadi_ya_vigeu_vya_ulimwengu) {
        kama (jina_linganisha(ghala_la_majina_ya_ulimwengu + umbali_wa_jina_la_ulimwengu[g], jina)) { rudisha 1; }
        g = g + 1;
    }
    rudisha 0;
}

// Kataa matumizi ya wito kupitia kielekezi katika muktadha wa d64.
// Matokeo ya wito kama huo hayajulikani wakati wa kukusanya na
// yanakuja kwenye rejesta za GP (eax/rax), si xmm0 -- kuyachukulia
// kama d64 kungekuwa takataka kimya kimya (hati 4.3: matokeo ya d64
// hayakubaliki kupitia kielekezi). enc_lengwa <= 0 au isiyo ya familia
// ya D (3) hairudi chochote.
w0 mkaguzi_kataa_d64_kutoka_wito_wa_kigezo(n32 nodi_hii, n32 usimbaji_lengwa) {
    kama (usimbaji_lengwa <= 0) { rudisha; }
    kama ((usimbaji_lengwa / 256) % 256 != 3) { rudisha; }  // familia D pekee
    kama (mkaguzi_ni_wito_kupitia_kigezo(nodi_hii) == 0) { rudisha; }
    andika_stderr("kosa [%s]: wito kupitia kielekezi hauna aina ya kurudi -- matokeo ya d64 hayakubaliki\n", mkaguzi_kazi_sasa);
    mkaguzi_makosa = mkaguzi_makosa + 1;
}

// Kataa kigeu cha ndani cha w0 chenye kianzio. w0 (familia 5,
// upana 0) ni aina ya kazi pekee -- hati 3: "W0 ni kwa kazi tu".
// Kianzio cha thamani kwa w0 kilikubaliwa kimya zamani (kigeu cha
// ukubwa 0 -- thamani ikimezwa); kataa kwa sauti, kama kigezo cha
// w0 kinavyokataliwa. w0 bila kianzio inabaki halali (tangazo
// halina thamani ya kuhifadhi) -- kama vile w0* yenye kianzio
// (kielekezi cha kazi kinachoshika anwani).
w0 mkaguzi_kataa_w0_chenye_kianzio(n32 usimbaji, n8* jina_la_kigeu) {
    n32 w0_fam = (usimbaji / 256) % 256;
    n32 w0_upana = usimbaji - (w0_fam * 256);
    kama (w0_fam == 5) {
        kama (w0_upana == 0) {
            andika_stderr("kosa [%s]: kigeu '%s' cha w0 chenye kianzio -- w0 ni kwa kazi tu\n", mkaguzi_kazi_sasa, jina_la_kigeu);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
    }
}

// Kataa modulo (%) ya kielekezi. % si hesabu ya anwani -- jumlisha
// na toa ndizo pekee (p + n na p - n); zamani p % n ilikubaliwa
// kimya na kupiga modulo ya anwani yenyewe (rekodi 8.9). Kataa
// kwa sauti, kama p+p na n-p zinavyokataliwa.
w0 mkaguzi_kataa_modulo_ya_kielekezi(n32 aina, n32 kushoto_usimbaji, n32 kulia_usimbaji) {
    kama (aina == 49) {  // AST_MODULO
        n32 modulo_kushoto = mkaguzi_ni_kielekezi(kushoto_usimbaji);
        n32 modulo_kulia = mkaguzi_ni_kielekezi(kulia_usimbaji);
        kama (modulo_kushoto == 1) {
            andika_stderr("kosa [%s]: kielekezi kwenye modulo haina maana (l=%d, r=%d)\n", mkaguzi_kazi_sasa, kushoto_usimbaji, kulia_usimbaji);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        } sivyo {
            kama (modulo_kulia == 1) {
                andika_stderr("kosa [%s]: kielekezi kwenye modulo haina maana (l=%d, r=%d)\n", mkaguzi_kazi_sasa, kushoto_usimbaji, kulia_usimbaji);
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
        }
    }
}

// Kataa hoja nyingi kwa kazi za pekee zisizosajiliwa (wito_wa_mfumo,
// tekeleza, ukubwa, anwani_ya_kazi) -- mzalishaji huzitambua kwa jina
// na hoja zaidi ya kiwango cha kila moja zilimezwa kimya (mdudu wa
// 2026-09-04). Kiwango: wito_wa_mfumo 7 (namba ya mfumo + hoja 6 za GP),
// tekeleza 4 (kazi, argc, argv, ofseti), ukubwa 1 (jina la aina),
// anwani_ya_kazi 1 (jina la kazi). Idadi ndogo inabaki halali
// (wito_wa_mfumo(60, 0) n.k. -- mzalishaji hutoa sifuri kwa
// zilizokosekana).
w0 mkaguzi_kagua_kiwango_cha_huduma(n8* jina, n32 idadi_ya_hoja) {
    n32 kiwango_hoja = 0;
    kama (jina_linganisha(jina, "wito_wa_mfumo")) { kiwango_hoja = 7; }
    sivyo { kama (jina_linganisha(jina, "tekeleza")) { kiwango_hoja = 4; }
        sivyo { kama (jina_linganisha(jina, "ukubwa")) { kiwango_hoja = 1; }
            sivyo { kama (jina_linganisha(jina, "anwani_ya_kazi")) { kiwango_hoja = 1; }
                sivyo { kama (jina_linganisha(jina, "urefu")) { kiwango_hoja = 1; } } } } }
    kama (kiwango_hoja > 0) {
        kama (idadi_ya_hoja > kiwango_hoja) {
            andika_stderr("kosa [%s]: idadi ya hoja kwa '%s' si sahihi (kikomo ni %d, imepokea %d)\n", mkaguzi_kazi_sasa, jina, kiwango_hoja, idadi_ya_hoja);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
    }
}

// Kagua wito wa kazi (AST_WITO, 8): thibitisha aina za hoja dhidi ya
// vigezo na idadi ya hoja dhidi ya tangazo. Huitwa kutoka kwa wito
// wa nafasi ya taarifa NA wa nafasi ya usemi -- mwito wa nafasi ya
// usemi haupaswi kukwepa ukaguzi (mende: aina na idadi zisizofaa
// zilipita bila kugunduliwa kwenye usemi). andika/andika_stderr ni
// za kutofautiana (variadic) -- idadi yao haithibitishwi. Kazi za
// nje (wito_wa_mfumo, tekeleza) hazijaandikishwa, kwa hiyo hazina
// idadi ya kuthibitisha. Rudisha usimbaji wa aina ya kurudi
// (0 = kazi ya nje -- aina haijulikani, inakubaliana na yoyote).
n32 mkaguzi_kagua_wito(n32 nodi_hii) {
    n32 name_nodi = nodi_ya_kushoto[nodi_hii];
    kama (name_nodi != -1) {
        n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[name_nodi];
        // Hoja ya ukubwa(...) ni jina la aina/muundo, si kigezo halisi
        // -- angalia mkaguzi_ukubwa_hoja hapo juu na AST_KITAMBULISHO
        // kwenye mkaguzi_kagua_usemi kwa maelezo kamili.
        n32 ukubwa_wa_hoja_zamani = mkaguzi_ukubwa_wa_hoja;
        kama (jina_linganisha(jina, "ukubwa")) { mkaguzi_ukubwa_wa_hoja = 1; }
        // Hesabu na kagua hoja zilizotolewa
        n32 idadi_ya_hoja = 0;
        n32 a = nodi_ya_kulia[nodi_hii];
        wakati (a != -1) {
            n32 ijayo = tatu_ya_nodi[a];  // Hifadhi kabla mkaguzi_kagua_usemi abadilishe ast_tiga[a]
            n32 usimbaji_wa_hoja = mkaguzi_kagua_usemi(a);
            tatu_ya_nodi[a] = ijayo;  // Rejesha kiungo cha mnyororo wa hoja
            // Halisi kamili inarudisha 0 ("aina yoyote") -- enc yake
            // halisi iko ast_nne (288 kwa n32, 320 kwa n64). Halisi
            // haiwezi kamwe kuwa kielekezi; itumie enc halisi kwenye
            // ukaguzi mkali wa kielekezi (mdudu wa 2026-09-01: f(5)
            // kwa kigezo cha n32* ilipita kwa enc 0 na kuanguka SEGV).
            n32 usimbaji_wa_hoja_halisi = usimbaji_wa_hoja;
            kama (aina_ya_nodi[a] == 4) { usimbaji_wa_hoja_halisi = nne_ya_nodi[a]; }
            // Angalia aina ya hoja dhidi ya aina ya parameta
            n32 usimbaji_wa_kigezo_unaotarajiwa = mkaguzi_tafuta_kigezo_usimbaji(jina, idadi_ya_hoja);
            // Kupitisha hoja ni KUGAWA kwa paramu -- maana moja kila
            // mahali. Namba <-> kielekezi inakubaliwa hapa kama ilivyo
            // kwenye tangazo na ugawaji (Nodi* p = 5; n64 v = p;):
            // kielekezi hupokea thamani ya namba (ikipanuliwa kwa ishara
            // ya aina yake), namba hupokea biti za chini za anwani.
            // Zamani hoja pekee ndiyo iliyokataa (f(5), f(0), f(p) kwa
            // n64) -- ufafanuzi mmoja, utendaji miwili. Mpanga programu
            // ana uhuru kamili; lugha haimkatazi kitu chenye maana.
            // Ukaguzi wa familia/upana: aina za mtumiaji (muundo)
            // zinaweza kuwa hasi; halisi kamili (arg_enc == 0)
            // inakubaliana na aina yoyote ya namba (C-semantiki).
            kama (usimbaji_wa_kigezo_unaotarajiwa != 0 && usimbaji_wa_kigezo_unaotarajiwa != -1 && usimbaji_wa_hoja != 0 && usimbaji_wa_hoja != -1) {
                kama (mkaguzi_aina_zifanane(usimbaji_wa_hoja, usimbaji_wa_kigezo_unaotarajiwa) == 0) {
                    kama (mkaguzi_mpaka_wa_desimali(usimbaji_wa_hoja, usimbaji_wa_kigezo_unaotarajiwa) == 0) {
                        andika_stderr("kosa [%s]: aina ya hoja #%d kwa '%s' hailingani (arg=%d, param=%d)\n",
                        mkaguzi_kazi_sasa, idadi_ya_hoja + 1, jina, usimbaji_wa_hoja, usimbaji_wa_kigezo_unaotarajiwa);
                        mkaguzi_makosa = mkaguzi_makosa + 1;
                    }
                }
            }
            // Wito kupitia kielekezi kama hoja ya parameta ya d64:
            // matokeo yake hayapo kwenye xmm0 -- kataa kwa sauti.
            mkaguzi_kataa_d64_kutoka_wito_wa_kigezo(a, usimbaji_wa_kigezo_unaotarajiwa);
            kama (usimbaji_wa_kigezo_unaotarajiwa == B1_USIMBAJI) { mkaguzi_funga_b1(a, 1); }
            idadi_ya_hoja = idadi_ya_hoja + 1;
            a = ijayo;
        }
        mkaguzi_ukubwa_wa_hoja = ukubwa_wa_hoja_zamani;
        // Kazi za pekee zisizosajiliwa (wito_wa_mfumo, tekeleza,
        // ukubwa, anwani_ya_kazi) -- angalia kikomo cha hoja zao.
        mkaguzi_kagua_kiwango_cha_huduma(jina, idadi_ya_hoja);
        // Angalia idadi ya hoja dhidi ya tangazo la kazi.
        n32 inatarajiwa = mkaguzi_tafuta_kazi(jina);
        kama (inatarajiwa >= 0) {
            kama (idadi_ya_hoja != inatarajiwa) {
                n32 ni_ya_kutofautiana = 0;
                kama (jina_linganisha(jina, "andika") || jina_linganisha(jina, "andika_stderr")) {
                    ni_ya_kutofautiana = 1;
                }
                // Kazi ya nje yenye `...`: hoja za ziada zinaruhusiwa
                n32 kigeni_k = kigeni_kazi_kwa_jina(jina);
                kama (kigeni_k >= 0) {
                    kama (kigeni_kazi_ya_ziada[kigeni_k] == 1 && idadi_ya_hoja > inatarajiwa) { ni_ya_kutofautiana = 1; }
                }
                kama (ni_ya_kutofautiana == 0) {
                    andika_stderr("kosa [%s]: idadi ya hoja kwa '%s' si sahihi (%d badala ya %d)\n",
                    mkaguzi_kazi_sasa, jina, idadi_ya_hoja, inatarajiwa);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                }
            }
            // Kikomo cha mzalishaji: hoja 16 (meza za paramu za
            // mzalishaji ni param_off/param_enc za 16). Hoja ya 17+
            // ilikubaliwa na kupotea KIMYA (mdudu wa 2026-09-01) --
            // kataa kwa sauti.
            kama (idadi_ya_hoja > 16) {
                andika_stderr("kosa [%s]: wito kwa '%s' una hoja nyingi mno (%d) -- kikomo ni 16\n",
                mkaguzi_kazi_sasa, jina, idadi_ya_hoja);
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
        }
        // Uthibitishaji wa kamba ya muundo kwa andika/andika_stderr
        // (hoja ya KWANZA ikitolewa kama halisi ya kamba): viungwa
        // vinavyofanya kazi ni %d, %s, %c, %% (asilimia halisi), na
        // \% (utorokaji wa asilimia). Vingine (k.m. %u, %x, %f, %l,
        // %n) vinakubaliwa kimya na mzalishaji na kutoa HAKUNA kitu --
        // kataa kwa sauti (uthibitisho-wa-lugha.md unaahidi %d %s %c
        // pekee).
        kama (jina_linganisha(jina, "andika") || jina_linganisha(jina, "andika_stderr")) {
            n32 a0 = nodi_ya_kulia[nodi_hii];
            kama (a0 != -1 && aina_ya_nodi[a0] == 5) {
                n8* umbo = ghala_la_majina + umbali_wa_jina_la_nodi[a0];
                kama (umbo[0] == 34) {  // nukuu ya mwanzo -- ni halisi ya kamba
                    n32 ml = 0;
                    wakati (umbo[ml] != 0) { ml = ml + 1; }
                    n32 mp = 1;  // baada ya nukuu ya mwanzo
                    wakati (mp < ml - 1) {
                        kama (umbo[mp] == 92 && umbo[mp + 1] == 37) {  // \%
                            mp = mp + 2;
                            endelea;
                        }
                        kama (umbo[mp] == 37) {  // '%'
                            n8 sp = umbo[mp + 1];
                            kama (sp == 100 || sp == 115 || sp == 99 || sp == 37) {
                                mp = mp + 2;
                                endelea;
                            }
                            andika_stderr("kosa [%s]: kipengele cha umbo %d hakitumiki (viungwa: asilimia, d, s, c)\n", mkaguzi_kazi_sasa, sp);
                            mkaguzi_makosa = mkaguzi_makosa + 1;
                            mp = mp + 2;
                            endelea;
                        }
                        mp = mp + 1;
                    }
                }
            }
        }
        // Wito kupitia kigezo (kielekezi cha kazi): jina ni kigeu cha
        // ndani/paramu (wigo) au cha ulimwengu -- si kazi iliyosajiliwa.
        // Hakuna saini ya kuthibitisha hoja dhidi yake; kikomo cha
        // mzalishaji (hoja 16) bado kinashikiliwa. Aina ya kigezo
        // lazima iweze kushika anwani ya kazi: kielekezi (mshale 1)
        // au namba ya upana 64 (n64/A64 -- hati 4.3). Nyingine
        // (n32, d64, miundo) ni kosa -- wito ungeita takataka.
        // Aina ya kurudi haijulikani (0) -- hupatikana hapa chini.
        kama (inatarajiwa < 0) {
            n32 usimbaji_wa_kigezo = wigo_tafuta(jina);
            kama (usimbaji_wa_kigezo == -1) {
                n32 g2 = 0;
                wakati (g2 < idadi_ya_vigeu_vya_ulimwengu) {
                    kama (jina_linganisha(ghala_la_majina_ya_ulimwengu + umbali_wa_jina_la_ulimwengu[g2], jina)) { usimbaji_wa_kigezo = aina_ya_ulimwengu[g2]; vunja; }
                    g2 = g2 + 1;
                }
            }
            kama (usimbaji_wa_kigezo != -1) {
                n32 ni_halali = 0;
                kama (mkaguzi_ni_kielekezi(usimbaji_wa_kigezo) == 1) { ni_halali = 1; }
                kama (ni_halali == 0) {
                    kama (usimbaji_wa_kigezo > 0) {
                        n32 fam2 = (usimbaji_wa_kigezo / 256) % 256;
                        n32 upana2 = usimbaji_wa_kigezo - (fam2 * 256);
                        kama (upana2 >= 64) {
                            kama (fam2 == 1) { ni_halali = 1; }
                            kama (fam2 == 2) { ni_halali = 1; }
                        }
                    }
                }
                kama (ni_halali == 0) {
                    andika_stderr("kosa [%s]: wito kupitia kigezo '%s': aina yake si kielekezi cha kazi (enc=%d)\n", mkaguzi_kazi_sasa, jina, usimbaji_wa_kigezo);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                }
                kama (idadi_ya_hoja > 16) {
                    andika_stderr("kosa [%s]: wito kupitia kigezo '%s' una hoja nyingi mno (%d) -- kikomo ni 16\n", mkaguzi_kazi_sasa, jina, idadi_ya_hoja);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                }
            }
        }
        // Tafuta aina ya kurudi kwa matumizi ya nafasi ya usemi
        n32 j = 0;
        wakati (j < idadi_ya_matokeo_ya_kazi) {
            n8* rj = ghala_la_majina_ya_kazi + umbali_wa_jina_la_matokeo_ya_kazi[j];
            kama (jina_linganisha(rj, jina)) { rudisha aina_ya_matokeo_ya_kazi[j]; }
            j = j + 1;
        }
    }
    rudisha 0;  // kazi ya nje -- aina haijulikani, inakubaliana na yoyote
}

w0 mkaguzi_kagua_kazi(n32 nodi_ya_kazi) {
    // MUHIMU: usajili wa saini (mkaguzi_sajili_kazi) HAUFANYIKI hapa
    // tena -- unafanyika mapema, kwenye pitio la pekee la usajili
    // ndani ya mkaguzi_angalia (angalia lugha-swa/swa#180), ili kazi
    // ZOTE zijulikane KABLA ya kukagua mwili wa kazi YOYOTE.
    // Fuatilia jina la kazi kwa ujumbe wa makosa
    mkaguzi_kazi_sasa = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kushoto[nodi_ya_kazi]];
    // Fuatilia aina ya kurudi kwa ukaguzi wa rudisha.
    usimbaji_wa_matokeo_ya_kazi = thamani_ya_nodi[nodi_ya_kazi];
    // Sukuma wigo wa kazi na usajili vigezo.
    wigo_sukuma();
    n32 p = nodi_ya_kulia[nodi_ya_kazi];
    wakati (p != -1) {
        n8* pjina = ghala_la_majina + umbali_wa_jina_la_nodi[p];
        n32 penc = thamani_ya_nodi[p];
        // w0 (familia 5, upana 0) ni aina ya kazi pekee -- kurudi bila
        // thamani. Kigezo cha w0 hakina thamani wala ukubwa; zamani
        // kilikubaliwa kimya (rekodi 8.3, hati 3: "W0 ni kwa kazi tu").
        // Kataa kwa sauti, kama w0 katika usemi inavyokataliwa.
        n32 pfam = (penc / 256) % 256;
        n32 pupana = penc - (pfam * 256);
        kama (pfam == 5) {
            kama (pupana == 0) {
                andika_stderr("kosa [%s]: kigezo '%s' cha w0 -- w0 ni kwa kazi tu\n", mkaguzi_kazi_sasa, pjina);
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
        }
        kama (penc == 0) { penc = thamani_ya_nodi[p]; }
        wigo_ongeza(pjina, penc);
        p = nodi_ya_kulia[p];
    }
    // Kagua mwili.
    n32 maudhui = tatu_ya_nodi[nodi_ya_kazi];
    kama (maudhui != -1) {
        mkaguzi_kagua_taarifa(maudhui);
    }
    wigo_toa();
}

w0 mkaguzi_kagua_taarifa(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha; }

    n32 aina = aina_ya_nodi[nodi_hii];

    kama (aina == 9) {  // KAMA
        mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
        wigo_sukuma();
        mkaguzi_kagua_taarifa(nodi_ya_kulia[nodi_hii]);
        wigo_toa();
        wigo_sukuma();
        mkaguzi_kagua_taarifa(tatu_ya_nodi[nodi_hii]);
        wigo_toa();
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 10) {  // WAKATI
        // Kwa kitanzi cha "kwa", ast_tiga ina taarifa ya anzisha.
        // Tangazo (n32 j = 0) lazima lisajiriwe kwenye wigo -- usemi
        // pekee hupitia mkaguzi_kagua_usemi. Zamani j haikujulikana
        // kwenye hatua na mwili (mkaguzi haukujali -- vitambulisho
        // visivyojulikana havikuwa makosa); ukaguzi wa kihifadhi
        // unategemea wigo kamili. MUHIMU: hii LAZIMA ifanyike KABLA
        // ya ast_kushoto (hali, mfano "j < 10") kukaguliwa -- vinginevyo
        // "j" bado haijasajiliwa wakati hali yenyewe inarejelea "j",
        // ikitoa kosa la uwongo "kitambulisho hakijafafanuliwa: j"
        // (pengo lililopatikana wakati wa uthibitisho wa ukaguzi mpya
        // wa kitambulisho-kisichofafanuliwa, 2026-09-26, issue #255).
        kama (tatu_ya_nodi[nodi_hii] != -1) {
            kama (aina_ya_nodi[tatu_ya_nodi[nodi_hii]] == 11) {
                mkaguzi_kagua_taarifa(tatu_ya_nodi[nodi_hii]);
            } sivyo {
                mkaguzi_kagua_usemi(tatu_ya_nodi[nodi_hii]);
            }
        }
        mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
        kina_cha_mzunguko = kina_cha_mzunguko + 1;
        wigo_sukuma();
        mkaguzi_kagua_taarifa(nodi_ya_kulia[nodi_hii]);
        wigo_toa();
        kina_cha_mzunguko = kina_cha_mzunguko - 1;
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 36) {  // SIVYO (mwili wa tawi la sivyo uko ast_kushoto)
        wigo_sukuma();
        mkaguzi_kagua_taarifa(nodi_ya_kushoto[nodi_hii]);
        wigo_toa();
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 15) {  // KIPINDI (kitanzi cha kwa)
        mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);  // anzisha
        mkaguzi_kagua_usemi(thamani_ya_nodi[nodi_hii]);  // hali
        mkaguzi_kagua_usemi(tatu_ya_nodi[nodi_hii]);  // hatua
        kina_cha_mzunguko = kina_cha_mzunguko + 1;
        wigo_sukuma();
        mkaguzi_kagua_taarifa(nodi_ya_kulia[nodi_hii]);  // mwili
        wigo_toa();
        kina_cha_mzunguko = kina_cha_mzunguko - 1;
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 14) {  // CHAGUA
        mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
        n32 h = nodi_ya_kulia[nodi_hii];
        wakati (h != -1) {
            // Lebo lazima iwe halisi ya nambari (chanya au hasi). Lebo
            // hasi ni toa-unari ya halisi. Kila kitu kingine (lebo ya
            // usemi, ya kigezo, wito) kinakataliwa kwa sauti -- C
            // inakataa lebo zisizo za kudumu (uthibitisho 19-21).
            n32 nodi_ya_hali = nodi_ya_kushoto[h];
            n32 ni_halisi = 0;
            kama (aina_ya_nodi[nodi_ya_hali] == 4) { ni_halisi = 1; }  // halisi chanya
            sivyo {
                kama (aina_ya_nodi[nodi_ya_hali] == 7) {  // toa-unari: -N
                    kama (nodi_ya_kushoto[nodi_ya_hali] == -1) {
                        kama (aina_ya_nodi[nodi_ya_kulia[nodi_ya_hali]] == 4) { ni_halisi = 1; }
                    }
                }
            }
            kama (ni_halisi == 0) {
                andika_stderr("kosa [%s]: lebo ya hali lazima iwe halisi ya nambari (chanya au hasi)\n", mkaguzi_kazi_sasa);
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
            wigo_sukuma();
            mkaguzi_kagua_taarifa(nodi_ya_kulia[h]);
            wigo_toa();
            h = nne_ya_nodi[h];
        }
        kama (tatu_ya_nodi[nodi_hii] != -1) {  // mwili wa sivyo (chaguo-msingi)
            wigo_sukuma();
            mkaguzi_kagua_taarifa(tatu_ya_nodi[nodi_hii]);
            wigo_toa();
        }
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 16) {  // VUNJA
        kama (kina_cha_mzunguko == 0) {
            andika_stderr("kosa: vunja nje ya kitanzi\n");
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 17) {  // ENDELEA
        kama (kina_cha_mzunguko == 0) {
            andika_stderr("kosa: endelea nje ya kitanzi\n");
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 50) {  // AST_BLOCK -- kifungio cha ndani (hatua ya kwa)
        mkaguzi_kagua_taarifa(nodi_ya_kushoto[nodi_hii]);
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 11) {  // TANGAZO (kigeu cha ndani)
        n32 nodi_ya_kigeu = nodi_ya_kushoto[nodi_hii];
        n32 usimbaji_wa_kigeu = thamani_ya_nodi[nodi_ya_kigeu];
        kama (usimbaji_wa_kigeu == 0) { usimbaji_wa_kigeu = thamani_ya_nodi[nodi_hii]; }
        // Safu ya ndani: usemi wa jina unaharibika hadi kielekezi (mshale +1)
        kama (tatu_ya_nodi[nodi_hii] > 0) { usimbaji_wa_kigeu = usimbaji_wa_kigeu + 1; }
        n8* jina_la_kigeu = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_kigeu];
        // Angalia tangazo rudufu katika wigo wa sasa
        kama (wigo_tafuta(jina_la_kigeu) >= 0) {
            andika_stderr("kosa: kigeu '%s' kimeshatangazwa\n", jina_la_kigeu);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        wigo_ongeza(jina_la_kigeu, usimbaji_wa_kigeu);
        n32 nodi_ya_kianzio = nodi_ya_kulia[nodi_hii];
        kama (nodi_ya_kianzio != -1) {
            // w0 chenye kianzio kinakataliwa kwa sauti (hati 3)
            mkaguzi_kataa_w0_chenye_kianzio(usimbaji_wa_kigeu, jina_la_kigeu);
            n32 usimbaji_wa_kianzio = mkaguzi_kagua_usemi(nodi_ya_kianzio);
            // Wito kupitia kielekezi kama kianzio cha d64 -- kataa (hati 4.3)
            mkaguzi_kataa_d64_kutoka_wito_wa_kigezo(nodi_ya_kianzio, usimbaji_wa_kigeu);
            // Angalia kama aina ya kianzio inalingana na aina ya tangazo
            // Aina za mtumiaji (muundo) ni hasi; tumia != 0 && != -1
            kama (usimbaji_wa_kianzio != 0 && usimbaji_wa_kianzio != -1 && usimbaji_wa_kigeu != 0) {
                kama (mkaguzi_aina_zifanane(usimbaji_wa_kigeu, usimbaji_wa_kianzio) == 0) {
                    kama (mkaguzi_mpaka_wa_desimali(usimbaji_wa_kigeu, usimbaji_wa_kianzio) == 0) {
                        andika_stderr("kosa [%s]: aina ya kianzio hailingani na tangazo la '%s' (tangazo=%d, kianzio=%d)\n", mkaguzi_kazi_sasa, jina_la_kigeu, usimbaji_wa_kigeu, usimbaji_wa_kianzio);
                        mkaguzi_makosa = mkaguzi_makosa + 1;
                    }
                }
            }
            kama (usimbaji_wa_kigeu == B1_USIMBAJI) { mkaguzi_funga_b1(nodi_ya_kianzio, 0); }
        }
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 37) {  // ASIMILIA (ugawaji)
        n32 kushoto_nodi = nodi_ya_kushoto[nodi_hii];
        n32 kulia_nodi = nodi_ya_kulia[nodi_hii];
        n32 kushoto_usimbaji = mkaguzi_kagua_usemi(kushoto_nodi);
        n32 kulia_usimbaji = mkaguzi_kagua_usemi(kulia_nodi);
        // Ugawaji unahitaji kihifadhi: kigeu, nyoosha, sehemu, au
        // kipengele cha safu. Matokeo ya wito, ternary, au oparesheni SI
        // kihifadhi -- kuyakubali kimya kunaacha no-op kwenye mzalishaji
        // (LHS hupuuzwa, RHS pekee hutathminiwa). Mbegu hukataa sawa
        // ("uwekaji usiotumika") -- weka mnyororo huu wenye mwendo uleule.
        n32 ni_lvalue = 0;
        kama (kushoto_nodi != -1) {
            n32 aina_l = aina_ya_nodi[kushoto_nodi];
            kama (aina_l == 5) {  // kitambulisho: lazima kiwe kigeu (wigo au ulimwengu)
                n8* jina_l = ghala_la_majina + umbali_wa_jina_la_nodi[kushoto_nodi];
                kama (wigo_tafuta(jina_l) != -1) { ni_lvalue = 1; }
                sivyo {
                    n32 g3 = 0;
                    wakati (g3 < idadi_ya_vigeu_vya_ulimwengu) {
                        kama (jina_linganisha(ghala_la_majina_ya_ulimwengu + umbali_wa_jina_la_ulimwengu[g3], jina_l)) { ni_lvalue = 1; vunja; }
                        g3 = g3 + 1;
                    }
                }
            }
            kama (aina_l == 29) { ni_lvalue = 1; }  // nyoosha / kipengele cha safu
            kama (aina_l == 33) { ni_lvalue = 1; }  // sehemu kwa nukta
            kama (aina_l == 34) { ni_lvalue = 1; }  // sehemu kwa mshale
        }
        kama (ni_lvalue == 0) {
            andika_stderr("kosa [%s]: ugawaji unahitaji kihifadhi (kigeu, nyoosha, sehemu, au kipengele cha safu)\n", mkaguzi_kazi_sasa);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        // Aina za mtumiaji zinaweza kuwa hasi
        kama (kushoto_usimbaji != 0 && kushoto_usimbaji != -1 && kulia_usimbaji != 0 && kulia_usimbaji != -1) {
            // Inaruhusu upanuzi/kupungua ndani ya familia moja;
            // mpaka wa kamili/desimali ni halali (C-semantiki)
            kama (mkaguzi_aina_zifanane(kushoto_usimbaji, kulia_usimbaji) == 0) {
                kama (mkaguzi_mpaka_wa_desimali(kushoto_usimbaji, kulia_usimbaji) == 0) {
                    andika_stderr("kosa [%s]: aina ya ugawaji hailingani (L=%d, R=%d)\n", mkaguzi_kazi_sasa, kushoto_usimbaji, kulia_usimbaji);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                }
            }
        }
        // Wito kupitia kielekezi kama thamani ya d64 -- kataa (hati 4.3)
        mkaguzi_kataa_d64_kutoka_wito_wa_kigezo(kulia_nodi, kushoto_usimbaji);
        kama (kushoto_usimbaji == B1_USIMBAJI) { mkaguzi_funga_b1(kulia_nodi, 0); }
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 19) {  // ACHILIA
        mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 8) {  // WITO (wito wa kazi)
        mkaguzi_kagua_wito(nodi_hii);
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }
    kama (aina == 3) {  // RUDISHA
        n32 nodi_ya_usemi = nodi_ya_kushoto[nodi_hii];
        kama (nodi_ya_usemi != -1) {
            n32 usimbaji_wa_matokeo = mkaguzi_kagua_usemi(nodi_ya_usemi);
            // Wito kupitia kielekezi kama kurudi ya kazi ya d64 -- kataa (hati 4.3)
            mkaguzi_kataa_d64_kutoka_wito_wa_kigezo(nodi_ya_usemi, usimbaji_wa_matokeo_ya_kazi);
            kama (usimbaji_wa_matokeo != 0 && usimbaji_wa_matokeo != -1 && usimbaji_wa_matokeo_ya_kazi != 0) {
                kama (mkaguzi_aina_zifanane(usimbaji_wa_matokeo, usimbaji_wa_matokeo_ya_kazi) == 0) {
                    kama (mkaguzi_mpaka_wa_desimali(usimbaji_wa_matokeo, usimbaji_wa_matokeo_ya_kazi) == 0) {
                        andika_stderr("kosa [%s]: aina ya kurudi hailingani na tangazo la kazi (ret=%d, tangazo=%d)\n", mkaguzi_kazi_sasa, usimbaji_wa_matokeo, usimbaji_wa_matokeo_ya_kazi);
                        mkaguzi_makosa = mkaguzi_makosa + 1;
                    }
                }
            }
            kama (usimbaji_wa_matokeo_ya_kazi == B1_USIMBAJI) { mkaguzi_funga_b1(nodi_ya_usemi, 0); }
        }
        mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
        rudisha;
    }

    // WITO na RUDISHA huitana ndugu kabla ya rudisha
    // Angalia juu.
    mkaguzi_kagua_taarifa(nne_ya_nodi[nodi_hii]);
}

n32 mkaguzi_kagua_usemi(n32 nodi_hii) {
    kama (nodi_hii == -1) { rudisha -1; }

    n32 aina = aina_ya_nodi[nodi_hii];

    // Halisi ya nambari kamili -- inafaa kwa aina yoyote (bila upana maalum).
    // Thamani iko ast_thamani; weka usimbaji wa chaguo-msingi (n32)
    // kwenye ast_nne kwa ukusanyaji wa hoja za wito (uzalishaji_wito
    // unasoma enc hapo -- si ast_thamani, ambayo ni thamani ya namba).
    kama (aina == 4) {
        // Alama ya n64 iko ast_kulia (ast_tiga ni kiungo cha mnyororo
        // wa hoja -- mkaguzi wa wito huiandika juu ya ast_tiga).
        kama (nodi_ya_kulia[nodi_hii] == 1) {
            nne_ya_nodi[nodi_hii] = 320;  // n64: familia 1, upana 64
        } sivyo {
            nne_ya_nodi[nodi_hii] = 288;  // n32: familia 1, upana 32
        }
        rudisha 0;  // "aina yoyote" -- haisababishi makosa ya utangamano
    }

    // Kitambulisho
    kama (aina == 5) {
        n8* jina = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_hii];
        n32 usimbaji = wigo_tafuta(jina);
        n32 imepatikana = wigo_ipo(jina);
        kama (imepatikana == 0) {
            // Angalia vigeu vya ulimwengu
            n32 g = 0;
            wakati (g < idadi_ya_vigeu_vya_ulimwengu) {
                n8* gj = ghala_la_majina_ya_ulimwengu + umbali_wa_jina_la_ulimwengu[g];
                kama (jina_linganisha(gj, jina)) { usimbaji = aina_ya_ulimwengu[g]; imepatikana = 1; vunja; }
                g = g + 1;
            }
        }
        kama (imepatikana == 0) {
            // Angalia majina ya kazi (viashiria vya kazi)
            n32 pc = mkaguzi_tafuta_kazi(jina);
            kama (pc >= 0) { usimbaji = 1; imepatikana = 1; }  // kiashiria cha kazi
        }
        // Jina halisi halipatikani mahali popote (wigo, kigezo cha
        // ulimwengu, jina la kazi) -- kosa la sauti, si kupitishwa kimya
        // kama "aina yoyote" (-1). Bila hii, kwa mfano jina la aina
        // (n32, d64 n.k.) likitumika kama usemi likiwa halijaguswa na
        // ukubwa(...) linapita kimya likiwa halina athari (angalia
        // lugha-swa/swa issue #255) -- ISIPOKUWA lina ujumbe wa kirafiki
        // zaidi kama linafanana na jina la aina la msingi.
        //
        // MUHIMU: halisi za kamba (string literals) NAZO ni nodi za
        // AST_KITAMBULISHO (angalia changanua_primary, TOKENI_MFUATANO) --
        // maandishi yaliyohifadhiwa YANAJUMUISHA alama za kunukuu
        // zenyewe (jina[0] == '"'), kwa hiyo KAMWE hayatapatikana kwenye
        // wigo/kigezo/jina la kazi (si kusudio lao) -- lazima yaruke
        // ukaguzi huu kabisa, si kutibiwa kama kitambulisho kisichopo.
        // Vivyo hivyo hoja ya ukubwa(...) (mkaguzi_ukubwa_hoja) -- ni
        // jina la aina/muundo kimakusudi, si kigezo halisi.
        kama (imepatikana == 0 && jina[0] != 34 && mkaguzi_ukubwa_wa_hoja == 0) {
            n32 jlen = 0;
            wakati (jina[jlen] != 0) { jlen = jlen + 1; }
            kama (ni_aina_msingi_pia_ndogo(jina, jlen)) {
                andika_stderr("kosa [%s]: jina la aina halitumiki kama usemi: %s\n", mkaguzi_kazi_sasa, jina);
            } sivyo {
                andika_stderr("kosa [%s]: kitambulisho hakijafafanuliwa: %s\n", mkaguzi_kazi_sasa, jina);
            }
            mkaguzi_makosa = mkaguzi_makosa + 1;
            usimbaji = -1;
        }
        // Hifadhi usimbaji kwenye nodi -- uzalishaji wa wito unausoma
        // kwa hoja za kigeu (rejeleo jipya la KITAMBULISHO lina thamani 0)
        thamani_ya_nodi[nodi_hii] = usimbaji;
        rudisha usimbaji;
    }

    // Ternary (hali ? kweli : uwongo)
    kama (aina == 45) {  // AST_HALISI_D -- desimali halisi (d64)
        // ast_thamani/tiga hubeba baiti za thamani; enc inawekwa ast_nne
        // kwa matumizi ya ukusanyaji wa hoja za wito.
        nne_ya_nodi[nodi_hii] = 832;
        rudisha 832;  // d64: familia 3, upana 64
    }

    kama (aina == 44) {  // AST_TERNARY
        mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);  // hali
        n32 true_usimbaji = mkaguzi_kagua_usemi(nodi_ya_kulia[nodi_hii]);  // tawi la kweli
        // Tawi la uwongo liko ast_nne -- ast_tiga hubeba kiungo cha hoja
        // cha mnyororo wa wito (mchanganuzi/mkaguzi huiandika).
        n32 false_usimbaji = mkaguzi_kagua_usemi(nne_ya_nodi[nodi_hii]);  // tawi la uwongo
        // Halisi kamili inarudisha 0 ("aina yoyote") -- enc halisi iko
        // ast_nne; iresolvi kwa mpaka wa desimali.
        kama (aina_ya_nodi[nodi_ya_kulia[nodi_hii]] == 4) { true_usimbaji = nne_ya_nodi[nodi_ya_kulia[nodi_hii]]; }
        kama (aina_ya_nodi[nne_ya_nodi[nodi_hii]] == 4) { false_usimbaji = nne_ya_nodi[nne_ya_nodi[nodi_hii]]; }
        // Angalia utangamano kati ya matawi
        kama (true_usimbaji != 0 && true_usimbaji != -1 && false_usimbaji != 0 && false_usimbaji != -1) {
            kama (mkaguzi_aina_zifanane(true_usimbaji, false_usimbaji) == 0) {
                kama (mkaguzi_mpaka_wa_desimali(true_usimbaji, false_usimbaji) == 0) {
                    andika_stderr("kosa [%s]: aina za matawi ya ternary haziendani (kweli=%d, uwongo=%d)\n",
                    mkaguzi_kazi_sasa, true_usimbaji, false_usimbaji);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                } sivyo {
                    // PANDISHA YA C: desimali inashinda nambari kamili
                    kama (ni_desimali_usimbaji(false_usimbaji)) { true_usimbaji = false_usimbaji; }
                }
            }
        }
        // Hifadhi encoding kwa mzalishaji; ukubwa hukokotolewa kutoka enc.
        thamani_ya_nodi[nodi_hii] = true_usimbaji;
        rudisha true_usimbaji;
    }

    // TOFAUTI ya unari (kukanusha): -x
    // Hushughulikiwa kabla ya oparesheni jozi -- vinginevyo mzalishaji
    // angechukua njia ya 64-bit kwa thamani ya 32-bit.
    kama (aina == 7) {
        kama (nodi_ya_kushoto[nodi_hii] == -1) {
            n32 kitendo = mkaguzi_kagua_usemi(nodi_ya_kulia[nodi_hii]);
            // Halisi kamili inarudisha 0 ("aina yoyote") -- enc halisi
            // iko ast_nne. Iihifadhi ili kukanusha kwa upana sahihi
            // (-10000000000 inahitaji ukanushaji wa 64-bit; -90 wa 32).
            kama (aina_ya_nodi[nodi_ya_kulia[nodi_hii]] == 4) { kitendo = nne_ya_nodi[nodi_ya_kulia[nodi_hii]]; }
            kama (mkaguzi_ni_biti(kitendo)) {
                andika_stderr("kosa [%s]: kukanusha (-x) hakufai kwa mifumo ya biti (familia b) -- tumia ~x\n", mkaguzi_kazi_sasa);
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
            thamani_ya_nodi[nodi_hii] = kitendo;
            rudisha kitendo;
        }
    }

    // Oparesheni jozi -- angalia utangamano wa aina za operesheni
    n32 ni_binary = 0;
    kama (aina >= 6) { kama (aina <= 25) { ni_binary = 1; } }
    kama (aina >= 31) { kama (aina <= 32) { ni_binary = 1; } }
    kama (aina >= 39) { kama (aina <= 43) { ni_binary = 1; } }
    kama (aina == 8) { ni_binary = 0; }  // WITO limehudumiwa tofauti hapo juu
    kama (aina == 44) { ni_binary = 0; }  // TERNARY sio oparesheni jozi
    kama (aina == 49) { ni_binary = 1; }  // AST_MODULO
    kama (aina == 46) { ni_binary = 1; }  // AST_XOR (^)
    kama (ni_binary) {
        n32 kushoto = mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
        n32 kulia = mkaguzi_kagua_usemi(nodi_ya_kulia[nodi_hii]);
        kama (kushoto != 0 && kushoto != -1) {
            kama (kulia != 0 && kulia != -1) {
                // Angalia upatanifu wa aina za operesheni; mpaka wa
                // kamili/desimali ni halali (C-semantiki ya pandisha).
                // << na >>: operandi ya kulia ni IDADI ya biti za
                // kuhamisha, si thamani ya aina ya kushoto -- namba
                // kamili yoyote (n, a, b) inafaa (b8 << n32).
                n32 ni_idadi_ya_kuhamisha = 0;
                kama (aina == 39 || aina == 41) {
                    kama (kulia > 0 && kulia % 4 == 0) {
                        n32 fam_r = (kulia / 256) % 256;
                        kama (fam_r == 1 || fam_r == 2 || fam_r == 4) { ni_idadi_ya_kuhamisha = 1; }
                    }
                }
                kama (mkaguzi_aina_zifanane(kushoto, kulia) == 0 && ni_idadi_ya_kuhamisha == 0) {
                    kama (mkaguzi_mpaka_wa_desimali(kushoto, kulia) == 0) {
                        andika_stderr("kosa [%s]: aina haziendani kwenye operesheni (l=%d, r=%d)\n", mkaguzi_kazi_sasa, kushoto, kulia);
                        mkaguzi_makosa = mkaguzi_makosa + 1;
                    }
                }
            }
        }
        // Ukubwa wa matokeo hukokotolewa na mzalishaji kutoka enc
        // (ukubwa_kutoka_enc) -- si ast_tiga, kwani mkaguzi wa wito
        // huandika kiungo cha mnyororo wa hoja juu ya ast_tiga.
        // Hifadhi encoding kamili kwa mzalishaji (kwa kutofautisha N/D/B/W)
        //
        // PANDISHA: operesheni yenye upana mchanganyiko ndani ya familia
        // moja inachukua upana MKUBWA (C-semantiki) -- 0 - 10000000000
        // ni n64, si n32 (mende: ilikuwa ikikatwa hadi biti 32).
        // Halisi kamili inarudisha 0 ("aina yoyote") -- enc halisi iko
        // ast_nne; d64 inarudisha enc yake yenyewe (832).
        n32 kushoto_usimbaji = kushoto;
        kama (aina_ya_nodi[nodi_ya_kushoto[nodi_hii]] == 4) { kushoto_usimbaji = nne_ya_nodi[nodi_ya_kushoto[nodi_hii]]; }
        n32 kulia_usimbaji = kulia;
        kama (aina_ya_nodi[nodi_ya_kulia[nodi_hii]] == 4) { kulia_usimbaji = nne_ya_nodi[nodi_ya_kulia[nodi_hii]]; }
        n32 usimbaji_ya_kitendo = kushoto_usimbaji;
        kama (kushoto_usimbaji > 0) {
            kama (kulia_usimbaji > 0) {
                // Hesabu ya anwani (C-semantiki): kielekezi + namba ->
                // kielekezi. Zamani biti ya mshale ilipotea hapa
                // (ast_pool + off ilikadiriwa n32) na hoja ya kielekezi
                // kwa kigezo cha n8* ilipita kama namba (mdudu wa
                // 2026-09-01). Mshale iko kwenye biti 0-1 za enc.
                n32 kushoto_mshale = kushoto_usimbaji - ((kushoto_usimbaji / 4) * 4);
                n32 kulia_mshale = kulia_usimbaji - ((kulia_usimbaji / 4) * 4);
                kama (kushoto_mshale != kulia_mshale) {
                    kama (kushoto_mshale != 0) { usimbaji_ya_kitendo = kushoto_usimbaji; }
                    sivyo { usimbaji_ya_kitendo = kulia_usimbaji; }
                } sivyo {
                    kama ((kushoto_usimbaji / 256) % 256 == (kulia_usimbaji / 256) % 256) {
                        kama (ukubwa_kutoka_usimbaji(kulia_usimbaji) > ukubwa_kutoka_usimbaji(kushoto_usimbaji)) { usimbaji_ya_kitendo = kulia_usimbaji; }
                    } sivyo {
                        // PANDISHA YA C: familia zikitofautiana na moja ni
                        // desimali, operesheni nzima inapandishwa hadi
                        // desimali (1 + 2.5 ni d64, si n32).
                        kama (ni_desimali_usimbaji(kushoto_usimbaji)) { usimbaji_ya_kitendo = kushoto_usimbaji; }
                        sivyo { kama (ni_desimali_usimbaji(kulia_usimbaji)) { usimbaji_ya_kitendo = kulia_usimbaji; } }
                    }
                }
            }
        }
        // Hesabu ya anwani ya kielekezi (C-semantiki): p + n na p - n
        // pekee ndizo halali. p + p, p - p (delta ghafi ya baiti --
        // haijaelezwa kwenye hati) na n - p hazina maana; zamani
        // zilihesabu baiti kimya (rekodi 8.9). Kataa kwa sauti.
        kama (aina == 6 || aina == 7) {
            n32 lk = mkaguzi_ni_kielekezi(kushoto_usimbaji);
            n32 rk = mkaguzi_ni_kielekezi(kulia_usimbaji);
            kama (lk == 1) {
                kama (rk == 1) {
                    andika_stderr("kosa [%s]: kielekezi kwa kielekezi kwenye hesabu (l=%d, r=%d)\n", mkaguzi_kazi_sasa, kushoto_usimbaji, kulia_usimbaji);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                }
            }
            kama (aina == 7) {
                kama (lk == 0) {
                    kama (rk == 1) {
                        andika_stderr("kosa [%s]: namba toa kielekezi haina maana (l=%d, r=%d)\n", mkaguzi_kazi_sasa, kushoto_usimbaji, kulia_usimbaji);
                        mkaguzi_makosa = mkaguzi_makosa + 1;
                    }
                }
            }
        }
        // Modulo ya kielekezi inakataliwa kwa sauti (rekodi 8.9)
        mkaguzi_kataa_modulo_ya_kielekezi(aina, kushoto_usimbaji, kulia_usimbaji);
        // Familia b ni mifumo ya biti: hesabu (+ - * / %) na mpangilio
        // (< > <= >=) hazina maana kwa biti -- kataa kwa sauti.
        kama (aina == 6 || aina == 7 || aina == 31 || aina == 32 || aina == 49 || (aina >= 22 && aina <= 25)) {
            kama (mkaguzi_ni_biti(kushoto_usimbaji) || mkaguzi_ni_biti(kulia_usimbaji)) {
                andika_stderr("kosa [%s]: oparesheni hii haifai kwa mifumo ya biti (familia b) -- tumia & | ^ ~ << >> == !=\n", mkaguzi_kazi_sasa);
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
        }
        thamani_ya_nodi[nodi_hii] = usimbaji_ya_kitendo;
        // b1 << n inaweza kuweka biti juu ya biti 0 -- ibaki biti moja.
        kama (aina == 39 && usimbaji_ya_kitendo == B1_USIMBAJI) { mkaguzi_funga_b1(nodi_hii, 1); }
        // Ulinganishi (20-25: == != < > <= >=): ast_thamani hubaki aina
        // ya OPERANDI -- mzalishaji huisoma kuchagua upana wa cmp
        // (cmp ya 64 kwa n64/kielekezi, ucomisd kwa d64). Lakini aina
        // ya MATOKEO ni n32 (0 au 1) daima. Zamani enc ya operandi
        // ilirudishwa kwa mpigaji: f(k != 0) ambapo k ni muundo*
        // ilikataliwa kama "kielekezi dhidi ya namba" (#296).
        kama (aina >= 20 && aina <= 25) { rudisha 288; }
        rudisha usimbaji_ya_kitendo;
    }

    // Wito wa kazi
    kama (aina == 8) {
        // Kagua hoja zote za wito -- aina NA idadi -- hata kama wito uko
        // katika nafasi ya usemi. Pia rudisha aina ya kurudi ya wito.
        n32 usimbaji_wa_matokeo = mkaguzi_kagua_wito(nodi_hii);
        // Hifadhi enc ya kurudi kwenye nodi -- mzalishaji wa wito
        // anaisoma kwa hoja za wito mwingine. Bila hii, hoja inayoleta
        // wito wa muundo (sret) ingeonekana kama aina isiyojulikana (0)
        // na kielekezi cha bafa ya sret kikapitishwa kwa thamani --
        // takataka kwa muundo wa baiti 5-8 (na bafa kuharibika kwa
        // muundo mkubwa zaidi).
        thamani_ya_nodi[nodi_hii] = usimbaji_wa_matokeo;
        rudisha usimbaji_wa_matokeo;
    }

    // Oparesheni unari
    kama (aina == 7) {  // TOFAUTI (kukanusha)
        n32 kitendo = mkaguzi_kagua_usemi(nodi_ya_kulia[nodi_hii]);
        rudisha kitendo;
    }
    kama (aina == 30) {  // KUMBUKA (anwani-ya)
        n32 usimbaji_wa_ndani = mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
        // Weka biti ya kielekezi (mshale=1) -- tumia |1 badala ya &254|1
        // kwa sababu aina za mtumiaji (muundo) zina encoding hasi, na
        // &254 huharibu biti za juu kwenye namba hasi.
        kama (usimbaji_wa_ndani != 0 && usimbaji_wa_ndani != -1) { kama ((usimbaji_wa_ndani / 2) * 2 == usimbaji_wa_ndani) { rudisha usimbaji_wa_ndani + 1; } rudisha usimbaji_wa_ndani; }
        rudisha 1;  // kielekezi cha aina isiyojulikana
    }
    kama (aina == 28) {  // SI (!)
        n32 kitendo = mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
        // Halisi kamili inarudisha 0 ("aina yoyote") -- enc halisi iko
        // ast_nne. Iisome ili upana wa matokeo usikose (0 - 10000000000
        // inahitaji upana wa 64; ~0 kwenye n64 vilevile).
        kama (aina_ya_nodi[nodi_ya_kushoto[nodi_hii]] == 4) { kitendo = nne_ya_nodi[nodi_ya_kushoto[nodi_hii]]; }
        // ! kwa desimali haijatekelezwa -- kataa kwa sauti badala ya
        // kutoa jibu la takataka (thamani ya d64 iko xmm0, si eax).
        kama (ni_desimali_usimbaji(kitendo)) {
            andika_stderr("kosa [%s]: kiambishi ! hakikubaliki kwa desimali\n", mkaguzi_kazi_sasa);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        // Matokeo ni 1 au 0 kwa aina ya operesheni (kama && na ||)
        // -- si B1, ili ugawaji kwa n32 ufanye kazi.
        thamani_ya_nodi[nodi_hii] = kitendo;
        rudisha kitendo;
    }
    kama (aina == 47) {  // KINYUME (~)
        n32 kitendo = mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
        // Halisi kamili inarudisha 0 ("aina yoyote") -- enc halisi iko
        // ast_nne. Iisome ili upana wa matokeo usikose.
        kama (aina_ya_nodi[nodi_ya_kushoto[nodi_hii]] == 4) { kitendo = nne_ya_nodi[nodi_ya_kushoto[nodi_hii]]; }
        // ~ kwa desimali haijatekelezwa -- kataa kwa sauti.
        kama (ni_desimali_usimbaji(kitendo)) {
            andika_stderr("kosa [%s]: kiambishi ~ hakikubaliki kwa desimali\n", mkaguzi_kazi_sasa);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        // Matokeo yana upana uleule wa operesheni. ~ ya b1 ingegeuza
        // biti zote za baiti -- ibaki biti moja.
        thamani_ya_nodi[nodi_hii] = kitendo;
        kama (kitendo == B1_USIMBAJI) { mkaguzi_funga_b1(nodi_hii, 1); }
        rudisha kitendo;
    }

    // Halisi ya kamba
    kama (aina == 40) {
        rudisha 1;  // kielekezi (n8*)
    }

    // Safu halisi {a, b, c}
    kama (aina == 38) {  // AST_SAFU
        n32 kipengele = nodi_ya_kushoto[nodi_hii];
        wakati (kipengele != -1) {
            mkaguzi_kagua_usemi(kipengele);
            kipengele = nne_ya_nodi[kipengele];
        }
        rudisha 1;  // kielekezi (safu inaharibika hadi kielekezi)
    }

    // Faharasa ya safu
    kama (aina == 29) {  // TAJA
        n32 base = mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
        mkaguzi_kagua_usemi(nodi_ya_kulia[nodi_hii]);
        // Ondoa mshale MMOJA kupata aina ya kipengele.
        // Biti za mshale kwenye upana: 1 = mshale, 2 = mshale wa pili
        // (inayotokana na uporomokaji wa safu), 3 = yote mawili.
        // n8* (9) -> n8 (8); n8** (11) -> n8* (9).
        // Tumia hesabu ya / na % (mbegu ina hitilafu katika & na |).
        n32 base_no_kielekezi = base;
        kama (base > 0) {
            n32 familia_b = (base / 256) % 256;
            n32 upana = base - (familia_b * 256);
            n32 mb = upana - ((upana / 4) * 4);
            kama (mb == 3) { base_no_kielekezi = base - 2; }
            sivyo { kama (mb == 1 || mb == 2) { base_no_kielekezi = base - 1; } }
        }
        // Hifadhi enc ya matokeo; ukubwa wa elementi hukokotolewa na
        // mzalishaji kutoka enc (ast_tiga ya hoja huandikwa na kiungo
        // cha mnyororo wa wito).
        thamani_ya_nodi[nodi_hii] = base_no_kielekezi;
        rudisha base_no_kielekezi;
    }

    // Ufikiaji wa sehemu ya muundo
    kama (aina == 33) {  // SEHEMU_DOT
        n32 base_usimbaji = mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
        n32 nodi_ya_sehemu = nodi_ya_kulia[nodi_hii];
        n8* jina_la_sehemu = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_sehemu];
        // Kama msingi ni muundo maalum, tafuta tu ndani ya muundo huo
        n8* jina_la_muundo = 0;
        kama (base_usimbaji < 0) {
            n32 name_umbali = ((-base_usimbaji) / 2) - 1;
            kama ((base_usimbaji / 2) * 2 != base_usimbaji) { name_umbali = name_umbali + 1; }  // mshale huhamisha -1
            jina_la_muundo = ghala_la_majina + name_umbali;
        }
        // Tafuta sehemu kwenye miundo iliyosajiliwa (akiba)
        n32 mi = 0;
        wakati (mi < idadi_ya_miundo) {
            kama (jina_la_muundo != 0) {
                n32 mn = nodi_ya_kushoto[nodi_ya_muundo[mi]];
                kama (jina_linganisha(ghala_la_majina + umbali_wa_jina_la_nodi[mn], jina_la_muundo) == 0) {
                    mi = mi + 1;
                    endelea;
                }
            }
            n32 kazi_hii = nodi_ya_kulia[nodi_ya_muundo[mi]];
            wakati (kazi_hii != -1) {
                n32 fname_nodi = nodi_ya_kushoto[kazi_hii];
                n8* jina_la_kazi = ghala_la_majina + umbali_wa_jina_la_nodi[fname_nodi];
                n32 umbali_kwenye_faili = tatu_ya_nodi[fname_nodi];
                kama (jina_linganisha(jina_la_kazi, jina_la_sehemu)) {
                    nne_ya_nodi[nodi_hii] = umbali_kwenye_faili;  // hifadhi ofseti (si ast_tiga -- hoja za wito huiandika)
                    n32 fenc = thamani_ya_nodi[fname_nodi];
                    kama (fenc != 0) { thamani_ya_nodi[nodi_hii] = fenc; rudisha fenc; }
                    thamani_ya_nodi[nodi_hii] = (1 << 8) | 32;
                    rudisha (1 << 8) | 32;
                }
                kazi_hii = nodi_ya_kulia[kazi_hii];
            }
            mi = mi + 1;
        }
        thamani_ya_nodi[nodi_hii] = (1 << 8) | 32;  // haikupatikana -- i32 chaguo-msingi
        rudisha (1 << 8) | 32;
    }
    kama (aina == 34) {  // SEHEMU_MSHALE
        n32 base_usimbaji2 = mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
        n32 nodi_ya_sehemu = nodi_ya_kulia[nodi_hii];
        n8* jina_la_sehemu = ghala_la_majina + umbali_wa_jina_la_nodi[nodi_ya_sehemu];
        // Kama msingi ni kielekezi cha muundo maalum, tafuta tu ndani yake
        n8* muundo_jina2 = 0;
        kama (base_usimbaji2 < 0) {
            n32 name_ofseti2 = ((-base_usimbaji2) / 2) - 1;
            kama ((base_usimbaji2 / 2) * 2 != base_usimbaji2) { name_ofseti2 = name_ofseti2 + 1; }  // mshale huhamisha -1
            muundo_jina2 = ghala_la_majina + name_ofseti2;

        }
        n32 mi = 0;
        wakati (mi < idadi_ya_miundo) {
            kama (muundo_jina2 != 0) {
                n32 mn2 = nodi_ya_kushoto[nodi_ya_muundo[mi]];
                kama (jina_linganisha(ghala_la_majina + umbali_wa_jina_la_nodi[mn2], muundo_jina2) == 0) {
                    mi = mi + 1;
                    endelea;
                }
            }
            n32 kazi_hii = nodi_ya_kulia[nodi_ya_muundo[mi]];
            wakati (kazi_hii != -1) {
                n32 fname_nodi = nodi_ya_kushoto[kazi_hii];
                n8* jina_la_kazi = ghala_la_majina + umbali_wa_jina_la_nodi[fname_nodi];
                kama (jina_linganisha(jina_la_kazi, jina_la_sehemu)) {
                    nne_ya_nodi[nodi_hii] = tatu_ya_nodi[fname_nodi];  // hifadhi ofseti (si ast_tiga -- hoja za wito huiandika)
                    n32 fenc = thamani_ya_nodi[fname_nodi];
                    kama (fenc != 0) { thamani_ya_nodi[nodi_hii] = fenc; rudisha fenc; }
                    thamani_ya_nodi[nodi_hii] = (1 << 8) | 32;
                    rudisha (1 << 8) | 32;
                }
                kazi_hii = nodi_ya_kulia[kazi_hii];
            }
            mi = mi + 1;
        }
        thamani_ya_nodi[nodi_hii] = (1 << 8) | 32;
        rudisha (1 << 8) | 32;
    }

    // badili(ptr, size) -- panua/kaza kumbukumbu
    kama (aina == 48) {  // AST_BADILI
        mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);  // kielekezi
        mkaguzi_kagua_usemi(nodi_ya_kulia[nodi_hii]);  // ukubwa
        rudisha 1;  // kielekezi
    }

    // Chaguo-msingi: tembea watoto na rudisha haijulikani
    mkaguzi_kagua_usemi(nodi_ya_kushoto[nodi_hii]);
    mkaguzi_kagua_usemi(nodi_ya_kulia[nodi_hii]);
    mkaguzi_kagua_usemi(tatu_ya_nodi[nodi_hii]);
    rudisha -1;
}
