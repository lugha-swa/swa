husisha { mkusanyaji/msambazaji.swa }
husisha { mkusanyaji/uzalishaji.swa }

// ==========================================================
// mkaguzi.swa -- mkaguzi wa semantiki (hatua muhimu ya 5 ya kujitegemea)
// Huangalia ukiukaji wa umiliki, kutolingana kwa idadi ya hoja,
// na makosa mengine ya semantiki kwenye AST iliyochambuliwa.
// ==========================================================

n32 mkaguzi_makosa = 0;

// Jina la kazi inayokaguliwa sasa (kwa ujumbe wa makosa)
n8* mkaguzi_kazi_sasa;

// Ufuatiliaji wa wigo kwa matamko ya vigeu
n32 wigo_jina_off[256];
n32 wigo_aina_enc[256];
n32 wigo_idadi = 0;
// Fahirisi za mwanzo za wigo kwa sukuma/toa. Kikomo cha zamani (16)
// kilifurika kwenye upachikaji wa kina (kila sivyo husukuma mara
// mbili: KAMA kisha SIVYO) — wigo_toa ilirejesha wigo_idadi kwa
// nafasi isiyo sahihi na vigeu vikaonekana kutokuwepo (mkaguzi
// wa zamani haukujali — vitambulisho visivyojulikana havikuwa
// makosa; ukaguzi wa kihifadhi unategemea wigo kamili).
n32 wigo_vidokezo[256];
n32 wigo_vidokezo_idadi = 0;

// Kina cha kitanzi kwa ukaguzi wa muktadha wa vunja/endelea
n32 kitanzi_kina = 0;

// Aina ya sasa ya kurudi ya kazi (kwa ukaguzi wa rudisha)
n32 kazi_ret_enc = 0;

w0 wigo_sukuma() {
    kama (wigo_vidokezo_idadi < 256) {
        wigo_vidokezo[wigo_vidokezo_idadi] = wigo_idadi;
        wigo_vidokezo_idadi = wigo_vidokezo_idadi + 1;
    } sivyo {
        andika_stderr("KOSA: kina cha kitanzi/tawi (wigo_vidokezo) kimejaa (kikomo 256) — kazi ina viwango vingi mno vya kutagusana vya {}\n");
        mkaguzi_makosa = mkaguzi_makosa + 1;
    }
}

w0 wigo_toa() {
    kama (wigo_vidokezo_idadi > 0) {
        wigo_vidokezo_idadi = wigo_vidokezo_idadi - 1;
        wigo_idadi = wigo_vidokezo[wigo_vidokezo_idadi];
    }
}

w0 wigo_ongeza(n8* jina, n32 enc) {
    kama (wigo_idadi < 256) {
        wigo_jina_off[wigo_idadi] = ast_pool_wapi;
        wigo_aina_enc[wigo_idadi] = enc;
        n32 i = 0;
        wakati (jina[i] != 0) {
            ast_pool[ast_pool_wapi + i] = jina[i];
            i = i + 1;
        }
        ast_pool[ast_pool_wapi + i] = 0;
        ast_pool_wapi = ast_pool_wapi + i + 1;
        wigo_idadi = wigo_idadi + 1;
    } sivyo {
        andika_stderr("KOSA: jedwali la vigezo vya wigo (wigo_idadi) limejaa (kikomo 256) kwenye kigezo '%s' — kazi ina vigezo/vitambulisho vingi mno vinavyoonekana kwa wakati mmoja\n", jina);
        mkaguzi_makosa = mkaguzi_makosa + 1;
    }
}

n32 wigo_tafuta(n8* jina) {
    n32 i = wigo_idadi - 1;
    wakati (i >= 0) {
        n8* wj = ast_pool + wigo_jina_off[i];
        kama (jina_linganisha(wj, jina)) { rudisha wigo_aina_enc[i]; }
        i = i - 1;
    }
    rudisha -1;
}

// Sawa na wigo_tafuta, lakini inarudisha UWEPO TU (1/0), si usimbaji
// wa aina. MUHIMU: wigo_tafuta HAIWEZI kutumika peke yake kuamua kama
// kitambulisho "kimepatikana" -- kigezo halisi kilichopo kwenye wigo
// kinaweza kuwa na usimbaji -1 lenyewe (aina isiyojulikana/wildcard,
// mfano kigezo kutoka usemi wa halisi kamili), sawa kabisa na thamani
// inayorudishwa kwa "hakijapatikana". Kazi hii inaondoa utata huo --
// angalia mkaguzi_kagua_usemi, kesi ya AST_KITAMBULISHO.
n32 wigo_ipo(n8* jina) {
    n32 i = wigo_idadi - 1;
    wakati (i >= 0) {
        n8* wj = ast_pool + wigo_jina_off[i];
        kama (jina_linganisha(wj, jina)) { rudisha 1; }
        i = i - 1;
    }
    rudisha 0;
}

// Kielekezi? Rudisha 1 kwa kielekezi, 0 kwa thamani, -1 kwa
// aina isiyojulikana (0/-1). Kielekezi: enc chanya yenye biti ya
// mshale (isiyo sawa), au enc hasi isiyo sawa (kielekezi cha
// muundo). Thamani: enc chanya iliyo sawa, au enc hasi iliyo
// sawa (muundo kwa thamani).
n32 mkaguzi_ni_kielekezi(n32 enc) {
    kama (enc == 0 || enc == -1) { rudisha -1; }
    kama ((enc / 2) * 2 != enc) { rudisha 1; }
    rudisha 0;
}

// Linganisha aina kwa ukaguzi: familia lazima zilingane.
// Upana na biti za mshale zinaweza kutofautiana — maktaba huchanganya
// n8/n16/n32/n64 na kielekezi+n32 (hesabu ya anwani: ast_pool + off)
// kwa hiari, na mzalishaji hutoa upana sahihi kila mahali.
// enc hasi = muundo au kielekezi cha muundo (zote zina familia maalum).
n32 mkaguzi_aina_zifanane(n32 a, n32 b) {
    kama (a == 0 || b == 0 || a == -1 || b == -1) { rudisha 1; }
    kama (a < 0 || b < 0) {
        kama (a < 0 && b < 0) { rudisha 1; }
        // Kielekezi cha muundo (hasi odd) dhidi ya kielekezi wa kawaida:
        // teng a() inarudisha n8* na hupewa muundo* — mchanganyiko halali
        // wa kielekezi. Muundo wenyewe (hasi hata) dhidi ya kielekezi si sawa.
        kama (a < 0) {
            kama ((a / 2) * 2 != a) { rudisha 1; }  // a ni kielekezi cha muundo
            rudisha 0;
        }
        kama ((b / 2) * 2 != b) { rudisha 1; }  // b ni kielekezi cha muundo
        rudisha 0;
    }
    n32 fa = (a / 256) % 256;
    n32 fb = (b / 256) % 256;
    kama (fa == 0 || fb == 0) { rudisha 1; }  // aina isiyojulikana
    rudisha fa == fb;
}

// Mpaka wa kamili/desimali (C-semantiki ya pandisha): desimali
// (familia 3) na nambari kamili yenye ishara/bila ishara (familia
// 1/2) zinachanganyika kwa hiari — operesheni inapandishwa hadi
// d64/D32 na mzalishaji. Rudisha 1 ikiwa zinaweza kuchanganyika.
n32 mkaguzi_mpaka_wa_desimali(n32 a, n32 b) {
    kama (a == 0) { rudisha 0; }
    kama (b == 0) { rudisha 0; }
    kama (a == -1) { rudisha 0; }
    kama (b == -1) { rudisha 0; }
    kama (a < 0) { rudisha 0; }  // miundo — mpaka hautumiki
    kama (b < 0) { rudisha 0; }
    n32 fa = (a / 256) % 256;
    n32 fb = (b / 256) % 256;
    kama (fa == 3) {
        kama (fb == 1) { rudisha 1; }
        kama (fb == 2) { rudisha 1; }
        rudisha 0;
    }
    kama (fb == 3) {
        kama (fa == 1) { rudisha 1; }
        kama (fa == 2) { rudisha 1; }
        rudisha 0;
    }
    rudisha 0;
}

// Akiba ya nodi za miundo kwa utendaji (kutafuta aina ya sehemu ya
// muundo, angalia mkaguzi_kagua_usemi kesi SEHEMU_DOT/SEHEMU_MSHALE
// chini). MUHIMU: ukubwa huu LAZIMA uwe mkubwa kuliko idadi ya
// `muundo` yoyote itakayofafanuliwa kwenye graph nzima ya husisha
// iliyotatuliwa ya programu YOYOTE inayotumia mkusanyaji huu —
// ukubwa wa awali (32) ulikuwa mdogo sana: mradi wowote halisi
// ulioukwepa (structs 33+) ulipata (a) hitilafu za AINA za uwongo
// (muundo usiopatikana kwenye akiba hurudi (1<<8)|32, "i32
// chaguo-msingi", badala ya aina yake halisi) NA (b) uharibifu wa
// wakati wa kukimbia (ast_nne[node], ofseti ya sehemu, kamwe
// haiandikwi kwa muundo usiopatikana kwenye akiba, kwa hiyo codegen
// hutumia thamani ya zamani/isiyoanzishwa) — angalia
// lugha-swa/swa#189. 1024 inaendana na jedwali dada kwenye faili
// hili (kazi_jina_off[1024], global_jina_off[1024], na kadhalika).
n32 muundo_nodes[1024];
n32 muundo_count = 0;

// Jedwali la vigezo vya ulimwengu (jina + aina) kwa utatuzi wa majina
n8* global_jina_pool;
n32 global_jina_off[1024];
n32 global_aina[1024];
n32 global_idadi = 0;

// Alama ya muktadha: hoja ya ukubwa(...) inayokaguliwa SASA hivi
// (angalia mkaguzi_kagua_wito) -- mahali pekee ambapo kitambulisho
// kinaruhusiwa kuwa jina la aina (n32, d64, n.k.) au jina la muundo
// badala ya kigezo/kigezo cha ulimwengu/jina la kazi halisi -- sawa
// na ukubwa_hoja kwenye msambazaji.swa (parser), lakini kwa ajili ya
// mkaguzi_kagua_usemi (AST_KITAMBULISHO, angalia chini).
n32 mkaguzi_ukubwa_hoja = 0;

n32 mkaguzi_angalia(n32 mzizi) {
    mkaguzi_makosa = 0;
    wigo_idadi = 0;
    wigo_vidokezo_idadi = 0;
    kitanzi_kina = 0;
    // Jaza jedwali la vigezo vya ulimwengu
    global_jina_pool = ast_pool;
    global_idadi = 0;
    n32 gn = ast_kushoto[mzizi];
    wakati (gn != -1) {
        kama (ast_aina[gn] == 35) {
            kama (global_idadi < 1024) {
                global_jina_off[global_idadi] = ast_jina_off[ast_kushoto[gn]];
                n32 genc = ast_thamani[gn];
                // Safu: usemi unapaswa kuiona kama kielekezi (anwani ya msingi)
                kama (ast_tiga[gn] != -1) { genc = genc + 1; }
                global_aina[global_idadi] = genc;
                global_idadi = global_idadi + 1;
            } sivyo {
                andika_stderr("KOSA: jedwali la vigezo vya ulimwengu (global_idadi) limejaa (kikomo 1024) — mradi una vigezo vya ulimwengu vingi mno\n");
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
        }
        gn = ast_nne[gn];
    }
    // Pitia ya kwanza: kusanya nodi za miundo (kwa utendaji)
    muundo_count = 0;
    n32 node = ast_kushoto[mzizi];
    wakati (node != -1) {
        kama (ast_aina[node] == 12) {  // AST_MUUNDO
            kama (muundo_count < 1024) {
                muundo_nodes[muundo_count] = node;
                muundo_count = muundo_count + 1;
            } sivyo {
                andika_stderr("KOSA: akiba ya nodi za miundo (muundo_nodes) imejaa (kikomo 1024) — graph ya husisha ina aina za muundo nyingi mno\n");
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
        }
        node = ast_nne[node];
    }
    // Pitia ya pili: sajili SAINI za kazi zote KABLA ya kukagua mwili
    // wowote (lugha-swa/swa#180) — kazi A inayoita kazi B iliyofafanuliwa
    // BAADAYE kwenye faili lile lile lazima ipate B tayari imesajiliwa
    // wakati mwito wake unakaguliwa, si baada ya kukagua mwili wa A.
    // Zamani usajili ulifanyika ndani ya mkaguzi_kagua_kazi yenyewe
    // (pitio moja lililochanganya usajili na ukaguzi), hivyo kazi
    // yoyote iliyoitwa kabla ya kufafanuliwa bado haikuwa imesajiliwa.
    node = ast_kushoto[mzizi];
    wakati (node != -1) {
        kama (ast_aina[node] == 2) {
            mkaguzi_sajili_kazi(node);
        }
        node = ast_nne[node];
    }
    // Pitia ya tatu: kagua miili ya kazi zote (saini zote tayari
    // zimesajiliwa kutoka pitio ya pili hapo juu).
    node = ast_kushoto[mzizi];
    wakati (node != -1) {
        kama (ast_aina[node] == 2) {
            mkaguzi_kagua_kazi(node);
        }
        node = ast_nne[node];
    }
    rudisha mkaguzi_makosa;
}

// Fuatilia ni majina gani ya kazi yaliyopo kwa ukaguzi wa idadi ya hoja.
//
// MUHIMU: kazi_jina_pool ni DIMBWI LA BAITI za majina HALISI ya kazi
// (si jedwali la idadi kama muundo_nodes/desimali_off) — ukubwa wake
// LAZIMA uzidi jumla ya urefu wa majina YOTE ya kazi zilizofafanuliwa
// kwenye graph nzima ya husisha iliyotatuliwa. Ukubwa wa awali
// (16384 baiti) ulikuwa mdogo sana: mradi halisi wenye moduli nyingi
// (mfano Dominion's mchezo.swa, ambayo huhusisha moduli 28+ zenye
// majina marefu ya Kiswahili kama "utawala_serikali_pata_rushwa_jumla")
// hufikia kikomo hiki kwa urahisi mara graph inapokuwa kubwa vya
// kutosha. Kuna ulinzi wa kufurika uliopo tayari (haiandiki nje ya
// mipaka, hutoa ujumbe wa hitilafu), lakini ujumbe huo wenyewe
// ulikuwa ukitokea mara kwa mara badala ya kufanya kazi ipasavyo.
n32 kazi_idadi = 0;
n8 kazi_jina_pool[131072];
n32 kazi_jina_pool_wapi = 1;
n32 kazi_jina_off[1024];
n32 kazi_param_count[1024];

// Jedwali la aina za kurudi kwa kazi — linajazwa wakati wa usajili
n32 kazi_ret_idadi = 0;
n8 kazi_ret_pool[8192];
n32 kazi_ret_pool_wapi = 1;
n32 kazi_ret_jina_off[1024];
n32 kazi_ret_aina[1024];

// Hifadhi za aina za vigezo kwa ukaguzi wa hoja za mwito
n32 kazi_param_enc[4096];  // aina za vigezo bapa
n32 kazi_param_enc_wapi = 0;  // nafasi ya sasa katika kazi_param_enc
n32 kazi_param_start[1024];  // fahirisi ya mwanzo wa vigezo kwa kila kazi

w0 mkaguzi_sajili_kazi(n32 kazi_node) {
    kama (kazi_idadi >= 1024) { rudisha; }
    n32 name_node = ast_kushoto[kazi_node];
    n8* jina = ast_pool + ast_jina_off[name_node];
    // Hesabu vigezo na hifadhi aina zao (viko kwenye nodi ya kazi, si nodi ya jina)
    n32 pc = 0;
    n32 param_start = kazi_param_enc_wapi;
    kazi_param_start[kazi_idadi] = param_start;
    n32 p = ast_kulia[kazi_node];
    wakati (p != -1) {
        kama (kazi_param_enc_wapi < 4096) {
            kazi_param_enc[kazi_param_enc_wapi] = ast_thamani[p];
            kazi_param_enc_wapi = kazi_param_enc_wapi + 1;
        } sivyo {
            andika_stderr("kosa [%s]: jedwali la aina za hoja bapa (kazi_param_enc) limejaa (kikomo 4096) — mradi una hoja nyingi mno kwa jumla, kwenye kazi zote\n", jina);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        pc = pc + 1;
        p = ast_kulia[p];
    }
    // Ulinzi wa dimbwi: kufurika kulikuwa kimeandika juu ya
    // kazi_jina_off (jedwali la ofseti) na kusababisha segfault
    // kwenye jina_linganisha wakati wa kujikusanya.
    //
    // MUHIMU: namba hii (131072) LAZIMA ilingane na ukubwa wa
    // tangazo la kazi_jina_pool[] juu ya faili hili — Swa haina
    // njia ya kupata ukubwa wa safu kutoka kwa jina lake (hakuna
    // sizeof/lengthof), kwa hiyo namba hii ni HARDCODED kwa
    // makusudi, ikilingana na muundo uliopo tayari wa faili hili
    // (mfano muundo_count/muundo_nodes hapo juu). Kosa halisi
    // lililopatikana wakati wa kikao hiki: ukubwa wa tangazo la safu
    // ULIBADILISHWA (16384->131072) BILA kubadilisha namba hii
    // hapa, ikiacha ulinzi wa kufurika ukiendelea kukataa kwa
    // ukubwa wa ZAMANI — angalia lugha-swa/swa#197 kwa maelezo
    // kamili. SASA kipengele kipya cha lugha, urefu(x) (angalia
    // uzalishaji.swa), kingeweza kutatua hili moja kwa moja — LAKINI
    // kimejaribiwa hapa na KUONDOLEWA KWA MAKUSUDI: mkaguzi.swa ni
    // sehemu ya CHANZO CHA MKUSANYAJI MWENYEWE, na mbegu.bin (mbegu
    // ya awali iliyogandishwa, isiyobadilika) haitambui urefu() kama
    // hoja iliyosajiliwa — ikijaribu kukusanya stage1.swa (ambayo
    // sasa ingehitaji urefu()) mbegu.bin ingekataa kwa "kazi
    // haijafafanuliwa: urefu", ikivunja mnyororo wa kujitegemea
    // (bootstrap) kabisa. urefu() inafaa kutumika kwenye MIRADI
    // INAYOTUMIA mkusanyaji (kama Dominion), SI ndani ya chanzo cha
    // mkusanyaji wenyewe, hadi mbegu.bin yenyewe ijengwe upya
    // ikiwa na msaada wa urefu() (swali tofauti kabisa la
    // kujitegemea, nje ya wigo wa kazi hii).
    n32 off = kazi_jina_pool_wapi;
    n32 i = 0;
    wakati (jina[i] != 0) {
        kama (off + i + 1 >= 131072) {
            andika_stderr("; KOSA: dimbwi la majina ya mkaguzi limejaa\n");
            mkaguzi_makosa = mkaguzi_makosa + 1;
            rudisha;
        }
        kazi_jina_pool[off + i] = jina[i];
        i = i + 1;
    }
    kazi_jina_pool[off + i] = 0;
    kazi_jina_pool_wapi = off + i + 1;
    kazi_jina_off[kazi_idadi] = off;
    kazi_param_count[kazi_idadi] = pc;
    kazi_idadi = kazi_idadi + 1;

    // Pia sajili aina ya kurudi kwa ukaguzi wa matumizi ya wito
    kama (kazi_ret_idadi < 1024) {
        kazi_ret_jina_off[kazi_ret_idadi] = off;
        kazi_ret_aina[kazi_ret_idadi] = ast_thamani[kazi_node];
        kazi_ret_idadi = kazi_ret_idadi + 1;
    } sivyo {
        andika_stderr("kosa [%s]: jedwali la aina za kurudi za kazi (kazi_ret_idadi) limejaa (kikomo 1024) — mradi una kazi nyingi mno\n", jina);
        mkaguzi_makosa = mkaguzi_makosa + 1;
    }
}

n32 mkaguzi_tafuta_kazi(n8* jina) {
    n32 i = 0;
    wakati (i < kazi_idadi) {
        n8* kj = kazi_jina_pool + kazi_jina_off[i];
        kama (jina_linganisha(kj, jina)) { rudisha kazi_param_count[i]; }
        i = i + 1;
    }
    rudisha -1;
}

// Tafuta encoding ya aina ya parameta kwa jina la kazi na faharisi ya parameta
n32 mkaguzi_tafuta_param_enc(n8* jina, n32 idx) {
    n32 i = 0;
    wakati (i < kazi_idadi) {
        n8* kj = kazi_jina_pool + kazi_jina_off[i];
        kama (jina_linganisha(kj, jina)) {
            kama (idx < kazi_param_count[i]) {
                rudisha kazi_param_enc[kazi_param_start[i] + idx];
            }
            rudisha -1;
        }
        i = i + 1;
    }
    rudisha -1;
}

// Wito kupitia kigezo (kielekezi cha kazi)? Rudisha 1 ikiwa wito
// (AST_WITO) unamuita kigeu cha ndani/paramu (wigo) au cha ulimwengu
// kwa jina — si kazi iliyosajiliwa. Wito kama huo hauna saini: aina za
// hoja na za kurudi hazijulikani wakati wa kukusanya (aina yake ya
// kurudi ni 0 — "inakubaliana na yoyote", sawa na kazi za nje).
n32 mkaguzi_ni_wito_kupitia_kigezo(n32 node) {
    kama (node < 0) { rudisha 0; }
    kama (ast_aina[node] != 8) { rudisha 0; }  // AST_WITO
    n32 cn = ast_kushoto[node];
    kama (cn < 0) { rudisha 0; }
    kama (ast_aina[cn] != 5) { rudisha 0; }  // AST_KITAMBULISHO
    n8* jina = ast_pool + ast_jina_off[cn];
    kama (mkaguzi_tafuta_kazi(jina) >= 0) { rudisha 0; }  // kazi halisi
    kama (wigo_tafuta(jina) >= 0) { rudisha 1; }
    n32 g = 0;
    wakati (g < global_idadi) {
        kama (jina_linganisha(global_jina_pool + global_jina_off[g], jina)) { rudisha 1; }
        g = g + 1;
    }
    rudisha 0;
}

// Kataa matumizi ya wito kupitia kielekezi katika muktadha wa d64.
// Matokeo ya wito kama huo hayajulikani wakati wa kukusanya na
// yanakuja kwenye rejesta za GP (eax/rax), si xmm0 — kuyachukulia
// kama d64 kungekuwa takataka kimya kimya (hati 4.3: matokeo ya d64
// hayakubaliki kupitia kielekezi). enc_lengwa ≤ 0 au isiyo ya familia
// ya D (3) hairudi chochote.
w0 mkaguzi_kataa_d64_kutoka_wito_wa_kigezo(n32 node, n32 enc_lengwa) {
    kama (enc_lengwa <= 0) { rudisha; }
    kama ((enc_lengwa / 256) % 256 != 3) { rudisha; }  // familia D pekee
    kama (mkaguzi_ni_wito_kupitia_kigezo(node) == 0) { rudisha; }
    andika_stderr("kosa [%s]: wito kupitia kielekezi hauna aina ya kurudi — matokeo ya D64 hayakubaliki\n", mkaguzi_kazi_sasa);
    mkaguzi_makosa = mkaguzi_makosa + 1;
}

// Kataa kigeu cha ndani cha w0 chenye kianzio. w0 (familia 5,
// upana 0) ni aina ya kazi pekee — hati 3: "W0 ni kwa kazi tu".
// Kianzio cha thamani kwa w0 kilikubaliwa kimya zamani (kigeu cha
// ukubwa 0 — thamani ikimezwa); kataa kwa sauti, kama kigezo cha
// w0 kinavyokataliwa. w0 bila kianzio inabaki halali (tangazo
// halina thamani ya kuhifadhi) — kama vile w0* yenye kianzio
// (kielekezi cha kazi kinachoshika anwani).
w0 mkaguzi_kataa_w0_chenye_kianzio(n32 enc, n8* jina_kigeu) {
    n32 w0_fam = (enc / 256) % 256;
    n32 w0_upana = enc - (w0_fam * 256);
    kama (w0_fam == 5) {
        kama (w0_upana == 0) {
            andika_stderr("kosa [%s]: kigeu '%s' cha W0 chenye kianzio — W0 ni kwa kazi tu\n", mkaguzi_kazi_sasa, jina_kigeu);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
    }
}

// Kataa modulo (%) ya kielekezi. % si hesabu ya anwani — jumlisha
// na toa ndizo pekee (p + n na p - n); zamani p % n ilikubaliwa
// kimya na kupiga modulo ya anwani yenyewe (rekodi 8.9). Kataa
// kwa sauti, kama p+p na n-p zinavyokataliwa.
w0 mkaguzi_kataa_modulo_ya_kielekezi(n32 aina, n32 lhs_enc, n32 rhs_enc) {
    kama (aina == 49) {  // AST_MODULO
        n32 modulo_kushoto = mkaguzi_ni_kielekezi(lhs_enc);
        n32 modulo_kulia = mkaguzi_ni_kielekezi(rhs_enc);
        kama (modulo_kushoto == 1) {
            andika_stderr("kosa [%s]: kielekezi kwenye modulo haina maana (l=%d, r=%d)\n", mkaguzi_kazi_sasa, lhs_enc, rhs_enc);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        } sivyo {
            kama (modulo_kulia == 1) {
                andika_stderr("kosa [%s]: kielekezi kwenye modulo haina maana (l=%d, r=%d)\n", mkaguzi_kazi_sasa, lhs_enc, rhs_enc);
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
        }
    }
}

// Kataa hoja nyingi kwa kazi za pekee zisizosajiliwa (wito_wa_mfumo,
// tekeleza, ukubwa, anwani_ya_kazi) — mzalishaji huzitambua kwa jina
// na hoja zaidi ya kiwango cha kila moja zilimezwa kimya (mdudu wa
// 2026-09-04). Kiwango: wito_wa_mfumo 7 (namba ya mfumo + hoja 6 za GP),
// tekeleza 4 (kazi, argc, argv, ofseti), ukubwa 1 (jina la aina),
// anwani_ya_kazi 1 (jina la kazi). Idadi ndogo inabaki halali
// (wito_wa_mfumo(60, 0) n.k. — mzalishaji hutoa sifuri kwa
// zilizokosekana).
w0 mkaguzi_kagua_kiwango_cha_huduma(n8* jina, n32 hoja_idadi) {
    n32 kiwango_hoja = 0;
    kama (jina_linganisha(jina, "wito_wa_mfumo")) { kiwango_hoja = 7; }
    sivyo { kama (jina_linganisha(jina, "tekeleza")) { kiwango_hoja = 4; }
        sivyo { kama (jina_linganisha(jina, "ukubwa")) { kiwango_hoja = 1; }
            sivyo { kama (jina_linganisha(jina, "anwani_ya_kazi")) { kiwango_hoja = 1; }
                sivyo { kama (jina_linganisha(jina, "urefu")) { kiwango_hoja = 1; } } } } }
    kama (kiwango_hoja > 0) {
        kama (hoja_idadi > kiwango_hoja) {
            andika_stderr("kosa [%s]: idadi ya hoja kwa '%s' si sahihi (kikomo ni %d, imepokea %d)\n", mkaguzi_kazi_sasa, jina, kiwango_hoja, hoja_idadi);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
    }
}

// Usemi wa anwani ya kazi (&jina_la_kazi) kwa paramu ya namba ya
// upana 64 (n64/A64)? Rudisha 1 kwa KUMBUKA (&) juu ya kitambulisho
// ambacho SI kigeu cha ndani/paramu (wigo) wala cha ulimwengu —
// yaani jina la kazi (lililosajiliwa au la: wito wa mbele bado
// halijasajiliwa, na jina lisilojulikana kabisa linalia kwa sauti
// mwishoni mwa kukusanya) — kinapoanishwa na paramu ya familia
// N/A ya upana ≥ 64: anwani ya kazi ni thamani ya baiti 8, kama
// paramu yenyewe (ubaguzi wa hati 4.3 dhidi ya sheria ya 5).
n32 mkaguzi_ni_anwani_ya_kazi_kwa_param(n32 node, n32 param_enc) {
    kama (node < 0) { rudisha 0; }
    kama (ast_aina[node] != 30) { rudisha 0; }  // AST_KUMBUKA (&)
    n32 op = ast_kushoto[node];
    kama (op < 0) { rudisha 0; }
    kama (ast_aina[op] != 5) { rudisha 0; }  // AST_KITAMBULISHO
    n8* jina = ast_pool + ast_jina_off[op];
    kama (wigo_tafuta(jina) >= 0) { rudisha 0; }  // kigeu/paramu
    n32 g = 0;
    wakati (g < global_idadi) {
        kama (jina_linganisha(global_jina_pool + global_jina_off[g], jina)) { rudisha 0; }
        g = g + 1;
    }
    kama (param_enc <= 0) { rudisha 0; }
    n32 fam_p = (param_enc / 256) % 256;
    n32 upana_p = param_enc - (fam_p * 256);
    kama (upana_p < 64) { rudisha 0; }
    kama (fam_p == 1) { rudisha 1; }
    kama (fam_p == 2) { rudisha 1; }
    rudisha 0;
}

// Kagua wito wa kazi (AST_WITO, 8): thibitisha aina za hoja dhidi ya
// vigezo na idadi ya hoja dhidi ya tangazo. Huitwa kutoka kwa wito
// wa nafasi ya taarifa NA wa nafasi ya usemi — mwito wa nafasi ya
// usemi haupaswi kukwepa ukaguzi (mende: aina na idadi zisizofaa
// zilipita bila kugunduliwa kwenye usemi). andika/andika_stderr ni
// za kutofautiana (variadic) — idadi yao haithibitishwi. Kazi za
// nje (wito_wa_mfumo, tekeleza) hazijaandikishwa, kwa hiyo hazina
// idadi ya kuthibitisha. Rudisha usimbaji wa aina ya kurudi
// (0 = kazi ya nje — aina haijulikani, inakubaliana na yoyote).
n32 mkaguzi_kagua_wito(n32 node) {
    n32 name_node = ast_kushoto[node];
    kama (name_node != -1) {
        n8* jina = ast_pool + ast_jina_off[name_node];
        // Hoja ya ukubwa(...) ni jina la aina/muundo, si kigezo halisi
        // -- angalia mkaguzi_ukubwa_hoja hapo juu na AST_KITAMBULISHO
        // kwenye mkaguzi_kagua_usemi kwa maelezo kamili.
        n32 ukubwa_hoja_zamani = mkaguzi_ukubwa_hoja;
        kama (jina_linganisha(jina, "ukubwa")) { mkaguzi_ukubwa_hoja = 1; }
        // Hesabu na kagua hoja zilizotolewa
        n32 hoja_idadi = 0;
        n32 a = ast_kulia[node];
        wakati (a != -1) {
            n32 ijayo = ast_tiga[a];  // Hifadhi kabla mkaguzi_kagua_usemi abadilishe ast_tiga[a]
            n32 arg_enc = mkaguzi_kagua_usemi(a);
            ast_tiga[a] = ijayo;  // Rejesha kiungo cha mnyororo wa hoja
            // Halisi kamili inarudisha 0 ("aina yoyote") — enc yake
            // halisi iko ast_nne (288 kwa n32, 320 kwa n64). Halisi
            // haiwezi kamwe kuwa kielekezi; itumie enc halisi kwenye
            // ukaguzi mkali wa kielekezi (mdudu wa 2026-09-01: f(5)
            // kwa kigezo cha n32* ilipita kwa enc 0 na kuanguka SEGV).
            n32 arg_enc_halisi = arg_enc;
            kama (ast_aina[a] == 4) { arg_enc_halisi = ast_nne[a]; }
            // Angalia aina ya hoja dhidi ya aina ya parameta
            n32 param_enc = mkaguzi_tafuta_param_enc(jina, hoja_idadi);
            // Ukaguzi mkali: kielekezi dhidi ya namba haikubaliki.
            // Kupitisha kielekezi kwa kigezo cha n32 — au kinyume —
            // kunakusanyika na kuanguka kwa SEGV wakati wa kukimbia
            // (mdudu wa 2026-09-01). andika na andika_stderr ni za
            // kutofautiana: mkia wao (hoja 2+) hukubali aina yoyote
            // (mkia hupitishwa kwa rejesta za n64 kwa ABI).
            // andika_ndani ni utekelezaji wao wa ndani — mkia wake
            // (a1..a6, hoja 3+) ni mkia huo huo uliofutwa aina.
            // Halisi (arg_enc == 0) zinajumuishwa kupitia arg_enc_halisi.
            kama (param_enc != 0 && param_enc != -1 && arg_enc_halisi != 0 && arg_enc_halisi != -1) {
                n32 ni_mkia_ya_kutofautiana = 0;
                kama (hoja_idadi > 0) {
                    kama (jina_linganisha(jina, "andika") || jina_linganisha(jina, "andika_stderr")) {
                        ni_mkia_ya_kutofautiana = 1;
                    }
                }
                kama (ni_mkia_ya_kutofautiana == 0 && hoja_idadi > 1) {
                    kama (jina_linganisha(jina, "andika_ndani")) {
                        ni_mkia_ya_kutofautiana = 1;
                    }
                }
                kama (ni_mkia_ya_kutofautiana == 0) {
                    n32 arg_mshale = mkaguzi_ni_kielekezi(arg_enc_halisi);
                    n32 param_mshale = mkaguzi_ni_kielekezi(param_enc);
                    kama (arg_mshale != -1 && param_mshale != -1) {
                        kama (arg_mshale != param_mshale) {
                            // Ubaguzi wa hati 4.3: usemi wa anwani ya
                            // kazi (&jina_la_kazi) kwa paramu ya namba ya
                            // upana 64 (n64/A64) ni halali — anwani ni
                            // thamani ya baiti 8. Vigeu vingine vya
                            // kielekezi kwa paramu ya namba bado
                            // vinakataliwa (5). Mwili wa kama ni tupu —
                            // usiweke kigezo hapa (ukomo wa 64).
                            kama (arg_mshale == 1 && param_mshale == 0 && mkaguzi_ni_anwani_ya_kazi_kwa_param(a, param_enc)) {
                            } sivyo {
                                andika_stderr("kosa [%s]: aina ya hoja #%d kwa '%s' hailingani (kielekezi dhidi ya namba: arg=%d, param=%d)\n",
                                mkaguzi_kazi_sasa, hoja_idadi + 1, jina, arg_enc_halisi, param_enc);
                                mkaguzi_makosa = mkaguzi_makosa + 1;
                            }
                        }
                    }
                }
            }
            // Ukaguzi wa familia/upana: aina za mtumiaji (muundo)
            // zinaweza kuwa hasi; halisi kamili (arg_enc == 0)
            // inakubaliana na aina yoyote ya namba (C-semantiki).
            kama (param_enc != 0 && param_enc != -1 && arg_enc != 0 && arg_enc != -1) {
                kama (mkaguzi_aina_zifanane(arg_enc, param_enc) == 0) {
                    kama (mkaguzi_mpaka_wa_desimali(arg_enc, param_enc) == 0) {
                        andika_stderr("kosa [%s]: aina ya hoja #%d kwa '%s' hailingani (arg=%d, param=%d)\n",
                        mkaguzi_kazi_sasa, hoja_idadi + 1, jina, arg_enc, param_enc);
                        mkaguzi_makosa = mkaguzi_makosa + 1;
                    }
                }
            }
            // Wito kupitia kielekezi kama hoja ya parameta ya d64:
            // matokeo yake hayapo kwenye xmm0 — kataa kwa sauti.
            mkaguzi_kataa_d64_kutoka_wito_wa_kigezo(a, param_enc);
            hoja_idadi = hoja_idadi + 1;
            a = ijayo;
        }
        mkaguzi_ukubwa_hoja = ukubwa_hoja_zamani;
        // Kazi za pekee zisizosajiliwa (wito_wa_mfumo, tekeleza,
        // ukubwa, anwani_ya_kazi) — angalia kikomo cha hoja zao.
        mkaguzi_kagua_kiwango_cha_huduma(jina, hoja_idadi);
        // Angalia idadi ya hoja dhidi ya tangazo la kazi.
        n32 inatarajiwa = mkaguzi_tafuta_kazi(jina);
        kama (inatarajiwa >= 0) {
            kama (hoja_idadi != inatarajiwa) {
                n32 ni_ya_kutofautiana = 0;
                kama (jina_linganisha(jina, "andika") || jina_linganisha(jina, "andika_stderr")) {
                    ni_ya_kutofautiana = 1;
                }
                kama (ni_ya_kutofautiana == 0) {
                    andika_stderr("kosa [%s]: idadi ya hoja kwa '%s' si sahihi (%d badala ya %d)\n",
                    mkaguzi_kazi_sasa, jina, hoja_idadi, inatarajiwa);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                }
            }
            // Kikomo cha mzalishaji: hoja 16 (meza za paramu za
            // mzalishaji ni param_off/param_enc za 16). Hoja ya 17+
            // ilikubaliwa na kupotea KIMYA (mdudu wa 2026-09-01) —
            // kataa kwa sauti.
            kama (hoja_idadi > 16) {
                andika_stderr("kosa [%s]: wito kwa '%s' una hoja nyingi mno (%d) — kikomo ni 16\n",
                mkaguzi_kazi_sasa, jina, hoja_idadi);
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
        }
        // Uthibitishaji wa kamba ya muundo kwa andika/andika_stderr
        // (hoja ya KWANZA ikitolewa kama halisi ya kamba): viungwa
        // vinavyofanya kazi ni %d, %s, %c, %% (asilimia halisi), na
        // \% (utorokaji wa asilimia). Vingine (k.m. %u, %x, %f, %l,
        // %n) vinakubaliwa kimya na mzalishaji na kutoa HAKUNA kitu —
        // kataa kwa sauti (uthibitisho-wa-lugha.md unaahidi %d %s %c
        // pekee).
        kama (jina_linganisha(jina, "andika") || jina_linganisha(jina, "andika_stderr")) {
            n32 a0 = ast_kulia[node];
            kama (a0 != -1 && ast_aina[a0] == 5) {
                n8* umbo = ast_pool + ast_jina_off[a0];
                kama (umbo[0] == 34) {  // nukuu ya mwanzo — ni halisi ya kamba
                    n32 ml = 0;
                    wakati (umbo[ml] != 0) { ml = ml + 1; }
                    n32 mp = 1;  // baada ya nukuu ya mwanzo
                    wakati (mp < ml - 1) {
                        kama (umbo[mp] == 92 && umbo[mp + 1] == 37) {  // \%
                            mp = mp + 2;
                            endelea;
                        }
                        kama (umbo[mp] == 37) {  // '%'
                            n8 sp = umbo[mp + 1];
                            kama (sp == 100 || sp == 115 || sp == 99 || sp == 37) {
                                mp = mp + 2;
                                endelea;
                            }
                            andika_stderr("kosa [%s]: kipengele cha umbo %d hakitumiki (viungwa: asilimia, d, s, c)\n", mkaguzi_kazi_sasa, sp);
                            mkaguzi_makosa = mkaguzi_makosa + 1;
                            mp = mp + 2;
                            endelea;
                        }
                        mp = mp + 1;
                    }
                }
            }
        }
        // Wito kupitia kigezo (kielekezi cha kazi): jina ni kigeu cha
        // ndani/paramu (wigo) au cha ulimwengu — si kazi iliyosajiliwa.
        // Hakuna saini ya kuthibitisha hoja dhidi yake; kikomo cha
        // mzalishaji (hoja 16) bado kinashikiliwa. Aina ya kigezo
        // lazima iweze kushika anwani ya kazi: kielekezi (mshale 1)
        // au namba ya upana 64 (n64/A64 — hati 4.3). Nyingine
        // (n32, d64, miundo) ni kosa — wito ungeita takataka.
        // Aina ya kurudi haijulikani (0) — hupatikana hapa chini.
        kama (inatarajiwa < 0) {
            n32 enc_kigezo = wigo_tafuta(jina);
            kama (enc_kigezo == -1) {
                n32 g2 = 0;
                wakati (g2 < global_idadi) {
                    kama (jina_linganisha(global_jina_pool + global_jina_off[g2], jina)) { enc_kigezo = global_aina[g2]; vunja; }
                    g2 = g2 + 1;
                }
            }
            kama (enc_kigezo != -1) {
                n32 ni_halali = 0;
                kama (mkaguzi_ni_kielekezi(enc_kigezo) == 1) { ni_halali = 1; }
                kama (ni_halali == 0) {
                    kama (enc_kigezo > 0) {
                        n32 fam2 = (enc_kigezo / 256) % 256;
                        n32 upana2 = enc_kigezo - (fam2 * 256);
                        kama (upana2 >= 64) {
                            kama (fam2 == 1) { ni_halali = 1; }
                            kama (fam2 == 2) { ni_halali = 1; }
                        }
                    }
                }
                kama (ni_halali == 0) {
                    andika_stderr("kosa [%s]: wito kupitia kigezo '%s': aina yake si kielekezi cha kazi (enc=%d)\n", mkaguzi_kazi_sasa, jina, enc_kigezo);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                }
                kama (hoja_idadi > 16) {
                    andika_stderr("kosa [%s]: wito kupitia kigezo '%s' una hoja nyingi mno (%d) — kikomo ni 16\n", mkaguzi_kazi_sasa, jina, hoja_idadi);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                }
            }
        }
        // Tafuta aina ya kurudi kwa matumizi ya nafasi ya usemi
        n32 j = 0;
        wakati (j < kazi_ret_idadi) {
            n8* rj = kazi_jina_pool + kazi_ret_jina_off[j];
            kama (jina_linganisha(rj, jina)) { rudisha kazi_ret_aina[j]; }
            j = j + 1;
        }
    }
    rudisha 0;  // kazi ya nje — aina haijulikani, inakubaliana na yoyote
}

w0 mkaguzi_kagua_kazi(n32 kazi_node) {
    // MUHIMU: usajili wa saini (mkaguzi_sajili_kazi) HAUFANYIKI hapa
    // tena — unafanyika mapema, kwenye pitio la pekee la usajili
    // ndani ya mkaguzi_angalia (angalia lugha-swa/swa#180), ili kazi
    // ZOTE zijulikane KABLA ya kukagua mwili wa kazi YOYOTE.
    // Fuatilia jina la kazi kwa ujumbe wa makosa
    mkaguzi_kazi_sasa = ast_pool + ast_jina_off[ast_kushoto[kazi_node]];
    // Fuatilia aina ya kurudi kwa ukaguzi wa rudisha.
    kazi_ret_enc = ast_thamani[kazi_node];
    // Sukuma wigo wa kazi na usajili vigezo.
    wigo_sukuma();
    n32 p = ast_kulia[kazi_node];
    wakati (p != -1) {
        n8* pjina = ast_pool + ast_jina_off[p];
        n32 penc = ast_thamani[p];
        // w0 (familia 5, upana 0) ni aina ya kazi pekee — kurudi bila
        // thamani. Kigezo cha w0 hakina thamani wala ukubwa; zamani
        // kilikubaliwa kimya (rekodi 8.3, hati 3: "W0 ni kwa kazi tu").
        // Kataa kwa sauti, kama w0 katika usemi inavyokataliwa.
        n32 pfam = (penc / 256) % 256;
        n32 pupana = penc - (pfam * 256);
        kama (pfam == 5) {
            kama (pupana == 0) {
                andika_stderr("kosa [%s]: kigezo '%s' cha W0 — W0 ni kwa kazi tu\n", mkaguzi_kazi_sasa, pjina);
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
        }
        kama (penc == 0) { penc = ast_thamani[p]; }
        wigo_ongeza(pjina, penc);
        p = ast_kulia[p];
    }
    // Kagua mwili.
    n32 body = ast_tiga[kazi_node];
    kama (body != -1) {
        mkaguzi_kagua_taarifa(body);
    }
    wigo_toa();
}

w0 mkaguzi_kagua_taarifa(n32 node) {
    kama (node == -1) { rudisha; }

    n32 aina = ast_aina[node];

    kama (aina == 9) {  // KAMA
        mkaguzi_kagua_usemi(ast_kushoto[node]);
        wigo_sukuma();
        mkaguzi_kagua_taarifa(ast_kulia[node]);
        wigo_toa();
        wigo_sukuma();
        mkaguzi_kagua_taarifa(ast_tiga[node]);
        wigo_toa();
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 10) {  // WAKATI
        // Kwa kitanzi cha "kwa", ast_tiga ina taarifa ya anzisha.
        // Tangazo (n32 j = 0) lazima lisajiriwe kwenye wigo — usemi
        // pekee hupitia mkaguzi_kagua_usemi. Zamani j haikujulikana
        // kwenye hatua na mwili (mkaguzi haukujali — vitambulisho
        // visivyojulikana havikuwa makosa); ukaguzi wa kihifadhi
        // unategemea wigo kamili. MUHIMU: hii LAZIMA ifanyike KABLA
        // ya ast_kushoto (hali, mfano "j < 10") kukaguliwa -- vinginevyo
        // "j" bado haijasajiliwa wakati hali yenyewe inarejelea "j",
        // ikitoa kosa la uwongo "kitambulisho hakijafafanuliwa: j"
        // (pengo lililopatikana wakati wa uthibitisho wa ukaguzi mpya
        // wa kitambulisho-kisichofafanuliwa, 2026-09-26, issue #255).
        kama (ast_tiga[node] != -1) {
            kama (ast_aina[ast_tiga[node]] == 11) {
                mkaguzi_kagua_taarifa(ast_tiga[node]);
            } sivyo {
                mkaguzi_kagua_usemi(ast_tiga[node]);
            }
        }
        mkaguzi_kagua_usemi(ast_kushoto[node]);
        kitanzi_kina = kitanzi_kina + 1;
        wigo_sukuma();
        mkaguzi_kagua_taarifa(ast_kulia[node]);
        wigo_toa();
        kitanzi_kina = kitanzi_kina - 1;
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 36) {  // SIVYO (mwili wa tawi la sivyo uko ast_kushoto)
        wigo_sukuma();
        mkaguzi_kagua_taarifa(ast_kushoto[node]);
        wigo_toa();
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 15) {  // KIPINDI (kitanzi cha kwa)
        mkaguzi_kagua_usemi(ast_kushoto[node]);  // anzisha
        mkaguzi_kagua_usemi(ast_thamani[node]);  // hali
        mkaguzi_kagua_usemi(ast_tiga[node]);  // hatua
        kitanzi_kina = kitanzi_kina + 1;
        wigo_sukuma();
        mkaguzi_kagua_taarifa(ast_kulia[node]);  // mwili
        wigo_toa();
        kitanzi_kina = kitanzi_kina - 1;
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 14) {  // CHAGUA
        mkaguzi_kagua_usemi(ast_kushoto[node]);
        n32 h = ast_kulia[node];
        wakati (h != -1) {
            // Lebo lazima iwe halisi ya nambari (chanya au hasi). Lebo
            // hasi ni toa-unari ya halisi. Kila kitu kingine (lebo ya
            // usemi, ya kigezo, wito) kinakataliwa kwa sauti — C
            // inakataa lebo zisizo za kudumu (uthibitisho 19-21).
            n32 lebo = ast_kushoto[h];
            n32 ni_halisi = 0;
            kama (ast_aina[lebo] == 4) { ni_halisi = 1; }  // halisi chanya
            sivyo {
                kama (ast_aina[lebo] == 7) {  // toa-unari: -N
                    kama (ast_kushoto[lebo] == -1) {
                        kama (ast_aina[ast_kulia[lebo]] == 4) { ni_halisi = 1; }
                    }
                }
            }
            kama (ni_halisi == 0) {
                andika_stderr("kosa [%s]: lebo ya hali lazima iwe halisi ya nambari (chanya au hasi)\n", mkaguzi_kazi_sasa);
                mkaguzi_makosa = mkaguzi_makosa + 1;
            }
            wigo_sukuma();
            mkaguzi_kagua_taarifa(ast_kulia[h]);
            wigo_toa();
            h = ast_nne[h];
        }
        kama (ast_tiga[node] != -1) {  // mwili wa sivyo (chaguo-msingi)
            wigo_sukuma();
            mkaguzi_kagua_taarifa(ast_tiga[node]);
            wigo_toa();
        }
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 16) {  // VUNJA
        kama (kitanzi_kina == 0) {
            andika_stderr("kosa: vunja nje ya kitanzi\n");
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 17) {  // ENDELEA
        kama (kitanzi_kina == 0) {
            andika_stderr("kosa: endelea nje ya kitanzi\n");
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 50) {  // AST_BLOCK — kifungio cha ndani (hatua ya kwa)
        mkaguzi_kagua_taarifa(ast_kushoto[node]);
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 11) {  // TANGAZO (kigeu cha ndani)
        n32 var_node = ast_kushoto[node];
        n32 var_enc = ast_thamani[var_node];
        kama (var_enc == 0) { var_enc = ast_thamani[node]; }
        // Safu ya ndani: usemi wa jina unaharibika hadi kielekezi (mshale +1)
        kama (ast_tiga[node] > 0) { var_enc = var_enc + 1; }
        n8* var_jina = ast_pool + ast_jina_off[var_node];
        // Angalia tangazo rudufu katika wigo wa sasa
        kama (wigo_tafuta(var_jina) >= 0) {
            andika_stderr("kosa: kigeu '%s' kimeshatangazwa\n", var_jina);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        wigo_ongeza(var_jina, var_enc);
        n32 init_node = ast_kulia[node];
        kama (init_node != -1) {
            // w0 chenye kianzio kinakataliwa kwa sauti (hati 3)
            mkaguzi_kataa_w0_chenye_kianzio(var_enc, var_jina);
            n32 init_enc = mkaguzi_kagua_usemi(init_node);
            // Wito kupitia kielekezi kama kianzio cha d64 — kataa (hati 4.3)
            mkaguzi_kataa_d64_kutoka_wito_wa_kigezo(init_node, var_enc);
            // Angalia kama aina ya kianzio inalingana na aina ya tangazo
            // Aina za mtumiaji (muundo) ni hasi; tumia != 0 && != -1
            kama (init_enc != 0 && init_enc != -1 && var_enc != 0) {
                kama (mkaguzi_aina_zifanane(var_enc, init_enc) == 0) {
                    kama (mkaguzi_mpaka_wa_desimali(var_enc, init_enc) == 0) {
                        andika_stderr("kosa [%s]: aina ya kianzio hailingani na tangazo la '%s' (tangazo=%d, kianzio=%d)\n", mkaguzi_kazi_sasa, var_jina, var_enc, init_enc);
                        mkaguzi_makosa = mkaguzi_makosa + 1;
                    }
                }
            }
        }
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 37) {  // ASIMILIA (ugawaji)
        n32 lhs_node = ast_kushoto[node];
        n32 rhs_node = ast_kulia[node];
        n32 lhs_enc = mkaguzi_kagua_usemi(lhs_node);
        n32 rhs_enc = mkaguzi_kagua_usemi(rhs_node);
        // Ugawaji unahitaji kihifadhi: kigeu, nyoosha, sehemu, au
        // kipengele cha safu. Matokeo ya wito, ternary, au oparesheni SI
        // kihifadhi — kuyakubali kimya kunaacha no-op kwenye mzalishaji
        // (LHS hupuuzwa, RHS pekee hutathminiwa). Mbegu hukataa sawa
        // ("uwekaji usiotumika") — weka mnyororo huu wenye mwendo uleule.
        n32 ni_lvalue = 0;
        kama (lhs_node != -1) {
            n32 aina_l = ast_aina[lhs_node];
            kama (aina_l == 5) {  // kitambulisho: lazima kiwe kigeu (wigo au ulimwengu)
                n8* jina_l = ast_pool + ast_jina_off[lhs_node];
                kama (wigo_tafuta(jina_l) != -1) { ni_lvalue = 1; }
                sivyo {
                    n32 g3 = 0;
                    wakati (g3 < global_idadi) {
                        kama (jina_linganisha(global_jina_pool + global_jina_off[g3], jina_l)) { ni_lvalue = 1; vunja; }
                        g3 = g3 + 1;
                    }
                }
            }
            kama (aina_l == 29) { ni_lvalue = 1; }  // nyoosha / kipengele cha safu
            kama (aina_l == 33) { ni_lvalue = 1; }  // sehemu kwa nukta
            kama (aina_l == 34) { ni_lvalue = 1; }  // sehemu kwa mshale
        }
        kama (ni_lvalue == 0) {
            andika_stderr("kosa [%s]: ugawaji unahitaji kihifadhi (kigeu, nyoosha, sehemu, au kipengele cha safu)\n", mkaguzi_kazi_sasa);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        // Aina za mtumiaji zinaweza kuwa hasi
        kama (lhs_enc != 0 && lhs_enc != -1 && rhs_enc != 0 && rhs_enc != -1) {
            // Inaruhusu upanuzi/kupungua ndani ya familia moja;
            // mpaka wa kamili/desimali ni halali (C-semantiki)
            kama (mkaguzi_aina_zifanane(lhs_enc, rhs_enc) == 0) {
                kama (mkaguzi_mpaka_wa_desimali(lhs_enc, rhs_enc) == 0) {
                    andika_stderr("kosa [%s]: aina ya ugawaji hailingani (L=%d, R=%d)\n", mkaguzi_kazi_sasa, lhs_enc, rhs_enc);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                }
            }
        }
        // Wito kupitia kielekezi kama thamani ya d64 — kataa (hati 4.3)
        mkaguzi_kataa_d64_kutoka_wito_wa_kigezo(rhs_node, lhs_enc);
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 19) {  // ACHILIA
        mkaguzi_kagua_usemi(ast_kushoto[node]);
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 8) {  // WITO (wito wa kazi)
        mkaguzi_kagua_wito(node);
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }
    kama (aina == 3) {  // RUDISHA
        n32 expr_node = ast_kushoto[node];
        kama (expr_node != -1) {
            n32 ret_enc = mkaguzi_kagua_usemi(expr_node);
            // Wito kupitia kielekezi kama kurudi ya kazi ya d64 — kataa (hati 4.3)
            mkaguzi_kataa_d64_kutoka_wito_wa_kigezo(expr_node, kazi_ret_enc);
            kama (ret_enc != 0 && ret_enc != -1 && kazi_ret_enc != 0) {
                kama (mkaguzi_aina_zifanane(ret_enc, kazi_ret_enc) == 0) {
                    kama (mkaguzi_mpaka_wa_desimali(ret_enc, kazi_ret_enc) == 0) {
                        andika_stderr("kosa [%s]: aina ya kurudi hailingani na tangazo la kazi (ret=%d, tangazo=%d)\n", mkaguzi_kazi_sasa, ret_enc, kazi_ret_enc);
                        mkaguzi_makosa = mkaguzi_makosa + 1;
                    }
                }
            }
        }
        mkaguzi_kagua_taarifa(ast_nne[node]);
        rudisha;
    }

    // WITO na RUDISHA huitana ndugu kabla ya rudisha
    // Angalia juu.
    mkaguzi_kagua_taarifa(ast_nne[node]);
}

n32 mkaguzi_kagua_usemi(n32 node) {
    kama (node == -1) { rudisha -1; }

    n32 aina = ast_aina[node];

    // Halisi ya nambari kamili — inafaa kwa aina yoyote (bila upana maalum).
    // Thamani iko ast_thamani; weka usimbaji wa chaguo-msingi (n32)
    // kwenye ast_nne kwa ukusanyaji wa hoja za wito (uzalishaji_wito
    // unasoma enc hapo — si ast_thamani, ambayo ni thamani ya namba).
    kama (aina == 4) {
        // Alama ya n64 iko ast_kulia (ast_tiga ni kiungo cha mnyororo
        // wa hoja — mkaguzi wa wito huiandika juu ya ast_tiga).
        kama (ast_kulia[node] == 1) {
            ast_nne[node] = 320;  // n64: familia 1, upana 64
        } sivyo {
            ast_nne[node] = 288;  // n32: familia 1, upana 32
        }
        rudisha 0;  // "aina yoyote" — haisababishi makosa ya utangamano
    }

    // Kitambulisho
    kama (aina == 5) {
        n8* jina = ast_pool + ast_jina_off[node];
        n32 enc = wigo_tafuta(jina);
        n32 imepatikana = wigo_ipo(jina);
        kama (imepatikana == 0) {
            // Angalia vigeu vya ulimwengu
            n32 g = 0;
            wakati (g < global_idadi) {
                n8* gj = global_jina_pool + global_jina_off[g];
                kama (jina_linganisha(gj, jina)) { enc = global_aina[g]; imepatikana = 1; vunja; }
                g = g + 1;
            }
        }
        kama (imepatikana == 0) {
            // Angalia majina ya kazi (viashiria vya kazi)
            n32 pc = mkaguzi_tafuta_kazi(jina);
            kama (pc >= 0) { enc = 1; imepatikana = 1; }  // kiashiria cha kazi
        }
        // Jina halisi halipatikani mahali popote (wigo, kigezo cha
        // ulimwengu, jina la kazi) -- kosa la sauti, si kupitishwa kimya
        // kama "aina yoyote" (-1). Bila hii, kwa mfano jina la aina
        // (n32, d64 n.k.) likitumika kama usemi likiwa halijaguswa na
        // ukubwa(...) linapita kimya likiwa halina athari (angalia
        // lugha-swa/swa issue #255) -- ISIPOKUWA lina ujumbe wa kirafiki
        // zaidi kama linafanana na jina la aina la msingi.
        //
        // MUHIMU: halisi za kamba (string literals) NAZO ni nodi za
        // AST_KITAMBULISHO (angalia changanua_primary, TOKENI_MFUATANO) --
        // maandishi yaliyohifadhiwa YANAJUMUISHA alama za kunukuu
        // zenyewe (jina[0] == '"'), kwa hiyo KAMWE hayatapatikana kwenye
        // wigo/kigezo/jina la kazi (si kusudio lao) -- lazima yaruke
        // ukaguzi huu kabisa, si kutibiwa kama kitambulisho kisichopo.
        // Vivyo hivyo hoja ya ukubwa(...) (mkaguzi_ukubwa_hoja) -- ni
        // jina la aina/muundo kimakusudi, si kigezo halisi.
        kama (imepatikana == 0 && jina[0] != 34 && mkaguzi_ukubwa_hoja == 0) {
            n32 jlen = 0;
            wakati (jina[jlen] != 0) { jlen = jlen + 1; }
            kama (ni_aina_msingi_pia_ndogo(jina, jlen)) {
                andika_stderr("kosa [%s]: jina la aina halitumiki kama usemi: %s\n", mkaguzi_kazi_sasa, jina);
            } sivyo {
                andika_stderr("kosa [%s]: kitambulisho hakijafafanuliwa: %s\n", mkaguzi_kazi_sasa, jina);
            }
            mkaguzi_makosa = mkaguzi_makosa + 1;
            enc = -1;
        }
        // Hifadhi usimbaji kwenye nodi — uzalishaji wa wito unausoma
        // kwa hoja za kigeu (rejeleo jipya la KITAMBULISHO lina thamani 0)
        ast_thamani[node] = enc;
        rudisha enc;
    }

    // Ternary (hali ? kweli : uwongo)
    kama (aina == 45) {  // AST_HALISI_D — desimali halisi (d64)
        // ast_thamani/tiga hubeba baiti za thamani; enc inawekwa ast_nne
        // kwa matumizi ya ukusanyaji wa hoja za wito.
        ast_nne[node] = 832;
        rudisha 832;  // d64: familia 3, upana 64
    }

    kama (aina == 44) {  // AST_TERNARY
        mkaguzi_kagua_usemi(ast_kushoto[node]);  // hali
        n32 true_enc = mkaguzi_kagua_usemi(ast_kulia[node]);  // tawi la kweli
        // Tawi la uwongo liko ast_nne — ast_tiga hubeba kiungo cha hoja
        // cha mnyororo wa wito (mchanganuzi/mkaguzi huiandika).
        n32 false_enc = mkaguzi_kagua_usemi(ast_nne[node]);  // tawi la uwongo
        // Halisi kamili inarudisha 0 ("aina yoyote") — enc halisi iko
        // ast_nne; iresolvi kwa mpaka wa desimali.
        kama (ast_aina[ast_kulia[node]] == 4) { true_enc = ast_nne[ast_kulia[node]]; }
        kama (ast_aina[ast_nne[node]] == 4) { false_enc = ast_nne[ast_nne[node]]; }
        // Angalia utangamano kati ya matawi
        kama (true_enc != 0 && true_enc != -1 && false_enc != 0 && false_enc != -1) {
            kama (mkaguzi_aina_zifanane(true_enc, false_enc) == 0) {
                kama (mkaguzi_mpaka_wa_desimali(true_enc, false_enc) == 0) {
                    andika_stderr("kosa [%s]: aina za matawi ya ternary haziendani (kweli=%d, uwongo=%d)\n",
                    mkaguzi_kazi_sasa, true_enc, false_enc);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                } sivyo {
                    // PANDISHA YA C: desimali inashinda nambari kamili
                    kama (ni_desimali_enc(false_enc)) { true_enc = false_enc; }
                }
            }
        }
        // Hifadhi encoding kwa mzalishaji; ukubwa hukokotolewa kutoka enc.
        ast_thamani[node] = true_enc;
        rudisha true_enc;
    }

    // TOFAUTI ya unari (kukanusha): -x
    // Hushughulikiwa kabla ya oparesheni jozi — vinginevyo mzalishaji
    // angechukua njia ya 64-bit kwa thamani ya 32-bit.
    kama (aina == 7) {
        kama (ast_kushoto[node] == -1) {
            n32 op = mkaguzi_kagua_usemi(ast_kulia[node]);
            // Halisi kamili inarudisha 0 ("aina yoyote") — enc halisi
            // iko ast_nne. Iihifadhi ili kukanusha kwa upana sahihi
            // (-10000000000 inahitaji ukanushaji wa 64-bit; -90 wa 32).
            kama (ast_aina[ast_kulia[node]] == 4) { op = ast_nne[ast_kulia[node]]; }
            ast_thamani[node] = op;
            rudisha op;
        }
    }

    // Oparesheni jozi — angalia utangamano wa aina za operesheni
    n32 ni_binary = 0;
    kama (aina >= 6) { kama (aina <= 25) { ni_binary = 1; } }
    kama (aina >= 31) { kama (aina <= 32) { ni_binary = 1; } }
    kama (aina >= 39) { kama (aina <= 43) { ni_binary = 1; } }
    kama (aina == 8) { ni_binary = 0; }  // WITO limehudumiwa tofauti hapo juu
    kama (aina == 44) { ni_binary = 0; }  // TERNARY sio oparesheni jozi
    kama (aina == 49) { ni_binary = 1; }  // AST_MODULO
    kama (aina == 46) { ni_binary = 1; }  // AST_XOR (^)
    kama (ni_binary) {
        n32 lhs = mkaguzi_kagua_usemi(ast_kushoto[node]);
        n32 rhs = mkaguzi_kagua_usemi(ast_kulia[node]);
        kama (lhs != 0 && lhs != -1) {
            kama (rhs != 0 && rhs != -1) {
                // Angalia upatanifu wa aina za operesheni; mpaka wa
                // kamili/desimali ni halali (C-semantiki ya pandisha)
                kama (mkaguzi_aina_zifanane(lhs, rhs) == 0) {
                    kama (mkaguzi_mpaka_wa_desimali(lhs, rhs) == 0) {
                        andika_stderr("kosa [%s]: aina haziendani kwenye operesheni (l=%d, r=%d)\n", mkaguzi_kazi_sasa, lhs, rhs);
                        mkaguzi_makosa = mkaguzi_makosa + 1;
                    }
                }
            }
        }
        // Ukubwa wa matokeo hukokotolewa na mzalishaji kutoka enc
        // (ukubwa_kutoka_enc) — si ast_tiga, kwani mkaguzi wa wito
        // huandika kiungo cha mnyororo wa hoja juu ya ast_tiga.
        // Hifadhi encoding kamili kwa mzalishaji (kwa kutofautisha N/D/B/W)
        //
        // PANDISHA: operesheni yenye upana mchanganyiko ndani ya familia
        // moja inachukua upana MKUBWA (C-semantiki) — 0 - 10000000000
        // ni n64, si n32 (mende: ilikuwa ikikatwa hadi biti 32).
        // Halisi kamili inarudisha 0 ("aina yoyote") — enc halisi iko
        // ast_nne; d64 inarudisha enc yake yenyewe (832).
        n32 lhs_enc = lhs;
        kama (ast_aina[ast_kushoto[node]] == 4) { lhs_enc = ast_nne[ast_kushoto[node]]; }
        n32 rhs_enc = rhs;
        kama (ast_aina[ast_kulia[node]] == 4) { rhs_enc = ast_nne[ast_kulia[node]]; }
        n32 enc_ya_op = lhs_enc;
        kama (lhs_enc > 0) {
            kama (rhs_enc > 0) {
                // Hesabu ya anwani (C-semantiki): kielekezi + namba →
                // kielekezi. Zamani biti ya mshale ilipotea hapa
                // (ast_pool + off ilikadiriwa n32) na hoja ya kielekezi
                // kwa kigezo cha n8* ilipita kama namba (mdudu wa
                // 2026-09-01). Mshale iko kwenye biti 0-1 za enc.
                n32 lhs_mshale = lhs_enc - ((lhs_enc / 4) * 4);
                n32 rhs_mshale = rhs_enc - ((rhs_enc / 4) * 4);
                kama (lhs_mshale != rhs_mshale) {
                    kama (lhs_mshale != 0) { enc_ya_op = lhs_enc; }
                    sivyo { enc_ya_op = rhs_enc; }
                } sivyo {
                    kama ((lhs_enc / 256) % 256 == (rhs_enc / 256) % 256) {
                        kama (ukubwa_kutoka_enc(rhs_enc) > ukubwa_kutoka_enc(lhs_enc)) { enc_ya_op = rhs_enc; }
                    } sivyo {
                        // PANDISHA YA C: familia zikitofautiana na moja ni
                        // desimali, operesheni nzima inapandishwa hadi
                        // desimali (1 + 2.5 ni d64, si n32).
                        kama (ni_desimali_enc(lhs_enc)) { enc_ya_op = lhs_enc; }
                        sivyo { kama (ni_desimali_enc(rhs_enc)) { enc_ya_op = rhs_enc; } }
                    }
                }
            }
        }
        // Hesabu ya anwani ya kielekezi (C-semantiki): p + n na p - n
        // pekee ndizo halali. p + p, p - p (delta ghafi ya baiti —
        // haijaelezwa kwenye hati) na n - p hazina maana; zamani
        // zilihesabu baiti kimya (rekodi 8.9). Kataa kwa sauti.
        kama (aina == 6 || aina == 7) {
            n32 lk = mkaguzi_ni_kielekezi(lhs_enc);
            n32 rk = mkaguzi_ni_kielekezi(rhs_enc);
            kama (lk == 1) {
                kama (rk == 1) {
                    andika_stderr("kosa [%s]: kielekezi kwa kielekezi kwenye hesabu (l=%d, r=%d)\n", mkaguzi_kazi_sasa, lhs_enc, rhs_enc);
                    mkaguzi_makosa = mkaguzi_makosa + 1;
                }
            }
            kama (aina == 7) {
                kama (lk == 0) {
                    kama (rk == 1) {
                        andika_stderr("kosa [%s]: namba toa kielekezi haina maana (l=%d, r=%d)\n", mkaguzi_kazi_sasa, lhs_enc, rhs_enc);
                        mkaguzi_makosa = mkaguzi_makosa + 1;
                    }
                }
            }
        }
        // Modulo ya kielekezi inakataliwa kwa sauti (rekodi 8.9)
        mkaguzi_kataa_modulo_ya_kielekezi(aina, lhs_enc, rhs_enc);
        ast_thamani[node] = enc_ya_op;
        rudisha enc_ya_op;
    }

    // Wito wa kazi
    kama (aina == 8) {
        // Kagua hoja zote za wito — aina NA idadi — hata kama wito uko
        // katika nafasi ya usemi. Pia rudisha aina ya kurudi ya wito.
        n32 ret_enc = mkaguzi_kagua_wito(node);
        // Hifadhi enc ya kurudi kwenye nodi — mzalishaji wa wito
        // anaisoma kwa hoja za wito mwingine. Bila hii, hoja inayoleta
        // wito wa muundo (sret) ingeonekana kama aina isiyojulikana (0)
        // na kielekezi cha bafa ya sret kikapitishwa kwa thamani —
        // takataka kwa muundo wa baiti 5-8 (na bafa kuharibika kwa
        // muundo mkubwa zaidi).
        ast_thamani[node] = ret_enc;
        rudisha ret_enc;
    }

    // Oparesheni unari
    kama (aina == 7) {  // TOFAUTI (kukanusha)
        n32 op = mkaguzi_kagua_usemi(ast_kulia[node]);
        rudisha op;
    }
    kama (aina == 30) {  // KUMBUKA (anwani-ya)
        n32 sub_enc = mkaguzi_kagua_usemi(ast_kushoto[node]);
        // Weka biti ya kielekezi (mshale=1) — tumia |1 badala ya &254|1
        // kwa sababu aina za mtumiaji (muundo) zina encoding hasi, na
        // &254 huharibu biti za juu kwenye namba hasi.
        kama (sub_enc != 0 && sub_enc != -1) { kama ((sub_enc / 2) * 2 == sub_enc) { rudisha sub_enc + 1; } rudisha sub_enc; }
        rudisha 1;  // kielekezi cha aina isiyojulikana
    }
    kama (aina == 28) {  // SI (!)
        n32 op = mkaguzi_kagua_usemi(ast_kushoto[node]);
        // Halisi kamili inarudisha 0 ("aina yoyote") — enc halisi iko
        // ast_nne. Iisome ili upana wa matokeo usikose (0 - 10000000000
        // inahitaji upana wa 64; ~0 kwenye n64 vilevile).
        kama (ast_aina[ast_kushoto[node]] == 4) { op = ast_nne[ast_kushoto[node]]; }
        // ! kwa desimali haijatekelezwa — kataa kwa sauti badala ya
        // kutoa jibu la takataka (thamani ya d64 iko xmm0, si eax).
        kama (ni_desimali_enc(op)) {
            andika_stderr("kosa [%s]: kiambishi ! hakikubaliki kwa desimali\n", mkaguzi_kazi_sasa);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        // Matokeo ni 1 au 0 kwa aina ya operesheni (kama && na ||)
        // — si B1, ili ugawaji kwa n32 ufanye kazi.
        ast_thamani[node] = op;
        rudisha op;
    }
    kama (aina == 47) {  // KINYUME (~)
        n32 op = mkaguzi_kagua_usemi(ast_kushoto[node]);
        // Halisi kamili inarudisha 0 ("aina yoyote") — enc halisi iko
        // ast_nne. Iisome ili upana wa matokeo usikose.
        kama (ast_aina[ast_kushoto[node]] == 4) { op = ast_nne[ast_kushoto[node]]; }
        // ~ kwa desimali haijatekelezwa — kataa kwa sauti.
        kama (ni_desimali_enc(op)) {
            andika_stderr("kosa [%s]: kiambishi ~ hakikubaliki kwa desimali\n", mkaguzi_kazi_sasa);
            mkaguzi_makosa = mkaguzi_makosa + 1;
        }
        // Matokeo yana upana uleule wa operesheni (si B1).
        ast_thamani[node] = op;
        rudisha op;
    }

    // Halisi ya kamba
    kama (aina == 40) {
        rudisha 1;  // kielekezi (n8*)
    }

    // Safu halisi {a, b, c}
    kama (aina == 38) {  // AST_SAFU
        n32 elem = ast_kushoto[node];
        wakati (elem != -1) {
            mkaguzi_kagua_usemi(elem);
            elem = ast_nne[elem];
        }
        rudisha 1;  // kielekezi (safu inaharibika hadi kielekezi)
    }

    // Faharasa ya safu
    kama (aina == 29) {  // TAJA
        n32 base = mkaguzi_kagua_usemi(ast_kushoto[node]);
        mkaguzi_kagua_usemi(ast_kulia[node]);
        // Ondoa mshale MMOJA kupata aina ya kipengele.
        // Biti za mshale kwenye upana: 1 = mshale, 2 = mshale wa pili
        // (inayotokana na uporomokaji wa safu), 3 = yote mawili.
        // n8* (9) → n8 (8); n8** (11) → n8* (9).
        // Tumia hesabu ya / na % (mbegu ina hitilafu katika & na |).
        n32 base_no_ptr = base;
        kama (base > 0) {
            n32 familia_b = (base / 256) % 256;
            n32 ua = base - (familia_b * 256);
            n32 mb = ua - ((ua / 4) * 4);
            kama (mb == 3) { base_no_ptr = base - 2; }
            sivyo { kama (mb == 1 || mb == 2) { base_no_ptr = base - 1; } }
        }
        // Hifadhi enc ya matokeo; ukubwa wa elementi hukokotolewa na
        // mzalishaji kutoka enc (ast_tiga ya hoja huandikwa na kiungo
        // cha mnyororo wa wito).
        ast_thamani[node] = base_no_ptr;
        rudisha base_no_ptr;
    }

    // Ufikiaji wa sehemu ya muundo
    kama (aina == 33) {  // SEHEMU_DOT
        n32 base_enc = mkaguzi_kagua_usemi(ast_kushoto[node]);
        n32 field_node = ast_kulia[node];
        n8* sehemu_jina = ast_pool + ast_jina_off[field_node];
        // Kama msingi ni muundo maalum, tafuta tu ndani ya muundo huo
        n8* muundo_jina = 0;
        kama (base_enc < 0) {
            n32 name_off = ((-base_enc) / 2) - 1;
            kama ((base_enc / 2) * 2 != base_enc) { name_off = name_off + 1; }  // mshale huhamisha -1
            muundo_jina = ast_pool + name_off;
        }
        // Tafuta sehemu kwenye miundo iliyosajiliwa (akiba)
        n32 mi = 0;
        wakati (mi < muundo_count) {
            kama (muundo_jina != 0) {
                n32 mn = ast_kushoto[muundo_nodes[mi]];
                kama (jina_linganisha(ast_pool + ast_jina_off[mn], muundo_jina) == 0) {
                    mi = mi + 1;
                    endelea;
                }
            }
            n32 fn = ast_kulia[muundo_nodes[mi]];
            wakati (fn != -1) {
                n32 fname_node = ast_kushoto[fn];
                n8* fn_jina = ast_pool + ast_jina_off[fname_node];
                n32 foffset = ast_tiga[fname_node];
                kama (jina_linganisha(fn_jina, sehemu_jina)) {
                    ast_nne[node] = foffset;  // hifadhi ofseti (si ast_tiga — hoja za wito huiandika)
                    n32 fenc = ast_thamani[fname_node];
                    kama (fenc != 0) { ast_thamani[node] = fenc; rudisha fenc; }
                    ast_thamani[node] = (1 << 8) | 32;
                    rudisha (1 << 8) | 32;
                }
                fn = ast_kulia[fn];
            }
            mi = mi + 1;
        }
        ast_thamani[node] = (1 << 8) | 32;  // haikupatikana — i32 chaguo-msingi
        rudisha (1 << 8) | 32;
    }
    kama (aina == 34) {  // SEHEMU_MSHALE
        n32 base_enc2 = mkaguzi_kagua_usemi(ast_kushoto[node]);
        n32 field_node = ast_kulia[node];
        n8* sehemu_jina = ast_pool + ast_jina_off[field_node];
        // Kama msingi ni kielekezi cha muundo maalum, tafuta tu ndani yake
        n8* muundo_jina2 = 0;
        kama (base_enc2 < 0) {
            n32 name_off2 = ((-base_enc2) / 2) - 1;
            kama ((base_enc2 / 2) * 2 != base_enc2) { name_off2 = name_off2 + 1; }  // mshale huhamisha -1
            muundo_jina2 = ast_pool + name_off2;

        }
        n32 mi = 0;
        wakati (mi < muundo_count) {
            kama (muundo_jina2 != 0) {
                n32 mn2 = ast_kushoto[muundo_nodes[mi]];
                kama (jina_linganisha(ast_pool + ast_jina_off[mn2], muundo_jina2) == 0) {
                    mi = mi + 1;
                    endelea;
                }
            }
            n32 fn = ast_kulia[muundo_nodes[mi]];
            wakati (fn != -1) {
                n32 fname_node = ast_kushoto[fn];
                n8* fn_jina = ast_pool + ast_jina_off[fname_node];
                kama (jina_linganisha(fn_jina, sehemu_jina)) {
                    ast_nne[node] = ast_tiga[fname_node];  // hifadhi ofseti (si ast_tiga — hoja za wito huiandika)
                    n32 fenc = ast_thamani[fname_node];
                    kama (fenc != 0) { ast_thamani[node] = fenc; rudisha fenc; }
                    ast_thamani[node] = (1 << 8) | 32;
                    rudisha (1 << 8) | 32;
                }
                fn = ast_kulia[fn];
            }
            mi = mi + 1;
        }
        ast_thamani[node] = (1 << 8) | 32;
        rudisha (1 << 8) | 32;
    }

    // badili(ptr, size) — panua/kaza kumbukumbu
    kama (aina == 48) {  // AST_BADILI
        mkaguzi_kagua_usemi(ast_kushoto[node]);  // kielekezi
        mkaguzi_kagua_usemi(ast_kulia[node]);  // ukubwa
        rudisha 1;  // kielekezi
    }

    // Chaguo-msingi: tembea watoto na rudisha haijulikani
    mkaguzi_kagua_usemi(ast_kushoto[node]);
    mkaguzi_kagua_usemi(ast_kulia[node]);
    mkaguzi_kagua_usemi(ast_tiga[node]);
    rudisha -1;
}
