    andika_baiti(182);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_idx);
    andika_neno4(0);
}

// movzx eax, word [rip + disp32]  (0F B7 05 xx xx xx xx)
W0 andika_movzx_eax_rip_rel_b2(N32 urekebishaji_idx) {
    andika_baiti(15);
    andika_baiti(183);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_idx);
    andika_neno4(0);
}

// Msaidizi: hifadhi thamani kutoka rax/eax/ax/al hadi [rip+disp32]
// kwa kigeu cha ulimwengu, kulingana na usimbaji wa aina.
W0 andika_mov_rip_rel_ax(N32 enc, N32 urekebishaji_idx) {
    N32 uk = ukubwa_kutoka_enc(enc);
    kama (uk >= 8) {
        andika_mov_rip_rel_rax(urekebishaji_idx);
    } sivyo kama (uk >= 4) {
        andika_mov_rip_rel_eax(urekebishaji_idx);
    } sivyo kama (uk >= 2) {
        andika_mov_rip_rel_ax16(urekebishaji_idx);
    } sivyo {
        andika_mov_rip_rel_al(urekebishaji_idx);
    }
}

// Msaidizi: pakia thamani kutoka [rip+disp32] hadi eax/rax kwa upana
// sahihi na upanuzi wa ishara/sifuri kwa aina ndogo.
W0 andika_mov_ax_rip_rel(N32 enc, N32 urekebishaji_idx) {
    N32 uk = ukubwa_kutoka_enc(enc);
    kama (uk >= 8) {
        andika_mov_rax_rip_rel(urekebishaji_idx);
    } sivyo kama (uk >= 4) {
        andika_mov_eax_rip_rel(urekebishaji_idx);
    } sivyo kama (uk >= 2) {
        // Aina ya baiti 2: panua kwa ishara au sifuri
        kama (ni_bila_ishara_enc(enc)) {
            andika_movzx_eax_rip_rel_b2(urekebishaji_idx);
        } sivyo {
            andika_movsx_eax_rip_rel_b2(urekebishaji_idx);
        }
    } sivyo {
        // Aina ya baiti 1: panua kwa ishara au sifuri
        kama (ni_bila_ishara_enc(enc)) {
            andika_movzx_eax_rip_rel_b1(urekebishaji_idx);
        } sivyo {
            andika_movsx_eax_rip_rel_b1(urekebishaji_idx);
        }
    }
}


// === Visaidizi vya usambazaji wa aina ===
// Rudisha 1 ikiwa encoding ni ya desimali (familia D=3)
N32 ni_desimali_enc(N32 enc) {
    kama (enc == 0) { rudisha 0; }
    N32 familia = (enc / 256) % 256;
    kama (familia == 2) { rudisha 1; }
    kama (familia == 3) { rudisha 1; }
    rudisha 0;
}

// Rudisha 1 ikiwa encoding inahitaji usajili wa 64-bit
N32 ni_aina_ya_64bit(N32 enc) {
    kama (enc == 0) { rudisha 0; }
    // Hesabu ya / na * (mbegu ina hitilafu katika & na >>)
    kama ((enc / 2) * 2 != enc) { rudisha 1; }  // kielekezi = baiti 8
    N32 familia = (enc / 256) % 256;
    N32 upana = enc - (familia * 256);
    kama (familia >= 1 && familia <= 5) {
        rudisha (upana >= 64);
    }
    rudisha 0;  // miundo na aina nyingine
}

// Rudisha 1 ikiwa encoding ni bila ishara (familia A=2, B=4, W=5)
// Aina hizi hutumia div (si idiv), shr (si sar), setb/seta (si setl/setg)
N32 ni_bila_ishara_enc(N32 enc) {
    kama (enc == 0) { rudisha 0; }
    N32 familia = (enc / 256) % 256;
    kama (familia == 2) { rudisha 1; }
    kama (familia == 4) { rudisha 1; }
    kama (familia == 5) { rudisha 1; }
    rudisha 0;
}

// call rel32 (E8 + offset)
W0 andika_call_bandari(N32 offset) {
    andika_baiti(232);
    andika_neno4(offset);
}

// jmp rel8 (EB + offset)
W0 andika_jmp_fupi(N32 offset) {
    andika_baiti(235);
    andika_baiti(offset & 255);
}

// je rel8 (74 + offset)
W0 andika_je_fupi(N32 offset) {
