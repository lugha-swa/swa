    uzalishaji_usemi(ast_kushoto[node], kazi_node);
    vuta_thamani_rcx(enc);

    uzalishaji_cmp_kwa_enc(enc);
    andika_setne_al();
    andika_movzx_eax_al();
}

// AST_CHINI (22) -- chini (<)
W0 uzalishaji_chini(N32 node, N32 kazi_node) {
    N32 enc = ast_thamani[node];
    N32 ni_d = ni_desimali_enc(enc);

    uzalishaji_usemi(ast_kulia[node], kazi_node);
    sukuma_thamani(enc);
    uzalishaji_usemi(ast_kushoto[node], kazi_node);
    vuta_thamani_rcx(enc);

    uzalishaji_cmp_kwa_enc(enc);
    weka_setcc_kwa_enc(enc, 0);
    andika_movzx_eax_al();
}

