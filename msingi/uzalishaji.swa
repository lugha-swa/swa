// sub rsp, 8; movss [rsp], xmm0  — sukuma D32 kwenye rafu (F3 0F 11 /r)
W0 andika_push_xmm0_d32() { andika_baiti(72); andika_baiti(131); andika_baiti(236); andika_baiti(8); andika_baiti(243); andika_baiti(15); andika_baiti(17); andika_baiti(4); andika_baiti(36); }
