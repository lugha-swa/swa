    uzalishaji_cmp_kwa_enc(enc);
    weka_setcc_kwa_enc(enc, 1);
    andika_movzx_eax_al();
}

// AST_CHINI_SAWA (24) -- chini au sawa (<=)
W0 uzalishaji_chini_sawa(N32 node, N32 kazi_node) {
    N32 enc = ast_thamani[node];
    N32 ni_d = ni_desimali_enc(enc);

    uzalishaji_usemi(ast_kulia[node], kazi_node);
