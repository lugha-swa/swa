// neg eax (F7 D8)
W0 andika_neg_eax() { andika_baiti(247); andika_baiti(216); }
W0 andika_cdq() { andika_baiti(153); }
W0 andika_idiv_ecx() { andika_baiti(247); andika_baiti(249); }
W0 andika_and_eax_ecx() { andika_baiti(33); andika_baiti(200); }
W0 andika_or_eax_ecx() { andika_baiti(9); andika_baiti(200); }
W0 andika_shl_eax_cl() { andika_baiti(211); andika_baiti(224); }
W0 andika_sar_eax_cl() { andika_baiti(211); andika_baiti(248); }

