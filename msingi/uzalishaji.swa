W0 andika_mov_eax_r9d() { andika_baiti(68); andika_baiti(137); andika_baiti(200); }
// 64-bit register-to-register moves kwa vigezo vya kielekezi
// mov rax, r8 (4C 89 C0)
W0 andika_mov_rax_r8() { andika_baiti(76); andika_baiti(137); andika_baiti(192); }
// mov rax, r9 (4C 89 C8)
W0 andika_mov_rax_r9() { andika_baiti(76); andika_baiti(137); andika_baiti(200); }

// SSE — desimali (D32/D64)
// addss xmm0, xmm1  (F3 0F 58 C1)
W0 andika_addss_xmm0_xmm1() { andika_baiti(243); andika_baiti(15); andika_baiti(88); andika_baiti(193); }
// subss xmm0, xmm1  (F3 0F 5C C1)
W0 andika_subss_xmm0_xmm1() { andika_baiti(243); andika_baiti(15); andika_baiti(92); andika_baiti(193); }
// mulss xmm0, xmm1  (F3 0F 59 C1)
W0 andika_mulss_xmm0_xmm1() { andika_baiti(243); andika_baiti(15); andika_baiti(89); andika_baiti(193); }
// divss xmm0, xmm1  (F3 0F 5E C1)
W0 andika_divss_xmm0_xmm1() { andika_baiti(243); andika_baiti(15); andika_baiti(94); andika_baiti(193); }
// cvtsi2ss xmm0, eax  (F3 0F 2A C0) — N32 → D32
W0 andika_cvtsi2ss_xmm0_eax() { andika_baiti(243); andika_baiti(15); andika_baiti(42); andika_baiti(192); }
// cvttss2si eax, xmm0  (F3 0F 2C C0) — D32 → N32
W0 andika_cvttss2si_eax_xmm0() { andika_baiti(243); andika_baiti(15); andika_baiti(44); andika_baiti(192); }
// movd xmm1, eax  (66 0F 6E C8) — N32 → xmm1
W0 andika_movd_xmm1_eax() { andika_baiti(102); andika_baiti(15); andika_baiti(110); andika_baiti(200); }
// sub rsp, 8; movss [rsp], xmm0  — sukuma D32 kwenye rafu
W0 andika_push_xmm0() { andika_baiti(72); andika_baiti(131); andika_baiti(236); andika_baiti(8); andika_baiti(0); andika_baiti(0); andika_baiti(0); andika_baiti(243); andika_baiti(15); andika_baiti(17); andika_baiti(4); andika_baiti(36); }
// movss xmm1, [rsp]; add rsp, 8 — vuta D32 kutoka rafu
W0 andika_pop_xmm1() { andika_baiti(243); andika_baiti(15); andika_baiti(16); andika_baiti(12); andika_baiti(36); andika_baiti(72); andika_baiti(131); andika_baiti(196); andika_baiti(8); andika_baiti(0); andika_baiti(0); andika_baiti(0); }
// movd eax, xmm0 — xmm0 → eax (kwa kurudisha thamani)
W0 andika_movd_eax_xmm0() { andika_baiti(102); andika_baiti(15); andika_baiti(126); andika_baiti(192); }
// movd xmm0, eax — eax → xmm0 (66 0F 6E C0)
W0 andika_movd_xmm0_eax() { andika_baiti(102); andika_baiti(15); andika_baiti(110); andika_baiti(192); }

// pop xmm0 — vuta D32 kutoka rafu hadi xmm0
W0 andika_pop_xmm0() {
    // movss xmm0, [rsp]; add rsp, 8
    andika_baiti(243);  // F3
    andika_baiti(15);   // 0F
    andika_baiti(16);   // 10
    andika_baiti(4);    // 04
    andika_baiti(36);   // 24 — ModRM: [rsp]
    andika_baiti(72);   // 48
    andika_baiti(131);  // 83
    andika_baiti(196);  // C4
    andika_baiti(8);    // add rsp, 8
    andika_baiti(0);
    andika_baiti(0);
    andika_baiti(0);
}

// mov al, imm8 (B0 + imm8)
W0 andika_mov_al(N32 imm) {
    andika_baiti(176);  // B0
    andika_baiti(imm & 255);
}

// movss [rbp + disp8], xmmN — hifadhi D32 kwenye rafu (F3 0F 11 /r)
W0 andika_movss_rbp_off_xmm(N32 reg, N32 off) {
    andika_baiti(243);  // F3
    andika_baiti(15);   // 0F
    andika_baiti(17);   // 11
    // ModRM: 01 reg rbp
    N32 modrm = (1 << 6) | ((reg & 7) << 3) | 5;
    andika_baiti(modrm);
    andika_baiti((256 - off) & 255);
}

// movsd [rbp + disp8], xmmN — hifadhi D64 kwenye rafu (F2 0F 11 /r)
W0 andika_movsd_rbp_off_xmm(N32 reg, N32 off) {
    andika_baiti(242);  // F2
    andika_baiti(15);   // 0F
    andika_baiti(17);   // 11
    // ModRM: 01 reg rbp
    N32 modrm = (1 << 6) | ((reg & 7) << 3) | 5;
    andika_baiti(modrm);
    andika_baiti((256 - off) & 255);
}

// movss xmmN, [rbp + disp8] — pakia D32 kutoka rafu (F3 0F 10 /r)
W0 andika_movss_xmm_rbp_off(N32 reg, N32 off) {
    andika_baiti(243);  // F3
    andika_baiti(15);   // 0F
    andika_baiti(16);   // 10
    // ModRM: 01 reg rbp
    N32 modrm = (1 << 6) | ((reg & 7) << 3) | 5;
    andika_baiti(modrm);
    andika_baiti((256 - off) & 255);
}

// movsd xmmN, [rbp + disp8] — pakia D64 kutoka rafu (F2 0F 10 /r)
W0 andika_movsd_xmm_rbp_off(N32 reg, N32 off) {
    andika_baiti(242);  // F2
    andika_baiti(15);   // 0F
    andika_baiti(16);   // 10
    // ModRM: 01 reg rbp
    N32 modrm = (1 << 6) | ((reg & 7) << 3) | 5;
    andika_baiti(modrm);
    andika_baiti((256 - off) & 255);
}

