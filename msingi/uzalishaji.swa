    kama (off < 128) {
        andika_baiti(72); andika_baiti(141); andika_baiti(69);
        andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(72); andika_baiti(141); andika_baiti(133);
        andika_disp32_ya_off(off);
    }
}

// lea rdi, [rbp+disp8] (48 8D 7D disp8) au [rbp+disp32] (48 8D BD xxxx)
