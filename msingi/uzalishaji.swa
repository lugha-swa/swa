    andika_baiti(136);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_idx);
    andika_neno4(0);
}

// mov [rip + disp32], ax  (66 89 05 xx xx xx xx)
W0 andika_mov_rip_rel_ax16(N32 urekebishaji_idx) {
    andika_baiti(102);  // kiambishi awali cha operesheni ya baiti 2
    andika_baiti(137);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_idx);
    andika_neno4(0);
}

// movsx eax, byte [rip + disp32]  (0F BE 05 xx xx xx xx)
W0 andika_movsx_eax_rip_rel_b1(N32 urekebishaji_idx) {
    andika_baiti(15);
    andika_baiti(190);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_idx);
    andika_neno4(0);
}

// movsx eax, word [rip + disp32]  (0F BF 05 xx xx xx xx)
W0 andika_movsx_eax_rip_rel_b2(N32 urekebishaji_idx) {
    andika_baiti(15);
    andika_baiti(191);
    andika_baiti(5);
    andika_rela_ulimwengu(urekebishaji_idx);
    andika_neno4(0);
}

// movzx eax, byte [rip + disp32]  (0F B6 05 xx xx xx xx)
W0 andika_movzx_eax_rip_rel_b1(N32 urekebishaji_idx) {
