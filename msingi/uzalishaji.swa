}


// === Visaidizi vya usambazaji wa aina ===
// Rudisha 1 ikiwa encoding ni ya desimali (familia D=3)
N32 ni_desimali_enc(N32 enc) {
    kama (enc == 0) { rudisha 0; }
    N32 familia = (enc >> 8) & 255;
    kama (familia == 2) { rudisha 1; }
    kama (familia == 3) { rudisha 1; }
    rudisha 0;
}

// Rudisha 1 ikiwa encoding inahitaji usajili wa 64-bit
N32 ni_aina_ya_64bit(N32 enc) {
    kama (enc == 0) { rudisha 0; }
    kama (enc & 1) { rudisha 1; }  // kielekezi = baiti 8
    N32 familia = (enc >> 8) & 255;
    N32 upana = enc & 254;
    kama (familia >= 1 && familia <= 5) {
        rudisha (upana >= 64);
    }
    rudisha 0;  // miundo na aina nyingine
}

// Rudisha 1 ikiwa encoding ni bila ishara (familia A=2, B=4, W=5)
// Aina hizi hutumia div (si idiv), shr (si sar), setb/seta (si setl/setg)
N32 ni_bila_ishara_enc(N32 enc) {
    kama (enc == 0) { rudisha 0; }
    N32 familia = (enc >> 8) & 255;
    kama (familia == 2) { rudisha 1; }
    kama (familia == 4) { rudisha 1; }
    kama (familia == 5) { rudisha 1; }
    rudisha 0;
}

// call rel32 (E8 + offset)
W0 andika_call_bandari(N32 offset) {
    andika_baiti(232);
    andika_neno4(offset);
}

// jmp rel8 (EB + offset)
W0 andika_jmp_fupi(N32 offset) {
    andika_baiti(235);
    andika_baiti(offset & 255);
}

// je rel8 (74 + offset)
W0 andika_je_fupi(N32 offset) {
    andika_baiti(116);
    andika_baiti(offset & 255);
}

// test eax, eax (85 C0)
W0 andika_test_eax_eax() {
    andika_baiti(133);
    andika_baiti(192);
}

// setne al (0F 95 C0)
W0 andika_setne_al() {
    andika_baiti(15);
    andika_baiti(149);
    andika_baiti(192);
}

// setg al (0F 9F C0) -- signed greater
W0 andika_setg_al() {
    andika_baiti(15);
    andika_baiti(159);
    andika_baiti(192);
}

// setle al (0F 9E C0) -- signed less or equal
W0 andika_setle_al() {
    andika_baiti(15);
    andika_baiti(158);
    andika_baiti(192);
}

// setge al (0F 9D C0) -- signed greater or equal
W0 andika_setge_al() {
    andika_baiti(15);
    andika_baiti(157);
    andika_baiti(192);
}

// === setCC kwa ulinganishi wa desimali (float) ===
// setb al — chini kwa float (CF=1)  (0F 92 C0)
W0 andika_setb_al() { andika_baiti(15); andika_baiti(146); andika_baiti(192); }
// seta al — juu kwa float (~CF & ~ZF)  (0F 97 C0)
W0 andika_seta_al() { andika_baiti(15); andika_baiti(151); andika_baiti(192); }
// setbe al — chini-au-sawa kwa float (CF|ZF)  (0F 96 C0)
W0 andika_setbe_al() { andika_baiti(15); andika_baiti(150); andika_baiti(192); }
// setae al — juu-au-sawa kwa float (~CF)  (0F 93 C0)
W0 andika_setae_al() { andika_baiti(15); andika_baiti(147); andika_baiti(192); }

// Kisaidizi: setCC inayofaa kwa aina na mwelekeo
// mwelekeo: 0=chini(<), 1=juu(>), 2=chini_sawa(<=), 3=juu_sawa(>=)
// Desimali na aina bila ishara hutumia setb/seta/setbe/setae
// Aina zenye ishara hutumia setl/setg/setle/setge
W0 weka_setcc_kwa_enc(N32 enc, N32 mwelekeo) {
    kama (ni_desimali_enc(enc) || ni_bila_ishara_enc(enc)) {
        kama (mwelekeo == 0) { andika_setb_al(); }
        sivyo kama (mwelekeo == 1) { andika_seta_al(); }
        sivyo kama (mwelekeo == 2) { andika_setbe_al(); }
        sivyo { andika_setae_al(); }
    } sivyo {
        kama (mwelekeo == 0) { andika_setl_al(); }
        sivyo kama (mwelekeo == 1) { andika_setg_al(); }
        sivyo kama (mwelekeo == 2) { andika_setle_al(); }
        sivyo { andika_setge_al(); }
    }
}

