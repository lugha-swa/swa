husisha { msambazaji.swa }

// ==========================================================
// uzalishaji.swa :: Kizalishe cha machine code asilia
// Hutoa ELF binary (.o) moja kwa moja kutoka AST.
// Hakuna LLVM, hakuna GNU as, hakuna tegemezi.
// ==========================================================

// -------------------------------------------------------
// Bafa ndogo ya .text — inahitajika kwa marekebisho ya
// kuruka mbele (forward branch fixup). Sehemu nyingine
// hutoka moja kwa moja kwenye stdout.
// -------------------------------------------------------

N8 bafa_text[524288];
N32 bafa_text_wapi = 0;
N32 text_imefurika = 0;

// Vigezo vya ulimwengu
N8 bafa_data[262144];
N32 bafa_data_wapi = 0;
N32 data_ulimwengu_off[1024];
N32 data_ulimwengu_size[1024];
N32 data_ulimwengu_jina_off[1024];
N32 data_ulimwengu_enc[1024];    // usimbaji wa aina kwa upakiaji sahihi
N32 data_ulimwengu_ni_safu[1024]; // 1 = safu (upakiaji unatumia LEA ya anwani)
N32 data_ulimwengu_bss[1024];   // 1 = hakuna kianzio, kigezo kinaenda .bss
N32 data_ulimwengu_idadi = 0;
N32 bss_wapi = 0;

W0 andika_baiti(N32 b) {
    kama (bafa_text_wapi < 524288) {
        bafa_text[bafa_text_wapi] = b & 255;
        bafa_text_wapi = bafa_text_wapi + 1;
    } sivyo kama (text_imefurika == 0) {
        text_imefurika = 1;
        andika_stderr("KOSA: bafa_text imefurika\n");
    }
}

W0 andika_neno2(N32 v) {
    andika_baiti(v & 255);
    andika_baiti((v >> 8) & 255);
}

W0 andika_neno4(N32 v) {
    andika_neno2(v & 65535);
    andika_neno2((v >> 16) & 65535);
}

W0 andika_neno8_kama_neno4(N32 lo, N32 hi) {
    andika_neno4(lo);
    andika_neno4(hi);
}

// -------------------------------------------------------
// Futa bafa ya .text hadi stdout
// -------------------------------------------------------
W0 futa_bafa_text() {
    // Andika bafa nzima ya .text kwa syscall moja (sio baiti kwa baiti)
    sys_andika(1, bafa_text, bafa_text_wapi);
}

// -------------------------------------------------------
// Andika moja kwa moja kwenye stdout (sio bafa)
// -------------------------------------------------------
W0 andika_baiti_moja_kwa_moja(N32 b) {
    andika("%c", b & 255);
}

W0 andika_neno2_moja_kwa_moja(N32 v) {
    andika_baiti_moja_kwa_moja(v & 255);
    andika_baiti_moja_kwa_moja((v >> 8) & 255);
}

W0 andika_neno4_moja_kwa_moja(N32 v) {
    andika_neno2_moja_kwa_moja(v & 65535);
    andika_neno2_moja_kwa_moja((v >> 16) & 65535);
}

W0 andika_neno8_moja_kwa_moja(N32 lo, N32 hi) {
    andika_neno4_moja_kwa_moja(lo);
    andika_neno4_moja_kwa_moja(hi);
}

// -------------------------------------------------------
// Mashine za x86-64 — opcodes tunazohitaji
// -------------------------------------------------------

// mov eax, imm32  (B8 + imm32)
W0 andika_mov_eax(N32 thamani) {
    andika_baiti(184);
    andika_neno4(thamani);
}

// ret (C3)
W0 andika_ret() {
    andika_baiti(195);
}

// push rax (50)
W0 andika_push_rax() {
    andika_baiti(80);
}

// pop rcx (59)
W0 andika_pop_rcx() {
    andika_baiti(89);
}

// add eax, ecx (01 C8)
W0 andika_add_eax_ecx() {
    andika_baiti(1);
    andika_baiti(200);
}

// add eax, imm32 (05 xx xx xx xx)
W0 andika_add_eax_imm32(N32 v) {
    andika_baiti(5);
    andika_neno4(v);
}

// sub eax, ecx (29 C8)
W0 andika_sub_eax_ecx() {
    andika_baiti(41);
    andika_baiti(200);
}

// imul eax, ecx (0F AF C1)
W0 andika_imul_eax_ecx() {
    andika_baiti(15);
    andika_baiti(175);
    andika_baiti(193);
}

// cmp eax, ecx (39 C8)
W0 andika_cmp_eax_ecx() {
    andika_baiti(57);
    andika_baiti(200);
}

// sete al (0F 94 C0)
W0 andika_sete_al() {
    andika_baiti(15);
    andika_baiti(148);
    andika_baiti(192);
}

// setl al (0F 9C C0)
W0 andika_setl_al() {
    andika_baiti(15);
    andika_baiti(156);
    andika_baiti(192);
}

// movzx eax, al (0F B6 C0)
W0 andika_movzx_eax_al() {
    andika_baiti(15);
    andika_baiti(182);
    andika_baiti(192);
}

// neg eax (F7 D8)
W0 andika_neg_eax() { andika_baiti(247); andika_baiti(216); }
W0 andika_cdq() { andika_baiti(153); }
W0 andika_idiv_ecx() { andika_baiti(247); andika_baiti(249); }
W0 andika_and_eax_ecx() { andika_baiti(33); andika_baiti(200); }
W0 andika_or_eax_ecx() { andika_baiti(9); andika_baiti(200); }
W0 andika_shl_eax_cl() { andika_baiti(211); andika_baiti(224); }
W0 andika_sar_eax_cl() { andika_baiti(211); andika_baiti(248); }

// === Visaidizi vya 32-bit bila ishara (unsigned) ===
// div ecx — unsigned divide edx:eax / ecx  (F7 F1)
W0 andika_div_ecx() { andika_baiti(247); andika_baiti(241); }
// shr eax, cl — shift right logical  (D3 E8)
W0 andika_shr_eax_cl() { andika_baiti(211); andika_baiti(232); }


// === Visaidizi vya 64-bit (REX.W) kwa N64 ===

// add rax, rcx (48 01 C8)
W0 andika_add_rax_rcx() {
    andika_baiti(72); andika_baiti(1); andika_baiti(200);
}

// add rax, imm32 (48 05 xx xx xx xx) — toleo la 64-bit la andika_add_eax_imm32
W0 andika_add_rax_imm32(N32 v) {
    andika_baiti(72); andika_baiti(5);
    andika_neno4(v);
}

// sub rax, rcx (48 29 C8)
W0 andika_sub_rax_rcx() {
    andika_baiti(72); andika_baiti(41); andika_baiti(200);
}

// cmp rax, rcx (48 39 C8)
W0 andika_cmp_rax_rcx() {
    andika_baiti(72); andika_baiti(57); andika_baiti(200);
}

// imul rax, rcx (48 0F AF C1)
W0 andika_imul_rax_rcx() {
    andika_baiti(72); andika_baiti(15); andika_baiti(175); andika_baiti(193);
}

// idiv rcx (48 F7 F9)
W0 andika_idiv_rcx_rax() {
    andika_baiti(72); andika_baiti(247); andika_baiti(249);
}

// and rax, rcx (48 21 C8)
W0 andika_and_rax_rcx() {
    andika_baiti(72); andika_baiti(33); andika_baiti(200);
}

// or rax, rcx (48 09 C8)
W0 andika_or_rax_rcx() {
    andika_baiti(72); andika_baiti(9); andika_baiti(200);
}

// shl rax, cl (48 D3 E0)
W0 andika_shl_rax_cl() {
    andika_baiti(72); andika_baiti(211); andika_baiti(224);
}

// sar rax, cl (48 D3 F8)
W0 andika_sar_rax_cl() {
    andika_baiti(72); andika_baiti(211); andika_baiti(248);
}

// === Visaidizi vya 64-bit bila ishara (unsigned) ===
// div rcx — unsigned divide rdx:rax / rcx  (48 F7 F1)
W0 andika_div_rcx_rax() {
    andika_baiti(72); andika_baiti(247); andika_baiti(241);
}
// shr rax, cl — shift right logical  (48 D3 E8)
W0 andika_shr_rax_cl() {
    andika_baiti(72); andika_baiti(211); andika_baiti(232);
}

// mov rax, rdi (48 89 F8)
W0 andika_mov_rax_rdi() { andika_baiti(72); andika_baiti(137); andika_baiti(248); }

// mov rax, rbp (48 89 E8)
W0 andika_mov_rax_rbp() { andika_baiti(72); andika_baiti(137); andika_baiti(232); }

// sub rax, imm32 (48 2D xx xx xx xx)
W0 andika_sub_rax_imm32(N32 v) {
    andika_baiti(72);
    andika_baiti(45);
    andika_neno4(v);
}

// mov rax, rsi (48 89 F0)
W0 andika_mov_rax_rsi() { andika_baiti(72); andika_baiti(137); andika_baiti(240); }

// mov rax, rdx (48 89 D0)
W0 andika_mov_rax_rdx() { andika_baiti(72); andika_baiti(137); andika_baiti(208); }

// mov rax, rcx (48 89 C8)
W0 andika_mov_rax_rcx() { andika_baiti(72); andika_baiti(137); andika_baiti(200); }

// mov rcx, rax (48 89 C1) — kwa kukanusha kwa 64-bit (0 - rcx)
W0 andika_mov_rcx_rax() { andika_baiti(72); andika_baiti(137); andika_baiti(193); }

// mov r11, rax (49 89 C3) — hifadhi kielekezi cha kazi kwa wito wa ndani
W0 andika_mov_r11_rax() { andika_baiti(73); andika_baiti(137); andika_baiti(195); }

// movsd xmm0, [rbp-off] (F2 0F 10 45 xx / F2 0F 10 85 xxxx) — pakia D64
W0 andika_movsd_xmm0_na_rbp_off(N32 off) {
    kama (off < 128) {
        andika_baiti(242); andika_baiti(15); andika_baiti(16); andika_baiti(69); andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(242); andika_baiti(15); andika_baiti(16); andika_baiti(133); andika_disp32_ya_off(off);
    }
}

// movss xmm0, [rbp-off] (F3 0F 10 45 xx / F3 0F 10 85 xxxx) — pakia D32
W0 andika_movss_xmm0_na_rbp_off(N32 off) {
    kama (off < 128) {
        andika_baiti(243); andika_baiti(15); andika_baiti(16); andika_baiti(69); andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(243); andika_baiti(15); andika_baiti(16); andika_baiti(133); andika_disp32_ya_off(off);
    }
}

// movsd [rbp-off], xmm0 (F2 0F 11 45 xx / F2 0F 11 85 xxxx) — hifadhi D64
W0 andika_movsd_xmm0_rbp_off(N32 off) {
    kama (off < 128) {
        andika_baiti(242); andika_baiti(15); andika_baiti(17); andika_baiti(69); andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(242); andika_baiti(15); andika_baiti(17); andika_baiti(133); andika_disp32_ya_off(off);
    }
}

// movss [rbp-off], xmm0 (F3 0F 11 45 xx / F3 0F 11 85 xxxx) — hifadhi D32
W0 andika_movss_xmm0_rbp_off(N32 off) {
    kama (off < 128) {
        andika_baiti(243); andika_baiti(15); andika_baiti(17); andika_baiti(69); andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(243); andika_baiti(15); andika_baiti(17); andika_baiti(133); andika_disp32_ya_off(off);
    }
}

// call r11 (41 FF D3) — wito wa kielekezi cha kazi
W0 andika_call_r11() { andika_baiti(65); andika_baiti(255); andika_baiti(211); }

// cdqe (48 98) — panua ishara ya eax hadi rax (kwa %d za N32)
W0 andika_cdqe() { andika_baiti(72); andika_baiti(152); }

// mov rsi, rax (48 89 C6) — hoja ya pili ya wito wa ndani
W0 andika_mov_rsi_rax2() { andika_baiti(72); andika_baiti(137); andika_baiti(198); }

// Tafuta nafasi ya kazi ya ndani kwa jina (iliyokwishakusanywa)
N32 kazi_nafasi_kwa_jina(N8* jina) {
    N32 li = 0;
    wakati (li < lebo_idadi) {
        kama (jina_linganisha(lebo_jina[li], jina)) {
            rudisha lebo_nafasi[li];
        }
        li = li + 1;
    }
    rudisha -1;
}

// Sehemu ya tungo: nakili kwenye bafa ya sehemu (kwa utorokaji wa \n na \\)
// na urudishe lebo ya ndani ya bafa ya .text.
N32 sehemu_tungo_hifadhi(N8* mwanzo, N32 urefu) {
    kama (sehemu_idadi >= 1024) { rudisha -1; }
    kama (sehemu_buf_wapi + urefu + 1 >= 4096) { rudisha -1; }
    N32 off = sehemu_buf_wapi;
    N32 i = 0;
    wakati (i < urefu) {
        N8 ch = mwanzo[i];
        kama (ch == 92 && i + 1 < urefu) {
            N8 e = mwanzo[i + 1];
            kama (e == 110) { ch = 10; i = i + 1; }
            sivyo kama (e == 92) { ch = 92; i = i + 1; }
            sivyo kama (e == 37) { ch = 37; i = i + 1; }
        }
        sehemu_buf[sehemu_buf_wapi] = ch;
        sehemu_buf_wapi = sehemu_buf_wapi + 1;
        i = i + 1;
    }
    sehemu_buf[sehemu_buf_wapi] = 0;
    sehemu_buf_wapi = sehemu_buf_wapi + 1;
    sehemu_off[sehemu_idadi] = off;
    sehemu_len[sehemu_idadi] = sehemu_buf_wapi - off - 1;
    sehemu_lebo_id[sehemu_idadi] = lebo_buf_mpya();
    sehemu_idadi = sehemu_idadi + 1;
    rudisha sehemu_lebo_id[sehemu_idadi - 1];
}

// Toa wito wa andika_sehemu(fd, lebo, urefu) — wito wa ndani
W0 andika_wito_sehemu(N32 fd, N32 lebo, N32 urefu) {
    andika_baiti(191); andika_neno4(fd);        // mov edi, fd
    toa_lea_rax_kwa_lebo(lebo);                 // lea rax, [rip+lebo]
    andika_mov_rsi_rax2();                      // mov rsi, rax
    andika_baiti(186); andika_neno4(urefu);     // mov edx, urefu
    N32 nafasi = kazi_nafasi_kwa_jina("andika_sehemu");
    kama (nafasi < 0) { rudisha; }
    andika_baiti(232);                          // call rel32
    N32 offset = nafasi - (bafa_text_wapi + 4);
    andika_neno4(offset);
}

// Toa wito wa andika_n64(fd, rax) — thamani iko kwenye rax
W0 andika_wito_n64(N32 fd) {
    andika_mov_rsi_rax2();                      // mov rsi, rax
    andika_baiti(191); andika_neno4(fd);        // mov edi, fd
    N32 nafasi = kazi_nafasi_kwa_jina("andika_n64");
    kama (nafasi < 0) { rudisha; }
    andika_baiti(232);
    N32 offset = nafasi - (bafa_text_wapi + 4);
    andika_neno4(offset);
}

// Toa wito wa andika_mfuatano(fd, rax) — kielekezi kiko kwenye rax
W0 andika_wito_mfuatano(N32 fd) {
    andika_mov_rsi_rax2();                      // mov rsi, rax
    andika_baiti(191); andika_neno4(fd);        // mov edi, fd
    N32 nafasi = kazi_nafasi_kwa_jina("andika_mfuatano");
    kama (nafasi < 0) { rudisha; }
    andika_baiti(232);
    N32 offset = nafasi - (bafa_text_wapi + 4);
    andika_neno4(offset);
}

// Toa wito wa andika_baiti(fd, rax) — baiti moja
W0 andika_wito_baiti(N32 fd) {
    andika_mov_rsi_rax2();                      // mov rsi, rax
    andika_baiti(191); andika_neno4(fd);        // mov edi, fd
    N32 nafasi = kazi_nafasi_kwa_jina("andika_herufi");
    kama (nafasi < 0) { rudisha; }
    andika_baiti(232);
    N32 offset = nafasi - (bafa_text_wapi + 4);
    andika_neno4(offset);
}

// Toa sehemu zote za tungo mwishoni mwa .text na uweke lebo zao
W0 andika_sehemu_halisi() {
    N32 i = 0;
    wakati (i < sehemu_idadi) {
        weka_lebo(sehemu_lebo_id[i]);
        N32 off = sehemu_off[i];
        N32 len = sehemu_len[i];
        N32 j = 0;
        wakati (j < len) {
            andika_baiti(sehemu_buf[off + j]);
            j = j + 1;
        }
        i = i + 1;
    }
}

// Andika disp32 (baiti 4, mdogo-kwanza) kwenye bafa maalum kwa ofseti.
// disp inaweza kuwa hasi — mgawanyo wa sakafu kama andika_disp32_ya_off.
W0 andika_disp32_kwenye(N8* bafa, N32 pos, N32 disp) {
    N32 q0 = disp / 256;
    kama (disp < 0 && (q0 * 256) != disp) { q0 = q0 - 1; }
    N32 b0 = disp - (q0 * 256);
    N32 q1 = q0 / 256;
    kama (q0 < 0 && (q1 * 256) != q0) { q1 = q1 - 1; }
    N32 b1 = q0 - (q1 * 256);
    N32 q2 = q1 / 256;
    kama (q1 < 0 && (q2 * 256) != q1) { q2 = q2 - 1; }
    N32 b2 = q1 - (q2 * 256);
    bafa[pos] = b0;
    bafa[pos + 1] = b1;
    bafa[pos + 2] = b2;
    bafa[pos + 3] = q2;
}

// Andika disp32 (baiti 4, mdogo-kwanza) ya thamani hasi: [rbp - off]
// Hesabu ya / na * (mbegu ina hitilafu katika & na >>); mgawanyo wa sakafu.
W0 andika_disp32_ya_off(N32 off) {
    N32 n = 0 - off;
    N32 q0 = n / 256;
    kama (n < 0 && (q0 * 256) != n) { q0 = q0 - 1; }
    N32 b0 = n - (q0 * 256);
    N32 q1 = q0 / 256;
    kama (q0 < 0 && (q1 * 256) != q0) { q1 = q1 - 1; }
    N32 b1 = q0 - (q1 * 256);
    N32 q2 = q1 / 256;
    kama (q1 < 0 && (q2 * 256) != q1) { q2 = q2 - 1; }
    N32 b2 = q1 - (q2 * 256);
    andika_baiti(b0); andika_baiti(b1); andika_baiti(b2); andika_baiti(q2);
}

// mov rax, [rbp+disp8] (48 8B 45 xx) au [rbp+disp32] (48 8B 85 xxxx)
W0 andika_mov_rax_rbp_off(N32 off) {
    kama (off < 128) {
        andika_baiti(72); andika_baiti(139); andika_baiti(69);
        andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(72); andika_baiti(139); andika_baiti(133);
        andika_disp32_ya_off(off);
    }
}

// mov [rbp+disp8], rax (48 89 45 xx) au [rbp+disp32] (48 89 85 xxxx)
W0 andika_mov_rbp_off_rax(N32 off) {
    kama (off < 128) {
        andika_baiti(72); andika_baiti(137); andika_baiti(69);
        andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(72); andika_baiti(137); andika_baiti(133);
        andika_disp32_ya_off(off);
    }
}

// mov [rbp+disp8], al (88 45 xx) au [rbp+disp32] (88 85 xxxx) — hifadhi ya baiti 1 (N8)
W0 andika_mov_rbp_off_al(N32 off) {
    kama (off < 128) {
        andika_baiti(136); andika_baiti(69); andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(136); andika_baiti(133);
        andika_disp32_ya_off(off);
    }
}

// mov [rbp+disp8], ax (66 89 45 xx) au [rbp+disp32] (66 89 85 xxxx) — hifadhi ya baiti 2 (N16)
W0 andika_mov_rbp_off_ax16(N32 off) {
    kama (off < 128) {
        andika_baiti(102); andika_baiti(137); andika_baiti(69); andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(102); andika_baiti(137); andika_baiti(133);
        andika_disp32_ya_off(off);
    }
}

// movzx eax, byte [rbp+disp8] (0F B6 45 xx) au [rbp+disp32] (0F B6 85 xxxx)
W0 andika_movzx_eax_baiti_rbp_off(N32 off) {
    kama (off < 128) {
        andika_baiti(15); andika_baiti(182); andika_baiti(69); andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(15); andika_baiti(182); andika_baiti(133);
        andika_disp32_ya_off(off);
    }
}

// movzx eax, word [rbp+disp8] (0F B7 45 xx) au [rbp+disp32] (0F B7 85 xxxx)
W0 andika_movzx_eax_neno_rbp_off(N32 off) {
    kama (off < 128) {
        andika_baiti(15); andika_baiti(183); andika_baiti(69); andika_baiti((256 - off) & 255);
    } sivyo {
        andika_baiti(15); andika_baiti(183); andika_baiti(133);
        andika_disp32_ya_off(off);
    }
}

// movzx eax, byte [rax] (0F B6 00)
W0 andika_movzx_eax_baiti_anwani() { andika_baiti(15); andika_baiti(182); andika_baiti(0); }

// movzx eax, word [rax] (0F B7 00)
W0 andika_movzx_eax_neno_anwani() { andika_baiti(15); andika_baiti(183); andika_baiti(0); }

// mov [rcx], al (88 01) — hifadhi ya baiti 1 kwa anwani ya rcx
W0 andika_mov_anwani_ecx_al() { andika_baiti(136); andika_baiti(1); }

// mov [rcx], ax (66 89 01) — hifadhi ya baiti 2 kwa anwani ya rcx
W0 andika_mov_anwani_ecx_ax16() { andika_baiti(102); andika_baiti(137); andika_baiti(1); }

// Pakia kigeu kutoka rafu kwa upana wa enc (movzx kwa N8/N16)
W0 andika_pakia_kigeu_kwa_enc(N32 enc, N32 off) {
    kama (ni_desimali_enc(enc)) {
        // Desimali: pakia kwenye xmm0
        N32 sz = ukubwa_kutoka_enc(enc);
        kama (sz >= 8) { andika_movsd_xmm0_na_rbp_off(off); }
        sivyo { andika_movss_xmm0_na_rbp_off(off); }
        rudisha;
    }
    N32 sz = ukubwa_kutoka_enc(enc);
    kama (sz == 1) { andika_movzx_eax_baiti_rbp_off(off); }
    sivyo kama (sz == 2) { andika_movzx_eax_neno_rbp_off(off); }
    sivyo kama (sz == 8) { andika_mov_rax_rbp_off(off); }
    sivyo { andika_mov_eax_rbp_off(off); }
}

// Hifadhi thamani (eax/ax/al/rax) katika [rcx] kwa upana wa saizi
W0 andika_hifadhi_anwani_kwa_saizi(N32 sz) {
    kama (sz == 1) { andika_mov_anwani_ecx_al(); }
    sivyo kama (sz == 2) { andika_mov_anwani_ecx_ax16(); }
    sivyo kama (sz == 8) { andika_mov_anwani_ecx_rax(); }
    sivyo { andika_mov_anwani_ecx_eax(); }
}

// Hifadhi paramu ya baiti 1 (reg8) katika [rbp+disp8]
// reg: 0=rdi, 1=rsi, 2=rdx, 3=rcx, 4=r8, 5=r9
W0 andika_mov_rbp_off_reg8(N32 reg, N32 off) {
    N32 d = (256 - off) & 255;
    kama (reg == 0) { andika_baiti(64); andika_baiti(136); andika_baiti(125); andika_baiti(d); }
    sivyo kama (reg == 1) { andika_baiti(64); andika_baiti(136); andika_baiti(117); andika_baiti(d); }
    sivyo kama (reg == 2) { andika_baiti(64); andika_baiti(136); andika_baiti(85); andika_baiti(d); }
    sivyo kama (reg == 3) { andika_baiti(64); andika_baiti(136); andika_baiti(77); andika_baiti(d); }
    sivyo kama (reg == 4) { andika_baiti(65); andika_baiti(136); andika_baiti(69); andika_baiti(d); }
    sivyo { andika_baiti(65); andika_baiti(136); andika_baiti(77); andika_baiti(d); }
}

// Hifadhi paramu ya baiti 2 (reg16) katika [rbp+disp8]
W0 andika_mov_rbp_off_reg16(N32 reg, N32 off) {
    N32 d = (256 - off) & 255;
    kama (reg == 0) { andika_baiti(102); andika_baiti(137); andika_baiti(125); andika_baiti(d); }
    sivyo kama (reg == 1) { andika_baiti(102); andika_baiti(137); andika_baiti(117); andika_baiti(d); }
    sivyo kama (reg == 2) { andika_baiti(102); andika_baiti(137); andika_baiti(85); andika_baiti(d); }
    sivyo kama (reg == 3) { andika_baiti(102); andika_baiti(137); andika_baiti(77); andika_baiti(d); }
    sivyo kama (reg == 4) { andika_baiti(102); andika_baiti(65); andika_baiti(137); andika_baiti(69); andika_baiti(d); }
    sivyo { andika_baiti(102); andika_baiti(65); andika_baiti(137); andika_baiti(77); andika_baiti(d); }
}

// Msaidizi: hifadhi thamani kutoka rax/eax/ax/al hadi [rbp-offset]
// kulingana na usimbaji wa aina.
// Aina za baiti 8 (N64, kielekezi): mov [rbp-off], rax
// Aina za baiti 4 (N32, n.k.):     mov [rbp-off], eax
// Aina za baiti 2 (B16):           mov [rbp-off], ax
// Aina za baiti 1 (B1, B8):        mov [rbp-off], al
// Desimali: movsd/movss [rbp-off], xmm0
W0 andika_mov_rbp_off_ax(N32 enc, N32 off) {
    kama (ni_desimali_enc(enc)) {
        N32 uk = ukubwa_kutoka_enc(enc);
        kama (uk >= 8) { andika_movsd_xmm0_rbp_off(off); }
        sivyo { andika_movss_xmm0_rbp_off(off); }
        rudisha;
    }
    N32 uk = ukubwa_kutoka_enc(enc);
    kama (uk >= 8) {
        andika_mov_rbp_off_rax(off);
    } sivyo kama (uk >= 4) {
        andika_mov_rbp_off_eax(off);
    } sivyo kama (uk >= 2) {
        andika_mov_rbp_off_ax16(off);
    } sivyo {
        andika_mov_rbp_off_al(off);
    }
}

// Msaidizi: pakia thamani kutoka [rbp-off] hadi eax/rax kwa upana sahihi.
// Kwa aina ndogo (baiti 1 na 2), inatumia movsx/movzx kwa upanuzi sahihi.
// Aina zenye ishara (N): movsx — panua ishara
// Aina bila ishara (A, B, W): movzx — panua sifuri
W0 andika_mov_ax_na_rbp_off(N32 enc, N32 off) {
    N32 uk = ukubwa_kutoka_enc(enc);
    kama (uk >= 8) {
        andika_mov_rax_rbp_off(off);
    } sivyo kama (uk >= 4) {
        andika_mov_eax_rbp_off(off);
    } sivyo kama (uk >= 2) {
        // Aina ya baiti 2: panua kwa ishara au sifuri
        kama (ni_bila_ishara_enc(enc)) {
            andika_movzx_eax_rbp_off_b2(off);
        } sivyo {
            andika_movsx_eax_rbp_off_b2(off);
        }
    } sivyo {
        // Aina ya baiti 1: panua kwa ishara au sifuri
        kama (ni_bila_ishara_enc(enc)) {
            andika_movzx_eax_rbp_off_b1(off);
        } sivyo {
            andika_movsx_eax_rbp_off_b1(off);
        }
    }
}

// Msaidizi: hifadhi paramu kutoka rejesta ya x86 hadi rafu.
// reg: 0=rdi/edi, 1=rsi/esi, 2=rdx/edx, 3=rcx/ecx, 4=r8/r8d, 5=r9/r9d
// Inashughulikia upana wote: baiti 8, 4, 2, na 1
W0 andika_mov_ax_reg_na_rbp_off(N32 enc, N32 reg, N32 off) {
    N32 uk = ukubwa_kutoka_enc(enc);
    kama (uk >= 8) {
        // Kesi ya baiti 8: rax ← rejesta, kisha [rbp-off] ← rax
        kama (reg == 0) { andika_mov_rax_rdi(); }
        sivyo kama (reg == 1) { andika_mov_rax_rsi(); }
        sivyo kama (reg == 2) { andika_mov_rax_rdx(); }
        sivyo kama (reg == 3) { andika_mov_rax_rcx(); }
        sivyo kama (reg == 4) { andika_mov_rax_r8(); }
        sivyo { andika_mov_rax_r9(); }
        andika_mov_rbp_off_rax(off);
    } sivyo {
        // Kesi za baiti 4/2/1: eax ← rejesta (inashughulikia upanuzi wa
        // baiti ndogo kiotomatiki kupitia mov ya baiti 4)
        kama (reg == 0) { andika_mov_eax_edi(); }
        sivyo kama (reg == 1) { andika_mov_eax_esi(); }
        sivyo kama (reg == 2) { andika_mov_eax_edx(); }
        sivyo kama (reg == 3) { andika_mov_eax_ecx(); }
        sivyo kama (reg == 4) { andika_mov_eax_r8d(); }
        sivyo { andika_mov_eax_r9d(); }
        // Hifadhi upana sahihi kwenye rafu
        kama (uk >= 4) {
            andika_mov_rbp_off_eax(off);
        } sivyo kama (uk >= 2) {
            andika_mov_rbp_off_ax16(off);
        } sivyo {
            andika_mov_rbp_off_al(off);
        }
    }
}

