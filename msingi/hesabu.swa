// hesabu.swa — Shughuli za hisabati
//
// Inatoa kazi za msingi za kulinganisha nambari na kukokotoa
// maadili kamili. Hizi ni muhimu kwa algorithms nyingi za msingi.

// Rudisha nambari kubwa kati ya mbili (N32).
N32 hesabu_kamili(N32 a, N32 b) {
    kama (a > b) {
        rudisha a;
    }
    rudisha b;
}

// Rudisha nambari ndogo kati ya mbili (N32).
N32 hesabu_ndogo(N32 a, N32 b) {
    kama (a < b) {
        rudisha a;
    }
    rudisha b;
}

// Rudisha nambari kubwa kati ya mbili (N64).
N64 hesabu_kubwa(N64 a, N64 b) {
    kama (a > b) {
        rudisha a;
    }
    rudisha b;
}

// Rudisha nambari ndogo kati ya mbili (N64).
N64 hesabu_dogo(N64 a, N64 b) {
    kama (a < b) {
        rudisha a;
    }
    rudisha b;
}

// Thamani kamili ya N32.
N32 neneo_n32(N32 n) {
    kama (n < 0) {
        rudisha 0 - n;
    }
    rudisha n;
}

// Thamani kamili ya N64.
N64 neneo_n64(N64 n) {
    kama (n < 0) {
        rudisha 0 - n;
    }
    rudisha n;
}
