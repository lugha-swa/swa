// hesabu.swa — Shughuli za hisabati
//
// Inatoa kazi za msingi za kulinganisha nambari na kukokotoa
// maadili kamili. Hizi ni muhimu kwa algorithms nyingi za msingi.

// Rudisha nambari kubwa kati ya mbili (N32).
N32 hesabu_kamili(N32 a, N32 b) {
    kama (a > b) {
        rudisha a;
    }
    rudisha b;
}

// Rudisha nambari ndogo kati ya mbili (N32).
N32 hesabu_ndogo(N32 a, N32 b) {
    kama (a < b) {
        rudisha a;
    }
    rudisha b;
}

// Rudisha nambari kubwa kati ya mbili (N64).
N64 hesabu_kubwa(N64 a, N64 b) {
    kama (a > b) {
        rudisha a;
    }
    rudisha b;
}

// Rudisha nambari ndogo kati ya mbili (N64).
N64 hesabu_dogo(N64 a, N64 b) {
    kama (a < b) {
        rudisha a;
    }
    rudisha b;
}

// Thamani kamili ya N32.
N32 neneo_n32(N32 n) {
    kama (n < 0) {
        rudisha 0 - n;
    }
    rudisha n;
}

// Thamani kamili ya N64.
N64 neneo_n64(N64 n) {
    kama (n < 0) {
        rudisha 0 - n;
    }
    rudisha n;
}

// gcd — kigawanyo kikubwa cha pamoja (algorithm ya Euclid)
N32 gcd_hesabu(N32 a, N32 b) {
    a = neneo_n32(a);
    b = neneo_n32(b);
    wakati (b != 0) {
        N32 t = a % b;
        a = b;
        b = t;
    }
    rudisha a;
}

// pow_kamili — kipeo cha nambari kamili (msingi ^ kipeo)
N32 pow_kamili(N32 msingi, N32 kipeo) {
    N32 r = 1;
    N32 i = 0;
    wakati (i < kipeo) { r = r * msingi; i = i + 1; }
    rudisha r;
}

// isqrt — kipeuo cha pili kamili (njia ya Newton kwa nambari kamili)
N32 isqrt_hesabu(N32 n) {
    kama (n <= 1) { rudisha n; }
    N32 x = n;
    N32 y = (x + 1) / 2;
    wakati (y < x) {
        x = y;
        y = (x + n / x) / 2;
    }
    rudisha x;
}

// fibonacci_hesabu — nambari ya Fibonacci kwa njia ya kujirudia
N32 fibonacci_hesabu(N32 n) {
    kama (n <= 1) { rudisha n; }
    rudisha fibonacci_hesabu(n - 1) + fibonacci_hesabu(n - 2);
}
