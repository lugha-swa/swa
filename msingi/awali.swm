; =============================================================================
; mbegu.swm -- Mkusanyaji Mbegu wa Swa
;
; Mkusanyaji wa Swa ulioandikwa kwa lugha ya mashine ya Swa
; (hati/kusanyiko-x86.md). Husoma chanzo cha Swa na kutoa ELF kwa stdout.
;
; Hii inafunga pengo la bootstrap: baiti 393 za mkono -> Swa.
;
; Kujenga (mfululizo huru, hati/mfululizo-huru.md -- bila NASM wala ld):
;   ./msingi/mjenzi.bin gharama/gandisha.mapishi
;   (kwanza.bin -> maoni -> mahali -> kusanyiko0 -> kusanyiko -> awali.bin)
;
; Kutumia:
;   ./msingi/awali.bin < chanzo.swa > pato.o
;   au: ./msingi/awali.bin chanzo.swa > pato.o
; =============================================================================


; =============================================================================
; Sehemu ya 0: Vifafanuzi vya ukubwa
; =============================================================================

fafanua UPEO_CHANZO = 4194304   ; 4 MB ya chanzo
fafanua UPEO_TOKENI = 262144   ; upeo wa tokeni
fafanua UPEO_WA_NODI = 262144   ; upeo wa nodi za AST
fafanua UKUBWA_CHOMBO_MSIMBO = 1048576   ; 1 MB ya msimbo wa .text
fafanua UKUBWA_CHOMBO_DATA = 4194304   ; MB 4 ya data ya ulimwengu na mifuatano halisi
fafanua UPEO_MAHALI = 65536   ; upeo wa mahali
fafanua UPEO_NJE = 65536   ; upeo wa alama za nje
fafanua UPEO_HAMISHO = 65536   ; upeo wa marekebisho
fafanua UPEO_ULIMWENGU = 4096   ; upeo wa vigezo vya ulimwengu
fafanua UKUBWA_GHALA_MFUATANO = 1048576   ; bwawa la herufi (1 MB kwa faili kubwa)
fafanua UPEO_NDANI = 1024   ; upeo wa vigezo vya ndani kwa kazi
fafanua UKUBWA_GHALA_HALISI64 = 65536   ; bwawa la halisi za N64 (baiti 8 kila moja)

; Aina za tokeni
